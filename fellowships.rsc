1e:["$","article",null,{"className":"article-body ","children":[["$","section","0-Compare professional and research fellowship routes",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Compare professional and research fellowship routes"}],[["$","p","Start with the activity you need to fund. Professional development, independent research and a postdoctoral project can lead to different outcomes even when all use the fellowship label. Decide whether your immediate goal is a qualification, a research output or a change in professional practice.",{"children":"Start with the activity you need to fund. Professional development, independent research and a postdoctoral project can lead to different outcomes even when all use the fellowship label. Decide whether your immediate goal is a qualification, a research output or a change in professional practice."}],["$","p","The cards below are programme routes, not a promise of current places. National nomination, host approval and a central call can each have a separate deadline. Resolve those dependencies before paying for documents or asking a referee to write a recommendation.",{"children":"The cards below are programme routes, not a promise of current places. National nomination, host approval and a central call can each have a separate deadline. Resolve those dependencies before paying for documents or asking a referee to write a recommendation."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Choose by purpose and eligibility, not programme prestige","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Choose by purpose and eligibility, not programme prestige"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route",{"scope":"col","children":"Route"}],["$","th","Who should investigate it",{"scope":"col","children":"Who should investigate it"}],["$","th","First condition to resolve",{"scope":"col","children":"First condition to resolve"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Humphrey"}],["$","td","1",{"children":"Professionals seeking a non-degree development route"}],["$","td","2",{"children":"Your country's nomination process and current call"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Humboldt Research Fellowship"}],["$","td","1",{"children":"Researchers planning work with a German host"}],["$","td","2",{"children":"Doctoral stage, host support and call availability"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"MSCA Postdoctoral Fellowships"}],["$","td","1",{"children":"PhD researchers developing a host-based project"}],["$","td","2",{"children":"Mobility and research-experience rules for the selected call"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.humphreyfellowship.org/how-to-apply/",{"children":["",["$","a",null,{"href":"https://www.humphreyfellowship.org/how-to-apply/","target":"_blank","rel":"noreferrer","children":"Humphrey application route"}]]}],["$","span","https://www.humboldt-foundation.de/en/apply/sponsorship-programmes/humboldt-research-fellowship",{"children":[" · ",["$","a",null,{"href":"https://www.humboldt-foundation.de/en/apply/sponsorship-programmes/humboldt-research-fellowship","target":"_blank","rel":"noreferrer","children":"Humboldt official fellowship"}]]}],["$","span","https://marie-sklodowska-curie-actions.ec.europa.eu/actions/postdoctoral-fellowships",{"children":[" · ",["$","a",null,{"href":"https://marie-sklodowska-curie-actions.ec.europa.eu/