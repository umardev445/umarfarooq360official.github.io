20:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is a fellowship the same as a scholarship?",{"children":[["$","summary",null,{"children":["Is a fellowship the same as a scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not always. Scholarships usually support study, while fellowships may support research, work placements, leadership programmes or projects. Read the activity and eligibility rules."}]]}],["$","details","Can students apply for professional fellowships?",{"children":[["$","summary",null,{"children":["Can students apply for professional fellowships?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Only when the programme permits their career stage. Many fellowships require graduation, work experience or evidence of professional impact."}]]}]]}]]}]
29:I["ab32ab9b14fd",[],"TaskChecklist",1]
21:["$","section","1-Check the doctoral, host and mobility conditions first",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Check the doctoral, host and mobility conditions first"}],[["$","p","Humboldt separates postdoctoral and experienced-researcher routes. Its current schedule lists the next opening on 15 November 2026, subject to capacity. That scheduled date does not mean applications are already open. Check the doctoral-date and residence conditions and the host's required support.",{"children":"Humboldt separates postdoctoral and experienced-researcher routes. Its current schedule lists the next opening on 15 November 2026, subject to capacity. That scheduled date does not mean applications are already open. Check the doctoral-date and residence conditions and the host's required support."}],["$","p","MSCA requires a PhD or a successfully defended thesis by the call deadline. Its overview includes an eight-year research-experience limit with specified exclusions and a mobility test. European and Global Fellowships have different nationality rules. Use the current call and host guidance to assess your own history.",{"children":"MSCA requires a PhD or a successfully defended thesis by the call deadline. Its overview includes an eight-year research-experience limit with specified exclusions and a mobility test. European and Global Fellowships have different nationality rules. Use the current call and host guidance to assess your own history."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L29",null,{"id":"fellowships:section-2","title":"Check your progress","items":["Record the doctoral award or defence date and supporting evidence.","Build a dated residence and work history for any mobility assessment.","Confirm the host, supervisor and internal submission deadline.","Identify the benefits, exclusions and any return or reporting commitments.","Resolve unclear requirements with the programme or host before drafting."]}],"$undefined","$undefined"]}]
22:["$","section","2-Match the fellowship to your stage",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Match the fellowship to your stage"}],[["$","p","Some fellowships are designed for enrolled students, others for professionals with several years of impact. Review the cohort profile and previous fellows to understand the real level of competitiveness.",{"children":"Some fellowships are designed for enrolled students, others for professionals with several years of impact. Review the cohort profile and previous fellows to understand the real level of competitiveness."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Career-stage requirement",{"children":"Career-stage requirement"}],["$","li","Residency and travel expectations",{"children":"Residency and travel expectations"}],["$","li","Project or research proposal",{"children":"Project or research proposal"}],["$","li","Employer approval or nomination",{"children":"Employer approval or nomination"}],["$","li","Post-fellowship commitments",{"children":"Post-fellowship commitments"}]]}],"$undefined","$undefined","$undefined"]}]
23:["$","section","3-Read the commitment behind the funding",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Read the commitment behind the funding"}],[["$","p","A fellowship may involve residential sessions, travel, a project, employer approval, public events or a return-home commitment. Put every required date beside your study and work calendar before applying.",{"children":"A fellowship may involve residential sessions, travel, a project, employer approval, public events or a return-home commitment. Put every required date beside your study and work calendar before applying."}],["$","p","Look beyond the stipend. Mentoring quality, cohort access, project ownership and alumni support often determine whether a fellowship creates lasting value.",{"children":"Look beyond the stipend. Mentoring quality, cohort access, project ownership and alumni support often determine whether a fellowship creates lasting value."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","4-Build a convincing fellowship proposal",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Build a convincing fellowship proposal"}],[["$","p","Describe a defined problem, the people affected, the approach you can realistically take during the fellowship and the evidence you will use to judge progress. Avoid promising national-scale change from a short programme.",{"children":"Describe a defined problem, the people affected, the approach you can realistically take during the fellowship and the evidence you will use to judge progress. Avoid promising national-scale change from a short programme."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","5-Prepare evidence for fellowship selection",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Prepare evidence for fellowship selection"}],[["$","p","Build a short evidence bank showing responsibility, outcomes, collaboration and reflection. Connect each example to the fellowship's stated purpose instead of submitting one general leadership story everywhere.",{"children":"Build a short evidence bank showing responsibility, outcomes, collaboration and reflection. Connect each example to the fellowship's stated purpose instead of submitting one general leadership story everywhere."}],["$","p","Confirm whether references, employer permission, a host invitation or a project budget must be ready before the deadline.",{"children":"Confirm whether references, employer permission, a host invitation or a project budget must be ready before the deadline."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","6-Worked example: a research question you can deliver",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Worked example: a research question you can deliver"}],[["$","p","This fictional planning example is not an accepted proposal or an official selection criterion. A researcher wants to study student retention but has access to only one small anonymised dataset. Promising to transform a national education system would be difficult to defend within that scope.",{"children":"This fictional planning example is not an accepted proposal or an official selection criterion. A researcher wants to study student retention but has access to only one small anonymised dataset. Promising to transform a national education system would be difficult to defend within that scope."}],["$","p","For each required resource, name who controls it and when you need an answer. Give a potential host a short question about the proposed work, their specific expertise and the support you seek. For a referee, provide facts they observed directly, the programme instructions and the submission method. This produces evidence the reader can assess instead of a collection of unsupported claims.",{"children":"For each required resource, name who controls it and when you need an answer. Give a potential host a short question about the proposed work, their specific expertise and the support you seek. For a referee, provide facts they observed directly, the programme instructions and the submission method. This produces evidence the reader can assess instead of a collection of unsupported claims."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original example: connect scope, method and host support","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original example: connect scope, method and host support"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Part",{"scope":"col","children":"Part"}],["$","th","Weak draft",{"scope":"col","children":"Weak draft"}],["$","th","More useful revision",{"scope":"col","children":"More useful revision"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Question"}],["$","td","1",{"children":"Improve all education"}],["$","td","2",{"children":"Investigate retention patterns in the available dataset"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Method"}],["$","td","1",{"children":"Use advanced AI"}],["$","td","2",{"children":"Document missing data and compare a baseline with one justified method"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Host fit"}],["$","td","1",{"children":"The university is famous"}],["$","td","2",{"children":"Identify the supervisor's relevant expertise and support needed"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Output"}],["$","td","1",{"children":"Publish many papers"}],["$","td","2",{"children":"Plan a reproducible analysis and a report, subject to data permission"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"If data permission is unresolved, put that decision before analysis in the project timeline. Add a realistic fallback, such as an approved public dataset, rather than promising access you do not control."}]]}],"$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Worked example: a research question you can deliver","children":[["$","$L5","/guides/find-phd-supervisor/",{"href":"/guides/find-phd-supervisor/","children":["Build a research supervisor shortlist","$L2a"]}],"$L2b"]}]]}]
27:["$","section","7-Choose an apply, clarify or watch decision",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Choose an apply, clarify or watch decision"}],[["$","p","Use Apply when the current route, mandatory eligibility and required evidence are clear. Use Clarify when one essential rule needs a written answer. Use Watch when a programme is between rounds, a host is not confirmed or a suitable vacancy has not been published. Keep planning opportunities separate from deadlines you can meet now.",{"children":"Use Apply when the current route, mandatory eligibility and required evidence are clear. Use Clarify when one essential rule needs a written answer. Use Watch when a programme is between rounds, a host is not confirmed or a suitable vacancy has not been published. Keep planning opportunities separate from deadlines you can meet now."}],["$","p","The comparison sheet records the source, location, funding, missing evidence and one next action. Save the actual call alongside your notes. A programme homepage may remain online after an application period ends; a checked date is a record of a review, not an extension of that period.",{"children":"The comparison sheet records the source, location, funding, missing evidence and one next action. Save the actual call alongside your notes. A programme homepage may remain online after an application period ends; a checked date is a record of a review, not an extension of that period."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Choose an apply, clarify or watch decision","children":[["$","a","/downloads/career-opportunity-comparison.csv",{"href":"/downloads/career-opportunity-comparison.csv","download":true,"children":["Download the career opportunity comparison sheet (CSV)",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
28:["$","section","8-Choose by career stage, purpose and commitment",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Choose by career stage, purpose and commitment"}],[["$","p","Compare the qualification or experience required, the activity funded, the support period and any residency or reporting obligation. The label fellowship does not establish an employment contract or complete funding.",{"children":"Compare the qualification or experience required, the activity funded, the support period and any residency or reporting obligation. The label fellowship does not establish an employment contract or complete funding."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Choose by career stage, purpose and commitment","children":[["$","$L5","/guides/fellowship-vs-scholarship/",{"href":"/guides/fellowship-vs-scholarship/","children":["Fellowship vs scholarship: choose by purpose and terms",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/find-phd-supervisor/",{"href":"/guides/find-phd-supervisor/","children":["Find a PhD supervisor: shortlist, email and follow up",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
