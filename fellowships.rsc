19:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-Match the fellowship to your stage",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Match the fellowship to your stage"}],[["$","p","Some fellowships are designed for enrolled students, others for professionals with several years of impact. Review the cohort profile and previous fellows to understand the real level of competitiveness.",{"children":"Some fellowships are designed for enrolled students, others for professionals with several years of impact. Review the cohort profile and previous fellows to understand the real level of competitiveness."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Career-stage requirement",{"children":"Career-stage requirement"}],["$","li","Residency and travel expectations",{"children":"Residency and travel expectations"}],["$","li","Project or research proposal",{"children":"Project or research proposal"}],["$","li","Employer approval or nomination",{"children":"Employer approval or nomination"}],["$","li","Post-fellowship commitments",{"children":"Post-fellowship commitments"}]]}],"$undefined","$undefined"]}],["$","section","2-Read the commitment behind the funding",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Read the commitment behind the funding"}],[["$","p","A fellowship may involve residential sessions, travel, a project, employer approval, public events or a return-home commitment. Put every required date beside your study and work calendar before applying.",{"children":"A fellowship may involve residential sessions, travel, a project, employer approval, public events or a return-home commitment. Put every required date beside your study and work calendar before applying."}],["$","p","Look beyond the stipend. Mentoring quality, cohort access, project ownership and alumni support often determine whether a fellowship creates lasting value.",{"children":"Look beyond the stipend. Mentoring quality, cohort access, project ownership and alumni support often determine whether a fellowship creates lasting value."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Build a convincing fellowship proposal",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Build a convincing fellowship proposal"}],[["$","p","Describe a defined problem, the people affected, the approach you can realistically take during the fellowship and the evidence you will use to judge progress. Avoid promising national-scale change from a short programme.",{"children":"Describe a defined problem, the people affected, the approach you can realistically take during the fellowship and the evidence you will use to judge progress. Avoid promising national-scale change from a short programme."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","4-Prepare evidence for fellowship selection",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Prepare evidence for fellowship selection"}],[["$","p","Build a short evidence bank showing responsibility, outcomes, collaboration and reflection. Connect each example to the fellowship's stated purpose instead of submitting one general leadership story everywhere.",{"children":"Build a short evidence bank showing responsibility, outcomes, collaboration and reflection. Connect each example to the fellowship's stated purpose instead of submitting one general leadership story everywhere."}],["$","p","Confirm whether references, employer permission, a host invitation or a project budget must be ready before the deadline.",{"children":"Confirm whether references, employer permission, a host invitation or a project budget must be ready before the deadline."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]]}]
