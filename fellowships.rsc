n.de/en/apply/sponsorship-programmes/humboldt-research-fellowship","sourceLabel":"Humboldt Foundation","checked":"2 November 2026"},{"id":"msca-postdoctoral-fellowships","title":"MSCA Postdoctoral Fellowships","provider":"European Commission","type":"Fellowship","level":"PhD","country":"Multiple European countries","region":"Europe","funding":"Funded","status":"Check official site","deadline":"Call-specific; check current funding portal and host deadline","summary":"Host-based research with doctoral, experience and mobility conditions. European and Global routes have different nationality rules. This overview does not confirm an open call.","tags":["Postdoctoral","Research","Mobility rules"],"source":"https://marie-sklodowska-curie-actions.ec.europa.eu/actions/postdoctoral-fellowships","sourceLabel":"European Commission: MSCA","checked":"2 November 2026"}],"showTypeFilter":false}]]}],false,"$L1e",false,"$L1f","$L20"]}],false]}]
