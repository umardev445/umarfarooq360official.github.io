1f:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L5","https://www.humboldt-foundation.de/en/apply/sponsorship-programmes/humboldt-research-fellowship",{"href":"https://www.humboldt-foundation.de/en/apply/sponsorship-programmes/humboldt-research-fellowship","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Humboldt Research Fellowship"}],["$","span",null,{"children":"Programme overview checked 2 November 2026. An overview is not proof of a live vacancy."}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L5","https://marie-sklodowska-curie-actions.ec.europa.eu/actions/postdoctoral-fellowships",{"href":"https://marie-sklodowska-curie-actions.ec.europa.eu/actions/postdoctoral-fellowships","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"MSCA Postdoctoral Fellowships"}],["$","span",null,{"children":"Programme overview checked 2 November 2026. An overview is not proof of a live vacancy."}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":"$1f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L5","https://www.humphreyfellowship.org/how-to-apply/",{"href":"https://www.humphreyfellowship.org/how-to-apply/","t