2b:["$","$L5","/guides/recommendation-letter/",{"href":"/guides/recommendation-letter/","children":["Prepare a reference request",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]
