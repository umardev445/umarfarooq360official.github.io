1f:["$","section","4-Research Italy through three funding owners",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Research Italy through three funding owners"}],[["$","p","For Italy, compare the MAECI government call, the competent regional DSU authority and university-specific merit or tuition support. Each can have its own portal, documents and deadline.",{"children":"For Italy, compare the MAECI government call, the competent regional DSU authority and university-specific merit or tuition support. Each can have its own portal, documents and deadline."}],["$","p","The dedicated Italy scholarship page labels closed 2026–2027 calls clearly and links to the official source, so applicants can plan for the next cycle without copying an expired date.",{"children":"The dedicated Italy scholarship page labels closed 2026–2027 calls clearly and links to the official source, so applicants can plan for the next cycle without copying an expired date."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
