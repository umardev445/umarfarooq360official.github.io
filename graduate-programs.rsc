1b:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-What makes a graduate programme different",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"What makes a graduate programme different"}],[["$","p","Strong programmes combine real responsibility with rotations, formal training, mentoring and progression criteria. Check whether sponsorship is available before investing in a long application.",{"children":"Strong programmes combine real responsibility with rotations, formal training, mentoring and progression criteria. Check whether sponsorship is available before investing in a long application."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Graduation-year eligibility",{"children":"Graduation-year eligibility"}],["$","li","Work-authorisation and sponsorship",{"children":"Work-authorisation and sponsorship"}],["$","li","Rotations and permanent-role pathway",{"children":"Rotations and permanent-role pathway"}],["$","li","Assessment stages",{"children":"Assessment stages"}],["$","li","Salary, benefits and location",{"children":"Salary, benefits and location"}]]}],"$undefined","$undefined","$undefined"]}],["$","section","2-Prepare for multi-stage assessment",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Prepare for multi-stage assessment"}],[["$","p","Graduate recruitment may include online tests, recorded questions, an assessment centre and final interviews. Learn what each stage measures, practise under realistic time limits and request an accommodation through the official process when needed.",{"children":"Graduate recruitment may include online tests, recorded questions, an assessment centre and final interviews. Learn what each stage measures, practise under realistic time limits and request an accommodation through the official process when needed."}],["$","p","Use examples from coursework, projects, employment and volunteering. Recruiters usually need evidence of judgement, collaboration and delivery—not an inflated job title.",{"children":"Use examples from coursework, projects, employment and volunteering. Recruiters usually need evidence of judgement, collaboration and delivery—not an inflated job title."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Check visa sponsorship before applying",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Check visa sponsorship before applying"}],[["$","p","Terms such as global programme or international company do not guarantee sponsorship. Look for the exact work location and right-to-work statement, then ask recruitment for written clarification if the vacancy is ambiguous.",{"children":"Terms such as global programme or international company do not guarantee sponsorship. Look for the exact work location and right-to-work statement, then ask recruitment for written clarification if the vacancy is ambiguous."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","4-Practise the decision-making behind an assessment centre",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Practise the decision-making behind an assessment centre"}],[["$","p","Use the employer’s stated format to decide what to rehearse. The preparation guide contains original fictional case and in-tray exercises, with explanations of evidence, constraints and priorities.",{"children":"Use the employer’s stated format to decide what to rehearse. The preparation guide contains original fictional case and in-tray exercises, with explanations of evidence, constraints and priorities."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$L1d"]}]]}]
