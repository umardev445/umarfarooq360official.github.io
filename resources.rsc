24:["$","article",null,{"className":"article-body ","children":[["$","section","0-One story, adapted carefully",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"One story, adapted carefully"}],[["$","p","Your CV, essays, references and interview should reinforce the same core direction while answering different questions. Reusing facts is fine; copying identical paragraphs into every application is not.",{"children":"Your CV, essays, references and interview should reinforce the same core direction while answering different questions. Reusing facts is fine; copying identical paragraphs into every application is not."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Create a master evidence bank",{"children":"Create a master evidence bank"}],["$","li","Map every prompt to one clear example",{"children":"Map every prompt to one clear example"}],["$","li","Use outcomes and reflection",{"children":"Use outcomes and reflection"}],["$","li","Remove unsupported claims",{"children":"Remove unsupported claims"}],["$","li","Proofread names, dates and programme details",{"children":"Proofread names, dates and programme details"}]]}],"$undefined","$undefined"]}],["$","section","1-Choose the guide that solves the next bottleneck",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Choose the guide that solves the next bottleneck"}],[["$","p","Start with eligibility and process before improving prose. If the shortlist is sound but the story is unclear, work on the evidence bank and statement of purpose. If the written application is submitted, move to interview preparation rather than repeatedly rewriting old documents.",{"children":"Start with eligibility and process before improving prose. If the shortlist is sound but the story is unclear, work on the evidence bank and statement of purpose. If the written application is submitted, move to interview preparation rather than repeatedly rewriting old documents."}],["$","p","Every guide is general educational support. The current programme prompt, word limit, document format and permitted use of AI always take priority.",{"children":"Every guide is general educational support. The current programme prompt, word limit, document format and permitted use of AI always take priority."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","2-Use AI without losing accuracy or authorship",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Use AI without losing accuracy or authorship"}],[["$","p","Check each programme's rules. If assistance is allowed, use tools to organise ideas, find gaps or improve clarity, then verify every fact and rebuild the final response in your own voice. Never invent achievements, references, research or personal experience.",{"children":"Check each programme's rules. If assistance is allowed, use tools to organise ideas, find gaps or improve clarity, then verify every fact and rebuild the final response in your own voice. Never invent achievements, references, research or personal experience."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]]}]
