18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"VSRP is a 2–6 month research internship with project-specific fit and published academic conditions. It is separate from KAUST graduate admission; check the current FAQ for recent graduates and the referee process."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose an active official project, check every eligibility condition and ask your faculty referee before applying."]}],"$undefined"]}],false,false,["$","$L1a",null,{"records":[{"id":"kaust-vsrp","title":"KAUST Visiting Student Research Program","provider":"KAUST","type":"Internship","level":"Student","country":"Saudi Arabia","region":"Middle East","funding":"Fully funded","deadline":"Year-round; project availability and dates to confirm","status":"Rolling","summary":"A 2–6 month research placement with published student/recent-graduate conditions, project-specific fit and a nominated-referee process. Separate from degree admission.","tags":["Research","STEM","Project application"],"source":"https://admissions.kaust.edu.sa/study/internships","sourceLabel":"KAUST official internship requirements and FAQ","checked":"24 October 2026"}]}],["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","VSRP is an internship, not a KAUST degree application",{"href":"#section-1","children":"VSRP is an internship, not a KAUST degree application"}],["$","a","Check the current requirements",{"href":"#section-2","children":"Check the current requirements"}],["$","a","Shortlist by project fit",{"href":"#section-3","children":"Shortlist by project fit"}],["$","a","Budget with the confirmed benefits",{"href":"#section-4","children":"Budget with the confirmed benefits"}],["$","a","Prepare the right documents and referee workflow",{"href":"#section-5","children":"Prepare the right documents and referee workflow"}],["$","a","Write a purpose statement around contribution and learning",{"href":"#section-6","children":"Write a purpose statement around contribution and learning"}],["$","a","Apply to a specific project and track the decision",{"href":"#section-7","children":"Apply to a specific project and track the decision"}],["$","a","If VSRP is not your route",{"href":"#section-8","children":"If VSRP is not your route"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-VSRP is an internship, not a KAUST degree application",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"VSRP is an internship, not a KAUST degree application"}],[["$","p","KAUST’s admissions page describes VSRP as a research internship lasting 2–6 months, with flexible dates throughout the year. This is different from admission to a master’s or PhD degree and its associated fellowship. A degree-intake deadline is not automatically an internship deadline.",{"children":"KAUST’s admissions page describes VSRP as a research internship lasting 2–6 months, with flexible dates throughout the year. This is different from admission to a master’s or PhD degree and its associated fellowship. A degree-intake deadline is not automatically an internship deadline."}],"$L1b"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],false,"$L23","$L24"]}],"$L25"]}]
19:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","internships",{"href":"/internships/","children":[["$","span",null,{"children":"Practical experience"}],["$","h3",null,{"children":"International internships for students and graduates"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/internship-application",{"href":"/guides/internship-application/","children":[["$","span",null,{"children":"Career guide"}],["$","h3",null,{"children":"How to apply for international internships"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","scholarships/kaust",{"href":"/scholarships/kaust/","children":[["$","span",null,{"children":"Official-source graduate guide"}],["$","h3",null,{"children":"KAUST Graduate Admission and Fellowship 2027 guide"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/find-phd-supervisor",{"href":"/guides/find-phd-supervisor/","children":[["$","span",null,{"children":"Applications & opportunity planning"}],["$","h3",null,{"children":"Find a PhD supervisor: shortlist, email and follow up"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
