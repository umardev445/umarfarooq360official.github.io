1e:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"ISTA’s central ISTernship summer fellowship is paused for 2026 and 2027. Year-round scientific internships are separate: contact a suitable group or staff scientist, then follow any formal application instructions. Availability and approval remain conditional."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Read the current route comparison and identify one research group whose actual work matches evidence from your background."]}],"$undefined"]}],["$","figure",null,{"className":"page-visual day15-guide-visual page-visual--inline","children":[["$","img",null,{"src":"/images/day25/application-workspace-1280.webp","srcSet":"/images/day25/application-workspace-640.webp 640w, /images/day25/application-workspace-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), (max-width: 1150px) calc(100vw - 64px), 760px","width":1280,"height":853,"alt":"Illustrative scene of two students comparing application folders in a library","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Illustrative study scene. The people do not represent this programme or university."}]]}],false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","The summer pause does not close every research route",{"href":"#section-1","children":"The summer pause does not close every research route"}],["$","a","Check the year-round scope before writing to a group",{"href":"#section-2","children":"Check the year-round scope before writing to a group"}],["$","a","Build a research-fit worksheet from work you have read",{"href":"#section-3","children":"Build a research-fit worksheet from work you have read"}],["$","a","Write a focused enquiry with dates that can work",{"href":"#section-4","children":"Write a focused enquiry with dates that can work"}],["$","a","A positive reply begins another stage",{"href":"#section-5","children":"A positive reply begins another stage"}],["$","a","Compare the offered terms with the costs you will face",{"href":"#section-6","children":"Compare the offered terms with the costs you will face"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","The summer pause does not close every research route",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"The summer pause does not close every research route"}],[["$","p","The owner’s internship overview says the central ISTernship fellowship is paused for 2026 and 2027. It distinguishes year-round scientific internships, which use direct contact and are not affected by that pause. Do not publish a summer 2027 deadline by copying an older central call.",{"children":"The owner’s internship overview says the central ISTernship fellowship is paused for 2026 and 2027. It distinguishes year-round scientific internships, which use direct contact and are not affected by that pause. Do not publish a summer 2027 deadline by copying an older central call."}],["$","p","Begin your private record with the route name. If a search result says ISTernship, check whether it refers to the paused central programme or a scientific internship arranged with a group. A promising old article is not a current vacancy, and an invitation to contact a professor is not a guarantee that the group has space.",{"children":"Begin your private record with the route name. If a search result says ISTernship, check whether it refers to the paused central programme or a scientific internship arranged with a group. A promising old article is not a current vacancy, and an invitation to contact a professor is not a guarantee that the group has space."}]],"$undefined","$L20","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]]}],false,false,false,false,"$L21",false,"$L22","$L23"]}],"$L24"]}]
