25:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original group-fit preparation worksheet","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original group-fit preparation worksheet"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Field",{"scope":"col","children":"Field"}],["$","th","Your note",{"scope":"col","children":"Your note"}],["$","th","Check",{"scope":"col","children":"Check"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Research connection"}],["$","td","1",{"children":"One specific question from group work"}],["$","td","2",{"children":"Source actually read"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Existing evidence"}],["$","td","1",{"children":"Project, method and personal contribution"}],["$","td","2",{"children":"Can you explain the work?"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Training gap"}],["$","td","1",{"children":"Technique you need to learn"}],["$","td","2",{"children":"Realistic within the proposed stay"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Possible contribution"}],["$","td","1",{"children":"A bounded task to discuss"}],["$","td","2",{"children":"No invented access or project promise"}]],"$undefined"]}]]}]]}]}],"$undefined"]
26:["$","section","3-Write a focused enquiry with dates that can work",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Write a focused enquiry with dates that can work"}],[["$","p","Use a short message that names the research connection, explains your relevant background and gives a realistic availability window. Follow the owner’s requested attachments and file format. This original drafting exercise is not a letter written as if the group has already agreed to host you.",{"children":"Use a short message that names the research connection, explains your relevant background and gives a realistic availability window. Follow the owner’s requested attachments and file format. This original drafting exercise is not a letter written as if the group has already agreed to host you."}],["$","p","A useful enquiry might connect a previous experimental task to one technique in the group’s work and ask whether a bounded project could be suitable during the proposed period. State any limitation honestly. If your experience is a course project, call it a course project. Do not claim employment, a publication or independent laboratory expertise you do not possess.",{"children":"A useful enquiry might connect a previous experimental task to one technique in the group’s work and ask whether a bounded project could be suitable during the proposed period. State any limitation honestly. If your experience is a course project, call it a course project. Do not claim employment, a publication or independent laboratory expertise you do not possess."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
27:["$","section","4-A positive reply begins another stage",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"A positive reply begins another stage"}],[["$","p","Keep enquiry, academic discussion, formal application and appointment approval as separate statuses. If a group asks for more information through a portal, complete that task under its actual instructions. An email expressing interest should not be treated as an employment contract or permission to arrange travel.",{"children":"Keep enquiry, academic discussion, formal application and appointment approval as separate statuses. If a group asks for more information through a portal, complete that task under its actual instructions. An email expressing interest should not be treated as an employment contract or permission to arrange travel."}],["$","p","Use a dependency calendar rather than a single arrival date. Record when the group needs material, when the formal system must be complete and which conditions must be resolved before a start can be confirmed. If a proposed start becomes unrealistic, ask whether another period is feasible instead of shortening required lead time in your own plan.",{"children":"Use a dependency calendar rather than a single arrival date. Record when the group needs material, when the formal system must be complete and which conditions must be resolved before a start can be confirmed. If a proposed start becomes unrealistic, ask whether another period is feasible instead of shortening required lead time in your own plan."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original enquiry-to-appointment timeline","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original enquiry-to-appointment timeline"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Stage",{"scope":"col","children":"Stage"}],["$","th","Evidence",{"scope":"col","children":"Evidence"}],["$","th","Remaining dependency",{"scope":"col","children":"Remaining dependency"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Research enquiry"}],["$","td","1",{"children":"Focused message and proposed dates"}],["$","td","2",{"children":"Group interest"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Formal file requested"}],["$","td","1",{"children":"Owner’s portal instructions"}],["$","td","2",{"children":"Complete assessment"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Appointment confirmed"}],["$","td","1",{"children":"Official terms and start"}],["$","td","2",{"children":"Arrival and administrative conditions"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Travel planning"}],["$","td","1",{"children":"Confirmed instructions"}],["$","td","2",{"children":"Personal document and housing tasks"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
28:["$","section","5-Compare the offered terms with the costs you will face",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Compare the offered terms with the costs you will face"}],[["$","p","The owner distinguishes employed scientific interns from externally funded visiting-student arrangements. Keep the category and written terms visible. A salary figure described as gross is not take-home money, and the fact that accommodation exists does not establish a free or allocated room.",{"children":"The owner distinguishes employed scientific interns from externally funded visiting-student arrangements. Keep the category and written terms visible. A salary figure described as gross is not take-home money, and the fact that accommodation exists does not establish a free or allocated room."}],["$","p","Before accepting, prepare a private arrival budget with travel, initial housing, deposit and costs due before the first payment. Use actual quotes and the institution’s instructions, not a generic scholarship total. An internship also does not provide preferential PhD admission; if a later doctorate interests you, research that separate programme on its own criteria.",{"children":"Before accepting, prepare a private arrival budget with travel, initial housing, deposit and costs due before the first payment. Use actual quotes and the institution’s instructions, not a generic scholarship total. An internship also does not provide preferential PhD admission; if a later doctorate interests you, research that separate programme on its own criteria."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Compare the offered terms with the costs you will face","children":[["$","$L5","/guides/internship-application/",{"href":"/guides/internship-application/","children":["Prepare an internship application",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/internships/",{"href":"/internships/","children":["Compare research placements",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/find-phd-supervisor/",{"href":"/guides/find-phd-supervisor/","children":["Plan a research enquiry",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
