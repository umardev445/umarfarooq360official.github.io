20:["$","p","Look for a named organisation, a specific manager or team, defined learning outcomes and a clear recruitment process. Avoid opportunities that ask candidates to pay for equipment, training or guaranteed placement.",{"children":"Look for a named organisation, a specific manager or team, defined learning outcomes and a clear recruitment process. Avoid opportunities that ask candidates to pay for equipment, training or guaranteed placement."}]
21:["$","ul",null,{"children":[["$","li","Country and time-zone eligibility",{"children":"Country and time-zone eligibility"}],["$","li","Paid, unpaid or academic-credit arrangement",{"children":"Paid, unpaid or academic-credit arrangement"}],["$","li","Mentoring and feedback structure",{"children":"Mentoring and feedback structure"}],["$","li","Data security and equipment requirements",{"children":"Data security and equipment requirements"}],["$","li","A verifiable company careers page",{"children":"A verifiable company careers page"}]]}]
22:["$","section","2-Remote is a work arrangement, not an eligibility promise",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Remote is a work arrangement, not an eligibility promise"}],[["$","p","An employer may describe a role as remote while limiting applicants to countries where it has payroll, tax or data-security arrangements. Hybrid roles can also require regular attendance at a named office. Check the vacancy location and right-to-work wording before tailoring an application.",{"children":"An employer may describe a role as remote while limiting applicants to countries where it has payroll, tax or data-security arrangements. Hybrid roles can also require regular attendance at a named office. Check the vacancy location and right-to-work wording before tailoring an application."}],["$","p","If the listing is unclear, ask recruitment whether you can work from your country, whether relocation is expected and which working hours are mandatory. Do not assume that an international organisation can hire from every jurisdiction.",{"children":"If the listing is unclear, ask recruitment whether you can work from your country, whether relocation is expected and which working hours are mandatory. Do not assume that an international organisation can hire from every jurisdiction."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Permitted country or region",{"children":"Permitted country or region"}],["$","li","Required time-zone overlap",{"children":"Required time-zone overlap"}],["$","li","Employee, intern or contractor status",{"children":"Employee, intern or contractor status"}],["$","li","Stipend currency and payment method",{"children":"Stipend currency and payment method"}],["$","li","Equipment and internet responsibility",{"children":"Equipment and internet responsibility"}],["$","li","Supervision and feedback schedule",{"children":"Supervision and feedback schedule"}]]}],"$undefined","$undefined","$undefined"]}]
23:["$","section","3-Avoid virtual-internship scams",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Avoid virtual-internship scams"}],[["$","p","Verify the vacancy on the organisation's own careers domain. Treat requests to buy equipment from a named seller, pay a placement fee, deposit a cheque or share online-banking credentials as serious warning signs. A legitimate employer should explain the role, selection process and supervisor before requesting sensitive onboarding data.",{"children":"Verify the vacancy on the organisation's own careers domain. Treat requests to buy equipment from a named seller, pay a placement fee, deposit a cheque or share online-banking credentials as serious warning signs. A legitimate employer should explain the role, selection process and supervisor before requesting sensitive onboarding data."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
