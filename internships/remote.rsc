25:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Does remote mean I can work from any country?",{"children":[["$","summary",null,{"children":["Does remote mean I can work from any country?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Payroll, tax, labour, data and time-zone rules can limit the eligible work location. Check the official vacancy and obtain written clarification when the wording is ambiguous."}]]}],["$","details","How can I judge the quality of a remote internship?",{"children":[["$","summary",null,{"children":["How can I judge the quality of a remote internship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Look for defined work, a named team, scheduled supervision, feedback, realistic hours and a verifiable application process. Avoid programmes whose main purpose appears to be selling a certificate."}]]}]]}]]}]
