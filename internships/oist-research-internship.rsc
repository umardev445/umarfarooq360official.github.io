22:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"OIST research internships are laboratory placements, separate from PhD admission. The owner lists Spring 2027’s cutoff as 15 October 2026 and Fall 2027’s as 15 April 2027, both at 23:59 JST. Verify the current portal before applying."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose the correct placement window, identify a research-unit match and arrange the referee dependency before final submission."]}],"$undefined"]}],false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Choose the placement round before preparing the application",{"href":"#section-1","children":"Choose the placement round before preparing the application"}],["$","a","Internship or PhD: identify the task you actually need",{"href":"#section-2","children":"Internship or PhD: identify the task you actually need"}],["$","a","Build a unit-fit worksheet from evidence you can explain",{"href":"#section-3","children":"Build a unit-fit worksheet from evidence you can explain"}],["$","a","Prepare documents and unlock the referee dependency",{"href":"#section-4","children":"Prepare documents and unlock the referee dependency"}],["$","a","Budget for support without treating every da