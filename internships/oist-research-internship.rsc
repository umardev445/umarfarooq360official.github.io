1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/internships/oist-research-internship/\",\"name\":\"OIST Research Internship: rounds, research fit and application evidence\",\"description\":\"Separate OIST internship and PhD rounds. Check the placement window, research-unit fit, documents, referee handoff and funding with an original planning worksheet.\",\"url\":\"https://aspirecompass.org/internships/oist-research-internship/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-11-14\",\"dateModified\":\"2026-11-14\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Internships\",\"item\":\"https://aspirecompass.org/internships/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"OIST Research Internship: rounds, research fit and application evidence\",\"item\":\"https://aspirecompass.org/internships/oist-research-internship/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"OIST Research Internship: rounds, research fit and application evidence\",\"description\":\"Separate OIST internship and PhD rounds. Check the placement window, research-unit fit, documents, referee handoff and funding with an original planning worksheet.\",\"datePublished\":\"2026-11-14\",\"dateModified\":\"2026-11-14\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/internships/oist-research-internship/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is the internship deadline the same as the PhD deadline?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. These are separate programmes and application schedules. Use the internship owner page for a placement and the PhD page for doctoral admission.\"}},{\"@type\":\"Question\",\"name\":\"Does an internship guarantee later PhD admission?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Investigate the separate PhD selection process; a placement is research experience, not an admission offer.\"}},{\"@type\":\"Question\",\"name\":\"Can I call an invited reference received?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Check the actual system status and follow OIST’s recommender rules before completing the application.\"}}]}"}}]],["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--guide","children":["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L5",null,{"href":"/","children":"Home"}],"$L1b"]}],"$L1c","$L1d"]}],"$L1e",false,"$L1f","$L20","$L21"]}],false]}]}],false,"$L22","$L23"]}]
