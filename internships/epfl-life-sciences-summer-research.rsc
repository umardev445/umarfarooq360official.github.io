24:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.epfl.ch/schools/sv/education/summer-research-program/how-to-apply/",{"children":["",["$","a",null,{"href":"https://www.epfl.ch/schools/sv/education/summer-research-program/how-to-apply/","target":"_blank","rel":"noreferrer","children":"EPFL application workflow"}]]}],["$","span","https://www.epfl.ch/schools/sv/education/summer-research-program/faqs/",{"children":[" · ",["$","a",null,{"href":"https://www.epfl.ch/schools/sv/education/summer-research-program/faqs/","target":"_blank","rel":"noreferrer","children":"EPFL FAQ and current prompts"}]]}]]]}]
25:["$","section","3-Choose labs through a research question",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Choose labs through a research question"}],[["$","p","For each lab, read its current research description and one relevant paper or project. Record the question, a method you want to understand, evidence of your preparation and a reason the lab fits that learning need. Choosing only by prestige produces little material for a specific scientific answer.",{"children":"For each lab, read its current research description and one relevant paper or project. Record the question, a method you want to understand, evidence of your preparation and a reason the lab fits that learning need. Choosing only by prestige produces little material for a specific scientific answer."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"Original lab-choice planning model"}],[["$","p","0",{"children":"Research question: what does this group investigate? Method: which technique or analytical approach would I learn? Preparation: which course/project gives me a starting point? Contribution: what can I realistically assist with while learning? Evidence: which lab page or paper supports my understanding?"}]],["$","p",null,{"className":"sample-card__note","children":"A planning framework. Do not invent skills, publications, project agreements or supervisor contact."}]]}],"$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Choose labs through a research question","children":[["$","a","/downloads/research-lab-fit-worksheet.csv",{"href":"/downloads/research-lab-fit-worksheet.csv","download":true,"children":["Download research lab-fit worksheet (CSV)",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
26:["$","section","4-Submission and reference handoff",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Submission and reference handoff"}],[["$","p","Use the transcript instructions and the actual portal fields as the final checklist. Ask your referee whether they can respond promptly once the invitation arrives. After submission, save the confirmation and check the reference-management instructions rather than uploading a letter yourself.",{"children":"Use the transcript instructions and the actual portal fields as the final checklist. Ask your referee whether they can respond promptly once the invitation arrives. After submission, save the confirmation and check the reference-management instructions rather than uploading a letter yourself."}],["$","p","For travel, the FAQ says reimbursement occurs after the programme and visa-required participants receive programme instructions. This means funding and cash availability are different questions. Wait for the official invitation and instructions before treating travel or visa arrangements as settled.",{"children":"For travel, the FAQ says reimbursement occurs after the programme and visa-required participants receive programme instructions. This means funding and cash availability are different questions. Wait for the official invitation and instructions before treating travel or visa arrangements as settled."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L27",null,{"id":"internships/epfl-life-sciences-summer-research:section-5","title":"Check your progress","items":["Subject and study-stage rules checked","Programme dates fit your academic calendar","Grade scale/rank evidence understood","Lab-choice answers prepared against current prompts","Transcript files prepared","Referee has agreed and email is checked","Confirmation and reference progress recorded"]}],["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.epfl.ch/schools/sv/education/summer-research-program/faqs/",{"children":["",["$","a",null,{"href":"https://www.epfl.ch/schools/sv/education/summer-research-program/faqs/","target":"_blank","rel":"noreferrer","children":"EPFL reference and travel FAQs"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Submission and reference handoff","children":[["$","$L5","/internships/",{"href":"/internships/","children":["Compare research internship routes",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/recommendation-letter/",{"href":"/guides/recommendation-letter/","children":["Ask a referee professionally",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
