1e:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"EPFL Life Sciences SRP: verified planning facts","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"EPFL Life Sciences SRP: verified planning facts"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Item",{"scope":"col","children":"Item"}],["$","th","Published detail",{"scope":"col","children":"Published detail"}],["$","th","Planning task",{"scope":"col","children":"Planning task"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Programme"}],["$","td","1",{"children":"School of Life Sciences SRP"}],["$","td","2",{"children":"Check related subject and lab fit"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Dates"}],["$","td","1",{"children":"5 July–27 August 2027"}],["$","td","2",{"children":"Check full availability and enrolment"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Application deadline"}],["$","td","1",{"children":"15 November 2026, 23:59 CET"}],["$","td","2",{"children":"Prepare before the closing day"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Evidence"}],["$","td","1",{"children":"Transcript, short answers and one reference"}],["$","td","2",{"children":"Arrange the reference before submitting"}]],"$undefined"]}]]}]]}]}],"$undefined"]
1f:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.epfl.ch/schools/sv/education/summer-research-program/",{"children":["",["$","a",null,{"href":"https://www.epfl.ch/schools/sv/education/summer-research-program/","target":"_blank","rel":"noreferrer","children":"EPFL programme overview"}]]}],["$","span","https://www.epfl.ch/schools/sv/education/summer-research-program/how-to-apply/",{"children":[" · ",["$","a",null,{"href":"https://www.epfl.ch/schools/sv/education/summer-research-program/how-to-apply/","target":"_blank","rel":"noreferrer","children":"EPFL how to apply"}]]}]]]}]
