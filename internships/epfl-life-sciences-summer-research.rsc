1b:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"EPFL’s Life Sciences SRP page lists applications open for 2027, closing 15 November 2026. The programme runs 5 July–27 August 2027. This guide covers Life Sciences SRP specifically, not every EPFL summer scheme."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Read the official eligibility page, prepare your short answers and transcript, and confirm a referee before starting the form."]}],"$undefined"]}],false,false,["$","$L1d",null,{"records":[{"id":"epfl-srp-2027","title":"EPFL Life Sciences Summer Research Program 2027","provider":"EPFL School of Life Sciences","type":"Internship","level":"Student","supportedDegrees":["Bachelor's","Master's"],"country":"Switzerland","region":"Europe","funding":"Funded","status":"Open","deadline":"15 November 2026, 23:59 CET","deadlineDate":"2026-11-15","deadlineAt":"2026-11-15T23:59:00+01:00","summary":"Life-sciences research from 5 July to 27 August 2027. Check enrolment, study stage and the published academic criterion. Prepare short answers and a referee before the one-sitting application. Housing is paid from the stipend.","tags":["Life sciences","Bachelor's and first-year master's","Research","2027"],"source":"https://www.epfl.ch/schools/sv/education/summer-research-program/","sourceLabel":"EPFL official SRP","checked":"1 November 2026","featured":true}]}],null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Dates, subject and study-stage fit",{"href":"#section-1","children":"Dates, subject and study-stage fit"}],["$","a","Stipend is not an extra housing allowance",{"href":"#section-2","children":"Stipend is not an extra housing allowance"}],["$","a","Prepare outside the form, then submit in one sitting",{"href":"#section-3","children":"Prepare outside the form, then submit in one sitting"}],["$","a","Choose labs through a research question",{"href":"#section-4","children":"Choose labs through a research question"}],["$","a","Submission and reference handoff",{"href":"#section-5","children":"Submission and reference handoff"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Dates, subject and study-stage fit",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Dates, subject and study-stage fit"}],[["$","p","The official application page gives 15 November 2026 at 23:59 CET as the deadline. It targets enrolled life-sciences-related students who will have completed at least two undergraduate years through the first master’s year by the programme start. It lists a 3.75/4.0 equivalent or top-5% academic criterion. Read the FAQ for borderline or unusual grading situations rather than claiming eligibility from an approximate calculator.",{"children":"The official application page gives 15 November 2026 at 23:59 CET as the deadline. It targets enrolled life-sciences-related students who will have completed at least two undergraduate years through the first master’s year by the programme start. It lists a 3.75/4.0 equivalent or top-5% academic criterion. Read the FAQ for borderline or unusual grading situations rather than claiming eligibility from an approximate calculator."}]],"$undefined","$L1e","$undefined","$undefined","$undefined","$undefined","$L1f","$undefined"]}]]}],"$L20",false,false,false,"$L21",false,"$L22",null]}],"$L23"]}]
