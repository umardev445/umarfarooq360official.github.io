2c:["$","p","Make a private yes/uncertain/no record against the actual wording. For example, a final-year applicant should establish whether they remain enrolled during their intended placement; an academic transcript alone may not answer that. An uncertain condition needs clarification or a different route, not an invented interpretation in the form.",{"children":"Make a private yes/uncertain/no record against the actual wording. For example, a final-year applicant should establish whether they remain enrolled during their intended placement; an academic transcript alone may not answer that. An uncertain condition needs clarification or a different route, not an invented interpretation in the form."}]
2d:["$","p","Do not send passport numbers or full academic files to an unofficial adviser merely to ask a general eligibility question. The programme owner supplies the authoritative submission channel and decides how your record is assessed.",{"children":"Do not send passport numbers or full academic files to an unofficial adviser merely to ask a general eligibility question. The programme owner supplies the authoritative submission channel and decides how your record is assessed."}]
2e:["$","section","3-Build an original project-fit worksheet from work you actually did",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Build an original project-fit worksheet from work you actually did"}],[["$","p","This worksheet is an AspireCompass preparation exercise, not a CERN selection rubric or a model application to copy. Write one concrete task, your individual contribution, the evidence that exists and the method you hope to learn. Replace broad claims such as “I am expert in AI” with a small, accurate account that a referee could recognise.",{"children":"This worksheet is an AspireCompass preparation exercise, not a CERN selection rubric or a model application to copy. Write one concrete task, your individual contribution, the evidence that exists and the method you hope to learn. Replace broad claims such as “I am expert in AI” with a small, accurate account that a referee could recognise."}],["$","p","Fictional example: a student helped analyse instrument readings in a course project. They removed invalid rows, wrote reproducible checks and compared a baseline model with a simple alternative. They did not design the instrument, lead a laboratory or publish a paper. Their research interest can build on the genuine analysis task without converting it into achievements they do not have.",{"children":"Fictional example: a student helped analyse instrument readings in a course project. They removed invalid rows, wrote reproducible checks and compared a baseline model with a simple alternative. They did not design the instrument, lead a laboratory or publish a paper. Their research interest can build on the genuine analysis task without converting it into achievements they do not have."}],["$","p","Read a current project or department description and identify the connection in your own words. If you cannot explain that connection, revise the shortlist. Keep the learning gap honest: needing supervised training is more informative than pretending to know a method from its name.",{"children":"Read a current project or department description and identify the connection in your own words. If you cannot explain that connection, revise the shortlist. Keep the learning gap honest: needing supervised training is more informative than pretending to know a method from its name."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Build an original project-fit worksheet from work you actually did","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Build an original project-fit worksheet from work you actually did"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Worksheet field",{"scope":"col","children":"Worksheet field"}],["$","th","Fictional example",{"scope":"col","children":"Fictional example"}],["$","th","What still needs checking",{"scope":"col","children":"What still needs checking"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Real task"}],["$","td","1",{"children":"Cleaned and checked a course dataset"}],["$","td","2",{"children":"A report or code sample that may be shared appropriately"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Individual contribution"}],["$","td","1",{"children":"Wrote checks for invalid sensor records"}],["$","td","2",{"children":"A precise description distinguishing individual and group work"}]],"$undefined"]}],"$L32","$L33","$L34"]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2f:["$","section","4-Finish the document dependencies before the final form",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Finish the document dependencies before the final form"}],[["$","p","The standard vacancy asks for a CV, academic reference, enrolment certificate and official transcripts in English or French. The openlab programme page also specifies labelled PDF files, a recent academic reference and an optional motivation letter. Its instructions say requested documents cannot be added after the application is completed. Read the selected route’s live requirements before using any generic checklist.",{"children":"The standard vacancy asks for a CV, academic reference, enrolment certificate and official transcripts in English or French. The openlab programme page also specifies labelled PDF files, a recent academic reference and an optional motivation letter. Its instructions say requested documents cannot be added after the application is completed. Read the selected route’s live requirements before using any generic checklist."}],["$","p","Start with items controlled by other people. Ask the appropriate academic contact about a genuine reference and obtain the institution’s official enrolment record. Then audit file type, readability, cycle, identity consistency and the permitted language. A folder named “final” is not proof that every file meets the live form’s requirements.",{"children":"Start with items controlled by other people. Ask the appropriate academic contact about a genuine reference and obtain the institution’s official enrolment record. Then audit file type, readability, cycle, identity consistency and the permitted language. A folder named “final” is not proof that every file meets the live form’s requirements."}],["$","p","Use separate states for requested, received, inspected and submitted. A reference request is not a received letter, and a downloaded transcript that will not open is not ready to upload. Keep personal documents private and use the owner’s application route for submission.",{"children":"Use separate states for requested, received, inspected and submitted. A reference request is not a received letter, and a downloaded transcript that will not open is not ready to upload. Keep personal documents private and use the owner’s application route for submission."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Finish the document dependencies before the final form","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Finish the document dependencies before the final form"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Dependency",{"scope":"col","children":"Dependency"}],["$","th","Not yet ready",{"scope":"col","children":"Not yet ready"}],["$","th","Evidence of the next completed state",{"scope":"col","children":"Evidence of the next completed state"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Academic record"}],["$","td","1",{"children":"Requested from institution"}],["$","td","2",{"children":"Official file received, opens and matches your record"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Reference"}],["$","td","1",{"children":"Academic contact has agreed to help"}],["$","td","2",{"children":"Required letter is available through the selected route"}]],"$undefined"]}],"$L35","$L36"]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
30:["$","section","5-Budget the allowance separately from accommodation and payment timing",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Budget the allowance separately from accommodation and payment timing"}],[["$","p","The current listings state CHF 94 per calendar day and health-insurance coverage, with a stated exception for some nationally funded students. They describe travel support as conditional and accommodation help as assistance finding housing. That is not an assurance of a free room. The openlab programme describes its travel allowance as a lump sum at the end of the stay; confirm your own final arrangements.",{"children":"The current listings state CHF 94 per calendar day and health-insurance coverage, with a stated exception for some nationally funded students. They describe travel support as conditional and accommodation help as assistance finding housing. That is not an assurance of a free room. The openlab programme describes its travel allowance as a lump sum at the end of the stay; confirm your own final arrangements."}],["$","p","Original arithmetic exercise: nine weeks contain 63 calendar days, and 63 × CHF 94 is CHF 5,922. This multiplication is not an award quotation. Your contract dates, applicable funding arrangement and payment conditions determine the actual entitlement. Do not apply the same total to a placement with a different duration.",{"children":"Original arithmetic exercise: nine weeks contain 63 calendar days, and 63 × CHF 94 is CHF 5,922. This multiplication is not an award quotation. Your contract dates, applicable funding arrangement and payment conditions determine the actual entitlement. Do not apply the same total to a placement with a different duration."}],["$","p","Create a cash-timing plan as well as a total budget. Suppose an invented housing quote requires a CHF 900 deposit and CHF 1,100 before arrival: the immediate cash need is CHF 2,000 before travel and other costs. A later reimbursement cannot pay that earlier bill. Replace these fictional numbers with verified arrangements and distinguish a refundable deposit from an expense.",{"children":"Create a cash-timing plan as well as a total budget. Suppose an invented housing quote requires a CHF 900 deposit and CHF 1,100 before arrival: the immediate cash need is CHF 2,000 before travel and other costs. A later reimbursement cannot pay that earlier bill. Replace these fictional numbers with verified arrangements and distinguish a refundable deposit from an expense."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
31:["$","section","6-Run a final consistency check before submission",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Run a final consistency check before submission"}],[["$","p","Open your chosen vacancy again and compare its reference with the form you are completing. Check the intended period against enrolment, your claimed skills against your actual contribution, and each file against the live instruction. Correct a mismatch before it becomes part of the submitted record.",{"children":"Open your chosen vacancy again and compare its reference with the form you are completing. Check the intended period against enrolment, your claimed skills against your actual contribution, and each file against the live instruction. Correct a mismatch before it becomes part of the submitted record."}],["$","p","Read every answer as a reviewer who has not seen your private notes. Would they understand what you did, why this route fits and what evidence supports it? Remove unsupported claims and keep the application in your own voice. An original worksheet should help you think clearly, not manufacture a background or a ready-made statement.",{"children":"Read every answer as a reviewer who has not seen your private notes. Would they understand what you did, why this route fits and what evidence supports it? Remove unsupported claims and keep the application in your own voice. An original worksheet should help you think clearly, not manufacture a background or a ready-made statement."}],["$","p","After submission, retain the owner’s confirmation and the final files in a private folder. Continue checking the official channel for any legitimate follow-up. The preparation checklist can establish that you have organised your tasks; it cannot predict selection, assign a project or replace CERN’s decision.",{"children":"After submission, retain the owner’s confirmation and the final files in a private folder. Continue checking the official channel for any legitimate follow-up. The preparation checklist can establish that you have organised your tasks; it cannot predict selection, assign a project or replace CERN’s decision."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
32:["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Learning question"}],["$","td","1",{"children":"How can a processing method remain reliable when inputs change?"}],["$","td","2",{"children":"A current department/project topic that genuinely fits"}]],"$undefined"]}]
33:["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Method gap"}],["$","td","1",{"children":"Need supervised practice in a stated technique"}],["$","td","2",{"children":"An achievable learning aim for the chosen placement"}]],"$undefined"]}]
34:["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Availability"}],["$","td","1",{"children":"An uninterrupted period consistent with enrolment"}],["$","td","2",{"children":"Home-institution confirmation and the selected programme’s dates"}]],"$undefined"]}]
35:["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Enrolment evidence"}],["$","td","1",{"children":"Current status/date requested"}],["$","td","2",{"children":"Certificate covers the relevant student status"}]],"$undefined"]}]
36:["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Final application"}],["$","td","1",{"children":"Draft saved or files chosen"}],["$","td","2",{"children":"Required fields/files complete and owner confirmation retained"}]],"$undefined"]}]
