21:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"At the 15 November 2026 review, CERN’s standard and openlab 2027 vacancy pages offered applications and listed 21 January 2027, 23:59 Geneva time. They are distinct research routes; choose one using the exact vacancy and your evidence, then recheck availability before applying."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Record the job reference, verify the study/enrolment conditions and complete a project-fit and document audit before submitting."]}],"$undefined"]}],"$undefined",false,false,["$","$L23",null,{"records":[{"id":"cern-summer","title":"CERN Summer Student Programme 2027","provider":"CERN","type":"Internship","level":"Student","country":"Switzerland","region":"Europe","funding":"Paid","deadline":"21 January 2027, 23:59 Geneva (CET)","status":"Open","summary":"Standard SUMM-2027 vacancy in Geneva, separate from openlab. Check full-time enrolment, completed study and previous-CERN conditions in the exact vacancy before applying.","tags":["Summer research","Physics","Engineering","Computing"],"source":"https://careers.cern/jobs/cern-summer-student-programme-2026-member-and-non-member-state/","sourceLabel":"CERN official SUMM-2027 vacancy (URL retains older year)","checked":"15 November 2026","supportedDegrees":["Bachelor's","Master's"],"deadlineDate":"2027-01-21","deadlineAt":"2027-01-21T23:59:00+01:00"}]}],null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Start with the 2027 vacancy, not the year inside a web address",{"href":"#section-1","children":"Start with the 2027 vacancy, not the year inside a web address"}],["$","a","Compare the research task before choosing the programme",{"href":"#section-2","children":"Compare the research task before choosing the programme"}],["$","a","Check the study conditions without treating this guide as an eligibility result",{"href":"#section-3","children":"Check the study conditions without treating this guide as an eligibility result"}],["$","a","Build an original project-fit worksheet from work you actually did",{"href":"#section-4","children":"Build an original project-fit worksheet from work you actually did"}],["$","a","Finish the document dependencies before the final form",{"href":"#section-5","children":"Finish the document dependencies before the final form"}],["$","a","Budget the allowance separately from accommodation and payment timing",{"href":"#section-6","children":"Budget the allowance separately from accommodation and payment timing"}],["$","a","Run a final consistency check before submission",{"href":"#section-7","children":"Run a final consistency check before submission"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Start with the 2027 vacancy, not the year inside a web address",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Start with the 2027 vacancy, not the year inside a web address"}],[["$","p","The standard listing is identified as SUMM-2027 and gives an ideal start of 14 June 2027; the openlab listing is SUM-OPENLAB-2027 with an ideal start of 21 June 2027. Both list the same closing instant at this review. The pages’ web addresses retain an older year, so use the body’s programme title, reference and current application link together.",{"children":"The standard listing is identified as SUMM-2027 and gives an ideal start of 14 June 2027; the openlab listing is SUM-OPENLAB-2027 with an ideal start of 21 June 2027. Both list the same closing instant at this review. The pages’ web addresses retain an older year, so use the body’s programme title, reference and current application link together."}],"$L24","$L25"],"$undefined","$L26","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]]}],"$L27",false,false,false,"$L28",false,"$L29","$L2a"]}],"$L2b"]}]
