24:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Research fit: translate a skill into an observable task",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Research fit: translate a skill into an observable task"}],[["$","p","Do not write “interested in physics and technology” and stop there. Choose a type of work you could discuss in detail, identify evidence from your own study and name a skill gap. A small, well-understood exercise is more informative than a list of software packages you have barely used.",{"children":"Do not write “interested in physics and technology” and stop there. Choose a type of work you could discuss in detail, identify evidence from your own study and name a skill gap. A small, well-understood exercise is more informative than a list of software packages you have barely used."}],["$","p","For one row, prepare a short explanation of the input, your method, a check for mistakes and what you could not conclude. If the work was a group assignment, identify your contribution. Use only material you are allowed to share; remove personal data and confidential laboratory records.",{"children":"For one row, prepare a short explanation of the input, your method, a check for mistakes and what you could not conclude. If the work was a group assignment, identify your contribution. Use only material you are allowed to share; remove personal data and confidential laboratory records."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original research-fit worksheet: examples are fictional","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original research-fit worksheet: examples are fictional"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Possible task family",{"scope":"col","children":"Possible task family"}],["$","th","Evidence from a student’s own work",{"scope":"col","children":"Evidence from a student’s own work"}],["$","th","Useful next practice",{"scope":"col","children":"Useful next practice"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Data analysis"}],["$","td","1",{"children":"A laboratory dataset, uncertainty estimate and residual plot"}],["$","td","2",{"children":"Explain why a discarded measurement was excluded"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Scientific software"}],["$","td","1",{"children":"A small simulation with documented inputs and a test"}],["$","td","2",{"children":"Show how a known case exposes a coding error"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Experimental work"}],["$","td","1",{"children":"A measurement log and calibration notes"}],["$","td","2",{"children":"Explain resolution, uncertainty and a failed setup"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Theory or modelling"}],["$","td","1",{"children":"A derivation with stated assumptions"}],["$","td","2",{"children":"Test a limiting case and explain the model’s boundary"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://summerstudents.desy.de/",{"children":["",["$","a",null,{"href":"https://summerstudents.desy.de/","target":"_blank","rel":"noreferrer","children":"DESY: last verified Summer Student Programme page"}]]}]]]}],"$undefined"]}],["$","section","2-Build a compact evidence folder before writing a motivation statement",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Build a compact evidence folder before writing a motivation statement"}],["$L27","$L28"],"$undefined","$undefined","$undefined","$undefined","$undefined","$L29","$undefined","$undefined"]}],"$L2a","$L2b","$L2c"]}]
