tion status"}],["$","span",null,{"children":"At retrieval the page is headed Summer Student Programme 2026 and says applications are closed. No verified 2027 opening or deadline."}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":"$25:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L5","https://summerstudents.desy.de/frequently_asked_questions/",{"href":"https://summerstudents.desy.de/frequently_asked_questions/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"DESY: programme FAQ"}],["$","span",null,{"children":"FAQ mixes 2026 participation details with travel-reimbursement wording explicitly based on 2025. Do not promote that reimbursement formula as a verified future entitlement."}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":"$25:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
