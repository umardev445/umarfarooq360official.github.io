 families"}],["$","a","Use past-cycle instructions for preparation only",{"href":"#section-4","children":"Use past-cycle instructions for preparation only"}],["$","a","Build a research or study plan with evidence",{"href":"#section-5","children":"Build a research or study plan with evidence"}],["$","a","Plan references and accepted language evidence",{"href":"#section-6","children":"Plan references and accepted language evidence"}],["$","a","Document quality matters as much as file presence",{"href":"#section-7","children":"Document quality matters as much as file presence"}],["$","a","Make the funding decision after reading the offer",{"href":"#section-8","children":"Make the funding decision after reading the offer"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Shandong University: what is verified and what is pending",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Shandong University: what is verified and what is pending"}],[],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Shandong University: what is verified and what is pending","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Shandong University: what is verified and what is pending"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route / question",{"scope":"col","children":"Route / question"}],["$","th","Current evidence",{"scope":"col","children":"Current evidence"}],["$","th","What to do",{"scope":"col","children":"What to do"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"General master’s ins