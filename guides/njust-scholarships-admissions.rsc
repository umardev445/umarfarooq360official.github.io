1b:["$","section","1-What the official portal currently shows",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"What the official portal currently shows"}],[["$","p","The official portal reviewed lists 2026 undergraduate and postgraduate admission guides, the 2026 Lanshan Scholarship guide and the 2026 Chinese Government Scholarship Silk Road programme notice. These are identified cycle references, not confirmation that a 2027 application is open.",{"children":"The official portal reviewed lists 2026 undergraduate and postgraduate admission guides, the 2026 Lanshan Scholarship guide and the 2026 Chinese Government Scholarship Silk Road programme notice. These are identified cycle references, not confirmation that a 2027 application is open."}],["$","p","For a new intake, use the newest portal notice and any programme update. If the guide is not yet published, prepare your academic file and shortlist without presenting an estimated opening date as official.",{"children":"For a new intake, use the newest portal notice and any programme update. If the guide is not yet published, prepare your academic file and shortlist without presenting an estimated opening date as official."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1c:["$","section","2-Separate scholarship eligibility from general admission",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Separate scholarship eligibility from general admission"}],[["$","p","Start with the academic entry requirements, then apply the selected scholarship’s additional criteria. A named programme can restrict eligible countries, subjects, degree levels or the application route. Do not assume that everybody eligible for admission qualifies for every award.",{"children":"Start with the academic entry requirements, then apply the selected scholarship’s additional criteria. A named programme can restrict eligible countries, subjects, degree levels or the application route. Do not assume that everybody eligible for admission qualifies for every award."}],["$","p","Compare the support components only after confirming eligibility. Tuition, accommodation, insurance and stipend should be recorded as separate rows and matched to the actual category. Do not combine two guides into an imagined higher funding package.",{"children":"Compare the support components only after confirming eligibility. Tuition, accommodation, insurance and stipend should be recorded as separate rows and matched to the actual category. Do not combine two guides into an imagined higher funding package."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"NJUST routes to verify","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"NJUST routes to verify"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Official guide",{"scope":"col","children":"Official guide"}],["$","th","What to establish",{"scope":"col","children":"What to establish"}],["$","th","Avoid this assumption",{"scope":"col","children":"Avoid this assumption"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Undergraduate admission"}],["$","td","1",{"children":"School qualification, subjects, language and examination requirements"}],["$","td","2",{"children":"Postgraduate rules also apply to bachelor’s applicants"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Postgraduate admission"}],["$","td","1",{"children":"Previous degree, programme and research requirements"}],["$","td","2",{"children":"An informal supervisor reply is an offer"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Lanshan Scholarship"}],["$","td","1",{"children":"Current degree and award conditions"}],["$","td","2",{"children":"The name alone confirms full coverage"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"CSC Silk Road"}],["$","td","1",{"children":"Eligible profile, subjects and required systems"}],["$","td","2",{"children":"The award is available to every nationality"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","3-Build the academic application",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Build the academic application"}],[["$","p","Collect identity, qualification and transcript evidence for the correct degree. Add the grading scale and required translations. For postgraduate research, connect your study plan to a feasible field and available supervision rather than submitting a generic destination essay.",{"children":"Collect identity, qualification and transcript evidence for the correct degree. Add the grading scale and required translations. For postgraduate research, connect your study plan to a feasible field and available supervision rather than submitting a generic destination essay."}],["$","p","Check whether a supervisor statement, references, language result or other document is mandatory for your chosen route. Requirements can differ by degree, programme and funding scheme. If a document is pending, use only a provisional alternative explicitly accepted by the guide.",{"children":"Check whether a supervisor statement, references, language result or other document is mandatory for your chosen route. Requirements can differ by degree, programme and funding scheme. If a document is pending, use only a provisional alternative explicitly accepted by the guide."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L23",null,{"id":"guides/njust-scholarships-admissions:section-4","title":"Check your progress","items":["University identity and degree confirmed","Current intake guide located","Academic and scholarship criteria checked separately","Documents prepared in the required language and format","Programme-specific examination or supervisor conditions checked"]}],"$undefined","$undefined"]}]
1e:["$","section","4-Application fee, deadline and portal completion",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Application fee, deadline and portal completion"}],[["$","p","Check the current programme guide and portal for any application charge and the final submission conditions. Do not promise that NJUST is fee-free because a different Chinese university waives an application fee or an older scholarship article says so.",{"children":"Check the current programme guide and portal for any application charge and the final submission conditions. Do not promise that NJUST is fee-free because a different Chinese university waives an application fee or an older scholarship article says so."}],["$","p","If the route requires both a scholarship-system record and an NJUST application, complete each step under its own instructions. Save payment evidence where applicable, the final application receipt and any documents requested later.",{"children":"If the route requires both a scholarship-system record and an NJUST application, complete each step under its own instructions. Save payment evidence where applicable, the final application receipt and any documents requested later."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Application fee, deadline and portal completion","children":[["$","$L4","/guides/csc-scholarship-application/",{"href":"/guides/csc-scholarship-application/","children":["CSC application and separate systems",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/csca-exam/",{"href":"/guides/csca-exam/","children":["CSCA undergraduate examination checks",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1f:["$","section","5-After selection: read the award, not the advertisement",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"After selection: read the award, not the advertisement"}],[["$","p","Read the written admission conditions and funding duration. Check continuation, housing charges and expenses before the first payment. Ask the official university office about unclear conditions using your application number.",{"children":"Read the written admission conditions and funding duration. Check continuation, housing charges and expenses before the first payment. Ask the official university office about unclear conditions using your application number."}],["$","p","Then prepare study-visa documents and arrival tasks. A scholarship or admission decision is not a visa guarantee, and the physical-examination form has its own document instructions. Keep these records connected but separate.",{"children":"Then prepare study-visa documents and arrival tasks. A scholarship or admission decision is not a visa guarantee, and the physical-examination form has its own document instructions. Keep these records connected but separate."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for After selection: read the award, not the advertisement","children":[["$","$L4","/guides/china-student-visa-x1-x2/",{"href":"/guides/china-student-visa-x1-x2/","children":["China study visa",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/china-tuition-fees-living-costs/",{"href":"/guides/china-tuition-fees-living-costs/","children":["China study-cost worksheet",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
