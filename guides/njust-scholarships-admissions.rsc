19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/expansion-20261022/china-njust-1280.webp","srcSet":"/images/expansion-20261022/china-njust-640.webp 640w, /images/expansion-20261022/china-njust-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Pink blossoms on trees in Nanjing","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Destination or study photograph; not a photograph of the named university or scholarship."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"The NJUST official portal publishes separate undergraduate, postgraduate and scholarship guides. Match your degree and programme to the current route; a Silk Road or university award can have narrower conditions than general admission."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Open the official NJUST portal and choose the newest guide for your degree, then read the scholarship notice separately."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Get the university identity right",{"href":"#section-1","children":"Get the university identity right"}],["$","a","What the official portal currently shows",{"href":"#section-2","children":"What the official portal currently shows"}],["$","a","Separate scholarship eligibility from general admission",{"href":"#section-3","children":"Separate scholarship eligibility from general admission"}],["$","a","Build the academic application",{"href":"#section-4","children":"Build the academic application"}],["$","a","Application fee, deadline and portal completion",{"href":"#section-5","children":"Application fee, deadline and portal completion"}],["$","a","After selection: read the award, not the advertisement",{"href":"#section-6","children":"After selection: read the award, not the advertisement"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Get the university identity right",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Get the university identity right"}],[["$","p","Several Chinese institutions have similar English names. Confirm Nanjing University of Science and Technology, its official njust.edu.cn domain and your intended programme. Do not reuse an agency number, deadline or award description from Nanjing University or another university of science and technology.",{"children":"Several Chinese institutions have similar English names. Confirm Nanjing University of Science and Technology, its official njust.edu.cn domain and your intended programme. Do not reuse an agency number, deadline or award description from Nanjing University or another university of science and technology."}],["$","p","Record the exact degree and teaching language. A university name in a scholarship search result does not establish that the advertised degree is offered in the format or intake you need.",{"children":"Record the exact degree and teaching language. A university name in a scholarship search result does not establish that the advertised degree is offered in the format or intake you need."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1b","$L1c","$L1d","$L1e","$L1f"]}],false,"$L20","$L21"]}],"$L22"]}]
