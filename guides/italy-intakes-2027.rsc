26:["$","section","2-Why January and February searches need a course-level check",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Why January and February searches need a course-level check"}],[["$","p","A page headed January intake may be discussing a deadline in January rather than classes beginning then. Ask the admissions office to identify the actual teaching start and whether new non-EU students applying from abroad are admitted at that start.",{"children":"A page headed January intake may be discussing a deadline in January rather than classes beginning then. Ask the admissions office to identify the actual teaching start and whether new non-EU students applying from abroad are admitted at that start."}],["$","p","Padua explicitly describes autumn entry and no direct second-semester admission. PoliMi has programme-specific semester arrangements; do not apply an engineering option to architecture, design or every university. Where the programme’s current call does not establish a February start, keep the option unconfirmed.",{"children":"Padua explicitly describes autumn entry and no direct second-semester admission. PoliMi has programme-specific semester arrangements; do not apply an engineering option to architecture, design or every university. Where the programme’s current call does not establish a February start, keep the option unconfirmed."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.unipd.it/en/ammissione-studenti-internazionali",{"children":["",["$","a",null,{"href":"https://www.unipd.it/en/ammissione-studenti-internazionali","target":"_blank","rel":"noreferrer","children":"Padua international admissions"}]]}],["$","span","https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification/deadlines",{"children":[" · ",["$","a",null,{"href":"https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification/deadlines","target":"_blank","rel":"noreferrer","children":"PoliMi master's deadlines and fee periods"}]]}]]]}],"$undefined"]}]
27:["$","section","3-Resolve your applicant category before choosing a round",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Resolve your applicant category before choosing a round"}],[["$","p","Nationality alone may not define the route. An EU applicant, a non-EU citizen already holding an eligible Italian residence status and a non-EU applicant who needs a visa from abroad can face different windows. A later call restricted to residents is not a workaround for a missed abroad deadline.",{"children":"Nationality alone may not define the route. An EU applicant, a non-EU citizen already holding an eligible Italian residence status and a non-EU applicant who needs a visa from abroad can face different windows. A later call restricted to residents is not a workaround for a missed abroad deadline."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Record citizenship, country of qualification and current residence status.",{"children":"Record citizenship, country of qualification and current residence status."}],["$","li","Copy the exact applicant-category wording from the course call.",{"children":"Copy the exact applicant-category wording from the course call."}],["$","li","Check restricted versus unrestricted access and any entrance test.",{"children":"Check restricted versus unrestricted access and any entrance test."}],["$","li","Save the submission closing time and the time zone when the call supplies one.",{"children":"Save the submission closing time and the time zone when the call supplies one."}],["$","li","Ask admissions about an unresolved category before paying.",{"children":"Ask admissions about an unresolved category before paying."}]]}],"$undefined","$undefined","$undefined"]}]
28:["$","section","4-Keep admission, scholarship and visa dates in separate rows",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Keep admission, scholarship and visa dates in separate rows"}],[["$","p","A course offer, a regional scholarship application and Universitaly pre-enrolment are separate tasks. Regional benefits can close while academic applications continue. Admission does not guarantee funding, housing or a visa.",{"children":"A course offer, a regional scholarship application and Universitaly pre-enrolment are separate tasks. Regional benefits can close while academic applications continue. Admission does not guarantee funding, housing or a visa."}],["$","p","Universitaly pre-enrolment is free. It does not replace the visa application to the competent diplomatic mission. The national procedures give outer visa dates for particular degree cycles, but universities and missions can require earlier action. Use the deadline that actually governs your course and consular process.",{"children":"Universitaly pre-enrolment is free. It does not replace the visa application to the competent diplomatic mission. The national procedures give outer visa dates for particular degree cycles, but universities and missions can require earlier action. Use the deadline that actually governs your course and consular process."}]],["$","ol",null,{"className":"process-steps","aria-label":"Keep admission, scholarship and visa dates in separate rows","children":[["$","li","Choose course, teaching start and applicant category.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Choose course, teaching start and applicant category."}]]}],["$","li","Complete the programme’s admission and test requirements.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Complete the programme’s admission and test requirements."}]]}],["$","li","Track scholarship and overseas financial-document deadlines separately.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Track scholarship and overseas financial-document deadlines separately."}]]}],["$","li","Follow Universitaly and the competent mission’s current instructions.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Follow Universitaly and the competent mission’s current instructions."}]]}],["$","li","Confirm final enrolment, originals and permitted arrival with the university.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Confirm final enrolment, originals and permitted arrival with the university."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.universitaly.org/en/studenti-stranieri",{"children":["",["$","a",null,{"href":"https://www.universitaly.org/en/studenti-stranieri","target":"_blank","rel":"noreferrer","children":"Universitaly official international procedures"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Keep admission, scholarship and visa dates in separate rows","children":[["$","$L4","/guides/italy-university-application-deadlines/",{"href":"/guides/italy-university-application-deadlines/","children":["Detailed Italy application deadlines",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/universitaly-pre-enrolment/",{"href":"/guides/universitaly-pre-enrolment/","children":["Universitaly sequence",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/dsu-italy-deadlines-by-region/",{"href":"/guides/dsu-italy-deadlines-by-region/","children":["DSU dates by authority","$L2d"]}]]}]]}]
29:["$","section","5-Two planning cases",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Two planning cases"}],[["$","p","Case A — autumn Padua applicant: a fictional non-EU student abroad identifies a suitable programme in the first 2027/28 call. They check qualification fit and language evidence, apply within the eligible window and start a separate funding tracker. They do not treat a later resident-only call as a backup.",{"children":"Case A — autumn Padua applicant: a fictional non-EU student abroad identifies a suitable programme in the first 2027/28 call. They check qualification fit and language evidence, apply within the eligible window and start a separate funding tracker. They do not treat a later resident-only call as a backup."}],["$","p","Case B — possible second-semester applicant: a fictional engineering graduate finds a PoliMi semester option. Before budgeting travel, they confirm the exact degree, foreign-qualification procedure, visa category and teaching start. The same option cannot be transferred to an unrelated design programme.",{"children":"Case B — possible second-semester applicant: a fictional engineering graduate finds a PoliMi semester option. Before budgeting travel, they confirm the exact degree, foreign-qualification procedure, visa category and teaching start. The same option cannot be transferred to an unrelated design programme."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"A deadline of 15 November 2026 for a 2027/28 programme is an application date in 2026, not evidence that teaching starts in November 2026."}]]}],"$undefined","$undefined","$undefined","$undefined"]}]
2a:["$","section","6-What to do when official pages disagree",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"What to do when official pages disagree"}],[["$","p","The Padua English application page retrieved during this review printed a call-two range beginning in December 2027 and ending in March 2027. The Italian-language version instead states 1 December 2026–1 March 2027. The table above identifies that source explicitly. The governing programme call and admissions clarification should settle an individual application.",{"children":"The Padua English application page retrieved during this review printed a call-two range beginning in December 2027 and ending in March 2027. The Italian-language version instead states 1 December 2026–1 March 2027. The table above identifies that source explicitly. The governing programme call and admissions clarification should settle an individual application."}],["$","p","A mismatched year heading was also visible beside some PoliMi engineering dates. Rather than extend that ambiguity to every applicant, use the selected programme’s current notice. Keep a saved copy and check for amendments.",{"children":"A mismatched year heading was also visible beside some PoliMi engineering dates. Rather than extend that ambiguity to every applicant, use the selected programme’s current notice. Keep a saved copy and check for amendments."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.unipd.it/en/studiare-inglese-come-fare-domanda",{"children":["",["$","a",null,{"href":"https://www.unipd.it/en/studiare-inglese-come-fare-domanda","target":"_blank","rel":"noreferrer","children":"Padua English application instructions"}]]}],["$","span","https://www.unipd.it/studiare-inglese-come-fare-domanda",{"children":[" · ",["$","a",null,{"href":"https://www.unipd.it/studiare-inglese-come-fare-domanda","target":"_blank","rel":"noreferrer","children":"Padua Italian-language version of English-course instructions"}]]}],["$","span","https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification/deadlines",{"children":[" · ",["$","a",null,{"href":"https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification/deadlines","target":"_blank","rel":"noreferrer","children":"PoliMi master's deadlines and fee periods"}]]}]]]}],"$undefined"]}]
2b:["$","section","7-Your intake decision checklist",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Your intake decision checklist"}],[["$","p","A usable shortlist entry should identify one course start, one applicant route and a sequence you can complete. If one is uncertain, record a question instead of presenting the date as confirmed.",{"children":"A usable shortlist entry should identify one course start, one applicant route and a sequence you can complete. If one is uncertain, record a question instead of presenting the date as confirmed."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2e",null,{"id":"guides/italy-intakes-2027:section-8","title":"Check your progress","items":["Actual new-entry teaching start confirmed.","Current programme call and academic year saved.","My nationality/residence category is eligible for this round.","Test, language and document requirements recorded.","Funding, pre-enrolment and visa dates are separate."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Your intake decision checklist","children":[["$","$L4","/guides/study-in-italy-admission-english-requirements/",{"href":"/guides/study-in-italy-admission-english-requirements/","children":["Italy admission and English evidence",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/italy-university-application-fees/",{"href":"/guides/italy-university-application-fees/","children":["Compare application payments",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
