1b:["$","p","Use the current university page to reach application, registration and payment services. Save assessment outcomes and any message telling you which office must register or approve the next stage. A portal account alone does not establish admission.",{"children":"Use the current university page to reach application, registration and payment services. Save assessment outcomes and any message telling you which office must register or approve the next stage. A portal account alone does not establish admission."}]
1c:["$","ol",null,{"className":"process-steps","aria-label":"Understand the non-EU admission sequence","children":[["$","li","Select the official degree and current intake",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Select the official degree and current intake"}]]}],["$","li","Check academic and language requirements",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Check academic and language requirements"}]]}],["$","li","Complete the programme’s assessment/application route",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Complete the programme’s assessment/application route"}]]}],["$","li","Follow the international-office enrolment instructions",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Follow the international-office enrolment instructions"}]]}],["$","li","Complete visa-track and final registration tasks where applicable",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Complete visa-track and final registration tasks where applicable"}]]}]]}]
1d:["$","section","2-Funding: DSU Toscana and targeted Florence calls",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Funding: DSU Toscana and targeted Florence calls"}],[["$","p","For the regional route, use DSU Toscana’s annual competition and foreign-student instructions. The documents and renewal rules are determined there rather than by a generic “fully funded Florence” article.",{"children":"For the regional route, use DSU Toscana’s annual competition and foreign-student instructions. The documents and renewal rules are determined there rather than by a generic “fully funded Florence” article."}],["$","p","Florence also publishes specific scholarship opportunities. Some calls support a particular population or partnership; the existence of a scholarship page does not make every call available to every international applicant. Build your shortlist using nationality, residence, degree and subject conditions.",{"children":"Florence also publishes specific scholarship opportunities. Some calls support a particular population or partnership; the existence of a scholarship page does not make every call available to every international applicant. Build your shortlist using nationality, residence, degree and subject conditions."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Which route should you investigate?","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Which route should you investigate?"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Your need",{"scope":"col","children":"Your need"}],["$","th","Start here",{"scope":"col","children":"Start here"}],["$","th","Check before applying",{"scope":"col","children":"Check before applying"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Regional living-cost support"}],["$","td","1",{"children":"DSU Toscana"}],["$","td","2",{"children":"Income, assets, merit, institution and deadlines"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"A named university award"}],["$","td","1",{"children":"Florence scholarship notice"}],["$","td","2",{"children":"Target group, benefit and selection"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Admission to a degree"}],["$","td","1",{"children":"Programme admission page"}],["$","td","2",{"children":"Qualification, language and assessment"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Tuition adjustment"}],["$","td","1",{"children":"University fee rules"}],["$","td","2",{"children":"Applicant category and document deadline"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Funding: DSU Toscana and targeted Florence calls","children":[["$","$L4","/scholarships/dsu-toscana/",{"href":"/scholarships/dsu-toscana/","children":["DSU Toscana documents and renewal",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1e:["$","section","3-Prepare a qualification file that answers the course requirements",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Prepare a qualification file that answers the course requirements"}],[["$","p","Collect the qualification, transcript and grading information required for your level. For a subject-based master’s assessment, the course descriptions may be more useful than a generic statement saying that your degree is related. Follow the actual document list.",{"children":"Collect the qualification, transcript and grading information required for your level. For a subject-based master’s assessment, the course descriptions may be more useful than a generic statement saying that your degree is related. Follow the actual document list."}],["$","p","Check translation and qualification-verification instructions before ordering paid services. If a university accepts one form of evidence for pre-assessment but asks for another at enrolment, record that distinction. A conditional acceptance should be read with all its remaining conditions.",{"children":"Check translation and qualification-verification instructions before ordering paid services. If a university accepts one form of evidence for pre-assessment but asks for another at enrolment, record that distinction. A conditional acceptance should be read with all its remaining conditions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Prepare a qualification file that answers the course requirements","children":[["$","$L4","/guides/cimea-vs-declaration-of-value-italy/",{"href":"/guides/cimea-vs-declaration-of-value-italy/","children":["Qualification evidence: CIMEA and Declaration of Value",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1f:["$","section","4-Build a calendar with separate owners",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Build a calendar with separate owners"}],[["$","p","Create rows for programme selection, academic assessment, scholarship request, fee evidence, Universitaly and visa steps. Assign each row to the university, DSU or diplomatic mission. The office that admits you may not be able to extend a regional scholarship deadline.",{"children":"Create rows for programme selection, academic assessment, scholarship request, fee evidence, Universitaly and visa steps. Assign each row to the university, DSU or diplomatic mission. The office that admits you may not be able to extend a regional scholarship deadline."}],["$","p","Where an official notice is for 2026/27, keep that year in your records. Do not predict a 2027/28 date by copying the old day and month. If a new call is not published, use preparation tasks without presenting the opportunity as currently open.",{"children":"Where an official notice is for 2026/27, keep that year in your records. Do not predict a 2027/28 date by copying the old day and month. If a new call is not published, use preparation tasks without presenting the opportunity as currently open."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","5-Housing and financial decisions before departure",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Housing and financial decisions before departure"}],[["$","p","Florence accommodation needs an actual quote and a clear contract. Compare room type, location, transport and deposit. A regional housing application is not a confirmed address, and a benefit award does not necessarily arrive before your first rent payment.",{"children":"Florence accommodation needs an actual quote and a clear contract. Compare room type, location, transport and deposit. A regional housing application is not a confirmed address, and a benefit award does not necessarily arrive before your first rent payment."}],["$","p","Prepare a funding gap using tuition, living costs and one-off arrival expenses. Keep requested scholarships separate from confirmed funding. This lets you compare Florence with Pisa and Siena using the same categories.",{"children":"Prepare a funding gap using tuition, living costs and one-off arrival expenses. Keep requested scholarships separate from confirmed funding. This lets you compare Florence with Pisa and Siena using the same categories."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L24",null,{"id":"guides/university-of-florence-admissions-scholarships:section-6","title":"Check your progress","items":["Correct university and degree verified","Academic assessment outcome retained","DSU and university funding checked separately","Qualification services ordered only when required","Arrival budget includes a housing contingency"]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Housing and financial decisions before departure","children":[["$","$L4","/guides/university-of-pisa-admissions-scholarships/",{"href":"/guides/university-of-pisa-admissions-scholarships/","children":["Pisa admissions and funding",["$","$L5",null,{"ref":"$undefined","i