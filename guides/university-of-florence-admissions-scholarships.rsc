19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"University of Florence admission depends on the selected degree and applicant profile. DSU Toscana is a separate regional support route; university-specific calls can target a narrower group."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Open the official programme and the international-student route that matches your qualification and visa situation."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Confirm the institution and programme level",{"href":"#section-1","children":"Confirm the institution and programme level"}],["$","a","Understand the non-EU admission sequence",{"href":"#section-2","children":"Understand the non-EU admission sequence"}],["$","a","Funding: DSU Toscana and targeted Florence calls",{"href":"#section-3","children":"Funding: DSU Toscana and targeted Florence calls"}],["$","a","Prepare a qualification file that answers the course requirements",{"href":"#section-4","children":"Prepare a qualification file that answers the course requirements"}],["$","a","Build a calendar with separate owners",{"href":"#section-5","children":"Build a calendar with separate owners"}],["$","a","Housing and financial decisi