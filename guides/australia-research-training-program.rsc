1f:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.education.gov.au/research-block-grants/research-training-program",{"children":["",["$","a",null,{"href":"https://www.education.gov.au/research-block-grants/research-training-program","target":"_blank","rel":"noreferrer","children":"Australian Government: RTP structure and stipend-rate table"}]]}]]]}]
20:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Separate fee offset, stipend and allowances",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Separate fee offset, stipend and allowances"}],[["$","p","RTP support can include one or more components: a fees offset, a stipend and allowances for ancillary research-degree costs. Their functions differ. A tuition offset reduces the research tuition liability; a living stipend is money for general living costs. Neither label should be copied into every line of a personal budget without reading the offer.",{"children":"RTP support can include one or more components: a fees offset, a stipend and allowances for ancillary research-degree costs. Their functions differ. A tuition offset reduces the research tuition liability; a living stipend is money for general living costs. Neither label should be copied into every line of a personal budget without reading the offer."}],["$","p","Use a fictional comparison. Offer A includes a full tuition offset but no living stipend. Offer B includes a stated stipend but leaves its tuition treatment unresolved. A’s living gap remains; B’s tuition question must be answered before the offers are comparable. “RTP recipient” alone does not tell you which components were awarded. Ask the university to identify each component, value and period in writing.",{"children":"Use a fictional comparison. Offer A includes a full tuition offset but no living stipend. Offer B includes a stated stipend but leaves its tuition treatment unresolved. A’s living gap remains; B’s tuition question must be answered before the offers are comparable. “RTP recipient” alone does not tell you which components were awarded. Ask the university to identify each component, value and period in writing."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original component comparison: fictional offers","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original component comparison: fictional offers"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Offer",{"scope":"col","children":"Offer"}],["$","th","Known component",{"scope":"col","children":"Known component"}],["$","th","Unresolved cost",{"scope":"col","children":"Unresolved cost"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"A"}],["$","td","1",{"children":"Tuition offset confirmed"}],["$","td","2",{"children":"Living and arrival funding"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"B"}],["$","td","1",{"children":"Stipend confirmed"}],["$","td","2",{"children":"Tuition treatment and exclusions"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Complete record"}],["$","td","1",{"children":"Each component separately stated"}],["$","td","2",{"children":"Actual personal shortfall"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.education.gov.au/research-block-grants/research-training-program/research-training-program-frequently-asked-questions-students",{"children":["",["$","a",null,{"href":"https://www.education.gov.au/research-block-grants/research-training-program/research-training-program-frequently-asked-questions-students","target":"_blank","rel":"noreferrer","children":"Australian Government: RTP student questions"}]]}]]]}],"$undefined"]}],["$","section","2-Read the 2027 rate bounds without assuming the maximum",{"className":"article-section","id":"section-3","children":["$L24",["$L25","$L26"],"$undefined","$L27","$undefined","$undefined","$undefined","$undefined","$L28","$undefined"]}],"$L29","$L2a","$L2b","$L2c","$L2d","$L2e"]}]
