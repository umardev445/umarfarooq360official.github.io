1b:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Apply through an eligible Australian provider for a research doctorate or research master’s. RTP can cover different components, and the university selects recipients and states the actual award. The published 2027 base and maximum stipend rates are boundaries, not your personal offer."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Find one university’s current research-degree and RTP policy pages, then record tuition, stipend, duration and uncovered costs separately."]}],"$undefined"]}],["$","figure",null,{"className":"page-visual day15-guide-visual page-visual--inline","children":[["$","img",null,{"src":"/images/day15/study-desk-1280.webp","srcSet":"/images/day15/study-desk-640.webp 640w, /images/day15/study-desk-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), (max-width: 1150px) calc(100vw - 64px), 760px","width":1280,"height":853,"alt":"Illustrative scene of students preparing research notes in a library","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Illustrative study scene. The people and setting do not represent this scholarship or university."}]]}],false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Apply through a provider, not a national student form",{"href":"#section-1","children":"Apply through a provider, not a national student form"}],["$","a","Separate fee offset, stipend and allowances",{"href":"#section-2","children":"Separate fee offset, stipend and allowances"}],["$","a","Read the 2027 rate bounds without assuming the maximum",{"href":"#section-3","children":"Read the 2027 rate bounds without assuming the maximum"}],["$","a","Build an original uncovered-cost calculation",{"href":"#section-4","children":"Build an original uncovered-cost calculation"}],["$","a","Compare scholarship duration with candidature",{"href":"#section-5","children":"Compare scholarship duration with candidature"}],["$","a","Treat international eligibility and selection as different questions",{"href":"#section-6","children":"Treat international eligibility and selection as different questions"}],["$","a","Check the offer before accepting or budgeting against it",{"href":"#section-7","children":"Check the offer before accepting or budgeting against it"}],["$","a","Your next useful research-funding task",{"href":"#section-8","children":"Your next useful research-funding task"}],["$","a","Continue with a specific application task",{"href":"#section-9","children":"Continue with a specific application task"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Apply through a provider, not a national student form",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Apply through a provider, not a national student form"}],[["$","p","The Department of Education provides RTP funding to eligible higher education providers for research doctorates and research master’s degrees. Prospective students contact the chosen provider directly; there is no RTP student application to submit to the Department. A taught master’s title is not enough to establish that the degree is an eligible research programme.",{"children":"The Department of Education provides RTP funding to eligible higher education providers for research doctorates and research master’s degrees. Prospective students contact the chosen provider directly; there is no RTP student application to submit to the Department. A taught master’s title is not enough to establish that the degree is an eligible research programme."}],"$L1d"],"$undefined","$L1e","$undefined","$undefined","$undefined","$undefined","$L1f","$undefined"]}]]}],false,false,false,false,"$L20",false,"$L21","$L22"]}],"$L23"]}]
