23:["$","aside",null,{"className":"content-sidebar","children":[["$","div",null,{"className":"sidebar-card sidebar-card--contents","children":[["$","span",null,{"children":"On this page"}],["$","nav",null,{"aria-label":"Page contents","children":[["$","a","Apply through a provider, not a national student form",{"href":"#section-1","children":[["$","b",null,{"children":"01"}],"Apply through a provider, not a national student form"]}],["$","a","Separate fee offset, stipend and allowances",{"href":"#section-2","children":[["$","b",null,{"children":"02"}],"Separate fee offset, stipend and allowances"]}],["$","a","Read the 2027 rate bounds without assuming the maximum",{"href":"#section-3","children":[["$","b",null,{"children":"03"}],"Read the 2027 rate bounds without assuming the maximum"]}],["$","a","Build an original uncovered-cost calculation",{"href":"#section-4","children":[["$","b",null,{"children":"04"}],"Build an original uncovered-cost calculation"]}],["$","a","Compare scholarship duration with candidature",{"href":"#section-5","children":[["$","b",null,{"children":"05"}],"Compare scholarship duration with candidature"]}],["$","a","Treat international eligibility and selection as different questions",{"href":"#section-6","children":[["$","b",null,{"children":"06"}],"Treat international eligibility and selection as different questions"]}],["$","a","Check the offer before accepting or budgeting against it",{"href":"#section-7","children":[["$","b",null,{"children":"07"}],"Check the offer before accepting or budgeting against it"]}],["$","a","Your next useful research-funding task",{"href":"#section-8","children":[["$","b",null,{"children":"08"}],"Your next useful research-funding task"]}],["$","a","Continue with a specific application task",{"href":"#section-9","children":[["$","b",null,{"children":"09"}],"Continue with a specific application task"]}]]}]]}],["$","div",null,{"className":"sidebar-card","children":[["$","h2",null,{"children":"Next useful step"}],[["