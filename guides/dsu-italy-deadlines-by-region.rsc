1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/dsu-italy-deadlines-by-region/\",\"name\":\"DSU Italy deadlines by region: current status and next steps\",\"description\":\"Check regional DSU application status, separate document and housing dates, and prepare for the next call using dated official sources.\",\"url\":\"https://aspirecompass.org/guides/dsu-italy-deadlines-by-region/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/research-20261028/dsu-1280.webp\",\"caption\":\"Illustration of a student organising separate scholarship, housing and financial-document deadline cards\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"DSU Italy deadlines by region: current status and next steps\",\"item\":\"https://aspirecompass.org/guides/dsu-italy-deadlines-by-region/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"DSU Italy deadlines by region: current status and next steps\",\"description\":\"Check regional DSU application status, separate document and housing dates, and prepare for