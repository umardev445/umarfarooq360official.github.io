29:["$","section","2-Three different ways an offer can treat an EPQ",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Three different ways an offer can treat an EPQ"}],[["$","p","Do not turn a total into an offer interpretation. A points-based offer may accept the EPQ, a grade-based offer may have a stated EPQ alternative, and another offer may not count it. The official course requirements and your actual offer determine which applies.",{"children":"Do not turn a total into an offer interpretation. A points-based offer may accept the EPQ, a grade-based offer may have a stated EPQ alternative, and another offer may not count it. The official course requirements and your actual offer determine which applies."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Read the EPQ rule before adding its points","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Read the EPQ rule before adding its points"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Offer pattern",{"scope":"col","children":"Offer pattern"}],["$","th","What to check",{"scope":"col","children":"What to check"}],["$","th","Planning response",{"scope":"col","children":"Planning response"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Tariff total with accepted qualifications"}],["$","td","1",{"children":"Whether EPQ is included or excluded"}],["$","td","2",{"children":"Include it only when permitted"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Named grade alternative involving EPQ"}],["$","td","1",{"children":"Required A-level subjects and EPQ grade"}],["$","td","2",{"children":"Test the whole alternative, not just its total"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Three named A-level grades only"}],["$","td","1",{"children":"Any separate EPQ concession in writing"}],["$","td","2",{"children":"Do not invent a reduction"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://www.ucas.com/applying/before-you-apply/what-and-where-to-study/entry-requirements/calculate-your-ucas-tariff-points","target":"_blank","rel":"noreferrer","children":"Official UCAS qualification calculator"}]]}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2a:["$","section","3-Worked combinations: adding an EPQ",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Worked combinations: adding an EPQ"}],[["$","p","The following totals are arithmetic examples, not examples of guaranteed course acceptance. The value of the extra qualification is the same wherever the grade table applies, but a university can decide not to count it in a particular route.",{"children":"The following totals are arithmetic examples, not examples of guaranteed course acceptance. The value of the extra qualification is the same wherever the grade table applies, but a university can decide not to count it in a particular route."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A-level and EPQ teaching examples","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A-level and EPQ teaching examples"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","A-level grades",{"scope":"col","children":"A-level grades"}],["$","th","A-level total",{"scope":"col","children":"A-level total"}],["$","th","EPQ result",{"scope":"col","children":"EPQ result"}],["$","th","Combined points",{"scope":"col","children":"Combined points"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"CCC"}],["$","td","1",{"children":"96"}],["$","td","2",{"children":"A (24)"}],["$","td","3",{"children":"120"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"BCC"}],["$","td","1",{"children":"104"}],["$","td","2",{"children":"C (16)"}],["$","td","3",{"children":"120"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"BBC"}],["$","td","1",{"children":"112"}],["$","td","2",{"children":"E (8)"}],["$","td","3",{"children":"120"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"BBB"}],["$","td","1",{"children":"120"}],["$","td","2",{"children":"E (8)"}],["$","td","3",{"children":"128"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"BBC"}],["$","td","1",{"children":"112"}],["$","td","2",{"children":"A (24)"}],["$","td","3",{"children":"136"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2b:["$","section","4-A points match is not the same as a reduced-grade offer",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"A points match is not the same as a reduced-grade offer"}],[["$","p","Suppose an offer is written as AAB, or ABB plus a specified EPQ grade. You must satisfy the named alternative; a different set of qualifications with the same tariff total may not qualify. Likewise, adding an EPQ does not replace a specifically required grade in Chemistry or Mathematics unless the provider explicitly says it does.",{"children":"Suppose an offer is written as AAB, or ABB plus a specified EPQ grade. You must satisfy the named alternative; a different set of qualifications with the same tariff total may not qualify. Likewise, adding an EPQ does not replace a specifically required grade in Chemistry or Mathematics unless the provider explicitly says it does."}],["$","p","UCAS shows that offers can combine qualifications, grades, subjects and exclusions. Use a two-column check: the academic result you expect and the exact condition it addresses. Mark any condition that has no matching evidence.",{"children":"UCAS shows that offers can combine qualifications, grades, subjects and exclusions. Use a two-column check: the academic result you expect and the exact condition it addresses. Mark any condition that has no matching evidence."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for A points match is not the same as a reduced-grade offer","children":[["$","$L5","/guides/conditional-vs-unconditional-offer/",{"href":"/guides/conditional-vs-unconditional-offer/","children":["Read offer types",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/tools/ucas-points-calculator/",{"href":"/tools/ucas-points-calculator/","children":["Calculate your full tariff",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2c:["$","section","5-Plan the EPQ alongside your main subjects",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Plan the EPQ alongside your main subjects"}],[["$","p","Use this page to understand an EPQ you are taking or considering; do not treat points as a reason to neglect required subjects. Compare the project deadline, supervised work, main-course assessments and the actual benefit described by your target courses.",{"children":"Use this page to understand an EPQ you are taking or considering; do not treat points as a reason to neglect required subjects. Compare the project deadline, supervised work, main-course assessments and the actual benefit described by your target courses."}],["$","p","A practical decision worksheet records the expected EPQ grade, whether the course recognises it, any written alternative offer, and the time needed to finish well. An uncertain concession should stay uncertain until admissions confirms it.",{"children":"A practical decision worksheet records the expected EPQ grade, whether the course recognises it, any written alternative offer, and the time needed to finish well. An uncertain concession should stay uncertain until admissions confirms it."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2d",null,{"id":"guides/epq-ucas-points:section-6","title":"Check your progress","items":["EPQ grade and its points recorded.","Course policy on EPQ checked.","Required subject grades still met.","Main-subject workload considered.","Any alternative offer copied accurately."]}],"$undefined","$undefined"]}]
