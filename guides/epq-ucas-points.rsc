ype\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/epq-ucas-points/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How many UCAS points is an EPQ A*?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"An A* in the EPQ is 28 UCAS points. A is 24, B is 20, C is 16, D is 12 and E is 8.\"}},{\"@type\":\"Question\",\"name\":\"Does an EPQ always lower my offer?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. A reduction must be stated by the course or in the offer. The tariff value does not create a concession automatically.\"}},{\"@type\":\"Question\",\"name\":\"Can CCC plus EPQ A total 120?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes: 96 + 24 = 120 arithmetically. Check that the course counts the EPQ and accepts the qualification combination.\"}},{\"@type\":\"Question\",\"name\":\"Does an EPQ replace an A level?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It is a separate qualification. Its tariff value does not make it a replacement for a named A level or subject requirement.\"}}]}"}}]],["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--guide","children":["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L5",null,{"href":"/","children":"Home"}],"$L19"]}],"$L1a","$L1b"]}],"$L1c",false,"$L1d","$L1e","$L1f"]}],false]}]}],false,"$L20","$L21"]}]
