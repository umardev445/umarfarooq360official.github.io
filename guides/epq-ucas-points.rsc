24:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Treat an EPQ condition as part of the actual offer wording",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Treat an EPQ condition as part of the actual offer wording"}],[["$","p","A fictional applicant has three A levels and an EPQ gradeA worth 24 tariff points. One course counts approved qualifications toward a tariff total; another issues a reduced A-level offer conditional on an EPQ grade. Adding 24 to both comparisons obscures the different decisions.",{"children":"A fictional applicant has three A levels and an EPQ gradeA worth 24 tariff points. One course counts approved qualifications toward a tariff total; another issues a reduced A-level offer conditional on an EPQ grade. Adding 24 to both comparisons obscures the different decisions."}],["$","p","Copy the real offer into a checklist: required main grades, any EPQ grade and whether the offer describes an alternative rather than extra points. Do not assume that satisfying the reduced main grades is enough if the EPQ condition is missed. Equally, do not turn a tariff contribution into an automatic grade reduction.",{"children":"Copy the real offer into a checklist: required main grades, any EPQ grade and whether the offer describes an alternative rather than extra points. Do not assume that satisfying the reduced main grades is enough if the EPQ condition is missed. Equally, do not turn a tariff contribution into an automatic grade reduction."}],["$","p","Use the tariff table to check arithmetic and AQA’s project description to understand the qualification. The admissions team remains responsible for the offer. If the wording is unclear, ask with your exact qualification and results instead of relying on another applicant’s arrangement.",{"children":"Use the tariff table to check arithmetic and AQA’s project description to understand the qualification. The admissions team remains responsible for the offer. If the wording is unclear, ask with your exact qualification and results instead of relying on another applicant’s arrangement."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Treat an EPQ condition as part of the actual offer wording","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Treat an EPQ condition as part of the actual offer wording"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Record",{"scope":"col","children":"Record"}],["$","th","Check",{"scope":"col","children":"Check"}],["$","th","Action",{"scope":"col","children":"Action"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Tariff offer"}],["$","td","1",{"children":"EPQ may contribute if permitted"}],["$","td","2",{"children":"Check included qualification rules"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Alternative grade offer"}],["$","td","1",{"children":"Named main grades plus EPQ condition"}],["$","td","2",{"children":"Meet the complete alternative"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"No EPQ allowance"}],["$","td","1",{"children":"No assumed reduction"}],["$","td","2",{"children":"Follow actual offer wording"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.aqa.org.uk/subjects/projects/level-three/projects-7993/specification",{"children":["",["$","a",null,{"href":"https://www.aqa.org.uk/subjects/projects/level-three/projects-7993/specification","target":"_blank","rel":"noreferrer","c