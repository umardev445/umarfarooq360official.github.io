17:T43e,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What A-level grades are 112 UCAS points?","acceptedAnswer":{"@type":"Answer","text":"BBC is one exact three-A-level combination. The combinations table shows other passing-grade routes to the same total."}},{"@type":"Question","name":"Can different qualifications with the same points meet the same offer?","acceptedAnswer":{"@type":"Answer","text":"Possibly, but not automatically. The course may restrict qualification type, size, subject, units or the source of the points."}},{"@type":"Question","name":"Can I add an EPQ to close a points gap?","acceptedAnswer":{"@type":"Answer","text":"Only count it towards a particular offer when the provider accepts it. A named grade offer may have a separate EPQ alternative or none at all."}},{"@type":"Question","name":"Are these university entry requirements?","acceptedAnswer":{"@type":"Answer","text":"No. These are tariff calculations and offer-reading examples. Check the current course page and your actual offer for binding conditions."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide student-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/112-ucas-points-in-grades/\",\"name\":\"112 UCAS points in grades: combinations and offer checks\",\"description\":\"See exact routes to 112 UCAS points, including A-level combinations and relevant vocational options. Check mixed qualifications and course conditions.\",\"url\":\"https://aspirecompass.org/guides/112-ucas-points-in-grades/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInn