1f:["$","section","1-All exact three-A-level combinations for 112",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"All exact three-A-level combinations for 112"}],[["$","p","These combinations use three passing GCE A-level grades, without AS or EPQ additions. The order is irrelevant to the total, but subject placement matters when the offer names a subject. This is an arithmetic enumeration rather than a list of university offers.",{"children":"These combinations use three passing GCE A-level grades, without AS or EPQ additions. The order is irrelevant to the total, but subject placement matters when the offer names a subject. This is an arithmetic enumeration rather than a list of university offers."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Three passing GCE A levels totalling exactly 112","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Three passing GCE A levels totalling exactly 112"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Grades",{"scope":"col","children":"Grades"}],["$","th","Point calculation",{"scope":"col","children":"Point calculation"}],["$","th","Total",{"scope":"col","children":"Total"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"A* / B / E"}],["$","td","1",{"children":"56 + 40 + 16"}],["$","td","2",{"children":"112"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"A* / C / D"}],["$","td","1",{"children":"56 + 32 + 24"}],["$","td","2",{"children":"112"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"A / A / E"}],["$","td","1",{"children":"48 + 48 + 16"}],["$","td","2",{"children":"112"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"A / B / D"}],["$","td","1",{"children":"48 + 40 + 24"}],["$","td","2",{"children":"112"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"A / C / C"}],["$","td","1",{"children":"48 + 32 + 32"}],["$","td","2",{"children":"112"}]],"$undefined"]}],["$","tr","5",{"children":[[["$","th","0",{"scope":"row","children":"B / B / C"}],["$","td","1",{"children":"40 + 40 + 32"}],["$","td","2",{"children":"112"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://qualifications.pearson.com/en/support/support-topics/understanding-our-qualifications/comparing-btec-to-other-qualifications/btec-ucas-points.html","target":"_blank","rel":"noreferrer","children":"Pearson: BTEC and A-level tariff comparison"}]]}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","2-A 112-point offer can still require a particular subject grade",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"A 112-point offer can still require a particular subject grade"}],[["$","p","The tariff total and the named conditions must both work. BBC in Biology, Chemistry and Mathematics reaches 112 whichever subject receives C, but a condition requiring B in Mathematics is met only when Mathematics has the required grade.",{"children":"The tariff total and the named conditions must both work. BBC in Biology, Chemistry and Mathematics reaches 112 whichever subject receives C, but a condition requiring B in Mathematics is met only when Mathematics has the required grade."}],["$","p","A mixed-qualification offer might also specify a minimum contribution from A levels or a named vocational qualification. Extra points in another subject do not erase such a restriction.",{"children":"A mixed-qualification offer might also specify a minimum contribution from A levels or a named vocational qualification. Extra points in another subject do not erase such a restriction."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"An illustrative offer asks for 112 points including B in Mathematics. B in Biology, B in Chemistry and C in Mathematics gives 112 but misses the named condition. B in Mathematics, B in Chemistry and C in Biology has the same total and addresses that particular condition; other requirements still need checking."}]]}],"$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","3-Mixed qualification examples reaching 112",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Mixed qualification examples reaching 112"}],[["$","p","The examples below calculate totals only. They do not confirm that a course accepts the mix, that the qualifications have no overlapping content, or that a named subject requirement is satisfied. In a mixed route, check the qualification titles and contribution rules before treating the total as usable.",{"children":"The examples below calculate totals only. They do not confirm that a course accepts the mix, that the qualifications have no overlapping content, or that a named subject requirement is satisfied. In a mixed route, check the qualification titles and contribution rules before treating the total as usable."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Mixed-route arithmetic examples for 112","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Mixed-route arithmetic examples for 112"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Combination",{"scope":"col","children":"Combination"}],["$","th","Calculation",{"scope":"col","children":"Calculation"}],["$","th","Total",{"scope":"col","children":"Total"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"CCC + EPQ C"}],["$","td","1",{"children":"96 + 16"}],["$","td","2",{"children":"112"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"BCC + EPQ E"}],["$","td","1",{"children":"104 + 8"}],["$","td","2",{"children":"112"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"National Extended Certificate D + two A levels CC"}],["$","td","1",{"children":"48 + 32 + 32"}],["$","td","2",{"children":"112"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Mixed qualification examples reaching 112","children":[["$","$L4","/guides/epq-ucas-points/",{"href":"/guides/epq-ucas-points/","children":["Check EPQ acceptance",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/btec-ucas-points/",{"href":"/guides/btec-ucas-points/","children":["Choose the correct BTEC size",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/ucas-points-calculator/",{"href":"/tools/ucas-points-calculator/","children":["Calculate your own mix",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
22:["$","section","4-Turn the number into an offer checklist",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Turn the number into an offer checklist"}],[["$","p","Write the actual offer next to your predicted or achieved record. Give each separate condition its own line so that a high total cannot conceal a missing requirement. If a condition excludes a qualification, calculate a second total with that qualification removed.",{"children":"Write the actual offer next to your predicted or achieved record. Give each separate condition its own line so that a high total cannot conceal a missing requirement. If a condition excludes a qualification, calculate a second total with that qualification removed."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"A short question for the admissions team"}],[["$","p","0",{"children":"I am considering your course and expect approximately 112 tariff points from the following exact qualifications and grades: [list]. Your course page states [copy condition]. Does this combination meet the accepted qualification route, and are there required subjects or units I should check?"}]],["$","p",null,{"className":"sample-card__note","children":"Replace the bracketed fields with your actual record and course. Do not send this as a claim that a calculator has confirmed admission."}]]}],"$undefined","$undefined",["$","$L27",null,{"id":"guides/112-ucas-points-in-grades:section-5","title":"Check your progress","items":["The offer uses a tariff minimum rather than only named grades.","The qualification family and size are accepted.","Required subjects or units have the necessary grades.","EPQ, AS and other additions are allowed.","Separate GCSE, interview or portfolio conditions are checked."]}],"$undefined","$undefined"]}]
23:["$","section","5-If your result is below the stated condition",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"If your result is below the stated condition"}],[["$","p","Check whether the course provides an alternative qualification route or a contextual offer that actually applies to you. A lower offer is not automatic. If results have already been issued, read the status in your UCAS account and contact the provider about the outcome; a calculator cannot change that decision.",{"children":"Check whether the course provides an alternative qualification route or a contextual offer that actually applies to you. A lower offer is not automatic. If results have already been issued, read the status in your UCAS account and contact the provider about the outcome; a calculator cannot change that decision."}],["$","p","Use nearby grade totals to understand the arithmetic, not to predict which university will accept a shortfall. Only the provider can confirm an exception, and requirements can differ between courses at the same university.",{"children":"Use nearby grade totals to understand the arithmetic, not to predict which university will accept a shortfall. Only the provider can confirm an exception, and requirements can differ between courses at the same university."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for If your result is below the stated condition","children":[["$","$L4","/guides/120-ucas-points-in-grades/",{"href":"/guides/120-ucas-points-in-grades/","children":["Compare 120 points",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/conditional-vs-unconditional-offer/",{"href":"/guides/conditional-vs-unconditional-offer/","children":["Understand offer types",["$","$L5",nu