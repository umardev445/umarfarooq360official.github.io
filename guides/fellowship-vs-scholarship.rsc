17:["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L4",null,{"href":"/","children":"Home"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/",{"children":[["$","$L4",null,{"href":"/guides/","children":"Guides"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/fellowship-vs-scholarship/",{"children":[["$","span",null,{"aria-current":"page","children":"Fellowship vs scholarship: choose by purpose and terms"}],false]}]]}],["$","span",null,{"data-slot":"badge","data-variant":"outline","className":"inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3 border-border text-foreground [a&]:hover:bg-accent [a&]:hover:text-accent-foreground inner-eyebrow","children":"Applications & opportunity planning"}],false,["$","h1",null,{"children":"Fellowship vs scholarship: choose by purpose and terms"}],["$","p",null,{"children":"The label is a starting point, not the full funding agreement. Compare what an award is intended to support, who is eligible, which costs it covers and what the recipient must do."}],["$","div",null,{"className":"inner-hero__meta","children":[["$","span",null,{"children":[["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z","key":"oel41y"}],["path",{"d":"m9 12 2 2 4-4","key":"dzmm74"}]],"className":"lucide-shield-check","aria-hidden":"true"}]," Updated ","24 Oct 2026"]}],["$","a",null,{"href":"#official-sources","children":"Official source record ↓"}]]}]]}],["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/opportunities-20261024/fellowship-1280.webp","srcSet":"/images/opportunities-20261024/fellowship-640.webp 640w, /images/opportunities-20261024/fellowship-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Illustrative international professional research workshop","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Illustrative scene; not a photograph of a named institution or programme participants."}]]}]]}]
18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Scholarships commonly support study, while fellowships can support research or professional activity as well as advanced study. The actual call decides eligibility, benefits and obligations—not the label alone."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Match the award to your purpose and stage, then compare its full funding terms and commitments."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","The useful distinction is the purpose of the award",{"href":"#section-1","children":"The useful distinction is the purpose of the award"}],["$","a","Compare the terms side by side",{"href":"#section-2","children":"Compare the terms side by side"}],["$","a","Match the opportunity to your stage",{"href":"#section-3","children":"Match the opportunity to your stage"}],["$","a","Scenario one: a student choosing fee support",{"href":"#section-4","children":"Scenario one: a student choosing fee support"}],["$","a","Scenario two: a graduate preparing a research project",{"href":"#section-5","children":"Scenario two: a graduate preparing a research project"}],["$","a","Scenario three: a professional considering a fellowship",{"href":"#section-6","children":"Scenario three: a professional considering a fellowship"}],["$","a","A stipend is not the same as a complete budget",{"href":"#section-7","children":"A stipend is not the same as a complete budget"}],["$","a","Prepare evidence for the actual selection task",{"href":"#section-8","children":"Prepare evidence for the actual selection task"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-The useful distinction is the purpose of the award",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"The useful distinction is the purpose of the award"}],[["$","p","A scholarship often supports study costs. A fellowship may support research, advanced study, professional development or a defined project. Institutions use the terms differently, so an award called a scholarship can include a living stipend, and a fellowship is not automatically an employment contract.",{"children":"A scholarship often supports study costs. A fellowship may support research, advanced study, professional development or a defined project. Institutions use the terms differently, so an award called a scholarship can include a living stipend, and a fellowship is not automatically an employment contract."}],["$","p","Read the actual programme terms rather than ruling yourself out from the title. The decision you need is whether the opportunity fits your stage and purpose, not which word sounds more prestigious.",{"children":"Read the actual programme terms rather than ruling yourself out from the title. The decision you need is whether the opportunity fits your stage and purpose, not which word sounds more prestigious."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","1-Compare the terms side by side",{"className":"article-section","id":"section-2","children":["$L1a",["$L1b"],"$undefined","$L1c","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],false,"$L23","$L24"]}],"$L25"]}]
19:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","fellowships",{"href":"/fellowships/","children":[["$","span",null,{"children":"Professional development"}],["$","h3",null,{"children":"International fellowships for emerging professionals"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","scholarships",{"href":"/scholarships/","children":[["$","span",null,{"children":"International funding"}],["$","h3",null,{"children":"Scholarships for international students in 2026–2027"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","scholarships/phd",{"href":"/scholarships/phd/","children":[["$","span",null,{"children":"Doctoral funding"}],["$","h3",null,{"children":"PhD scholarships and funded doctoral opportunities"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","graduate-programs",{"href":"/graduate-programs/","children":[["$","span",null,{"children":"First career step"}],["$","h3",null,{"children":"Graduate programmes for international applicants"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
