1a:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"There is no reliable single student price for each Italian city. Compare a room quote with the same bills, commute and contract length, then add food and personal costs. The examples below separate official transport products from indicative university housing guidance and original planning scenarios."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Use the evidence table to choose assumptions, replace the housing figure with an actual quote and calculate the remaining funding gap."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Compare like with like before ranking cities",{"href":"#section-1","children":"Compare like with like before ranking cities"}],["$","a","Five-city evidence table",{"href":"#section-2","children":"Five-city evidence table"}],["$","a","Two original budgets using the same expense categories",{"href":"#section-3","children":"Two original budgets using the same expense categories"}],["$","a","Food and bills: convert weekly costs correctly",{"href":"#section-4","children":"Food and bills: convert weekly costs correctly"}],["$","a","Subsidised residence and scholarship accommodation are different cases",{"href":"#section-5","children":"Subsidised residence and scholarship accommodation are different cases"}],["$","a","Arrival cash is not another monthly city cost",{"href":"#section-6","children":"Arrival cash is not another monthly city cost"}],["$","a","Before accepting a housing quote",{"href":"#section-7","children":"Before accepting a housing quote"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Compare like with like before ranking cities",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Compare like with like before ranking cities"}],[["$","p","A bed in a shared room, a single room in a shared apartment, a subsidised residence and a studio are different products. A cheap advertised price may exclude bills, require a long lease or be far from your teaching campus. Record these differences before comparing a monthly total.",{"children":"A bed in a shared room, a single room in a shared apartment, a subsidised residence and a studio are different products. A cheap advertised price may exclude bills, require a long lease or be far from your teaching campus. Record these differences before comparing a monthly total."}],["$","p","The official sources were reviewed on 28 October 2026; their examples are not a fresh rental-market survey. We leave a comparable current rent unavailable when it was not verified instead of fabricating a five-city average.",{"children":"The official sources were reviewed on 28 October 2026; their examples are not a fresh rental-market survey. We leave a comparable current rent unavailable when it was not verified instead of fabricating a five-city average."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","Five-city evidence table",{"className":"article-section","id":"section-2","children":["$L1c",["$L1d"],"$undefined","$L1e","$undefined","$undefined","$undefined","$undefined","$L1f","$undefined"]}]]}],"$L20",false,false,false,"$L21",false,"$L22","$L23"]}],"$L24"]}]
