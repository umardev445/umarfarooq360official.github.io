20:["$","figure",null,{"className":"page-visual page-visual--inline","children":[["$","img",null,{"src":"/images/research-20261028/cities-1280.webp","srcSet":"/images/research-20261028/cities-640.webp 640w, /images/research-20261028/cities-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Illustration of a student comparing five generic Italian housing scenes and a budget notebook","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Original editorial illustration. People and settings are illustrative; current requirements are recorded in the guide."}]]}]
21:["$","article",null,{"className":"article-body article-body--guide","children":[null,null,["$","section","2-Two original budgets using the same expense categories",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Two original budgets using the same expense categories"}],[["$","p","These are fictional planning scenarios, not observed city averages. Both use a single room in a shared flat with utilities excluded from rent. Food, phone and other spending are deliberately held constant so the arithmetic explains the decision.",{"children":"These are fictional planning scenarios, not observed city averages. Both use a single room in a shared flat with utilities excluded from rent. Food, phone and other spending are deliberately held constant so the arithmetic explains the decision."}],["$","p","Scenario A totals 650 + 80 + 260 + 22 + 15 + 65 = EUR 1,092. Scenario B totals EUR 900. The EUR 192 difference is produced by these selected inputs; it is not proof of a fixed Milan–Padua price gap. If bills are included in rent, remove the separate utility entry rather than counting them again.",{"children":"Scenario A totals 650 + 80 + 260 + 22 + 15 + 65 = EUR 1,092. Scenario B totals EUR 900. The EUR 192 difference is produced by these selected inputs; it is not proof of a fixed Milan–Padua price gap. If bills are included in rent, remove the separate utility entry rather than counting them again."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Illustrative monthly comparison — replace every assumption","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Illustrative monthly comparison — replace every assumption"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Monthly item",{"scope":"col","children":"Monthly item"}],["$","th","Scenario A: Milan (€)",{"scope":"col","children":"Scenario A: Milan (€)"}],["$","th","Scenario B: Padua (€)",{"scope":"col","children":"Scenario B: Padua (€)"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Rent assumption"}],["$","td","1",{"children":"650"}],["$","td","2",{"children":"450"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Utilities/internet assumption"}],["$","td","1",{"children":"80"}],["$","td","2",{"children":"80"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Food assumption"}],["$","td","1",{"children":"260"}],["$","td","2",{"children":"260"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Transport input"}],["$","td","1",{"children":"22 — youth product if eligible"}],["$","td","2",{"children":"30 — placeholder, obtain current fare"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Phone assumption"}],["$","td","1",{"children":"15"}],["$","td","2",{"children":"15"}]],"$undefined"]}],["$","tr","5",{"children":[[["$","th","0",{"scope":"row","children":"Other regular costs assumption"}],["$","td","1",{"children":"65"}],["$","td","2",{"children":"65"}]],"$undefined"]}],["$","tr","6",{"children":[[["$","th","0",{"scope":"row","children":"Total"}],["$","td","1",{"children":"1,092"}],["$","td","2",{"children":"900"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"A rent quote that includes EUR 80 of bills must be compared against rent plus bills in the other city. Equalise the boundaries before choosing the lower total."}]]}],"$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Food and bills: convert weekly costs correctly",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Food and bills: convert weekly costs correctly"}],[["$","p","Weekly food estimates need a full-year conversion. EUR 60 per week is approximately EUR 260 per average month using 60 × 52 ÷ 12, not EUR 240 from a four-week shortcut. The Padua and Bologna pages provide indicative grocery examples; your diet and actual prices decide your budget.",{"children":"Weekly food estimates need a full-year conversion. EUR 60 per week is approximately EUR 260 per average month using 60 × 52 ÷ 12, not EUR 240 from a four-week shortcut. The Padua and Bologna pages provide indicative grocery examples; your diet and actual prices decide your budget."}],"$L25"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$L26","$undefined"]}],"$L27","$L28","$L29"]}]
