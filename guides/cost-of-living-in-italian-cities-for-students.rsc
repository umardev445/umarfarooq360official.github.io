23:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Which Italian city is cheapest for students?",{"children":[["$","summary",null,{"children":["Which Italian city is cheapest for students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"This evidence does not establish a reliable current ranking. Compare actual quotes for the same room type, bills and commute rather than unrelated advertised prices."}]]}],["$","details","Are the scenario totals official city averages?",{"children":[["$","summary",null,{"children":["Are the scenario totals official city averages?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. They are original examples with labelled assumptions and checked arithmetic."}]]}],["$","details","Is a housing deposit a monthly expense?",{"children":[["$","summary",null,{"children":["Is a housing deposit a monthly expense?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Usually it is an upfront cash requirement with contract-specific refund conditions. Keep it separate from recurring expenses."}]]}],["$","details","Do all students get Milan’s youth fare?",{"children":[["$","summary",null,{"children":["Do all students get Milan’s youth fare?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The cited product has age and coverage conditions; confirm that you qualify and that it covers your route."}]]}]]}]]}]
