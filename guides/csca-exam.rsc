18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/expansion-20261022/china-csca-1280.webp","srcSet":"/images/expansion-20261022/china-csca-640.webp 640w, /images/expansion-20261022/china-csca-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Student writing in an open binder during a study session","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Destination or study photograph; not a photograph of the named university or scholarship."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"CSCA is the China Scholastic Competency Assessment for undergraduate academic readiness. The target university and programme determine how its requirements apply to your application and which subject results you need."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Read the current university undergraduate guide and record its required CSCA subjects, test language and result-submission deadline."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","What CSCA does, and which applicants should investigate it",{"href":"#section-1","children":"What CSCA does, and which applicants should investigate it"}],["$","a","Choose the subject combination from the programme rule",{"href":"#section-2","children":"Choose the subject combination from the programme rule"}],["$","a","Registration and test arrangements",{"href":"#section-3","children":"Registration and test arrangements"}],["$","a","A preparation plan based on evidence",{"href":"#section-4","children":"A preparation plan based on evidence"}],["$","a","Results, university selection and scholarships",{"href":"#section-5","children":"Results, university selection and scholarships"}],["$","a","Avoid three common mistakes",{"href":"#section-6","children":"Avoid three common mistakes"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-What CSCA does, and which applicants should investigate it",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"What CSCA does, and which applicants should investigate it"}],[["$","p","Shanghai’s official guide describes CSCA as an assessment of language proficiency and academic readiness for undergraduate study. It identifies a requirement in undergraduate applications at universities offering Chinese Government Scholarships. Your university’s current instructions remain essential for the application you are actually making.",{"children":"Shanghai’s official guide describes CSCA as an assessment of language proficiency and academic readiness for undergraduate study. It identifies a requirement in undergraduate applications at universities offering Chinese Government Scholarships. Your university’s current instructions remain essential for the application you are actually making."}],["$","p","Do not turn that statement into a requirement for every master’s, doctoral, short-course or exchange applicant. Check degree level first. Then confirm whether your chosen undergraduate programme requires a result at submission, later in assessment or under a specified scholarship route.",{"children":"Do not turn that statement into a requirement for every master’s, doctoral, short-course or exchange applicant. Check degree level first. Then confirm whether your chosen undergraduate programme requires a result at submission, later in assessment or under a specified scholarship route."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1a","$L1b","$L1c","$L1d","$L1e"]}],false,"$L1f","$L20"]}],"$L21"]}]
