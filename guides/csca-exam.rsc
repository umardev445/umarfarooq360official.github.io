1a:["$","section","1-Choose the subject combination from the programme rule",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Choose the subject combination from the programme rule"}],[["$","p","Read the official CSCA syllabus and the university’s subject table together. Mathematics, physics, chemistry and Chinese-related assessment can play different roles across programmes. Do not choose subjects simply because another applicant to China selected them.",{"children":"Read the official CSCA syllabus and the university’s subject table together. Mathematics, physics, chemistry and Chinese-related assessment can play different roles across programmes. Do not choose subjects simply because another applicant to China selected them."}],["$","p","The teaching language and the examination language are separate details to confirm. Keep a screenshot or copy of the university instruction with its intake year, especially if you are comparing engineering, science and non-science degrees.",{"children":"The teaching language and the examination language are separate details to confirm. Keep a screenshot or copy of the university instruction with its intake year, especially if you are comparing engineering, science and non-science degrees."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Your CSCA requirement record","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Your CSCA requirement record"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Field",{"scope":"col","children":"Field"}],["$","th","What to write down",{"scope":"col","children":"What to write down"}],["$","th","Where to verify",{"scope":"col","children":"Where to verify"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Programme"}],["$","td","1",{"children":"Exact degree, campus and intake"}],["$","td","2",{"children":"University undergraduate guide"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Subjects"}],["$","td","1",{"children":"Every required subject and any condition"}],["$","td","2",{"children":"Programme subject table"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Language"}],["$","td","1",{"children":"Accepted examination language"}],["$","td","2",{"children":"University and CSCA instructions"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Timing"}],["$","td","1",{"children":"Test and score-delivery deadlines"}],["$","td","2",{"children":"Official schedule and university call"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Submission"}],["$","td","1",{"children":"How scores are uploaded or verified"}],["$","td","2",{"children":"Application portal instructions"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1b:["$","section","2-Registration and test arrangements",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Registration and test arrangements"}],[["$","p","Start from csca.cn and use its official registration route. Check the currently offered dates, testing arrangements, identification rules and payment instructions before paying. Third-party preparation packages are not the official examination registration.",{"children":"Start from csca.cn and use its official registration route. Check the currently offered dates, testing arrangements, identification rules and payment instructions before paying. Third-party preparation packages are not the official examination registration."}],["$","p","If the examination is offered remotely for your sitting, read the technical and room requirements in full. Test your device and connection using the organiser’s instructions. If a centre-based option applies, check the venue and arrival time. Keep the confirmation for the exact sitting you booked.",{"children":"If the examination is offered remotely for your sitting, read the technical and room requirements in full. Test your device and connection using the organiser’s instructions. If a centre-based option applies, check the venue and arrival time. Keep the confirmation for the exact sitting you booked."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L22",null,{"id":"guides/csca-exam:section-3","title":"Check your progress","items":["Official account and applicant name match identification","Required subjects and test language confirmed","Date allows enough time for university score submission","Current fee and payment confirmation checked","Technical or centre instructions reviewed"]}],"$undefined","$undefined"]}]
1c:["$","section","3-A preparation plan based on evidence",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"A preparation plan based on evidence"}],[["$","p","Download the current official subject outline and available examples. Compare it with your school topics to identify gaps rather than buying a broad course immediately. Divide your study time between learning missing material and practising under the stated time conditions.",{"children":"Download the current official subject outline and available examples. Compare it with your school topics to identify gaps rather than buying a broad course immediately. Divide your study time between learning missing material and practising under the stated time conditions."}],["$","p","Keep a short error log by subject: conceptual mistake, algebra or calculation error, misunderstanding the instruction, or time management. Revise the weakest category first. Any study schedule here is an editorial suggestion, not an official score guarantee.",{"children":"Keep a short error log by subject: conceptual mistake, algebra or calculation error, misunderstanding the instruction, or time management. Revise the weakest category first. Any study schedule here is an editorial suggestion, not an official score guarantee."}]],["$","ol",null,{"className":"process-steps","aria-label":"A preparation plan based on evidence","children":[["$","li","Match the official syllabus to your previous study",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Match the official syllabus to your previous study"}]]}],["$","li","Try available official sample tasks",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Try available official sample tasks"}]]}],["$","li","List missing topics and recurring mistakes",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"List missing topics and recurring mistakes"}]]}],["$","li","Practise timed sets using the correct examination language",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Practise timed sets using the correct examination language"}]]}],["$","li","Complete the organiser’s test-day preparation checks",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Complete the organiser’s test-day preparation checks"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","4-Results, university selection and scholarships",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Results, university selection and scholarships"}],[["$","p","A result is one part of the application alongside school records and other required material. Do not assume a score guarantees admission or government funding. The university’s selection method and scholarship competition remain separate decisions.",{"children":"A result is one part of the application alongside school records and other required material. Do not assume a score guarantees admission or government funding. The university’s selection method and scholarship competition remain separate decisions."}],["$","p","Follow the university’s method for submitting or verifying the score. If the result date appears later than the document deadline, ask the admissions office whether a later upload is permitted. An exam booking receipt should not be assumed to replace an actual result.",{"children":"Follow the university’s method for submitting or verifying the score. If the result date appears later than the document deadline, ask the admissions office whether a later upload is permitted. An exam booking receipt should not be assumed to replace an actual result."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Results, university selection and scholarships","children":[["$","$L4","/guides/csc-scholarship-application/",{"href":"/guides/csc-scholarship-application/","children":["CSC application steps",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/countries/china/",{"href":"/countries/china/","children":["Compare China study routes",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1e:["$","section","5-Avoid three common mistakes",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Avoid three common mistakes"}],[["$","p","First, do not treat an old syllabus, fee or timetable as the current sitting. Second, do not use another university’s subject combination without checking your programme. Third, do not repeat unverified claims about pass rates or universal minimum scores.",{"children":"First, do not treat an old syllabus, fee or timetable as the current sitting. Second, do not use another university’s subject combination without checking your programme. Third, do not repeat unverified claims about pass rates or universal minimum scores."}],["$","p","Use the latest official notices if a test arrangement changes. Keep the source, publication year and date you checked it in your application tracker. That record is useful when a university or examination office asks which instructions you followed.",{"children":"Use the latest official notices if a test arrangement changes. Keep the source, publication year and date you checked it in your application tracker. That record is useful when a university or examination office asks which instructions you followed."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://csca.cn/",{"href":"https://csca.cn/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"CSCA official examination portal"}],["$","span",null,{"children":"Official reference reviewed 22 October 2026; check the selected intake and programme before applying."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://english.shanghai.gov.cn/en-Individuals-Education-Testscompetitions/20260813/9565875c1c214744971b07e9236da16f.html",{"href":"https://english.shanghai.gov.cn/en-Individuals-Education-Testscompetitions/20260813/9565875c1c214744971b07e9236da16f.html","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Shanghai government: CSCA guide"}],["$","span",null,{"children":"Official reference reviewed 22 October 2026; check the selected intake and programme before applying."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$1f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
