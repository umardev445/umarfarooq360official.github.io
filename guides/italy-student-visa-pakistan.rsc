1b:["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"From university admission to final enrolment","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"From university admission to final enrolment"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Stage",{"scope":"col","children":"Stage"}],["$","th","Responsible owner",{"scope":"col","children":"Responsible owner"}],["$","th","What to keep",{"scope":"col","children":"What to keep"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Programme application"}],["$","td","1",{"children":"University"}],["$","td","2",{"children":"Degree call and submission"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Admission conditions"}],["$","td","1",{"children":"University"}],["$","td","2",{"children":"Offer and outstanding requirements"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Universitaly where applicable"}],["$","td","1",{"children":"Applicant and university"}],["$","td","2",{"children":"Submission and validation record"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Visa application"}],["$","td","1",{"children":"Competent Italian mission"}],["$","td","2",{"children":"Current checklist and decision"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Arrival and enrolment"}],["$","td","1",{"children":"University and relevant authorities"}],["$","td","2",{"children":"Accepted originals and follow-up instructions"}]],"$undefined"]}]]}]]}]}]
1c:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Follow the process and the decision owner","children":[["$","$L4","/guides/universitaly-pre-enrolment/",{"href":"/guides/universitaly-pre-enrolment/","children":["Universitaly steps",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/cimea-vs-declaration-of-value-italy/",{"href":"/guides/cimea-vs-declaration-of-value-italy/","children":["Recognition evidence",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
1d:["$","section","1-The six-stage route from Pakistan to Italy",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"The six-stage route from Pakistan to Italy"}],[["$","p","Keep admission, scholarship, Universitaly and visa tasks in separate rows. A scholarship offer does not replace university admission, and a validated pre-enrolment does not guarantee a visa.",{"children":"Keep admission, scholarship, Universitaly and visa tasks in separate rows. A scholarship offer does not replace university admission, and a validated pre-enrolment does not guarantee a visa."}],["$","p","Begin document preparation while the university is evaluating your application, but check the current academic-year instructions before legalising, translating or purchasing anything.",{"children":"Begin document preparation while the university is evaluating your application, but check the current academic-year instructions before legalising, translating or purchasing anything."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","1. Shortlist the exact degree and intake",{"children":"1. Shortlist the exact degree and intake"}],["$","li","2. Apply through the university portal",{"children":"2. Apply through the university portal"}],["$","li","3. Accept or satisfy the admission conditions",{"children":"3. Accept or satisfy the admission conditions"}],["$","li","4. Complete Universitaly pre-enrolment",{"children":"4. Complete Universitaly pre-enrolment"}],["$","li","5. Follow the authorised Pakistan appointment process",{"children":"5. Follow the authorised Pakistan appointment process"}],["$","li","6. Submit the visa application and wait for the official decision",{"children":"6. Submit the visa application and wait for the official decision"}]]}],"$undefined","$undefined","$undefined"]}]
1e:["$","section","2-Build one document file with clear categories",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Build one document file with clear categories"}],[["$","p","The competent mission and current checklist decide the final documents. A planning file commonly includes identity records, university and Universitaly evidence, prior qualifications, financial evidence, accommodation, insurance and travel information.",{"children":"The competent mission and current checklist decide the final documents. A planning file commonly includes identity records, university and Universitaly evidence, prior qualifications, financial evidence, accommodation, insurance and travel information."}],["$","p","Names, dates, passport details and academic records should remain consistent across the file. If a document needs translation, legalisation, apostille, a Declaration of Value or CIMEA evidence, follow the current university and consular instruction rather than a general social-media checklist.",{"children":"Names, dates, passport details and academic records should remain consistent across the file. If a document needs translation, legalisation, apostille, a Declaration of Value or CIMEA evidence, follow the current university and consular instruction rather than a general social-media checklist."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Valid passport and required photographs",{"children":"Valid passport and required photographs"}],["$","li","Admission and Universitaly validation evidence",{"children":"Admission and Universitaly validation evidence"}],["$","li","Academic qualifications and requested recognition documents",{"children":"Academic qualifications and requested recognition documents"}],["$","li","Financial means and sponsor evidence where relevant",{"children":"Financial means and sponsor evidence where relevant"}],["$","li","Accommodation evidence",{"children":"Accommodation evidence"}],["$","li","Medical or travel insurance meeting the current rule",{"children":"Medical or travel insurance meeting the current rule"}],["$","li","Forms, fee and any travel reservation requested by the checklist",{"children":"Forms, fee and any travel reservation requested by the checklist"}]]}],"$undefined","$undefined","$undefined"]}]
1f:["$","section","3-Financial evidence must tell a coherent story",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Financial evidence must tell a coherent story"}],[["$","p","Visa officers assess whether the applicant can realistically fund tuition and living costs. Present the source of funds clearly and keep sponsor identity, income, bank activity and relationship evidence consistent.",{"children":"Visa officers assess whether the applicant can realistically fund tuition and living costs. Present the source of funds clearly and keep sponsor identity, income, bank activity and relationship evidence consistent."}],["$","p","Required amounts and acceptable evidence can change. Use the current official checklist for the exact figure and period; do not copy an old euro amount from a video. A scholarship may support the file, but it does not automatically remove every financial-document requirement.",{"children":"Required amounts and acceptable evidence can change. Use the current official checklist for the exact figure and period; do not copy an old euro amount from a video. A scholarship may support the file, but it does not automatically remove every financial-document requirement."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","4-Accommodation, insurance and appointment safety",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Accommodation, insurance and appointment safety"}],[["$","p","Accommodation evidence should match the city, dates and study plan. Insurance must follow the duration, territory and coverage stated in the current checklist. Keep confirmations readable and verifiable.",{"children":"Accommodation evidence should match the city, dates and study plan. Insurance must follow the duration, territory and coverage stated in the current checklist. Keep confirmations readable and verifiable."}],["$","p","Use only the appointment route published by the Embassy or authorised visa centre. The Embassy warns that appointments should not be purchased and that unofficial intermediaries can expose applicants to fraud.",{"children":"Use only the appointment route published by the Embassy or authorised visa centre. The Embassy warns that appointments should not be purchased and that unofficial intermediaries can expose applicants to fraud."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","5-After arrival: complete the residence steps",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"After arrival: complete the residence steps"}],[["$","p","A non-EU student staying for more than three months generally applies for a study residence permit within eight working days of arrival. The university international office can explain local enrolment, tax-code, health and housing procedures.",{"children":"A non-EU student staying for more than three months generally applies for a study residence permit within eight working days of arrival. The university international office can explain local enrolment, tax-code, health and housing procedures."}],["$","p","Carry the documents used for admission and the visa in your hand luggage. Border and local authorities may ask to see evidence again, and the university may still require original or verified academic records for final enrolment.",{"children":"Carry the documents used for admission and the visa in your hand luggage. Border and local authorities may ask to see evidence again, and the university may still require original or verified academic records for final enrolment."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Reach the university and confirm final enrolment",{"children":"Reach the university and confirm final enrolment"}],["$","li","Apply for the residence permit within the applicable deadline",{"children":"Apply for the residence permit within the applicable deadline"}],["$","li","Complete tax-code and health-cover steps",{"children":"Complete tax-code and health-cover steps"}],["$","li","Register accommodation where required",{"children":"Register accommodation where required"}],["$","li","Store every receipt and appointment notice",{"children":"Store every receipt and appointment notice"}]]}],"$undefined","$undefined","$undefined"]}]
22:["$","section","6-Final anti-refusal check",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Final anti-refusal check"}],[["$","p","Before submission, compare every document with the current official checklist and arrange the file in the same order. Prepare short, truthful answers about the degree, university, funding, accommodation and career plan.",{"children":"Before submission, compare every document with the current official checklist and arrange the file in the same order. Prepare short, truthful answers about the degree, university, funding, accommodation and career plan."}],["$","p","No website or agent can guarantee approval. AspireCompass provides planning information only; the competent Italian authority makes the visa decision.",{"children":"No website or agent can guarantee approval. AspireCompass provides planning information only; the competent Italian authority makes the visa decision."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://ambislamabad.esteri.it/en/news/dall_ambasciata/2026/05/new-procedures-for-enrolment-in-higher-education-courses-in-italy-for-international-students-academic-year-2026-2027-documentary-requirements-and-opening-of-applications/",{"href":"https://ambislamabad.esteri.it/en/news/dall_ambasciata/2026/05/new-procedures-for-enrolment-in-higher-education-courses-in-italy-for-international-students-academic-year-2026-2027-documentary-requirements-and-opening-of-applications/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Embassy of Italy in Islamabad: 2026–2027 student procedures"}],["$","span",null,{"children":"Current Pakistan-specific pre-enrolment, document and appointment notice"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://www.universitaly.it/first-steps",{"href":"https://www.universitaly.it/first-steps","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Universitaly: first steps for international students"}],["$","span",null,{"children":"Official programme search, pre-enrolment and visa sequence"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$23:props:children:2:props:children:0:props:children:1:prop