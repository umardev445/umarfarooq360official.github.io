25:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"From university admission to final enrolment","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"From university admission to final enrolment"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Stage",{"scope":"col","children":"Stage"}],["$","th","Responsible owner",{"scope":"col","children":"Responsible owner"}],["$","th","What to keep",{"scope":"col","children":"What to keep"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Programme application"}],["$","td","1",{"children":"University"}],["$","td","2",{"children":"Degree call and submission"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Admission conditions"}],["$","td","1",{"children":"University"}],["$","td","2",{"children":"Offer and outstanding requirements"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Universitaly where applicable"}],["$","td","1",{"children":"Applicant and university"}],["$","td","2",{"children":"Submission and validation record"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Visa application"}],["$","td","1",{"children":"Competent Italian mission"}],["$","td","2",{"children":"Current checklist and decision"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Arrival and enrolment"}],["$","td","1",{"children":"University and relevant authorities"}],["$","td","2",{"children":"Accepted originals and follow-up instructions"}]],"$undefined"]}]]}]]}]}],"$undefined"]
26:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Follow the process and the decision owner","children":[["$","$L4","/guides/universitaly-pre-enrolment/",{"href":"/guides/universitaly-pre-enrolment/","children":["Universitaly steps",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/cimea-vs-declaration-of-value-italy/",{"href":"/guides/cimea-vs-declaration-of-value-italy/","children":["Recognition evidence",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
27:["$","section","3-The six-stage route from Pakistan to Italy",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"The six-stage route from Pakistan to Italy"}],[["$","p","Keep admission, scholarship, Universitaly and visa tasks in separate rows. A scholarship offer does not replace university admission, and a validated pre-enrolment does not guarantee a visa.",{"children":"Keep admission, scholarship, Universitaly and visa tasks in separate rows. A scholarship offer does not replace university admission, and a validated pre-enrolment does not guarantee a visa."}],["$","p","Begin document preparation while the university is evaluating your application, but check the current academic-year instructions before legalising, translating or purchasing anything.",{"children":"Begin document preparation while the university is evaluating your application, but check the current academic-year instructions before legalising, translating or purchasing anything."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","1. Shortlist the exact degree and intake",{"children":"1. Shortlist the exact degree and intake"}],["$","li","2. Apply through the university portal",{"children":"2. Apply through the university portal"}],["$","li","3. Accept or satisfy the admission conditions",{"children":"3. Accept or satisfy the admission conditions"}],["$","li","4. Complete Universitaly pre-enrolment",{"children":"4. Complete Universitaly pre-enrolment"}],["$","li","5. Follow the authorised Pakistan appointment process",{"children":"5. Follow the authorised Pakistan appointment process"}],["$","li","6. Submit the visa application and wait for the official decision",{"children":"6. Submit the visa application and wait for the official decision"}]]}],"$undefined","$undefined","$undefined"]}]
28:["$","section","4-Build one document file with clear categories",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Build one document file with clear categories"}],[["$","p","The competent mission and current checklist decide the final documents. A planning file commonly includes identity records, university and Universitaly evidence, prior qualifications, financial evidence, accommodation, insurance and travel information.",{"children":"The competent mission and current checklist decide the final documents. A planning file commonly includes identity records, university and Universitaly evidence, prior qualifications, financial evidence, accommodation, insurance and travel information."}],["$","p","Names, dates, passport details and academic records should remain consistent across the file. If a document needs translation, legalisation, apostille, a Declaration of Value or CIMEA evidence, follow the current university and consular instruction rather than a general social-media checklist.",{"children":"Names, dates, passport details and academic records should remain consistent across the file. If a document needs translation, legalisation, apostille, a Declaration of Value or CIMEA evidence, follow the current university and consular instruction rather than a general social-media checklist."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Valid passport and required photographs",{"children":"Valid passport and required photographs"}],["$","li","Admission and Universitaly validation evidence",{"children":"Admission and Universitaly validation evidence"}],["$","li","Academic qualifications and requested recognition documents",{"children":"Academic qualifications and requested recognition documents"}],["$","li","Financial means and sponsor evidence where relevant",{"children":"Financial means and sponsor evidence where relevant"}],["$","li","Accommodation evidence",{"children":"Accommodation evidence"}],["$","li","Medical or travel insurance meeting the current rule",{"children":"Medical or travel insurance meeting the current rule"}],["$","li","Forms, fee and any travel reservation requested by the checklist",{"children":"Forms, fee and any travel reservation requested by the checklist"}]]}],"$undefined","$undefined","$undefined"]}]
29:["$","section","5-Italy student-visa funds: amount and evidence",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Italy student-visa funds: amount and evidence"}],[["$","p","The Ministry’s current study FAQ lists €10,179.85 annually for university enrolment in 2026/27 and 2027/28. Islamabad’s checklist also names this minimum. It is a visa-financing threshold, not a quote for a year of life in every Italian city.",{"children":"The Ministry’s current study FAQ lists €10,179.85 annually for university enrolment in 2026/27 and 2027/28. Islamabad’s checklist also names this minimum. It is a visa-financing threshold, not a quote for a year of life in every Italian city."}],["$","p","Explain where the funds come from and how support continues. A last-minute deposit does not replace the wider financial assessment. Match any sponsorship documentation to the sponsor’s actual profile and the mission’s requirements.",{"children":"Explain where the funds come from and how support continues. A last-minute deposit does not replace the wider financial assessment. Match any sponsorship documentation to the sponsor’s actual profile and the mission’s requirements."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.esteri.it/en/ministero/sportello_info/domandefrequenti/studiare-in-italia/",{"children":["",["$","a",null,{"href":"https://www.esteri.it/en/ministero/sportello_info/domandefrequenti/studiare-in-italia/","target":"_blank","rel":"noreferrer","children":"Italian Ministry: study and financing FAQ"}]]}],["$","span","https://ambislamabad.esteri.it/wp-content/uploads/2026/06/ME10_Study-visa-D.pdf",{"children":[" · ",["$","a",null,{"href":"https://ambislamabad.esteri.it/wp-content/uploads/2026/06/ME10_Study-visa-D.pdf","target":"_blank","rel":"noreferrer","children":"Islamabad financial-document checklist"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Italy student-visa funds: amount and evidence","children":[["$","$L4","/guides/cost-of-living-in-italy-for-students/",{"href":"/guides/cost-of-living-in-italy-for-students/","children":["Compare realistic Italy living costs",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2a:["$","section","6-Accommodation, insurance and appointment safety",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Accommodation, insurance and appointment safety"}],[["$","p","Accommodation evidence should match the city, dates and study plan. Insurance must follow the duration, territory and coverage stated in the current checklist. Keep confirmations readable and verifiable.",{"children":"Accommodation evidence should match the city, dates and study plan. Insurance must follow the duration, territory and coverage stated in the current checklist. Keep confirmations readable and verifiable."}],["$","p","Use only the appointment route published by the Embassy or authorised visa centre. The Embassy warns that appointments should not be purchased and that unofficial intermediaries can expose applicants to fraud.",{"children":"Use only the appointment route published by the Embassy or authorised visa centre. The Embassy warns that appointments should not be purchased and that unofficial intermediaries can expose applicants to fraud."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2b:["$","section","7-After arrival: complete the residence steps",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"After arrival: complete the residence steps"}],[["$","p","A non-EU student staying for more than three months generally applies for a study residence permit within eight working days of arrival. The university international office can explain local enrolment, tax-code, health and housing procedures.",{"children":"A non-EU student staying for more than three months generally applies for a study residence permit within eight working days of arrival. The university international office can explain local enrolment, tax-code, health and housing procedures."}],["$","p","Carry the documents used for admission and the visa in your hand luggage. Border and local authorities may ask to see evidence again, and the university may still require original or verified academic records for final enrolment.",{"children":"Carry the documents used for admission and the visa in your hand luggage. Border and local authorities may ask to see evidence again, and the university may still require original or verified academic records for final enrolment."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Reach the university and confirm final enrolment",{"children":"Reach the university and confirm final enrolment"}],["$","li","Apply for the residence permit within the applicable deadline",{"children":"Apply for the residence permit within the applicable deadline"}],["$","li","Complete tax-code and health-cover steps",{"children":"Complete tax-code and health-cover steps"}],["$","li","Register accommodation where required",{"children":"Register accommodation where required"}],["$","li","Store every receipt and appointment notice",{"children":"Store every receipt and appointment notice"}]]}],"$undefined","$undefined","$undefined"]}]
2c:["$","section","8-Final anti-refusal check",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Final anti-refusal check"}],[["$","p","Before submission, compare every document with the current official checklist and arrange the file in the same order. Prepare short, truthful answers about the degree, university, funding, accommodation and career plan.",{"children":"Before submission, compare every document with the current official checklist and arrange the file in the same order. Prepare short, truthful answers about the degree, university, funding, accommodation and career plan."}],["$","p","No website or agent can guarantee approval. AspireCompass provides planning information only; the competent Italian authority makes the visa decision.",{"children":"No website or agent can guarantee approval. AspireCompass provides planning information only; the competent Italian authority makes the visa decision."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2d:["$","section","9-Confirm the course start before planning the visa",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"Confirm the course start before planning the visa"}],[["$","p","Check that your programme accepts new non-EU applicants from abroad in the selected intake, then follow the competent mission's current instructions.",{"children":"Check that your programme accepts new non-EU applicants from abroad in the selected intake, then follow the competent mission's current instructions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Confirm the course start before planning the visa","children":[["$","$L4","/guides/italy-intakes-2027/",{"href":"/guides/italy-intakes-2027/","children":["Italy intakes 2027: September, February and applicant eligibility",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
