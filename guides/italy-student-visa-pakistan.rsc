22:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is an MOI letter enough for an Italy student visa from Pakistan?",{"children":[["$","summary",null,{"children":["Is an MOI letter enough for an Italy student visa from Pakistan?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Do not assume so. Admission exemptions and visa evidence are separate. The linked Islamabad checklist describes B2 language evidence across four skills; confirm your exact document with the competent mission."}]]}],["$","details","Is the visa funding minimum the total cost of studying in Italy?",{"children":[["$","summary",null,{"children":["Is the visa funding minimum the total cost of studying in Italy?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The stated minimum is one financing requirement. Tuition, actual housing, travel, deposits and costs before funding arrives can leave a larger budget to cover."}]]}],["$","details","Does a 2026/27 visa deadline apply to a 2027/28 admission?",{"children":[["$","summary",null,{"children":["Does a 2026/27 visa deadline apply to a 2027/28 admission?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No automatic transfer is valid. Keep the admission intake and the consular academic-year instructions together, and use the new cycle’s published procedure."}]]}]]}]]}]
