isa"]}]]}]]}],["$","div",null,{"className":"sidebar-card","children":[["$","h2",null,{"children":"Next useful step"}],[["$","$L4","countries/italy",{"href":"/countries/italy/","children":["Scholarships and study routes in Italy for international students"," ",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/study-in-italy-admission-english-requirements",{"href":"/guides/study-in-italy-admission-english-requirements/","children":["Italy IELTS requirements: scores, PTE and MOI by university"," ",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]]}]]}]
