20:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Undergraduate admission scholarships",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Undergraduate admission scholarships"}],[["$","p","Sabancı’s international scholarship page says eligible applicants are considered automatically, including those who leave the optional scholarship section blank. The committee considers academic evidence, and a given exam score does not guarantee a particular scholarship.",{"children":"Sabancı’s international scholarship page says eligible applicants are considered automatically, including those who leave the optional scholarship section blank. The committee considers academic evidence, and a given exam score does not guarantee a particular scholarship."}],["$","p","Organise your evidence by what it proves: school performance, subject preparation and independently verifiable achievements. An award certificate without context tells less than the result, competition level and your own contribution. Keep optional material relevant to the degree rather than uploading a large unsorted portfolio.",{"children":"Organise your evidence by what it proves: school performance, subject preparation and independently verifiable achievements. An award certificate without context tells less than the result, competition level and your own contribution. Keep optional material relevant to the degree rather than uploading a large unsorted portfolio."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://iro.sabanciuniv.edu/en/scholarships",{"children":["",["$","a",null,{"href":"https://iro.sabanciuniv.edu/en/scholarships","target":"_blank","rel":"noreferrer","children":"Sabancı international scholarship policy"}]]}]]]}],"$undefined"]}],["$","section","2-2026/27 undergraduate tuition an