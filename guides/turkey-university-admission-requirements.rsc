25:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A practical document inventory","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A practical document inventory"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Document group",{"scope":"col","children":"Document group"}],["$","th","Application question",{"scope":"col","children":"Application question"}],["$","th","Registration question",{"scope":"col","children":"Registration question"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Academic records"}],["$","td","1",{"children":"Are interim or final results required?"}],["$","td","2",{"children":"Which originals and translations must be shown?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Exam results"}],["$","td","1",{"children":"Is the result accepted and still valid?"}],["$","td","2",{"children":"How is its authenticity verified?"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Identity/category evidence"}],["$","td","1",{"children":"Which citizenship and school-history evidence is needed?"}],["$","td","2",{"children":"Which passport and entry records are required?"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Language evidence"}],["$","td","1",{"children":"Is a score needed now or later?"}],["$","td","2",{"children":"What exempts preparation?"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"School equivalence"}],["$","td","1",{"children":"Is it requested with the application?"}],["$","td","2",{"children":"When must MEB Denklik be completed?"}]],"$undefined"]}]]}]]}]}],"$undefined"