26:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Build two document folders","children":[["$","a","/downloads/turkey-admission-tracker.csv",{"href":"/downloads/turkey-admission-tracker.csv","download":true,"children":["Download the admissions task tracker (CSV)",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
27:["$","section","3-Denklik: school equivalence is not a university admission offer",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Denklik: school equivalence is not a university admission offer"}],[["$","p","For secondary-school equivalence, start with the Ministry of National Education’s e-Denklik system and the relevant equivalence centre. This school-level process should not be confused with higher-education recognition or degree equivalence handled through other routes.",{"children":"For secondary-school equivalence, start with the Ministry of National Education’s e-Denklik system and the relevant equivalence centre. This school-level process should not be confused with higher-education recognition or degree equivalence handled through other routes."}],["$","p","The MEB FAQ describes uploading the application and education evidence, then presenting originals to the centre. It discusses authenticated graduation records, transcripts and, where required, translations; requirements depend on document and country circumstances. Do not order a generic attestation chain without checking the current centre’s instructions.",{"children":"The MEB FAQ describes uploading the application and education evidence, then presenting originals to the centre. It discusses authenticated graduation records, transcripts and, where required, translations; requirements depend on document and country circumstances. Do not order a generic attestation chain without checking the current centre’s instructions."}],["$","p","Prepare a document map showing the issuing school/body, official authentication route, translation status and appointment. If a final certificate is not yet issued, ask the centre what accepted evidence can be used rather than assuming a provisional letter is always sufficient.",{"children":"Prepare a document map showing the issuing school/body, official authentication route, translation status and appointment. If a final certificate is not yet issued, ask the centre what accepted evidence can be used rather than assuming a provisional letter is always sufficient."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://edenklik.meb.gov.tr/?culture=en-GB",{"children":["",["$","a",null,{"href":"https://edenklik.meb.gov.tr/?culture=en-GB","target":"_blank","rel":"noreferrer","children":"MEB e-Denklik official system"}]]}],["$","span","https://edenklik.meb.gov.tr/Home/IndexSSS",{"children":[" · ",["$","a",null,{"href":"https://edenklik.meb.gov.tr/Home/IndexSSS","target":"_blank","rel":"noreferrer","children":"MEB school equivalence FAQ"}]]}]]]}],"$undefined"]}]
28:["$","section","4-A workable school Denklik sequence",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"A workable school Denklik sequence"}],[["$","p","Plan this alongside admission, while respecting the actual order required by your registrar and centre. It is a preparation workflow, not a promise of a fixed processing time.",{"children":"Plan this alongside admission, while respecting the actual order required by your registrar and centre. It is a preparation workflow, not a promise of a fixed processing time."}]],["$","ol",null,{"className":"process-steps","aria-label":"A workable school Denklik sequence","children":[["$","li","Read the university’s requirement for school equivalence and its submission deadline.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Read the university’s requirement for school equivalence and its submission deadline."}]]}],["$","li","Use e-Denklik to identify the relevant centre and document instructions.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Use e-Denklik to identify the relevant centre and document instructions."}]]}],["$","li","Collect education records and the authentication/translation evidence required for your case.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Collect education records and the authentication/translation evidence required for your case."}]]}],["$","li","Submit the online record and attend or present originals as instructed.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Submit the online record and attend or present originals as instructed."}]]}],["$","li","Keep the equivalence outcome with the final registration documents.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Keep the equivalence outcome with the final registration documents."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","5-English and Turkish preparation need their own evidence",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"English and Turkish preparation need their own evidence"}],[["$","p","Teaching language, admission eligibility and language exemption should be recorded separately. A degree can be English-taught while still requiring preparation or an accepted exemption result. A past test-acceptance statement may also contain a date restriction.",{"children":"Teaching language, admission eligibility and language exemption should be recorded separately. A degree can be English-taught while still requiring preparation or an accepted exemption result. A past test-acceptance statement may also contain a date restriction."}],["$","p","Before paying for a language exam, confirm the precise test, version, minimum components, validity and delivery method accepted by your chosen institution. If preparation may be required, include its time and costs in your plan.",{"children":"Before paying for a language exam, confirm the precise test, version, minimum components, validity and delivery method accepted by your chosen institution. If preparation may be required, include its time and costs in your plan."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for English and Turkish preparation need their own evidence","children":[["$","$L4","/guides/metu-international-admissions/",{"href":"/guides/metu-international-admissions/","children":["METU English rules and IELTS restriction",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/universities-in-turkey-for-international-students/",{"href":"/guides/universities-in-turkey-for-international-students/","children":["Compare universities by language",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2a:["$","section","6-For Pakistani and other applicants with several education routes",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"For Pakistani and other applicants with several education routes"}],[["$","p","Write the exact qualification rather than only “high school”: for example, the actual board-issued certificate or A-level award. Follow the institution’s country/qualification row and the relevant equivalence centre’s instructions.",{"children":"Write the exact qualification rather than only “high school”: for example, the actual board-issued certificate or A-level award. Follow the institution’s country/qualification row and the relevant equivalence centre’s instructions."}],["$","p","Your passport alone does not settle every category question. Where citizenship history, study abroad or mixed school attendance creates ambiguity, send a concise factual summary to the university before applying. Keep its reply with the call you used.",{"children":"Your passport alone does not settle every category question. Where citizenship history, study abroad or mixed school attendance creates ambiguity, send a concise factual summary to the university before applying. Keep its reply with the call you used."}],["$","p","Admission, scholarship and visa decisions remain separate. A university application in progress is not an admission confirmation for a visa file, and an offer without a funded award does not establish full financial support.",{"children":"Admission, scholarship and visa decisions remain separate. A university application in progress is not an admission confirmation for a visa file, and an offer without a funded award does not establish full financial support."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for For Pakistani and other applicants with several education routes","children":[["$","$L4","/guides/turkey-student-visa-requirements/",{"href":"/guides/turkey-student-visa-requirements/","children":["Turkey student visa requirements",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/turkiye-burslari/",{"href":"/scholarships/turkiye-burslari/","children":["Türkiye Bursları funding route",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2b:["$","section","7-Before pressing submit",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Before pressing submit"}],[["$","p","A requirements matrix is useful only when it changes what you do next. Resolve unknown items before the last day where possible.",{"children":"A requirements matrix is useful only when it changes what you do next. Resolve unknown items before the last day where possible."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2c",null,{"id":"guides/turkey-university-admission-requirements:section-8","title":"Check your progress","items":["My international applicant category is confirmed.","One accepted qualification meets all relevant subject/result conditions.","I have the required document format and result validity.","I know the language requirement and preparation route.","I have recorded separate application, scholarship, Denklik and registration deadlines."]}],"$undefined","$undefined"]}]
