1c:["$","section","1-Read the course call as a checklist",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Read the course call as a checklist"}],[["$","p","Open the exact course, campus and academic year. Check previous subjects or credits, language evidence, selection method and the documents requested for academic assessment. Do not infer admission from the existence of an English programme or a general minimum grade mentioned elsewhere.",{"children":"Open the exact course, campus and academic year. Check previous subjects or credits, language evidence, selection method and the documents requested for academic assessment. Do not infer admission from the existence of an English programme or a general minimum grade mentioned elsewhere."}],["$","p","Build a short evidence table before paying. If your transcript uses a different grading scale, attach the explanation requested by the programme. If you are still completing your degree, verify when graduation evidence must be available.",{"children":"Build a short evidence table before paying. If your transcript uses a different grading scale, attach the explanation requested by the programme. If you are still completing your degree, verify when graduation evidence must be available."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A programme-specific admission check","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A programme-specific admission check"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Item",{"scope":"col","children":"Item"}],["$","th","Question to resolve",{"scope":"col","children":"Question to resolve"}],["$","th","Evidence",{"scope":"col","children":"Evidence"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Academic background"}],["$","td","1",{"children":"Does my qualification and subject preparation fit?"}],["$","td","2",{"children":"Transcript, syllabus or degree evidence requested"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Language"}],["$","td","1",{"children":"Which test or exemption is accepted?"}],["$","td","2",{"children":"Current programme language rule"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Selection"}],["$","td","1",{"children":"Is there a test, interview or ranking?"}],["$","td","2",{"children":"Official admission call"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Timing"}],["$","td","1",{"children":"Which deadline applies to my category?"}],["$","td","2",{"children":"Call and international-student instructions"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Read the course call as a checklist","children":[["$","$L4","/guides/study-in-italy-admission-english-requirements/",{"href":"/guides/study-in-italy-admission-english-requirements/","children":["Italy English test and MOI rules",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1d:["$","section","2-Pre-selection, Infostud and final enrolment",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Pre-selection, Infostud and final enrolment"}],[["$","p","Use the official admissions page to reach the relevant application system. Where a pre-selection is required, submit the academic file there and retain its outcome. Create or use the Infostud student record as instructed; an account registration alone is not final enrolment.",{"children":"Use the official admissions page to reach the relevant application system. Where a pre-selection is required, submit the academic file there and retain its outcome. Create or use the Infostud student record as instructed; an account registration alone is not final enrolment."}],["$","p","After an offer, read its conditions. Foreign-qualification checks, tuition payments and any entrance selection can remain outstanding. Keep the same name and identity details across systems, and use the university’s help desk when a record needs correction.",{"children":"After an offer, read its conditions. Foreign-qualification checks, tuition payments and any entrance selection can remain outstanding. Keep the same name and identity details across systems, and use the university’s help desk when a record needs correction."}]],["$","ol",null,{"className":"process-steps","aria-label":"Pre-selection, Infostud and final enrolment","children":[["$","li","Select the exact course and intake",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Select the exact course and intake"}]]}],["$","li","Complete the required pre-selection or programme application",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Complete the required pre-selection or programme application"}]]}],["$","li","Keep the decision and satisfy its conditions",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Keep the decision and satisfy its conditions"}]]}],["$","li","Follow Infostud and international-office instructions",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Follow Infostud and international-office instructions"}]]}],["$","li","Complete final enrolment and retain the receipt",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Complete final enrolment and retain the receipt"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","3-Universitaly and visa: a parallel administrative track",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Universitaly and visa: a parallel administrative track"}],[["$","p","If your applicant category needs Universitaly pre-enrolment, complete it according to Sapienza’s instructions. University validation is one stage of that process; it is not a visa grant. The diplomatic mission determines visa requirements and its own decision.",{"children":"If your applicant category needs Universitaly pre-enrolment, complete it according to Sapienza’s instructions. University validation is one stage of that process; it is not a visa grant. The diplomatic mission determines visa requirements and its own decision."}],["$","p","Avoid booking non-refundable travel solely because a portal shows an academic offer. Coordinate the university enrolment deadline, visa appointment and qualification documents. If the schedule appears impossible, request written guidance before paying extra fees.",{"children":"Avoid booking non-refundable travel solely because a portal shows an academic offer. Coordinate the university enrolment deadline, visa appointment and qualification documents. If the schedule appears impossible, request written guidance before paying extra fees."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Universitaly and visa: a parallel administrative track","children":[["$","$L4","/guides/universitaly-pre-enrolment/",{"href":"/guides/universitaly-pre-enrolment/","children":["Universitaly pre-enrolment steps",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/cimea-vs-declaration-of-value-italy/",{"href":"/guides/cimea-vs-declaration-of-value-italy/","children":["CIMEA versus Declaration of Value",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1f:["$","section","4-Funding: separate Lazio DiSCo from university calls",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Funding: separate Lazio DiSCo from university calls"}],[["$","p","For regional need-based support, read the Lazio DiSCo call and prepare the requested financial evidence. For a Sapienza-specific award, read its own target degree, nationality conditions and selection method. A scholarship announced for one programme or profile is not funding for every international applicant.",{"children":"For regional need-based support, read the Lazio DiSCo call and prepare the requested financial evidence. For a Sapienza-specific award, read its own target degree, nationality conditions and selection method. A scholarship announced for one programme or profile is not funding for every international applicant."}],["$","p","Write admission and funding deadlines on different lines. If a scholarship requires an admission application, an offer or a completed registration, mark that dependency. Never assume admission automatically submits your funding request.",{"children":"Write admission and funding deadlines on different lines. If a scholarship requires an admission application, an offer or a completed registration, mark that dependency. Never assume admission automatically submits your funding request."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Funding: separate Lazio DiSCo from university calls","children":[["$","$L4","/scholarships/lazio-disco/",{"href":"/scholarships/lazio-disco/","children":["Lazio DiSCo requirements and process",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/italy/",{"href":"/scholarships/italy/","children":["Compare Italy funding routes",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
20:["$","section","5-Fees and your first months in Rome",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Fees and your first months in Rome"}],[["$","p","Calculate tuition using Sapienza’s current fee rules for your degree and applicant situation. Keep application charges, enrolment payments, regional charges and living expenses separate. A fee reduction can depend on documents and deadlines even if admission is already complete.",{"children":"Calculate tuition using Sapienza’s current fee rules for your degree and applicant situation. Keep application charges, enrolment payments, regional charges and living expenses separate. A fee reduction can depend on documents and deadlines even if admission is already complete."}],["$","p","For your own budget, obtain a realistic housing quote and include a deposit, transport, food, insurance and document costs. Label every scholarship as applied, awarded or paid. Only the latter two statuses support a firm funding plan, and timing still matters.",{"children":"For your own budget, obtain a realistic housing quote and include a deposit, transport, food, insurance and document costs. Label every scholarship as applied, awarded or paid. Only the latter two statuses support a firm funding plan, and timing still matters."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L24",null,{"id":"guides/sapienza-university-admissions-scholarships:section-6","title":"Check your progress","items":["Programme and applicant category confirmed","Language and academic evidence matched to the call","Separate admission and funding receipts saved","Qualification and visa tasks assigned deadlines","Arrival budget includes a no-early-payment scenario"]}],"$undefined","$undefined"]}]
