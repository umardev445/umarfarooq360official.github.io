1a:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/expansion-20261022/italy-sapienza-1280.webp","srcSet":"/images/expansion-20261022/italy-sapienza-640.webp 640w, /images/expansion-20261022/italy-sapienza-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Historic rooftops and domes in Rome","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Destination or study photograph; not a photograph of the named university or scholarship."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Sapienza has different procedures for international applicants depending on qualifications, citizenship, residence and visa need. Admission, enrolment and scholarship applications are separate decisions."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Find the official programme page and annual call, then identify your applicant category on the international admissions page."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Choose your applicant route before opening an account",{"href":"#section-1","children":"Choose your applicant route before opening an account"}],["$","a","Read the course call as a checklist",{"href":"#section-2","children":"Read the course call as a checklist"}],["$","a","Pre-selection, Infostud and final enrolment",{"href":"#section-3","children":"Pre-selection, Infostud and final enrolment"}],["$","a","Universitaly and visa: a parallel administrative track",{"href":"#section-4","children":"Universitaly and visa: a parallel administrative track"}],["$","a","Funding: separate Lazio DiSCo from university calls",{"href":"#section-5","children":"Funding: separate Lazio DiSCo from university calls"}],["$","a","Fees and your first months in Rome",{"href":"#section-6","children":"Fees and your first months in Rome"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Choose your applicant route before opening an account",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Choose your applicant route before opening an account"}],[["$","p","Start with degree level and the qualification you hold. A bachelor’s applicant with a foreign school certificate, a master’s applicant with a foreign degree and a PhD applicant follow different checks. Record whether you require a study visa or already hold a qualifying residence status in Italy.",{"children":"Start with degree level and the qualification you hold. A bachelor’s applicant with a foreign school certificate, a master’s applicant with a foreign degree and a PhD applicant follow different checks. Record whether you require a study visa or already hold a qualifying residence status in Italy."}],["$","p","Sapienza’s international admissions guidance explicitly separates applicant situations. An English-taught programme’s pre-selection instructions are not a substitute for the final enrolment procedure. Keep the programme page and international office instructions together so neither step is missed.",{"children":"Sapienza’s international admissions guidance explicitly separates applicant situations. An English-taught programme’s pre-selection instructions are not a substitute for the final enrolment procedure. Keep the programme page and international office instructions together so neither step is missed."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1c","$L1d","$L1e","$L1f","$L20"]}],false,"$L21","$L22"]}],"$L23"]}]
1b:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","scholarships/lazio-disco",{"href":"/scholarships/lazio-disco/","children":[["$","span",null,{"children":"Italy study pathway"}],["$","h3",null,{"children":"Lazio DiSCo scholarship: eligibility, documents and application"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/universitaly-pre-enrolment",{"href":"/guides/universitaly-pre-enrolment/","children":[["$","span",null,{"children":"Pre-enrolment · Step-by-step guide"}],["$","h3",null,{"children":"Universitaly pre-enrolment: from university instructions to validation"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/study-in-italy-admission-english-requirements",{"href":"/guides/study-in-italy-admission-english-requirements/","children":[["$","span",null,{"children":"Admission and language guide"}],["$","h3",null,{"children":"Italy IELTS requirements, accepted tests and MOI rules"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/italy-universities-tuition-fees",{"href":"/guides/italy-universities-tuition-fees/","children":[["$","span",null,{"children":"University cost comparison"}],["$","h3",null,{"children":"Italian universities and tuition fees for international students"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
