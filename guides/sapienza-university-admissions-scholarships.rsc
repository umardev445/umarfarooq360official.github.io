,null,{"children":[["$","strong",null,{"children":"Sapienza English-programme procedures"}],["$","span",null,{"children":"Official reference reviewed 22 October 2026; check the selected intake and programme before applying."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$21:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://laziodisco.it/",{"href":"https://laziodisco.it/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"DiSCo regional funding"}],["$","span",null,{"children":"Official reference reviewed 22 October 2026; check the selected intake and programme before applying."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$21:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
