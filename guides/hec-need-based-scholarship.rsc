28:["$","section","3-Write a clear financial-need explanation",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Write a clear financial-need explanation"}],[["$","p","A useful explanation connects your study costs to the household resources actually available for them. State the relevant facts, describe the resulting education-related shortfall and identify the support requested. Keep the tone factual. A dramatic story without supporting information is less helpful than a clear account of the constraints.",{"children":"A useful explanation connects your study costs to the household resources actually available for them. State the relevant facts, describe the resulting education-related shortfall and identify the support requested. Keep the tone factual. A dramatic story without supporting information is less helpful than a clear account of the constraints."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"Structure to adapt with your own facts"}],[["$","p","0",{"children":"My household’s documented recurring income supports [household responsibilities]. After [supported essential costs], the amount available for [tuition/study costs] is limited. I am requesting need-based assistance to continue [programme/semester]. The attached evidence explains the figures and any irregular income."}]],["$","p",null,{"className":"sample-card__note","children":"A writing framework, not a completed declaration. Use accurate figures and the form’s required wording."}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","4-Questions to take to the Financial Aid Office",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Questions to take to the Financial Aid Office"}],[["$","p","Send a short enquiry naming your programme, campus, semester and admission category. Ask which call is active, where to obtain the current form, what evidence is accepted and how receipt is acknowledged. Avoid emailing identity or bank documents unless the university provides a suitable official submission route.",{"children":"Send a short enquiry naming your programme, campus, semester and admission category. Ask which call is active, where to obtain the current form, what evidence is accepted and how receipt is acknowledged. Avoid emailing identity or bank documents unless the university provides a suitable official submission route."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2a",null,{"id":"guides/hec-need-based-scholarship:section-5","title":"Check your progress","items":["Scheme and campus confirmed","Admission category checked","Current closing date recorded","Local attachment list obtained","Income and expense periods reconciled","Existing aid disclosed","Submission acknowledgement retained"]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Questions to take to the Financial Aid Office","children":[["$","$L5","/guides/scholarships-in-pakistan/",{"href":"/guides/scholarships-in-pakistan/","children":["Compare domestic scholarship routes",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/scholarship-application/",{"href":"/guides/scholarship-application/","children":["Use the application tracker",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
