1b:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"The current HEC NBS eligibility page describes undergraduate support at selected public-sector institutions. Apply through the participating university’s Financial Aid Office; the university controls its call and assessment."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Confirm your campus, programme, admission category and current application window with the FAO before completing the form."]}],"$undefined"]}],false,false,["$","$L1d",null,{"records":[{"id":"hec-nbs","title":"HEC Need-Based Scholarship — institutional route","provider":"HEC / participating university Financial Aid Office","type":"Scholarship","level":"Bachelor's","country":"Pakistan","region":"Asia","funding":"Funded","status":"Check official site","deadline":"University-specific call; confirm with your Financial Aid Office","summary":"Undergraduate need-based support at selected public-sector institutions. The university assesses need and controls its application window. Check your campus, programme and admission category; a national overview does not confirm a local opening.","tags":["Pakistan domestic funding","Undergraduate","Financial Aid Office","Need-based"],"source":"https://www.hec.gov.pk/english/scholarshipsgrants/NBS/Pages/Eligibility-Criteria.aspx","sourceLabel":"HEC NBS eligibility","checked":"1 November 2026"}]}],null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Check the scheme and your institution first",{"href":"#section-1","children":"Check the scheme and your institution first"}],["$","a","Application form: return it to the university",{"href":"#section-2","children":"Application form: return it to the university"}],["$","a","Explain the household picture with consistent evidence",{"href":"#section-3","children":"Explain the household picture with consistent evidence"}],["$","a","Write a clear financial-need explanation",{"href":"#section-4","children":"Write a clear financial-need explanation"}],["$","a","Questions to take to the Financial Aid Office",{"href":"#section-5","children":"Questions to take to the Financial Aid Office"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Check the scheme and your institution first",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Check the scheme and your institution first"}],[["$","p","The reviewed NBS eligibility page covers undergraduate programmes of four to five years at selected public-sector universities/DAIs, including financially constrained students already enrolled. Self-finance admission is excluded. Financial need is assessed institutionally; slots and discipline coverage depend on the institution’s budget. The page states university-fee support plus a PKR 6,000 monthly stipend. These published terms do not establish that your campus has a currently funded place.",{"children":"The reviewed NBS eligibility page covers undergraduate programmes of four to five years at selected public-sector universities/DAIs, including financially constrained students already enrolled. Self-finance admission is excluded. Financial need is assessed institutionally; slots and discipline coverage depend on the institution’s budget. The page states university-fee support plus a PKR 6,000 monthly stipend. These published terms do not establish that your campus has a currently funded place."}]],"$undefined","$L1e","$undefined","$undefined","$undefined","$undefined","$L1f","$undefined"]}]]}],"$L20",false,false,false,"$L21",false,"$L22",null]}],"$L23"]}]
