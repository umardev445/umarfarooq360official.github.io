1f:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Find your programme call before following an application checklist",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Find your programme call before following an application checklist"}],[["$","p","Open the official Bologna course page for the exact degree, campus and intake. Read its call for entry qualification, subject requirements, language evidence, selection and the platform where you must apply. Keep the call with the application record; a general international-student page does not replace programme-specific rules.",{"children":"Open the official Bologna course page for the exact degree, campus and intake. Read its call for entry qualification, subject requirements, language evidence, selection and the platform where you must apply. Keep the call with the application record; a general international-student page does not replace programme-specific rules."}],["$","p","Write each remaining condition after an offer as a separate task. Academic selection, foreign-qualification evidence, Universitaly, visa and final registration may be handled by different offices. Admission and an ER.GO benefit application also have separate deadlines.",{"children":"Write each remaining condition after an offer as a separate task. Academic selection, foreign-qualification evidence, Universitaly, visa and final registration may be handled by different offices. Admission and an ER.GO benefit application also have separate deadlines."}]],["$","ol",null,{"className":"process-steps","aria-label":"Find your programme call before following an application checklist","children":[["$","li","Find the official degree and current admission call",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Find the official degree and current admission call"}]]}],["$","li","Match your qualifications and language evidence to that call",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Match your qualifications and language evidence to that call"}]]}],["$","li","Submit to the application system identified by the programme",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Submit to the application system identified by the programme"}]]}],["$","li","Record any offer conditions and final registration tasks",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Record any offer conditions and final registration tasks"}]]}],["$","li","Track ER.GO funding separately from academic admission",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Track ER.GO funding separately from academic admission"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Find your programme call before following an application checklist","children":[["$","$L4","/guides/italy-dsu-scholarships/",{"href":"/guides/italy-dsu-scholarships/","children":["Compare regional DSU routes",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/ergo-scholarship/",{"href":"/scholarships/ergo-scholarship/","children":["ER.GO benefit guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/universitaly-pre-enrolment/",{"href":"/guides/universitaly-pre-enrolment/","children":["Universitaly process",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],["$","section","2-Find the programme and campus that fit",{"className":"article-section","id":"section-3","children":[["