23:["$","p","Record the campus before comparing living costs. A programme attached to the University of Bologna is not necessarily taught in central Bologna. Compare the curriculum, where you will attend classes and what practical or project work the course includes.",{"children":"Record the campus before comparing living costs. A programme attached to the University of Bologna is not necessarily taught in central Bologna. Compare the curriculum, where you will attend classes and what practical or project work the course includes."}]
24:["$","section","3-Admission and English requirements",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Admission and English requirements"}],[["$","p","Bologna's non-EU master's route distinguishes open and restricted access and directs applicants to the programme notice for English or other language evidence. No single IELTS/PTE score is assigned to the whole university here.",{"children":"Bologna's non-EU master's route distinguishes open and restricted access and directs applicants to the programme notice for English or other language evidence. No single IELTS/PTE score is assigned to the whole university here."}],["$","p","Where the programme uses Studenti Online, create the correct university credentials and follow its admission instructions. Some degrees use different tests or selection steps. Do not assume creating an account is the same as completing an application.",{"children":"Where the programme uses Studenti Online, create the correct university credentials and follow its admission instructions. Some degrees use different tests or selection steps. Do not assume creating an account is the same as completing an application."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Four questions for the actual programme call","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Four questions for the actual programme call"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Question",{"scope":"col","children":"Question"}],["$","th","Record before applying",{"scope":"col","children":"Record before applying"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Who is eligible?"}],["$","td","1",{"children":"Prior qualification, subject fit and applicant category"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"How is selection made?"}],["$","td","1",{"children":"Open/restricted access, test, assessment or ranking"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"What language evidence?"}],["$","td","1",{"children":"Exact test/alternative, score and upload deadline"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"When and where?"}],["$","td","1",{"children":"Current academic year, closing time and portal"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","4-Fees: fixed charge plus programme contribution",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Fees: fixed charge plus programme contribution"}],[["$","p","For 2026–2027, Bologna publishes a fixed €157.04 component plus a variable contribution determined by the programme and economic assessment. Without the required evidence or eligibility for exemption, the full programme amount can apply.",{"children":"For 2026–2027, Bologna publishes a fixed €157.04 component plus a variable contribution determined by the programme and economic assessment. Without the required evidence or eligibility for exemption, the full programme amount can apply."}],["$","p","Read the fee page for your year of study and category. Do not compare the fixed charge with another university's full annual contribution. Confirm what remains payable after a waiver and whether application costs are separate.",{"children":"Read the fee page for your year of study and category. Do not compare the fixed charge with another university's full annual contribution. Confirm what remains payable after a waiver and whether application costs are separate."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","5-Fee exemptions and ER.GO scholarships are not the same deadline",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Fee exemptions and ER.GO scholarships are not the same deadline"}],[["$","p","Bologna's current fee-exemption instructions list 30 October 2026 at 18:00 for personal/economic data, a late route to 16 November at 18:00 with a €100 fee and foreign-document upload by 20 November. These dates concern 2026–2027 fee exemptions, not a new ER.GO scholarship deadline or 2027–2028 admission.",{"children":"Bologna's current fee-exemption instructions list 30 October 2026 at 18:00 for personal/economic data, a late route to 16 November at 18:00 with a €100 fee and foreign-document upload by 20 November. These dates concern 2026–2027 fee exemptions, not a new ER.GO scholarship deadline or 2027–2028 admission."}],["$","p","The 18:00 times concern the stated Italian university procedure. Confirm your own deadline in the current instructions; do not confuse it with an overseas consular appointment or a future admission intake.",{"children":"The 18:00 times concern the stated Italian university procedure. Confirm your own deadline in the current instructions; do not confuse it with an overseas consular appointment or a future admission intake."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Separate financial tasks in your tracker","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Separate financial tasks in your tracker"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Task",{"scope":"col","children":"Task"}],["$","th","What to verify",{"scope":"col","children":"What to verify"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"University fee exemption"}],["$","td","1",{"children":"Personal/economic data and supporting-document dates"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"ER.GO scholarship"}],["$","td","1",{"children":"Annual benefit call, eligibility and original application cut-off"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Accommodation"}],["$","td","1",{"children":"Separate request, available places and evidence"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Later payment/renewal"}],["$","td","1",{"children":"Verified award, credit conditions and disbursement schedule"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://www.unibo.it/en/study/enrolment-fees-and-other-procedures/degree-programmes/tuition-fees-and-exemptions/submitting-the-isee-or-documents-for-foreign-income-for-university-fee-exemptions","target":"_blank","rel":"noreferrer","children":"Bologna foreign-income evidence and fee-exemption deadlines"}]]}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
27:["$","section","6-Organise overseas financial evidence",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Organise overseas financial evidence"}],[["$","p","Where income or assets are held abroad, use the institution's foreign-document route. Do not assume a CAF certificate prepared for Padua replaces ER.GO's required evidence.",{"children":"Where income or assets are held abroad, use the institution's foreign-document route. Do not assume a CAF certificate prepared for Padua replaces ER.GO's required evidence."}],["$","p","List each household member and document category before arranging translation. Check the reference year and official issuer, then retain the original and submitted version together. Use the ISEE guide for the comparison of assessment routes, and the current Bologna/ER.GO instructions for your actual application.",{"children":"List each household member and document category before arranging translation. Check the reference year and official issuer, then retain the original and submitted version together. Use the ISEE guide for the comparison of assessment routes, and the current Bologna/ER.GO instructions for your actual application."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
28:["$","section","7-After admission: pre-enrolment, originals and housing",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"After admission: pre-enrolment, originals and housing"}],[["$","p","Follow the applicable international-student route for Universitaly and qualification verification. Ask whether your admission remains conditional and what must be completed before matriculation. Keep the academic offer and visa documents aligned.",{"children":"Follow the applicable international-student route for Universitaly and qualification verification. Ask whether your admission remains conditional and what must be completed before matriculation. Keep the academic offer and visa documents aligned."}],["$","p","Start a housing shortlist early but verify each offer. Record the location, commute, deposit, included utilities and cancellation rules. A benefit application or a place on a ranking is not a reason to assume that a room is already allocated.",{"children":"Start a housing shortlist early but verify each offer. Record the location, commute, deposit, included utilities and cancellation rules. A benefit application or a place on a ranking is not a reason to assume that a room is already allocated."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","8-A practical next-step checklist",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"A practical next-step checklist"}],[["$","p","Before you commit, your notes should identify one programme, one admission route, one realistic fee category and one plan for living costs. Missing information belongs on a question list for the official office, not in your budget as a guessed zero.",{"children":"Before you commit, your notes should identify one programme, one admission route, one realistic fee category and one plan for living costs. Missing information belongs on a question list for the official office, not in your budget as a guessed zero."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Programme call and applicant category saved.",{"children":"Programme call and applicant category saved."}],["$","li","Teaching language and evidence confirmed.",{"children":"Teaching language and evidence confirmed."}],["$","li","Application portal and selection steps understood.",{"children":"Application portal and selection steps understood."}],["$","li","Fee-exemption and benefit dates kept separate.",{"children":"Fee-exemption and benefit dates kept separate."}],["$","li","Current overseas-document instructions checked.",{"children":"Current overseas-document instructions checked."}],["$","li","Campus-specific housing and arrival costs budgeted.",{"children":"Campus-specific housing and arrival costs budgeted."}]]}],"$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for A practical next-step checklist","children":[["$","$L4","/guides/isee-parificato-international-students/",{"href":"/guides/isee-parificato-international-students/","children":["Foreign-income assessment guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/universitaly-pre-enrolment/",{"href":"/guides/universitaly-pre-enrolment/","children":["Universitaly step-by-step",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Italy study-cost calculator",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2a:["$","section","9-Campus and funding choice: make the next comparison",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"Campus and funding choice: make the next comparison"}],[["$","p","A Bologna degree may be taught on a different campus. Verify the actual teaching location before using a central-Bologna rent assumption. The same budget method applies, but the room, transport and arrival evidence must fit your own location.",{"children":"A Bologna degree may be taught on a different campus. Verify the actual teaching location before using a central-Bologna rent assumption. The same budget method applies, but the room, transport and arrival evidence must fit your own location."}],["$","p","ER.GO’s main 2026/27 application closed on 24 August at 16:00. A later university fee-exemption step can still be relevant to an eligible student, but it is a separate financial process. Keep any pending benefit out of confirmed cash until the actual decision and payment terms are available.",{"children":"ER.GO’s main 2026/27 application closed on 24 August at 16:00. A later university fee-exemption step can still be relevant to an eligible student, but it is a separate financial process. Keep any pending benefit out of confirmed cash until the actual decision and payment terms are available."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.er-go.it/tutte-le-notizie/bando-a-a-2026-2027-apertura-domande-il-23-giugno-2026",{"children":["",["$","a",null,{"href":"https://www.er-go.it/tutte-le-notizie/bando-a-a-2026-2027-apertura-domande-il-23-giugno-2026","target":"_blank","rel":"noreferrer","children":"ER.GO 2026/27 opening and deadline"}]]}],["$","span","https://www.unibo.it/en/study/enrolment-fees-and-other-procedures/degree-programmes/tuition-fees-and-exemptions/fees-and-exemptions-amounts-deadlines",{"ch