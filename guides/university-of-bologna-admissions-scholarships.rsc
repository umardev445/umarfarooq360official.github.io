18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Find the exact degree and its call, check your applicant category and follow the stated application route. ER.GO support and university fee exemptions are separate from admission."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose a bachelor's or master's programme and note its campus, teaching language, current call and portal."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","https://www.unibo.it/en/study/second-cycle-degree",{"href":"https://www.unibo.it/en/study/second-cycle-degree","children":["Find Bologna master's programmes",["$","$L5",null,{"ref":"$undefined","iconNode":"$14:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.unibo.it/en/study/first-and-single-cycle-degree",{"href":"https://www.unibo.it/en/study/first-and-single-cycle-degree","children":["Find Bologna bachelor's programmes",["$","$L5",null,{"ref":"$undefined","iconNode":"$14:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Find the programme and campus that fit",{"href":"#section-1","children":"Find the programme and campus that fit"}],["$","a","Admission and English requirements",{"href":"#section-2","children":"Admission and English requirements"}],["$","a","Fees: fixed charge plus programme contribution",{"href":"#section-3","children":"Fees: fixed charge plus programme contribution"}],["$","a","Fee exemptions and ER.GO scholarships are not the same deadline",{"href":"#section-4","children":"Fee exemptions and ER.GO scholarships are not the same deadline"}],["$","a","Organise overseas financial evidence",{"href":"#section-5","children":"Organise overseas financial evidence"}],["$","a","After admission: pre-enrolment, originals and housing",{"href":"#section-6","children":"After admission: pre-enrolment, originals and housing"}],["$","a","A practical next-step checklist",{"href":"#section-7","children":"A practical next-step checklist"}],["$","a","Your working checklist",{"href":"#section-8","children":"Your working checklist"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Find the programme and campus that fit",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Find the programme and campus that fit"}],[["$","p","The degree catalogue separates first/single-cycle and second-cycle programmes. Open the degree's own website for entry requirements, selection process and language conditions. The catalogue observed during this review shows 2026–2027 offerings; do not assume it confirms future 2027–2028 deadlines.",{"children":"The degree catalogue separates first/single-cycle and second-cycle programmes. Open the degree's own website for entry requirements, selection process and language conditions. The catalogue observed during this review shows 2026–2027 offerings; do not assume it confirms future 2027–2028 deadlines."}],["$","p","Record the campus before comparing living costs. A programme attached to the University of Bologna is not necessarily taught in central Bologna. Compare the curriculum, where you will attend classes and what practical or project work the course includes.",{"children":"Record the campus before comparing living costs. A programme attached to the University of Bologna is not necessarily taught in central Bologna. Compare the curriculum, where you will attend classes and what practical or project work the course includes."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}],false,"$L21","$L22"]}],"$L23"]}]
