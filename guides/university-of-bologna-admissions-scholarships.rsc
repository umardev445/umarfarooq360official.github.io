 deadline"}],[["$","p","Use the official programme call for your degree, campus and applicant category. A university-wide acceptance rate, one entrance test or a flat application price cannot describe every Bologna course. Admission, fee exemptions and ER.GO benefits are separate decisions.",{"children":"Use the official programme call for your degree, campus and applicant category. A university-wide acceptance rate, one entrance test or a flat application price cannot describe every Bologna course. Admission, fee exemptions and ER.GO benefits are separate decisions."}]],"$undefined","$L1c","$undefined","$undefined","$undefined","$undefined","$L1d","$undefined"]}]]}],"$L1e",false,false,false,"$L1f",false,"$L20","$L21"]}],"$L22"]}]
