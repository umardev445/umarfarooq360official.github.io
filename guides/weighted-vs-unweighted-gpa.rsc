19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[null,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Unweighted GPA averages base grade points without an advanced-course bonus. Weighted GPA applies the school's eligible course bonuses or other weighting rules. Both numbers need the school policy and transcript for context."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Calculate both from the same course record, then follow the application instructions about which reported result to provide."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","The practical difference",{"href":"#section-1","children":"The practical difference"}],["$","a","One transcript can produce 3.67 and 4.17",{"href":"#section-2","children":"One transcript can produce 3.67 and 4.17"}],["$","a","Unweighted does not mean every row has equal influence",{"href":"#section-3","children":"Unweighted does not mean every row has equal influence"}],["$","a","Why subtracting a fixed amount does not reliably convert GPA",{"href":"#section-4","children":"Why subtracting a fixed amount does not reliably convert GPA"}],["$","a","School reporting and college recalculation are separate",{"href":"#section-5","children":"School reporting and college recalculation are separate"}],["$","a","Use GPA to plan a better question",{"href":"#section-6","children":"Use GPA to plan a better question"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-The practical difference",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"The practical difference"}],[["$","p","Unweighted describes the absence of a course-rigor bonus, not necessarily equal credit for every course. Different credit values can still give courses different influence. Weighted GPA adds the school's treatment of advanced coursework, which can vary between schools.",{"children":"Unweighted describes the absence of a course-rigor bonus, not necessarily equal credit for every course. Different credit values can still give courses different influence. Weighted GPA adds the school's treatment of advanced coursework, which can vary between schools."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Compare definitions before comparing numbers","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Compare definitions before comparing numbers"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Feature",{"scope":"col","children":"Feature"}],["$","th","Unweighted GPA",{"scope":"col","children":"Unweighted GPA"}],["$","th","Weighted GPA",{"scope":"col","children":"Weighted GPA"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Base input"}],["$","td","1",{"children":"Course grades and credits"}],["$","td","2",{"children":"Course grades, credits and cours