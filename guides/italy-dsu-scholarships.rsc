1d:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Find the correct DSU authority first","children":[["$","$L4","https://www.er-go.it/international-students/what-you-need/",{"href":"https://www.er-go.it/international-students/what-you-need/","children":["ER.GO international-student documents",["$","$L5",null,{"ref":"$undefined","iconNode":"$14:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.unipd.it/en/isee",{"href":"https://www.unipd.it/en/isee","children":["Padua equivalent ISEE and concessions",["$","$L5",null,{"ref":"$undefined","iconNode":"$14:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.polimi.it/en/students/tuition-fees-scholarships-and-financial-aid/university-financial-aid-diritto-allo-studio-universitario-dsu",{"href":"https://www.polimi.it/en/students/tuition-fees-scholarships-and-financial-aid/university-financial-aid-diritto-allo-studio-universitario-dsu","children":["Polimi DSU financial aid",["$","$L5",null,{"ref":"$undefined","iconNode":"$14:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.dsu.toscana.it/-/foreign-students",{"href":"https://www.dsu.toscana.it/-/foreign-students","children":["DSU Toscana foreign-student rules",["$","$L5",null,{"ref":"$undefined","iconNode":"$14:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
1e:["$","section","1-Economic and academic conditions work together",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Economic and academic conditions work together"}],[["$","p","A first-year application is normally assessed using economic conditions and the enrolment rules in the call. Continued or later-year benefits can depend on earning the required credits by specified dates. The exact thresholds, credit rules and exceptions must be taken from the current regional notice.",{"children":"A first-year application is normally assessed using economic conditions and the enrolment rules in the call. Continued or later-year benefits can depend on earning the required credits by specified dates. The exact thresholds, credit rules and exceptions must be taken from the current regional notice."}],["$","p","For 2026–2027, ER.GO published €25,000 ISEE and €50,000 ISPE access thresholds for its scholarship and accommodation benefits. Both values had to fall within the stated limits. These are ER.GO figures for a named year and should not be copied to another region or future call.",{"children":"For 2026–2027, ER.GO published €25,000 ISEE and €50,000 ISPE access thresholds for its scholarship and accommodation benefits. Both values had to fall within the stated limits. These are ER.GO figures for a named year and should not be copied to another region or future call."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","2-Documents for income and assets outside Italy",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Documents for income and assets outside Italy"}],[["$","p","International applicants whose family unit has income or assets abroad must prove the household's composition and economic position according to the regional instructions. Typical categories include household members, annual income, buildings or land, and bank or other movable assets, but the call determines the precise reference year and evidence.",{"children":"International applicants whose family unit has income or assets abroad must prove the household's composition and economic position according to the regional instructions. Typical categories include household members, annual income, buildings or land, and bank or other movable assets, but the call determines the precise reference year and evidence."}],["$","p","Documents may need issue by the competent authority, translation and legalisation or another accepted authentication. Prepare from the official checklist and keep names, dates and family relationships consistent across every document. A self-written statement is not a substitute when the call requires official evidence.",{"children":"Documents may need issue by the competent authority, translation and legalisation or another accepted authentication. Prepare from the official checklist and keep names, dates and family relationships consistent across every document. A self-written statement is not a substitute when the call requires official evidence."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Foreign-income document planning worksheet","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Foreign-income document planning worksheet"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Category",{"scope":"col","children":"Category"}],["$","th","Evidence to ask the authority about",{"scope":"col","children":"Evidence to ask the authority about"}],["$","th","Record in your tracker",{"scope":"col","children":"Record in your tracker"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Household"}],["$","td","1",{"children":"Family composition and relationships"}],["$","td","2",{"children":"Issuing authority and reference date"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Income"}],["$","td","1",{"children":"Required annual income records"}],["$","td","2",{"children":"Reference year, currency and accepted format"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Property / land"}],["$","td","1",{"children":"Ownership and valuation evidence where requested"}],["$","td","2",{"children":"Owner, reference date and accepted valuation"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Bank / movable assets"}],["$","td","1",{"children":"Balances or other evidence required by the call"}],["$","td","2",{"children":"Reference date and required account records"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Translation / authentication"}],["$","td","1",{"children":"Accepted language and legalisation route"}],["$","td","2",{"children":"Responsible office and completion deadline"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined",["$","ul",null,{"children":[["$","li","Family composition certificate",{"children":"Family composition certificate"}],["$","li","Income for each adult household member",{"children":"Income for each adult household member"}],["$","li","Property or no-property evidence",{"children":"Property or no-property evidence"}],"$L29","$L2a","$L2b"]}],"$undefined","$L2c"]}]
20:["$","section","3-Student status can change the benefit",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Student status can change the benefit"}],[["$","p","Regional calls can distinguish students living at home, commuting and living away from home. Accommodation evidence and deadlines can affect this classification. ER.GO explains that the assigned amount varies with domicile and provides specific guidance for international students with income and assets abroad.",{"children":"Regional calls can distinguish students living at home, commuting and living away from home. Accommodation evidence and deadlines can affect this classification. ER.GO explains that the assigned amount varies with domicile and provides specific guidance for international students with income and assets abroad."}],["$","p","Do not assume that selecting an away-from-home option is enough. Read what contract, duration, registration or residence evidence must be submitted and when.",{"children":"Do not assume that selecting an away-from-home option is enough. Read what contract, duration, registration or residence evidence must be submitted and when."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","4-Admission and DSU use separate clocks",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Admission and DSU use separate clocks"}],[["$","p","A DSU deadline may arrive before enrolment is complete. Follow the call's rule for applicants awaiting admission and note any later deadline to finalise enrolment. Missing the scholarship deadline is not normally repaired by receiving a university offer later.",{"children":"A DSU deadline may arrive before enrolment is complete. Follow the call's rule for applicants awaiting admission and note any later deadline to finalise enrolment. Missing the scholarship deadline is not normally repaired by receiving a university offer later."}],["$","p","The main ER.GO scholarship deadline shown for 2026–2027 was 24 August 2026 at 16:00. Use it only as historical planning context and check the next official call for new dates.",{"children":"The main ER.GO scholarship deadline shown for 2026–2027 was 24 August 2026 at 16:00. Use it only as historical planning context and check the next official call for new dates."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","5-What a DSU benefit may contain",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"What a DSU benefit may contain"}],[["$","p","Depending on the authority and student status, support may combine a monetary grant with catering, accommodation or other services. The headline amount can be affected by services provided and later verification. Read the payment schedule and conditions before building a budget.",{"children":"Depending on the authority and student status, support may combine a monetary grant with catering, accommodation or other services. The headline amount can be affected by services provided and later verification. Read the payment schedule and conditions before building a budget."}],["$","p","Plan for tuition and mandatory university charges separately. A DSU application can interact with fee reductions, but the university explains how fees are assessed and when documents must be registered.",{"children":"Plan for tuition and mandatory university charges separately. A DSU application can interact with fee reductions, but the university explains how fees are assessed and when documents must be registered."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","6-Final DSU application checklist",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Final DSU application checklist"}],[["$","p","Complete this check from the current call and keep a saved copy of every submitted record.",{"children":"Complete this check from the current call and keep a saved copy of every submitted record."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2d",null,{"id":"guides/italy-dsu-scholarships:section-7","title":"Check your progress","items":["Identify the responsible authority and current academic year.","Record household, income and asset reference years.","Use the call’s issuing, translation and authentication rules.","Submit the scholarship request separately from assessment documents.","Record enrolment, credit and payment conditions."]}],"$undefined"]}]
24:["$","section","7-Plan money before the first payment",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Plan money before the first payment"}],[["$","p","Make three separate columns: confirmed grant cash, services such as meals/housing and costs you must pay yourself. Keep deposits, travel and early rent in an arrival-cash budget. Do not count an unawarded benefit as money already available.",{"children":"Make three separate columns: confirmed grant cash, services such as meals/housing and costs you must pay yourself. Keep deposits, travel and early rent in an arrival-cash budget. Do not count an unawarded benefit as money already available."}],["$","p","A provisional ranking or economic eligibility is not a guarantee of a room or immediate payment. Follow the award decision, required follow-up actions and published payment schedule.",{"children":"A provisional ranking or economic eligibility is not a guarantee of a room or immediate payment. Follow the award decision, required follow-up actions and published payment schedule."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Plan money before the first payment","children":[["$","$L4","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Estimate your funding gap",["$","$L5",null,{"ref":"$undefined","iconNode":"$14:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/isee-parificato-international-students/",{"href":"/guides/isee-parificato-international-students/","children":["Foreign-income document guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$14:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
25:["$","section","8-Connect the DSU application to documents and budget",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Connect the DSU application to documents and budget"}],[["$","p","A DSU plan is stronger when the household evidence, regional call and personal cash-flow estimate are handled together. Start the financial-document route early, then calculate what tuition, housing and arrival costs remain before any benefit is paid.",{"children":"A DSU plan is stronger when the household evidence, regional call and personal cash-flow estimate are handled together. Start the financial-document route early, then calculate what tuition, housing and arrival costs remain before any benefit is paid."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Connect the DSU application to documents and budget","children":[["$","$L4","/guides/isee-parificato-international-students/",{"href":"/guides/isee-parificato-international-students/","children":["Prepare ISEE Parificato evidence",["$","$L5",null,{"ref":"$undefined","iconNode":"$14:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Calculate Italy study costs",["$","$L5",null,{"ref":"$undefined","iconNode":"$14:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/italy/",{"href":"/scholarships/italy/","children":["Compare Italy scholarships",["$","$L5",null,{"ref":"$undefined","iconNode":"$14:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/italy-university-application-deadlines/",{"href":"/guides/italy-university-application-deadlines/","children":["Check Ital