22:["$","section","1-Toscana 2026–27: degree categories have different dates",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Toscana 2026–27: degree categories have different dates"}],[["$","p","Official calendar checked 24 October 2026: DSU Toscana lists 7 September 2026 as the closed degree/master’s deadline, while its doctoral and specialisation category lists 16 November 2026 at 13:00. These are Toscana dates, not a national DSU deadline. Confirm the call and applicant category before acting.",{"children":"Official calendar checked 24 October 2026: DSU Toscana lists 7 September 2026 as the closed degree/master’s deadline, while its doctoral and specialisation category lists 16 November 2026 at 13:00. These are Toscana dates, not a national DSU deadline. Confirm the call and applicant category before acting."}],["$","p","Do not budget for a housing place simply because you applied: the authority describes availability and award-category conditions. Record tuition treatment, cash support, meals and housing separately, with a funding gap and a cash-flow plan.",{"children":"Do not budget for a housing place simply because you applied: the authority describes availability and award-category conditions. Record tuition treatment, cash support, meals and housing separately, with a funding gap and a cash-flow plan."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.dsu.toscana.it/borsa-di-studio",{"children":["",["$","a",null,{"href":"https://www.dsu.toscana.it/borsa-di-studio","target":"_blank","rel":"noreferrer","children":"DSU Toscana current scholarship calendar"}]]}]]]}],"$undefined"]}]
23:["$","section","2-A seven-step DSU application workflow",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"A seven-step DSU application workflow"}],[["$","p","Use this sequence as a tracker; the notice may impose a different order or earlier documentary deadline.",{"children":"Use this sequence as a tracker; the notice may impose a different order or earlier documentary deadline."}]],["$","ol",null,{"className":"process-steps","aria-label":"A seven-step DSU application workflow","children":[["$","li","Identify the authority and current academic-year notice for your institution.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Identify the authority and current academic-year notice for your institution."}]]}],["$","li","Check economic and merit conditions for first application or renewal.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Check economic and merit conditions for first application or renewal."}]]}],["$","li","Prepare household, income, asset, translation and authentication evidence for the required reference periods.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Prepare household, income, asset, translation and authentication evidence for the required reference periods."}]]}],["$","li","Complete the official online benefit application, including housing if required.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Complete the official online benefit application, including housing if required."}]]}],["$","li","Complete any separately required document delivery and retain proof.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Complete any separately required document delivery and retain proof."}]]}],["$","li","Check provisional rankings, correction windows and final results.",{"children":[["$","span",null,{"children":6}],["$","strong",null,{"children":"Check provisional rankings, correction windows and final results."}]]}],["$","li","Meet enrolment, merit, payment and later reporting conditions.",{"children":[["$","span",null,{"children":7}],["$","strong",null,{"children":"Meet enrolment, merit, payment and later reporting conditions."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","3-First application or renewal: check which evidence is required",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"First application or renewal: check which evidence is required"}],[["$","p","DSU Toscana’s 2026–2027 foreign-student instructions distinguish first-time applicants and specified changes of degree from some returning scholarship holders. Its renewal exception is conditional; it is not a rule for every region. Use the authority’s wording rather than recycling another student’s checklist.",{"children":"DSU Toscana’s 2026–2027 foreign-student instructions distinguish first-time applicants and specified changes of degree from some returning scholarship holders. Its renewal exception is conditional; it is not a rule for every region. Use the authority’s wording rather than recycling another student’s checklist."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"First application or renewal: check which evidence is required","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"First application or renewal: check which evidence is required"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Your situation",{"scope":"col","children":"Your situation"}],["$","th","Question to settle before applying",{"scope":"col","children":"Question to settle before applying"}],["$","th","Evidence to retain",{"scope":"col","children":"Evidence to retain"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"First application or change of study level"}],["$","td","1",{"children":"Which original family, income and asset documents are required?"}],["$","td","2",{"children":"Current annual call and accepted translation/legalisation instructions"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Returning scholarship holder"}],["$","td","1",{"children":"Does this call permit unchanged financial circumstances to be declared?"}],["$","td","2",{"children":"Prior award and the current renewal conditions"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Requesting housing"}],["$","td","1",{"children":"Is a separate housing choice, contract or deadline required?"}],["$","td","2",{"children":"Housing request receipt and any accepted lease evidence"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for First application or renewal: check which evidence is required","children":[["$","$L4","/guides/isee-parificato-international-students/",{"href":"/guides/isee-parificato-international-students/","children":["ISEE and foreign-income documents",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/edisu-piemonte/",{"href":"/scholarships/edisu-piemonte/","children":["EDISU Piemonte route",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/ergo-scholarship/",{"href":"/scholarships/ergo-scholarship/","children":["ER.GO route",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
25:["$","section","4-Economic and academic conditions work together",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Economic and academic conditions work together"}],[["$","p","A first-year application is normally assessed using economic conditions and the enrolment rules in the call. Continued or later-year benefits can depend on earning the required credits by specified dates. The exact thresholds, credit rules and exceptions must be taken from the current regional notice.",{"children":"A first-year application is normally assessed using economic conditions and the enrolment rules in the call. Continued or later-year benefits can depend on earning the required credits by specified dates. The exact thresholds, credit rules and exceptions must be taken from the current regional notice."}],["$","p","For 2026–2027, ER.GO published €25,000 ISEE and €50,000 ISPE access thresholds for its scholarship and accommodation benefits. Both values had to fall within the stated limits. These are ER.GO figures for a named year and should not be copied to another region or future call.",{"children":"For 2026–2027, ER.GO published €25,000 ISEE and €50,000 ISPE access thresholds for its scholarship and accommodation benefits. Both values had to fall within the stated limits. These are ER.GO figures for a named year and should not be copied to another region or future call."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","5-Documents for income and assets outside Italy",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Documents for income and assets outside Italy"}],[["$","p","International applicants whose family unit has income or assets abroad must prove the household's composition and economic position according to the regional instructions. Typical categories include household members, annual income, buildings or land, and bank or other movable assets, but the call determines the precise reference year and evidence.",{"children":"International applicants whose family unit has income or assets abroad must prove the household's composition and economic position according to the regional instructions. Typical categories include household members, annual income, buildings or land, and bank or other movable assets, but the call determines the precise reference year and evidence."}],["$","p","Documents may need issue by the competent authority, translation and legalisation or another accepted authentication. Prepare from the official checklist and keep names, dates and family relationships consistent across every document. A self-written statement is not a substitute when the call requires official evidence.",{"children":"Documents may need issue by the competent authority, translation and legalisation or another accepted authentication. Prepare from the official checklist and keep names, dates and family relationships consistent across every document. A self-written statement is not a substitute when the call requires official evidence."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Foreign-income document planning worksheet","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Foreign-income document planning worksheet"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Category",{"scope":"col","children":"Category"}],["$","th","Evidence to ask the authority about",{"scope":"col","children":"Evidence to ask the authority about"}],["$","th","Record in your tracker",{"scope":"col","children":"Record in your tracker"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Household"}],["$","td","1",{"children":"Family composition and relationships"}],["$","td","2",{"children":"Issuing authority and reference date"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Income"}],["$","td","1",{"children":"Required annual income records"}],["$","td","2",{"children":"Reference year, currency and accepted format"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Property / land"}],["$","td","1",{"children":"Ownership and valuation evidence where requested"}],["$","td","2",{"children":"Owner, reference date and accepted valuation"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Bank / movable assets"}],["$","td","1",{"children":"Balances or other evidence required by the call"}],["$","td","2",{"children":"Reference date and required account records"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Translation / authentication"}],["$","td","1",{"children":"Accepted language and legalisation route"}],["$","td","2",{"children":"Responsible office and completion deadline"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined",["$","ul",null,{"children":[["$","li","Family composition certificate",{"children":"Family composition certificate"}],["$","li","Income for each adult household member",{"children":"Income for each adult household member"}],["$","li","Property or no-property evidence",{"children":"Property or no-property evidence"}],"$L31","$L32","$L33"]}],"$undefined","$undefined","$L34"]}]
27:["$","section","6-Student status can change the benefit",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Student status can change the benefit"}],[["$","p","Regional calls can distinguish students living at home, commuting and living away from home. Accommodation evidence and deadlines can affect this classification. ER.GO explains that the assigned amount varies with domicile and provides specific guidance for international students with income and assets abroad.",{"children":"Regional calls can distinguish students living at home, commuting and living away from home. Accommodation evidence and deadlines can affect this classification. ER.GO explains that the assigned amount varies with domicile and provides specific guidance for international students with income and assets abroad."}],["$","p","Do not assume that selecting an away-from-home option is enough. Read what contract, duration, registration or residence evidence must be submitted and when.",{"children":"Do not assume that selecting an away-from-home option is enough. Read what contract, duration, registration or residence evidence must be submitted and when."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
28:["$","section","7-Admission and DSU use separate clocks",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Admission and DSU use separate clocks"}],[["$","p","A DSU deadline may arrive before enrolment is complete. Follow the call's rule for applicants awaiting admission and note any later deadline to finalise enrolment. Missing the scholarship deadline is not normally repaired by receiving a university offer later.",{"children":"A DSU deadline may arrive before enrolment is complete. Follow the call's rule for applicants awaiting admission and note any later deadline to finalise enrolment. Missing the scholarship deadline is not normally repaired by receiving a university offer later."}],["$","p","The main ER.GO scholarship deadline shown for 2026–2027 was 24 August 2026 at 16:00. Use it only as historical planning context and check the next official call for new dates.",{"children":"The main ER.GO scholarship deadline shown for 2026–2027 was 24 August 2026 at 16:00. Use it only as historical planning context and check the next official call for new dates."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","8-What a DSU benefit may contain",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"What a DSU benefit may contain"}],[["$","p","Depending on the authority and student status, support may combine a monetary grant with catering, accommodation or other services. The headline amount can be affected by services provided and later verification. Read the payment schedule and conditions before building a budget.",{"children":"Depending on the authority and student status, support may combine a monetary grant with catering, accommodation or other services. The headline amount can be affected by services provided and later verification. Read the payment schedule and conditions before building a budget."}],["$","p","Plan for tuition and mandatory university charges separately. A DSU application can interact with fee reductions, but the university explains how fees are assessed and when documents must be registered.",{"children":"Plan for tuition and mandatory university charges separately. A DSU application can interact with fee reductions, but the university explains how fees are assessed and when documents must be registered."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2a:["$","section","9-Final DSU application checklist",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"Final DSU application checklist"}],[["$","p","Complete this check from the current call and keep a saved copy of every submitted record.",{"children":"Complete this check from the current call and keep a saved copy of every submitted record."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L35",null,{"id":"guides/italy-dsu-scholarships:section-10","title":"Check your progress","items":["Identify the responsible authority and current academic year.","Record household, income and asset reference years.","Use the call’s issuing, translation and authentication rules.","Submit the scholarship request separately from assessment documents.","Record enrolment, credit and payment conditions."]}],"$undefined","$undefined"]}]
2b:["$","section","10-Plan money before the first payment",{"className":"article-section","id":"section-11","children":[["$","h2",null,{"children":"Plan money before the first payment"}],[["$","p","Make three separate columns: confirmed grant cash, services such as meals/housing and costs you must pay yourself. Keep deposits, travel and early rent in an arrival-cash budget. Do not count an unawarded benefit as money already available.",{"children":"Make three separate columns: confirmed grant cash, services such as meals/housing and costs you must pay yourself. Keep deposits, travel and early rent in an arrival-cash budget. Do not count an unawarded benefit as money already available."}],["$","p","A provisional ranking or economic eligibility is not a guarantee of a room or immediate payment. Follow the award decision, required follow-up actions and published payment schedule.",{"children":"A provisional ranking or economic eligibility is not a guarantee of a room or immediate payment. Follow the award decision, required follow-up actions and published payment schedule."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Plan money before the first payment","children":[["$","$L4","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Estimate your funding gap",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/isee-parificato-international-students/",{"href":"/guides/isee-parificato-international-students/","children":["Foreign-income document guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2c:["$","section","11-Italy: continue with the right admission and funding route",{"className":"article-section","id":"section-12","children":[["$","h2",null,{"children":"Italy: continue with the right admission and funding route"}],[["$","p","Use these connected guides to compare institution rules, funding conditions and the next application task. Each guide identifies the official sources and the cycle it describes.",{"children":"Use these connected guides to compare institution rules, funding conditions and the next application task. Each guide identifies the official sources and the cycle it describes."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Italy: continue with the right admission and funding route","children":[["$","$L4","/scholarships/maeci-scholarship/",{"href":"/scholarships/maeci-scholarship/","children":["MAECI Italian Government Scholarship: eligibility, funding and application",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/ergo-scholarship/",{"href":"/scholarships/ergo-scholarship/","children":["ER.GO scholarship for international students: documents, status and application",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/edisu-piemonte/",{"href":"/scholarships/edisu-piemonte/","children":["EDISU Piemonte scholarship: documents, housing and the correct application route",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/university-of-turin-admissions-scholarships/",{"href":"/guides/university-of-turin-admissions-scholarships/","children":["University of Turin admissions and scholarships for international students",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/university-of-pavia-admissions-scholarships/",{"href":"/guides/university-of-pavia-admissions-scholarships/","children":["University of Pavia admissions and scholarships: a practical application guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/politecnico-di-torino-admissions-scholarships/",{"href":"/guides/politecnico-di-torino-admissions-scholarships/","children":["Politecnico di Torino admissions and scholarships: choose your application route",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
