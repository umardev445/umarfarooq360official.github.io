1c:["$","section","1-Compare three funding routes without mixing eligibility",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Compare three funding routes without mixing eligibility"}],[["$","p","The University of Milan publishes separate information for international scholarships, regional benefits and university scholarships. Compare the current calls rather than assuming one standard award for all admitted students. Each route can have its own financial, academic, nationality or enrolment conditions.",{"children":"The University of Milan publishes separate information for international scholarships, regional benefits and university scholarships. Compare the current calls rather than assuming one standard award for all admitted students. Each route can have its own financial, academic, nationality or enrolment conditions."}],["$","p","The international scholarship page reviewed includes the European Futures 2026/27 call. Its existence does not mean it funds every non-EU applicant or that its application is currently open. Read the named call and its ranking or amendment before using its benefits in a budget.",{"children":"The international scholarship page reviewed includes the European Futures 2026/27 call. Its existence does not mean it funds every non-EU applicant or that its application is currently open. Read the named call and its ranking or amendment before using its benefits in a budget."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"University of Milan funding routes","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"University of Milan funding routes"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route",{"scope":"col","children":"Route"}],["$","th","Main check",{"scope":"col","children":"Main check"}],["$","th","Next action",{"scope":"col","children":"Next action"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Regional scholarship"}],["$","td","1",{"children":"Current income, assets, merit and enrolment conditions"}],["$","td","2",{"children":"Read the regional benefit competition"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"University scholarship"}],["$","td","1",{"children":"Target students and selection conditions"}],["$","td","2",{"children":"Read the university scholarship call"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"International named award"}],["$","td","1",{"children":"Nationality, degree and application rules"}],["$","td","2",{"children":"Open the exact award notice; avoid generic promises"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.unimi.it/en/study/financial-support/international-scholarships",{"children":["",["$","a",null,{"href":"https://www.unimi.it/en/study/financial-support/international-scholarships","target":"_blank","rel":"noreferrer","children":"University of Milan funding overview"}]]}]]]}],"$undefined"]}]
1d:["$","section","2-Admission and financial evidence belong to separate files",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Admission and financial evidence belong to separate files"}],[["$","p","For admission, organise the degree certificate or expected-completion evidence, transcript, grading scale and the course-specific materials requested. Preserve both originals and required translations. A general statement of purpose cannot replace a mandatory academic document.",{"children":"For admission, organise the degree certificate or expected-completion evidence, transcript, grading scale and the course-specific materials requested. Preserve both originals and required translations. A general statement of purpose cannot replace a mandatory academic document."}],["$","p","For benefits or fee reductions, check the relevant financial evidence procedure. If your household income or assets are abroad, ask which documents and certification route apply. Do not assume that the documents accepted for a visa are automatically enough for a regional scholarship.",{"children":"For benefits or fee reductions, check the relevant financial evidence procedure. If your household income or assets are abroad, ask which documents and certification route apply. Do not assume that the documents accepted for a visa are automatically enough for a regional scholarship."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Admission and financial evidence belong to separate files","children":[["$","$L4","/guides/isee-parificato-international-students/",{"href":"/guides/isee-parificato-international-students/","children":["Italy financial-document planning",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1e:["$","section","3-Fees: model your profile rather than quoting one universal figure",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Fees: model your profile rather than quoting one universal figure"}],[["$","p","La Statale’s current fee hub identifies the 2026/27 rules and separates tuition, ISEE certification, waivers and refunds. Use those rules for your study type and circumstances. Application charges and the instalments needed for enrolment should be recorded separately.",{"children":"La Statale’s current fee hub identifies the 2026/27 rules and separates tuition, ISEE certification, waivers and refunds. Use those rules for your study type and circumstances. Application charges and the instalments needed for enrolment should be recorded separately."}],["$","p","Before treating a scholarship as a tuition waiver, confirm which charges it covers and when the university recognises the exemption. Keep a copy of the fee calculation and every payment receipt. A funding application still pending is not the same as an approved fee adjustment.",{"children":"Before treating a scholarship as a tuition waiver, confirm which charges it covers and when the university recognises the exemption. Keep a copy of the fee calculation and every payment receipt. A funding application still pending is not the same as an approved fee adjustment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.unimi.it/en/study/bachelor-and-master-study/fees-and-how-pay-them",{"children":["",["$","a",null,{"href":"https://www.unimi.it/en/study/bachelor-and-master-study/fees-and-how-pay-them","target":"_blank","rel":"noreferrer","children":"University of Milan fees and payment routes"}]]}]]]}],"$undefined"]}]
1f:["$","section","4-Build an application sequence with dependencies",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Build an application sequence with dependencies"}],[["$","p","Use the programme deadline as one milestone, not the only date. A foreign qualification review, language test, scholarship application and visa track can each need work before or after the admission result. Put the owner of each action next to its deadline.",{"children":"Use the programme deadline as one milestone, not the only date. A foreign qualification review, language test, scholarship application and visa track can each need work before or after the admission result. Put the owner of each action next to its deadline."}],["$","p","If you receive a conditional result, write down the condition in your own words and attach the official message. This prevents a common mistake: treating an invitation to complete checks as an unconditional final registration.",{"children":"If you receive a conditional result, write down the condition in your own words and attach the official message. This prevents a common mistake: treating an invitation to complete checks as an unconditional final registration."}]],["$","ol",null,{"className":"process-steps","aria-label":"Build an application sequence with dependencies","children":[["$","li","Verify La Statale, degree and intake",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Verify La Statale, degree and intake"}]]}],["$","li","Check selection and foreign-qualification requirements",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Check selection and foreign-qualification requirements"}]]}],["$","li","Submit the academic application with its receipt",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Submit the academic application with its receipt"}]]}],["$","li","Complete the relevant funding and fee-reduction procedures",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Complete the relevant funding and fee-reduction procedures"}]]}],["$","li","Follow enrolment, Universitaly and visa instructions for your category",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Follow enrolment, Universitaly and visa instructions for your category"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","5-Budget for Milan before support is paid",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Budget for Milan before support is paid"}],[["$","p","Housing costs depend on location, room type and contract, so obtain actual accommodation quotes rather than using a national Italy average. Include the deposit and any initial temporary stay. Compare accommodation through the university or benefit route with private options without assuming allocation.",{"children":"Housing costs depend on location, room type and contract, so obtain actual accommodation quotes rather than using a national Italy average. Include the deposit and any initial temporary stay. Compare accommodation through the university or benefit route with private options without assuming allocation."}],["$","p","Use three funding columns: requested, confirmed and received. If a benefit is confirmed but paid later, you still need money for arrival. Review whether another award affects eligibility before accepting or spending both.",{"children":"Use three funding columns: requested, confirmed and received. If a benefit is confirmed but paid later, you still need money for arrival. Review whether another award affects eligibility before accepting or spending both."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L24",null,{"id":"guides/university-of-milan-admissions-scholarships:section-6","title":"Check your progress","items":["Correct Milan institution verified","Programme language and selection confirmed","Funding calls compared by eligibility","Fee calculation matched to applicant profile","First-month cash and housing deposit budgeted"]}],"$undefined","$undefined"]}]
