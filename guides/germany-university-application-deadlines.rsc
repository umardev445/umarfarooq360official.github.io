20:["$","section","2-VPD processing time is not your university deadline",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"VPD processing time is not your university deadline"}],[["$","p","uni-assist says VPD processing usually takes four to six weeks and recommends requesting it ideally at least eight weeks before the deadline. These are planning guidelines, not a guarantee that a late file will be accepted. A VPD request alone does not apply you to the degree.",{"children":"uni-assist says VPD processing usually takes four to six weeks and recommends requesting it ideally at least eight weeks before the deadline. These are planning guidelines, not a guarantee that a late file will be accepted. A VPD request alone does not apply you to the degree."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"VPD processing time is not your university deadline","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"VPD processing time is not your university deadline"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route",{"scope":"col","children":"Route"}],["$","th","Submission responsibility",{"scope":"col","children":"Submission responsibility"}],["$","th","Receipt to save",{"scope":"col","children":"Receipt to save"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Direct university route"}],["$","td","1",{"children":"Apply through the university’s stated portal"}],["$","td","2",{"children":"University submission confirmation"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Standard uni-assist route"}],["$","td","1",{"children":"Use My assist and meet the selected programme’s conditions"}],["$","td","2",{"children":"Paid/submitted application and evaluation messages"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"VPD route"}],["$","td","1",{"children":"Request the review, then apply to the university with the VPD"}],["$","td","2",{"children":"Both review result and university application receipt"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for VPD processing time is not your university deadline","children":[["$","$L4","/guides/uni-assist-application/",{"href":"/guides/uni-assist-application/","children":["Understand uni-assist",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/vpd-germany/",{"href":"/guides/vpd-germany/","children":["VPD steps and timing",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
21:["$","section","3-Build a sixteen-week application timeline",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Build a sixteen-week application timeline"}],[["$","p","A safe plan begins before the portal opens. Qualification research, language tests, certified translations and programme-specific documents can take longer than the final upload.",{"children":"A safe plan begins before the portal opens. Qualification research, language tests, certified translations and programme-specific documents can take longer than the final upload."}],["$","p","uni-assist recommends applying at least eight weeks before the deadline so missing-document issues can be identified. Treat that as a minimum planning buffer rather than permission to delay preparation.",{"children":"uni-assist recommends applying at least eight weeks before the deadline so missing-document issues can be identified. Treat that as a minimum planning buffer rather than permission to delay preparation."}]],["$","ol",null,{"className":"process-steps","aria-label":"Build a sixteen-week application timeline","children":[["$","li","16+ weeks: verify route and requirements",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"16+ weeks: verify route and requirements"}]]}],["$","li","12+ weeks: order documents and translations",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"12+ weeks: order documents and translations"}]]}],["$","li","8+ weeks: submit uni-assist or request VPD",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"8+ weeks: submit uni-assist or request VPD"}]]}],["$","li","Before deadline: complete the university application",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Before deadline: complete the university application"}]]}],["$","li","After submission: monitor portal and email",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"After submission: monitor portal and email"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","4-A VPD creates two deadlines",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"A VPD creates two deadlines"}],[["$","p","First submit a complete VPD request through uni-assist. After the evaluation, download the VPD and submit it with the direct university application before that institution's deadline.",{"children":"First submit a complete VPD request through uni-assist. After the evaluation, download the VPD and submit it with the direct university application before that institution's deadline."}],["$","p","uni-assist states that a VPD is normally valid for one year from issue, but it is issued for a chosen university. Recheck the programme and intake instructions before reusing it.",{"children":"uni-assist states that a VPD is normally valid for one year from issue, but it is issued for a chosen university. Recheck the programme and intake instructions before reusing it."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for A VPD creates two deadlines","children":[["$","$L4","/guides/study-in-germany-admission-requirements/",{"href":"/guides/study-in-germany-admission-requirements/","children":["Understand uni-assist and VPD",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
23:["$","section","5-Track every programme as a separate record",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Track every programme as a separate record"}],[["$","p","Create one row per degree rather than one row per university. A university can use different dates and portals for bachelor's, master's, restricted, non-restricted, Studienkolleg and international applications.",{"children":"Create one row per degree rather than one row per university. A university can use different dates and portals for bachelor's, master's, restricted, non-restricted, Studienkolleg and international applications."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Minimum fields for a Germany application tracker","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Minimum fields for a Germany application tracker"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Field",{"scope":"col","children":"Field"}],["$","th","What to record",{"scope":"col","children":"What to record"}],["$","th","Why it matters",{"scope":"col","children":"Why it matters"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Degree and intake"}],["$","td","1",{"children":"Exact programme title and semester"}],["$","td","2",{"children":"Prevents mixing similar course pages"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Application owner"}],["$","td","1",{"children":"Direct, uni-assist, VPD or another route"}],["$","td","2",{"children":"Determines the actual sequence"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Portal opens"}],["$","td","1",{"children":"First date sub