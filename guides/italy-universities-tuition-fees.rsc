19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"The lowest advertised fee is not everyone's bill. Compare the academic year, degree, residence category, mandatory charges and waiver conditions before choosing a university."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Use the university-specific profile for your category, then add living and arrival expenses to the budget."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","/guides/university-of-padua-admissions-scholarships/",{"href":"/guides/university-of-padua-admissions-scholarships/","children":["Padua fee categories",["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/politecnico-di-milano-masters-admissions/",{"href":"/guides/politecnico-di-milano-masters-admissions/","children":["Polimi tuition and funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/university-of-bologna-admissions-scholarships/",{"href":"/guides/university-of-bologna-admissions-scholarships/","children":["Bologna fixed and variable fees",["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Compare the same applicant profile",{"hre