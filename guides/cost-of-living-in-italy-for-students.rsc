ion quote and personal assumptions"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Tuition and insurance"}],"$L1b","$L1c"],"$undefined"]}],"$L1d","$L1e"]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$L1f"]}],"$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}],false,"$L2a","$L2b"]}],"$L2c"]}]
