19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Build a realistic Italy budget before choosing a university or scholarship. Compare recurring monthly costs with arrival expenses, and test your own figures in the calculator rather than relying on one national average."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Start with the comparison or checklist below, then open the current instructions for your exact programme or route."]}],"$undefined"]}],false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Separate recurring costs from arrival cash",{"href":"#section-1","children":"Separate recurring costs from arrival cash"}],["$","a","Separate monthly costs from arrival costs",{"href":"#section-2","children":"Separate monthly costs from arrival costs"}],["$","a","Build a city-specific housing plan",{"href":"#section-3","children":"Build a city-specific housing plan"}],["$","a","Food, transport and everyday costs",{"href":"#section-4","children":"Food, transport and everyday costs"}],["$","a","How scholarships change the cash-flow plan",{"href":"#section-5","children":"How scholarships change the cash-flow plan"}],["$","a","Use the free Italy study cost calculator",{"href":"#section-6","children":"Use the free Italy study cost calculator"}],["$","a","Published examples: distinguish guidance from a housing quote",{"href":"#section-7","children":"Published examples: distinguish guidance from a housing quote"}],["$","a","Worked monthly budget: show every assumption",{"href":"#