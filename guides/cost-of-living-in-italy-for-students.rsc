22:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","How much does it cost to live in Italy as a student?",{"children":[["$","summary",null,{"children":["How much does it cost to live in Italy as a student?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"There is no single amount. Housing, city, lifestyle and scholarship services produce large differences, so build a city-specific monthly and arrival budget."}]]}],["$","details","Is Milan more expensive for students?",{"children":[["$","summary",null,{"children":["Is Milan more expensive for students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Housing demand often makes Milan a higher-budget destination than many smaller cities, but the actual room, commute and scholarship support determine the final cost."}]]}],["$","details","Does a DSU scholarship cover all living costs?",{"children":[["$","summary",null,{"children":["Does a DSU scholarship cover all living costs?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not automatically. Benefits and payment timing vary by region, student status and current call. Compare cash, meals, accommodation and uncovered costs separately."}]]}],["$","details","Should I include part-time work in my budget?",{"children":[["$","summary",null,{"children":["Should I include part-time work in my budget?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Treat unconfirmed work income as a possible later benefit, not as the money required for visa, travel or the first months."}]]}]]}]]}]
