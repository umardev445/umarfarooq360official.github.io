20:["$","section","1-Separate monthly costs from arrival costs",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Separate monthly costs from arrival costs"}],[["$","p","Monthly planning normally covers rent, utilities, food, local transport, phone, study materials and personal spending. Arrival planning includes travel, visa-related expenses, housing deposits, initial rent, residence-permit costs and items needed before the first scholarship payment.",{"children":"Monthly planning normally covers rent, utilities, food, local transport, phone, study materials and personal spending. Arrival planning includes travel, visa-related expenses, housing deposits, initial rent, residence-permit costs and items needed before the first scholarship payment."}],["$","p","Keeping the two budgets separate prevents a student from appearing able to afford the year while lacking the cash needed during the first weeks.",{"children":"Keeping the two budgets separate prevents a student from appearing able to afford the year while lacking the cash needed during the first weeks."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Recurring: rent and utilities",{"children":"Recurring: rent and utilities"}],["$","li","Recurring: food and transport",{"children":"Recurring: food and transport"}],["$","li","Recurring: phone, health and study costs",{"children":"Recurring: phone, health and study costs"}],["$","li","One-time: visa and travel",{"children":"One-time: visa and travel"}],["$","li","One-time: deposit and first rent",{"children":"One-time: deposit and first rent"}],["$","li","One-time: residence permit and setup costs",{"children":"One-time: residence permit and setup costs"}]]}],"$undefined","$undefined","$undefined"]}]
21:["$","section","2-Build a city-specific housing plan",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Build a city-specific housing plan"}],[["$","p","Compare university residences, regional accommodation, shared rooms, private rooms and studio apartments. Ask whether utilities, internet, condominium charges or registration fees are included.",{"children":"Compare university residences, regional accommodation, shared rooms, private rooms and studio apartments. Ask whether utilities, internet, condominium charges or registration fees are included."}],["$","p","Never transfer a deposit only because a social-media advertiser creates urgency. Verify the property, contract, owner or authorised agent and cancellation terms. University housing offices can provide safer starting points but availability is limited.",{"children":"Never transfer a deposit only because a social-media advertiser creates urgency. Verify the property, contract, owner or authorised agent and cancellation terms. University housing offices can provide safer starting points but availability is limited."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","3-Food, transport and everyday costs",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Food, transport and everyday costs"}],[["$","p","Cooking at home, using student canteens and buying a student transport pass can reduce recurring costs. Your campus location matters: cheaper rent outside the city centre may create higher transport costs and longer travel time.",{"children":"Cooking at home, using student canteens and buying a student transport pass can reduce recurring costs. Your campus location matters: cheaper rent outside the city centre may create higher transport costs and longer travel time."}],["$","p","Add a buffer for seasonal utilities, course materials, clothing, health expenses and trips required for documents or appointments.",{"children":"Add a buffer for seasonal utilities, course materials, clothing, health expenses and trips required for documents or appointments."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","4-How scholarships change the cash-flow plan",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"How scholarships change the cash-flow plan"}],[["$","p","A tuition waiver reduces university cost but may not pay rent or food. A regional benefit can include cash, meals or accommodation, but payment dates and student-status rules matter as much as the advertised value.",{"children":"A tuition waiver reduces university cost but may not pay rent or food. A regional benefit can include cash, meals or accommodation, but payment dates and student-status rules matter as much as the advertised value."}],["$","p","Calculate how much money is needed before the first confirmed payment. Keep a contingency amount and avoid building the budget around work income that is not yet secured.",{"children":"Calculate how much money is needed before the first confirmed payment. Keep a contingency amount and avoid building the budget around work income that is not yet secured."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","5-Use the free Italy study cost calculator",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Use the free Italy study cost calculator"}],[["$","p","Enter your expected tuition, rent, utilities, food, transport, insurance, travel and scholarship. The calculator separates annual recurring costs, arrival costs and the estimated funding gap.",{"children":"Enter your expected tuition, rent, utilities, food, transport, insurance, travel and scholarship. The calculator separates annual recurring costs, arrival costs and the estimated funding gap."}],["$","p","Save the result as a planning estimate and replace every placeholder with a quote or official figure from your university, housing provider, scholarship owner or government source.",{"children":"Save the result as a planning estimate and replace every placeholder with a quote or official figure from your university, housing provider, scholarship owner or government source."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Choose a city starting point",{"children":"Choose a city starting point"}],["$","li","Replace rent with an actual housing estimate",{"children":"Replace rent with an actual housing estimate"}],["$","li","Add tuition after any verified waiver",{"children":"Add tuition after any verified waiver"}],["$","li","Enter only confirmed scholarship support",{"children":"Enter only confirmed scholarship support"}],["$","li","Keep a separate arrival cash target",{"children":"Keep a separate arrival cash target"}]]}],"$undefined","$undefined","$undefined"]}]
25:["$","section","6-Published examples: distinguish guidance from a housing quote",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Published examples: distinguish guidance from a housing quote"}],[["$","p","University cost pages give a starting point, not a guaranteed price for an available room. Checked 13 October 2026, Padua’s page lists a single room at €300–€600 plus expenses; Bologna’s page gives an approximate single room in a shared apartment at €400 plus utilities. Both list weekly supermarket groceries around €60.",{"children":"University cost pages give a starting point, not a guaranteed price for an available room. Checked 13 October 2026, Padua’s page lists a single room at €300–€600 plus expenses; Bologna’s page gives an approximate single room in a shared apartment at €400 plus utilities. Both list weekly supermarket groceries around €60."}],["$","p","These are the institutions’ indicative examples, not a measured current rental-market survey. Replace housing with an actual contract or offer for your period. Do not use older public transport or insurance examples as legal or current supplier prices without checking the responsible source.",{"children":"These are the institutions’ indicative examples, not a measured current rental-market survey. Replace housing with an actual contract or offer for your period. Do not use older public transport or insurance examples as legal or current supplier prices without checking the responsible source."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Institutional examples consulted 13 October 2026","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Institutional examples consulted 13 October 2026"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Source",{"scope":"col","children":"Source"}],["$","th","Published example",{"scope":"col","children":"Published example"}],["$","th","Interpretation",{"scope":"col","children":"Interpretation"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"University of Padua"}],["$","td","1",{"children":"Single room: €300–€600 plus expenses"}],["$","td","2",{"children":"An indicative range, not an available offer"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"University of Bologna"}],["$","td","1",{"children":"Single room in shared flat: about €400 plus utilities"}],["$","td","2",{"children":"An approximate example; find current accommodation"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Both university pages"}],["$","td","1",{"children":"Supermarket groceries: about €60 per week"}],["$","td","2",{"children":"Convert weeks correctly and adapt to your needs"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","7-Worked monthly budget: show every assumption",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Worked monthly budget: show every assumption"}],[["$","p","The following is an original teaching budget, not a recommended amount, visa threshold or city price. Suppose a student has an actual room quote of €500, plans €80 for utilities and internet, €260 for food, €30 for local travel, €15 for a phone and €65 for other regular expenses.",{"children":"The following is an original teaching budget, not a recommended amount, visa threshold or city price. Suppose a student has an actual room quote of €500, plans €80 for utilities and internet, €260 for food, €30 for local travel, €15 for a phone and €65 for other regular expenses."}],["$","p","The total is €950 per month: 500 + 80 + 260 + 30 + 15 + 65. Twelve months would be €11,400 before tuition, insurance, travel and one-off costs. If food is estimated weekly, use approximately 52 weeks divided by 12 for an average month; four weeks per month understates a full year.",{"children":"The total is €950 per month: 500 + 80 + 260 + 30 + 15 + 65. Twelve months would be €11,400 before tuition, insurance, travel and one-off costs. If food is estimated weekly, use approximately 52 weeks divided by 12 for an average month; four weeks per month understates a full year."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Fictional budget — replace each value with your evidence","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Fictional budget — replace each value with your evidence"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Expense",{"scope":"col","children":"Expense"}],["$","th","Monthly example (€)",{"scope":"col","children":"Monthly example (€)"}],["$","th","Evidence needed",{"scope":"col","children":"Evidence needed"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Rent"}],["$","td","1",{"children":"500"}],["$","td","2",{"children":"Actual room offer and contract"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Utilities and internet"}],["$","td","1",{"children":"80"}],["$","td","2",{"children":"What the landlord includes or excludes"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Food"}],["$","td","1",{"children":"260"}],["$","td","2",{"children":"Personal plan and current prices"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Local transport"}],["$","td","1",{"children":"30"}],["$","td","2",{"children":"Route and current student fare"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Phone"}],["$","td","1",{"children":"15"}],["$","td","2",{"children":"Available tariff"}]],"$undefined"]}],["$","tr","5",{"children":[[["$","th","0",{"scope":"row","children":"Other recurring costs"}],["$","td","1",{"children":"65"}],["$","td","2",{"children":"Course and personal assumptions"}]],"$undefined"]}],["$","tr","6",{"children":[[["$","th","0",{"scope":"row","children":"Total recurring"}],["$","td","1",{"children":"950"}],["$","td","2",{"children":"Sum of distinct costs"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
27:["$","section","8-Arrival cash is different from annual affordability",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Arrival cash is different from annual affordability"}],[["$","p","Using the same fictional budget, suppose the refundable deposit is €1,000, travel €350 and initial document/setup costs €250. These one-off items total €1,600. If the first confirmed scholarship payment arrives after two months, two months of living costs require another €1,900. The illustrative pre-payment cash target is therefore €3,500, plus tuition and insurance payable before that payment.",{"children":"Using the same fictional budget, suppose the refundable deposit is €1,000, travel €350 and initial document/setup costs €250. These one-off items total €1,600. If the first confirmed scholarship payment arrives after two months, two months of living costs require another €1,900. The illustrative pre-payment cash target is therefore €3,500, plus tuition and insurance payable before that payment."}],["$","p","Do not add the first two months of living costs again to the annual total: they already form part of €11,400. The arrival target describes timing, while the annual budget describes total expenditure. A refundable deposit still needs cash, but record the possible refund separately rather than assuming it pays an early bill.",{"children":"Do not add the first two months of living costs again to the annual total: they already form part of €11,400. The arrival target describes timing, while the annual budget describes total expenditure. A refundable deposit still needs cash, but record the possible refund separately rather than assuming it pays an early bill."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
28:["$","section","9-Test the budget against a delay or a higher rent",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"Test the budget against a delay or a higher rent"}],[["$","p","A useful budget survives a plausible change. If your room quote rises by €100 per month, the annual recurring budget rises by €1,200. If a scholarship payment is delayed one additional month, the pre-payment cash need rises by the monthly costs that still have to be paid.",{"children":"A useful budget survives a plausible change. If your room quote rises by €100 per month, the annual recurring budget rises by €1,200. If a scholarship payment is delayed one additional month, the pre-payment cash need rises by the monthly costs that still have to be paid."}],["$","p","Choose a contingency based on your actual risks rather than a universal percentage. Check lease cancellation, payment schedules and temporary housing options. Keep uncertain work income separate from money you need before you have permission and an actual job.",{"children":"Choose a contingency based on your actual risks rather than a universal percentage. Check lease cancellation, payment schedules and temporary housing options. Keep uncertain work income separate from money you need before you have permission and an actual job."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","10-Use the calculator with the same boundaries",{"className":"article-section","id":"section-11","children":[["$","h2",null,{"children":"Use the calculator with the same boundaries"}],[["$","p","Enter tuition after any confirmed waiver, recurring living costs, one-off costs and only the support you can justify. If a benefit is meals or accommodation rather than cash, represent the reduced expense carefully and do not count it again as a cash award.",{"children":"Enter tuition after any confirmed waiver, recurring living costs, one-off costs and only the support you can justify. If a benefit is meals or accommodation rather than cash, represent the reduced expense carefully and do not count it again as a cash award."}],["$","p","Record the source and date beside every important input. A calculator helps with arithmetic; it cannot decide benefit eligibility or confirm a landlord’s offer. Revisit the budget when your programme, accommodation or funding conditions change.",{"children":"Record the source and date beside every important input. A calculator helps with arithmetic; it cannot decide benefit eligibility or confirm a landlord’s offer. Revisit the budget when your programme, accommodation or funding conditions change."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Use the calculator with the same boundaries","children":[["$","$L4","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Run the Italy study-cost calculator",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/italy-dsu-scholarships/",{"href":"/guides/italy-dsu-scholarships/","children":["Understand regional DSU support",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/italy-universities-tuition-fees/",{"href":"/guides/italy-universities-tuition-fees/","children":["Compare tuition categories",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2a:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://studyinitaly.esteri.it/Static/InformazioniSoggiorno",{"href":"https://studyinitaly.esteri.it/Static/InformazioniSoggiorno","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Study in Italy: practical stay information"}],["$","span",null,{"children":"Official residence, permit and accommodation guidance"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://www.universitaly.it/first-steps",{"href":"https://www.universitaly.it/first-steps","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Universitaly: first steps in Italy"}],["$","span",null,{"children":"Official student planning and pre-enrolment route"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$2a:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://www.unipd.it/en/costo-vita-padova",{"href":"https://www.unipd.it/en/costo-vita-padova","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"University of Padua: indicative living costs"}],["$","span",null,{"children":"Consulted 13 October 2026. Published examples are indicative, not current housing offers."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$2a:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://www.unibo.it/en/study/life-at-university-and-in-the-city/living-in-the-city/living-costs-in-bologna",{"href":"https://www.unibo.it/en/study/life-at-university-and-in-the-city/living-in-the-city/living-costs-in-bologna","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"University of Bologna: approximate living costs"}],["$","span",null,{"children":"Consulted 13 October 2026. Replace examples with actual quotes; check supplier rates separately."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$2a:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
2b:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","How much does it cost to live in Italy as a student?",{"children":[["$","summary",null,{"children":["How much does it cost to live in Italy as a student?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"There is no single amount. Housing, city, lifestyle and scholarship services produce large differences, so build a city-specific monthly and arrival budget."}]]}],["$","details","Is Milan more expensive for students?",{"children":[["$","summary",null,{"children":["Is Milan more expensive for students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Housing demand often makes Milan a higher-budget destination than many smaller cities, but the actual room, commute and scholarship support determine the final cost."}]]}],["$","details","Does a DSU scholarship cover all living costs?",{"children":[["$","summary",null,{"children":["Does a DSU scholarship cover all living costs?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not automatically. Benefits and payment timing vary by region, student status and current call. Compare cash, meals, accommodation and uncovered costs separately."}]]}],["$","details","Should I include part-time work in my budget?",{"children":[["$","summary",null,{"children":["Should I include part-time work in my budget?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Treat unconfirmed work income as a possible later benefit, not as the money required for visa, travel or the first months."}]]}]]}]]}]
