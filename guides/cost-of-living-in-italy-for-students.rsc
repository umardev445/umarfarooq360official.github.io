1c:["$","section","1-Separate monthly costs from arrival costs",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Separate monthly costs from arrival costs"}],[["$","p","Monthly planning normally covers rent, utilities, food, local transport, phone, study materials and personal spending. Arrival planning includes travel, visa-related expenses, housing deposits, initial rent, residence-permit costs and items needed before the first scholarship payment.",{"children":"Monthly planning normally covers rent, utilities, food, local transport, phone, study materials and personal spending. Arrival planning includes travel, visa-related expenses, housing deposits, initial rent, residence-permit costs and items needed before the first scholarship payment."}],["$","p","Keeping the two budgets separate prevents a student from appearing able to afford the year while lacking the cash needed during the first weeks.",{"children":"Keeping the two budgets separate prevents a student from appearing able to afford the year while lacking the cash needed during the first weeks."}]],"$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Recurring: rent and utilities",{"children":"Recurring: rent and utilities"}],["$","li","Recurring: food and transport",{"children":"Recurring: food and transport"}],["$","li","Recurring: phone, health and study costs",{"children":"Recurring: phone, health and study costs"}],["$","li","One-time: visa and travel",{"children":"One-time: visa and travel"}],["$","li","One-time: deposit and first rent",{"children":"One-time: deposit and first rent"}],["$","li","One-time: residence permit and setup costs",{"children":"One-time: residence permit and setup costs"}]]}],"$undefined","$undefined"]}]
1d:["$","section","2-Build a city-specific housing plan",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Build a city-specific housing plan"}],[["$","p","Compare university residences, regional accommodation, shared rooms, private rooms and studio apartments. Ask whether utilities, internet, condominium charges or registration fees are included.",{"children":"Compare university residences, regional accommodation, shared rooms, private rooms and studio apartments. Ask whether utilities, internet, condominium charges or registration fees are included."}],["$","p","Never transfer a deposit only because a social-media advertiser creates urgency. Verify the property, contract, owner or authorised agent and cancellation terms. University housing offices can provide safer starting points but availability is limited.",{"children":"Never transfer a deposit only because a social-media advertiser creates urgency. Verify the property, contract, owner or authorised agent and cancellation terms. University housing offices can provide safer starting points but availability is limited."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","3-Food, transport and everyday costs",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Food, transport and everyday costs"}],[["$","p","Cooking at home, using student canteens and buying a student transport pass can reduce recurring costs. Your campus location matters: cheaper rent outside the city centre may create higher transport costs and longer travel time.",{"children":"Cooking at home, using student canteens and buying a student transport pass can reduce recurring costs. Your campus location matters: cheaper rent outside the city centre may create higher transport costs and longer travel time."}],["$","p","Add a buffer for seasonal utilities, course materials, clothing, health expenses and trips required for documents or appointments.",{"children":"Add a buffer for seasonal utilities, course materials, clothing, health expenses and trips required for documents or appointments."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","4-How scholarships change the cash-flow plan",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"How scholarships change the cash-flow plan"}],[["$","p","A tuition waiver reduces university cost but may not pay rent or food. A regional benefit can include cash, meals or accommodation, but payment dates and student-status rules matter as much as the advertised value.",{"children":"A tuition waiver reduces university cost but may not pay rent or food. A regional benefit can include cash, meals or accommodation, but payment dates and student-status rules matter as much as the advertised value."}],["$","p","Calculate how much money is needed before the first confirmed payment. Keep a contingency amount and avoid building the budget around work income that is not yet secured.",{"children":"Calculate how much money is needed before the first confirmed payment. Keep a contingency amount and avoid building the budget around work income that is not yet secured."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","5-Use the free Italy study cost calculator",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Use the free Italy study cost calculator"}],[["$","p","Enter your expected tuition, rent, utilities, food, transport, insurance, travel and scholarship. The calculator separates annual recurring costs, arrival costs and the estimated funding gap.",{"children":"Enter your expected tuition, rent, utilities, food, transport, insurance, travel and scholarship. The calculator separates annual recurring costs, arrival costs and the estimated funding gap."}],["$","p","Save the result as a planning estimate and replace every placeholder with a quote or official figure from your university, housing provider, scholarship owner or government source.",{"children":"Save the result as a planning estimate and replace every placeholder with a quote or official figure from your university, housing provider, scholarship owner or government source."}]],"$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Choose a city starting point",{"children":"Choose a city starting point"}],["$","li","Replace rent with an actual housing estimate",{"children":"Replace rent with an actual housing estimate"}],["$","li","Add tuition after any verified waiver",{"children":"Add tuition after any verified waiver"}],["$","li","Enter only confirmed scholarship support",{"children":"Enter only confirmed scholarship support"}],["$","li","Keep a separate arrival cash target",{"children":"Keep a separate arrival cash target"}]]}],"$undefined","$undefined"]}]
