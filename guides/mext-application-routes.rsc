1e:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Current university examples show why availability must be checked",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Current university examples show why availability must be checked"}],[["$","p","Kyoto University’s Graduate School of Science says it will not recruit for the 2027 General Program under the named university-recommendation route. Hokkaido’s e3 separately advertises a 2027 MEXT university-recommendation programme. The notices concern different programmes; neither establishes one global shutdown or one universal opening.",{"children":"Kyoto University’s Graduate School of Science says it will not recruit for the 2027 General Program under the named university-recommendation route. Hokkaido’s e3 separately advertises a 2027 MEXT university-recommendation programme. The notices concern different programmes; neither establishes one global shutdown or one universal opening."}],["$","p","For a Pakistani undergraduate applicant, begin with the Embassy of Japan in Pakistan’s undergraduate-category notice. A research-student call or an overseas university’s master’s nomination form is not a substitute. Read the actual year’s documents and dates before treating any route as open.",{"children":"For a Pakistani undergraduate applicant, begin with the Embassy of Japan in Pakistan’s undergraduate-category notice. A research-student call or an overseas university’s master’s nomination form is not a substitute. Read the actual year’s documents and dates before treating any route as open."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Programme-specific examples reviewed 28 October 2026","tabIndex":0,"children":["$","table",null,{"className":"guide-tab