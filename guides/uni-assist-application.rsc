17:T55c,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is uni-assist the university?","acceptedAnswer":{"@type":"Answer","text":"No. It evaluates qualifications for participating institutions. The university makes its admission decision under its own programme rules."}},{"@type":"Question","name":"How much do two choices cost?","acceptedAnswer":{"@type":"Answer","text":"Under the checked standard schedule, two chosen courses in the same semester cost €105: €75 for the first and €30 for the additional course. Check any institution-specific arrangement before paying."}},{"@type":"Question","name":"Is uploading documents enough?","acceptedAnswer":{"@type":"Answer","text":"No. Follow the portal’s payment and submission steps and retain confirmation. A saved draft or uploaded file is not automatically a completed application."}},{"@type":"Question","name":"Does every German university require uni-assist?","acceptedAnswer":{"@type":"Answer","text":"No. The exact university, programme and qualification instructions determine whether you use a standard application, VPD or direct route."}},{"@type":"Question","name":"Can uni-assist guarantee admission?","acceptedAnswer":{"@type":"Answer","text":"No. Evaluation does not replace university selection, language checks, programme requirements or funding decisions."}}]}1:["$","main",null,{"id":"main-content","className":"$undefined","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/uni-assist-application/\",\"name\":\"uni-assist application: documents, fees and the right submission route\",\"description\":\"Plan your uni-assist application, compare standard and VPD routes, calculate handling fees and avoid missing the separate university submission.\",\"url\":\"https://aspirecompass.org/guides/uni-assist-application/\",\"inLanguage\":\"en