1b:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Application routes: identify the university’s requirement","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Application routes: identify the university’s requirement"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Instruction on the course page",{"scope":"col","children":"Instruction on the course page"}],["$","th","Your action",{"scope":"col","children":"Your action"}],["$","th","Completion evidence",{"scope":"col","children":"Completion evidence"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Apply via uni-assist"}],["$","td","1",{"children":"Follow the specified course application workflow"}],["$","td","2",{"children":"Submitted application and payment confirmation"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Obtain a VPD, then apply directly"}],["$","td","1",{"children":"Request the named university’s VPD and complete its own portal"}],["$","td","2",{"children":"VPD plus separate university application"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Apply directly without uni-assist"}],["$","td","1",{"children":"Use the institution’s stated portal"}],["$","td","2",{"children":"University submission confirmation"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://www.uni-assist.de/en/how-to-apply/get-information/","target":"_blank","rel":"noreferrer","children":"Official guidance"}]]}]]
1c:["$","section","1-Prepare educational evidence before uploading",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Prepare educational evidence before uploading"}],[["$","p","Make an inventory of your actual qualification history: school leaving certificate, university study, degree certificate when available, transcript and the grading information supplied by the issuing institution. Compare it with the country instructions and course requirements. Do not assume one generic document checklist covers every applicant.",{"children":"Make an inventory of your actual qualification history: school leaving certificate, university study, degree certificate when available, transcript and the grading information supplied by the issuing institution. Compare it with the country instructions and course requirements. Do not assume one generic document checklist covers every applicant."}],["$","p","Use clear scans that include all pages and any relevant reverse side. Keep the original-language document with the required translation rather than replacing it with an English summary you wrote yourself. Certification, translation and additional country-specific evidence must follow the official instructions for your case.",{"children":"Use clear scans that include all pages and any relevant reverse side. Keep the original-language document with the required translation rather than replacing it with an English summary you wrote yourself. Certification, translation and additional country-specific evidence must follow the official instructions for your case."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L26",null,{"id":"guides/uni-assist-application:section-2","title":"Check your progress","items":["My name and dates are consistent across the application.","Every required page is readable and correctly oriented.","Translations accompany the relevant originals where required.","The qualification country instructions have been checked.","Any programme-specific request is recorded separately."]}],"$undefined","$undefined"]}]
1d:["$","section","2-Calculate the handling fee by course and semester",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Calculate the handling fee by course and semester"}],[["$","p","The checked official fee schedule charges €75 for the first chosen course and €30 for each additional chosen course in the same semester. The fee covers evaluation, not admission or tuition. A new semester can create a new charge.",{"children":"The checked official fee schedule charges €75 for the first chosen course and €30 for each additional chosen course in the same semester. The fee covers evaluation, not admission or tuition. A new semester can create a new charge."}],["$","p","Count courses, not just university names: two courses at one institution are still two choices. Before paying, check whether a university has a specific arrangement and whether your selected procedure is correct. Never treat a fee receipt as confirmation that the academic requirements have been met.",{"children":"Count courses, not just university names: two courses at one institution are still two choices. Before paying, check whether a university has a specific arrangement and whether your selected procedure is correct. Never treat a fee receipt as confirmation that the academic requirements have been met."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Planning examples using the standard handling schedule","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Planning examples using the standard handling schedule"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Choices in one semester",{"scope":"col","children":"Choices in one semester"}],["$","th","Calculation",{"scope":"col","children":"Calculation"}],["$","th","Total",{"scope":"col","children":"Total"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"One course"}],["$","td","1",{"children":"€75"}],["$","td","2",{"children":"€75"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Two courses, including at one university"}],["$","td","1",{"children":"€75 + €30"}],["$","td","2",{"children":"€105"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Three courses"}],["$","td","1",{"children":"€75 + €30 + €30"}],["$","td","2",{"children":"€135"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://www.uni-assist.de/en/how-to-apply/apply-online/pay-submit/","target":"_blank","rel":"noreferrer","children":"Official guidance"}]]}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","3-Submit deliberately: account, choices, documents and payment",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Submit deliberately: account, choices, documents and payment"}],[["$","p","Use your own email address and retain control of the account. Choose the correct semester and course or VPD option, then compare the generated application summary with the university instruction. Fix a wrong degree type or target university before it becomes a processing problem.",{"children":"Use your own email address and retain control of the account. Choose the correct semester and course or VPD option, then compare the generated application summary with the university instruction. Fix a wrong degree type or target university before it becomes a processing problem."}],["$","p","Read each portal status after uploading and payment. A document in an upload area, a saved draft and a submitted application are different things. Save the final confirmation and fee record together so you can identify the application if you need to contact support.",{"children":"Read each portal status after uploading and payment. A document in an upload area, a saved draft and a submitted application are different things. Save the final confirmation and fee record together so you can identify the application if you need to contact support."}]],["$","ol",null,{"className":"process-steps","aria-label":"Submit deliberately: account, choices, documents and payment","children":[["$","li","Confirm the official route and intended semester.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Confirm the official route and intended semester."}]]}],["$","li","Create your own My assist account and select the correct choice.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Create your own My assist account and select the correct choice."}]]}],["$","li","Upload the required educational documents.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Upload the required educational documents."}]]}],["$","li","Follow the payment and submission instructions.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Follow the payment and submission instructions."}]]}],["$","li","Save confirmation and monitor messages.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Save confirmation and monitor messages."}]]}],["$","li","Complete any separate university step, especially for a VPD.",{"children":[["$","span",null,{"children":6}],["$","strong",null,{"children":"Complete any separate university step, especially for a VPD."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.uni-assist.de/en/how-to-apply/apply-online/pay-submit/",{"children":["",["$","a",null,{"href":"https://www.uni-assist.de/en/how-to-apply/apply-online/pay-submit/","target":"_blank","rel":"noreferrer","children":"Official payment and submission instructions"}]]}]]]}],"$undefined"]}]
1f:["$","section","4-Work backwards from the deadline",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Work backwards from the deadline"}],[["$","p","Write down the deadline shown for your exact programme and category, including any time zone. Then set earlier personal dates for obtaining documents, translations and payment. Do not use 15 July or 15 January as a universal promise: university and programme windows differ.",{"children":"Write down the deadline shown for your exact programme and category, including any time zone. Then set earlier personal dates for obtaining documents, translations and payment. Do not use 15 July or 15 January as a universal promise: university and programme windows differ."}],["$","p","For VPD requests, uni-assist describes a usual four-to-six-week processing period and recommends starting ideally at least eight weeks before the university deadline. That is a planning buffer, not guaranteed delivery. Incomplete documents or follow-up questions can extend the process.",{"children":"For VPD requests, uni-assist describes a usual four-to-six-week processing period and recommends starting ideally at least eight weeks before the university deadline. That is a planning buffer, not guaranteed delivery. Incomplete documents or follow-up questions can extend the process."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.uni-assist.de/en/how-to-apply/plan-your-application/vpd/",{"children":["",["$","a",null,{"href":"https://www.uni-assist.de/en/how-to-apply/plan-your-application/vpd/","target":"_blank","rel":"noreferrer","children":"Official VPD timing guidance"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Work backwards from the deadline","children":[["$","$L4","/guides/vpd-germany/",{"href":"/guides/vpd-germany/","children":["Detailed VPD timeline and submission guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/germany-university-application-deadlines/",{"href":"/guides/germany-university-application-deadlines/","children":["Germany application deadlines",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
20:["$","section","5-Read the result and finish the university application",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Read the result and finish the university application"}],[["$","p","Check what the evaluation actually says and whether another action is needed. Keep the assessment, portal correspondence and any university reference number together. If something appears incorrect, write a specific question with the relevant qualification and document page.",{"children":"Check what the evaluation actually says and whether another action is needed. Keep the assessment, portal correspondence and any university reference number together. If something appears incorrect, write a specific question with the relevant qualification and document page."}],["$","p","A positive educational evaluation is not an admission offer. Course selection, language evidence, aptitude assessment and funding may remain the university’s responsibility. The VPD route particularly needs a second submission; put that task in your calendar before waiting for the result.",{"children":"A positive educational evaluation is not an admission offer. Course selection, language evidence, aptitude assessment and funding may remain the university’s responsibility. The VPD route particularly needs a second submission; put that task in your calendar before waiting for the result."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","6-Avoid unnecessary documents and unsafe shortcuts",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Avoid unnecessary documents and unsafe shortcuts"}],[["$","p","Use the required list instead of uploading a large unrelated portfolio. For example, the TUM VPD instructions explain that items such as motivation letters and language certificates are not needed for that assessment, although the university application can require them separately. This illustrates why assessment and admission files should be treated as related but distinct.",{"children":"Use the required list instead of uploading a large unrelated portfolio. For example, the TUM VPD instructions explain that items such as motivation letters and language certificates are not needed for that assessment, although the university application can require them separately. This illustrates why assessment and admission files should be treated as related but distinct."}],["$","p","Keep passwords private and use official support channels. uni-assist’s official information warns that it does not cooperate with commercial agencies to place applicants at German universities. No agency can turn an evaluation fee into guaranteed admission.",{"children":"Keep passwords private and use official support channels. uni-assist’s official information warns that it does not cooperate with commercial agencies to place applicants at German universities. No agency can turn an evaluation fee into guaranteed admission."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.tum.de/en/studies/application/application-info-portal/uni-assist",{"children":["",["$","a",null,{"href":"https://www.tum.de/en/studies/application/application-info-portal/uni-assist","target":"_blank","rel":"noreferrer","children":"TUM’s VPD document distinction"}]]}],["$","span","https://www.uni-assist.de/en/how-to-apply/get-information/",{"children":[" · ",["$","a",null,{"href":"https://www.uni-assist.de/en/how-to-apply/get-information/","target":"_blank","rel":"noreferrer","children":"uni-assist official application information"}]]}]]]}],"$undefined"]}]
22:["$","section","7-Your next useful action",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Your next useful action"}],[["$","p","Create one row per course with the route, deadline, required evidence, charge, submission status and remaining university task. This makes a shortlist actionable without encouraging unnecessary applications.",{"children":"Create one row per course with the route, deadline, required evidence, charge, submission status and remaining university task. This makes a shortlist actionable without encouraging unnecessary applications."}],["$","p","If TUM is on your list, check its own VPD selection instructions and funding rules before using the general workflow. For your budget, keep application charges separate from proof of funds, tuition and living costs.",{"children":"If TUM is on your list, check its own VPD selection instructions and funding rules before using the general workflow. For your budget, keep application charges separate from proof of funds, tuition and living costs."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Your next useful action","children":[["$","$L4","/guides/study-in-germany-admission-requirements/",{"href":"/guides/study-in-germany-admission-requirements/","children":["Germany admission planning",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/technical-university-of-munich-admissions-scholarships/",{"href":"/guides/technical-university-of-munich-admissions-scholarships/","children":["TUM admission and funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/germany-blocked-account-calculator/",{"hre