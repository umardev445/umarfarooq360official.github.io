19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"uni-assist evaluates international educational qualifications for participating universities. Your course may use a standard application, a university-specific VPD or a different direct route. The university’s instructions decide which one applies."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Open the admission instructions for your exact course, qualification country and intended semester before creating or paying for an application."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","#official-sources",{"href":"#official-sources","children":["Official sources",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/team/hafiz-umar-farooq/",{"href":"/team/hafiz-umar-farooq/","children":["Editorial contact",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","First decide which route applies",{"href":"#section-1","children":"First decide which route applies"}],["$","a","Prepare educational evidence before uploading",{"href":"#section-2","children":"Prepare educational evidence before uploading"}],["$","a","Calculate the handling fee by course and semester",{"href":"#section-3","children":"Calculate the handling fee by course and semester"}],["$","a","Submit deliberately: account, choices, documents and payment",{"href":"#section-4","children":"Submit deliberately: account, choices, documents and payment"}],["$","a","Work backwards from the deadline",{"href":"#section-5","children":"Work backwards from the deadline"}],["$","a","Read the result and finish the university application",{"href":"#section-6","children":"Read the result and finish the university application"}],["$","a","Avoid unnecessary documents and unsafe shortcuts",{"href":"#section-7","children":"Avoid unnecessary documents and unsafe shortcuts"}],["$","a","Your next useful action",{"href":"#section-8","children":"Your next useful action"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-First decide which route applies",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"First decide which route applies"}],[["$","p","Begin with the university’s course page, not a search for the cheapest portal. Record the degree, semester, qualification country and applicant category. A university can use different procedures for different programmes, so an instruction from another department is not enough.",{"children":"Begin with the university’s course page, not a search for the cheapest portal. Record the degree, semester, qualification country and applicant category. A university can use different procedures for different programmes, so an instruction from another department is not enough."}],["$","p","A standard uni-assist application and a VPD request are different workflows. In the VPD procedure, you still apply directly to the university with the assessment. For a direct university route, do not buy an unnecessary uni-assist assessment just because another applicant needed one.",{"children":"A standard uni-assist application and a VPD request are different workflows. In the VPD procedure, you still apply directly to the university with the assessment. For a direct university route, do not buy an unnecessary uni-assist assessment just because another applicant needed one."}]],"$undefined","$L1b","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],false,"$L23","$L24"]}],"$L25"]}]
