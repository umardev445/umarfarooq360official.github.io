1d:["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Spring 2027"}],["$","td","1",{"children":"Application closing date: 25 December 2026"}],["$","td","2",{"children":"Registration listed for 3–5 March 2027"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"September 2027"}],["$","td","1",{"children":"1 April–25 June 2027"}],["$","td","2",{"children":"Registration listed for 6–10 September 2027"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Cutoff precision"}],["$","td","1",{"children":"Calendar does not specify a closing time/timezone"}],["$","td","2",{"children":"Ask admissions and submit early"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"CSC funding"}],["$","td","1",{"children":"Reviewed scholarship page contains older-cycle material"}],["$","td","2",{"children":"Do not relabel old dates as a 2027 scholarship call"}]],"$undefined"]}]]}]
1e:["$","section","1-Treat the calendar as an admission schedule",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Treat the calendar as an admission schedule"}],[["$","p","The university’s general dates identify an intake, not a universal scholarship window. Determine whether your chosen degree and programme are offered in that intake. A spring admission entry does not imply that every bachelor’s, master’s or doctoral course starts in March.",{"children":"The university’s general dates identify an intake, not a universal scholarship window. Determine whether your chosen degree and programme are offered in that intake. A spring admission entry does not imply that every bachelor’s, master’s or doctoral course starts in March."}],["$","p","Create separate tracker columns for admission, scholarship, test scores and registration. This prevents a later admission closing date from hiding an earlier award deadline. If the scholarship notice has not been refreshed for your intake, keep that funding route unconfirmed.",{"children":"Create separate tracker columns for admission, scholarship, test scores and registration. This prevents a later admission closing date from hiding an earlier award deadline. If the scholarship notice has not been refreshed for your intake, keep that funding route unconfirmed."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","2-Undergraduate applicants need to resolve the CSCA sequence",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Undergraduate applicants need to resolve the CSCA sequence"}],[["$","p","The reviewed eligibility page requires undergraduate CSCA evidence and lists a 6 January 2027 transcript deadline. That is later than the general spring application closing date in the admission calendar. Do not interpret the later score date as an extension of the application deadline.",{"children":"The reviewed eligibility page requires undergraduate CSCA evidence and lists a 6 January 2027 transcript deadline. That is later than the general spring application closing date in the admission calendar. Do not interpret the later score date as an extension of the application deadline."}],["$","p","Ask admissions how score submission works for your programme and intake, including whether a pending result is accepted at initial submission. Check the required test subjects and language against the course list. A generic test registration is not enough if you select the wrong subject combination.",{"children":"Ask admissions how score submission works for your programme and intake, including whether a pending result is accepted at initial submission. Check the required test subjects and language against the course list. A generic test registration is not enough if you select the wrong subject combination."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","3-Compare CSC and university funding as separate offers",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Compare CSC and university funding as separate offers"}],[["$","p","Jiangsu lists Chinese Government Scholarship and institutional funding information. Read the current dated notice for each option. A historical CSC page or an old Presidential Scholarship example does not establish a new award’s opening, amount or available places.",{"children":"Jiangsu lists Chinese Government Scholarship and institutional funding information. Read the current dated notice for each option. A historical CSC page or an old Presidential Scholarship example does not establish a new award’s opening, amount or available places."}],["$","p","Before calling a route fully funded, record tuition coverage, accommodation, insurance and living support separately. Check whether an award is for new applicants or enrolled students. An award for continuing students should not be counted as guaranteed first-year funding.",{"children":"Before calling a route fully funded, record tuition coverage, accommodation, insurance and living support separately. Check whether an award is for new applicants or enrolled students. An award for continuing students should not be counted as guaranteed first-year funding."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","4-Degree-level requirements are different",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Degree-level requirements are different"}],[["$","p","Read the eligibility section for the intended qualification. Bachelor’s, master’s and doctoral applicants have different academic and document expectations. Language evidence should match the teaching language and the university’s accepted certificates.",{"children":"Read the eligibility section for the intended qualification. Bachelor’s, master’s and doctoral applicants have different academic and document expectations. Language evidence should match the teaching language and the university’s accepted certificates."}],["$","p","If a document is missing, ask the admissions office whether a substitute is permitted and by what date it must be replaced. Do not infer permission from a portal that lets you leave an upload empty. Keep the answer together with your application record.",{"children":"If a document is missing, ask the admissions office whether a substitute is permitted and by what date it must be replaced. Do not infer permission from a portal that lets you leave an upload empty. Keep the answer together with your application record."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","5-Make your statement useful to the reviewer",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Make your statement useful to the reviewer"}],[["$","p","Describe why the selected programme fits your preparation and what you intend to do with the training. A graduate applicant should show the transition from earlier work to the proposed field. If changing disciplines, identify the prerequisite knowledge you already have and the gaps you need to address.",{"children":"Describe why the selected programme fits your preparation and what you intend to do with the training. A graduate applicant should show the transition from earlier work to the proposed field. If changing disciplines, identify the prerequisite knowledge you already have and the gaps you need to address."}],["$","p","Use a CV to document projects, research, employment and relevant skills in chronological order. Explain your contribution to group work and avoid presenting planned publications as completed achievements. Keep all dates consistent with the academic records.",{"children":"Use a CV to document projects, research, employment and relevant skills in chronological order. Explain your contribution to group work and avoid presenting planned publications as completed achievements. Keep all dates consistent with the academic records."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","6-Budget before paying or accepting",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Budget before paying or accepting"}],[["$","p","Read the current tuition, housing and application-payment instructions directly from the Overseas Education College. Confirm the payee and permitted payment method. Do not send money to an individual who claims they can guarantee an offer.",{"children":"Read the current tuition, housing and application-payment instructions directly from the Overseas Education College. Confirm the payee and permitted payment method. Do not send money to an individual who claims they can guarantee an offer."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L28",null,{"id":"guides/jiangsu-university-admissions-scholarships:section-7","title":"Check your progress","items":["Programme offered in the selected intake","General admission and scholarship deadlines separated","Undergraduate CSCA timing clarified where needed","Language and qualification evidence complete","Current funding coverage obtained","Fee instructions checked on the official site","Application and final award records retained"]}],"$undefined","$undefined"]}]
24:["$","section","7-After an offer, move to registration planning",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"After an offer, move to registration planning"}],[["$","p","Read the admission and scholarship decisions as separate documents. Confirm original-document checks, arrival arrangements and what must be done before registration. Use the university’s current instructions for immigration and residence processes rather than assuming admission alone completes them.",{"children":"Read the admission and scholarship decisions as separate documents. Confirm original-document checks, arrival arrangements and what must be done before registration. Use the university’s current instructions for immigration and residence processes rather than assuming admission alone completes them."}],["$","p","Compare Jiangsu with other options on academic fit, verified funding and the remaining personal cost. Its published calendar is helpful planning evidence, but it should not replace the award notice for the scholarship you intend to pursue.",{"children":"Compare Jiangsu with other options on academic fit, verified funding and the remaining personal cost. Its published calendar is helpful planning evidence, but it should not replace the award notice for the scholarship you intend to pursue."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for After an offer, move to registration planning","children":[["$","$L4","/countries/china/",{"href":"/countries/china/","children":["China scholarship comparison",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/csc-scholarship-application/",{"href":"/guides/csc-scholarship-application/","children":["CSC application workflow",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
25:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://oec.ujs.edu.cn/en/ADMISSIONS/Dates_and_Deadlines.htm",{"href":"https://oec.ujs.edu.cn/en/ADMISSIONS/Dates_and_Deadlines.htm","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Jiangsu University admission calendar"}],["$","span",null,{"children":"Official source reviewed 19 October 2026. Intake and programme-specific rules apply."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://oec.ujs.edu.cn/en/ADMISSIONS/Eligibility_and_Requirements.htm",{"href":"https://oec.ujs.edu.cn/en/ADMISSIONS/Eligibility_and_Requirements.htm","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Jiangsu University eligibility and documents"}],["$","span",null,{"children":"Official source reviewed 19 October 2026. Intake and programme-specific rules apply."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$25:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://oec.ujs.edu.cn/en/SCHOLARSHIPS/Chinese_Govt__Scholarship__CSC_.htm",{"href":"https://oec.ujs.edu.cn/en/SCHOLARSHIPS/Chinese_Govt__Scholarship__CSC_.htm","target":"_blank","rel":"norefer