",{"href":"#section-5","children":"Women, subjects and provincial schemes"}],["$","a","Build a useful financial-evidence folder",{"href":"#section-6","children":"Build a useful financial-evidence folder"}],["$","a","A scholarship does not always cover every expense",{"href":"#section-7","children":"A scholarship does not always cover every expense"}],["$","a","Ask the aid office a precise question",{"href":"#section-8","children":"Ask the aid office a precise question"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Choose a route that matches where you will study",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Choose a route that matches where you will study"}],[["$","p","This guide covers education within Pakistan. Overseas undergraduate, master’s and MBA funding has different admission, nomination and travel requirements; use the separate level guides for those decisions.",{"children":"This guide covers education within Pakistan. Overseas undergraduate, master’s and MBA funding has different admission, nomination and travel requirements; use the separate level guides for those decisions."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Domestic funding routes reviewed on 28 October 2026","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Domestic funding routes reviewed on 28 October 2026"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route",{"scope":"col","children":"Route"}],["$","th","Who / where",{"scope":"col","children":"Who / where"}],["$","th","Type and key restriction",{"scope":"col","children":"Type and key restriction"}],["$