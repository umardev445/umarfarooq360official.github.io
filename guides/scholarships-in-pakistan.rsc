1f:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-HEC Need-Based: apply through the institution",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"HEC Need-Based: apply through the institution"}],[["$","p","The official scheme is tied to selected public-sector institutions and the published undergraduate eligibility. It is not a universal payment to every student in every university. Self-finance admission does not meet the cited eligibility.",{"children":"The official scheme is tied to selected public-sector institutions and the published undergraduate eligibility. It is not a universal payment to every student in every university. Self-finance admission does not meet the cited eligibility."}],["$","p","Ask the Financial Aid Office whether your programme and campus participate, whether applications are currently accepted and which assessed household documents are required. Submit through the institution’s stated route rather than sending the form directly to HEC.",{"children":"Ask the Financial Aid Office whether your programme and campus participate, whether applications are currently accepted and which assessed household documents are required. Submit through the institution’s stated route rather than sending the form directly to HEC."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Confirm participation and degree eligibility.",{"children":"Confirm participation and degree eligibility."}],["$","li","Use the institution’s actual application window and form.",{"children":"Use the institution’s actual application window and form."}],["$","li","Explain household income, dependants and relevant expenses accurately.",{"children":"Explain household income, dependants and relevant expenses accurately."}],["$","li","Retain submission evidence and attend an assessment if required.",{"children":"Retain submission evidence and attend an assessment if required."}],["$","li","Read continuation, other-award and reporting conditions before accepting.",{"children":"Read continuation, other-award and reporting conditions before accepting."}]]}],"$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.hec.gov.pk/english/scholarshipsgrants/NBS/Pages/Eligibility-Criteria.aspx",{"children":["",["$","a",null,{"href":"https://www.hec.gov.pk/english/scholarshipsgrants/NBS/Pages/Eligibility-Criteria.aspx","target":"_blank","rel":"noreferrer","children":"HEC NBS eligibility"}]]}],["$","span","https://www.hec.gov.pk/english/scholarshipsgrants/NBS/Pages/How-To-Apply.aspx",{"children":[" · ",["$","a",null,{"href":"https://www.hec.gov.pk/english/scholarshipsgrants/NBS/Pages/How-To-Apply.aspx","target":"_blank","rel":"noreferrer","children":"application route"}]]}]]]}],"$undefined"]}],["$","section","2-LUMS NOP starts before an admission decision",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"LUMS NOP starts before an admission decision"}],[["$","p","The reviewed NOP instructions require at least 80% Matric marks or equivalent O-level grades together with financial need. Applicants must follow the current preparation/selection stage; meeting a threshold does not guarantee entry or funding.",{"children":"The reviewed NOP instructions require at least 80% Matric marks or equivalent O-level grades together with financial need. Applicants must follow the current preparation/selection stage; meeting a threshold does not guarantee entry or funding."}],["$","p","Separate NOP participation, university admission and the eventual financial-aid decision in your tracker. A student already admitted to another institution should not assume this school-stage pipeline functions like a transferable fee grant.",{"children":"Separate NOP participation, university admission and the eventual financial-aid decision in your tracker. A student already admitted to another institution should not assume this school-stage pipeline functions like a transferable fee grant."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$L23","$undefined"]}],"$L24","$L25","$L26","$L27","$L28"]}]
