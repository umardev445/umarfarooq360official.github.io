1e:["$","figure",null,{"className":"page-visual page-visual--inline","children":[["$","img",null,{"src":"/images/study-planning-1280.webp","srcSet":"/images/study-planning-640.webp 640w, /images/study-planning-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Illustrative students comparing study notes and programme information at a library table","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Illustrative editorial image; not a photograph identifying a particular university."}]]}]
1f:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Make a city comparison fair",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Make a city comparison fair"}],[["$","p","A campus dorm, private dorm and shared apartment do not offer the same product. Check meals, utilities, internet, laundry, deposit, commute and holiday access. If one price is a whole flat and the other is per person, convert the unit before comparing.",{"children":"A campus dorm, private dorm and shared apartment do not offer the same product. Check meals, utilities, internet, laundry, deposit, commute and holiday access. If one price is a whole flat and the other is per person, convert the unit before comparing."}],["$","p","The Sabancı annual figures are on a nine-month dorm basis. Dividing the quoted examples by nine produces approximately TRY 25,517–42,328 per occupied month. That is a derived campus-room comparison, not an Istanbul-wide rent range. Summer housing and daily spending remain separate.",{"children":"The Sabancı annual figures are on a nine-month dorm basis. Dividing the quoted examples by nine produces approximately TRY 25,517–42,328 per occupied month. That is a derived campus-room comparison, not an Istanbul-wide rent range. Summer housing and daily spending remain separate."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://dorm.sabanciuniv.edu/tr/yurt-ucretleri",{"children":["",["$","a",null,{"href":"https://dorm.sabanciuniv.edu/tr/yurt-ucretleri","target":"_blank","rel":"noreferrer","children":"Sabancı: dormitory prices and deposit"}]]}],["$","span","https://iro.sabanciuniv.edu/en/tuition-fee",{"children":[" · ",["$","a",null,{"href":"https://iro.sabanciuniv.edu/en/tuition-fee","target":"_blank","rel":"noreferrer","children":"Sabancı: nine-month per-person billing basis"}]]}]]]}],"$undefined"]}],["$","section","2-Worked Ankara budget: a shared apartment",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Worked Ankara budget: a shared apartment"}],[["$","p","Original illustrative case: three students share a flat at an assumed TRY 45,000 monthly. An equal rent split is TRY 15,000 each. One student assumes TRY 10,500 for other monthly spending, bringing their working monthly total to TRY 25,500 before separately itemised extras.",{"children":"Original illustrative case: three students share a flat at an assumed TRY 45,000 monthly. An equal rent split is TRY 15,000 each. One student assumes TRY 10,500 for other monthly spending, bringing their working monthly total to TRY 25,500 before separately itemised extras."}],["$","p","For nine occupied months, that total is TRY 229,500. If they remain for twelve months at the same assumed rates, it becomes TRY 306,000. Neither number is a quote or a guaranteed future price. Actual bills, furnishing, deposits and summer arrangements can change the result.",{"children":"For nine occupied months, that total is TRY 229,500. If they remain for twelve months at the same assumed rates, it becomes TRY 306,000. Neither number is a quote or a guaranteed future price. Actual bills, furnishing, deposits and summer arrangements can change the result."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"A whole-flat rent must be divided only by the people actually sharing that payment. If a flatmate leaves, TRY 45,000 divided between two becomes TRY 22,500 each. Test that downside before committing to a lease."}]]}],"$undefined","$undefined","$undefined","$undefined"]}],"$L23","$L24","$L25","$L26"]}]
