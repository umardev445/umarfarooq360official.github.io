23:["$","section","3-Worked Istanbul budget: teaching-year housing",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Worked Istanbul budget: teaching-year housing"}],[["$","p","Use a current offer rather than an assumed city average. With the listed Sabancı four-person Study room at TRY 229,650 for nine months, an additional fictional daily-spending allowance of TRY 12,000 per month gives TRY 337,650 for those nine months.",{"children":"Use a current offer rather than an assumed city average. With the listed Sabancı four-person Study room at TRY 229,650 for nine months, an additional fictional daily-spending allowance of TRY 12,000 per month gives TRY 337,650 for those nine months."}],["$","p","The calculation is 229,650 + (12,000 × 9). The daily-spending input is an assumption, and tuition is excluded. Add any required deposit to arrival cash; do not quietly divide an annual dorm bill by twelve and assume the room is available all year.",{"children":"The calculation is 229,650 + (12,000 × 9). The daily-spending input is an assumption, and tuition is excluded. Add any required deposit to arrival cash; do not quietly divide an annual dorm bill by twelve and assume the room is available all year."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Worked Istanbul budget: teaching-year housing","children":[["$","$L4","/guides/sabanci-university-admissions-scholarships/",{"href":"/guides/sabanci-university-admissions-scholarships/","children":["Sabancı undergraduate and graduate funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/student-accommodation-turkey/",{"href":"/guides/student-accommodation-turkey/","children":["Housing and deposit questions",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
24:["$","section","4-Arrival cash is not the annual cost divided by twelve",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Arrival cash is not the annual cost divided by twelve"}],[["$","p","A student may owe several things before the first ordinary study month: an initial tuition payment, room deposit, first housing payment, travel and document costs. A scholarship paid later cannot necessarily cover an earlier bill.",{"children":"A student may owe several things before the first ordinary study month: an initial tuition payment, room deposit, first housing payment, travel and document costs. A scholarship paid later cannot necessarily cover an earlier bill."}],["$","p","Use a cash calendar with due dates. Treat refundable deposits as cash required now even if they are not a final expense. Keep an emergency buffer separate from compulsory funds, and do not count income from an unconfirmed part-time job.",{"children":"Use a cash calendar with due dates. Treat refundable deposits as cash required now even if they are not a final expense. Keep an emergency buffer separate from compulsory funds, and do not count income from an unconfirmed part-time job."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Budget on two timelines","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Budget on two timelines"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Line",{"scope":"col","children":"Line"}],["$","th","Annual-cost treatment",{"scope":"col","children":"Annual-cost treatment"}],["$","th","Arrival-cash treatment",{"scope":"col","children":"Arrival-cash treatment"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Tuition"}],["$","td","1",{"children":"Net covered semesters/year"}],["$","td","2",{"children":"Amount due before registration"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Housing"}],["$","td","1",{"children":"Occupied months or actual billed period"}],["$","td","2",{"children":"First bill plus required deposit"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Living"}],["$","td","1",{"children":"Your spending × study months"}],["$","td","2",{"children":"Funds until reliable next payment"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Scholarship"}],["$","td","1",{"children":"Only written amounts and payment months"}],["$","td","2",{"children":"Only funds available before each due date"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Refundable deposit"}],["$","td","1",{"children":"Track separately from consumed cost"}],["$","td","2",{"children":"Include the full payment due"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","5-How to update the budget when prices change",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"How to update the budget when prices change"}],[["$","p","Keep the original-currency source, date and scope beside every price. Recheck the largest uncertain line first, usually housing or tuition, instead of refreshing many small estimates while leaving the room unconfirmed.",{"children":"Keep the original-currency source, date and scope beside every price. Recheck the largest uncertain line first, usually housing or tuition, instead of refreshing many small estimates while leaving the room unconfirmed."}],["$","p","Build a stress case by changing assumptions you control. For example, a 15% rise on an assumed TRY 20,000 monthly cost adds TRY 3,000 per month, or TRY 27,000 over nine months. This is a planning exercise, not an inflation forecast.",{"children":"Build a stress case by changing assumptions you control. For example, a 15% rise on an assumed TRY 20,000 monthly cost adds TRY 3,000 per month, or TRY 27,000 over nine months. This is a planning exercise, not an inflation forecast."}],["$","p","If you fund TRY costs from another currency, test a less favourable exchange rate and transfer charge. Record the rate date so the next review can explain why the estimate moved.",{"children":"If you fund TRY costs from another currency, test a less favourable exchange rate and transfer charge. Record the rate date so the next review can explain why the estimate moved."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for How to update the budget when prices change","children":[["$","$L4","/guides/turkey-university-tuition-fees/",{"href":"/guides/turkey-university-tuition-fees/","children":["Compare university tuition",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
26:["$","section","6-Your student living-cost checklist",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Your student living-cost checklist"}],[["$","p","A useful budget should tell you whether to accept, ask another question or choose a cheaper arrangement.",{"children":"A useful budget should tell you whether to accept, ask another question or choose a cheaper arrangement."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L27",null,{"id":"guides/cost-of-living-in-turkey-for-students:section-7","title":"Check your progress","items":["My room quote names the person/unit, included services and months.","I have kept campus quotes separate from city-wide estimates.","Tuition and daily spending are not accidentally omitted or double-counted.","I can pay deposits and first bills before expected award payments.","I have a fallback for an unavailable room or changed sharing arrangement."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Your student living-cost checklist","children":[["$","a","/downloads/turkey-student-budget.csv",{"href":"/downloads/turkey-student-budget.csv","download":true,"children":["Download the student-budget worksheet (CSV)",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
