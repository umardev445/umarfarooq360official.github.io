27:["$","section","2-Make four admission decisions in order",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Make four admission decisions in order"}],[["$","p","Do not begin with a generic document upload. Identify the degree and intake, then verify the academic, language and submission route before paying for translations or application processing.",{"children":"Do not begin with a generic document upload. Identify the degree and intake, then verify the academic, language and submission route before paying for translations or application processing."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Germany admission decision map","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Germany admission decision map"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Decision",{"scope":"col","children":"Decision"}],["$","th","Question to answer",{"scope":"col","children":"Question to answer"}],["$","th","Primary evidence",{"scope":"col","children":"Primary evidence"}]],["$","th",null,{"scope":"col","children":"Next step"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Academic access"}],["$","td","1",{"children":"Does the previous qualification permit direct or subject-restricted entry?"}],["$","td","2",{"children":"DAAD admission database and university decision"}]],["$","td",null,{"children":["$","$L5",null,{"href":"https://www.daad.de/en/studying-in-germany/requirements/admission-database/","target":"_blank","rel":"noreferrer","children":["Check qualification"," ↗"]}]}]]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Programme fit"}],["$","td","1",{"children":"Are prior subjects, credits, grade or portfolio requirements met?"}],["$","td","2",{"children":"Current degree regulations and admissions page"}]],["$","td",null,{"children":["$","$L5",null,{"href":"https://www.study-in-germany.com/en/plan-your-studies/preparation/application/","target":"_blank","rel":"noreferrer","children":["Application overview"," ↗"]}]}]]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Language"}],["$","td","1",{"children":"Which German or English evidence and score is accepted?"}],["$","td","2",{"children":"Programme-specific certificate list"}]],["$","td",null,{"children":["$","$L5",null,{"href":"https://www.study-in-germany.com/en/plan-your-studies/requirements/language-skills/","target":"_blank","rel":"noreferrer","children":["Language guidance"," ↗"]}]}]]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Application owner"}],["$","td","1",{"children":"Direct university, uni-assist or VPD followed by direct submission?"}],["$","td","2",{"children":"University's international application instructions"}]],["$","td",null,{"children":["$","$L5",null,{"href":"https://www.uni-assist.de/en/apply-in-6-steps","target":"_blank","rel":"noreferrer","children":["uni-assist steps"," ↗"]}]}]]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
28:["$","section","3-Check whether you qualify for direct entry",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Check whether you qualify for direct entry"}],[["$","p","The DAAD admission database gives orientation based on educational background and is prepared with uni-assist, but the higher education institution makes the final admission decision. Save the result as a research note, not as an admission certificate.",{"children":"The DAAD admission database gives orientation based on educational background and is prepared with uni-assist, but the higher education institution makes the final admission decision. Save the result as a research note, not as an admission certificate."}],["$","p","If a school-leaving qualification is not sufficient for direct undergraduate entry, a Studienkolleg and the relevant assessment examination may be required. Master's applicants must separately match the first degree, subject content, credits and grade rules published by the programme.",{"children":"If a school-leaving qualification is not sufficient for direct undergraduate entry, a Studienkolleg and the relevant assessment examination may be required. Master's applicants must separately match the first degree, subject content, credits and grade rules published by the programme."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","4-Direct application, uni-assist and VPD are different routes",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Direct application, uni-assist and VPD are different routes"}],[["$","p","Some institutions receive applications directly. Others ask uni-assist to evaluate and forward an application. A VPD route adds another step: uni-assist evaluates the documents, then the applicant submits the VPD and university application directly before the university deadline.",{"children":"Some institutions receive applications directly. Others ask uni-assist to evaluate and forward an application. A VPD route adds another step: uni-assist evaluates the documents, then the applicant submits the VPD and university application directly before the university deadline."}],["$","p","A VPD is issued for the chosen university and normally takes four to six weeks after a complete submission. Request it early; receiving the VPD does not submit the university application for you.",{"children":"A VPD is issued for the chosen university and normally takes four to six weeks after a complete submission. Request it early; receiving the VPD does not submit the university application for you."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Direct application, uni-assist and VPD are different routes","children":[["$","$L5","https://www.uni-assist.de/en/how-to-apply/plan-your-application/vpd/",{"href":"https://www.uni-assist.de/en/how-to-apply/plan-your-application/vpd/","children":["Read the VPD procedure",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/germany-university-application-deadlines/",{"href":"/guides/germany-university-application-deadlines/","children":["Plan application deadlines",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2a:["$","section","5-Prepare documents without losing context",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Prepare documents without losing context"}],[["$","p","Common categories include the degree or school certificate, complete transcript, the institution's grading system, language evidence and programme-specific material. Upload complete documents rather than selected pages.",{"children":"Common categories include the degree or school certificate, complete transcript, the institution's grading system, language evidence and programme-specific material. Upload complete documents rather than selected pages."}],["$","p","Where a certificate is not issued in German or English, uni-assist generally asks for the original-language document plus a certified translation into German or English. Check country-specific notes and the university's instructions before ordering copies.",{"children":"Where a certificate is not issued in German or English, uni-assist generally asks for the original-language document plus a certified translation into German or English. Check country-specific notes and the university's instructions before ordering copies."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2e",null,{"id":"guides/study-in-germany-admission-requirements:section-6","title":"Check your progress","items":["Complete qualification certificate","Full subject and grade transcript","Official grading-system information","Accepted language certificate","Programme-specific CV, motivation, portfolio or module evidence","Required original-language and certified translations"]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Prepare documents without losing context","children":[["$","$L5","https://www.uni-assist.de/en/how-to-apply/assemble-your-documents/educational-certificates/",{"href":"https://www.uni-assist.de/en/how-to-apply/assemble-your-documents/educational-certificates/","children":["Educational certificate rules",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","https://www.uni-assist.de/en/how-to-apply/assemble-your-documents/translations/",{"href":"https://www.uni-assist.de/en/how-to-apply/assemble-your-documents/translations/","children":["Certified translation rules",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2b:["$","section","6-Keep admission, funding and visa as separate decisions",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Keep admission, funding and visa as separate decisions"}],[["$","p","An academic offer does not automatically provide a scholarship or satisfy the visa proof-of-funds requirement. Likewise, a funding application may need a separate university admission or course nomination.",{"children":"An academic offer does not automatically provide a scholarship or satisfy the visa proof-of-funds requirement. Likewise, a funding application may need a separate university admission or course nomination."}],["$","p","After identifying an admissible programme, compare its actual costs, scholarship route and visa sequence. This prevents an offer from becoming unusable because a financial or immigration requirement was left too late.",{"children":"After identifying an admissible programme, compare its actual costs, scholarship route and visa sequence. This prevents an offer from becoming unusable because a financial or immigration requirement was left too late."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Keep admission, funding and visa as separate decisions","children":[["$","$L5","/scholarships/germany/",{"href":"/scholarships/germany/","children":["Scholarships in Germany",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/germany-student-visa-requirements/",{"href":"/guides/germany-student-visa-requirements/","children":["Germany student visa checklist",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/tools/germany-blocked-account-calculator/",{"href":"/tools/germany-blocked-account-calculator/","children":["Calculate the first-year budget",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2c:["$","section","7-Germany: continue with the right admission and funding route",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Germany: continue with the right admission and funding route"}],[["$","p","Use these connected guides to compare institution rules, funding conditions and the next application task. Each guide identifies the official sources and the cycle it describes.",{"children":"Use these connected guides to compare institution rules, funding conditions and the next application task. Each guide identifies the official sources and the cycle it describes."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Germany: continue with the right admission and funding route","children":[["$","$L5","/guides/uni-assist-application/",{"href":"/guides/uni-assist-application/","children":["uni-assist application: documents, fees and the right submission route",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/vpd-germany/",{"href":"/guides/vpd-germany/","children":["VPD for Germany: meaning, processing time and university submission",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/technical-university-of-munich-admissions-scholarships/",{"href":"/guides/technical-university-of-munich-admissions-scholarships/","children":["Technical University of Munich: admission, tuition and scholarship planning",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
