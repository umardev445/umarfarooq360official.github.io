23:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Keep the transcript complete even when only one page has grades",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Keep the transcript complete even when only one page has grades"}],[["$","p","uni-assist’s current educational-document guidance asks for complete certificates and accompanying subject/grade records, including relevant supplements and every page. A scan showing just the overall percentage can omit the grading explanation or qualification context needed for an assessment.",{"children":"uni-assist’s current educational-document guidance asks for complete certificates and accompanying subject/grade records, including relevant supplements and every page. A scan showing just the overall percentage can omit the grading explanation or qualification context needed for an assessment."}],["$","p","For a fictional file with a two-page transcript, the first page lists courses and the reverse explains the scale. Retain both in the document set. If a translation is required, keep it associated with the corresponding original rather than replacing the original with an English summary you created yourself.",{"children":"For a fictional file with a two-page transcript, the first page lists courses and the reverse explains the scale. Retain both in the document set. If a translation is required, keep it associated with the corresponding original rather than replacing the original with an English summary you created yourself."}],["$","p","Before submission, compare page count, legibility, institution verification details and document titles with the current country and university instructions. This is a completeness check, not an independent recognition decision. If the required educational history includes earlier qualifications, a recent master’s certificate does not automatically remove those earlier tasks.",{"children":"Before submission, compare page count, legibility, institution verification details and document titles with the current country and university instructions. This is a completeness check, not an independent recognition decision. If the required educational history includes earlier qualifications, a recent master’s certificate does not automatically remove those earlier tasks."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original certificate-completeness check","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original certificate-completeness check"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Document feature",{"scope":"col","children":"Document feature"}],["$","th","Check",{"scope":"col","children":"Check"}],["$","th","Risk if omitted",{"scope":"col","children":"Risk if omitted"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Reverse or second page"}],["$","td","1",{"children":"Included and readable"}],["$","td","2",{"children":"Grading context missing"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Supplement"}],["$","td","1",{"children":"Matches the named qualification"}],["$","td","2",{"children":"Incomplete academic record"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Translation pair"}],["$","td","1",{"children":"Original linked to accepted translation"}],["$","td","2",{"children":"Unclear evidence identity"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L27","$L28","$L29","$L2a","$L2b","$L2c"]}]
