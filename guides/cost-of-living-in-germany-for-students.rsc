1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide research-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/cost-of-living-in-germany-for-students/\",\"name\":\"Cost of living in Germany for students: build your budget\",\"description\":\"Build a Germany student budget for rent, health insurance, food, transport and arrival costs. Distinguish actual expenses from blocked-account proof of funds.\",\"url\":\"https://aspirecompass.org/guides/cost-of-living-in-germany-for-students/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-22\",\"dateModified\":\"2026-10-22\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/expansion-20261022/germany-budget-1280.webp\",\"caption\":\"Tram tracks and buildings on a Berlin street\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Cost of living in Germany for students: build your budget\",\"item\":\"https://aspirecompass.org/guides/cost-of-living-in-germany-for-students/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"Cost of living in Germany for students: build your budget\",\"description\":\"Build a Germany student budget for rent, health insurance, food, transport and arrival costs. Distinguish actual expenses from blocked-account proof of funds.\",\"image\":\"https://aspirecompass.org/images/expansion-20261022/germany-budget-1280.webp\",\"datePublished\":\"2026-10-22\",\"dateModified\":\"2026-10-22\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/cost-of-living-in-germany-for-students/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is the blocked-account minimum my exact monthly budget?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. It is a proof-of-resources requirement under the applicable rules. Your actual expenses depend on housing, insurance, university charges and circumstances.\"}},{\"@type\":\"Question\",\"name\":\"Should I add the deposit to a full year of living costs?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Do not count the same money twice. The deposit funds living expenses; separately include any provider fees and additional unfunded costs.\"}},{\"@type\":\"Question\",\"name\":\"Are the example euro amounts national averages?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. They are explicitly illustrative inputs demonstrating the budgeting method. Replace them with current quotes.\"}}]}"}}]],"$L18",false,"$L19","$L1a"]}]
