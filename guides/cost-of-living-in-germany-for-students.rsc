19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/expansion-20261022/germany-budget-1280.webp","srcSet":"/images/expansion-20261022/germany-budget-640.webp 640w, /images/expansion-20261022/germany-budget-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Tram tracks and buildings on a Berlin street","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Destination or study photograph; not a photograph of the named university or scholarship."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Germany student living costs depend strongly on housing, city and personal circumstances. Add recurring expenses, semester charges and arrival costs; then compare them with confirmed funding without counting blocked money twice."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Get a housing quote, the current semester contribution and a health-insurance quote before choosing your monthly budget."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Start with a budget you can audit",{"href":"#section-1","children":"Start with a budget you can audit"}],["$","a","Recurring monthly categories",{"href":"#section-2","children":"Recurring monthly categories"}],["$","a","A worked budget, with assumptions visible",{"href":"#section-3","children":"A worked budget, with assumptions visible"}],["$","a","Tuition and semester contributions are different",{"href":"#section-4","children":"Tuition and semester contributions are different"}],["$","a","Blocked account: proof of resources, not an extra expense",{"href":"#section-5","children":"Blocked account: proof of resources, not an extra expense"}],["$","a","Compare cities using the same applicant profile",{"href":"#section-6","children":"Compare cities using the same applicant profile"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Start with a budget you can audit",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Start with a budget you can audit"}],[["$","p","Write down the city, course duration, household size and accommodation type. These explain more than a single national average. A room in a shared flat, a student residence and a private apartment can produce very different totals.",{"children":"Write down the city, course duration, household size and accommodation type. These explain more than a single national average. A room in a shared flat, a student residence and a private apartment can produce very different totals."}],["$","p","Use dated quotes for housing and insurance and label estimates clearly. Keep the first month separate from a normal month because deposits, travel and setup costs can distort the comparison. Review the budget when your housing or enrolment situation changes.",{"children":"Use dated quotes for housing and insurance and label estimates clearly. Keep the first month separate from a normal month because deposits, travel and setup costs can distort the comparison. Review the budget when your housing or enrolment situation changes."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1b","$L1c","$L1d","$L1e","$L1f"]}],false,"$L20","$L21"]}],"$L22"]}]
