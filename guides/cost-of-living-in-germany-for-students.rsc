1b:["$","section","1-Recurring monthly categories",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Recurring monthly categories"}],[["$","p","Rent is only one part of the monthly total. Check whether the quoted amount includes heating, electricity, internet and other charges. Ask about the deposit and contract duration before treating the advertised monthly figure as the complete housing cost.",{"children":"Rent is only one part of the monthly total. Check whether the quoted amount includes heating, electricity, internet and other charges. Ask about the deposit and contract duration before treating the advertised monthly figure as the complete housing cost."}],["$","p","Insurance costs depend on the applicable status and cover. Transport may be affected by a semester ticket or local arrangements, so check what your university contribution actually includes before adding a separate full transport pass.",{"children":"Insurance costs depend on the applicable status and cover. Transport may be affected by a semester ticket or local arrangements, so check what your university contribution actually includes before adding a separate full transport pass."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Use your own quotes: no national price is implied","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Use your own quotes: no national price is implied"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Category",{"scope":"col","children":"Category"}],["$","th","What to include",{"scope":"col","children":"What to include"}],["$","th","Evidence",{"scope":"col","children":"Evidence"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Housing"}],["$","td","1",{"children":"Rent plus excluded utilities"}],["$","td","2",{"children":"Contract or current residence offer"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Insurance"}],["$","td","1",{"children":"Required cover for your status"}],["$","td","2",{"children":"Provider and university guidance"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Food and household"}],["$","td","1",{"children":"Groceries and routine essentials"}],["$","td","2",{"children":"Personal weekly spending estimate"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Transport"}],["$","td","1",{"children":"Costs not included in the semester contribution"}],["$","td","2",{"children":"University and local transport information"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Communication and study"}],["$","td","1",{"children":"Phone, internet and course materials"}],["$","td","2",{"children":"Plan and programme requirements"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1c:["$","section","2-A worked budget, with assumptions visible",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"A worked budget, with assumptions visible"}],[["$","p","The following figures are an illustrative planning scenario, not a claim about average prices or a government requirement. Replace them with your own quotes before deciding whether a destination is affordable.",{"children":"The following figures are an illustrative planning scenario, not a claim about average prices or a government requirement. Replace them with your own quotes before deciding whether a destination is affordable."}],["$","p","Add confirmed funding only once. A €3,000 award would leave €11,400 in this example if it can be used for these expenses. If it arrives later, calculate the cash needed before that payment separately.",{"children":"Add confirmed funding only once. A €3,000 award would leave €11,400 in this example if it can be used for these expenses. If it arrives later, calculate the cash needed before that payment separately."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"Example monthly budget: housing €520 + insurance €145 + food/household €250 + transport €35 + phone/study/personal €100 = €1,050. Twelve months cost €12,600. If semester charges total €600 and one-off arrival costs are €1,200, the first-year spending plan is €14,400. These are invented example inputs for demonstrating the method, not published fee estimates."}]]}],"$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","3-Tuition and semester contributions are different",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Tuition and semester contributions are different"}],[["$","p","Check the exact institution, degree, state and applicant category for tuition. “Public university” does not establish that every programme and applicant pays zero tuition. A semester contribution is another charge and may apply even when tuition is not charged.",{"children":"Check the exact institution, degree, state and applicant category for tuition. “Public university” does not establish that every programme and applicant pays zero tuition. A semester contribution is another charge and may apply even when tuition is not charged."}],["$","p","Record which payments are due before enrolment and whether your award covers them. A scholarship described as living support should not be assumed to pay a tuition bill. Keep the university fee schedule attached to your budget.",{"children":"Record which payments are due before enrolment and whether your award covers them. A scholarship described as living support should not be assumed to pay a tuition bill. Keep the university fee schedule attached to your budget."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Tuition and semester contributions are different","children":[["$","$L4","/countries/germany/",{"href":"/countries/germany/","children":["Germany study and funding hub",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1e:["$","section","4-Blocked account: proof of resources, not an extra expense",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Blocked account: proof of resources, not an extra expense"}],[["$","p","DAAD’s finance page gives a proof-of-funds figure explicitly dated 1 January 2025 and advises checking the competent diplomatic mission or official portal. Do not present an old figure as a confirmed requirement for a later intake.",{"children":"DAAD’s finance page gives a proof-of-funds figure explicitly dated 1 January 2025 and advises checking the competent diplomatic mission or official portal. Do not present an old figure as a confirmed requirement for a later intake."}],["$","p","Blocked funds are money set aside for living costs. If you budget living expenses and then add the entire deposit as a second expense, you overstate spending. Provider charges can be additional costs; the protected deposit itself is a funding arrangement. Verify the required amount and permitted evidence for your own visa situation.",{"children":"Blocked funds are money set aside for living costs. If you budget living expenses and then add the entire deposit as a second expense, you overstate spending. Provider charges can be additional costs; the protected deposit itself is a funding arrangement. Verify the required amount and permitted evidence for your own visa situation."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Blocked account: proof of resources, not an extra expense","children":[["$","$L4","/tools/germany-blocked-account-calculator/",{"href":"/tools/germany-blocked-account-calculator/","children":["Blocked account and first-year funding calculator",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/germany-student-visa-requirements/",{"href":"/guides/germany-student-visa-requirements/","children":["Germany visa requirements",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1f:["$","section","5-Compare cities using the same applicant profile",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Compare cities using the same applicant profile"}],[["$","p","Use the same course length, room type, insurance status and personal allowance when comparing cities. Collect two or three actual housing options per city instead of labelling one universally cheapest. A lower rent far from campus can bring higher travel costs or unsuitable contract conditions.",{"children":"Use the same course length, room type, insurance status and personal allowance when comparing cities. Collect two or three actual housing options per city instead of labelling one universally cheapest. A lower rent far from campus can bring higher travel costs or unsuitable contract conditions."}],["$","p","Before accepting an offer, test a higher-rent scenario and a delayed-funding scenario. If your plan fails in both, find a documented cost reduction or additional funding rather than assuming part-time work will immediately close the gap.",{"children":"Before accepting an offer, test a higher-rent scenario and a delayed-funding scenario. If your plan fails in both, find a documented cost reduction or additional funding rather than assuming part-time work will immediately close the gap."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L23",null,{"id":"guides/cost-of-living-in-germany-for-students:section-6","title":"Check your progress","items":["Housing and utilities confirmed","Tuition and semester charges separated","Insurance matched to student status","Arrival cash calculated","Blocked deposit not counted twice","Visa proof-of-funds requirement checked at the competent authority"]}],"$undefined","$undefined"]}]
