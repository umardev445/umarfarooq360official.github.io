18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/expansion-20261022/germany-testas-1280.webp","srcSet":"/images/expansion-20261022/germany-testas-640.webp 640w, /images/expansion-20261022/germany-testas-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Open reading floors in Stuttgart City Library","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Destination or study photograph; not a photograph of the named university or scholarship."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"TestAS assesses academic aptitude. Universities decide whether they require or consider it and how results are used. It does not automatically replace language evidence, a qualification assessment or Studienkolleg."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Find your target university’s current TestAS policy, including format and module, then work backwards from its document deadline."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Check whether your university requires or considers TestAS",{"href":"#section-1","children":"Check whether your university requires or considers TestAS"}],["$","a","Digital and paper-based formats",{"href":"#section-2","children":"Digital and paper-based formats"}],["$","a","Choose the date using result availability",{"href":"#section-3","children":"Choose the date using result availability"}],["$","a","Registration, fees and identity checks",{"href":"#section-4","children":"Registration, fees and identity checks"}],["$","a","A practical preparation plan",{"href":"#section-5","children":"A practical preparation plan"}],["$","a","Use the certificate in your application",{"href":"#section-6","children":"Use the certificate in your application"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Check whether your university requires or considers TestAS",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Check whether your university requires or considers TestAS"}],[["$","p","Look for the test rule in the actual admission instructions, not only on a preparation website. Record whether TestAS is compulsory, optional, used for selection or not requested. Ask which subject module and test language apply if the instructions are unclear.",{"children":"Look for the test rule in the actual admission instructions, not only on a preparation website. Record whether TestAS is compulsory, optional, used for selection or not requested. Ask which subject module and test language apply if the instructions are unclear."}],["$","p","Keep aptitude testing separate from recognition of your school certificate and proof of teaching-language ability. A strong TestAS result does not by itself cure a missing entry qualification or an unmet language condition.",{"children":"Keep aptitude testing separate from recognition of your school certificate and proof of teaching-language ability. A strong TestAS result does not by itself cure a missing entry qualification or an unmet language condition."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$L1a"]}],"$L1b","$L1c","$L1d","$L1e","$L1f"]}],false,"$L20","$L21"]}],"$L22"]}]
