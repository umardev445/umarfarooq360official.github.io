1b:["$","section","1-Digital and paper-based formats",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Digital and paper-based formats"}],[["$","p","The official provider offers digital and paper-based TestAS. Both assess relevant abilities, but their structure, available modules and result interpretation should be checked in the instructions for that format. Do not assume scores or preparation materials transfer unchanged.",{"children":"The official provider offers digital and paper-based TestAS. Both assess relevant abilities, but their structure, available modules and result interpretation should be checked in the instructions for that format. Do not assume scores or preparation materials transfer unchanged."}],["$","p","Before registering, confirm that the receiving university accepts your selected format and module. Then choose the official preparation resources for that version. A generic course may combine task types that do not match the exam you booked.",{"children":"Before registering, confirm that the receiving university accepts your selected format and module. Then choose the official preparation resources for that version. A generic course may combine task types that do not match the exam you booked."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Compare the format before booking","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Compare the format before booking"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Decision",{"scope":"col","children":"Decision"}],["$","th","Digital TestAS",{"scope":"col","children":"Digital TestAS"}],["$","th","Paper-based TestAS",{"scope":"col","children":"Paper-based TestAS"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Preparation"}],["$","td","1",{"children":"Use digital-format official task guidance"}],["$","td","2",{"children":"Use paper-format official sample tasks"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Acceptance"}],["$","td","1",{"children":"Confirm with the receiving university"}],["$","td","2",{"children":"Confirm with the receiving university"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Results planning"}],["$","td","1",{"children":"Provider states about three weeks for evaluation"}],["$","td","2",{"children":"Provider states about four weeks for evaluation"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Registration"}],["$","td","1",{"children":"Use the official participant route"}],["$","td","2",{"children":"Use the official participant route"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.testas.de/en/participants/my-testas/testas-dates-and-registration",{"children":["",["$","a",null,{"href":"https://www.testas.de/en/participants/my-testas/testas-dates-and-registration","target":"_blank","rel":"noreferrer","children":"Official test dates and result timing"}]]}]]]}],"$undefined"]}]
1c:["$","section","2-Choose the date using result availability",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Choose the date using result availability"}],[["$","p","The provider advises allowing about three weeks for digital results and four weeks for paper-based results. Check the actual result date in the current schedule because the university may need the certificate before its application deadline.",{"children":"The provider advises allowing about three weeks for digital results and four weeks for paper-based results. Check the actual result date in the current schedule because the university may need the certificate before its application deadline."}],["$","p","Use a buffer for registration, travel and unexpected rescheduling. An exam taken before the deadline is not enough if its result arrives afterwards and the university requires it with the application. Do not rely on an early unofficial score being available.",{"children":"Use a buffer for registration, travel and unexpected rescheduling. An exam taken before the deadline is not enough if its result arrives afterwards and the university requires it with the application. Do not rely on an early unofficial score being available."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","3-Registration, fees and identity checks",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Registration, fees and identity checks"}],[["$","p","Reach the participant portal from the official TestAS website. Select the correct date, centre, language and module, and check the current payable fee before confirming. Charges and payment options should be read in the live registration process rather than copied from an older intake.",{"children":"Reach the participant portal from the official TestAS website. Select the correct date, centre, language and module, and check the current payable fee before confirming. Charges and payment options should be read in the live registration process rather than copied from an older intake."}],["$","p","The provider’s terms require registration payment and a passport photo by the stated deadline for identity verification. Review the exact identity-document and test-day instructions. Keep the confirmation and check that the name matches your identification.",{"children":"The provider’s terms require registration payment and a passport photo by the stated deadline for identity verification. Review the exact identity-document and test-day instructions. Keep the confirmation and check that the name matches your identification."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L23",null,{"id":"guides/testas-exam-germany:section-4","title":"Check your progress","items":["University test policy saved","Correct format, language and module selected","Result release fits the application deadline","Registration and payment confirmed","Required photo and identity instructions completed"]}],"$undefined","$undefined"]}]
1e:["$","section","4-A practical preparation plan",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"A practical preparation plan"}],[["$","p","Start with an official sample under untimed conditions to learn the task format. Then practise in timed sets and classify mistakes: misunderstanding the prompt, choosing an inefficient method or running out of time. Adjust practice to the pattern rather than repeating the same easy questions.",{"children":"Start with an official sample under untimed conditions to learn the task format. Then practise in timed sets and classify mistakes: misunderstanding the prompt, choosing an inefficient method or running out of time. Adjust practice to the pattern rather than repeating the same easy questions."}],["$","p","Schedule full attempts only after you understand the format. Keep a short error log and review it between sessions. This is an editorial study plan, not a promise of a particular score or an official preparation timetable.",{"children":"Schedule full attempts only after you understand the format. Keep a short error log and review it between sessions. This is an editorial study plan, not a promise of a particular score or an official preparation timetable."}]],["$","ol",null,{"className":"process-steps","aria-label":"A practical preparation plan","children":[["$","li","Read the format and module instructions",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Read the format and module instructions"}]]}],["$","li","Try official samples and understand the solutions",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Try official samples and understand the solutions"}]]}],["$","li","Practise the weakest task type in short timed sets",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Practise the weakest task type in short timed sets"}]]}],["$","li","Review errors and adjust your method",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Review errors and adjust your method"}]]}],["$","li","Complete a timed rehearsal using permitted conditions",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Complete a timed rehearsal using permitted conditions"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","5-Use the certificate in your application",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Use the certificate in your application"}],[["$","p","Follow the university’s instruction for uploading or verifying results. Keep the candidate details and report together, and check that you attached the certificate for the correct examination sitting.",{"children":"Follow the university’s instruction for uploading or verifying results. Keep the candidate details and report together, and check that you attached the certificate for the correct examination sitting."}],["$","p","If the result is unavailable or lower than hoped, read the programme’s published alternatives or future-intake policy. Do not invent a universal passing score: selection methods and required results belong to the receiving institution.",{"children":"If the result is unavailable or lower than hoped, read the programme’s published alternatives or future-intake policy. Do not invent a universal passing score: selection methods and required results belong to the receiving institution."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
