1f:["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Why this course or award?"}],["$","td","1",{"children":"A specific learning gap and relevant course feature"}],["$","td","2",{"children":"Why not a different programme?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Leadership or teamwork"}],["$","td","1",{"children":"One situation, your own action and an outcome"}],["$","td","2",{"children":"What did another person contribute?"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Challenge or setback"}],["$","td","1",{"children":"A real difficulty and what changed afterwards"}],["$","td","2",{"children":"What would you do differently?"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Future contribution"}],["$","td","1",{"children":"A realistic plan with intended beneficiaries"}],["$","td","2",{"children":"What is your first practical step?"}]],"$undefined"]}]]}]
20:["$","section","1-Worked answer: why this programme?",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Worked answer: why this programme?"}],[["$","p","A useful response connects preparation, a gap and an actual programme resource. The following example is fictional and does not describe a real course. Replace every detail with your own evidence and verified information.",{"children":"A useful response connects preparation, a gap and an actual programme resource. The following example is fictional and does not describe a real course. Replace every detail with your own evidence and verified information."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"Fictional answer with an explicit learning gap"}],[["$","p","0",{"children":"My final-year project showed me that I can organise field data, but I need a stronger method for interpreting uncertainty. I am looking for training that connects statistical analysis with environmental decisions. In a real programme application, I would identify the specific module or research resource that addresses this need. I would then explain how it would help me improve the small evaluation project I have already attempted, rather than claiming the university's reputation alone is my reason."}]],["$","p",null,{"className":"sample-card__note","children":"The answer names evidence and a gap. A real answer must supply the verified programme detail that this teaching example deliberately leaves unspecified."}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","2-Worked answer: a challenge and your contribution",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Worked answer: a challenge and your contribution"}],[["$","p","Avoid presenting a team result as a solo achievement. Describe your role and what you learned about the problem. Numbers help only when they are accurate and explain scale or impact.",{"children":"Avoid presenting a team result as a solo achievement. Describe your role and what you learned about the problem. Numbers help only when they are accurate and explain scale or impact."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"Fictional teamwork example"}],[["$","p","0",{"children":"Our student team initially collected observations in different formats, which made comparison difficult. I was responsible for checking the dataset. I proposed a shared recording sheet, tested it on a small sample and asked teammates to identify fields they found confusing. The final dataset was easier to review, but some early observations could not be recovered. I learned to agree the collection method before collecting more data and to report what the project could not establish."}]],["$","p",null,{"className":"sample-card__note","children":"The result is proportionate, acknowledges team involvement and includes a limitation. It is not a script to memorise."}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","3-Prepare for difficult follow-up questions",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Prepare for difficult follow-up questions"}],[["$","p","If asked why an alternative would not work, compare its limitations honestly instead of dismissing it. If a result was smaller than expected, explain the decision and what changed. If you do not know a fact, state that limit and describe how you would verify it.",{"children":"If asked why an alternative would not work, compare its limitations honestly instead of dismissing it. If a result was smaller than expected, explain the decision and what changed. If you do not know a fact, state that limit and describe how you would verify it."}],["$","p","For a question about funding or future contribution, distinguish your intention from a guaranteed outcome. A plan can be credible while acknowledging uncertain partners, employment or resources. Do not promise results beyond your control.",{"children":"For a question about funding or future contribution, distinguish your intention from a guaranteed outcome. A plan can be credible while acknowledging uncertain partners, employment or resources. Do not promise results beyond your control."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Replace defensive answers with clear reasoning","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Replace defensive answers with clear reasoning"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Situation",{"scope":"col","children":"Situation"}],["$","th","Better response approach",{"scope":"col","children":"Better response approach"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"You do not know a fact"}],["$","td","1",{"children":"State what you know and how you would verify the rest"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"A claim is challenged"}],["$","td","1",{"children":"Clarify your personal contribution and evidence"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"A project failed"}],["$","td","1",{"children":"Explain the decision, limitation and lesson"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"A plan depends on others"}],["$","td","1",{"children":"Name dependencies and a viable alternative"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","4-Run a useful mock interview",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Run a useful mock interview"}],[["$","p","Ask the reviewer to interrupt with follow-up questions. Record a practice session if everyone agrees, then assess whether you answered the question, gave evidence, explained your role and stopped at a sensible point. Do not score yourself by accent or by how sophisticated the vocabulary sounds.",{"children":"Ask the reviewer to interrupt with follow-up questions. Record a practice session if everyone agrees, then assess whether you answered the question, gave evidence, explained your role and stopped at a sensible point. Do not score yourself by accent or by how sophisticated the vocabulary sounds."}],["$","p","Select two changes for the next practice rather than rewriting every answer at once. One might be a shorter opening; another might be a clearer result. Compare the next recording to those specific goals.",{"children":"Select two changes for the next practice rather than rewriting every answer at once. One might be a shorter opening; another might be a clearer result. Compare the next recording to those specific goals."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2a",null,{"id":"guides/scholarship-interview:section-5","title":"Check your progress","items":["Question answered directly","Own contribution clear","Example supported by real facts","Programme detail verified","Limitations acknowledged","Answer left room for follow-up"]}],"$undefined","$undefined"]}]
24:["$","section","5-Start with your submitted application",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Start with your submitted application"}],[["$","p","Read the exact version you sent. Highlight projects, leadership claims, goals and programme details. For each, note what happened, what you personally did, what evidence supports the result and what you would change. The panel can ask about any claim, including a sentence you wrote months earlier.",{"children":"Read the exact version you sent. Highlight projects, leadership claims, goals and programme details. For each, note what happened, what you personally did, what evidence supports the result and what you would change. The panel can ask about any claim, including a sentence you wrote months earlier."}],["$","p","Do not prepare one perfect speech for every possible question. Prepare an evidence bank with different situations: a collaboration, a difficulty, a decision, a mistake and a learning experience. Reusing one story repeatedly can hide the range of your preparation.",{"children":"Do not prepare one perfect speech for every possible question. Prepare an evidence bank with different situations: a collaboration, a difficulty, a decision, a mistake and a learning experience. Reusing one story repeatedly can hide the range of your preparation."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Interview evidence bank","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Interview evidence bank"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Question area",{"scope":"col","children":"Question area"}],["$","th","Example to prepare",{"scope":"col","children":"Example to prepare"}],["$","th","Likely follow-up",{"scope":"col","children":"Likely follow-up"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Why this programme?"}],["$","td","1",{"children":"A learning gap and verified course resource"}],["$","td","2",{"children":"Why not an alternative?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Leadership"}],["$","td","1",{"children":"A decision with your own responsibility"}],["$","td","2",{"children":"What did others contribute?"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Challenge"}],["$","td","1",{"children":"A setback and change of approach"}],["$","td","2",{"children":"What would you do differently?"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Future plan"}],["$","td","1",{"children":"A realistic first step"}],["$","td","2",{"children":"What could prevent it?"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","6-Build an answer that leaves room for conversation",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Build an answer that leaves room for conversation"}],[["$","p","For an experience question, state the situation briefly, describe your responsibility, explain the action and result, then reflect. For an opinion question, state a position, give a reason and example, and acknowledge a relevant limitation.",{"children":"For an experience question, state the situation briefly, describe your responsibility, explain the action and result, then reflect. For an opinion question, state a position, give a reason and example, and acknowledge a relevant limitation."}],["$","p","Practising a 60–90 second first answer can help control length, but it is not a universal interview limit. Follow the question and panel's instructions. A concise answer with a clear stopping point makes follow-up easier.",{"children":"Practising a 60–90 second first answer can help control length, but it is not a universal interview limit. Follow the question and panel's instructions. A concise answer with a clear stopping point makes follow-up easier."}]],["$","ol",null,{"className":"process-steps","aria-label":"Build an answer that leaves room for conversation","children":[["$","li","Answer the actual question",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Answer the actual question"}]]}],["$","li","Set only the necessary context",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Set only the necessary context"}]]}],["$","li","Explain your own action",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Explain your own action"}]]}],["$","li","Give the result and its limits",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Give the result and its limits"}]]}],["$","li","State what you learned",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"State what you learned"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","7-Interview-day preparation",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Interview-day preparation"}],[["$","p","Confirm platform or venue, identification instructions, local time conversion and permitted materials. For online interviews, test audio, camera, connection and a practical backup. For in-person interviews, plan travel and arrival instructions.",{"children":"Confirm platform or venue, identification instructions, local time conversion and permitted materials. For online interviews, test audio, camera, connection and a practical backup. For in-person interviews, plan travel and arrival instructions."}],["$","p","Use notes only when permitted and never rely on unauthorised live assistance. If a technical problem occurs, explain it briefly and follow the panel's instructions. End with a thoughtful question about the programme when invited, not a question answered prominently in the published guidance.",{"children":"Use notes only when permitted and never rely on unauthorised live assistance. If a technical problem occurs, explain it briefly and follow the panel's instructions. End with a thoughtful question about the programme when invited, not a question answered prominently in the published guidance."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Interview-day preparation","children":[["$","$L4","/guides/scholarship-application/",{"href":"/guides/scholarship-application/","children":["Review your application evidence",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/motivation-letter/",{"href":"/guides/motivation-letter/","children":["Improve the motivation argument",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/recommendation-letter/",{"href":"/guides/recommendation-letter/","children":["Check referee planning",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
27:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://europass.europa.eu/en/create-europass-cover-letter",{"href":"https://europass.europa.eu/en/create-europass-cover-letter","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Europass: preparing a clear, tailored cover letter"}],["$","span",null,{"children":"General document-organisation guidance; the chosen application prompt and rules take priority."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
28:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Should I memorise answers?",{"children":[["$","summary",null,{"children":["Should I memorise answers?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Remember facts and practise flexible structures. A memorised script can fail when the panel asks a different question or a follow-up."}]]}],["$","details","Can study projects count as leadership evidence?",{"children":[["$","summary",null,{"children":["Can study projects count as leadership evidence?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes when they demonstrate the behaviour asked about. Explain responsibility, action and results honestly; do not inflate the role."}]]}],["$","details","What if I do not know an answer?",{"children":[["$","summary",null,{"children":["What if I do not know an answer?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Clarify if needed, state your limits and reason from what you know. Avoid inventing facts."}]]}]]}]]}]
