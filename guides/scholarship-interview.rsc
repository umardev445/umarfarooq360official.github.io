1c:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/application-writing-1280.webp","srcSet":"/images/application-writing-640.webp 640w, /images/application-writing-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"A student reviewing notes and preparing an application at a desk","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Prepare your own evidence, then adapt it to the application instructions."}]]}],false,["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Prepare to explain your application, programme choice, relevant experience and proposed contribution. Strong answers give a specific example, acknowledge limits and respond to the question rather than reciting a memorised speech."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Read the worked answers, then practise follow-up questions against your submitted application with a timer and a partner."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Use question families to practise follow-ups",{"href":"#section-1","children":"Use question families to practise follow-ups"}],["$","a","Worked answer: why this programme?",{"href":"#section-2","children":"Worked answer: why this programme?"}],["$","a","Worked answer: a challenge and your contribution",{"href":"#section-3","children":"Worked answer: a challenge and your contribution"}],["$","a","Prepare for difficult follow-up questions",{"href":"#section-4","children":"Prepare for difficult follow-up questions"}],["$","a","Run a useful mock interview",{"href":"#section-5","children":"Run a useful mock interview"}],["$","a","Start with your submitted application",{"href":"#section-6","children":"Start with your submitted application"}],["$","a","Build an answer that leaves room for conversation",{"href":"#section-7","children":"Build an answer that leaves room for conversation"}],["$","a","Interview-day preparation",{"href":"#section-8","children":"Interview-day preparation"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Use question families to practise follow-ups",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Use question families to practise follow-ups"}],[["$","p","These are practice prompts, not a leaked or guaranteed interview script. Reviewers can ask about any claim in your application, so check your dates, responsibilities and programme choices before a mock interview.",{"children":"These are practice prompts, not a leaked or guaranteed interview script. Reviewers can ask about any claim in your application, so check your dates, responsibilities and programme choices before a mock interview."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Use question families to practise follow-ups","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Use question families to practise follow-ups"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Question family",{"scope":"col","children":"Question family"}],["$","th","Evidence to prepare",{"scope":"col","children":"Evidence to prepare"}],"$L1e"],"$undefined"]}]}],"$L1f"]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}],false,"$L27","$L28"]}],"$L29"]}]
