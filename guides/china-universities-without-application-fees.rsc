26:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Does a free CSC application mean every university is free?",{"children":[["$","summary",null,{"children":["Does a free CSC application mean every university is free?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. A university can have a separate academic application charge. Read its programme and fee instructions before submitting."}]]}],["$","details","Which 2027 routes are documented here?",{"children":[["$","summary",null,{"children":["Which 2027 routes are documented here?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The selected table includes SUES degree admission and Duke Kunshan international undergraduate admission, plus HUST’s named Type A channel. Each has different eligibility and timing; use the linked official source."}]]}],["$","details","Does Nankai’s previous waiver confirm a free 2027 application?",{"children":[["$","summary",null,{"children":["Does Nankai’s previous waiver confirm a free 2027 application?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The checked 2026 notice is historical and makes the waiver conditional on a CGS award. Recheck a new notice for the next intake."}]]}],["$","details","Can I assume there is no fee if the page does not mention one?",{"children":[["$","summary",null,{"children":["Can I assume there is no fee if the page does not mention one?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. An absent amount is unconfirmed, not zero. Ask the institution and retain the response."}]]}],["$","details","Does no application fee mean tuition is free?",{"children":[["$","summary",null,{"children":["Does no application fee mean tuition is free?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Application, tuition, housing and other charges are separate. A veri