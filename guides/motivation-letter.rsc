1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/motivation-letter/\",\"name\":\"How to write a scholarship motivation letter\",\"description\":\"Write a scholarship motivation letter with a clear structure, annotated example and editing checklist. Connect your experience, programme choice and future plans.\",\"url\":\"https://aspirecompass.org/guides/motivation-letter/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-08-31\",\"dateModified\":\"2026-10-21\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/application-writing-1280.webp\",\"caption\":\"A student reviewing notes and preparing an application at a desk\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"How to write a scholarship motivation letter\",\"item\":\"https://aspirecompass.org/guides/motivation-letter/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"How to write a scholarship motivation letter\",\"description\":\"Write a scholarship motivation letter with a clear structure, annotated example and editing checklist. Connect your experience, programme choice and future plans.\",\"image\":\"https://aspirecompass.org/images/application-writing-1280.webp\",\"datePublished\":\"2026-08-31\",\"dateModified\":\"2026-10-21\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/motivation-letter/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How long should a scholarship motivation letter be?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Follow the programme's word, character or page limit. If none is published, seek clarification when possible and use enough space to answer the purpose without repetition.\"}},{\"@type\":\"Question\",\"name\":\"Can I reuse a letter for another scholarship?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Reuse your verified evidence bank, then rewrite the programme fit, award priorities and future contribution. Recheck the new prompt and assistance rules.\"}},{\"@type\":\"Question\",\"name\":\"Is this example safe to submit?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. It is a fictional teaching example. An application must use your own evidence and comply with its authorship and assistance requirements.\"}}]}"}}]],["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--guide inner-hero--visual","children":"$L17"}],false,"$L18","$L19"]}]
