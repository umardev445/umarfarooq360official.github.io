18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/application-writing-1280.webp","srcSet":"/images/application-writing-640.webp 640w, /images/application-writing-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"A student reviewing notes and preparing an application at a desk","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Prepare your own evidence, then adapt it to the application instructions."}]]}],false,["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"A scholarship motivation letter explains why this programme and funding fit your next step, using evidence from your experience. Follow the exact prompt and word limit; use the sample to learn the reasoning, not to copy someone else’s identity."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Use the four-paragraph structure, then read the annotated teaching example. Gather one real example for each claim before drafting."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Build a four-paragraph argument",{"href":"#section-1","children":"Build a four-paragraph argument"}],["$","a","An illustrative letter: notice how the parts connect",{"href":"#section-2","children":"An illustrative letter: notice how the parts connect"}],["$","a","Why the example is stronger than generic praise",{"href":"#section-3","children":"Why the example is stronger than generic praise"}],["$","a","Read the prompt before choosing a template",{"href":"#section-4","children":"Read the prompt before choosing a template"}],["$","a","Explain funding without making it your only argument",{"href":"#section-5","children":"Explain funding without making it your only argument"}],["$","a","Revise content, credibility and format separately",{"href":"#section-6","children":"Revise content, credibility and format separately"}],["$","a","Keep the rest of the application consistent",{"href":"#section-7","children":"Keep the rest of the application consistent"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Build a four-paragraph argument",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Build a four-paragraph argument"}],[["$","p","Give each paragraph a different job. The opening identifies the direction you want to pursue. The second supplies evidence of preparation. The third connects a learning gap to the actual programme. The final paragraph explains a realistic next step and why funding matters.",{"children":"Give each paragraph a different job. The opening identifies the direction you want to pursue. The second supplies evidence of preparation. The third connects a learning gap to the actual programme. The final paragraph explains a realistic next step and why funding matters."}],["$","p","This is an editorial planning model, not a required format for every award. A form with separate short questions should be answered as separate questions. Do not force a four-paragraph letter into a portal that asks for different evidence.",{"children":"This is an editorial planning model, not a required format for every award. A form with separate short questions should be answered as separate questions. Do not force a four-paragraph letter into a portal that asks for different evidence."}]],"$undefined","$L1a","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}],false,"$L21","$L22"]}],"$L23"]}]
