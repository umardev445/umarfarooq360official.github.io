21:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Do all master’s scholarships require HAT?",{"children":[["$","summary",null,{"children":["Do all master’s scholarships require HAT?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. HAT applies to the HEC calls that require it; direct university and consortium routes can have different tests."}]]}],["$","details","Is Commonwealth Shared the same deadline as Commonwealth Master’s?",{"children":[["$","summary",null,{"children":["Is Commonwealth Shared the same deadline as Commonwealth Master’s?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. They have separate application processes and dates; the reviewed Shared round opens after the central Master’s deadline."}]]}],["$","details","Can a fresh graduate apply for every master’s award?",{"children":[["$","summary",null,{"children":["Can a fresh graduate apply for every master’s award?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Some routes require experience or other conditions; check each actual scheme."}]]}],["$","details","Does a university offer automatically include a scholarship?",{"children":[["$","summary",null,{"children":["Does a university offer automatically include a scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Only when its written terms expressly say so. Admission and funding decisions can be separate."}]]}]]}]]}]
