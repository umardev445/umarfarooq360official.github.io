1f:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Fresh graduate or experienced applicant?",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Fresh graduate or experienced applicant?"}],[["$","p","Begin with each scheme’s experience definition. Some university and joint-programme master’s routes accept eligible recent graduates. Others require work experience under specific timing and calculation rules. Do not impose one two-year rule on all postgraduate funding.",{"children":"Begin with each scheme’s experience definition. Some university and joint-programme master’s routes accept eligible recent graduates. Others require work experience under specific timing and calculation rules. Do not impose one two-year rule on all postgraduate funding."}],["$","p","A fresh graduate should first check course prerequisites, graduation evidence, academic references and the actual language/test policy. An experienced applicant should also document the roles, dates and achievements the selected scheme requests. The correct route is the one whose published criteria the applicant actually meets.",{"children":"A fresh graduate should first check course prerequisites, graduation evidence, academic references and the actual language/test policy. An experienced applicant should also document the roles, dates and achievements the selected scheme requests. The correct route is the one whose published criteria the applicant actually meets."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","2-HEC nomination, direct university and consortium applications",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"HEC nomination, direct university and consortium applications"}],[["$","p","An HEC foreign-funded call can add a national application, test or nomination step alongside the partner’s application. Direct university funding may instead be assessed through a course application or a separate scholarship form. Erasmus Mundus is managed through the individual joint programme.",{"children":"An HEC foreign-funded call can add a national application, test or nomination step alongside the partner’s application. Direct university funding may instead be assessed through a course application or a separate scholarship form. Erasmus Mundus is managed through the individual joint programme."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Keep each submission visible","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Keep each submission visible"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route model",{"scope":"col","children":"Route model"}],["$","th","What to record",{"scope":"col","children":"What to record"}],["$","th","Common mistake",{"scope":"col","children":"Common mistake"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"HEC / partner nomination"}],["$","td","1",{"children":"Both owner and HEC instructions, tests and dates"}],["$","td","2",{"children":"Submitting only one required application"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Direct university"}],["$","td","1",{"children":"Course application and any separate award form"}],["$","td","2",{"children":"Assuming admission automatically guarantees funding"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Joint programme / consortium"}],["$","td","1",{"children":"The course’s admission, scholarship and mobility rules"}],"$L23"],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$und