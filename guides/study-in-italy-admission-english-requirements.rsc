1a:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"There is no single Italy IELTS score or national MOI waiver. Check the university, degree level, intake and accepted evidence. The current comparison below separates Padua, Polimi and Bologna."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Find your route in the table. Open the university's current certificate and exemption rules before paying for a test."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","/guides/italy-university-application-deadlines/",{"href":"/guides/italy-university-application-deadlines/","children":["Italy deadline guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/ielts-band-calculator/",{"href":"/tools/ielts-band-calculator/","children":["IELTS band calculator",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","IELTS, PTE and TOEFL: selected current requirements",{"href":"#section-1","children":"IELTS, PTE and TOEFL: selected current requirements"}],["$","a","Padua's new exemption list: do not reuse old MOI advice",{"href":"#section-2","children":"Padua's new exemption list: do not reuse old MOI advice"}],["$","a","Bachelor's and master's academ