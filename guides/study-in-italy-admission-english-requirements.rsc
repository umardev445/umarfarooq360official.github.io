1e:["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"Question format: “I am applying to [programme] for [intake]. My qualification was awarded in [country], and my proposed English evidence is [certificate/exemption] dated [date]. Is it accepted for this route, and what is the upload deadline?” Send this to the university’s published admissions contact."}]]}]
1f:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for IELTS, PTE and TOEFL: selected current requirements","children":[["$","$L4","https://www.unipd.it/en/requisito-linguistico-ammissione-corsi-studio-ateneo",{"href":"https://www.unipd.it/en/requisito-linguistico-ammissione-corsi-studio-ateneo","children":["Padua language requirement and current certificate lists",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification/application/list-of-documents-required-by-the-admissions-office",{"href":"https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification/application/list-of-documents-required-by-the-admissions-office","children":["Polimi required documents and 2027–2028 English evidence",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.unibo.it/en/study/enrolment-fees-and-other-procedures/degree-programmes/enrolling-in-second-cycle-degree-programmes/enrolling-in-a-second-cycle-degree-programme-if-you-come-from-a-non-eu-country",{"href":"https://www.unibo.it/en/study/enrolment-fees-and-other-procedures/degree-programmes/enrolling-in-second-cycle-degree-programmes/enrolling-in-a-second-cycle-degree-programme-if-you-come-from-a-non-eu-country","children":["Bologna non-EU master's enrolment route",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
20:["$","section","1-Padua's new exemption list: do not reuse old MOI advice",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Padua's new exemption list: do not reuse old MOI advice"}],[["$","p","The September 2026 exemption PDF lists specific countries and entry qualifications. A degree taught in English in Pakistan is not automatically an exempt qualification. Check the linked PDF and obtain confirmation where your qualification is unclear.",{"children":"The September 2026 exemption PDF lists specific countries and entry qualifications. A degree taught in English in Pakistan is not automatically an exempt qualification. Check the linked PDF and obtain confirmation where your qualification is unclear."}],["$","p","Keep admission-language proof separate from consular visa requirements. A university exemption does not override the competent mission's checklist.",{"children":"Keep admission-language proof separate from consular visa requirements. A university exemption does not override the competent mission's checklist."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","2-Bachelor's and master's academic admission",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Bachelor's and master's academic admission"}],[["$","p","A bachelor's or single-cycle application with a foreign qualification normally requires a school history equivalent to at least 12 years, subject prerequisites and any course-specific test or ranking. Applicants from shorter school systems should read the university's permitted compensating study or foundation routes.",{"children":"A bachelor's or single-cycle application with a foreign qualification normally requires a school history equivalent to at least 12 years, subject prerequisites and any course-specific test or ranking. Applicants from shorter school systems should read the university's permitted compensating study or foundation routes."}],["$","p","A master's application is assessed against the prior degree, subjects, credits, academic performance and any portfolio or programme-specific evidence. Polimi tells foreign-degree applicants to check country-specific qualification and GPA requirements before submitting its master's application.",{"children":"A master's application is assessed against the prior degree, subjects, credits, academic performance and any portfolio or programme-specific evidence. Polimi tells foreign-degree applicants to check country-specific qualification and GPA requirements before submitting its master's application."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","3-Application documents to prepare",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Application documents to prepare"}],[["$","p","Use the selected programme's checklist. Common items include passport, qualification or current enrolment evidence, transcript, grading information, language proof, translations and programme-specific statements or portfolio. A positive initial evaluation can still require original, verified or recognition documents for enrolment.",{"children":"Use the selected programme's checklist. Common items include passport, qualification or current enrolment evidence, transcript, grading information, language proof, translations and programme-specific statements or portfolio. A positive initial evaluation can still require original, verified or recognition documents for enrolment."}],["$","p","Names and dates should match the passport. Upload complete scans in the required format and keep originals available. Never edit a transcript or create a replacement certificate yourself.",{"children":"Names and dates should match the passport. Upload complete scans in the required format and keep originals available. Never edit a transcript or create a replacement certificate yourself."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Passport",{"children":"Passport"}],["$","li","Final or provisional qualification",{"children":"Final or provisional qualification"}],["$","li","Transcript and grading scale",{"children":"Transcript and grading scale"}],["$","li","Accepted language evidence",{"children":"Accepted language evidence"}],["$","li","Certified translation where required",{"children":"Certified translation where required"}],["$","li","Programme-specific CV, statement or portfolio",{"children":"Programme-specific CV, statement or portfolio"}],["$","li","Recognition or authenticity evidence requested for enrolment",{"children":"Recognition or authenticity evidence requested for enrolment"}]]}],"$undefined","$undefined","$undefined"]}]
23:["$","section","4-Universitaly pre-enrolment comes after the university route",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Universitaly pre-enrolment comes after the university route"}],[["$","p","Universitaly explains that applicants first choose a programme and contact or apply to the higher education institution. After the university process, eligible non-EU applicants living abroad complete online pre-enrolment and upload the records required for the institution's validation.",{"children":"Universitaly explains that applicants first choose a programme and contact or apply to the higher education institution. After the university process, eligible non-EU applicants living abroad complete online pre-enrolment and upload the records required for the institution's validation."}],["$","p","The validated pre-enrolment supports the visa application but does not create a right to a visa. Follow the competent embassy or consulate for the current appointment, financial, accommodation, insurance and document requirements.",{"children":"The validated pre-enrolment supports the visa application but does not create a right to a visa. Follow the competent embassy or consulate for the current appointment, financial, accommodation, insurance and document requirements."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","5-A six-stage application tracker",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"A six-stage application tracker"}],[["$","p","Give each stage its own status and deadline so one completed form is not mistaken for the whole process.",{"children":"Give each stage its own status and deadline so one completed form is not mistaken for the whole process."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","1. Programme and qualification fit",{"children":"1. Programme and qualification fit"}],["$","li","2. University admission application",{"children":"2. University admission application"}],["$","li","3. Scholarship or fee-support application",{"children":"3. Scholarship or fee-support application"}],["$","li","4. Admission decision and conditions",{"children":"4. Admission decision and conditions"}],["$","li","5. Universitaly pre-enrolment where applicable",{"children":"5. Universitaly pre-enrolment where applicable"}],["$","li","6. Visa, travel and final enrolment",{"children":"6. Visa, travel and final enrolment"}]]}],"$undefined","$undefined","$undefined"]}]
25:["$","section","6-Ask admissions a precise question",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Ask admissions a precise question"}],[["$","p","State your programme, intake, qualification country, test name or proposed alternative and certificate issue date. Ask whether it meets the requirement and when it must be uploaded. Save the written response with the call; it is more useful than a general claim that the university accepts MOI.",{"children":"State your programme, intake, qualification country, test name or proposed alternative and certificate issue date. Ask whether it meets the requirement and when it must be uploaded. Save the written response with the call; it is more useful than a general claim that the university accepts MOI."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Ask admissions a precise question","children":[["$","$L4","/guides/university-of-padua-admissions-scholarships/",{"href":"/guides/university-of-padua-admissions-scholarships/","children":["Padua route",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/politecnico-di-milano-masters-admissions/",{"href":"/guides/politecnico-di-milano-masters-admissions/","children":["Polimi master's route",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/university-of-bologna-admissions-scholarships/",{"href":"/guides/university-of-bologna-admissions-scholarships/","children":["Bologna route",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
26:["$","section","7-Your working checklist",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Your working checklist"}],[],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2b",null,{"id":"guides/study-in-italy-admission-english-requirements:section-8","title":"Check your progress","items":["Confirm programme, degree and intake.","Check accepted certificates and exemptions for your qualification.","Record language-proof upload deadlines.","Ask admissions a precise written question if unclear."]}],"$undefined","$undefined"]}]
27:["$","section","8-Turn the English-language rule into an application decision",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Turn the English-language rule into an application decision"}],[["$","p","Once you identify the accepted proof for a specific Italian degree, record the minimum overall score, any section minimum, the waiver evidence and the last test date that can reach the university before its deadline. This keeps a general language policy from becoming a late application blocker.",{"children":"Once you identify the accepted proof for a specific Italian degree, record the minimum overall score, any section minimum, the waiver evidence and the last test date that can reach the university before its deadline. This keeps a general language policy from becoming a late application blocker."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Turn the English-language rule into an application decision","children":[["$","$L4","/tools/ielts-band-calculator/",{"href":"/tools/ielts-band-calculator/","children":["Calculate an IELTS overall band",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/italy-university-application-deadlines/",{"href":"/guides/italy-university-application-deadlines/","children":["Check Italy application deadlines",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/scholarships-without-ielts/",{"href":"/guides/scholarships-without-ielts/","children":["Understand IELTS waivers",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]