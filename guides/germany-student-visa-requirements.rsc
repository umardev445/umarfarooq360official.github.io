1e:["$","section","1-Confirm the visa route and responsible mission",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Confirm the visa route and responsible mission"}],[["$","p","Applicants who require a national visa should use the German mission responsible for their place of residence. The Consular Services Portal supports online applications for study purposes, while an in-person appointment can still be required for original documents, biometrics and payment.",{"children":"Applicants who require a national visa should use the German mission responsible for their place of residence. The Consular Services Portal supports online applications for study purposes, while an in-person appointment can still be required for original documents, biometrics and payment."}],["$","p","Do not apply through a different mission merely because its appointment calendar appears faster. Check nationality-based exemptions and your own residence situation on the official visa route.",{"children":"Do not apply through a different mission merely because its appointment calendar appears faster. Check nationality-based exemptions and your own residence situation on the official visa route."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Confirm the visa route and responsible mission","children":[["$","$L4","https://www.make-it-in-germany.com/en/visa-residence/types/studying",{"href":"https://www.make-it-in-germany.com/en/visa-residence/types/studying","children":["Official study-visa route",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.auswaertiges-amt.de/en/visa-service/consular-services-portal",{"href":"https://www.auswaertiges-amt.de/en/visa-service/consular-services-portal","children":["Consular Services Portal guidance",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1f:["$","section","2-Build the document file from the official checklist",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Build the document file from the official checklist"}],[["$","p","The mission's portal or local website decides the exact format, copy, translation and appointment requirements. Use these categories to organise the file, then replace them with the binding local checklist.",{"children":"The mission's portal or local website decides the exact format, copy, translation and appointment requirements. Use these categories to organise the file, then replace them with the binding local checklist."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Germany study-visa evidence categories","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Germany study-visa evidence categories"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Category",{"scope":"col","children":"Category"}],["$","th","Purpose",{"scope":"col","children":"Purpose"}],["$","th","Verification question",{"scope":"col","children":"Verification question"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Identity and application"}],["$","td","1",{"children":"Establish applicant and requested visa"}],["$","td","2",{"children":"Which form, passport validity, photos and copies are required?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Study purpose"}],["$","td","1",{"children":"Show admission or the qualifying study route"}],["$","td","2",{"children":"Which admission or preparatory-study document is accepted?"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Academic and language evidence"}],["$","td","1",{"children":"Support the planned study path"}],["$","td","2",{"children":"Which certificates and language proof does the mission request?"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Proof of financing"}],["$","td","1",{"children":"Show funds for the relevant stay"}],["$","td","2",{"children":"Blocked account, recognised scholarship, declaration or another accepted form?"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Insurance and arrival cover"}],["$","td","1",{"children":"Show required medical cover"}],["$","td","2",{"children":"Which coverage period and certificate wording apply?"}]],"$undefined"]}],["$","tr","5",{"children":[[["$","th","0",{"scope":"row","children":"Applicant-specific evidence"}],["$","td","1",{"children":"Resolve gaps or local requirements"}],["$","td","2",{"children":"Does the mission request a CV, motivation, prior-study or other evidence?"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","3-Understand proof of financing before transferring money",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Understand proof of financing before transferring money"}],[["$","p","Official guidance lists several possible forms of financial proof, including a blocked account, a recognised scholarship, a declaration of commitment and other accepted evidence. A blocked account is one route, not a fee paid to the German government.",{"children":"Official guidance lists several possible forms of financial proof, including a blocked account, a recognised scholarship, a declaration of commitment and other accepted evidence. A blocked account is one route, not a fee paid to the German government."}],["$","p","The official study-visa guidance lists at least €11,904 for 2026 for a standard twelve-month study route. Amounts can change and other residence purposes use different rates, so verify the current figure for your purpose and mission before transferring funds.",{"children":"The official study-visa guidance lists at least €11,904 for 2026 for a standard twelve-month study route. Amounts can change and other residence purposes use different rates, so verify the current figure for your purpose and mission before transferring funds."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Understand proof of financing before transferring money","children":[["$","$L4","/tools/germany-blocked-account-calculator/",{"href":"/tools/germany-blocked-account-calculator/","children":["Use the Germany blocked account calculator",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.auswaertiges-amt.de/en/visa-service/buergerservice/faq/08-finanzierung/606696",{"href":"https://www.auswaertiges-amt.de/en/visa-service/buergerservice/faq/08-finanzierung/606696","children":["Official financing alternatives",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
21:["$","section","4-Choose a blocked-account provider carefully",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Choose a blocked-account provider carefully"}],[["$","p","The Federal Foreign Office does not recommend a particular provider. Compare identity checks, opening time, setup and monthly fees, transfer method, refund procedure and customer support on the provider's current terms.",{"children":"The Federal Foreign Office does not recommend a particular provider. Compare identity checks, opening time, setup and monthly fees, transfer method, refund procedure and customer support on the provider's current terms."}],["$","p","Monthly withdrawals are restricted so the required support remains available over the stay. Keep accessible money outside the account for deposits, travel and other costs due before the first release.",{"children":"Monthly withdrawals are restricted so the required support remains available over the stay. Keep accessible money outside the account for deposits, travel and other costs due before the first release."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","5-Submit, attend and track the application",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Submit, attend and track the application"}],[["$","p","Upload accurate documents through the stated portal, respond to preliminary-check messages and attend the required appointment with the requested originals. A complete upload does not guarantee approval or a particular processing time.",{"children":"Upload accurate documents through the stated portal, respond to preliminary-check messages and attend the required appointment with the requested originals. A complete upload does not guarantee approval or a particular processing time."}],["$","p","The mission can involve the foreigners authority at the study location. Do not purchase non-refundable travel based only on an expected decision date.",{"children":"The mission can involve the foreigners authority at the study location. Do not purchase non-refundable travel based only on an expected decision date."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L27",null,{"id":"guides/germany-student-visa-requirements:section-6","title":"Check your progress","items":["Responsible mission confirmed","Current portal checklist saved","Admission and language evidence ready","Accepted proof of financing ready","Insurance evidence checked","Originals and appointment items prepared","Post-arrival registration and residence steps recorded"]}],"$undefined","$undefined"]}]
23:["$","section","6-Plan the monthly budget after arrival",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Plan the monthly budget after arrival"}],[["$","p","The official blocked amount is a financing threshold, not a personalised cost-of-living prediction. Housing and setup costs can make the real budget higher, especially at the start of the stay.",{"children":"The official blocked amount is a financing threshold, not a personalised cost-of-living prediction. Housing and setup costs can make the real budget higher, especially at the start of the stay."}],["$","p","Use editable estimates for rent, food, insurance, transport, semester contributions and tuition. Compare the monthly total with the expected blocked-account release and confirmed scholarship support.",{"children":"Use editable estimates for rent, food, insurance, transport, semester contributions and tuition. Compare the monthly total with the expected blocked-account release and confirmed scholarship support."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Plan the monthly budget after arrival","children":[["$","$L4","/tools/germany-blocked-account-calculator/",{"href":"/tools/germany-blocked-account-calculator/","children":["Calculate Germany study costs",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/germany/",{"href":"/scholarships/germany/","children":["Find scholarships in Germany",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
