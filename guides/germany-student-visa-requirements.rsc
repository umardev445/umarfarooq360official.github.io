19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Use the checklist from the German mission responsible for your residence and visa route. Admission evidence, financial proof and insurance must satisfy that route; a university offer alone does not establish visa eligibility."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Open the official mission instructions, record the document format and appointment process, then check financing against the published current requirement."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Keep three document decisions separate",{"href":"#section-1","children":"Keep three document decisions separate"}],["$","a","Confirm the visa route and responsible mission",{"href":"#section-2","children":"Confirm the visa route and responsible mission"}],["$","a","Build the document file from the official checklist",{"href":"#section-3","children":"Build the document file from the official checklist"}],["$","a","Understand proof of financing before transferring money",{"href":"#section-4","children":"Understand proof of financing before transferring money"}],["$","a","Choose a blocked-account provider carefully",{"href":"#section-5","children":"Choose a blocked-account provider carefully"}],["$","a","Submit, attend and track the application",{"href":"#section-6","children":"Submit, attend and track the application"}],["$","a","Plan the monthly budget after arrival",{"href":"#section-7","children":"Plan the monthly budget