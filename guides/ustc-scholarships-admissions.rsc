25:["$","article",null,{"className":"article-body article-body--guide","children":[null,null,["$","section","2-Compare fellowship and scholarship routes",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Compare fellowship and scholarship routes"}],[["$","p","The USTC admissions overview lists ANSO, Chinese Government Scholarship and USTC international-student funding, and links separate fellowship pages by degree level. Read the exact scheme’s eligibility, assessment and support before choosing it in an application.",{"children":"The USTC admissions overview lists ANSO, Chinese Government Scholarship and USTC international-student funding, and links separate fellowship pages by degree level. Read the exact scheme’s eligibility, assessment and support before choosing it in an application."}],["$","p","Do not combine funding amounts from several scheme pages into one package. A stipend, tuition waiver, accommodation arrangement and insurance provision should each be verified for the award category you are applying to.",{"children":"Do not combine funding amounts from several scheme pages into one package. A stipend, tuition waiver, accommodation arrangement and insurance provision should each be verified for the award category you are applying to."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"USTC funding comparison worksheet","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"USTC funding comparison worksheet"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route",{"scope":"col","children":"Route"}],["$","th","Essential check",{"scope":"col","children":"Essential check"}],["$","th","Keep separate",{"scope":"col","children":"Keep separate"}]],"$undefined"]}]}],["$","