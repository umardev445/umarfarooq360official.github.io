1e:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"USTC’s 2027 international master’s general application window is 25 October 2026–31 March 2027. Named scholarships use their own dates: CAS-ANSO closes 28 February 2027 for applicants and referees. Programme admission and funding remain separate decisions."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Open the 2027 degree guide and selected scholarship notice, then plan against the earlier applicable task."]}],"$undefined"]}],false,false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Confirm USTC, degree level and programme",{"href":"#section-1","children":"Confirm USTC, degree level and programme"}],["$","a","Use the 2027 master’s guide and the scholarship call together",{"href":"#section-2","children":"Use the 2027 master’s guide and the scholarship call together"}],["$","a","Compare fellowship and scholarship routes",{"href":"#section-3","children":"Compare fellowship and scholarship routes"}],["$","a","Read the current admission guide before writing your file",{"href":"#section-4","children":"Read the current admission guide before writing your file"}],["$","a","Build an application file that can be checked",{"href":"#section-5","children"