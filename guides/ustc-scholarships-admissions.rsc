19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/expansion-20261022/china-ustc-1280.webp","srcSet":"/images/expansion-20261022/china-ustc-640.webp 640w, /images/expansion-20261022/china-ustc-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Modern buildings and green spaces in Shanghai","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Destination or study photograph; not a photograph of the named university or scholarship."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"USTC publishes degree-specific admission and fellowship information. Match the funding scheme to your study level and programme; a benefit listed for one fellowship category is not a promise to every applicant."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Use the International College admissions page to open the current guide and fellowship instructions for your intended degree."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Confirm USTC, degree level and programme",{"href":"#section-1","children":"Confirm USTC, degree level and programme"}],["$","a","Compare fellowship and scholarship routes",{"href":"#section-2","children":"Compare fellowship and scholarship routes"}],["$","a","Read the current admission guide before writing your file",{"href":"#section-3","children":"Read the current admission guide before writing your file"}],["$","a","Build an application file that can be checked",{"href":"#section-4","children":"Build an application file that can be checked"}],["$","a","Cycle status and submission planning",{"href":"#section-5","children":"Cycle status and submission planning"}],["$","a","After an offer: verify the remaining financial gap",{"href":"#section-6","children":"After an offer: verify the remaining financial gap"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Confirm USTC, degree level and programme",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Confirm USTC, degree level and programme"}],[["$","p","Check that you are reading University of Science and Technology of China, not another institution with a similar English name. Use the official International College and application links for your intake.",{"children":"Check that you are reading University of Science and Technology of China, not another institution with a similar English name. Use the official International College and application links for your intake."}],["$","p","Start with undergraduate, master’s, doctoral or non-degree status. Then choose the actual subject and teaching language. A university-wide list of research fields is not confirmation that a specific degree is available in the language and intake you need.",{"children":"Start with undergraduate, master’s, doctoral or non-degree status. Then choose the actual subject and teaching language. A university-wide list of research fields is not confirmation that a specific degree is available in the language and intake you need."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1b","$L1c","$L1d","$L1e","$L1f"]}],false,"$L20","$L21"]}],"$L22"]}]
