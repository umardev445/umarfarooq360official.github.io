28:["$","aside",null,{"className":"content-sidebar","children":[["$","div",null,{"className":"sidebar-card sidebar-card--contents","children":[["$","span",null,{"children":"On this page"}],["$","nav",null,{"aria-label":"Page contents","children":[["$","a","Confirm USTC, degree level and programme",{"href":"#section-1","children":[["$","b",null,{"children":"01"}],"Confirm USTC, degree level and programme"]}],["$","a","Use the 2027 master’s guide and the scholarship call together",{"href":"#section-2","children":[["$","b",null,{"children":"02"}],"Use the 2027 master’s guide and the scholarship call together"]}],["$","a","Compare fellowship and scholarship routes",{"href":"#section-3","children":[["$","b",null,{"children":"03"}],"Compare fellowship and scholarship routes"]}],["$","a","Read the current admission guide before writing your file",{"href":"#section-4","children":[["$","b",null,{"children":"04"}],"Read the current admission guide before writing your file"]}],["$","a","Build an application file that can be checked",{"href":"#section-5","children":[["$","b",null,{"children":"05"}],"Build an application file that can be checked"]}],["$","a","Cycle status and submission planning",{"href":"#section-6","children":[["$","b",null,{"children":"06"}],"Cycle status and submission planning"]}],["$","a","After an offer: verify the remaining financial gap",{"href":"#section-7","children":[["$","b",null,{"children":"07"}],"After an offer: verify the remaining financial gap"]}]]}]]}],["$","div",null,{"className":"sidebar-card","children":[["$","h2",null,{"children":"Next useful step"}],[["$","$L5","scholarships/cas-anso",{"href":"/scholarships/cas-anso/","children":["CAS-ANSO scholarship: USTC, UCAS and the application route"," ",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","guides/csc-scholarship-application",{"href":"/guides/csc-scholarship-application/","children"