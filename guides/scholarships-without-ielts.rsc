1b:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Without IELTS does not necessarily mean without English evidence. A university may accept a different test or a narrowly defined exemption; the scholarship or visa process can have separate conditions."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Check the exact programme and intake before requesting an MOI letter or paying for a test."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","/guides/study-in-italy-admission-english-requirements/",{"href":"/guides/study-in-italy-admission-english-requirements/","children":["Italy English requirements",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/university-of-padua-admissions-scholarships/",{"href":"/guides/university-of-padua-admissions-scholarships/","children":["Padua exemptions",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/politecnico-di-milano-masters-admissions/",{"href":"/guides/politecnico-di-milano-masters-admissions/","children":["Polimi MOI conditions",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/ielts-band-calculator/",{"href":"/tools/ielts-band-calculator/","children":["IELTS band calculator",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:childre