1d:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"The USEFP degree programme page was marked closed when checked on 1 November 2026, with a displayed deadline of 1 April 2026. Use this guide to prepare; a new deadline must come from a newly published USEFP call."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Check the current status on USEFP, choose the correct degree route and map your evidence before booking tests or preparing references."]}],"$undefined"]}],false,false,["$","$L1f",null,{"records":[{"id":"fulbright-pakistan","title":"Fulbright Pakistan degree programme — closed call","provider":"USEFP","type":"Scholarship","level":"Master's","supportedDegrees":["Master's","PhD"],"country":"United States","region":"North America","funding":"Fully funded","status":"Closed","deadline":"Reviewed call closed 1 April 2026; next deadline not confirmed","deadlineDate":"2026-04-01","summary":"Pakistan-specific graduate route through USEFP. The reviewed call is closed. Prepare the study rationale and documents, then wait for the next official announcement before treating applications as available.","tags":["Pakistani applicants","USEFP","Graduate study","Closed call"],"source":"https://usefp.org/scholarships/fulbright-degree.cfm","sourceLabel":"USEFP Fulbright degree programme","checked":"1 November 2026"}]}],null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Current call and degree route",{"href":"#section-1","children":"Current call and degree route"}],["$","a","Tests, transcripts and references are separate tasks",{"href":"#section-2","children":"Tests, transcripts and references are separate tasks"}],["$","a","Build an evidence argument before writing",{"href":"#section-3","children":"Build an evidence argument before writing"}],["$","a","Choose a referee who can evaluate the evidence",{"href":"#section-4","children":"Choose a referee who can evaluate the evidence"}],["$","a","Preparation checklist while the call is closed",{"href":"#section-5","children":"Preparation checklist while the call is closed"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Current call and degree route",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Current call and degree route"}],[["$","p","The reviewed USEFP page funds master’s and PhD study. It describes 16 years of education for master’s and 18 for PhD applicants, and excludes clinical medicine. MBA and Public Policy/Administration routes require two years of relevant work experience. Funding includes tuition, textbooks, airfare, a living stipend and health insurance, subject to the programme budget.",{"children":"The reviewed USEFP page funds master’s and PhD study. It describes 16 years of education for master’s and 18 for PhD applicants, and excludes clinical medicine. MBA and Public Policy/Administration routes require two years of relevant work experience. Funding includes tuition, textbooks, airfare, a living stipend and health insurance, subject to the programme budget."}]],"$undefined","$L20","$undefined","$undefined","$undefined","$undefined","$L21","$undefined"]}]]}],"$L22",false,false,false,"$L23",false,"$L24",null]}],"$L25"]}]
