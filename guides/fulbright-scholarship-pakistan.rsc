20:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Pakistan route: what to establish first","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Pakistan route: what to establish first"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Decision",{"scope":"col","children":"Decision"}],["$","th","Reviewed position",{"scope":"col","children":"Reviewed position"}],["$","th","Your next evidence",{"scope":"col","children":"Your next evidence"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Current call"}],["$","td","1",{"children":"Closed; displayed deadline 1 April 2026"}],["$","td","2",{"children":"Read the next USEFP announcement before submitting"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Degree"}],["$","td","1",{"children":"Master’s or PhD; different prior-education requirements"}],["$","td","2",{"children":"Degree/transcript and qualification history"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Application owner"}],["$","td","1",{"children":"USEFP Pakistan"}],["$","td","2",{"children":"Use the application route linked by USEFP"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Funding and obligations"}],["$","td","1",{"children":"Read the award conditions and return/service commitment"}],["$","td","2",{"children":"Confirm the terms before accepting"}]],"$undefined"]}]]}]]}]}],"$undefined"]
21:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://usefp.org/scholarships/fulbright-degree.cfm",{"children":["",["$","a",null,{"href":"https://usefp.org/scholarships/fulbright-degree.cfm","target":"_blank","rel":"noreferrer","children":"USEFP degree programme"}]]}]]]}]
