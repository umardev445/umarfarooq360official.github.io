26:["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"Illustrative evidence note, not an application answer"}],[["$","p","0",{"children":"During a course project, I compared two low-cost sensing approaches and found that the noisier measurements limited the conclusion. My next training need is stronger experimental design and signal analysis. I should now identify the actual work I completed and the relevant study direction before turning this note into an essay."}]],["$","p",null,{"className":"sample-card__note","children":"Fictional teaching example. Replace it with your own experience and follow the current prompt."}]]}]
27:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Build an evidence argument before writing","children":[["$","a","/downloads/application-evidence-worksheet.csv",{"href":"/downloads/application-evidence-worksheet.csv","download":true,"children":["Download the evidence worksheet (CSV)",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/statement-of-purpose/",{"href":"/guides/statement-of-purpose/","children":["Plan a statement of purpose",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
28:["$","section","3-Choose a referee who can evaluate the evidence",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Choose a referee who can evaluate the evidence"}],[["$","p","Ask people who observed your work and can explain its quality. Share a short evidence sheet, your study direction and the submission deadline. Agree their availability before entering contact details in a portal. A famous name with no knowledge of your work may produce a less useful letter than a direct supervisor.",{"children":"Ask people who observed your work and can explain its quality. Share a short evidence sheet, your study direction and the submission deadline. Agree their availability before entering contact details in a portal. A famous name with no knowledge of your work may produce a less useful letter than a direct supervisor."}],["$","p","The USEFP FAQ explains that placement is handled by experienced placement professionals; personal university preferences are not the same as a guaranteed destination. It also clarifies degree-stage and test questions. Check its current wording when your circumstances do not fit a simple checklist.",{"children":"The USEFP FAQ explains that placement is handled by experienced placement professionals; personal university preferences are not the same as a guaranteed destination. It also clarifies degree-stage and test questions. Check its current wording when your circumstances do not fit a simple checklist."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://usefp.org/scholarships/fulbright-degree-FAQ.cfm",{"children":["",["$","a",null,{"href":"https://usefp.org/scholarships/fulbright-degree-FAQ.cfm","target":"_blank","rel":"noreferrer","children":"USEFP FAQs"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Choose a referee who can evaluate the evidence","children":[["$","a","/downloads/reference-request-template.txt",{"href":"/downloads/reference-request-template.txt","download":true,"children":["Reference request template (TXT)",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/recommendation-letter/",{"href":"/guides/recommendation-letter/","children":["Recommendation-letter guide",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
29:["$","section","4-Preparation checklist while the call is closed",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Preparation checklist while the call is closed"}],[["$","p","Choose tasks that remain useful even if the next call changes. An accurate transcript, a realistic study rationale and referees who know your work are more durable than an essay written for an old prompt.",{"children":"Choose tasks that remain useful even if the next call changes. An accurate transcript, a realistic study rationale and referees who know your work are more durable than an essay written for an old prompt."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2a",null,{"id":"guides/fulbright-scholarship-pakistan:section-5","title":"Check your progress","items":["Check the official call and save its date/status","Identify master’s versus PhD preparation needs","Review the full eligibility/exclusion list","Plan tests with the actual reporting requirements","Ask referees and assemble an evidence sheet","Keep essays adaptable until the new prompt is published"]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Preparation checklist while the call is closed","children":[["$","$L5","/guides/scholarships-for-pakistani-students/",{"href":"/guides/scholarships-for-pakistani-students/","children":["Compare overseas funding routes",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","a","/downloads/scholarship-application-tracker.csv",{"href":"/downloads/scholarship-application-tracker.csv","download":true,"children":["Track separate submissions (CSV)",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
