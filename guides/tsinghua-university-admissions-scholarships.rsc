rong",null,{"children":"Graduate application fee"}],["$","span",null,{"children":"Checked 20 October 2026; the named programme and cycle control the rule."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$26:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://yz.tsinghua.edu.cn/en/Financial_Aid/Financial_Aid_System.htm",{"href":"https://yz.tsinghua.edu.cn/en/Financial_Aid/Financial_Aid_System.htm","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Financial aid types"}],["$","span",null,{"children":"Checked 20 October 2026; the named programme and cycle control the rule."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$26:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://international.join-tsinghua.edu.cn/",{"href":"https://international.join-tsinghua.edu.cn/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Undergraduate admissions"}],["$","span",null,{"children":"Checked 20 October 2026; the named programme and cycle control the rule."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$26:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
27:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is there one Tsinghua scholarship deadline?",{"children":[["$","summary",null,{"children":["Is there one Tsinghua scholarship deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Do not assume so. The graduate instructions describe department-specific deadlines and batches, and funding notices can have their own timelines. Check both the programme and the exact scholarship."}]]}],["$","details","Is the graduate application free if I apply for CSC?",{"children":[["$","summary",null,{"children":["Is the graduate application free if I apply for CSC?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The checked general graduate fee guidance states RMB 800 and says the Chinese Government Scholarship does not cover that application charge. Only a verified specific exception should be treated differently."}]]}],["$","details","Can I use a universal IELTS score from a scholarship blog?",{"children":[["$","summary",null,{"children":["Can I use a universal IELTS score from a scholarship blog?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Use the programme catalogue and department instructions instead. Language requirements and accepted evidence can differ by programme."}]]}],["$","details","Does a department recommendation guarantee a scholarship?",{"children":[["$","summary",null,{"children":["Does a department recommendation guarantee a scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Academic evaluation, recommendation or nomination and the final funding decision are distinct stages. Read the current route’s rules."}]]}]]}]]}]
