1b:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/research-2026-10/tsinghua-1280.webp","srcSet":"/images/research-2026-10/tsinghua-640.webp 640w, /images/research-2026-10/tsinghua-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Conceptual illustration for tsinghua university admissions and scholarships for international students","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Original conceptual illustration; not a photograph of a named university or scholarship recipient."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Tsinghua’s graduate admission instructions refer to 2027 entry, with department-specific arrangements. Its scholarship index still labels 2027 Chinese Government Scholarship information as forthcoming. Admission guidance and an open scholarship call are not the same announcement."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Select the programme and department first, then check the current admission instructions and the separate funding notice for that exact route."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","#official-sources",{"href":"#official-sources","children":["Official sources",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props