1d:["$","p","The official graduate instructions refer to the 2027 programme catalogue and say application batches and deadlines vary by school or department. The scholarship index separately retains the 2026 CGS entry with a notice that 2027 information is coming soon. This guide does not turn a typical application season into one fixed scholarship closing date.",{"children":"The official graduate instructions refer to the 2027 programme catalogue and say application batches and deadlines vary by school or department. The scholarship index separately retains the 2026 CGS entry with a notice that 2027 information is coming soon. This guide does not turn a typical application season into one fixed scholarship closing date."}]
1e:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Tsinghua information checked 20 October 2026","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Tsinghua information checked 20 October 2026"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Item",{"scope":"col","children":"Item"}],["$","th","Verified source position",{"scope":"col","children":"Verified source position"}],["$","th","Your action",{"scope":"col","children":"Your action"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Graduate admission"}],["$","td","1",{"children":"2027 instructions and programme catalogue referenced"}],["$","td","2",{"children":"Open your department’s application remarks"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"CGS scholarship notice"}],["$","td","1",{"children":"2027 information marked forthcoming on scholarship index"}],["$","td","2",{"children":"Wait for the specific new notice before relying on a date"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Graduate application fee"}],["$","td","1",{"children":"RMB 800 in the general fee guidance"}],["$","td","2",{"children":"Budget separately from scholarship coverage"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Undergraduate application"}],["$","td","1",{"children":"Separate admissions route"}],["$","td","2",{"children":"Do not use graduate documents or dates"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://yz.tsinghua.edu.cn/en/Financial_Aid/Scholarship_Application.htm","target":"_blank","rel":"noreferrer","children":"Official guidance"}]]}]]
1f:["$","section","1-Select degree, campus and programme before checking requirements",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Select degree, campus and programme before checking requirements"}],[["$","p","A master’s application, direct doctoral route and undergraduate application are different tasks. Begin with the official programme entry, its teaching language and the responsible school. If you are considering a separate campus, professional programme or special scholarship programme, use that programme’s own instructions as well.",{"children":"A master’s application, direct doctoral route and undergraduate application are different tasks. Begin with the official programme entry, its teaching language and the responsible school. If you are considering a separate campus, professional programme or special scholarship programme, use that programme’s own instructions as well."}],["$","p","Write a fit note before spending on documents: prior qualification, relevant coursework, academic interests and the course or research group you want to join. For a research application, explain the connection between your existing work and the proposed topic. The institution’s reputation is not a substitute for subject preparation.",{"children":"Write a fit note before spending on documents: prior qualification, relevant coursework, academic interests and the course or research group you want to join. For a research application, explain the connection between your existing work and the proposed topic. The institution’s reputation is not a substitute for subject preparation."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://yz.tsinghua.edu.cn/en/Admissions/How_to_Apply.htm",{"children":["",["$","a",null,{"href":"https://yz.tsinghua.edu.cn/en/Admissions/How_to_Apply.htm","target":"_blank","rel":"noreferrer","children":"Tsinghua graduate application instructions"}]]}],["$","span","https://international.join-tsinghua.edu.cn/",{"children":[" · ",["$","a",null,{"href":"https://international.join-tsinghua.edu.cn/","target":"_blank","rel":"noreferrer","children":"Separate undergraduate admissions"}]]}]]]}],"$undefined"]}]
20:["$","section","2-Language and academic documents: follow the department",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Language and academic documents: follow the department"}],[["$","p","The university’s graduate guidance directs applicants to the language requirements in programme-catalogue remarks. Do not assume a single IELTS, TOEFL or HSK minimum covers every programme. Check accepted proof, any exemption and the point at which the evidence must be submitted.",{"children":"The university’s graduate guidance directs applicants to the language requirements in programme-catalogue remarks. Do not assume a single IELTS, TOEFL or HSK minimum covers every programme. Check accepted proof, any exemption and the point at which the evidence must be submitted."}],["$","p","Prepare a document map rather than a generic attachment bundle. Match each required qualification, transcript, personal statement, research evidence and reference to its role in the application. Applicants completing a degree should identify the accepted provisional document and the later deadline for final qualification evidence.",{"children":"Prepare a document map rather than a generic attachment bundle. Match each required qualification, transcript, personal statement, research evidence and reference to its role in the application. Applicants completing a degree should identify the accepted provisional document and the later deadline for final qualification evidence."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Programme and language requirement saved from the official source.",{"children":"Programme and language requirement saved from the official source."}],["$","li","Relevant qualification and transcript prepared in accepted form.",{"children":"Relevant qualification and transcript prepared in accepted form."}],["$","li","Authentication or provisional-degree requirements checked.",{"children":"Authentication or provisional-degree requirements checked."}],["$","li","Personal statement linked to the selected academic route.",{"children":"Personal statement linked to the selected academic route."}],["$","li","References requested with the correct submission procedure.",{"children":"References requested with the correct submission procedure."}]]}],"$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://yz.tsinghua.edu.cn/en/Admissions/How_to_Apply.htm",{"children":["",["$","a",null,{"href":"https://yz.tsinghua.edu.cn/en/Admissions/How_to_Apply.htm","target":"_blank","rel":"noreferrer","children":"Official academic and document requirements"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Language and academic documents: follow the department","children":[["$","$L4","/guides/statement-of-purpose/",{"href":"/guides/statement-of-purpose/","children":["Develop an original statement of purpose",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/recommendation-letter/",{"href":"/guides/recommendation-letter/","children":["Plan recommendation letters",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
21:["$","section","3-The graduate application fee is separate from a scholarship",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"The graduate application fee is separate from a scholarship"}],[["$","p","Tsinghua’s general graduate fee page states RMB 800, payable when the application is submitted, and says it is not covered by the Chinese Government Scholarship. It also states that the charge is non-refundable regardless of the result. Do not assume a free CSC portal means the university application is free.",{"children":"Tsinghua’s general graduate fee page states RMB 800, payable when the application is submitted, and says it is not covered by the Chinese Government Scholarship. It also states that the charge is non-refundable regardless of the result. Do not assume a free CSC portal means the university application is free."}],["$","p","Before payment, verify the programme, applicant identity and required files. If a specific programme publishes a distinct fee arrangement, retain that notice and confirm its scope. An exception for one programme must not be repeated as a university-wide waiver.",{"children":"Before payment, verify the programme, applicant identity and required files. If a specific programme publishes a distinct fee arrangement, retain that notice and confirm its scope. An exception for one programme must not be repeated as a university-wide waiver."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://yz.tsinghua.edu.cn/en/Costs/Application_Fee.htm",{"children":["",["$","a",null,{"href":"https://yz.tsinghua.edu.cn/en/Costs/Application_Fee.htm","target":"_blank","rel":"noreferrer","children":"Official Tsinghua graduate application fee"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for The graduate application fee is separate from a scholarship","children":[["$","$L4","/guides/china-universities-without-application-fees/",{"href":"/guides/china-universities-without-application-fees/","children":["Compare verified application-fee routes in China",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
22:["$","section","4-Compare the funding route before starting a second form",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Compare the funding route before starting a second form"}],[["$","p","Tsinghua’s financial-aid system distinguishes government scholarships, tuition support and particular fully funded programmes. These options do not have identical coverage, duration or selection processes. A tuition award should not be budgeted as a living stipend unless its own terms say so.",{"children":"Tsinghua’s financial-aid system distinguishes government scholarships, tuition support and particular fully funded programmes. These options do not have identical coverage, duration or selection processes. A tuition award should not be budgeted as a living stipend unless its own terms say so."}],["$","p","For a university-nominated CGS route, understand the relationship between academic evaluation, departmental recommendation and final scholarship selection. For a sending-authority route, check the authority’s own deadline and nomination instructions. The broad Type A/Type B label helps you find the process, but the current institution and authority notices control the actual steps.",{"children":"For a university-nominated CGS route, understand the relationship between academic evaluation, departmental recommendation and final scholarship selection. For a sending-authority route, check the authority’s own deadline and nomination instructions. The broad Type A/Type B label helps you find the process, but the current institution and authority notices control the actual steps."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Questions for your funding shortlist","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Questions for your funding shortlist"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route",{"scope":"col","children":"Route"}],["$","th","Decision to verify",{"scope":"col","children":"Decision to verify"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Government scholarship"}],["$","td","1",{"children":"Which channel, study category, nomination and final decision apply?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Tuition scholarship"}],["$","td","1",{"children":"Does it cover full or partial tuition, and for which period?"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Programme-specific funding"}],["$","td","1",{"children":"Is the exact programme and applicant group included?"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Assistantship"}],["$","td","1",{"children":"Is an actual position or award confirmed, rather than merely possible?"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://yz.tsinghua.edu.cn/en/Financial_Aid/Financial_Aid_System.htm",{"children":["",["$","a",null,{"href":"https://yz.tsinghua.edu.cn/en/Financial_Aid/Financial_Aid_System.htm","target":"_blank","rel":"noreferrer","children":"Tsinghua financial aid system"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Compare the funding route before starting a second form","children":[["$","$L4","/guides/csc-scholarship-type-a-vs-type-b/",{"href":"/guides/csc-scholarship-type-a-vs-type-b/","children":["CSC routes explained",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
23:["$","section","5-Coordinate the university portal and scholarship instructions",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Coordinate the university portal and scholarship instructions"}],[["$","p","Use a tracker with separate records for the academic application and funding steps. Keep programme names consistent across systems; a mismatch between the research topic, department and selected major creates avoidable confusion. Do not submit a second form simply because another university required it at a different stage.",{"children":"Use a tracker with separate records for the academic application and funding steps. Keep programme names consistent across systems; a mismatch between the research topic, department and selected major creates avoidable confusion. Do not submit a second form simply because another university required it at a different stage."}],["$","p","Before each deadline, inspect which application is final, what receipt exists and whether any reference or departmental action remains. Save instructions received from the responsible office. A supervisor’s informal interest, a pre-admission assessment and a final award are different outcomes.",{"children":"Before each deadline, inspect which application is final, what receipt exists and whether any reference or departmental action remains. Save instructions received from the responsible office. A supervisor’s informal interest, a pre-admission assessment and a final award are different outcomes."}]],["$","ol",null,{"className":"process-steps","aria-label":"Coordinate the university portal and scholarship instructions","children":[["$","li","Check programme-specific admission conditions and dates.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Check programme-specific admission conditions and dates."}]]}],["$","li","Submit the correct university application with its required fee.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Submit the correct university application with its required fee."}]]}],["$","li","Read the current scholarship route instructions.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Read the current scholarship route instructions."}]]}],["$","li","Complete any departmental or authority steps in the stated sequence.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Complete any departmental or authority steps in the stated sequence."}]]}],["$","li","Retain both records and monitor official communications.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Retain both records and monitor official communications."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Coordinate the university portal and scholarship instructions","children":[["$","$L4","/guides/csc-scholarship-application/",{"href":"/guides/csc-scholarship-application/","children":["CSC application preparation",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
24:["$","section","6-Build a realistic funding and arrival plan",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Build a realistic funding and arrival plan"}],[["$","p","Separate tuition, accommodation, living support and insurance in the award you are considering. Add application costs, documents, travel and any initial expenses that arise before benefits are usable. A partial tuition award can still leave a substantial living-cost requirement.",{"children":"Separate tuition, accommodation, living support and insurance in the award you are considering. Add application costs, documents, travel and any initial expenses that arise before benefits are usable. A partial tuition award can still leave a substantial living-cost requirement."}],["$","p","Choose the decision you need next: apply, await a new call, clarify a condition or reject an unaffordable route. If funding is not confirmed, keep a pending column instead of counting it as money already available. Compare other Chinese universities for academic and financial fit rather than submitting only to one famous institution.",{"children":"Choose the decision you need next: apply, await a new call, clarify a condition or reject an unaffordable route. If funding is not confirmed, keep a pending column instead of counting it as money already available. Compare other Chinese universities for academic and financial fit rather than submitting only to one famous institution."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Build a realistic funding and arrival plan","children":[["$","$L4","/countries/china/",{"href":"/countries/china/","children":["China study and scholarship hub",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/peking-university-admissions-scholarships/",{"href":"/guides/peking-university-admissions-scholarships/","children":["Peking admission and funding comparison",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/chinese-government-scholarship/",{"href":"/scholarships/chinese-government-scholarship/","children":["Chinese Government Scholarship overview",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
25:["$","section","7-Final consistency check",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Final consistency check"}],[["$","p","Read your complete file as an evaluator would: intended programme, academic evidence, research or career plan and funding route. Check that every date, degree title and identity document belongs to the same intake. Remove copied instructions that refer to a different year.",{"children":"Read your complete file as an evaluator would: intended programme, academic evidence, research or career plan and funding route. Check that every date, degree title and identity document belongs to the same intake. Remove copied instructions that refer to a different year."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L29",null,{"id":"guides/tsinghua-university-admissions-scholarships:section-8","title":"Check your progress","items":["Correct degree and department confirmed.","Admission and scholarship status checked separately.","Language evidence follows the programme.","Application fee and initial costs budgeted.","University and funding records are consistent.","Only the current notice supplies binding deadlines."]}],"$undefined","$undefined"]}]
