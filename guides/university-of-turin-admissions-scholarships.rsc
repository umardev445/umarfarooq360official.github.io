19:T4e0,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Are the University of Turin and Politecnico di Torino the same?","acceptedAnswer":{"@type":"Answer","text":"No. They are separate universities with different programme catalogues, admissions systems and calls. Their students may research the same regional EDISU authority, but university applications remain separate."}},{"@type":"Question","name":"What is the University of Turin application fee?","acceptedAnswer":{"@type":"Answer","text":"The checked 2026/27 international application page states €60 for up to two programmes. Recheck the current portal before paying for a later cycle or a different application route."}},{"@type":"Question","name":"Can I use one deadline for every UniTo programme?","acceptedAnswer":{"@type":"Answer","text":"No. Degree, programme access rules and applicant category can change the permitted call. Keep a separate record for admission, scholarship and pre-enrolment."}},{"@type":"Question","name":"Does an admission offer include an EDISU scholarship?","acceptedAnswer":{"@type":"Answer","text":"No. EDISU has its own application, documents and conditions. Use the dedicated regional guide and current notice."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/university-of-turin-admissions-scholarships/\",\"name\":\"University of Turin admissions and scholarships for international students\",\"description\":\"Compare University of Turin admission steps, application fees, programme requirements and funding routes, including EDISU and separate pre-enrolment tasks.\",\"url\":\"https://aspirecompass.org/guides/university-of-turin-admissions-scholarships/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-20\"