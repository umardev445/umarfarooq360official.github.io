1b:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/research-2026-10/turin-1280.webp","srcSet":"/images/research-2026-10/turin-640.webp 640w, /images/research-2026-10/turin-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Conceptual illustration for university of turin admissions and scholarships for international students","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Original conceptual illustration; not a photograph of a named university or scholarship recipient."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"University of Turin admission, university scholarships and EDISU Piemonte are separate processes. The checked main 2026/27 application dates have passed. Use programme-specific calls to confirm a new intake rather than assuming the old dates repeat."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose the exact programme and applicant category on Apply@UniTo, then create separate records for admission, funding and Universitaly."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","#official-sources",{"href":"#official-sources","children":["Official sources",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/team/hafiz-umar-farooq/",{"href":"/team/hafiz-umar-farooq/","children":["Editorial contact",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","UniTo application facts and cycle status",{"href":"#section-1","children":"UniTo application facts and cycle status"}],["$","a","Find your programme before evaluating eligibility",{"href":"#section-2","children":"Find your programme before evaluating eligibility"}],["$","a","English and Italian requirements: use the actual course rules",{"href":"#section-3","children":"English and Italian requirements: use the actual course rules"}],["$","a","Build an application that can be evaluated",{"href":"#section-4","children":"Build an application that can be evaluated"}],["$","a","University funding and EDISU: two different routes",{"href":"#section-5","children":"University funding and EDISU: two different routes"}],["$","a","Tuition and arrival costs: ask for the right calculation",{"href":"#section-6","children":"Tuition and arrival costs: ask for the right calculation"}],["$","a","After an offer: Universitaly, originals and enrolment",{"href":"#section-7","children":"After an offer: Universitaly, originals and enrolment"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-UniTo application facts and cycle status",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"UniTo application facts and cycle status"}],[["$","p","The official 2026/27 international application page lists a €60 application allowing up to two programmes. This is an application charge, not the annual tuition bill. The main published postgraduate and undergraduate application periods below have ended. Restricted or later calls depend on the applicant category and programme.",{"children":"The official 2026/27 international application page lists a €60 application allowing up to two programmes. This is an application charge, not the annual tuition bill. The main published postgraduate and undergraduate application periods below have ended. Restricted or later calls depend on the applicant category and programme."}]],"$undefined","$L1d","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1e","$L1f","$L20","$L21","$L22","$L23"]}],false,"$L24","$L25"]}],"$L26"]}]
