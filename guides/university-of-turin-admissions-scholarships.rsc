25:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Are the University of Turin and Politecnico di Torino the same?",{"children":[["$","summary",null,{"children":["Are the University of Turin and Politecnico di Torino the same?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. They are separate universities with different programme catalogues, admissions systems and calls. Their students may research the same regional EDISU authority, but university applications remain separate."}]]}],["$","details","What is the University of Turin application fee?",{"children":[["$","summary",null,{"children":["What is the University of Turin application fee?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The checked 2026/27 international application page states €60 for up to two programmes. Recheck the current portal before paying for a later cycle or a different application route."}]]}],["$","details","Can I use one deadline for every UniTo programme?",{"children":[["$","summary",null,{"children":["Can I use one deadline for every UniTo programme?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Degree, programme access rules and applicant category can change the permitted call. Keep a separate record for admission, scholarship and pre-enrolment."}]]}],["$","details","Does an admission offer include an EDISU scholarship?",{"children":[["$","summary",null,{"children":["Does an admission offer include an EDISU scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. EDISU has its own application, documents and conditions. Use the dedicated regional guide and current notice."}]]}]]}]]}]
