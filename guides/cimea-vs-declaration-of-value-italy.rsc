22:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is CIMEA the same as a Declaration of Value?",{"children":[["$","summary",null,{"children":["Is CIMEA the same as a Declaration of Value?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. They are different qualification-information routes. The university or competent authority decides which evidence it accepts or requires."}]]}],["$","details","Do all Italian universities require CIMEA?",{"children":[["$","summary",null,{"children":["Do all Italian universities require CIMEA?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Requirements vary by university, programme, qualification country and stage of enrolment. Read the exact current instructions."}]]}],["$","details","Should I order CIMEA before admission?",{"children":[["$","summary",null,{"children":["Should I order CIMEA before admission?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Only when the university says it is required at that stage or the processing timeline makes early action necessary. Confirm the exact service first."}]]}],["$","details","Does a Declaration of Value guarantee recognition?",{"children":[["$","summary",null,{"children":["Does a Declaration of Value guarantee recognition?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It supplies information about a foreign qualification; the receiving institution makes the relevant academic decision."}]]}]]}]]}]
