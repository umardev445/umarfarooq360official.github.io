26:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.esteri.it/en/temi/diplomazia_culturale/universita/riconoscimento_titoli_studio/",{"children":["",["$","a",null,{"href":"https://www.esteri.it/en/temi/diplomazia_culturale/universita/riconoscimento_titoli_studio/","target":"_blank","rel":"noreferrer","children":"Italian Ministry: Declaration of Value"}]]}]]]}]
27:["$","section","3-Comparability and verification answer different questions",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Comparability and verification answer different questions"}],[["$","p","A statement about a qualification’s level and a check of its authenticity address different needs. Do not treat the word CIMEA as a single product that automatically includes every service. The receiving institution should identify the evidence it wants and the stage when it wants it.",{"children":"A statement about a qualification’s level and a check of its authenticity address different needs. Do not treat the word CIMEA as a single product that automatically includes every service. The receiving institution should identify the evidence it wants and the stage when it wants it."}],["$","p","Before ordering, copy the exact wording from the programme or enrolment instructions. If it names comparability, verification, both, a Declaration of Value or an alternative, keep that distinction visible. A general explanation of services does not establish what your particular university will accept.",{"children":"Before ordering, copy the exact wording from the programme or enrolment instructions. If it names comparability, verification, both, a Declaration of Value or an alternative, keep that distinction visible. A general explanation of services does not establish what your particular university will accept."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Questions to clarify before choosing evidence","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Questions to clarify before choosing evidence"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Wording in the instruction",{"scope":"col","children":"Wording in the instruction"}],["$","th","Question for the receiving institution",{"scope":"col","children":"Question for the receiving institution"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Comparability"}],["$","td","1",{"children":"Which qualification and specific statement are required?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Verification"}],["$","td","1",{"children":"Which authenticity evidence and service are accepted?"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Declaration of Value"}],["$","td","1",{"children":"Which competent mission and document route apply?"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Alternative evidence"}],["$","td","1",{"children":"What exact document satisfies this requirement?"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
28:["$","section","4-Three applicant scenarios",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Three applicant scenarios"}],[["$","p","Scenario A: an applicant sees a document requirement only in final-enrolment instructions. They ask whether it must be completed before admission or can follow an offer. They use the confirmed timing instead of paying immediately because another student did so.",{"children":"Scenario A: an applicant sees a document requirement only in final-enrolment instructions. They ask whether it must be completed before admission or can follow an offer. They use the confirmed timing instead of paying immediately because another student did so."}],["$","p","Scenario B: a university names two statements. The applicant checks the qualification, current official service package and upload stage. They do not assume that ordering one statement automatically fulfils the second request.",{"children":"Scenario B: a university names two statements. The applicant checks the qualification, current official service package and upload stage. They do not assume that ordering one statement automatically fulfils the second request."}],["$","p","Scenario C: the programme permits a listed alternative. The applicant compares the accepted routes and timing after confirming that the alternative applies to their qualification country. These are fictional decision scenarios, not promises about a named university’s policy.",{"children":"Scenario C: the programme permits a listed alternative. The applicant compares the accepted routes and timing after confirming that the alternative applies to their qualification country. These are fictional decision scenarios, not promises about a named university’s policy."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","5-Ask for clarification with a useful email",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Ask for clarification with a useful email"}],[["$","p","A precise question can prevent duplicate purchases. State the programme, intake, qualification country and document instruction. Ask about the evidence and timing, rather than asking whether CIMEA is generally compulsory in Italy.",{"children":"A precise question can prevent duplicate purchases. State the programme, intake, qualification country and document instruction. Ask about the evidence and timing, rather than asking whether CIMEA is generally compulsory in Italy."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"Fictional clarification email"}],[["$","p","0",{"children":"Dear Admissions Team, I am preparing an application for the stated programme and intake. My qualification was issued in [country]. Your instructions mention [exact document wording]. Could you confirm which statement or accepted alternative is required for this qualification, and whether it must be supplied at application or final enrolment? I would also appreciate the official document page for the procedure. Thank you."}]],["$","p",null,{"className":"sample-card__note","children":"Replace the placeholders with your own case. Send to the institution’s published contact, not an unverified intermediary."}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2a:["$","section","6-Record fees, processing and dependencies without guessing",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Record fees, processing and dependencies without guessing"}],[["$","p","Current fees, processing routes and document lists must be checked on the service or competent mission. We do not publish a universal processing time or fee because the required service and case can differ. An advertised standard period is not a guaranteed completion date.",{"children":"Current fees, processing routes and document lists must be checked on the service or competent mission. We do not publish a universal processing time or fee because the required service and case can differ. An advertised standard period is not a guaranteed completion date."}],["$","p","Record the ordering date, reference number, requested evidence, estimated processing information, university upload deadline and a contact for queries. If the institution changes the requirement, seek clarification before ordering a second route. Keep the original instructions and response together.",{"children":"Record the ordering date, reference number, requested evidence, estimated processing information, university upload deadline and a contact for queries. If the institution changes the requirement, seek clarification before ordering a second route. Keep the original instructions and response together."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2b:["$","section","7-Final checks before submitting the result",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Final checks before submitting the result"}],[["$","p","Confirm that the name, qualification, issuing institution and document type match your application. Read whether the university needs an uploaded copy, original or verification through its own channel. Do not assume a document accepted by one institution is accepted everywhere.",{"children":"Confirm that the name, qualification, issuing institution and document type match your application. Read whether the university needs an uploaded copy, original or verification through its own channel. Do not assume a document accepted by one institution is accepted everywhere."}],["$","p","A qualification-information document does not itself confer admission, a scholarship or a visa. Continue the remaining programme and immigration tasks separately.",{"children":"A qualification-information document does not itself confer admission, a scholarship or a visa. Continue the remaining programme and immigration tasks separately."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2e",null,{"id":"guides/cimea-vs-declaration-of-value-italy:section-8","title":"Check your progress","items":["Exact requirement saved","Service and qualification confirmed","Stage and deadline recorded","Official ordering channel verified","Files and names checked","Receiving institution’s submission route followed"]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Final checks before submitting the result","children":[["$","$L4","/guides/study-in-italy-admission-english-requirements/",{"href":"/guides/study-in-italy-admission-english-requirements/","children":["Italy admission and language requirements",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/universitaly-pre-enrolment/",{"href":"/guides/universitaly-pre-enrolment/","children":["Universitaly pre-enrolment sequence",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/italy-university-application-deadlines/",{"href":"/guides/italy-university-application-deadlines/","children":["Plan university application dates",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
