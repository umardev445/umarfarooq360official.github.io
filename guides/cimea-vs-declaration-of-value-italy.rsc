1c:["$","section","1-Start with the university requirement",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Start with the university requirement"}],[["$","p","Read the admissions call, country-specific document page and enrolment instructions. Search for CIMEA, Statement of Comparability, Statement of Verification, Declaration of Value, legalisation, apostille and certified translation.",{"children":"Read the admissions call, country-specific document page and enrolment instructions. Search for CIMEA, Statement of Comparability, Statement of Verification, Declaration of Value, legalisation, apostille and certified translation."}],["$","p","If the wording is unclear, contact the university using the exact programme, qualification country and intake. Save the written response before paying for a service.",{"children":"If the wording is unclear, contact the university using the exact programme, qualification country and intake. Save the written response before paying for a service."}]],"$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Exact degree and academic year",{"children":"Exact degree and academic year"}],["$","li","Country where the qualification was awarded",{"children":"Country where the qualification was awarded"}],["$","li","Admission-stage requirement",{"children":"Admission-stage requirement"}],["$","li","Final-enrolment requirement",{"children":"Final-enrolment requirement"}],["$","li","Visa or consular requirement",{"children":"Visa or consular requirement"}],["$","li","Accepted language and document format",{"children":"Accepted language and document format"}]]}],"$undefined","$undefined"]}]
1d:["$","section","2-What a Declaration of Value does",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"What a Declaration of Value does"}],[["$","p","The Declaration of Value provides information about a qualification in the education system where it was awarded. It is not itself an Italian degree and does not automatically create academic recognition.",{"children":"The Declaration of Value provides information about a qualification in the education system where it was awarded. It is not itself an Italian degree and does not automatically create academic recognition."}],["$","p","Procedures depend on the competent Italian mission and document jurisdiction. Follow its current instructions for appointments, originals, verification, translation and legalisation.",{"children":"Procedures depend on the competent Italian mission and document jurisdiction. Follow its current instructions for appointments, originals, verification, translation and legalisation."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","3-What CIMEA statements do",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"What CIMEA statements do"}],[["$","p","CIMEA provides credential-information services through its official platform. A statement can support an institution's evaluation of the level or authenticity of a qualification, depending on the service requested.",{"children":"CIMEA provides credential-information services through its official platform. A statement can support an institution's evaluation of the level or authenticity of a qualification, depending on the service requested."}],["$","p","Service names, fees, processing routes and required evidence can change. Use only the official CIMEA platform and order the service named by the receiving institution.",{"children":"Service names, fees, processing routes and required evidence can change. Use only the official CIMEA platform and order the service named by the receiving institution."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","4-Documents to organise before starting",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Documents to organise before starting"}],[["$","p","Prepare high-quality records that match across name, date and institution. If the university requests a translation or specific authentication, complete it through the accepted route.",{"children":"Prepare high-quality records that match across name, date and institution. If the university requests a translation or specific authentication, complete it through the accepted route."}]],"$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Final diploma or degree certificate",{"children":"Final diploma or degree certificate"}],["$","li","Complete transcript or marksheets",{"children":"Complete transcript or marksheets"}],["$","li","Passport identity page",{"children":"Passport identity page"}],["$","li","Name-change evidence where applicable",{"children":"Name-change evidence where applicable"}],["$","li","Certified translations when required",{"children":"Certified translations when required"}],["$","li","Verification or legalisation requested by the authority",{"children":"Verification or legalisation requested by the authority"}]]}],"$undefined","$undefined"]}]
20:["$","section","5-Avoid duplicate cost and delay",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Avoid duplicate cost and delay"}],[["$","p","Do not order both routes unless the official instructions require them. Check whether the requirement applies at application, after admission or only at final enrolment, and compare processing time with the real deadline.",{"children":"Do not order both routes unless the official instructions require them. Check whether the requirement applies at application, after admission or only at final enrolment, and compare processing time with the real deadline."}],["$","p","Keep receipts, reference numbers and digital copies. Never give a third party your portal password or one-time code.",{"children":"Keep receipts, reference numbers and digital copies. Never give a third party your portal password or one-time code."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
