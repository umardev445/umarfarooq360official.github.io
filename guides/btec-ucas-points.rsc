1f:["$","section","2-BTEC National Diploma points",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"BTEC National Diploma points"}],[["$","p","The Diploma has its own two-grade scale. In particular, D*D is an exact 104-point qualification. It would be incorrect to say that no single qualification can give 104 merely because the Extended Diploma has no exact 104-point band.",{"children":"The Diploma has its own two-grade scale. In particular, D*D is an exact 104-point qualification. It would be incorrect to say that no single qualification can give 104 merely because the Extended Diploma has no exact 104-point band."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"National Diploma grade-to-tariff lookup","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"National Diploma grade-to-tariff lookup"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Grade",{"scope":"col","children":"Grade"}],["$","th","UCAS points",{"scope":"col","children":"UCAS points"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"D*D*"}],["$","td","1",{"children":"112"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"D*D"}],["$","td","1",{"children":"104"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"DD"}],["$","td","1",{"children":"96"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"DM"}],["$","td","1",{"children":"80"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"MM"}],["$","td","1",{"children":"64"}]],"$undefined"]}],["$","tr","5",{"children":[[["$","th","0",{"scope":"ro