20:["$","section","3-BTEC National Extended Certificate points",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"BTEC National Extended Certificate points"}],[["$","p","An Extended Certificate can form part of a mixed programme alongside A levels. Add the separate qualifications only when they are accepted together and do not duplicate study. A Foundation Diploma or a differently named Certificate needs its own lookup.",{"children":"An Extended Certificate can form part of a mixed programme alongside A levels. Add the separate qualifications only when they are accepted together and do not duplicate study. A Foundation Diploma or a differently named Certificate needs its own lookup."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"National Extended Certificate grade-to-tariff lookup","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"National Extended Certificate grade-to-tariff lookup"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Grade",{"scope":"col","children":"Grade"}],["$","th","UCAS points",{"scope":"col","children":"UCAS points"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"D*"}],["$","td","1",{"children":"56"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"D"}],["$","td","1",{"children":"48"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"M"}],["$","td","1",{"children":"32"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"P"}],["$","td","1",{"children":"16"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://qualifications.pearson.com/en/support/support-topics/understanding-our-qualifications/comparing-btec-to-other-qualifications/btec-ucas-points.html","target":"_blank","rel":"noreferrer","children":"Pearson: BTEC and A-level tariff comparison"}]]}]],"$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"An Extended Certificate at D contributes 48. Two A levels at B and C contribute 40 + 32. Their arithmetic total is 120, provided the offer permits that qualification mix."}]]}],"$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","4-Convert points without claiming subject equivalence",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Convert points without claiming subject equivalence"}],[["$","p","Equal tariff totals do not make different subjects interchangeable. An engineering offer might name Mathematics, while a health-related course may name specific units. A vocational route can be accepted in its own right without being treated as the same academic preparation as every A-level combination.",{"children":"Equal tariff totals do not make different subjects interchangeable. An engineering offer might name Mathematics, while a health-related course may name specific units. A vocational route can be accepted in its own right without being treated as the same academic preparation as every A-level combination."}],["$","p","Copy the course wording into a comparison worksheet: exact award, accepted subject, required grade, compulsory units, additional qualification and any GCSE requirement. Ask admissions a precise question if one field is unclear.",{"children":"Copy the course wording into a comparison worksheet: exact award, accepted subject, required grade, compulsory units, additional qualification and any GCSE requirement. Ask admissions a precise question if one field is unclear."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L26",null,{"id":"guides/btec-ucas-points:section-5","title":"Check your progress","items":["Full qualification title and family recorded.","BTEC subject and required units checked.","Mixed qualifications explicitly permitted.","Any named A-level or GCSE condition retained."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Convert points without claiming subject equivalence","children":[["$","$L4","/tools/ucas-points-calculator/",{"href":"/tools/ucas-points-calculator/","children":["Add a mixed qualification total",["$","$L5",null,{"ref":"$unde