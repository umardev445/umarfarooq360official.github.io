1e:["$","section","1-BTEC National Extended Diploma points",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"BTEC National Extended Diploma points"}],[["$","p","Use this table for the named Level 3 National Extended Diploma family. Do not apply a three-grade result to a two-A-level-sized Diploma. The tariff describes qualification value; a course may still specify the BTEC subject, mandatory units or particular grades.",{"children":"Use this table for the named Level 3 National Extended Diploma family. Do not apply a three-grade result to a two-A-level-sized Diploma. The tariff describes qualification value; a course may still specify the BTEC subject, mandatory units or particular grades."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Extended Diploma grade-to-tariff lookup","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Extended Diploma grade-to-tariff lookup"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Grade",{"scope":"col","children":"Grade"}],["$","th","UCAS points",{"scope":"col","children":"UCAS points"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"D*D*D*"}],["$","td","1",{"children":"168"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"D*D*D"}],["$","td","1",{"children":"160"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"D*DD"}],["$","td","1",{"children":"152"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"DDD"}],["$","td","1",{"children":"144"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"DDM"}],["$","td","1",{"ch