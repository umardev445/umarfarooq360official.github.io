17:T41e,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How many UCAS points is DMM?","acceptedAnswer":{"@type":"Answer","text":"DMM in a BTEC National Extended Diploma is 112 points under the table shown. A different award title must be checked separately."}},{"@type":"Question","name":"Is D*D worth 104 points?","acceptedAnswer":{"@type":"Answer","text":"Yes, in the National Diploma table shown. D*D and a three-grade Extended Diploma result refer to different qualification sizes."}},{"@type":"Question","name":"Do all BTECs have UCAS points?","acceptedAnswer":{"@type":"Answer","text":"Do not assume so. Check the level, full title and current tariff entry. Level 2 and Level 3 are not interchangeable."}},{"@type":"Question","name":"Can these tables calculate my final BTEC grade from unit marks?","acceptedAnswer":{"@type":"Answer","text":"No. These tables convert an overall qualification grade to tariff points. Unit assessment and award grading use the specification for that particular qualification."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide student-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/btec-ucas-points/\",\"name\":\"BTEC UCAS points: choose the right qualification size\",\"description\":\"Find BTEC UCAS points by qualification size and grade. Compare National Diploma, Extended Diploma and Extended Certificate with worked mixed-route examples.\",\"url\":\"https://aspirecompass.org/guides/btec-ucas-points/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://sche