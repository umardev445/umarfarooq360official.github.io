19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"For the applicable international-student route, Universitaly pre-enrolment is a separate step from university admission. The institution validates the request; the competent Italian diplomatic mission decides the visa. Validation does not guarantee a visa."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Follow your university’s pre-enrolment instructions, prepare consistent programme and identity details, then save the submitted request and monitor corrections."]}],"$undefined"]}],false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","What to do when the request is not yet validated",{"href":"#section-1","children":"What to do when the request is not yet validated"}],["$","a","Who handles each decision?",{"href":"#section-2","children":"Who handles each decision?"}],["$","a","Step 1: confirm that this route applies",{"href":"#section-3","children":"Step 1: confirm that this route applies"}],["$","a","Step 2: prepare the information once",{"href":"#section-4","children":"Step 2: prepare the information once"}],["$","a","Step 3: create your account and complete the request",{"href":"#section-5","children":"Step 3: create your account and complete the request"}],["$","a","Step 4: save proof and monitor corrections",{"href":"#section-6","children":"Step 4: save proof and monitor corrections"}],["$","a","Step 5: understand validation and the visa handoff",{"href":"#section-7","children":"Step 5: understand validation and the vi