21:["$","section","2-Step 1: confirm that this route applies",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Step 1: confirm that this route applies"}],[["$","p","Check the instructions for your citizenship, residence status, qualification and course. Do not copy the process of an EU applicant if you are a non-EU applicant living abroad.",{"children":"Check the instructions for your citizenship, residence status, qualification and course. Do not copy the process of an EU applicant if you are a non-EU applicant living abroad."}],["$","p","Before using the portal, ask the university when it expects you to submit and whether an admission condition must be completed first. The institution's intake-specific instructions should resolve the timing, not a general video.",{"children":"Before using the portal, ask the university when it expects you to submit and whether an admission condition must be completed first. The institution's intake-specific instructions should resolve the timing, not a general video."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","3-Step 2: prepare the information once",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Step 2: prepare the information once"}],[["$","p","Use a working checklist so that the university application and pre-enrolment request describe the same person and programme. Check scan quality before starting.",{"children":"Use a working checklist so that the university application and pre-enrolment request describe the same person and programme. Check scan quality before starting."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Preparation checklist: requirements depend on your institution","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Preparation checklist: requirements depend on your institution"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Item",{"scope":"col","children":"Item"}],["$","th","Check before entering it",{"scope":"col","children":"Check before entering it"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Identity"}],["$","td","1",{"children":"Passport spelling, date of birth and document validity"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"University/course"}],["$","td","1",{"children":"Correct institution, campus, degree and academic year"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Qualification"}],["$","td","1",{"children":"Documents and translation format requested by the university"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Admission evidence"}],["$","td","1",{"children":"Offer and any unresolved conditions"}]],"$undefined"]}],