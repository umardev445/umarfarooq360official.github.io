23:["$","section","4-Step 3: create your account and complete the request",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Step 3: create your account and complete the request"}],[["$","p","Start from Universitaly's official website and follow its registration/login link. Record your credentials securely. Do not share a login with anyone claiming they can guarantee validation.",{"children":"Start from Universitaly's official website and follow its registration/login link. Record your credentials securely. Do not share a login with anyone claiming they can guarantee validation."}],["$","p","Choose the pre-enrolment route and follow the current form. Compare course names carefully when similar names appear. Upload the documents agreed with your institution and review the completed request before submission. Portal labels can change; use university help when the screen differs from an old tutorial.",{"children":"Choose the pre-enrolment route and follow the current form. Compare course names carefully when similar names appear. Upload the documents agreed with your institution and review the completed request before submission. Portal labels can change; use university help when the screen differs from an old tutorial."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","5-Step 4: save proof and monitor corrections",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Step 4: save proof and monitor corrections"}],[["$","p","After submitting, retain the application reference and any downloadable receipt. Check the portal and university email for requests to correct or supplement documents.",{"children":"After submitting, retain the application reference and any downloadable receipt. Check the portal and university email for requests to correct or supplement documents."}],["$","p","A request for correction is a task to resolve, not a reason to create several conflicting applications. Describe the precise issue to the institution: application reference, course, field or document affected and the message displayed. Never include your password in a support email.",{"children":"A request for correction is a task to resolve, not a reason to create several conflicting applications. Describe the precise issue to the institution: application reference, course, field or document affected and the message displayed. Never include your password in a support email."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","6-Step 5: understand validation and the visa handoff",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Step 5: understand validation and the visa handoff"}],[["$","p","Universitaly explains that the institution validates a positively assessed request for the relevant diplomatic mission. This does not give the applicant a right to a visa. Use the mission's current requirements for the next stage.",{"children":"Universitaly explains that the institution validates a positively assessed request for the relevant diplomatic mission. This does not give the applicant a right to a visa. Use the mission's current requirements for the next stage."}],["$","p","Do not make non-refundable travel commitments solely because a portal status changed. Also check whether enrolment requires original qualifications or further verification after arrival. There is no universal guaranteed validation duration; request an update from the institution if a stated deadline is approaching.",{"children":"Do not make non-refundable travel commitments solely because a portal status changed. Also check whether enrolment requires original qualifications or further verification after arrival. There is no universal guaranteed validation duration; request an update from the institution if a stated deadline is approaching."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","7-Your final consistency check",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Your final consistency check"}],[["$","p","Compare the university offer, submitted pre-enrolment request and visa file side by side. Correct material differences using the authorised route before relying on the documents.",{"children":"Compare the university offer, submitted pre-enrolment request and visa file side by side. Correct material differences using the authorised route before relying on the documents."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Same passport identity.",{"children":"Same passport identity."}],["$","li","Same programme, institution and intake.",{"children":"Same programme, institution and intake."}],["$","li","Required conditions completed or clearly recorded.",{"children":"Required conditions completed or clearly recorded."}],["$","li","Latest receipt and university messages saved.",{"children":"Latest receipt and university messages saved."}],["$","li","Visa checklist taken from the competent mission.",{"children":"Visa checklist taken from the competent mission."}],["$","li","University arrival/enrolment tasks recorded separately.",{"children":"University arrival/enrolment tasks recorded separately."}]]}],"$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Your final consistency check","children":[["$","$L4","/guides/italy-student-visa-pakistan/",{"href":"/guides/italy-student-visa-pakistan/","children":["Visa planning for Pakistan",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/cimea-vs-declaration-of-value-italy/",{"href":"/guides/cimea-vs-declaration-of-value-italy/","children":["CIMEA vs Declaration of Value",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
