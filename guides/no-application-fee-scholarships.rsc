1c:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Many major scholarship applications do not charge a scholarship form fee, but a connected university, test, document, visa or deposit cost may still apply. This guide shows how to verify every payment before you apply."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Start with the comparison or checklist below, then open the current instructions for your exact programme or route."]}],"$undefined"]}],["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Check the complete cost of applying",{"href":"#section-1","children":"Check the complete cost of applying"}],["$","a","Separate the scholarship fee from the university fee",{"href":"#section-2","children":"Separate the scholarship fee from the university fee"}],["$","a","Use official programmes as your starting point",{"href":"#section-3","children":"Use official programmes as your starting point"}],["$","a","A four-step payment verification",{"href":"#section-4","children":"A four-step payment verification"}],["$","a","How fee waivers work",{"href":"#section-5","children":"How fee waivers work"}],["$","a","Build a zero-surprise application budget",{"href":"#section-6","children":"Build a zero-surprise application budget"}],["$","a","Recognise a scholarship payment scam",{"href":"#section-7","children":"Recognise a scholarship payment scam"}],["$","a","No-fee strategy for applicants with limited budgets",{"href":"#section-8","children":"No-fee strategy for applicants with limited budgets"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Check the complete cost of applying",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Check the complete cost of applying"}],[["$","p","A missing fee statement is not proof that a process is free.",{"children":"A missing fee statement is not proof that a process is free."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Free form versus other costs","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Free form versus other costs"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Cost",{"scope":"col","children":"Cost"}],["$","th","Who confirms it?",{"scope":"col","children":"Who confirms it?"}],["$","th","Record before paying",{"scope":"col","children":"Record before paying"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Scholarship form"}],["$","td","1",{"children":"Scholarship owner"}],["$","td","2",{"children":"Free / fee / waiver / not confirmed"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"University application"}],["$","td","1",{"children":"University admissions"}],["$","td","2",{"children":"Separate amount and official payment route"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Tests and documents"}],["$","td","1",{"children":"Test provider and issuing authorities"}],["$","td","2",{"children":"Required evidence and preparation costs"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Visa / travel / deposit"}],["$","td","1",{"children":"Mission, transport and housing provider"}],["$","td","2",{"children":"Timing, refund terms and self-funded costs"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined",["$","$L1e",null,{"id":"guides/no-application-fee-scholarships:section-1","title":"Check your progress","items":["Open the official application route.","Check every connected portal for fees.","Request a published waiver if eligible.","Record uncovered costs before paying."]}],"$undefined"]}],"$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}],false,"$L26","$L27"]}],"$L28"]}]
1d:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","scholarships",{"href":"/scholarships/","children":[["$","span",null,{"children":"International funding"}],["$","h3",null,{"children":"Scholarships for international students in 2026–2027"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$13:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/scholarship-application",{"href":"/guides/scholarship-application/","children":[["$","span",null,{"children":"Application guide"}],["$","h3",null,{"children":"How to apply for international scholarships step by step"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$13:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/scholarships-for-pakistani-students",{"href":"/guides/scholarships-for-pakistani-students/","children":[["$","span",null,{"children":"Pakistan applicant guide"}],["$","h3",null,{"children":"Fully funded scholarships for Pakistani students in 2027"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$13:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","legal",{"href":"/legal/","children":[["$","span",null,{"children":"Legal and safety centre"}],["$","h3",null,{"children":"AspireCompass policies, disclaimers and opportunity safety"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$13:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
1f:["$","section","1-Separate the scholarship fee from the university fee",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Separate the scholarship fee from the university fee"}],[["$","p","A scholarship portal can be free while the university admission route charges a separate application fee. The opposite can also happen when scholarship consideration is automatic with admission. Map every required portal and write the owner and payment beside it.",{"children":"A scholarship portal can be free while the university admission route charges a separate application fee. The opposite can also happen when scholarship consideration is automatic with admission. Map every required portal and write the owner and payment beside it."}],["$","p","Also separate application charges from normal preparation costs: language tests, transcripts, certification, translations, passports, visa fees, medical checks, deposits and travel may occur even when scholarship submission is free.",{"children":"Also separate application charges from normal preparation costs: language tests, transcripts, certification, translations, passports, visa fees, medical checks, deposits and travel may occur even when scholarship submission is free."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","2-Use official programmes as your starting point",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Use official programmes as your starting point"}],[["$","p","Government and consortium programmes such as Chevening, Commonwealth, Erasmus Mundus and DAAD publish their application routes openly. KAUST publishes its graduate admissions process and fellowship information. Check each current portal for fee wording and then check the connected university or course separately.",{"children":"Government and consortium programmes such as Chevening, Commonwealth, Erasmus Mundus and DAAD publish their application routes openly. KAUST publishes its graduate admissions process and fellowship information. Check each current portal for fee wording and then check the connected university or course separately."}],["$","p","AspireCompass does not label an application permanently fee-free because fees and routes can change. The official page at the time of submission is the only reliable confirmation.",{"children":"AspireCompass does not label an application permanently fee-free because fees and routes can change. The official page at the time of submission is the only reliable confirmation."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","3-A four-step payment verification",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"A four-step payment verification"}],[["$","p","Never begin with a payment link sent by private message. Reach the programme through its official domain, open the current application instructions, identify every required portal and search each official fee page. If the wording is unclear, ask the institution through a published contact channel.",{"children":"Never begin with a payment link sent by private message. Reach the programme through its official domain, open the current application instructions, identify every required portal and search each official fee page. If the wording is unclear, ask the institution through a published contact channel."}]],"$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Confirm the organisation and exact intake",{"children":"Confirm the organisation and exact intake"}],["$","li","List scholarship and admission portals separately",{"children":"List scholarship and admission portals separately"}],["$","li","Check official fee and waiver pages",{"children":"Check official fee and waiver pages"}],["$","li","Keep written confirmation of any waiver",{"children":"Keep written confirmation of any waiver"}]]}],"$undefined","$undefined"]}]
22:["$","section","4-How fee waivers work",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"How fee waivers work"}],[["$","p","Some universities offer need-based, country-based, event-based or programme-specific waivers. A waiver code from an unofficial forum may be invalid or misused. Follow the institution's published request process and never claim financial circumstances that are untrue.",{"children":"Some universities offer need-based, country-based, event-based or programme-specific waivers. A waiver code from an unofficial forum may be invalid or misused. Follow the institution's published request process and never claim financial circumstances that are untrue."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","5-Build a zero-surprise application budget",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Build a zero-surprise application budget"}],[["$","p","For every programme, record the scholarship form fee, university fee, test costs, document costs, passport, visa, health requirements, deposit, travel and the timing of the first stipend. Mark each item covered, waived, refundable or self-funded.",{"children":"For every programme, record the scholarship form fee, university fee, test costs, document costs, passport, visa, health requirements, deposit, travel and the timing of the first stipend. Mark each item covered, waived, refundable or self-funded."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","6-Recognise a scholarship payment scam",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Recognise a scholarship payment scam"}],[["$","p","Warning signs include guaranteed selection, urgency to pay a private person, requests for cryptocurrency or gift cards, a look-alike domain, interviews conducted only through informal chat and demands for passwords or one-time codes.",{"children":"Warning signs include guaranteed selection, urgency to pay a private person, requests for cryptocurrency or gift cards, a look-alike domain, interviews conducted only through informal chat and demands for passwords or one-time codes."}],["$","p","A legitimate fee should appear in the official process and use a traceable institutional payment system. Even then, confirm what the fee covers and whether it is refundable before paying.",{"children":"A legitimate fee should appear in the official process and use a traceable institutional payment system. Even then, confirm what the fee covers and whether it is refundable before paying."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","7-No-fee strategy for applicants with limited budgets",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"No-fee strategy for applicants with limited budgets"}],[["$","p","Prioritise strong-fit programmes with confirmed affordable processes, request official waivers early and avoid unnecessary repeated tests. A smaller, verified shortlist is safer than applying to dozens of unclear opportunities because a social post calls them free.",{"children":"Prioritise strong-fit programmes with confirmed affordable processes, request official waivers early and avoid unnecessary repeated tests. A smaller, verified shortlist is safer than applying to dozens of unclear opportunities because a social post calls them free."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://www.chevening.org/scholarships/",{"href":"https://www.chevening.org/scholarships/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Chevening Scholarships"}],["$","span",null,{"children":"Official application route"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://cscuk.fcdo.gov.uk/scholarships/commonwealth-masters-scholarships/",{"href":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-masters-scholarships/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Commonwealth Master's Scholarships"}],["$","span",null,{"children":"Official application and nomination process"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$26:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://erasmus-plus.ec.europa.eu/opportunities/individuals/students/erasmus-mundus-joint-masters",{"href":"https://erasmus-plus.ec.europa.eu/opportunities/individuals/students/erasmus-mundus-joint-masters","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Erasmus Mundus Joint Masters"}],["