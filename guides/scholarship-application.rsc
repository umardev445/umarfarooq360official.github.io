23:["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A practical application worksheet","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A practical application worksheet"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Task",{"scope":"col","children":"Task"}],["$","th","Owner / evidence",{"scope":"col","children":"Owner / evidence"}],["$","th","Status to record",{"scope":"col","children":"Status to record"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Eligibility audit"}],["$","td","1",{"children":"Applicant; current official rules"}],["$","td","2",{"children":"Researching / confirmed / unclear"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Admission"}],["$","td","1",{"children":"University; degree application"}],["$","td","2",{"children":"Preparing / submitted / decision"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Scholarship / nomination"}],["$","td","1",{"children":"Award and nominating body"}],["$","td","2",{"children":"Preparing / submitted / decision"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Documents and references"}],["$","td","1",{"children":"Applicant and issuing/referee authority"}],["$","td","2",{"children":"Requested / received / uploaded"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Visa and enrolment"}],["$","td","1",{"children":"Competent mission and university"}],["$","td","2",{"children":"After the applicable prior steps"}]],"$undefined"]}]]}]]}]}]
24:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Build one tracker for separate applications","children":[["$","$L4","/guides/scholarship-cv/",{"href":"/guides/scholarship-cv/","children":["Prepare a CV",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/statement-of-purpose/",{"href":"/guides/statement-of-purpose/","children":["Write an SOP",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/recommendation-letter/",{"href":"/guides/recommendation-letter/","children":["Plan references",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
25:["$","section","2-What a strong scholarship application must prove",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"What a strong scholarship application must prove"}],[["$","p","A scholarship committee is normally deciding more than whether you have good grades. It may assess eligibility, academic or professional readiness, alignment with the award's purpose, leadership or service, the realism of your study plan and the contribution you could make after the programme. The exact criteria vary, so the official call must shape every application.",{"children":"A scholarship committee is normally deciding more than whether you have good grades. It may assess eligibility, academic or professional readiness, alignment with the award's purpose, leadership or service, the realism of your study plan and the contribution you could make after the programme. The exact criteria vary, so the official call must shape every application."}],["$","p","Treat the application as an evidence file. Your form, CV, essays, references and interview should support the same overall direction without repeating identical sentences. A reviewer should be able to see what you have done, what you learned, why this programme fits and what the funding would make possible.",{"children":"Treat the application as an evidence file. Your form, CV, essays, references and interview should support the same overall direction without repeating identical sentences. A reviewer should be able to see what you have done, what you learned, why this programme fits and what the funding would make possible."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Eligibility: you meet every non-negotiable rule",{"children":"Eligibility: you meet every non-negotiable rule"}],["$","li","Readiness: your record supports the proposed level and field",{"children":"Readiness: your record supports the proposed level and field"}],["$","li","Fit: your goals connect to the programme and scholarship purpose",{"children":"Fit: your goals connect to the programme and scholarship purpose"}],["$","li","Evidence: important claims are supported by specific examples",{"children":"Evidence: important claims are supported by specific examples"}],["$","li","Trajectory: your next steps are ambitious but believable",{"children":"Trajectory: your next steps are ambitious but believable"}]]}],"$undefined","$undefined","$undefined"]}]
26:["$","section","3-Step 1: define the opportunity you can actually use",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Step 1: define the opportunity you can actually use"}],[["$","p","Before searching, write a one-page target profile. Include your citizenship and residence, current qualification, intended degree level and field, preferred intake, possible destinations, language-test position, work experience and maximum personal budget. These facts prevent a famous scholarship from becoming a poor fit.",{"children":"Before searching, write a one-page target profile. Include your citizenship and residence, current qualification, intended degree level and field, preferred intake, possible destinations, language-test position, work experience and maximum personal budget. These facts prevent a famous scholarship from becoming a poor fit."}],["$","p","Decide what funding you need. Fully funded does not always mean that every cost is covered. Depending on the award, an applicant may still need money for tests, document certification, visa-related expenses, deposits, dependants or costs above the stipend. Confirm the current benefit list instead of relying on the label alone.",{"children":"Decide what funding you need. Fully funded does not always mean that every cost is covered. Depending on the award, an applicant may still need money for tests, document certification, visa-related expenses, deposits, dependants or costs above the stipend. Confirm the current benefit list instead of relying on the label alone."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Degree level and intended start year",{"children":"Degree level and intended start year"}],["$","li","Fields and courses you can justify",{"children":"Fields and courses you can justify"}],["$","li","Countries you would genuinely accept",{"children":"Countries you would genuinely accept"}],["$","li","Minimum funding required",{"children":"Minimum funding required"}],["$","li","Tests or documents that need preparation",{"children":"Tests or documents that need preparation"}],["$","li","Career outcome the study should support",{"children":"Career outcome the study should support"}]]}],"$undefined","$undefined","$undefined"]}]
27:["$","section","4-Step 2: separate scholarship, admission and visa processes",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Step 2: separate scholarship, admission and visa processes"}],[["$","p","International funding can involve two or three connected applications. Some scholarships require a university offer before the funding application. Others let you apply for funding first or submit scholarship and admission forms together. Erasmus Mundus applicants, for example, apply directly to the institution running the selected master's programme, while other awards may use separate scholarship and university portals.",{"children":"International funding can involve two or three connected applications. Some scholarships require a university offer before the funding application. Others let you apply for funding first or submit scholarship and admission forms together. Erasmus Mundus applicants, for example, apply directly to the institution running the selected master's programme, while other awards may use separate scholarship and university portals."}],["$","p","Create a simple process map for every opportunity: who receives the scholarship application, who receives the university application, which offer is conditional or unconditional and whether any later immigration requirement affects your plan. Never assume that success at one stage automatically completes the others.",{"children":"Create a simple process map for every opportunity: who receives the scholarship application, who receives the university application, which offer is conditional or unconditional and whether any later immigration requirement affects your plan. Never assume that success at one stage automatically completes the others."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Scholarship portal and scholarship deadline",{"children":"Scholarship portal and scholarship deadline"}],["$","li","University portal and admission deadline",{"children":"University portal and admission deadline"}],["$","li","Required order of the two applications",{"children":"Required order of the two applications"}],["$","li","Offer type required by the funder",{"children":"Offer type required by the funder"}],["$","li","Language, financial and visa evidence required later",{"children":"Language, financial and visa evidence required later"}]]}],"$undefined","$undefined","$undefined"]}]
28:["$","section","5-Step 3: run an eligibility audit before writing",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Step 3: run an eligibility audit before writing"}],[["$","p","Read the current official eligibility page line by line and create a yes, no or needs-confirmation checklist. Hard rules can include nationality, residence, age, graduation date, degree subject, grade, work experience, return requirements or restrictions linked to previous funding. A persuasive essay cannot repair a failed mandatory condition.",{"children":"Read the current official eligibility page line by line and create a yes, no or needs-confirmation checklist. Hard rules can include nationality, residence, age, graduation date, degree subject, grade, work experience, return requirements or restrictions linked to previous funding. A persuasive essay cannot repair a failed mandatory condition."}],["$","p","Do not convert a condition into a guess. If the wording is unclear, contact the programme through its published channel and keep the written reply. Save a copy of the rule you relied on, because webpages and yearly calls can change.",{"children":"Do not convert a condition into a guess. If the wording is unclear, contact the programme through its published channel and keep the written reply. Save a copy of the rule you relied on, because webpages and yearly calls can change."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Nationality and residency",{"children":"Nationality and residency"}],["$","li","Degree level, subject and completion date",{"children":"Degree level, subject and completion date"}],["$","li","Minimum grade or recognised equivalence",{"children":"Minimum grade or recognised equivalence"}],["$","li","Work, research or leadership experience",{"children":"Work, research or leadership experience"}],["$","li","Language requirement or accepted alternative",{"children":"Language requirement or accepted alternative"}],["$","li","Previous scholarship and return obligations",{"children":"Previous scholarship and return obligations"}]]}],"$undefined","$undefined","$undefined"]}]
29:["$","section","6-Step 4: verify the opportunity on the primary source",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Step 4: verify the opportunity on the primary source"}],[["$","p","Use blogs, videos and databases for discovery, then confirm the opportunity on the scholarship owner, government, university or programme website. Check the intake year, eligible countries, funding, application route and deadline in the programme's stated time zone. A copied announcement can remain online after the official call has closed or changed.",{"children":"Use blogs, videos and databases for discovery, then confirm the opportunity on the scholarship owner, government, university or programme website. Check the intake year, eligible countries, funding, application route and deadline in the programme's stated time zone. A copied announcement can remain online after the official call has closed or changed."}],["$","p","Be cautious when someone promises guaranteed selection, requests payment to secure an award or asks you to send sensitive documents through an unrelated account. Legitimate programmes may have application or institutional fees, but those charges should be stated on an official source and paid through an authorised process.",{"children":"Be cautious when someone promises guaranteed selection, requests payment to secure an award or asks you to send sensitive documents through an unrelated account. Legitimate programmes may have application or institutional fees, but those charges should be stated on an official source and paid through an authorised process."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Official programme owner and current call",{"children":"Official programme owner and current call"}],["$","li","Correct intake or academic year",{"children":"Correct intake or academic year"}],["$","li","Application portal under an expected domain",{"children":"Application portal under an expected domain"}],["$","li","Published funding and eligibility details",{"children":"Published funding and eligibility details"}],["$","li","Official contact and privacy information",{"children":"Official contact and privacy information"}]]}],"$undefined","$undefined","$undefined"]}]
2a:["$","section","7-Step 5: build an eligibility-first shortlist",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Step 5: build an eligibility-first shortlist"}],[["$","p","A shortlist of six carefully selected opportunities is often more useful than a spreadsheet of fifty names. Group options as strong fit, possible fit and aspirational. Record why each opportunity belongs in its group, not just its prestige or funding amount.",{"children":"A shortlist of six carefully selected opportunities is often more useful than a spreadsheet of fifty names. Group options as strong fit, possible fit and aspirational. Record why each opportunity belongs in its group, not just its prestige or funding amount."}],["$","p","Track each university and scholarship separately when both applications are required. Include the official link, deadline with time zone, status, missing documents, referee progress and next action. This reduces duplicated work and prevents a strong application from failing through poor administration.",{"children":"Track each university and scholarship separately when both applications are required. Include the official link, deadline with time zone, status, missing documents, referee progress and next action. This reduces duplicated work and prevents a strong application from failing through poor administration."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Programme and official source",{"children":"Programme and official source"}],["$","li","Fit decision with a written reason",{"children":"Fit decision with a written reason"}],["$","li","Separate admission and funding deadlines",{"children":"Separate admission and funding deadlines"}],["$","li","Required essays, documents and references",{"children":"Required essays, documents and references"}],["$","li","Current status and next action",{"children":"Current status and next action"}],["$","li","Date on which the information was verified",{"children":"Date on which the information was verified"}]]}],"$undefined","$undefined","$undefined"]}]
2b:["$","section","8-Step 6: prepare a master document folder",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Step 6: prepare a master document folder"}],[["$","p","Create clean master copies of your passport or identity document, certificates, transcripts, grading explanation, CV and relevant test results. Some programmes may request certified copies, official translations, a research proposal, portfolio, employment proof, financial information or medical documents. Do not obtain costly certification until the current instructions confirm what is required and at which stage.",{"children":"Create clean master copies of your passport or identity document, certificates, transcripts, grading explanation, CV and relevant test results. Some programmes may request certified copies, official translations, a research proposal, portfolio, employment proof, financial information or medical documents. Do not obtain costly certification until the current instructions confirm what is required and at which stage."}],["$","p","Use consistent names and dates across every document. If your passport, transcript and degree use different spellings, follow the programme's instructions for explaining the difference. Scan complete pages clearly, use sensible file names and keep each upload within the permitted file type and size.",{"children":"Use consistent names and dates across every document. If your passport, transcript and degree use different spellings, follow the programme's instructions for explaining the difference. Scan complete pages clearly, use sensible file names and keep each upload within the permitted file type and size."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Identity and nationality evidence",{"children":"Identity and nationality evidence"}],["$","li","Degrees, transcripts and grading information",{"children":"Degrees, transcripts and grading information"}],["$","li","Language or medium-of-instruction evidence where accepted",{"children":"Language or medium-of-instruction evidence where accepted"}],["$","li","Scholarship CV or required application résumé",{"children":"Scholarship CV or required application résumé"}],["$","li","Essays, SOP or research proposal",{"children":"Essays, SOP or research proposal"}],["$","li","Reference details and letters when requested",{"children":"Reference details and letters when requested"}],["$","li","Programme-specific supporting documents",{"children":"Programme-specific supporting documents"}]]}],"$undefined","$undefined","$undefined"]}]
2c:["$","section","9-Step 7: create an evidence bank before drafting essays",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"Step 7: create an evidence bank before drafting essays"}],[["$","p","List eight to twelve examples from education, research, work, leadership, volunteering and difficult decisions. For each example, record the context, your responsibility, the action you personally took, the result and what you learned. This becomes the source material for essays and interviews.",{"children":"List eight to twelve examples from education, research, work, leadership, volunteering and difficult decisions. For each example, record the context, your responsibility, the action you personally took, the result and what you learned. This becomes the source material for essays and interviews."}],["$","p","Map the strongest examples to the published selection criteria. One detailed example showing judgement and measurable contribution is stronger than several claims that you are passionate, hardworking or a leader. Use the same true experience across documents when relevant, but adjust the emphasis to answer each prompt.",{"children":"Map the strongest examples to the published selection criteria. One detailed example showing judgement and measurable contribution is stronger than several claims that you are passionate, hardworking or a leader. Use the same true experience across documents when relevant, but adjust the emphasis to answer each prompt."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Situation or problem",{"children":"Situation or problem"}],["$","li","Your individual responsibility",{"children":"Your individual responsibility"}],["$","li","Decision, method or action",{"children":"Decision, method or action"}],["$","li","Result, scale or observable change",{"children":"Result, scale or observable change"}],["$","li","Reflection and connection to the scholarship",{"children":"Reflection and connection to the scholarship"}]]}],"$undefined","$undefined","$undefined"]}]
2d:["$","section","10-Step 8: write prompt-specific essays",{"className":"article-section","id":"section-11","children":[["$","h2",null,{"children":"Step 8: write prompt-specific essays"}],[["$","p","Copy every essay question into a planning document and divide it into separate tasks. A question may ask why this course, why this scholarship, what you have already done and how you will create impact. Missing one part can make a polished response incomplete.",{"children":"Copy every essay question into a planning document and divide it into separate tasks. A question may ask why this course, why this scholarship, what you have already done and how you will create impact. Missing one part can make a polished response incomplete."}],["$","p","Build a direct argument: answer the question, provide relevant evidence, explain the significance and connect it to a realistic next step. Research programme features that genuinely support your goal. Avoid generic praise, copied mission statements and a single unchanged essay sent to every funder.",{"children":"Build a direct argument: answer the question, provide relevant evidence, explain the significance and connect it to a realistic next step. Research programme features that genuinely support your goal. Avoid generic praise, copied mission statements and a single unchanged essay sent to every funder."}],["$","p","Check the programme's current rules on AI and authorship. Where tools are permitted, they may assist with planning or language review, but the experiences, reasoning and final claims must remain accurate and genuinely yours.",{"children":"Check the programme's current rules on AI and authorship. Where tools are permitted, they may assist with planning or language review, but the experiences, reasoning and final claims must remain accurate and genuinely yours."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2e:["$","section","11-Step 9: keep the CV, essays and references consistent",{"className":"article-section","id":"section-12","children":[["$","h2",null,{"children":"Step 9: keep the CV, essays and references consistent"}],[["$","p","Your application documents should complement one another. The CV provides a scan-friendly record, essays explain selected evidence and references offer an independent assessment. Dates, roles, degree names and results must agree across all three.",{"children":"Your application documents should complement one another. The CV provides a scan-friendly record, essays explain selected evidence and references offer an independent assessment. Dates, roles, degree names and results must agree across all three."}],["$","p","Choose referees for the relevant evidence they can discuss, not only for seniority. Ask early, explain the programme and deadline, and provide your current CV, goals, selection criteria and a short evidence sheet. Never pressure someone to sign a recommendation they cannot support.",{"children":"Choose referees for the relevant evidence they can discuss, not only for seniority. Ask early, explain the programme and deadline, and provide your current CV, goals, selection criteria and a short evidence sheet. Never pressure someone to sign a recommendation they cannot support."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Use the same accurate dates and role titles",{"children":"Use the same accurate dates and role titles"}],["$","li","Explain major claims consistently",{"children":"Explain major claims consistently"}],["$","li","Give each document a different purpose",{"children":"Give each document a different purpose"}],["$","li","Select referees who observed relevant work",{"children":"Select referees who observed relevant work"}],["$","li","Track whether the applicant or referee submits the letter",{"children":"Track whether the applicant or referee submits the letter"}]]}],"$undefined","$undefined","$undefined"]}]
2f:["$","section","12-Step 10: complete a technical submission review",{"className":"article-section","id":"section-13","children":[["$","h2",null,{"children":"Step 10: complete a technical submission review"}],[["$","p","Finish the substantive writing before the final day. Application portals can time out, reject a file or display answers differently after pasting. Review the full form in the portal, not only the draft stored on your computer.",{"children":"Finish the substantive writing before the final day. Application portals can time out, reject a file or display answers differently after pasting. Review the full form in the portal, not only the draft stored on your computer."}],["$","p","Submit early enough to recover from a technical problem. Save the confirmation page, application number and final documents. After submission, do not send revised material unless the programme permits updates or requests it.",{"children":"Submit early enough to recover from a technical problem. Save the confirmation page, application number and final documents. After submission, do not send revised material unless the programme permits updates or requests it."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Every mandatory field is complete",{"children":"Every mandatory field is complete"}],["$","li","Names, dates and contact details match official documents",{"children":"Names, dates and contact details match official documents"}],["$","li","Uploads open and use the required format",{"children":"Uploads open and use the required format"}],["$","li","Word and character limits are respected",{"children":"Word and character limits are respected"}],["$","li","Referee email addresses are correct",{"children":"Referee email addresses are correct"}],["$","li","Deadline and time zone are confirmed",{"children":"Deadline and time zone are confirmed"}],["$","li","Submission receipt is saved",{"children":"Submission receipt is saved"}]]}],"$undefined","$undefined","$undefined"]}]
30:["$","section","13-A practical backward application timeline",{"className":"article-section","id":"section-14","children":[["$","h2",null,{"children":"A practical backward application timeline"}],[["$","p","Work backwards from the earliest relevant deadline. The timeline below is a planning model, not a programme rule. Applicants needing a passport, language test, official translation or multiple references should begin earlier.",{"children":"Work backwards from the earliest relevant deadline. The timeline below is a planning model, not a programme rule. Applicants needing a passport, language test, official translation or multiple references should begin earlier."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Twelve to eight weeks before: verify eligibility, process and funding; create the shortlist",{"children":"Twelve to eight weeks before: verify eligibility, process and funding; create the shortlist"}],["$","li","Eight to six weeks before: request slow documents and approach referees",{"children":"Eight to six weeks before: request slow documents and approach referees"}],["$","li","Six to four weeks before: build the evidence bank, CV and first essay drafts",{"children":"Six to four weeks before: build the evidence bank, CV and first essay drafts"}],["$","li","Four to two weeks before: tailor programme fit and obtain feedback",{"children":"Four to two weeks before: tailor programme fit and obtain feedback"}],["$","li","Final two weeks: proofread, upload, test files and submit before the last day",{"children":"Final two weeks: proofread, upload, test files and submit before the last day"}],["$","li","After submission: save evidence, monitor official email and prepare for the next stage",{"children":"After submission: save evidence, monitor official email and prepare for the next stage"}]]}],"$undefined","$undefined","$undefined"]}]
31:["$","section","14-Additional checks for applicants from Pakistan",{"className":"article-section","id":"section-15","children":[["$","h2",null,{"children":"Additional checks for applicants from Pakistan"}],[["$","p","Pakistani applicants should confirm how the programme interprets local qualifications, grading scales and degree completion documents. Depending on the destination and stage, a programme may ask for HEC, IBCC, MOFA or another form of verification, attestation or equivalence. These requirements are not universal, so follow the scholarship, university and relevant authority instructions for the current intake.",{"children":"Pakistani applicants should confirm how the programme interprets local qualifications, grading scales and degree completion documents. Depending on the destination and stage, a programme may ask for HEC, IBCC, MOFA or another form of verification, attestation or equivalence. These requirements are not universal, so follow the scholarship, university and relevant authority instructions for the current intake."}],["$","p","Keep your name and date of birth consistent with your passport, explain CGPA or percentage using the issuing institution's official scale and arrange English translations only through an accepted process. If an application uses two portals, such as a scholarship authority and a university, confirm that both submissions are complete rather than assuming one transfers to the other.",{"children":"Keep your name and date of birth consistent with your passport, explain CGPA or percentage using the issuing institution's official scale and arrange English translations only through an accepted process. If an application uses two portals, such as a scholarship authority and a university, confirm that both submissions are complete rather than assuming one transfers to the other."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
32:["$","section","15-Common scholarship application mistakes",{"className":"article-section","id":"section-16","children":[["$","h2",null,{"children":"Common scholarship application mistakes"}],[["$","p","Competitive applications can fail before their strongest evidence is considered. Use this list as a final diagnostic rather than trying to compensate for an eligibility or process error with more elaborate writing.",{"children":"Competitive applications can fail before their strongest evidence is considered. Use this list as a final diagnostic rather than trying to compensate for an eligibility or process error with more elaborate writing."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Applying despite a failed mandatory eligibility rule",{"children":"Applying despite a failed mandatory eligibility rule"}],["$","li","Using an expired blog post instead of the current official call",{"children":"Using an expired blog post instead of the current official call"}],["$","li","Confusing university admission with scholarship selection",{"children":"Confusing university admission with scholarship selection"}],["$","li","Sending generic essays that do not answer the full prompt",{"children":"Sending generic essays that do not answer the full prompt"}],["$","li","Listing qualities without evidence or reflection",{"children":"Listing qualities without evidence or reflection"}],["$","li","Submitting inconsistent dates or achievements",{"children":"Submitting inconsistent dates or achievements"}],["$","li","Approaching referees too late",{"children":"Approaching referees too late"}],["$","li","Uploading unreadable, incomplete or incorrectly named files",{"children":"Uploading unreadable, incomplete or incorrectly named files"}],["$","li","Waiting until the final hours to submit",{"children":"Waiting until the final hours to submit"}],["$","li","Paying an unofficial agent for a guaranteed result",{"children":"Paying an unofficial agent for a guaranteed result"}]]}],"$undefined","$undefined","$undefined"]}]
33:["$","section","16-Final scholarship application checklist",{"className":"article-section","id":"section-17","children":[["$","h2",null,{"children":"Final scholarship application checklist"}],[["$","p","Complete one final review from the perspective of a reader who knows nothing about you. The application should be eligible, easy to navigate, internally consistent and specific enough that it could not be sent unchanged to a different programme.",{"children":"Complete one final review from the perspective of a reader who knows nothing about you. The application should be eligible, easy to navigate, internally consistent and specific enough that it could not be sent unchanged to a different programme."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Current official eligibility has been checked",{"children":"Current official eligibility has been checked"}],["$","li","Admission, scholarship and visa stages are understood",{"children":"Admission, scholarship and visa stages are understood"}],["$","li","Funding and uncovered costs are recorded",{"children":"Funding and uncovered costs are recorded"}],["$","li","Every prompt is answered with relevant evidence",{"children":"Every prompt is answered with relevant evidence"}],["$","li","CV, essays, form and references tell a consistent story",{"children":"CV, essays, form and references tell a consistent story"}],["$","li","Programme details and future plans are accurate",{"children":"Programme details and future plans are accurate"}],["$","li","All files meet the portal requirements",{"children":"All files meet the portal requirements"}],["$","li","The application was reviewed and submitted safely",{"children":"The application was reviewed and submitted safely"}]]}],"$undefined","$undefined","$undefined"]}]
34:["$","section","17-Move from research to a trackable application",{"className":"article-section","id":"section-18","children":[["$","h2",null,{"children":"Move from research to a trackable application"}],[["$","p","Turn every shortlisted award into a small project: verify eligibility, record the deadline, calculate academic readiness and prepare each writing document for that programme. The tools below keep those decisions connected.",{"children":"Turn every shortlisted award into a small project: verify eligibility, record the deadline, calculate academic readiness and prepare each writing document for that programme. The tools below keep those decisions connected."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Move from research to a trackable application","children":[["$","$L4","/matcher/",{"href":"/matcher/","children":["Find a scholarship match",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/deadline-calendar/",{"href":"/deadline-calendar/","children":["Track upcoming deadlines",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/gpa-cgpa-calculator/",{"href":"/tools/gpa-cgpa-calculator/","children":["Calculate GPA or CGPA",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/motivation-letter/",{"href":"/guides/motivation-letter/","children":["Write a motivation letter",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/scholarship-cv/",{"