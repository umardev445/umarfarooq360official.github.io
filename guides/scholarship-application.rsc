36:["$","details","What is the safest way to manage scholarship deadlines?",{"children":[["$","summary",null,{"children":["What is the safest way to manage scholarship deadlines?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Track the scholarship submission, university admission, nomination, reference and document deadlines separately. Save the official page and note the time zone rather than relying on a third-party date alone."}]]}]
