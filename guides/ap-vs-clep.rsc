24:["$","section","1-Credit and placement are different outcomes",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Credit and placement are different outcomes"}],[["$","p","Credit adds recognised academic credit under the institution's policy. Placement can let a student begin at a more advanced course level without necessarily awarding credit. A result that gives placement is not automatically a tuition saving or a reduction in graduation requirements.",{"children":"Credit adds recognised academic credit under the institution's policy. Placement can let a student begin at a more advanced course level without necessarily awarding credit. A result that gives placement is not automatically a tuition saving or a reduction in graduation requirements."}],["$","p","When reading a policy, record the exact exam, score threshold, credits, course equivalency and any limitations. A general statement that a college accepts AP or CLEP is less useful than the rule for the exam and degree you are considering.",{"children":"When reading a policy, record the exact exam, score threshold, credits, course equivalency and any limitations. A general statement that a college accepts AP or CLEP is less useful than the rule for the exam and degree you are considering."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Credit and placement are different outcomes","children":[["$","$L4","https://apstudents.collegeboard.org/getting-credit-placement/search-policies",{"href":"https://apstudents.collegeboard.org/getting-credit-placement/search-policies","children":["Official AP policy search",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://clep.collegeboard.org/clep-college-credit-policy-search",{"href":"https://clep.collegeboard.org/clep-college-credit-policy-search","children":["Official CLEP policy search",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
25:["$","section","2-You do not always need an AP course to take an AP exam",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"You do not always need an AP course to take an AP exam"}],[["$","p","College Board says an AP course is recommended but is not required to take an AP exam. Students studying independently must arrange registration with a school or test centre, and some subjects have additional portfolio or other requirements.",{"children":"College Board says an AP course is recommended but is not required to take an AP exam. Students studying independently must arrange registration with a school or test centre, and some subjects have additional portfolio or other requirements."}],["$","p","This matters when comparing routes for a homeschool student or someone whose school does not offer the subject. Do not reject AP solely because there is no local AP class; first check exam access and the subject's requirements.",{"children":"This matters when comparing routes for a homeschool student or someone whose school does not offer the subject. Do not reject AP solely because there is no local AP class; first check exam access and the subject's requirements."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://apstudents.collegeboard.org/help-center/can-i-take-ap-exam-if-i-havent-taken-ap-course",{"children":["",["$","a",null,{"href":"https://apstudents.collegeboard.org/help-center/can-i-take-ap-exam-if-i-havent-taken-ap-course","target":"_blank","rel":"noreferrer","children":"College Board: AP exams without an AP course"}]]}]]]}],"$undefined"]}]
26:["$","section","3-Use a college-policy worksheet before paying",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Use a college-policy worksheet before paying"}],[["$","p","Create one row per college and exam rather than assuming the first policy you find applies everywhere. Include your intended major because the same awarded credit can be useful as elective credit but not replace a required module.",{"children":"Create one row per college and exam rather than assuming the first policy you find applies everywhere. Include your intended major because the same awarded credit can be useful as elective credit but not replace a required module."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Fields for a college-credit decision worksheet","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Fields for a college-credit decision worksheet"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Record",{"scope":"col","children":"Record"}],["$","th","Why it matters",{"scope":"col","children":"Why it matters"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"College, degree and policy year"}],["$","td","1",{"children":"Rules can differ by institution and programme"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Exam and required score"}],["$","td","1",{"children":"Acceptance is exam-specific"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Credit or placement awarded"}],["$","td","1",{"children":"These are different outcomes"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Equivalent course / requirement"}],["$","td","1",{"children":"Shows whether it helps the intended degree"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Overlap and residency restrictions"}],["$","td","1",{"children":"Prevents double-counting or unusable credit"}]],"$undefined"]}],["$","tr","5",{"children":[[["$","th","0",{"scope":"row","children":"Official source and date checked"}],["$","td","1",{"children":"Makes the decision traceable"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
27:["$","section","4-Compare real savings rather than headline credit",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Compare real savings rather than headline credit"}],[["$","p","A hypothetical exam producing three accepted elective credits is not automatically worth three credits of cash savings. If tuition is charged at a flat full-time rate or the credits do not replace required study, the financial effect may differ. Record actual exam/administration costs and the degree requirement that would be displaced.",{"children":"A hypothetical exam producing three accepted elective credits is not automatically worth three credits of cash savings. If tuition is charged at a flat full-time rate or the credits do not replace required study, the financial effect may differ. Record actual exam/administration costs and the degree requirement that would be displaced."}],["$","p","For a useful scenario, ask: would these credits remove a required course, reduce a later paid credit load, or create timetable flexibility? Keep each potential benefit separate instead of promising that an exam will always shorten a degree.",{"children":"For a useful scenario, ask: would these credits remove a required course, reduce a later paid credit load, or create timetable flexibility? Keep each potential benefit separate instead of promising that an exam will always shorten a degree."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
28:["$","section","5-Course grades, exam scores and GPA are separate records",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Course grades, exam scores and GPA are separate records"}],[["$","p","A high-school AP course grade can contribute to the school's GPA under its weighting policy. An AP exam score is a different result used for college credit or placement. CLEP exam credit is also not a high-school course grade. Do not feed an exam score directly into a GPA calculator as though it were an A–F course grade.",{"children":"A high-school AP course grade can contribute to the school's GPA under its weighting policy. An AP exam score is a different result used for college credit or placement. CLEP exam credit is also not a high-school course grade. Do not feed an exam score directly into a GPA calculator as though it were an A–F course grade."}],["$","p","For GPA planning use the school's course record. For credit planning use the receiving college's actual award and requirement evaluation. This separation keeps the number useful for the decision it can actually support.",{"children":"For GPA planning use the school's course record. For credit planning use the receiving college's actual award and requirement evaluation. This separation keeps the number useful for the decision it can actually support."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2c",null,{"id":"guides/ap-vs-clep:section-6","title":"Check your progress","items":["Target college and degree identified.","Exam-specific policy and score threshold checked.","Credit versus placement distinguished.","Course equivalency and overlap rules recorded.","Costs and realistic degree benefit compared."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Course grades, exam scores and GPA are separate records","children":[["$","$L4","/guides/weighted-vs-unweighted-gpa/",{"href":"/guides/weighted-vs-unweighted-gpa/","children":["Understand weighted GPA",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/weighted-gpa-calculator/",{"href":"/tools/weighted-gpa-calculator/","children":["Use the weighted course calculator",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/quarter-to-semester-credits-calculator/",{"href":"/tools/quarter-to-semester-credits-calculator/","children":["Convert quarter/semester credit volume",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
