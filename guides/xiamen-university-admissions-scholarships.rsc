1c:["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Chinese Government Scholarship university route"}],["$","td","1",{"children":"1 December 2026–20 February 2027"}],["$","td","2",{"children":"This calendar does not govern Type A nomination"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Listed university / provincial routes"}],["$","td","1",{"children":"1 December 2026–30 April 2027"}],["$","td","2",{"children":"Check the particular scholarship’s own guide"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Self-funded admission"}],["$","td","1",{"children":"1 December 2026–31 May 2027"}],["$","td","2",{"children":"Later admission deadline does not extend scholarship funding"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Timezone"}],["$","td","1",{"children":"XMU guide specifies Beijing time, UTC+8"}],["$","td","2",{"children":"Save a reminder in your local timezone"}]],"$undefined"]}]]}]
1d:["$","section","1-Match the degree before using the timeline",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Match the degree before using the timeline"}],[["$","p","The table above summarises the published master’s guide. Bachelor’s and doctoral applicants should open their own degree guide from XMU’s official admissions website. Do not copy a master’s document list or eligibility condition into an undergraduate application.",{"children":"The table above summarises the published master’s guide. Bachelor’s and doctoral applicants should open their own degree guide from XMU’s official admissions website. Do not copy a master’s document list or eligibility condition into an undergraduate application."}],["$","p","Check your intended programme’s language, prior-subject expectations and academic assessment. Joint or specialised programmes can have additional arrangements. Make sure the actual teaching location and qualification fit your plans, rather than selecting a course from the scholarship label alone.",{"children":"Check your intended programme’s language, prior-subject expectations and academic assessment. Joint or specialised programmes can have additional arrangements. Make sure the actual teaching location and qualification fit your plans, rather than selecting a course from the scholarship label alone."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","2-Scholarship routes need separate coverage comparisons",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Scholarship routes need separate coverage comparisons"}],[["$","p","XMU lists government, provincial and university funding options. They are not interchangeable awards. Open the exact scholarship notice and record its class, duration and covered costs. The admissions timetable identifies when an application is due but does not by itself establish the benefits of every award.",{"children":"XMU lists government, provincial and university funding options. They are not interchangeable awards. Open the exact scholarship notice and record its class, duration and covered costs. The admissions timetable identifies when an application is due but does not by itself establish the benefits of every award."}],["$","p","For CSC Type A, follow the responsible dispatching authority rather than using XMU’s university-route deadline. If a scholarship requires both the XMU application and CSC registration, complete both. Keep admission and award results separate in your tracker.",{"children":"For CSC Type A, follow the responsible dispatching authority rather than using XMU’s university-route deadline. If a scholarship requires both the XMU application and CSC registration, complete both. Keep admission and award results separate in your tracker."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","3-Use the published language options accurately",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Use the published language options accurately"}],[["$","p","The reviewed 2027 master’s guide lists English test evidence and certain alternative proof for English-medium programmes. This is a programme-specific acceptance policy, not a China-wide no-IELTS promise. Chinese-medium programmes have their own evidence requirements.",{"children":"The reviewed 2027 master’s guide lists English test evidence and certain alternative proof for English-medium programmes. This is a programme-specific acceptance policy, not a China-wide no-IELTS promise. Chinese-medium programmes have their own evidence requirements."}],["$","p","Check whether your evidence matches the course and whether the department has additional expectations. If relying on prior teaching language, obtain a clear official certificate and verify that your exact degree route accepts it. Never substitute a self-written declaration for an institutional document.",{"children":"Check whether your evidence matches the course and whether the department has additional expectations. If relying on prior teaching language, obtain a clear official certificate and verify that your exact degree route accepts it. Never substitute a self-written declaration for an institutional document."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","4-Plan the document pack before the opening date",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Plan the document pack before the opening date"}],[["$","p","Use the period before December to organise identity, academic and language records. The master’s guide includes references and a substantial personal statement; the department may provide further writing instructions. Explain preparation, motivation and a feasible study direction in your own words.",{"children":"Use the period before December to organise identity, academic and language records. The master’s guide includes references and a substantial personal statement; the department may provide further writing instructions. Explain preparation, motivation and a feasible study direction in your own words."}],["$","p","The reviewed guide treats pre-acceptance as optional with priority consideration, but this does not make it a guaranteed award or remove a scholarship’s separate conditions. It also asks scholarship applicants for financial-support documentation. Read the full list rather than assuming funding applicants can skip financial evidence.",{"children":"The reviewed guide treats pre-acceptance as optional with priority consideration, but this does not make it a guaranteed award or remove a scholarship’s separate conditions. It also asks scholarship applicants for financial-support documentation. Read the full list rather than assuming funding applicants can skip financial evidence."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","5-Prepare an academic application that can be assessed",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Prepare an academic application that can be assessed"}],[["$","p","Choose two or three concrete examples showing readiness for the course. Describe your role, methods and outcome in a project, dissertation or relevant work. Link those examples to the programme’s curriculum or research direction. Avoid a statement made mostly of praise for the university.",{"children":"Choose two or three concrete examples showing readiness for the course. Describe your role, methods and outcome in a project, dissertation or relevant work. Link those examples to the programme’s curriculum or research direction. Avoid a statement made mostly of praise for the university."}],["$","p","Ask referees who can describe your academic work specifically. Share the intended degree, relevant deadlines and submission requirements. A detailed reference from someone who knows your work is more informative than a prestigious name with no direct experience of your abilities.",{"children":"Ask referees who can describe your academic work specifically. Share the intended degree, relevant deadlines and submission requirements. A detailed reference from someone who knows your work is more informative than a prestigious name with no direct experience of your abilities."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","6-Review before final submission",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Review before final submission"}],[["$","p","The published master’s instructions warn that submitted information and documents cannot be modified. Review the form, uploads, programme choices and payment step carefully. Ensure every scan is legible and every required page is present.",{"children":"The published master’s instructions warn that submitted information and documents cannot be modified. Review the form, uploads, programme choices and payment step carefully. Ensure every scan is legible and every required page is present."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L27",null,{"id":"guides/xiamen-university-admissions-scholarships:section-7","title":"Check your progress","items":["Correct 2027 degree guide used","Scholarship-specific deadline recorded","Required portals and application fee step completed","Accepted language evidence uploaded","References and programme-specific statement prepared","Financial-support requirement checked","Final submission and application number saved"]}],"$undefined","$undefined"]}]
23:["$","section","7-Track admission and funding separately",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Track admission and funding separately"}],[["$","p","Check the official application system and the email address used in your account for assessment requests. An invitation to interview or a pre-acceptance letter is not the final scholarship result. Read the final decision’s coverage, duration and registration conditions before arranging travel.",{"children":"Check the official application system and the email address used in your account for assessment requests. An invitation to interview or a pre-acceptance letter is not the final scholarship result. Read the final decision’s coverage, duration and registration conditions before arranging travel."}],["$","p","If you cannot enroll without adequate funding, calculate the remaining gap before accepting an offer. A self-funded admission outcome can be academically positive while still being financially unsuitable. Keep a backup option until the award terms are clear.",{"children":"If you cannot enroll without adequate funding, calculate the remaining gap before accepting an offer. A self-funded admission outcome can be academically positive while still being financially unsuitable. Keep a backup option until the award terms are clear."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Track admission and funding separately","children":[["$","$L4","/guides/csc-scholarship-type-a-vs-type-b/",{"href":"/guides/csc-scholarship-type-a-vs-type-b/","children":["Compare CSC routes",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/csc-scholarship-application/",{"href":"/guides/csc-scholarship-application/","children":["Build the application checklist",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
24:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://admissions.xmu.edu.cn/info/1061/4630.htm",{"href":"https://admissions.xmu.edu.cn/info/1061/4630.htm","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Xiamen University 2027 master’s admission guide"}],["$","span",null,{"children":"Official source reviewed 19 October 2026. Intake and programme-specific rules apply."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://admissions.xmu.edu.cn/Scholarships/Scholarships_Information.htm",{"href":"https://admissions.xmu.edu.cn/Scholarships/Scholarships_Information.htm","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Xiamen University official scholarship directory"}],["$","span",null,{"children":"Official source reviewed 19 October 2026. Intake and programme-specific rules apply."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$24:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
