28:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is TUM tuition-free for every international student?",{"children":[["$","summary",null,{"children":["Is TUM tuition-free for every international student?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Non-EU/EEA tuition applies to many newly enrolled bachelor’s and master’s students, with exceptions. Check the exact programme, intake and personal category."}]]}],["$","details","Does a TUM scholarship automatically cover tuition and living costs?",{"children":[["$","summary",null,{"children":["Does a TUM scholarship automatically cover tuition and living costs?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. A waiver and a cash grant have different purposes. Confirm the amount, coverage and duration in the specific award terms."}]]}],["$","details","Does requesting a VPD apply me to TUM?",{"children":[["$","summary",null,{"children":["Does requesting a VPD apply me to TUM?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The university also requires the relevant programme application in TUMonline. Follow its VPD and portal instructions as separate tasks."}]]}],["$","details","What is the universal TUM GPA or IELTS requirement?",{"children":[["$","summary",null,{"children":["What is the universal TUM GPA or IELTS requirement?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"There is no single figure that should be applied to every programme. Use the academic, assessment and language requirements of the exact degree."}]]}],["$","details","Are tuition rates changing for 2027?",{"children":[["$","summary",null,{"children":["Are tuition rates changing for 2027?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The checked official tuition page announces higher bands from winter semester 2027/28. Confirm the current course-specific amount before setting your budget."}]]}]]}]]}]
