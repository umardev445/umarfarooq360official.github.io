1c:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"TUM admission is programme-specific, and many applicants with foreign qualifications need a TUM-specific VPD plus a TUMonline application. Non-EU/EEA tuition can apply; scholarships and tuition waivers have separate conditions and are not automatic."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose one exact degree programme and intake, then check its academic requirements, application period, tuition and VPD instructions."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","#official-sources",{"href":"#official-sources","children":["Official sources",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/team/hafiz-umar-farooq/",{"href":"/team/hafiz-umar-farooq/","children":["Editorial contact",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Start with the programme, not a university-wide eligibility claim",{"href":"#section-1","children":"Start with the programme, not a university-wide eligibility claim"}],["$","a","Separate academic fit, language and application evidence",{"href":"#section-2","children":"Separate academic fit, language and application evidence"}],["$","a","Plan the VPD and TUMonline as two connected tasks",{"href":"#section-3","children":"Plan the VPD and TUMonline as two connected tasks"}],["$","a","Check tuition for your intake before comparing funding",{"href":"#section-4","children":"Check tuition for your intake before comparing funding"}],["$","a","A waiver and a cash scholarship solve different problems",{"href":"#section-5","children":"A waiver and a cash scholarship solve different problems"}],["$","a","Build a cost plan that can survive an unsuccessful award",{"href":"#section-6","children":"Build a cost plan that can survive an unsuccessful award"}],["$","a","Prepare a realistic submission and decision timeline",{"href":"#section-7","children":"Prepare a realistic submission and decision timeline"}],["$","a","Questions worth asking the official admissions team",{"href":"#section-8","children":"Questions worth asking the official admissions team"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Start with the programme, not a university-wide eligibility claim",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Start with the programme, not a university-wide eligibility claim"}],[["$","p","Open the official degree catalogue and identify the precise bachelor’s or master’s programme, campus, language and starting semester. A title such as engineering or computer science is too broad for an application plan. Requirements can include prior subject coverage and assessment steps that another programme does not use.",{"children":"Open the official degree catalogue and identify the precise bachelor’s or master’s programme, campus, language and starting semester. A title such as engineering or computer science is too broad for an application plan. Requirements can include prior subject coverage and assessment steps that another programme does not use."}],"$L1e"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$L1f","$undefined"]}],"$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}],false,"$L27","$L28"]}],"$L29"]}]
1d:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","guides/vpd-germany",{"href":"/guides/vpd-germany/","children":[["$","span",null,{"children":"Germany · Admission & funding research"}],["$","h3",null,{"children":"VPD for Germany: meaning, processing time and university submission"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/uni-assist-application",{"href":"/guides/uni-assist-application/","children":[["$","span",null,{"children":"Germany · Admission & funding research"}],["$","h3",null,{"children":"uni-assist application: documents, fees and the right submission route"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","countries/germany",{"href":"/countries/germany/","children":[["$","span",null,{"children":"Destination guide"}],["$","h3",null,{"children":"Study in Germany: scholarships, admission, visa and costs"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","tools/germany-blocked-account-calculator",{"href":"/tools/germany-blocked-account-calculator/","children":[["$","span",null,{"children":"Free Germany finance calculator · instant result"}],["$","h3",null,{"children":"Germany blocked account amount and student cost calculator"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
