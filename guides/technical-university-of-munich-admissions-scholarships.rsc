1b:["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--guide inner-hero--visual","children":["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L4",null,{"href":"/","children":"Home"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/",{"children":[["$","$L4",null,{"href":"/guides/","children":"Guides"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/technical-university-of-munich-admissions-scholarships/",{"children":[["$","span",null,{"aria-current":"page","children":"Technical University of Munich: admission, tuition and scholarship planning"}],false]}]]}],["$","span",null,{"data-slot":"badge","data-variant":"outline","className":"inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3 border-border text-foreground [a&]:hover:bg-accent [a&]:hover:text-accent-foreground inner-eyebrow","children":"Germany · Admission & funding research"}],false,["$","h1",null,{"children":"Technical University of Munich: admission, tuition and scholarship planning"}],["$","p",null,{"children":"Compare your academic fit and actual costs before applying to TUM. Keep programme admission, qualification assessment and financial support as separate decisions."}],["$","div",null,{"className":"inner-hero__meta","children":[["$","span",null,{"children":[["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1