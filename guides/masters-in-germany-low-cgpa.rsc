29:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Do not compare unlike grade scales","children":[["$","$L5","/tools/gpa-cgpa-calculator/",{"href":"/tools/gpa-cgpa-calculator/","children":["GPA and CGPA planning calculator",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/study-in-germany-admission-requirements/",{"href":"/guides/study-in-germany-admission-requirements/","children":["Germany admission guide",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
2a:["$","section","3-Build a shortlist with three honest outcomes",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Build a shortlist with three honest outcomes"}],[["$","p","Mark a programme as meets published criteria, needs clarification or does not meet a stated requirement. These labels describe your evidence review, not an admission prediction. Keep the exact official URL and a short reason beside the label so that another person can check your reasoning.",{"children":"Mark a programme as meets published criteria, needs clarification or does not meet a stated requirement. These labels describe your evidence review, not an admission prediction. Keep the exact official URL and a short reason beside the label so that another person can check your reasoning."}],["$","p","If an essential rule is unclear, ask one precise question. Include your degree title, awarding institution, relevant modules and the specific rule you need interpreted. Do not ask an admissions office to promise admission from a CGPA alone. If a mandatory condition is clearly unmet and no alternative is published, spend your time on better-fitting routes.",{"children":"If an essential rule is unclear, ask one precise question. Include your degree title, awarding institution, relevant modules and the specific rule you need interpreted. Do not ask an admissions office to promise admission from a CGPA alone. If a mandatory condition is clearly unmet and no alternative is published, spend your time on better-fitting routes."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Build a shortlist with three honest outcomes","children":[["$","a","/downloads/germany-programme-fit-shortlist.csv",{"href":"/downloads/germany-programme-fit-shortlist.csv","download":true,"children":["Download programme-fit shortlist (CSV)",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2b:["$","section","4-Strengthen evidence without hiding a weak result",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Strengthen evidence without hiding a weak result"}],[["$","p","Choose projects, research or professional work that demonstrate relevant preparation. Explain a grade issue briefly when the prompt invites context, then return to the course fit and what your evidence can support. Neither an impressive SOP nor a reference should be presented as an automatic waiver of formal entry requirements.",{"children":"Choose projects, research or professional work that demonstrate relevant preparation. Explain a grade issue briefly when the prompt invites context, then return to the course fit and what your evidence can support. Neither an impressive SOP nor a reference should be presented as an automatic waiver of formal entry requirements."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2c",null,{"id":"guides/masters-in-germany-low-cgpa:section-5","title":"Check your progress","items":["Record the exact course and intake","Copy the grade rule with its scale and official URL","Map mandatory subject areas to transcript modules","Identify any published ranking/alternative route","Check language and document requirements","Separate admission fit from scholarship eligibility","Estimate application and living costs before committing"]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Strengthen evidence without hiding a weak result","children":[["$","$L5","/guides/statement-of-purpose/",{"href":"/guides/statement-of-purpose/","children":["Plan a focused SOP",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/tools/germany-blocked-account-calculator/",{"href":"/tools/germany-blocked-account-calculator/","children":["Germany blocked-account budget tool",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
