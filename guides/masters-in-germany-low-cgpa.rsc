1b:["$","div",null,{"className":"inner-hero__meta","children":[["$","span",null,{"children":[["$","$L6",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z","key":"oel41y"}],["path",{"d":"m9 12 2 2 4-4","key":"dzmm74"}]],"className":"lucide-shield-check","aria-hidden":"true"}]," Updated ","1 Nov 2026"]}],["$","a",null,{"href":"#official-sources","children":"Official source record ↓"}]]}]
1c:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"There is no single low-CGPA admission rule for Germany. Individual programmes decide grade, subject, language and documentation requirements. Compare those published rules with your transcript instead of treating a university name as an admission guarantee."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Record the exact programme and grade scale, then check subject-credit and language conditions before writing a motivation letter."]}],"$undefined"]}],false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","A programme rule matters more than a university list",{"href":"#section-1","children":"A programme rule matters more than a university list"}],["$","a","A sourced example: Passau M.Sc. Computer Science",{"href":"#section-2","children":"A sourced example: Passau M.Sc. Computer Science"}],["$","a","Do not compare unlike grade scales",{"href":"#section-3","children":"Do not compare unlike grade scales"}],["$","a","Build a shortlist with three honest outcomes",{"href":"#section-4","children":"Build a shortlist with three honest outcomes"}],["$","a","Strengthen evidence without hiding a weak result",{"href":"#section-5","children":"Strengthen evidence without hiding a weak result"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","A programme rule matters more than a university list",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"A programme rule matters more than a university list"}],[["$","p","Uni-assist explains that master’s entry requirements are set by individual universities and can differ by course. A related recognised first degree, language evidence and additional criteria may be required; some programmes specify a minimum grade. A title such as “universities accepting 2.5 CGPA” cannot tell you which scale is meant or whether the actual course fits your education.",{"children":"Uni-assist explains that master’s entry requirements are set by individual universities and can differ by course. A related recognised first degree, language evidence and additional criteria may be required; some programmes specify a minimum grade. A title such as “universities accepting 2.5 CGPA” cannot tell you which scale is meant or whether the actual course fits your education."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Five gates to check for each programme","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Five gates to check for each programme"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Gate",{"scope":"col","children":"Gate"}],["$","th","Evidence to capture",{"scope":"col","children":"Evidence to capture"}],["$","th","Reason to pause",{"scope":"col","children":"Reason to pause"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","