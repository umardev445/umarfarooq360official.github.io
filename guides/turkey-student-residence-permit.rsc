23:["$","section","3-Health insurance: match coverage to the application",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Health insurance: match coverage to the application"}],[["$","p","METU’s October 2026 health guidance distinguishes public GSS/SGK coverage from private insurance and notes that recognised family/bilateral coverage needs evidence. It describes an early student enrolment window for public cover. Ask SGK and the university for the deadline and documents tied to your own enrolment.",{"children":"METU’s October 2026 health guidance distinguishes public GSS/SGK coverage from private insurance and notes that recognised family/bilateral coverage needs evidence. It describes an early student enrolment window for public cover. Ask SGK and the university for the deadline and documents tied to your own enrolment."}],["$","p","A policy that helps with travel is not automatically sufficient for residence. Ask whether it meets the current residence minimums and covers the period you request. Compare exclusions, provider access, co-payments and activation timing as well as the premium.",{"children":"A policy that helps with travel is not automatically sufficient for residence. Ask whether it meets the current residence minimums and covers the period you request. Compare exclusions, provider access, co-payments and activation timing as well as the premium."}],["$","p","Do not buy overlapping policies simply because different guides use different names. First determine whether a scholarship, parent’s recognised cover or bilateral arrangement already gives accepted coverage, and obtain the required proof.",{"children":"Do not buy overlapping policies simply because different guides use different names. First determine whether a scholarship, parent’s recognised cover or bilateral arrangement already gives accepted coverage, and obtain the required proof."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://iso.metu.edu.tr/en/health-care-services-and-insurance",{"children":["",["$","a",null,{"href":"https://iso.metu.edu.tr/en/health-care-services-and-insurance","target":"_blank","rel":"noreferrer","children":"METU: health insurance options and student GSS process"}]]}],["$","span","https://en.goc.gov.tr/kurumlar/en.goc/Brosurler/2_SAGLI%CC%87K_BROSURU_ENG-2.pdf",{"children":[" · ",["$","a",null,{"href":"https://en.goc.gov.tr/kurumlar/en.goc/Brosurler/2_SAGLI%CC%87K_BROSURU_ENG-2.pdf","target":"_blank","rel":"noreferrer","children":"Migration authority: healthcare information brochure"}]]}]]]}],"$undefined"]}]
24:["$","section","4-Separate card fees, insurance and private service charges",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Separate card fees, insurance and private service charges"}],[["$","p","Use the payment reference generated for your application and the current official route. METU’s reviewed 2026 student instructions cite a TRY 964 card fee. That dated institutional example should not be treated as a universal price for every year, nationality or situation.",{"children":"Use the payment reference generated for your application and the current official route. METU’s reviewed 2026 student instructions cite a TRY 964 card fee. That dated institutional example should not be treated as a universal price for every year, nationality or situation."}],["$","p","Build three budget lines: official application/card charges as applicable, insurance premium and any optional private service. A private intermediary’s bundled quote is not the same as the government fee. Keep receipts with the application record.",{"children":"Build three budget lines: official application/card charges as applicable, insurance premium and any optional private service. A private intermediary’s bundled quote is not the same as the government fee. Keep receipts with the application record."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://iso.metu.edu.tr/en/node/32",{"children":["",["$","a",null,{"href":"https://iso.metu.edu.tr/en/node/32","target":"_blank","rel":"noreferrer","children":"METU: 2026 card-fee example"}]]}]]]}],"$undefined"]}]
25:["$","section","5-Changes, extensions and graduation need a new check",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Changes, extensions and graduation need a new check"}],[["$","p","Keep the authority informed through the required route when your passport, address, programme or student status changes. Before leaving Türkiye during a pending application, obtain instructions for your specific situation rather than relying on another student’s experience.",{"children":"Keep the authority informed through the required route when your passport, address, programme or student status changes. Before leaving Türkiye during a pending application, obtain instructions for your specific situation rather than relying on another student’s experience."}],["$","p","Before graduation, ask about the residence route and deadlines relevant to your actual status. A post-graduation residence possibility is not an automatic work visa. Treat any new residence application and permission to work as separate decisions.",{"children":"Before graduation, ask about the residence route and deadlines relevant to your actual status. A post-graduation residence possibility is not an automatic work visa. Treat any new residence application and permission to work as separate decisions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://iso.metu.edu.tr/en/node/32",{"children":["",["$","a",null,{"href":"https://iso.metu.edu.tr/en/node/32","target":"_blank","rel":"noreferrer","children":"METU: student changes and graduation guidance"}]]}]]]}],"$undefined"]}]
26:["$","section","6-Can international students work?",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Can international students work?"}],[["$","p","The labour ministry’s criteria distinguish the levels: associate/bachelor’s students can be considered for part-time work after completing the first year; graduate students in formal education are not subject to that particular first-year restriction. A work permit is still a separate requirement.",{"children":"The labour ministry’s criteria distinguish the levels: associate/bachelor’s students can be considered for part-time work after completing the first year; graduate students in formal education are not subject to that particular first-year restriction. A work permit is still a separate requirement."}],["$","p","Check the employer and activity with the relevant authority. This guide does not promise a fixed number of work hours, an automatic graduate job or permission for every placement. Do not use speculative earnings to meet an immediate tuition or arrival payment.",{"children":"Check the employer and activity with the relevant authority. This guide does not promise a fixed number of work hours, an automatic graduate job or permission for every placement. Do not use speculative earnings to meet an immediate tuition or arrival payment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://csgb.gov.tr/uigm/en/calisma-izni/calisma-izni-degerlendirme-kriterleri/",{"children":["",["$","a",null,{"href":"https://csgb.gov.tr/uigm/en/calisma-izni/calisma-izni-degerlendirme-kriterleri/","target":"_blank","rel":"noreferrer","children":"Ministry of Labour: current foreign-student criteria"}]]}],["$","span","https://iso.metu.edu.tr/en/work-permits",{"children":[" · ",["$","a",null,{"href":"https://iso.metu.edu.tr/en/work-permits","target":"_blank","rel":"noreferrer","children":"METU: work-permit guidance"}]]}]]]}],"$undefined"]}]
27:["$","section","7-Keep a residence record you can use at renewal",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Keep a residence record you can use at renewal"}],[["$","p","Store sensitive copies privately. A public or shared checklist should contain task status, not passport numbers or insurance identifiers.",{"children":"Store sensitive copies privately. A public or shared checklist should contain task status, not passport numbers or insurance identifiers."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L28",null,{"id":"guides/turkey-student-residence-permit:section-8","title":"Check your progress","items":["I know my actual lawful-stay deadline and correct application category.","I saved the e-İkamet record and university handover instructions.","My student, identity and address evidence matches my situation.","My insurance proof covers the requested period and accepted scope.","I have receipts and a way to monitor missing-document requests.","I have reminders for expiry and any change of status."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Keep a residence record you can use at renewal","children":[["$","a","/downloads/turkey-arrival-checklist.csv",{"href":"/downloads/turkey-arrival-checklist.csv","download":true,"children":["Download the arrival and residence checklist (CSV)",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
