1a:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Start with the official e-İkamet system and your university’s current international-student instructions. Universities may collect student files under the cooperation protocol, but the migration authority decides the application."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Ask your university which submission channel and document list apply to you; do not copy another institution’s appointment or handover schedule."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","/countries/turkey/",{"href":"/countries/turkey/","children":["Explore the Turkey study hub",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Follow the owner of each residence task",{"href":"#section-1","children":"Follow the owner of each residence task"}],["$","a","Use the university’s process, not a generic appointment rule",{"href":"#section-2","children":"Use the university’s process, not a generic appointment rule"}],["$","a","Organise identity, student 