1:["$","main",null,{"id":"main-content","className":"$undefined","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/recommendation-letter/\",\"name\":\"How to get strong scholarship recommendation letters\",\"description\":\"Ask for a scholarship recommendation with a sample request email, evidence brief and reminder. Check who submits the reference and how confidentiality works.\",\"url\":\"https://aspirecompass.org/guides/recommendation-letter/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-08-31\",\"dateModified\":\"2026-10-21\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/application-writing-1280.webp\",\"caption\":\"A student reviewing notes and preparing an application at a desk\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"How to get strong scholarship recommendation letters\",\"item\":\"https://aspirecompass.org/guides/recommendation-letter/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"How to get strong scholarship recommendation letters\",\"description\":\"Ask for a scholarship recommendation with a sample request email, evidence brief and reminder. Check who submits the reference and how confidentiality works.\",\"image\":\"https://aspirecompass.org/images/application-writing-1280.webp\",\"datePublished\":\"2026-08-31\",\"dateModified\":\"2026-10-21\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/recommendation-letter/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can a friend or family member be my referee?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Normally an independent academic or professional observer is more appropriate. Follow the programme's permitted relationships and referee requirements.\"}},{\"@type\":\"Question\",\"name\":\"Should I draft the recommendation for the referee?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Provide accurate evidence and instructions. The referee should own the assessment and wording; never fabricate praise or impersonate their submission.\"}},{\"@type\":\"Question\",\"name\":\"Must the referee always upload the letter directly?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No universal method applies. Some programmes require direct submission; others tell applicants to collect and upload authentic references. Follow the actual instructions.\"}}]}"}}]],["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--guide inner-hero--visual","children":"$L18"}],"$L19","$L1a"]}]
