example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"Request example: “Would you be comfortable writing a strong reference for my application? The deadline is [date]. I can send the criteria, CV and a brief reminder of the work you supervised.” Do not write a confidential letter on the referee’s behalf."}]]}],"$undefined","$L1b","$undefined"]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}],false,null,"$L24"]}],"$L25"]}]
