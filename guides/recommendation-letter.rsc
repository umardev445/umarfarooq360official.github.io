18:["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L4",null,{"href":"/","children":"Home"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/",{"children":[["$","$L4",null,{"href":"/guides/","children":"Guides"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/recommendation-letter/",{"children":[["$","span",null,{"aria-current":"page","children":"How to get strong scholarship recommendation letters"}],false]}]]}],["$","span",null,{"data-slot":"badge","data-variant":"outline","className":"inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3 border-border text-foreground [a&]:hover:bg-accent [a&]:hover:text-accent-foreground inner-eyebrow","children":"Reference guide"}],false,["$","h1",null,{"children":"How to get strong scholarship recommendation letters"}],["$","p",null,{"children":"A useful recommendation is an independent evaluation backed by observed work. Your role is to select the right referee, explain the process and supply accurate evidence without controlling the judgement."}],["$","div",null,{"className":"inner-hero__meta","children":[["$","span",null,{"children":[["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z","key":"oel41y"}],["path",{"d":"m9 12 2 2 4-4","key":"dzmm74"}]],"className":"lucide-shield-check","aria-hidden":"true"}]," Updated ","21 Oct 2026"]}],["$","a",null,{"href":"#official-sources","children":"Official source record ↓"}]]}]]}],["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/application-writing-1280.webp","srcSet":"/images/application-writing-640.webp 640w, /images/application-writing-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"A student reviewing notes and preparing an application at a desk","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Prepare your own evidence, then adapt it to the application instructions."}]]}]]}]
19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Choose a referee who can evaluate relevant work, ask early with the exact deadline, and provide a concise evidence brief. Follow the portal’s submission rules; a sample request email is not a substitute for a referee’s independent assessment."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Use the request-email example, then prepare your evidence brief and confirm the referee’s submission method."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Student request and referee letter are different tasks",{"href":"#section-1","children":"Student request and referee letter are different tasks"}],["$","a","Send a request that makes the task clear",{"href":"#section-2","children":"Send a request that makes the task clear"}],["$","a","Prepare a one-page evidence brief",{"href":"#section-3","children":"Prepare a one-page evidence brief"}],["$","a","Choose the person who can evaluate the relevant work",{"href":"#section-4","children":"Choose the person who can evaluate the relevant work"}],["$","a","Follow the actual submission and confidentiality rules",{"href":"#section-5","children":"Follow the actual submission and confidentiality rules"}],["$","a","Use a respectful reminder and a backup plan",{"href":"#section-6","children":"Use a respectful reminder and a backup plan"}],["$","a","After submission, maintain the relationship",{"href":"#section-7","children":"After submission, maintain the relationship"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Student request and referee letter are different tasks",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Student request and referee letter are different tasks"}],[["$","p","This guide helps applicants request and organise references. If a referee asks for background, provide factual notes rather than an invented endorsement. The author must be able to stand behind the evaluation and follow the programme’s rules.",{"children":"This guide helps applicants request and organise references. If a referee asks for background, provide factual notes rather than an invented endorsement. The author must be able to stand behind the evaluation and follow the programme’s rules."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Student request and referee letter are different tasks","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Student request and referee letter are different tasks"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Task",{"scope":"col","children":"Task"}],["$","th","Applicant’s role",{"scope":"col","children":"Applicant’s role"}],["$","th","Referee’s role",{"scope":"col","children":"Referee’s role"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Initial request"}],["$","td","1",{"children":"Share the award, deadline and reason for asking"}],["$","td","2",{"children":"Confirm availability and suitability"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Evidence brief"}],["$","td","1",{"children":"Provide accurate work, dates and relevant examples"}],"$L1b"],"$undefined"]}],"$L1c","$L1d"]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1e","$L1f","$L20","$L21","$L22","$L23"]}],false,"$L24","$L25"]}],"$L26"]}]
1a:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","guides/scholarship-application",{"href":"/guides/scholarship-application/","children":[["$","span",null,{"children":"Application guide"}],["$","h3",null,{"children":"How to apply for international scholarships step by step"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/motivation-letter",{"href":"/guides/motivation-letter/","children":[["$","span",null,{"children":"Writing guide"}],["$","h3",null,{"children":"How to write a scholarship motivation letter"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/scholarship-cv",{"href":"/guides/scholarship-cv/","children":[["$","span",null,{"children":"Application guide"}],["$","h3",null,{"children":"How to write a scholarship CV for international applications"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/scholarship-interview",{"href":"/guides/scholarship-interview/","children":[["$","span",null,{"children":"Interview guide"}],["$","h3",null,{"children":"How to prepare for a scholarship interview"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
