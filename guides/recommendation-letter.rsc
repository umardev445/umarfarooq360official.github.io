1b:["$","$L26",null,{"id":"guides/recommendation-letter:section-1","title":"Check your progress","items":["Ask for agreement before naming a referee.","Share criteria and a concise evidence summary.","Confirm the submission method and deadline.","Send a respectful reminder and thank-you."]}]
1c:["$","section","1-Choose evidence over title",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Choose evidence over title"}],[["$","p","A professor who supervised your research closely can write a stronger letter than a famous academic who barely knows your work. Match each referee to the criteria they can assess.",{"children":"A professor who supervised your research closely can write a stronger letter than a famous academic who barely knows your work. Match each referee to the criteria they can assess."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","2-Ask early and clearly",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Ask early and clearly"}],[["$","p","Request the letter four to six weeks before the deadline when possible. State the programme, deadline, submission method and why you are asking that person.",{"children":"Request the letter four to six weeks before the deadline when possible. State the programme, deadline, submission method and why you are asking that person."}]],"$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Current CV",{"children":"Current CV"}],["$","li","Programme and selection criteria",{"children":"Programme and selection criteria"}],["$","li","Draft goals or essays",{"children":"Draft goals or essays"}],["$","li","Projects completed together",{"children":"Projects completed together"}],["$","li","Exact deadline and portal instructions",{"children":"Exact deadline and portal instructions"}]]}],"$undefined","$undefined"]}]
1e:["$","section","3-Help without writing the letter",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Help without writing the letter"}],[["$","p","A concise evidence sheet is appropriate. It reminds the referee of outcomes, dates and examples. Do not pressure a referee to sign a letter they did not write or cannot support.",{"children":"A concise evidence sheet is appropriate. It reminds the referee of outcomes, dates and examples. Do not pressure a referee to sign a letter they did not write or cannot support."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","4-Manage the submission respectfully",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Manage the submission respectfully"}],[["$","p","Send one polite reminder before the deadline, confirm receipt if the portal allows it and thank the referee. Keep them updated on the outcome.",{"children":"Send one polite reminder before the deadline, confirm receipt if the portal allows it and thank the referee. Keep them updated on the outcome."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","5-Match referees to different criteria",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Match referees to different criteria"}],[["$","p","When two letters are required, choose referees who add complementary evidence. One might assess academic or research readiness while another explains leadership, professional judgement or public-service impact.",{"children":"When two letters are required, choose referees who add complementary evidence. One might assess academic or research readiness while another explains leadership, professional judgement or public-service impact."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","6-Create a one-page referee brief",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Create a one-page referee brief"}],[["$","p","Provide the programme, selection criteria, deadline, submission method and a short evidence table of work completed with that referee. Mark facts that need confirmation and never write confidential praise on the referee's behalf.",{"children":"Provide the programme, selection criteria, deadline, submission method and a short evidence table of work completed with that referee. Mark facts that need confirmation and never write confidential praise on the referee's behalf."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","7-Handle confidential references correctly",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Handle confidential references correctly"}],[["$","p","Use institutional or professional email addresses when requested, waive access only when you understand the form and never create an account pretending to be your referee. If a letter must be sealed or uploaded directly, respect that process.",{"children":"Use institutional or professional email addresses when requested, waive access only when you understand the form and never create an account pretending to be your referee. If a letter must be sealed or uploaded directly, respect that process."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","8-Protect credibility and confidentiality",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Protect credibility and confidentiality"}],[["$","p","Do not invent a referee, write false evidence or pressure someone to sign a letter they cannot support. If the portal requires confidential submission, the referee should upload it through their own link or account.",{"children":"Do not invent a referee, write false evidence or pressure someone to sign a letter they cannot support. If the portal requires confidential submission, the referee should upload it through their own link or account."}],["$","p","Send a polite reminder before the deadline and confirm that the portal records completion. Keep a backup referee only where the programme permits a change.",{"children":"Send a polite reminder before the deadline and confirm that the portal records completion. Keep a backup referee only where the programme permits a change."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can a family member write my recommendation?",{"children":[["$","summary",null,{"children":["Can a family member write my recommendation?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Normally no. Choose an academic or professional referee who can provide independent evidence, unless the programme explicitly permits another relationship."}]]}],["$","details","What if my referee misses the deadline?",{"children":[["$","summary",null,{"children":["What if my referee misses the deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Contact the programme through its official channel and explain briefly. Do not submit a letter yourself if the rules require direct confidential submission."}]]}],["$","details","Can a friend write my recommendation letter?",{"children":[["$","summary",null,{"children":["Can a friend write my recommendation letter?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Normally no. Use an academic, research, employment or professional referee who can independently evaluate relevant work."}]]}],["$","details","Should I write the letter for my referee?",{"children":[["$","summary",null,{"children":["Should I write the letter for my referee?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Provide an evidence sheet and programme instructions. The referee should decide the wording and submit an honest evaluation under the programme's rules."}]]}]]}]]}]
