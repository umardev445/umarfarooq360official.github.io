15:T465,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can a family member write my recommendation?","acceptedAnswer":{"@type":"Answer","text":"Normally no. Choose an academic or professional referee who can provide independent evidence, unless the programme explicitly permits another relationship."}},{"@type":"Question","name":"What if my referee misses the deadline?","acceptedAnswer":{"@type":"Answer","text":"Contact the programme through its official channel and explain briefly. Do not submit a letter yourself if the rules require direct confidential submission."}},{"@type":"Question","name":"Can a friend write my recommendation letter?","acceptedAnswer":{"@type":"Answer","text":"Normally no. Use an academic, research, employment or professional referee who can independently evaluate relevant work."}},{"@type":"Question","name":"Should I write the letter for my referee?","acceptedAnswer":{"@type":"Answer","text":"Provide an evidence sheet and programme instructions. The referee should decide the wording and submit an honest evaluation under the programme's rules."}}]}1:["$","main",null,{"id":"main-content","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"How to get strong scholarship recommendation letters\",\"item\":\"https://aspirecompass.org/guides/recommendation-letter/\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"How to get strong scholarship recommendation letters\",\"description\":\"Choose the right referee