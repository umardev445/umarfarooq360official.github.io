1d:["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Reminder"}],["$","td","1",{"children":"Send a respectful reminder with the original details"}],["$","td","2",{"children":"Confirm submission or flag a problem"}]],"$undefined"]}]
1e:["$","section","1-Send a request that makes the task clear",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Send a request that makes the task clear"}],[["$","p","Give reasonable notice and state the exact deadline, submission route and programme. Four to six weeks is a planning suggestion when available, not a programme rule. Shorter notice may be unavoidable; acknowledge it and ask about availability rather than assuming consent.",{"children":"Give reasonable notice and state the exact deadline, submission route and programme. Four to six weeks is a planning suggestion when available, not a programme rule. Shorter notice may be unavoidable; acknowledge it and ask about availability rather than assuming consent."}],["$","p","Offer a concise evidence brief and the official instructions. Do not attach a long collection of unrelated files to the first message. Make it easy to decline if the referee cannot support the request.",{"children":"Offer a concise evidence brief and the official instructions. Do not attach a long collection of unrelated files to the first message. Make it easy to decline if the referee cannot support the request."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"Example request email — fictional details"}],[["$","p","0",{"children":"Subject: Recommendation request — programme application due 18 November"}],["$","p","1",{"children":"Dear Dr Khan, would you be willing to provide a recommendation for my application to the proposed research master's programme? You supervised my final-year data project, so your perspective on my method, revisions and independent work would be particularly relevant."}],["$","p","2",{"children":"The application requires a reference through the institution's own portal by 18 November. If you are comfortable supporting me, I can send the official instructions, my current CV and a one-page summary of the work we completed together. Please let me know if the timing or your availability makes this difficult. Thank you for considering the request."}]],["$","p",null,{"className":"sample-card__note","children":"Names, programme and date are fictional. Replace them with your own facts and the actual submission instructions."}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","2-Prepare a one-page evidence brief",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Prepare a one-page evidence brief"}],[["$","p","The brief reminds the referee of work they observed. Include your relationship, project dates, responsibilities, outputs, feedback and selection criteria. Distinguish measured results from your interpretation and mark any fact that needs confirmation.",{"children":"The brief reminds the referee of work they observed. Include your relationship, project dates, responsibilities, outputs, feedback and selection criteria. Distinguish measured results from your interpretation and mark any fact that needs confirmation."}],["$","p","Do not write praise for the referee to sign. They should choose the evaluation, level of support and wording. A reference becomes less credible when a candidate pressures an observer to endorse a claim they cannot assess.",{"children":"Do not write praise for the referee to sign. They should choose the evaluation, level of support and wording. A reference becomes less credible when a candidate pressures an observer to endorse a claim they cannot assess."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A filled fictional evidence brief","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A filled fictional evidence brief"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Field",{"scope":"col","children":"Field"}],["$","th","Example information",{"scope":"col","children":"Example information"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Relationship"}],["$","td","1",{"children":"Supervisor of final-year project; met monthly"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Work observed"}],["$","td","1",{"children":"Designed a data-cleaning workflow and documented errors"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Personal contribution"}],["$","td","1",{"children":"Revised the validation rules after supervisor feedback"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Output"}],["$","td","1",{"children":"Submitted a reproducible analysis with a limitations section"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Relevant criterion"}],["$","td","1",{"children":"Independent reasoning and ability to respond to criticism"}]],"$undefined"]}],["$","tr","5",{"children":[[["$","th","0",{"scope":"row","children":"Needs confirmation"}],["$","td","1",{"children":"Exact project dates and assessment outcome"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","3-Choose the person who can evaluate the relevant work",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Choose the person who can evaluate the relevant work"}],[["$","p","Start with the selection criteria. For academic readiness, a supervisor or lecturer who has assessed substantial work may be suitable. For professional judgement, a manager who has observed your decisions may have stronger evidence. A senior title alone does not make a reference informative.",{"children":"Start with the selection criteria. For academic readiness, a supervisor or lecturer who has assessed substantial work may be suitable. For professional judgement, a manager who has observed your decisions may have stronger evidence. A senior title alone does not make a reference informative."}],["$","p","If two references are required, look for complementary perspectives rather than two people who would describe the same project. Check permitted relationships and any requirement for an academic referee. Ask whether the person can provide a supportive, evidence-based reference before entering their name.",{"children":"If two references are required, look for complementary perspectives rather than two people who would describe the same project. Check permitted relationships and any requirement for an academic referee. Ask whether the person can provide a supportive, evidence-based reference before entering their name."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Match the criterion to an observer","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Match the criterion to an observer"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Criterion",{"scope":"col","children":"Criterion"}],["$","th","Possible observer",{"scope":"col","children":"Possible observer"}],["$","th","Evidence to discuss",{"scope":"col","children":"Evidence to discuss"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Research readiness"}],["$","td","1",{"children":"Project or dissertation supervisor"}],["$","td","2",{"children":"Method, revision and independent reasoning"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Academic performance"}],["$","td","1",{"children":"Lecturer with substantial assessed work"}],["$","td","2",{"children":"Assignments and response to feedback"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Professional judgement"}],["$","td","1",{"children":"Manager or project lead"}],["$","td","2",{"children":"Decisions, reliability and outcomes"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Leadership or service"}],["$","td","1",{"children":"Relevant organisational supervisor"}],["$","td","2",{"children":"Personal responsibility and collaboration"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","4-Follow the actual submission and confidentiality rules",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Follow the actual submission and confidentiality rules"}],[["$","p","References may be uploaded by the referee, sent from an institutional email or collected by the applicant when the programme explicitly instructs that route. These methods are not interchangeable. Read who submits, what format is accepted, whether a signature or letterhead is required and when the letter must arrive.",{"children":"References may be uploaded by the referee, sent from an institutional email or collected by the applicant when the programme explicitly instructs that route. These methods are not interchangeable. Read who submits, what format is accepted, whether a signature or letterhead is required and when the letter must arrive."}],["$","p","Never impersonate a referee or use their account. If the process is confidential, respect that separation. If the programme asks you to collect and upload a reference, preserve the authentic document and follow its instructions rather than inventing a confidentiality rule that is not there.",{"children":"Never impersonate a referee or use their account. If the process is confidential, respect that separation. If the programme asks you to collect and upload a reference, preserve the authentic document and follow its instructions rather than inventing a confidentiality rule that is not there."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L27",null,{"id":"guides/recommendation-letter:section-5","title":"Check your progress","items":["Referee has agreed","Official method and deadline shared","Email and identity details entered correctly","Letter format confirmed","Completion checked through the permitted channel"]}],"$undefined","$undefined"]}]
22:["$","section","5-Use a respectful reminder and a backup plan",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Use a respectful reminder and a backup plan"}],[["$","p","Agree how you will follow up. One polite reminder can mention the approaching date, the programme and the submission link without implying fault. Check the portal first where a completion indicator is available; an email notification can be delayed.",{"children":"Agree how you will follow up. One polite reminder can mention the approaching date, the programme and the submission link without implying fault. Check the portal first where a completion indicator is available; an email notification can be delayed."}],["$","p","If the referee becomes unavailable, ask the programme whether a substitution is permitted. Keep any replacement honest and disclose changes through the required channel. A missed reference deadline is not automatically repaired by sending a letter yourself.",{"children":"If the referee becomes unavailable, ask the programme whether a substitution is permitted. Keep any replacement honest and disclose changes through the required channel. A missed reference deadline is not automatically repaired by sending a letter yourself."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"Example reminder"}],[["$","p","0",{"children":"Dear Dr Khan, thank you again for supporting my application. The reference deadline is 18 November. I wanted to check whether the portal invitation reached you and whether you need any further factual information from me. Please let me know if there is a problem with the submission link."}]],["$","p",null,{"className":"sample-card__note","children":"Use only after agreement and adapt the timing to your referee's preferences."}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","6-After submission, maintain the relationship",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"After submission, maintain the relationship"}],[["$","p","Thank the referee and let them know the outcome when appropriate. If you apply again, ask before reusing their details. A previous letter may not answer a new programme's criteria or fit its portal.",{"children":"Thank the referee and let them know the outcome when appropriate. If you apply again, ask before reusing their details. A previous letter may not answer a new programme's criteria or fit its portal."}],["$","p","Keep a tracker of requests, agreed dates and submission status. Store contact information carefully and avoid sharing confidential evaluations with other applications without permission. Good reference planning is a professional relationship, not a template-filling task.",{"children":"Keep a tracker of requests, agreed dates and submission status. Store contact information carefully and avoid sharing confidential evaluations with other applications without permission. Good reference planning is a professional relationship, not a template-filling task."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for After submission, maintain the relationship","children":[["$","$L4","/guides/scholarship-application/",{"href":"/guides/scholarship-application/","children":["Organise the complete application",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/scholarship-cv/",{"href":"/guides/scholarship-cv/","children":["Prepare a consistent CV",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/motivation-letter/",{"href":"/guides/motivation-letter/","children":["Explain your goals clearly",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
24:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://cscuk.fcdo.gov.uk/scholarships/commonwealth-masters-scholarships/",{"href":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-masters-scholarships/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Commonwealth Master’s: application and reference instructions"}],["$","span",null,{"children":"An example of a scheme with its own reference and document process; other schemes can require direct referee submission."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
25:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can a friend or family member be my referee?",{"children":[["$","summary",null,{"children":["Can a friend or family member be my referee?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Normally an independent academic or professional observer is more appropriate. Follow the programme's permitted relationships and referee requirements."}]]}],["$","details","Should I draft the recommendation for the referee?",{"children":[["$","summary",null,{"children":["Should I draft the recommendation for the referee?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Provide accurate evidence and instructions. The referee should own the assessment and wording; never fabricate praise or impersonate their submission."}]]}],["$","details","Must the referee always upload the letter directly?",{"children":[["$","summary",null,{"children":["Must the referee always upload the letter directly?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No universal method applies. Some programmes require direct submission; others tell applicants to collect and upload authentic references. Follow the actual instructions."}]]}]]}]]}]
