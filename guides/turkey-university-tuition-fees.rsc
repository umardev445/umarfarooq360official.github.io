1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/turkey-university-tuition-fees/\",\"name\":\"Turkey university tuition fees for international students\",\"description\":\"Compare sourced 2026/27 international tuition at METU, Istanbul University, Sabancı and Bilkent, including annual versus semester fees and scholarship gaps.\",\"url\":\"https://aspirecompass.org/guides/turkey-university-tuition-fees/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-29\",\"dateModified\":\"2026-10-29\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/study-planning-1280.webp\",\"caption\":\"Illustrative students comparing study notes and programme information at a library table\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Turkey university tuition fees for international students\",\"item\":\"https://aspirecompass.org/guides/turkey-university-tuition-fees/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"Turkey university tuition fees for international students\",\"description\":\"Compare sourced 2026/27 international tuition at METU, Istanbul University, Sabancı and Bilkent, including annual versus semester fees and scholarship gaps.\",\"image\":\"https://aspirecompass.org/images/study-planning-1280.webp\",\"datePublished\":\"2026-10-29\",\"dateModified\":\"2026-10-29\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/turkey-university-tuition-fees/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is the tuition fee in Turkey for international students?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"There is no single national tuition figure. The table gives selected official 2026/27 examples with institution, programme scope and payment unit; use your own fee category for a decision.\"}},{\"@type\":\"Question\",\"name\":\"Can a scholarship make a foundation university cheaper than a public university?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It can change the comparison, but use the actual award and complete cost. A hypothetical maximum scholarship is not an amount you can deduct from a confirmed offer.\"}},{\"@type\":\"Question\",\"name\":\"Are the displayed fees for 2027/28?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The numeric examples are explicitly 2026/27. A later intake requires its own published fee schedule and offer.\"}}]}"}}]],"$L18",false,"$L19","$L1a"]}]
