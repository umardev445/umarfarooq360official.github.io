2a:["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Tuition waiver"}],["$","td","1",{"children":"Percentage or amount in the offer"}],["$","td","2",{"children":"Reduce only covered tuition"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Cash stipend"}],["$","td","1",{"children":"Amount, payment months and start date"}],["$","td","2",{"children":"Apply to costs in those months"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Dorm award"}],["$","td","1",{"children":"Room type, duration and conditions"}],["$","td","2",{"children":"Remove only the covered housing"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Unconfirmed award"}],["$","td","1",{"children":"Pending decision or general eligibility"}],["$","td","2",{"children":"Keep a separate scenario; no guaranteed deduction"}]],"$undefined"]}]]}]
2b:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for What does a scholarship leave you to pay?","children":[["$","$L4","/guides/sabanci-university-admissions-scholarships/",{"href":"/guides/sabanci-university-admissions-scholarships/","children":["Sabancı award types",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/bilkent-university-admissions-scholarships/",{"href":"/guides/bilkent-university-admissions-scholarships/","children":["Bilkent award and retention rules",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/koc-university-admissions-scholarships/",{"href":"/guides/koc-university-admissions-scholarships/","children":["Koç offer comparison",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
2c:["$","section","3-Public-university tuition is programme-specific",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Public-university tuition is programme-specific"}],[["$","p","The official Istanbul schedule is organised by faculty, while METU distinguishes cohorts and programme groups. This is why “public university” cannot be treated as one national price. A medical degree and a humanities degree may have very different charges.",{"children":"The official Istanbul schedule is organised by faculty, while METU distinguishes cohorts and programme groups. This is why “public university” cannot be treated as one national price. A medical degree and a humanities degree may have very different charges."}],["$","p","Do not choose an open/distance-education row as the price for a campus degree, or a domestic central-placement category as your international-entry price. Confirm which row the registrar will use before paying.",{"children":"Do not choose an open/distance-education row as the price for a campus degree, or a domestic central-placement category as your international-entry price. Confirm which row the registrar will use before paying."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Public-university tuition is programme-specific","children":[["$","$L4","/guides/istanbul-university-admissions-fees/",{"href":"/guides/istanbul-university-admissions-fees/","children":["Istanbul University faculty fees",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/metu-international-admissions/",{"href":"/guides/metu-international-admissions/","children":["METU campus and cohort rules",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2d:["$","section","4-Payments due before and after arrival",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Payments due before and after arrival"}],[["$","p","Create a cash calendar alongside the annual total. It should show any required deposit, first tuition instalment, accommodation deposit, visa submission costs and first living month. Record refund conditions next to each advance payment.",{"children":"Create a cash calendar alongside the annual total. It should show any required deposit, first tuition instalment, accommodation deposit, visa submission costs and first living month. Record refund conditions next to each advance payment."}],["$","p","A large annual scholarship can still leave an arrival cash problem if the stipend begins after registration. Ask who pays the first room bill and when the first award payment reaches you. Do not describe a refundable deposit as free money or subtract it from required arrival cash.",{"children":"A large annual scholarship can still leave an arrival cash problem if the stipend begins after registration. Ask who pays the first room bill and when the first award payment reaches you. Do not describe a refundable deposit as free money or subtract it from required arrival cash."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Payments due before and after arrival","children":[["$","$L4","/guides/cost-of-living-in-turkey-for-students/",{"href":"/guides/cost-of-living-in-turkey-for-students/","children":["Living costs and worked budgets",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/student-accommodation-turkey/",{"href":"/guides/student-accommodation-turkey/","children":["Housing payment questions",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2e:["$","section","5-A fee enquiry that gets a useful answer",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"A fee enquiry that gets a useful answer"}],[["$","p","Send the university your intended academic year, degree, programme, citizenship/applicant category and entry year. Ask for the fee unit, taxes, preparation-year charge, instalments and how any award applies. Include your application reference if you have one; do not send bank documents to a general public contact.",{"children":"Send the university your intended academic year, degree, programme, citizenship/applicant category and entry year. Ask for the fee unit, taxes, preparation-year charge, instalments and how any award applies. Include your application reference if you have one; do not send bank documents to a general public contact."}],["$","p","For Koç, this guide deliberately gives no newly verified 2026/27 numeric fee: the live fee page could not be retrieved during this review. Ask the university for the current written schedule rather than using a dated brochure amount.",{"children":"For Koç, this guide deliberately gives no newly verified 2026/27 numeric fee: the live fee page could not be retrieved during this review. Ask the university for the current written schedule rather than using a dated brochure amount."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2f",null,{"id":"guides/turkey-university-tuition-fees:section-6","title":"Check your progress","items":["My source names the correct year, faculty and entry category.","I have kept annual and semester fees distinct.","I know the net tuition and conditions of the written award.","I have included housing and initial cash, not only tuition.","I have saved the official fee and refund information."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for A fee enquiry that gets a useful answer","children":[["$","a","/downloads/turkey-tuition-comparison.csv",{"href":"/downloads/turkey-tuition-comparison.csv","download":true,"children":["Download the tuition comparison sheet (CSV)",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
