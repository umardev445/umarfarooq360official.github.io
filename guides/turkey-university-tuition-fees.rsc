24:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Normalise the unit before deciding what is affordable",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Normalise the unit before deciding what is affordable"}],[["$","p","Multiply a per-semester figure by the number of chargeable semesters in the academic year. Keep summer study, preparation, extensions and special joint degrees outside that estimate until you know their rules. A fee for an older entering cohort may not apply to a new student.",{"children":"Multiply a per-semester figure by the number of chargeable semesters in the academic year. Keep summer study, preparation, extensions and special joint degrees outside that estimate until you know their rules. A fee for an older entering cohort may not apply to a new student."}],["$","p","Use a common comparison currency only after recording the original amount. Write down the exchange-rate date and any bank or transfer charge. A conversion helps compare offers; it does not replace the university’s invoicing rule.",{"children":"Use a common comparison currency only after recording the original amount. Write down the exchange-rate date and any bank or transfer charge. A conversion helps compare offers; it does not replace the university’s invoicing rule."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"Worked comparison: two standard semesters at USD 1,200 are USD 2,400 for tuition. An annual USD 18,400 fee is already a yearly figure, so do not multiply it by two. The comparison still needs scholarships, rent and other expenses before it becomes a study budget."}]]}],"$undefined","$undefined","$undefined","$undefined"]}],["$","section","2-What does a scholarship leave you to pay?",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"What does a scholarship leave you to pay?"}],[["$","p","Build the net tuition from the scholarship letter rather than the percentage advertised on a general page. If accommodation is not expressly included, leave it in the budget. Do the same for travel, meals and insurance.",{"children":"Build the net tuition from the scholarship letter rather than the percentage advertised on a general page. If accommodation is not expressly included, leave it in the budget. Do the same for travel, meals and insurance."}],["$","p","Original arithmetic example: an annual tuition of 20,000 with a confirmed 60% tuition waiver leaves 8,000 in the same currency. A separate living estimate of 9,000 makes the planned total 17,000 before arrival costs. These fictional inputs explain the method and are not a university quote.",{"children":"Original arithmetic example: an annual tuition of 20,000 with a confirmed 60% tuition waiver leaves 8,000 in the same currency. A separate living estimate of 9,000 makes the planned total 17,000 before arrival costs. These fictional inputs explain the method and are not a university quote."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Record funding without double counting","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Record funding without double counting"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Budget line",{"scope":"col","children":"Budget line"}],"$L28","$L29"],"$undefined"]}]}],"$L2a"]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$L2b"]}],"$L2c","$L2d","$L2e"]}]
