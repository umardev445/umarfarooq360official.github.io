23:["$","figure",null,{"className":"page-visual page-visual--inline","children":[["$","img",null,{"src":"/images/research-20261028/undergraduate-1280.webp","srcSet":"/images/research-20261028/undergraduate-640.webp 640w, /images/research-20261028/undergraduate-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Illustration of a Pakistani school-leaver and counsellor reviewing nomination and university application stages","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Original editorial illustration. People and settings are illustrative; current requirements are recorded in the guide."}]]}]
24:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Pearson: a remaining deadline can have expired prerequisites",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Pearson: a remaining deadline can have expired prerequisites"}],[["$","p","The published 2027 entry sequence gives school nomination by 9 October 2026, the required university admission application by 16 October and the scholarship form by 6 November. On 28 October, a new applicant who missed the earlier steps should not assume that the last date creates a fresh opportunity.",{"children":"The published 2027 entry sequence gives school nomination by 9 October 2026, the required university admission application by 16 October and the scholarship form by 6 November. On 28 October, a new applicant who missed the earlier steps should not assume that the last date creates a fresh opportunity."}],["$","p","Already-nominated applicants should check their actual invitation, programme selection and submission requirements. A school nomination is a prerequisite, not a scholarship award. Review the university’s exact student-profile rules and funding conditions.",{"children":"Already-nominated applicants should check their actual invitation, programme selection and submission requirements. A school nomination is a prerequisite, not a scholarship award. Review the university’s exact student-profile rules and funding conditions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://future.utoronto.ca/pearson-scholarships",{"children":["",["$","a",null,{"href":"https://future.utoronto.ca/pearson-scholarships","target":"_blank","rel":"noreferrer","children":"University of Toronto Pearson"}]]}]]]}],"$undefined"]}],["$","section","2-Berea: substantial support still needs a cash plan",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Berea: substantial support still needs a cash plan"}],[["$","p","Berea’s international guidance describes combined support for listed educational and living costs, but also explains a deposit and personal-cost expectations. Its cited USD 2,200 deposit has an assistance process for those unable to pay. Read that process rather than describing the route as requiring no money at any stage.",{"children":"Berea’s international guidance describes combined support for listed educational and living costs, but also explains a deposit and personal-cost expectations. Its cited USD 2,200 deposit has an assistance process for those unable to pay. Read that process rather than describing the route as requiring no money at any stage."}],["$","p","Follow the current English-score and document checklist. Berea also sets its own rules on outside assistance with the personal essay: the applicant must comply with those instructions. A general scholarship writing template is not permission to have another person or AI write an application essay.",{"children":"Follow the current English-score and document checklist. Berea also sets its own rules on outside assistance with the personal essay: the applicant must comply with those instructions. A general scholarship writing template is not permission to have another person or AI write an application essay."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.berea.edu/admissions/admission-information/apply/checklist-items/international-faqs",{"children":["","$L28"]}]]]}],"$undefined"]}],"$L29","$L2a","$L2b","$L2c","$L2d"]}]
