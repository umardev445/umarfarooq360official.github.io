1b:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Pakistani undergraduate applicants can research international university awards and applicable government routes, but admission and funding often require different steps. Pearson needs school nomination; Berea assesses international admission and aid together; Oxford funding follows an earlier admission application. Check the stage you can still complete."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose your qualification and application stage, then compare the route, coverage and dated status below."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Compare routes before collecting application forms",{"href":"#section-1","children":"Compare routes before collecting application forms"}],["$","a","Pearson: a remaining deadline can have expired prerequisites",{"href":"#section-2","children":"Pearson: a remaining deadline can have expired prerequisites"}],["$","a","Berea: substantial support still needs a cash plan",{"href":"#section-3","children":"Berea: substantial support still needs a cash plan"}],["$","a","Oxford: admission and funding do not share one deadline",{"href":"#section-4","children":"Oxford: admission an