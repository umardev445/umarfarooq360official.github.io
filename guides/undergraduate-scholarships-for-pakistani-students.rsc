29:["$","section","3-Oxford: admission and funding do not share one deadline",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Oxford: admission and funding do not share one deadline"}],[["$","p","Oxford’s 2027 undergraduate funding instructions describe a January scholarship stage. Admission has an earlier sequence. Someone who has not completed the required admission application cannot treat a later funding date as a reopened course application.",{"children":"Oxford’s 2027 undergraduate funding instructions describe a January scholarship stage. Admission has an earlier sequence. Someone who has not completed the required admission application cannot treat a later funding date as a reopened course application."}],["$","p","Open the particular award, check Pakistan’s inclusion and any residence, financial-need, subject and first-degree restrictions. Do not combine several Oxford awards into one guaranteed fully funded package.",{"children":"Open the particular award, check Pakistan’s inclusion and any residence, financial-need, subject and first-degree restrictions. Do not combine several Oxford awards into one guaranteed fully funded package."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.ox.ac.uk/admissions/undergraduate/fees-and-funding/oxford-bursaries-and-scholarships",{"children":["",["$","a",null,{"href":"https://www.ox.ac.uk/admissions/undergraduate/fees-and-funding/oxford-bursaries-and-scholarships","target":"_blank","rel":"noreferrer","children":"Oxford undergraduate funding"}]]}]]]}],"$undefined"]}]
2a:["$","section","4-FSc, A levels and entry tests: keep requirements specific",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"FSc, A levels and entry tests: keep requirements specific"}],[["$","p","Universities decide how they assess a Pakistani school qualification and the subjects required for a course. A grade threshold from one institution is not a universal percentage for foreign scholarships. Record the qualification, subject prerequisites and graduation timing for each actual programme.",{"children":"Universities decide how they assess a Pakistani school qualification and the subjects required for a course. A grade threshold from one institution is not a universal percentage for foreign scholarships. Record the qualification, subject prerequisites and graduation timing for each actual programme."}],["$","p","HEC’s applicable foreign-funded routes can use USAT for undergraduate selection; other institutions use their own admission process. Do not label every overseas scholarship as requiring USAT, SAT or one English test. Use the current owner and programme instructions.",{"children":"HEC’s applicable foreign-funded routes can use USAT for undergraduate selection; other institutions use their own admission process. Do not label every overseas scholarship as requiring USAT, SAT or one English test. Use the current owner and programme instructions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.hec.gov.pk/english/scholarshipsgrants/lao/pages/default.aspx",{"children":["",["$","a",null,{"href":"https://www.hec.gov.pk/english/scholarshipsgrants/lao/pages/default.aspx","target":"_blank","rel":"noreferrer","children":"HEC Learning Opportunities Abroad"}]]}]]]}],"$undefined"]}]
2b:["$","section","5-Full-cost, full-tuition and partial support mean different things",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Full-cost, full-tuition and partial support mean different things"}],[["$","p","Full tuition describes university fees, not automatically rent, food, travel, insurance, tests or a visa. A living allowance may be paid only after enrolment. Record the benefit and its start date, then identify what your household must finance before arrival.",{"children":"Full tuition describes university fees, not automatically rent, food, travel, insurance, tests or a visa. A living allowance may be paid only after enrolment. Record the benefit and its start date, then identify what your household must finance before arrival."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A funding label is useful only with its boundary","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A funding label is useful only with its boundary"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Advertised support",{"scope":"col","children":"Advertised support"}],["$","th","Question to answer",{"scope":"col","children":"Question to answer"}],["$","th","Budget action",{"scope":"col","children":"Budget action"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Tuition covered"}],["$","td","1",{"children":"Which mandatory fees are excluded?"}],["$","td","2",{"children":"Keep uncovered fees and living costs"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Residence support"}],["$","td","1",{"children":"Is it an allocated room, allowance or reimbursement?"}],["$","td","2",{"children":"Check the contract and arrival timing"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Stipend"}],["$","td","1",{"children":"Amount, duration and first payment?"}],["$","td","2",{"children":"Budget the gap before payment"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Travel support"}],["$","td","1",{"children":"Ticket, allowance or later reimbursement?"}],["$","td","2",{"children":"Keep upfront travel cash if needed"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Partial award"}],["$","td","1",{"children":"Fixed amount or percentage of which bill?"}],["$","td","2",{"children":"Calculate the remaining annual cost"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2c:["$","section","6-Two applicants, two useful next steps",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Two applicants, two useful next steps"}],[["$","p","Applicant A is a fictional FSc student starting research after Pearson’s nomination deadline. Their next step is not to rush an ineligible late form; it is to check still-usable verified routes and prepare a realistic admission and testing calendar.",{"children":"Applicant A is a fictional FSc student starting research after Pearson’s nomination deadline. Their next step is not to rush an ineligible late form; it is to check still-usable verified routes and prepare a realistic admission and testing calendar."}],["$","p","Applicant B was nominated and completed the required Toronto admission stage on time. Their next step is to follow the actual scholarship invitation and final form deadline. The visible November date has different meaning for these two students.",{"children":"Applicant B was nominated and completed the required Toronto admission stage on time. Their next step is to follow the actual scholarship invitation and final form deadline. The visible November date has different meaning for these two students."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2d:["$","section","7-Your application record",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Your application record"}],[["$","p","Save a small record for each route: owner, course, entry qualification, nomination, admission, scholarship form, tests, coverage and funding gap. Keep references and school documents ready early, but follow each programme’s own essay and outside-assistance rules.",{"children":"Save a small record for each route: owner, course, entry qualification, nomination, admission, scholarship form, tests, coverage and funding gap. Keep references and school documents ready early, but follow each programme’s own essay and outside-assistance rules."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L30",null,{"id":"guides/undergraduate-scholarships-for-pakistani-students:section-8","title":"Check your progress","items":["Pakistan and my actual qualification are eligible.","School nomination, if required, is completed.","Admission and scholarship forms are separately tracked.","Tests and references follow the exact checklist.","Funding exclusions and arrival cash recorded.","Current application stage is still usable."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Your application record","children":[["$","$L4","/guides/scholarships-for-pakistani-students/",{"href":"/guides/scholarships-for-pakistani-students/","children":["Pakistan scholarship overview",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/bachelors/",{"href":"/scholarships/bachelors/","children":["Bachelor’s funding directory",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/scholarship-application/",{"href":"/guides/s