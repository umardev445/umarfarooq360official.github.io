20:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Are Italian university application fees refundable?",{"children":[["$","summary",null,{"children":["Are Italian university application fees refundable?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"There is no universal rule. Padua and the cited PoliTO route describe non-refundable fees; read your own programme’s conditions before paying."}]]}],["$","details","Does Pavia charge once for all choices?",{"children":[["$","summary",null,{"children":["Does Pavia charge once for all choices?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The reviewed FAQ states EUR 35 for each programme, with up to three choices per intake."}]]}],["$","details","Should I add both PoliMi payment amounts?",{"children":[["$","summary",null,{"children":["Should I add both PoliMi payment amounts?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The early and standard amounts depend on the payment period; they are not a combined fee."}]]}],["$","details","Is Universitaly pre-enrolment a paid university application?",{"children":[["$","summary",null,{"children":["Is Universitaly pre-enrolment a paid university application?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Universitaly pre-enrolment is free and separate from a university’s own application or assessment charges."}]]}]]}]]}]
