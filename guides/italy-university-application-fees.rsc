22:["$","p","If an application allows two programme choices for one payment, record those choices within that application. If another institution charges per programme, two applications mean two charges. Do not compare the totals without this distinction.",{"children":"If an application allows two programme choices for one payment, record those choices within that application. If another institution charges per programme, two applications mean two charges. Do not compare the totals without this distinction."}]
23:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification/deadlines",{"children":["",["$","a",null,{"href":"https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification/deadlines","target":"_blank","rel":"noreferrer","children":"PoliMi master's deadlines and fee periods"}]]}],["$","span","https://en.unipv.it/en/education/bachelors-and-masters-degree-programs/how-apply/faq-prospective-students",{"children":[" · ",["$","a",null,{"href":"https://en.unipv.it/en/education/bachelors-and-masters-degree-programs/how-apply/faq-prospective-students","target":"_blank","rel":"noreferrer","children":"Pavia applicant FAQ"}]]}]]]}]
24:["$","section","3-A shortlist budget with no hidden double counting",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"A shortlist budget with no hidden double counting"}],[["$","p","Original example: a student chooses two Pavia programmes. At the documented EUR 35 per programme, the assessment cost is 2 × 35 = EUR 70. Add language tests, translations and payment-provider charges only when actually required and evidenced.",{"children":"Original example: a student chooses two Pavia programmes. At the documented EUR 35 per programme, the assessment cost is 2 × 35 = EUR 70. Add language tests, translations and payment-provider charges only when actually required and evidenced."}],["$","p","Suppose the same student also makes one eligible Padua application under the EUR 60 route. The combined university application budget is EUR 130. This is an illustrative combination, not a package price, acceptance prediction or total cost of studying in Italy.",{"children":"Suppose the same student also makes one eligible Padua application under the EUR 60 route. The combined university application budget is EUR 130. This is an illustrative combination, not a package price, acceptance prediction or total cost of studying in Italy."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"Two Pavia programmes (EUR 70) + one Padua application under the specified route (EUR 60) = EUR 130. Tuition, travel and living costs remain separate."}]]}],"$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.unipd.it/en/studiare-inglese-come-fare-domanda",{"children":["",["$","a",null,{"href":"https://www.unipd.it/en/studiare-inglese-come-fare-domanda","target":"_blank","rel":"noreferrer","children":"Padua English application instructions"}]]}],["$","span","https://en.unipv.it/en/education/bachelors-and-masters-degree-programs/how-apply/faq-prospective-students",{"children":[" · ",["$","a",null,{"href":"https://en.unipv.it/en/education/bachelors-and-masters-degree-programs/how-apply/faq-prospective-students","target":"_blank","rel":"noreferrer","children":"Pavia applicant FAQ"}]]}]]]}],"$undefined"]}]
25:["$","section","4-Refunds and waivers: confirm them before paying",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Refunds and waivers: confirm them before paying"}],[["$","p","A rejection does not automatically produce a refund. Where the call says non-refundable, budget the payment as a cost even if admission is unsuccessful. An annual tuition waiver does not necessarily waive an application fee.",{"children":"A rejection does not automatically produce a refund. Where the call says non-refundable, budget the payment as a cost even if admission is unsuccessful. An annual tuition waiver does not necessarily waive an application fee."}],["$","p","For an unclear rule, ask the admissions or fee office about your exact programme and academic year. Request the official refund/waiver instructions rather than relying on another applicant’s transaction. Do not send money to someone claiming to guarantee an exemption.",{"children":"For an unclear rule, ask the admissions or fee office about your exact programme and academic year. Request the official refund/waiver instructions rather than relying on another applicant’s transaction. Do not send money to someone claiming to guarantee an exemption."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Confirm whether the call explicitly allows a waiver.",{"children":"Confirm whether the call explicitly allows a waiver."}],["$","li","Read what happens after withdrawal, rejection or duplicate payment.",{"children":"Read what happens after withdrawal, rejection or duplicate payment."}],["$","li","Keep any written approval and its conditions.",{"children":"Keep any written approval and its conditions."}],["$","li","Pay through the university’s documented channel.",{"children":"Pay through the university’s documented channel."}]]}],"$undefined","$undefined","$undefined"]}]
26:["$","section","5-When a payment fails or the portal still shows unpaid",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"When a payment fails or the portal still shows unpaid"}],[["$","p","Keep the application reference, payment time, amount and transaction status. Check the university’s stated processing instructions before making another payment. A bank debit and a university receipt can describe different stages of the same transaction.",{"children":"Keep the application reference, payment time, amount and transaction status. Check the university’s stated processing instructions before making another payment. A bank debit and a university receipt can describe different stages of the same transaction."}],["$","p","Contact the published admissions/payment office with the relevant reference and a suitably redacted receipt. Do not share card numbers or login credentials. If a duplicate payment occurred, follow the institution’s refund process; this guide cannot promise a reversal.",{"children":"Contact the published admissions/payment office with the relevant reference and a suitably redacted receipt. Do not share card numbers or login credentials. If a duplicate payment occurred, follow the institution’s refund process; this guide cannot promise a reversal."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
27:["$","section","6-Bologna and no-fee claims need programme-level evidence",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Bologna and no-fee claims need programme-level evidence"}],[["$","p","Do not assign Bologna one application price across all degrees. A course can have its own selection, test or application procedure. The fixed annual component shown on Bologna’s tuition page is not a university-wide application fee.",{"children":"Do not assign Bologna one application price across all degrees. A course can have its own selection, test or application procedure. The fixed annual component shown on Bologna’s tuition page is not a university-wide application fee."}],["$","p","Likewise, a no-application-fee scholarship is not proof that every associated university course has free admission assessment. Compare the award form, university application and tests separately.",{"children":"Likewise, a no-application-fee scholarship is not proof that every associated university course has free admission assessment. Compare the award form, university application and tests separately."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Bologna and no-fee claims need programme-level evidence","children":[["$","$L4","/guides/university-of-bologna-admissions-scholarships/",{"href":"/guides/university-of-bologna-admissions-scholarships/","children":["Bologna programme and fee routes",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/no-application-fee-scholarships/",{"href":"/guides/no-application-fee-scholarships/","children":["No-application-fee funding guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
28:["$","section","7-Before you pay",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Before you pay"}],[["$","p","Record a total you can explain, with one row for each actual payable item. Recheck the current notice at the point of payment because fee amounts and periods can change.",{"children":"Record a total you can explain, with one row for each actual payable item. Recheck the current notice at the point of payment because fee amounts and periods can change."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2d",null,{"id":"guides/italy-university-application-fees:section-8","title":"Check your progress","items":["Correct programme, applicant category and academic year.","Payment covers one programme or the specified number of choices.","Test payment is additional or alternative, as the call states.","Refund and waiver rules read.","Official channel, receipt and application submission saved."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Before you pay","children":[["$","$L4","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Italy study-cost calculator",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/italy-intakes-2027/",{"href":"/guides/italy-intakes-2027/","children":["Italy intake eligibility",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
