1e:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Separate application, test, enrolment and tuition charges",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Separate application, test, enrolment and tuition charges"}],[["$","p","An application or assessment payment funds the evaluation process; it does not reserve an offer or pay the annual university contribution. An entrance-test provider can charge separately, while some university routes substitute a particular test procedure for the usual application payment.",{"children":"An application or assessment payment funds the evaluation process; it does not reserve an offer or pay the annual university contribution. An entrance-test provider can charge separately, while some university routes substitute a particular test procedure for the usual application payment."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Keep four budget lines","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Keep four budget lines"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Charge",{"scope":"col","children":"Charge"}],["$","th","Typical trigger",{"scope":"col","children":"Typical trigger"}],["$","th","Evidence to keep",{"scope":"col","children":"Evidence to keep"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Application / assessment"}],["$","td","1",{"children":"Submitting a programme application"}],["$","td","2",{"children":"Official call, payment unit and receipt"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Entrance test"}],["$","td","1",{"children":"Booking the