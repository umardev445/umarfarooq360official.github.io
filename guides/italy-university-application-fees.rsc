1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/italy-university-application-fees/\",\"name\":\"Italy university application fees: amounts, refunds and payment steps\",\"description\":\"Compare Italian university application fees, payment units, refunds and test charges. Check official sources before budgeting or paying.\",\"url\":\"https://aspirecompass.org/guides/italy-university-application-fees/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/research-20261028/fees-1280.webp\",\"caption\":\"Illustration of application folders, a payment receipt and a calculator on a student’s desk\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Italy university application fees: amounts, refunds and payment steps\",\"item\":\"https://aspirecompass.org/guides/italy-university-application-fees/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"Italy university application fees: amounts, refunds and payment steps\",\"description\":\"Compare Italian university application fees, payment units, refunds and test charges. Check official sources before budgeting or paying.\",\"image\":\"https://aspirecompass.org/images/research-20261028/fees-1280.webp\",\"datePublished\":\"2026-10-28\",\"dateModified\":\"2026-10-28\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/italy-university-application-fees/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Are Italian university application fees refundable?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"There is no universal rule. Padua and the cited PoliTO route describe non-refundable fees; read your own programme’s conditions before paying.\"}},{\"@type\":\"Question\",\"name\":\"Does Pavia charge once for all choices?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The reviewed FAQ states EUR 35 for each programme, with up to three choices per intake.\"}},{\"@type\":\"Question\",\"name\":\"Should I add both PoliMi payment amounts?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The early and standard amounts depend on the payment period; they are not a combined fee.\"}},{\"@type\":\"Question\",\"name\":\"Is Universitaly pre-enrolment a paid university application?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Universitaly pre-enrolment is free and separate from a university’s own application or assessment charges.\"}}]}"}}]],"$L18",false,"$L19","$L1a"]}]
