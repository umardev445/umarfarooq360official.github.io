22:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Does Bilkent accept predicted grades?",{"children":[["$","summary",null,{"children":["Does Bilkent accept predicted grades?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The reviewed international undergraduate application page says predicted grades, results and scores are not evaluated. Confirm the current intake rules before submitting."}]]}],["$","details","Is a 100% tuition waiver the same as a fully funded living package?",{"children":[["$","summary",null,{"children":["Is a 100% tuition waiver the same as a fully funded living package?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Limited accommodation awards are a separate decision, and other living expenses still need to be checked in the written award."}]]}],["$","details","Can I lose a Bilkent scholarship?",{"children":[["$","summary",null,{"children":["Can I lose a Bilkent scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. The published policy sets academic, load, attendance and other conditions. Read the original rules and ask the university about your situation before changing your studies."}]]}]]}]]}]
