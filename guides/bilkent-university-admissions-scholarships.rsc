19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Bilkent evaluates international applicants requesting financial assistance for partial or full tuition waivers. The published award levels run from 20% to 100%; housing support is limited and separate. Meeting an admission minimum does not guarantee a place or scholarship."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Match your final qualification to the accepted list and request financial assistance in the correct application route."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","/countries/turkey/",{"href":"/countries/turkey/","children":["Explore the Turkey study hub",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Bilkent application decisions at a glance",{"href":"#section-1","children":"Bilkent application decisions at a glance"}],["$","a","Admission requirements and the last published intake",{"href":"#section-2","children":"Admission requirements and the last published intake"}],["$","a","Tuition waivers and a