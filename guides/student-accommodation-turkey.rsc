18:T49e,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can international students apply for KYK dormitories?","acceptedAnswer":{"@type":"Answer","text":"Official GSB information includes non-scholarship international students in designated application categories. Check the current period, eligibility conditions and identity/document requirements; a place is not guaranteed."}},{"@type":"Question","name":"Does a Turkish university offer guarantee a dorm room?","acceptedAnswer":{"@type":"Answer","text":"No. Ask about the separate housing application and allocation process. Scholarship room coverage also needs explicit confirmation."}},{"@type":"Question","name":"Are accommodation prices monthly?","acceptedAnswer":{"@type":"Answer","text":"Not always. A quote may cover a semester or teaching year and may be per person, room or whole flat. Keep that unit visible before converting."}},{"@type":"Question","name":"Can I use a room booking as residence address proof?","acceptedAnswer":{"@type":"Answer","text":"Do not assume so. Confirm the accepted document with your university and the migration process before making a commitment."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/student-accommodation-turkey/\",\"name\":\"Student accommodation in Turkey: KYK, dorms and renting\",\"description\":\"Compare KYK/GSB, university and private dorms with shared rentals, including international-student access, contract units, deposits and address evidence.\",\"url\":\"https://aspirecompass.org/guides/student-accommodation-turkey/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-29\",\"dateModified\":\"2026-10-29\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.