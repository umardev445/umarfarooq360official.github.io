2a:["$","section","3-Foundation universities: compare the offer after aid",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Foundation universities: compare the offer after aid"}],[["$","p","Treat the pre-award tuition and net tuition as different figures. A partial waiver reduces a bill; it does not automatically pay rent. For research degrees, examine the particular graduate school’s award rather than importing an undergraduate scholarship label.",{"children":"Treat the pre-award tuition and net tuition as different figures. A partial waiver reduces a bill; it does not automatically pay rent. For research degrees, examine the particular graduate school’s award rather than importing an undergraduate scholarship label."}],["$","p","Ask whether the award lasts through language preparation, whether it applies to every year of the programme and what progress conditions keep it active. The three institution guides below explain different award structures, including Bilkent’s retention conditions and Sabancı’s academic/professional graduate distinction.",{"children":"Ask whether the award lasts through language preparation, whether it applies to every year of the programme and what progress conditions keep it active. The three institution guides below explain different award structures, including Bilkent’s retention conditions and Sabancı’s academic/professional graduate distinction."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Foundation universities: compare the offer after aid","children":[["$","$L4","/guides/sabanci-university-admissions-scholarships/",{"href":"/guides/sabanci-university-admissions-scholarships/","children":["Sabancı scholarships",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/koc-university-admissions-scholarships/",{"href":"/guides/koc-university-admissions-scholarships/","children":["Koç scholarships",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/bilkent-university-admissions-scholarships/",{"href":"/guides/bilkent-university-admissions-scholarships/","children":["Bilkent scholarships",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2b:["$","section","4-Use a three-choice shortlist instead of a long directory",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Use a three-choice shortlist instead of a long directory"}],[["$","p","One ambitious choice, one academically realistic alternative and one affordable fallback can be more useful than twenty unsorted names. They need not be in the same city, but all three should lead to a degree you would accept.",{"children":"One ambitious choice, one academically realistic alternative and one affordable fallback can be more useful than twenty unsorted names. They need not be in the same city, but all three should lead to a degree you would accept."}],["$","p","Original example: a student wants computer engineering in English and has a fixed family budget. They remove programmes with unclear teaching language, then compare accepted school qualifications, net tuition and confirmed housing. Only after those checks do rankings become a useful tie-breaker.",{"children":"Original example: a student wants computer engineering in English and has a fixed family budget. They remove programmes with unclear teaching language, then compare accepted school qualifications, net tuition and confirmed housing. Only after those checks do rankings become a useful tie-breaker."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A shortlist row you can actually act on","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A shortlist row you can actually act on"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Field",{"scope":"col","children":"Field"}],["$","th","What to record",{"scope":"col","children":"What to record"}],["$","th","Reason",{"scope":"col","children":"Reason"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Programme and campus"}],["$","td","1",{"children":"Exact degree title, campus, language"}],["$","td","2",{"children":"Avoid a similar course or different campus"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Admission evidence"}],["$","td","1",{"children":"Accepted exam/diploma, validity, documents"}],["$","td","2",{"children":"Avoid buying an unnecessary test"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Funding gap"}],["$","td","1",{"children":"Net tuition plus living and arrival cost"}],["$","td","2",{"children":"Compare costs after the actual award"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Unresolved condition"}],["$","td","1",{"children":"Question, official owner, reply date"}],["$","td","2",{"children":"Prevent an assumption becoming a decision"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Use a three-choice shortlist instead of a long directory","children":[["$","a","/downloads/turkey-programme-shortlist.csv",{"href":"/downloads/turkey-programme-shortlist.csv","download":true,"children":["Download the programme comparison sheet (CSV)",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2c:["$","section","5-Check recognition before paying a deposit",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Check recognition before paying a deposit"}],[["$","p","Use the official Study in Türkiye portal to find institutions, then go to the university’s own programme listing. If you plan to return to Pakistan, India or another country for a regulated profession, check the relevant professional authority for that exact qualification. Institutional recognition alone may not settle licensing.",{"children":"Use the official Study in Türkiye portal to find institutions, then go to the university’s own programme listing. If you plan to return to Pakistan, India or another country for a regulated profession, check the relevant professional authority for that exact qualification. Institutional recognition alone may not settle licensing."}],["$","p","Keep the offer, fee and refund conditions together. If an intermediary recommends an institution, verify the same course, price and application route directly with the university before making a payment.",{"children":"Keep the offer, fee and refund conditions together. If an intermediary recommends an institution, verify the same course, price and application route directly with the university before making a payment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.studyinturkiye.gov.tr/",{"children":["",["$","a",null,{"href":"https://www.studyinturkiye.gov.tr/","target":"_blank","rel":"noreferrer","children":"Official Study in Türkiye portal"}]]}]]]}],"$undefined"]}]
2d:["$","section","6-Your final comparison check",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Your final comparison check"}],[["$","p","A shortlist is ready when each row has enough evidence to choose the next application action.",{"children":"A shortlist is ready when each row has enough evidence to choose the next application action."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2e",null,{"id":"guides/universities-in-turkey-for-international-students:section-7","title":"Check your progress","items":["The institution and exact degree appear on official pages.","The applicant category fits my citizenship and school history.","I have confirmed language and accepted qualification evidence.","I have a comparable cost after written funding, including housing.","I know what is due next and which office answers remaining questions."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Your final comparison check","children":[["$","$L4","/guides/turkey-university-tuition-fees/",{"href":"/guides/turkey-university-tuition-fees/","children":["Compare tuition and fee units",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/cost-of-living-in-turkey-for-students/",{"href":"/guides/cost-of-living-in-turkey-for-students/","children":["Choose an arrival budget",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
