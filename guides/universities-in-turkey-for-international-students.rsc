24:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Public universities: what to compare first",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Public universities: what to compare first"}],[["$","p","An international quota is a separate admission category. Do not read a domestic central-placement score or a Turkish-citizen fee as the rule for your application. Check citizenship history and where you completed secondary school before choosing the route.",{"children":"An international quota is a separate admission category. Do not read a domestic central-placement score or a Turkish-citizen fee as the rule for your application. Check citizenship history and where you completed secondary school before choosing the route."}],["$","p","For a public-university shortlist, collect four documents: the accepted qualifications list, the programme/quota table, the fee schedule for your entry cohort and the language policy. A low headline tuition has little value if the course is unavailable in your language or your result is not accepted.",{"children":"For a public-university shortlist, collect four documents: the accepted qualifications list, the programme/quota table, the fee schedule for your entry cohort and the language policy. A low headline tuition has little value if the course is unavailable in your language or your result is not accepted."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Public universities: what to compare first","children":[["$","$L4","/guides/tr-yos-exam/",{"href":"/guides/tr-yos-exam/","children":["TR-YÖS and university applications",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/turkey-university-admission-