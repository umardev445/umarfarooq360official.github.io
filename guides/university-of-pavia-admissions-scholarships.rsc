29:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","What is the Pavia application fee?",{"children":[["$","summary",null,{"children":["What is the Pavia application fee?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The university’s checked prospective-student FAQ states €35 for each selected bachelor’s or master’s programme. Check the exact programme call and portal before payment."}]]}],["$","details","Can I use an EDISU Piemonte application for Pavia?",{"children":[["$","summary",null,{"children":["Can I use an EDISU Piemonte application for Pavia?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Pavia has its own EDiSU authority. Use the official funding route linked by Pavia for your intended course and academic year."}]]}],["$","details","Does every Pavia scholarship cover living costs?",{"children":[["$","summary",null,{"children":["Does every Pavia scholarship cover living costs?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. A fee reduction, tuition waiver and regional benefit can cover different costs. Read each named call and calculate the remaining expenses."}]]}],["$","details","Can I use last year’s calendar for the next intake?",{"children":[["$","summary",null,{"children":["Can I use last year’s calendar for the next intake?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Use it only to understand the sequence. A previous deadline is not confirmation that the next cycle has the same dates or is open."}]]}]]}]]}]
