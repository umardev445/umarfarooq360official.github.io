26:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","What does VPD mean?",{"children":[["$","summary",null,{"children":["What does VPD mean?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"VPD is preliminary review documentation: an assessment of educational qualifications prepared for a particular university. It is not an admission offer."}]]}],["$","details","How long does a VPD take?",{"children":[["$","summary",null,{"children":["How long does a VPD take?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"uni-assist describes a usual processing period of four to six weeks and recommends requesting it ideally at least eight weeks before the university deadline. Incomplete documents and queries can delay it."}]]}],["$","details","How long is a VPD valid?",{"children":[["$","summary",null,{"children":["How long is a VPD valid?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The general uni-assist rule is one year. Check the receiving university’s specific acceptance policy; TUM describes a conditional three-year acceptance period for its own VPD."}]]}],["$","details","Can I use a VPD for another university?",{"children":[["$","summary",null,{"children":["Can I use a VPD for another university?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Do not assume so. It is issued for a particular university, and TUM explicitly rejects a VPD requested for another institution."}]]}],["$","details","Can I submit the VPD after the deadline?",{"children":[["$","summary",null,{"children":["Can I submit the VPD after the deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Only if the university’s current rules explicitly allow your situation. A conditional TUM placeholder procedure must not be applied to other institutions."}]]}]]}]]}]
