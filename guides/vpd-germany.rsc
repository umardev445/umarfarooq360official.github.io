19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/research-2026-10/vpd-1280.webp","srcSet":"/images/research-2026-10/vpd-640.webp 640w, /images/research-2026-10/vpd-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Conceptual illustration for vpd for germany: meaning, processing time and university submission","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Original conceptual illustration; not a photograph of a named university or scholarship recipient."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"VPD means preliminary review documentation. uni-assist issues it for a particular university to assess your educational qualifications. It is not an admission offer and normally must be submitted in a separate application to that university."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Confirm that your programme requires a VPD, then record both the assessment task and the university submission deadline."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","#official-sources",{"href":"#official-sources","children":["Official sources",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/team/hafiz-umar-farooq/",{"href":"/team/hafiz-umar-farooq/","children":["Editorial contact",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","VPD result versus an application receipt",{"href":"#section-1","children":"VPD result versus an application receipt"}],["$","a","What the VPD does—and what remains undecided",{"href":"#section-2","children":"What the VPD does—and what remains undecided"}],["$","a","Check the receiving university and qualification category",{"href":"#section-3","children":"Check the receiving university and qualification category"}],["$","a","Give processing time a realistic buffer",{"href":"#section-4","children":"Give processing time a realistic buffer"}],["$","a","Understand validity without mixing institution rules",{"href":"#section-5","children":"Understand validity without mixing institution rules"}],["$","a","A delayed VPD is governed by the university’s rule",{"href":"#section-6","children":"A delayed VPD is governed by the university’s rule"}],["$","a","Upload the assessment and check the final status",{"href":"#section-7","children":"Upload the assessment and check the final status"}],["$","a","Keep fee and document questions in the right workflow",{"href":"#section-8","children":"Keep fee and document questions in the right workflow"}],["$","a","Before you move on to visa and funding plans",{"href":"#section-9","children":"Before you move on to visa and funding plans"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-VPD result versus an application receipt",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"VPD result versus an application receipt"}],[["$","p","A VPD is a preliminary review document. Keep the VPD request, the issued document and the university submission as three separate records; paying for the review does not prove that you applied to the course.",{"children":"A VPD is a preliminary review document. Keep the VPD request, the issued document and the university submission as three separate records; paying for the review does not prove that you applied to the course."}]],"$undefined","$L1b","$undefined","$undefined","$undefined","$undefined","$undefined","$L1c"]}],"$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}],false,"$L25","$L26"]}],"$L27"]}]
