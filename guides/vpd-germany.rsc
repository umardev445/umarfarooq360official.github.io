1c:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for VPD result versus an application receipt","children":[["$","$L4","/guides/germany-university-application-deadlines/",{"href":"/guides/germany-university-application-deadlines/","children":["Plan Germany application deadlines",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/uni-assist-application/",{"href":"/guides/uni-assist-application/","children":["Compare the standard uni-assist process",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
1d:["$","section","1-What the VPD does—and what remains undecided",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"What the VPD does—and what remains undecided"}],[["$","p","The assessment helps the receiving university interpret your educational background. It does not select your course, award a scholarship or establish that a language requirement has been satisfied. Read the document as qualification evidence rather than a final admission result.",{"children":"The assessment helps the receiving university interpret your educational background. It does not select your course, award a scholarship or establish that a language requirement has been satisfied. Read the document as qualification evidence rather than a final admission result."}],["$","p","Keep three separate records: the VPD request, the university application and the eventual admission decision. This avoids a common mistake: waiting for an offer from an assessment service when the university has not yet received an application.",{"children":"Keep three separate records: the VPD request, the university application and the eventual admission decision. This avoids a common mistake: waiting for an offer from an assessment service when the university has not yet received an application."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"VPD versus admission: separate the responsibilities","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"VPD versus admission: separate the responsibilities"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Stage",{"scope":"col","children":"Stage"}],["$","th","Purpose",{"scope":"col","children":"Purpose"}],["$","th","Still needed afterwards",{"scope":"col","children":"Still needed afterwards"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"VPD request"}],["$","td","1",{"children":"Assessment for the named university"}],["$","td","2",{"children":"The university’s own application steps"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"University application"}],["$","td","1",{"children":"Programme and applicant assessment"}],["$","td","2",{"children":"Selection result and any conditions"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Admission offer"}],["$","td","1",{"children":"University decision under stated conditions"}],["$","td","2",{"children":"Acceptance, enrolment and practical preparation"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://www.uni-assist.de/en/how-to-apply/plan-your-application/vpd/","target":"_blank","rel":"noreferrer","children":"Official guidance"}]]}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","2-Check the receiving university and qualification category",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Check the receiving university and qualification category"}],[["$","p","Use the institution’s admission page for your degree level and qualification country. A requirement for a foreign bachelor’s qualification is not necessarily the same as the rule for a school-leaving certificate. Some applicant groups have exceptions; copying a friend’s workflow can produce the wrong request.",{"children":"Use the institution’s admission page for your degree level and qualification country. A requirement for a foreign bachelor’s qualification is not necessarily the same as the rule for a school-leaving certificate. Some applicant groups have exceptions; copying a friend’s workflow can produce the wrong request."}],["$","p","uni-assist issues the VPD for a specific university. Keep the exact institution name in your application tracker and check it on the resulting document. TUM explicitly states that it does not accept a VPD requested for another university.",{"children":"uni-assist issues the VPD for a specific university. Keep the exact institution name in your application tracker and check it on the resulting document. TUM explicitly states that it does not accept a VPD requested for another university."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.uni-assist.de/en/how-to-apply/plan-your-application/vpd/",{"children":["",["$","a",null,{"href":"https://www.uni-assist.de/en/how-to-apply/plan-your-application/vpd/","target":"_blank","rel":"noreferrer","children":"General VPD procedure"}]]}],["$","span","https://www.tum.de/en/studies/application/application-info-portal/uni-assist",{"children":[" · ",["$","a",null,{"href":"https://www.tum.de/en/studies/application/application-info-portal/uni-assist","target":"_blank","rel":"noreferrer","children":"TUM VPD applicant categories and institution requirement"}]]}]]]}],"$undefined"]}]
1f:["$","section","3-Give processing time a realistic buffer",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Give processing time a realistic buffer"}],[["$","p","uni-assist describes usual VPD processing as four to six weeks and recommends applying ideally at least eight weeks before the university’s deadline. Use this to plan early, not to promise an exact completion date. Missing educational evidence and clarification requests can make a late request especially risky.",{"children":"uni-assist describes usual VPD processing as four to six weeks and recommends applying ideally at least eight weeks before the university’s deadline. Use this to plan early, not to promise an exact completion date. Missing educational evidence and clarification requests can make a late request especially risky."}],["$","p","An illustrative plan for a hypothetical 15 July university deadline would place the VPD request around mid-May or earlier, document collection before that and a final portal check before July. This is an example, not a published deadline for your programme. Replace every date with your course’s actual window.",{"children":"An illustrative plan for a hypothetical 15 July university deadline would place the VPD request around mid-May or earlier, document collection before that and a final portal check before July. This is an example, not a published deadline for your programme. Replace every date with your course’s actual window."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L28",null,{"id":"guides/vpd-germany:section-4","title":"Check your progress","items":["The university deadline is recorded with its time zone.","Document collection starts before my VPD target date.","I allow time to answer an assessment query.","The university portal is prepared while I wait.","I know the institution’s rule if the final VPD is delayed."]}],["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.uni-assist.de/en/how-to-apply/plan-your-application/vpd/",{"children":["",["$","a",null,{"href":"https://www.uni-assist.de/en/how-to-apply/plan-your-application/vpd/","target":"_blank","rel":"noreferrer","children":"Official processing estimate and recommended buffer"}]]}]]]}],"$undefined"]}]
20:["$","section","4-Understand validity without mixing institution rules",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Understand validity without mixing institution rules"}],[["$","p","The general uni-assist page describes a VPD as valid for one year from issue. An individual university can explain its own acceptance conditions. TUM, for example, states that it accepts its VPD for three years provided the relevant entrance qualification and admission requirements have not changed.",{"children":"The general uni-assist page describes a VPD as valid for one year from issue. An individual university can explain its own acceptance conditions. TUM, for example, states that it accepts its VPD for three years provided the relevant entrance qualification and admission requirements have not changed."}],["$","p","These are different scopes, not permission to use any old VPD everywhere. Before reusing a document, check the target university, issue date, qualification changes and the current programme instructions. If you completed a new degree after the assessment, ask whether an updated evaluation is needed.",{"children":"These are different scopes, not permission to use any old VPD everywhere. Before reusing a document, check the target university, issue date, qualification changes and the current programme instructions. If you completed a new degree after the assessment, ask whether an updated evaluation is needed."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Validity checks for reuse","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Validity checks for reuse"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Question",{"scope":"col","children":"Question"}],["$","th","Why it matters",{"scope":"col","children":"Why it matters"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Was it issued for this university?"}],["$","td","1",{"children":"A document for another institution may not be accepted"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"When was it issued?"}],["$","td","1",{"children":"General validity and university acceptance conditions differ"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Has my qualification changed?"}],["$","td","1",{"children":"The assessment may not reflect the latest evidence"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Have admission requirements changed?"}],["$","td","1",{"children":"An earlier document may no longer fit the current procedure"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.uni-assist.de/en/how-to-apply/plan-your-application/vpd/",{"children":["",["$","a",null,{"href":"https://www.uni-assist.de/en/how-to-apply/plan-your-application/vpd/","target":"_blank","rel":"noreferrer","children":"uni-assist general validity rule"}]]}],["$","span","https://www.tum.de/en/studies/application/application-info-portal/uni-assist",{"children":[" · ",["$","a",null,{"href":"https://www.tum.de/en/studies/application/application-info-portal/uni-assist","target":"_blank","rel":"noreferrer","children":"TUM three-year acceptance condition"}]]}]]]}],"$undefined"]}]
21:["$","section","5-A delayed VPD is governed by the university’s rule",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"A delayed VPD is governed by the university’s rule"}],[["$","p","Do not assume every institution allows you to submit the assessment later. If the final document is required by the deadline, an early request alone may not satisfy that condition. Read the university’s current wording or ask admissions before relying on a placeholder.",{"children":"Do not assume every institution allows you to submit the assessment later. If the final document is required by the deadline, an early request alone may not satisfy that condition. Read the university’s current wording or ask admissions before relying on a placeholder."}],["$","p","TUM publishes a conditional route using its signed confirmation form when a complete VPD request was made in time. Its page also sets the applicable deadlines and grace periods. This is a TUM procedure, not a general German rule, and it does not excuse a late or incomplete original request.",{"children":"TUM publishes a conditional route using its signed confirmation form when a complete VPD request was made in time. Its page also sets the applicable deadlines and grace periods. This is a TUM procedure, not a general German rule, and it does not excuse a late or incomplete original request."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.tum.de/en/studies/application/application-info-portal/uni-assist",{"children":["",["$","a",null,{"href":"https://www.tum.de/en/studies/application/application-info-portal/uni-assist","target":"_blank","rel":"noreferrer","children":"Read TUM’s complete form and deadline conditions"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for A delayed VPD is governed by the university’s rule","children":[["$","$L4","/guides/technical-university-of-munich-admissions-scholarships/",{"href":"/guides/technical-university-of-munich-admissions-scholarships/","children":["TUM application guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
22:["$","section","6-Upload the assessment and check the final status",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Upload the assessment and check the final status"}],[["$","p","When the VPD becomes available, read it before uploading. Match your identity, qualification and target university; retain the original electronic file. Follow the university’s requested upload field and check whether replacing a placeholder needs another action.",{"children":"When the VPD becomes available, read it before uploading. Match your identity, qualification and target university; retain the original electronic file. Follow the university’s requested upload field and check whether replacing a placeholder needs another action."}],["$","p","Save a university submission confirmation, not just the uni-assist result. If the portal marks a document as pending or not accepted, read the explanatory message. A status can describe a missing final document rather than an academic rejection, but it still requires attention.",{"children":"Save a university submission confirmation, not just the uni-assist result. If the portal marks a document as pending or not accepted, read the explanatory message. A status can describe a missing final document rather than an academic rejection, but it still requires attention."}]],["$","ol",null,{"className":"process-steps","aria-label":"Upload the assessment and check the final status","children":[["$","li","Download and read the issued VPD.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Download and read the issued VPD."}]]}],["$","li","Check the university and qualification details.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Check the university and qualification details."}]]}],["$","li","Upload it in the university’s own application.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Upload it in the university’s own application."}]]}],["$","li","Replace any permitted placeholder as instructed.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Replace any permitted placeholder as instructed."}]]}],["$","li","Confirm completion and save the final portal record.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Confirm completion and save the final portal record."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","7-Keep fee and document questions in the right workflow",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Keep fee and document questions in the right workflow"}],[["$","p","A VPD request has a handling charge under the applicable uni-assist schedule; it is not a tuition payment. Use the application guide for the current course-based fee examples rather than paying an intermediary who promises a faster result.",{"children":"A VPD request has a handling charge under the applicable uni-assist schedule; it is not a tuition payment. Use the application guide for the current course-based fee examples rather than paying an intermediary who promises a faster result."}],["$","p","Keep assessment documents distinct from essays, references and programme-specific material. The university may need evidence that the assessment service does not. This separation makes it easier to correct an incomplete file without sending unnecessary personal information.",{"children":"Keep assessment documents distinct from essays, references and programme-specific material. The university may need evidence that the assessment service does not. This separation makes it easier to correct an incomplete file without sending unnecessary personal information."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Keep fee and document questions in the right workflow","children":[["$","$L4","/guides/uni-assist-application/",{"href":"/guides/uni-assist-application/","children":["uni-assist fees, documents and submission",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/study-in-germany-admission-requirements/",{"href":"/guides/study-in-germany-admission-requirements/","children":["Germany admission requirements",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
24:["$","section","8-Before you move on to visa and funding plans",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Before you move on to visa and funding plans"}],[["$","p","Treat an issued VPD as progress, not as a confirmed place. Build your budget and practical timeline around the actual offer, admission conditions and intended enrolment. Do not book non-refundable travel just because the qualification assessment is complete.",{"children":"Treat an issued VPD as progress, not as a confirmed place. Build your budget and practical timeline around the actual offer, admission conditions and intended enrolment. Do not book non-refundable travel just because the qualification assessment is complete."}],["$","p","For a shortlist containing several German universities, keep one deadline row per institution. Include the assessment requirement, application portal, funding route and any later enrolment evidence. A single country-level calendar cannot replace these course-specific tasks.",{"children":"For a shortlist containing several German universities, keep one deadline row per institution. Include the assessment requirement, application portal, funding route and any later enrolment evidence. A single country-level calendar cannot replace these course-specific tasks."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Before you move on to visa and funding plans","children":[["$","$L4","/countries/germany/",{"href":"/countries/germany/","children":["Germany study pathway",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/germany-university-application-deadlines/",{"href":"/guides/germany-university-application-deadlines/","children":["Germany deadline planning",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/germany-blocked-account-calculator/",{"href":"/tools/germany-blocked-account-calculator/","children":["Germany funding-gap calculator",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
25:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://www.uni-assist.de/en/how-to-apply/plan-your-application/vpd/",{"href":"https://www.uni-assist.de/en/how-to-apply/plan-your-application/vpd/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"uni-assist VPD: purpose, request, timing and submission"}],["$","span",null,{"children":"Checked 20 October 2026; the named programme and cycle control the rule."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://www.tum.de/en/studies/application/application-info-portal/uni-assist",{"href":"https://www.tum.de/en/studies/application/application-info-portal/uni-assist","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"TUM VPD: exceptions, deadlines, conditional placeholder and validity"}],["$","span",null,{"children":"Checked 20 October 2026; the named programme and cycle control the rule."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$25:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://www.uni-assist.de/en/how-to-apply/apply-online/pay-submit/",{"href":"https://www.uni-assist.de/en/how-to-apply/apply-online/pay-submit/",