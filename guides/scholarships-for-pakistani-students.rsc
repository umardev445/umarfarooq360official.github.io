20:["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Commonwealth"}],["$","td","1",{"children":"Eligible degree, nomination and national process"}],["$","td","2",{"children":"Commission plus applicable nominating body"}]],["$","td",null,{"children":["$","$L4",null,{"href":"/scholarships/commonwealth/","target":"$undefined","rel":"$undefined","children":["Commonwealth"," ↗"]}]}]]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Stipendium Hungaricum"}],["$","td","1",{"children":"Sending-partner and eligible study options"}],["$","td","2",{"children":"Scholarship portal plus partner route"}]],["$","td",null,{"children":["$","$L4",null,{"href":"/scholarships/stipendium-hungaricum/","target":"$undefined","rel":"$undefined","children":["Stipendium"," ↗"]}]}]]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"MEXT"}],["$","td","1",{"children":"Category and embassy/university route"}],["$","td","2",{"children":"Responsible mission or university"}]],["$","td",null,{"children":["$","$L4",null,{"href":"/guides/mext-application-routes/","target":"$undefined","rel":"$undefined","children":["MEXT"," ↗"]}]}]]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"University / consortium award"}],["$","td","1",{"children":"Nationality, degree and exact programme"}],["$","td","2",{"children":"Institution or consortium"}]],["$","td",null,{"children":["$","$L4",null,{"href":"/scholarships/","target":"$undefined","rel":"$undefined","children":["Compare degrees"," ↗"]}]}]]}]]}]
21:["$","section","1-Scholarships Pakistani applicants can research now",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Scholarships Pakistani applicants can research now"}],[["$","p","The published Chevening 2027–2028 application deadline was 6 October 2026 at 11:00 UTC; check the official timeline for subsequent stages or the next cycle. Commonwealth Master's and eligible PhD routes for 2027–2028 are also open, with a central deadline of 20 October 2026 at 16:00 BST; the relevant nominator can impose its own process. KAUST's Spring 2027 PhD deadline has passed, while its Fall 2027 MS, MS/PhD and PhD round opened on 28 September 2026 and closes on 3 January 2027.",{"children":"The published Chevening 2027–2028 application deadline was 6 October 2026 at 11:00 UTC; check the official timeline for subsequent stages or the next cycle. Commonwealth Master's and eligible PhD routes for 2027–2028 are also open, with a central deadline of 20 October 2026 at 16:00 BST; the relevant nominator can impose its own process. KAUST's Spring 2027 PhD deadline has passed, while its Fall 2027 MS, MS/PhD and PhD round opened on 28 September 2026 and closes on 3 January 2027."}],["$","p","Erasmus Mundus Joint Masters normally accept applications between October and January, but every consortium sets its own dates and criteria. DAAD EPOS uses course-specific deadlines and normally expects at least two years of relevant professional experience. Fulbright, MEXT and Stipendium Hungaricum use country, embassy, university or sending-partner processes, so a general global date is not enough.",{"children":"Erasmus Mundus Joint Masters normally accept applications between October and January, but every consortium sets its own dates and criteria. DAAD EPOS uses course-specific deadlines and normally expects at least two years of relevant professional experience. Fulbright, MEXT and Stipendium Hungaricum use country, embassy, university or sending-partner processes, so a general global date is not enough."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Chevening: one-year eligible UK master's route",{"children":"Chevening: one-year eligible UK master's route"}],["$","li","Commonwealth: development-focused UK postgraduate routes",{"children":"Commonwealth: development-focused UK postgraduate routes"}],["$","li","Erasmus Mundus: multi-university joint master's programmes",{"children":"Erasmus Mundus: multi-university joint master's programmes"}],["$","li","DAAD EPOS: development-related postgraduate courses in Germany",{"children":"DAAD EPOS: development-related postgraduate courses in Germany"}],["$","li","KAUST: funded STEM master's and PhD study",{"children":"KAUST: funded STEM master's and PhD study"}],["$","li","Fulbright and MEXT: locally administered government routes",{"children":"Fulbright and MEXT: locally administered government routes"}]]}],"$undefined","$undefined","$undefined"]}]
22:["$","section","2-Open does not automatically mean eligible",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Open does not automatically mean eligible"}],[["$","p","Check citizenship and residence, degree completion date, academic level, work experience, intended subject and return or impact commitments. For Commonwealth awards, confirm that Pakistan appears in the eligible-country list for the exact Master's or PhD route and follow the approved nominator process. For Chevening, test your profile against the current eligibility rules and eligible course requirements before writing essays.",{"children":"Check citizenship and residence, degree completion date, academic level, work experience, intended subject and return or impact commitments. For Commonwealth awards, confirm that Pakistan appears in the eligible-country list for the exact Master's or PhD route and follow the approved nominator process. For Chevening, test your profile against the current eligibility rules and eligible course requirements before writing essays."}],["$","p","For DAAD EPOS, the professional-experience requirement and eligible-course list are central. For Erasmus Mundus, the consortium—not a general Erasmus portal—controls programme eligibility and selection. For KAUST, match your academic preparation to the available science and engineering fields and submit through the current admissions process.",{"children":"For DAAD EPOS, the professional-experience requirement and eligible-course list are central. For Erasmus Mundus, the consortium—not a general Erasmus portal—controls programme eligibility and selection. For KAUST, match your academic preparation to the available science and engineering fields and submit through the current admissions process."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","3-Build a priority plan from current deadlines",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Build a priority plan from current deadlines"}],[["$","p","First complete Chevening and Knight-Hennessy before their 6 October deadlines only if the separate university routes fit your plan. Then prioritise the Commonwealth process before 20 October, allowing time for any nominating body requirements. KAUST's Fall 2027 round remains a later option with a stated 3 January 2027 deadline for MS, MS/PhD and PhD applicants.",{"children":"First complete Chevening and Knight-Hennessy before their 6 October deadlines only if the separate university routes fit your plan. Then prioritise the Commonwealth process before 20 October, allowing time for any nominating body requirements. KAUST's Fall 2027 round remains a later option with a stated 3 January 2027 deadline for MS, MS/PhD and PhD applicants."}],["$","p","Do not apply only because a date is close. A rushed ineligible application has no strategic value. Keep later Erasmus Mundus, DAAD and institution-funded programmes in a second calendar, with official programme pages saved and documents prepared early.",{"children":"Do not apply only because a date is close. A rushed ineligible application has no strategic value. Keep later Erasmus Mundus, DAAD and institution-funded programmes in a second calendar, with official programme pages saved and documents prepared early."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Confirm the exact intake and status today",{"children":"Confirm the exact intake and status today"}],["$","li","Identify every portal or nominating body",{"children":"Identify every portal or nominating body"}],["$","li","Ask referees before drafting final essays",{"children":"Ask referees before drafting final essays"}],["$","li","Prepare verified degrees and transcripts",{"children":"Prepare verified degrees and transcripts"}],["$","li","Convert all deadlines to Pakistan Standard Time",{"children":"Convert all deadlines to Pakistan Standard Time"}],["$","li","Submit before the last day and save receipts",{"children":"Submit before the last day and save receipts"}]]}],"$undefined","$undefined","$undefined"]}]
24:["$","section","4-Documents Pakistani students should organise early",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Documents Pakistani students should organise early"}],[["$","p","Use the name and date of birth shown on your passport consistently. Keep clear degree and transcript scans, an official grading-scale explanation, employment evidence where required, referee contact details and certified translations for any document not accepted in its original language.",{"children":"Use the name and date of birth shown on your passport consistently. Keep clear degree and transcript scans, an official grading-scale explanation, employment evidence where required, referee contact details and certified translations for any document not accepted in its original language."}],["$","p","Attestation, equivalence, nomination and testing rules are programme-specific. HEC, IBCC, a university, an embassy or another authority may be involved depending on the qualification and route, but no single checklist applies to every scholarship. Follow the current official call and each portal's document instructions.",{"children":"Attestation, equivalence, nomination and testing rules are programme-specific. HEC, IBCC, a university, an embassy or another authority may be involved depending on the qualification and route, but no single checklist applies to every scholarship. Follow the current official call and each portal's document instructions."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Valid passport or accepted identity document",{"children":"Valid passport or accepted identity document"}],["$","li","Degrees, transcripts and result evidence",{"children":"Degrees, transcripts and result evidence"}],["$","li","Institutional grading scale or CGPA explanation",{"children":"Institutional grading scale or CGPA explanation"}],["$","li","Employment letters with dates and duties",{"children":"Employment letters with dates and duties"}],["$","li","Language evidence accepted by the chosen course",{"children":"Language evidence accepted by the chosen course"}],["$","li","References submitted through the required channel",{"children":"References submitted through the required channel"}],["$","li","Research proposal for relevant doctoral routes",{"children":"Research proposal for relevant doctoral routes"}]]}],"$undefined","$undefined","$undefined"]}]
25:["$","section","5-English-language requirements are separate decisions",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"English-language requirements are separate decisions"}],[["$","p","A scholarship may not impose one universal IELTS score while the university still requires language evidence. Check the scholarship, selected course and visa process separately. Possible alternatives such as TOEFL, PTE, a Medium of Instruction letter or an institutional assessment are accepted only when the responsible institution says so for your intake.",{"children":"A scholarship may not impose one universal IELTS score while the university still requires language evidence. Check the scholarship, selected course and visa process separately. Possible alternatives such as TOEFL, PTE, a Medium of Instruction letter or an institutional assessment are accepted only when the responsible institution says so for your intake."}],["$","p","Do not rely on a headline promising a scholarship without IELTS. Obtain written confirmation and consider whether one recognised test would keep more strong-fit programmes open across your full shortlist.",{"children":"Do not rely on a headline promising a scholarship without IELTS. Obtain written confirmation and consider whether one recognised test would keep more strong-fit programmes open across your full shortlist."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","6-Important CERN eligibility warning for Pakistani nationals",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Important CERN eligibility warning for Pakistani nationals"}],[["$","p","CERN's current Short-Term Internship and Origin Programme pages state that candidates of several nationalities, including Pakistani nationals, cannot currently be considered because the applicable nationality ceiling has been reached. This is a current programme condition, not a judgement about an applicant's qualifications.",{"children":"CERN's current Short-Term Internship and Origin Programme pages state that candidates of several nationalities, including Pakistani nationals, cannot currently be considered because the applicable nationality ceiling has been reached. This is a current programme condition, not a judgement about an applicant's qualifications."}],["$","p","Rules can change, so reopen the official CERN page before a future application. Do not pay an intermediary who claims to bypass a nationality or membership condition, and do not present CERN as currently available to Pakistani applicants when the programme page says otherwise.",{"children":"Rules can change, so reopen the official CERN page before a future application. Do not pay an intermediary who claims to bypass a nationality or membership condition, and do not present CERN as currently available to Pakistani applicants when the programme page says otherwise."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
27:["$","section","7-How to write a Pakistan-to-programme fit argument",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"How to write a Pakistan-to-programme fit argument"}],[["$","p","Avoid a generic promise to help Pakistan. Define a problem you understand through study, work or service, show what you have already done, name the skill or network gap the programme addresses and describe a realistic next step after the award.",{"children":"Avoid a generic promise to help Pakistan. Define a problem you understand through study, work or service, show what you have already done, name the skill or network gap the programme addresses and describe a realistic next step after the award."}],["$","p","A credible plan may focus on a sector, institution, research question, community or professional practice. Use evidence at the scale you can support. Scholarship selectors can distinguish a thoughtful sequence from an oversized impact claim written only for the application.",{"children":"A credible plan may focus on a sector, institution, research question, community or professional practice. Use evidence at the scale you can support. Scholarship selectors can distinguish a thoughtful sequence from an oversized impact claim written only for the application."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
28:["$","section","8-Avoid agents, copied essays and false guarantees",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Avoid agents, copied essays and false guarantees"}],[["$","p","Major scholarship programmes publish their official routes. Nobody can guarantee selection, and an applicant remains responsible for truthful documents and original responses. Verify every fee on the programme or university domain, never send money to a personal account and do not give an agent access to your email or one-time codes.",{"children":"Major scholarship programmes publish their official routes. Nobody can guarantee selection, and an applicant remains responsible for truthful documents and original responses. Verify every fee on the programme or university domain, never send money to a personal account and do not give an agent access to your email or one-time codes."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","9-Build a Pakistan-specific eligibility map",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"Build a Pakistan-specific eligibility map"}],[["$","p","Start with the programme owner's country eligibility. Chevening applicants follow the UK scholarship and university routes. Stipendium Hungaricum applicants may need a Pakistan sending-partner process as well as the Hungarian application. MEXT embassy recommendation is organised by the Japanese mission in Pakistan, while university recommendation is handled through a participating Japanese institution.",{"children":"Start with the programme owner's country eligibility. Chevening applicants follow the UK scholarship and university routes. Stipendium Hungaricum applicants may need a Pakistan sending-partner process as well as the Hungarian application. MEXT embassy recommendation is organised by the Japanese mission in Pakistan, while university recommendation is handled through a participating Japanese institution."}],["$","p","For a Canadian undergraduate award such as Pearson, the student's own school nomination can be the first deadline. These routes have different decision makers; an HEC notice is relevant only where the particular award requires it.",{"children":"For a Canadian undergraduate award such as Pearson, the student's own school nomination can be the first deadline. These routes have different decision makers; an HEC notice is relevant only where the particular award requires it."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Nationality and residence evidence",{"children":"Nationality and residence evidence"}],["$","li","Scholarship portal and local partner",{"children":"Scholarship portal and local partner"}],["$","li","Current HEC notice when relevant",{"children":"Current HEC notice when relevant"}],["$","li","Exact university and degree eligibility",{"children":"Exact university and degree eligibility"}],["$","li","English-language evidence at each stage",{"children":"English-language evidence at each stage"}],["$","li","Funds still needed despite the award",{"children":"Funds still needed despite the award"}]]}],"$undefined","$undefined","$undefined"]}]
2a:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://www.chevening.org/scholarships/application-timeline/",{"href":"https://www.chevening.org/scholarships/application-timeline/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Chevening application timeline"}],["$","span",null,{"children":"Official 2027–2028 dates"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://cscuk.fcdo.gov.uk/scholarships/commonwealth-masters-scholarships/",{"href":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-masters-scholarships/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Commonwealth Master's Scholarships"}],["$","span",null,{"children":"Current eligibility, nomination and benefits"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$2a:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://cscuk.fcdo.gov.uk/scholarships/commonwealth-phd-scholarships-for-least-developed-countries-and-vulnerable-states/",{"href":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-phd-scholarships-for-least-developed-countries-and-vulnerable-states/","target":"_blank","rel":"noreferrer","children"