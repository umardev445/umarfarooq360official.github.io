1b:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/programme-research-editorial.webp","srcSet":"$undefined","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Students working through programme information and application notes","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Use the guide to organise your next decision, then check the official source."}]]}],false,["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Pakistani students can compete for major government, university and consortium funding, but each route uses different nomination, admission, experience and document rules. This guide helps you build an eligibility-first 2027 shortlist from official sources."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Start with the comparison or checklist below, then open the current instructions for your exact programme or route."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Choose the submission route for your profile",{"href":"#section-1","children":"Choose the submission route for your profile"}],["$","a","Scholarships Pakistani applicants can research now",{"href":"#section-2","children":"Scholarships Pakistani applicants can research now"}],["$","a","Open does not automatically mean eligible",{"href":"#section-3","children":"Open does not automatically mean eligible"}],["$","a","Build a priority plan from current deadlines",{"href":"#sectio