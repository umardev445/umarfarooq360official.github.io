1c:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Pakistan applicant routes: status at the review date","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Pakistan applicant routes: status at the review date"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route",{"scope":"col","children":"Route"}],["$","th","Cycle/status",{"scope":"col","children":"Cycle/status"}],["$","th","Your next action",{"scope":"col","children":"Your next action"}]],["$","th",null,{"scope":"col","children":"Next step"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Chevening Pakistan"}],["$","td","1",{"children":"2027–2028: closed"}],["$","td","2",{"children":"Existing applicants: follow selection and course-offer tasks; future applicants: wait for the next call."}]],["$","td",null,{"children":["$","$L4",null,{"href":"https://www.chevening.org/scholarship/pakistan/","target":"_blank","rel":"noreferrer","children":["Official source"," ↗"]}]}]]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Commonwealth Master’s"}],["$","td","1",{"children":"2027–2028: closed"}],["$","td","2",{"children":"Retain submission confirmation and follow the nominator; a nomination task does not reopen the central form."}]],["$","td",null,{"children":["$","$L4",null,{"href":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-masters-scholarships/","target":"_blank","rel":"noreferrer","children":["Official source"," ↗"]}]}]]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"KAUST graduate admission"}],["$","td","1",{"children":"Fall 2027 Round 2: deadline 3 January 2027; published dates may be tentative"}],["$","td","2",{"children":"Check degree, research fit and current admissions timeline; Spring 2027 had a different deadline."}]],["$","td",null,{"children":["$","$L4",null,{"href":"https://admissions.kaust.edu.sa/how-to-apply/admission-timelines","target":"_blank","rel":"noreferrer","children":["Official source"," ↗"]}]}]]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Erasmus Mundus Joint Masters"}],["$","td","1",{"children":"Each consortium publishes its own call"}],["$","td","2",{"children":"Choose the exact course; check admission and scholarship availability separately."}]],["$","td",null,{"children":["$","$L4",null,{"href":"https://erasmus-plus.ec.europa.eu/opportunities/individuals/students/erasmus-mundus-joint-masters","target":"_blank","rel":"noreferrer","children":["Official source"," ↗"]}]}]]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"HEC-supported foreign awards"}],["$","td","1",{"children":"Programme- and cycle-specific"}],["$","td","2",{"children":"Read HEC’s named notice and the host application process; HEC does not handle every award."}]],["$","td",null,{"children":["$","$L4",null,{"href":"https://www.hec.gov.pk/english/scholarshipsgrants/lao/pages/default.aspx","target":"_blank","rel":"noreferrer","children":["Official source"," ↗"]}]}]]}]]}]]}]}],"$undefined"]
1d:["$","section","1-Choose an undergraduate, master’s, MBA or research route",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Choose an undergraduate, master’s, MBA or research route"}],[["$","p","For undergraduate study, check school qualifications, eligible entry year and whether the award needs school nomination. Use the bachelor’s funding guide before borrowing a postgraduate application checklist.",{"children":"For undergraduate study, check school qualifications, eligible entry year and whether the award needs school nomination. Use the bachelor’s funding guide before borrowing a postgraduate application checklist."}],["$","p","For a master’s or MBA, check the exact course against the award’s eligible degrees and funding exclusions. A scholarship for master’s study does not establish that every MBA or business-school fee is covered. Record admission fees and any uncovered tuition before applying.",{"children":"For a master’s or MBA, check the exact course against the award’s eligible degrees and funding exclusions. A scholarship for master’s study does not establish that every MBA or business-school fee is covered. Record admission fees and any uncovered tuition before applying."}],["$","p","For PhD funding, identify the research area, supervisor or advertised project and whether admission includes a funding decision. A research placement or fellowship is not automatically a degree scholarship.",{"children":"For PhD funding, identify the research area, supervisor or advertised project and whether admission includes a funding decision. A research placement or fellowship is not automatically a degree scholarship."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Choose an undergraduate, master’s, MBA or research route","children":[["$","$L4","/scholarships/bachelors/",{"href":"/scholarships/bachelors/","children":["Bachelor’s funding routes",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/masters/",{"href":"/scholarships/masters/","children":["Master’s funding routes",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/find-phd-supervisor/",{"href":"/guides/find-phd-supervisor/","children":["Find a PhD supervisor",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1e:["$","section","2-Make a submission map before writing",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Make a submission map before writing"}],[["$","p","Create one row per programme: degree, eligible nationality, application owner, separate university form, reference process, deadline and receipt. HEC, an embassy, a consortium and a university are different submission owners.",{"children":"Create one row per programme: degree, eligible nationality, application owner, separate university form, reference process, deadline and receipt. HEC, an embassy, a consortium and a university are different submission owners."}],["$","p","Illustrative plan: an applicant with two shortlisted courses records each course’s language evidence, funding form and reference deadline. An item stays “pending” until the required portal confirms submission; a saved draft or a named referee is not a received application or reference.",{"children":"Illustrative plan: an applicant with two shortlisted courses records each course’s language evidence, funding form and reference deadline. An item stays “pending” until the required portal confirms submission; a saved draft or a named referee is not a received application or reference."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L28",null,{"id":"guides/scholarships-for-pakistani-students:section-3","title":"Check your progress","items":["Current call and eligible course saved.","Admission, funding and nomination responsibilities separated.","Required documents and accepted language evidence matched to the exact route.","Final submission and reference receipts retained."]}],"$undefined","$undefined"]}]
1f:["$","section","3-Documents Pakistani students should organise early",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Documents Pakistani students should organise early"}],[["$","p","Use the name and date of birth shown on your passport consistently. Keep clear degree and transcript scans, an official grading-scale explanation, employment evidence where required, referee contact details and certified translations for any document not accepted in its original language.",{"children":"Use the name and date of birth shown on your passport consistently. Keep clear degree and transcript scans, an official grading-scale explanation, employment evidence where required, referee contact details and certified translations for any document not accepted in its original language."}],["$","p","Attestation, equivalence, nomination and testing rules are programme-specific. HEC, IBCC, a university, an embassy or another authority may be involved depending on the qualification and route, but no single checklist applies to every scholarship. Follow the current official call and each portal's document instructions.",{"children":"Attestation, equivalence, nomination and testing rules are programme-specific. HEC, IBCC, a university, an embassy or another authority may be involved depending on the qualification and route, but no single checklist applies to every scholarship. Follow the current official call and each portal's document instructions."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Valid passport or accepted identity document",{"children":"Valid passport or accepted identity document"}],["$","li","Degrees, transcripts and result evidence",{"children":"Degrees, transcripts and result evidence"}],["$","li","Institutional grading scale or CGPA explanation",{"children":"Institutional grading scale or CGPA explanation"}],["$","li","Employment letters with dates and duties",{"children":"Employment letters with dates and duties"}],["$","li","Language evidence accepted by the chosen course",{"children":"Language evidence accepted by the chosen course"}],["$","li","References submitted through the required channel",{"children":"References submitted through the required channel"}],["$","li","Research proposal for relevant doctoral routes",{"children":"Research proposal for relevant doctoral routes"}]]}],"$undefined","$undefined","$undefined"]}]
20:["$","section","4-English-language requirements are separate decisions",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"English-language requirements are separate decisions"}],[["$","p","A scholarship may not impose one universal IELTS score while the university still requires language evidence. Check the scholarship, selected course and visa process separately. Possible alternatives such as TOEFL, PTE, a Medium of Instruction letter or an institutional assessment are accepted only when the responsible institution says so for your intake.",{"children":"A scholarship may not impose one universal IELTS score while the university still requires language evidence. Check the scholarship, selected course and visa process separately. Possible alternatives such as TOEFL, PTE, a Medium of Instruction letter or an institutional assessment are accepted only when the responsible institution says so for your intake."}],["$","p","Do not rely on a headline promising a scholarship without IELTS. Obtain written confirmation and consider whether one recognised test would keep more strong-fit programmes open across your full shortlist.",{"children":"Do not rely on a headline promising a scholarship without IELTS. Obtain written confirmation and consider whether one recognised test would keep more strong-fit programmes open across your full shortlist."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","5-Important CERN eligibility warning for Pakistani nationals",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Important CERN eligibility warning for Pakistani nationals"}],[["$","p","CERN's current Short-Term Internship and Origin Programme pages state that candidates of several nationalities, including Pakistani nationals, cannot currently be considered because the applicable nationality ceiling has been reached. This is a current programme condition, not a judgement about an applicant's qualifications.",{"children":"CERN's current Short-Term Internship and Origin Programme pages state that candidates of several nationalities, including Pakistani nationals, cannot currently be considered because the applicable nationality ceiling has been reached. This is a current programme condition, not a judgement about an applicant's qualifications."}],["$","p","Rules can change, so reopen the official CERN page before a future application. Do not pay an intermediary who claims to bypass a nationality or membership condition, and do not present CERN as currently available to Pakistani applicants when the programme page says otherwise.",{"children":"Rules can change, so reopen the official CERN page before a future application. Do not pay an intermediary who claims to bypass a nationality or membership condition, and do not present CERN as currently available to Pakistani applicants when the programme page says otherwise."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","6-How to write a Pakistan-to-programme fit argument",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"How to write a Pakistan-to-programme fit argument"}],[["$","p","Avoid a generic promise to help Pakistan. Define a problem you understand through study, work or service, show what you have already done, name the skill or network gap the programme addresses and describe a realistic next step after the award.",{"children":"Avoid a generic promise to help Pakistan. Define a problem you understand through study, work or service, show what you have already done, name the skill or network gap the programme addresses and describe a realistic next step after the award."}],["$","p","A credible plan may focus on a sector, institution, research question, community or professional practice. Use evidence at the scale you can support. Scholarship selectors can distinguish a thoughtful sequence from an oversized impact claim written only for the application.",{"children":"A credible plan may focus on a sector, institution, research question, community or professional practice. Use evidence at the scale you can support. Scholarship selectors can distinguish a thoughtful sequence from an oversized impact claim written only for the application."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","7-Avoid agents, copied essays and false guarantees",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Avoid agents, copied essays and false guarantees"}],[["$","p","Major scholarship programmes publish their official routes. Nobody can guarantee selection, and an applicant remains responsible for truthful documents and original responses. Verify every fee on the programme or university domain, never send money to a personal account and do not give an agent access to your email or one-time codes.",{"children":"Major scholarship programmes publish their official routes. Nobody can guarantee selection, and an applicant remains responsible for truthful documents and original responses. Verify every fee on the programme or university domain, never send money to a personal account and do not give an agent access to your email or one-time codes."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","8-Choose the correct programme and country route",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Choose the correct programme and country route"}],[["$","p","Nationality is one eligibility condition, not a complete decision. FLEX Global directs Pakistani applicants to the country office, while degree scholarships and research placements use different academic requirements.",{"children":"Nationality is one eligibility condition, not a complete decision. FLEX Global directs Pakistani applicants to the country office, while degree scholarships and research placements use different academic requirements."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Choose the correct programme and country route","children":[["$","$L4","/guides/flex-global-exchange-program/",{"href":"/guides/flex-global-exchange-program/","children":["FLEX Global: choose the right country application route",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/turkiye-burslari/",{"href":"/scholarships/turkiye-burslari/","children":["Türkiye Scholarships: eligibility and a stronger application",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/internships/kaust-vsrp/",{"href":"/internships/kaust-vsrp/","children":["KAUST VSRP internship: eligibility, projects and application",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
