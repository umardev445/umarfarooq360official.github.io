2b:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Which fully funded scholarships are open for Pakistani students in late September 2026?",{"children":[["$","summary",null,{"children":["Which fully funded scholarships are open for Pakistani students in late September 2026?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Official pages currently show Chevening and eligible Commonwealth 2027–2028 routes as open. KAUST's Fall 2027 round is open until 3 January 2027. Eligibility, university admission and nomination rules still need individual verification."}]]}],["$","details","Can Pakistani students apply for Chevening 2027–2028?",{"children":[["$","summary",null,{"children":["Can Pakistani students apply for Chevening 2027–2028?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Pakistani applicants can use the Chevening route when they meet the current eligibility and course requirements. Applications close 6 October 2026 at 11:00 UTC according to the official timeline."}]]}],["$","details","Is Pakistan eligible for Commonwealth Master's Scholarships?",{"children":[["$","summary",null,{"children":["Is Pakistan eligible for Commonwealth Master's Scholarships?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Pakistan is listed among eligible countries on the current official Master's page. Applicants must also meet all criteria and use an approved nominator route; the central deadline is not the only process step."}]]}],["$","details","Can Pakistani nationals apply for CERN internships now?",{"children":[["$","summary",null,{"children":["Can Pakistani nationals apply for CERN internships now?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"CERN's current Short-Term Internship and Origin pages state that Pakistani nationals cannot currently be considered because a nationality ceiling has been reached. Recheck the official page for future changes."}]]}],["$","details","Can I get a scholarship abroad without IELTS from Pakistan?",{"children":[["$","summary",null,{"children":["Can I get a scholarship abroad without IELTS from Pakistan?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Sometimes, if the scholarship and chosen institution accept another test, Medium of Instruction evidence or a waiver. Admission, scholarship and visa rules must be checked separately in writing."}]]}],["$","details","Does HEC nominate applicants for every scholarship?",{"children":[["$","summary",null,{"children":["Does HEC nominate applicants for every scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Some routes involve HEC or another national body, while others use an embassy, university, consortium or direct programme portal. Follow the exact current process for each award."}]]}]]}]]}]
