26:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Are Chevening and Commonwealth applications currently open for Pakistan?",{"children":[["$","summary",null,{"children":["Are Chevening and Commonwealth applications currently open for Pakistan?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"At the 25 October 2026 check, Chevening Pakistan and Commonwealth Master’s 2027–2028 applications are closed. Follow the current official page for amendments or a future call; later selection tasks do not reopen the scholarship form."}]]}],["$","details","Which scholarship route should an undergraduate applicant use?",{"children":[["$","summary",null,{"children":["Which scholarship route should an undergraduate applicant use?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Start with awards that explicitly fund first degrees and check entry-year and nomination conditions. Master’s and PhD scholarship rules cannot be applied to an undergraduate application."}]]}],["$","details","Can a master’s scholarship pay for an MBA?",{"children":[["$","summary",null,{"children":["Can a master’s scholarship pay for an MBA?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Only when that award and institution permit the exact MBA and cover the relevant fees. Check eligible-course rules and exclusions instead of treating all master’s degrees as interchangeable."}]]}],["$","details","Can I get a scholarship abroad without IELTS from Pakistan?",{"children":[["$","summary",null,{"children":["Can I get a scholarship abroad without IELTS from Pakistan?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Sometimes, if the scholarship and chosen institution accept another test, Medium of Instruction evidence or a waiver. Admission, scholarship and visa rules must be checked separately in writing."}]]}],["$","details","Does HEC nominate applicants for every scholarship?",{"children":[["$","summary",null,{"children":["Does HEC nominate applicants for every scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Some routes involve HEC or another national body, while others use an embassy, university, consortium or direct programme portal. Follow the exact current process for each award."}]]}]]}]]}]
