1a:["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Decide whether the placement is usable before applying"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Check",{"scope":"col","children":"Check"}],["$","th","Evidence to find",{"scope":"col","children":"Evidence to find"}],["$","th","Do not assume",{"scope":"col","children":"Do not assume"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Eligibility"}],["$","td","1",{"children":"Degree/year, skills and availability"}],["$","td","2",{"children":"Every student can apply"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Funding"}],["$","td","1",{"children":"Salary or stipend, travel and accommodation terms"}],["$","td","2",{"children":"Paid means all costs are covered"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Work conditions"}],["$","td","1",{"children":"Location, hours, supervision and duties"}],["$","td","2",{"children":"Remote means no location restrictions"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Authorisation"}],["$","td","1",{"children":"Employer and relevant official immigration instructions"}],["$","td","2",{"children":"An offer automatically grants permission to work"}]],"$undefined"]}]]}]]}]
1b:["$","section","1-Rewrite a CV bullet around work and results",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Rewrite a CV bullet around work and results"}],[["$","p","A useful bullet states the task, your action and the output. Add a figure when it is measured and helps explain scale. A classroom exercise can demonstrate preparation without being described as employment.",{"children":"A useful bullet states the task, your action and the output. Add a figure when it is measured and helps explain scale. A classroom exercise can demonstrate preparation without being described as employment."}],["$","p","Keep the project title and context accurate. Explain your part of a team effort, distinguish a prototype from a deployed product and avoid claims about business impact you did not measure.",{"children":"Keep the project title and context accurate. Explain your part of a team effort, distinguish a prototype from a deployed product and avoid claims about business impact you did not measure."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"Before and after — fictional project"}],[["$","p","0",{"children":"Before: Worked on a university data project and learned teamwork."}],["$","p","1",{"children":"After: Built a validation sheet for a course dataset, documented inconsistent entries and summarised the limits of the final comparison in the team report."}]],["$","p",null,{"className":"sample-card__note","children":"The revised bullet shows work and evidence without inventing revenue, employment or a measured percentage."}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1c:["$","section","2-Write a short cover letter with one clear example",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Write a short cover letter with one clear example"}],[["$","p","Open with the exact role and your strongest reason for fit. Use one or two examples to prove relevant preparation. Explain why the team or work interests you using details from the real vacancy. End with the required availability or next step rather than repeating your entire CV.",{"children":"Open with the exact role and your strongest reason for fit. Use one or two examples to prove relevant preparation. Explain why the team or work interests you using details from the real vacancy. End with the required availability or next step rather than repeating your entire CV."}],["$","p","The fictional example below demonstrates the sequence. A real application needs the correct employer, role, dates and evidence.",{"children":"The fictional example below demonstrates the sequence. A real application needs the correct employer, role, dates and evidence."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"Fictional cover-letter example"}],[["$","p","0",{"children":"Dear Recruitment Team, I am applying for the research internship because its focus on organising and communicating evidence matches the work I have practised in my final-year project."}],["$","p","1",{"children":"In that project, I created validation rules for our observations, recorded errors and revised the collection sheet after feedback. I also wrote a short explanation of the findings and their limitations. This experience would help me contribute to careful data preparation while learning your team's methods."}],["$","p","2",{"children":"I am interested in the specific responsibilities published in your vacancy and would confirm my availability and location requirements in the application form. Thank you for considering my application."}]],["$","p",null,{"className":"sample-card__note","children":"Not an application to a real vacancy. Adapt with your own evidence and the employer's instructions."}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","3-Verify the role before investing in the application",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Verify the role before investing in the application"}],[["$","p","Open the vacancy on the employer's official careers domain. Record its reference, team, location, dates, responsibilities, essential requirements and application route. A copied listing can help you discover a role, but it is not the final instruction.",{"children":"Open the vacancy on the employer's official careers domain. Record its reference, team, location, dates, responsibilities, essential requirements and application route. A copied listing can help you discover a role, but it is not the final instruction."}],["$","p","Check student or recent-graduate status, permitted countries, working hours, pay and immigration responsibility. Remote describes an arrangement, not worldwide eligibility. If a condition is unclear, ask recruitment a precise question before presenting yourself as eligible.",{"children":"Check student or recent-graduate status, permitted countries, working hours, pay and immigration responsibility. Remote describes an arrangement, not worldwide eligibility. If a condition is unclear, ask recruitment a precise question before presenting yourself as eligible."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L26",null,{"id":"guides/internship-application:section-4","title":"Check your progress","items":["Official vacancy found","Essential requirements checked","Location and work arrangement confirmed","Pay and start date understood","Application channel verified"]}],"$undefined","$undefined"]}]
1e:["$","section","4-Separate essential and preferred requirements",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Separate essential and preferred requirements"}],[["$","p","Read the vacancy as a selection checklist. Mandatory conditions decide whether the role is possible. Preferred skills tell you where stronger evidence may help. Do not spend the entire cover letter proving an optional skill while ignoring an essential requirement.",{"children":"Read the vacancy as a selection checklist. Mandatory conditions decide whether the role is possible. Preferred skills tell you where stronger evidence may help. Do not spend the entire cover letter proving an optional skill while ignoring an essential requirement."}],["$","p","If experience can come from coursework or volunteering, select the most relevant example. Do not claim a tool because you used a different tool with a similar name. You can explain a transferable method and accurately describe what you have learned.",{"children":"If experience can come from coursework or volunteering, select the most relevant example. Do not claim a tool because you used a different tool with a similar name. You can explain a transferable method and accurately describe what you have learned."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Fictional research-internship vacancy: map the requirement","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Fictional research-internship vacancy: map the requirement"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Requirement",{"scope":"col","children":"Requirement"}],["$","th","Student evidence",{"scope":"col","children":"Student evidence"}],["$","th","Where to show it",{"scope":"col","children":"Where to show it"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Clean and organise data"}],["$","td","1",{"children":"Course project with documented validation rules"}],["$","td","2",{"children":"CV project bullet"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Explain findings clearly"}],["$","td","1",{"children":"Short report with a limitations section"}],["$","td","2",{"children":"Cover letter example"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Work with a team"}],["$","td","1",{"children":"Shared project with a defined contribution"}],["$","td","2",{"children":"Interview evidence"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Available during the placement"}],["$","td","1",{"children":"Confirmed study schedule"}],["$","td","2",{"children":"Availability field"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","5-Check the placement's practical value",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Check the placement's practical value"}],[["$","p","Compare the work, supervision, learning objectives, hours and financial conditions. A recognisable organisation can still have a role that does not match your learning need or permitted work location. A stipend may not cover the full cost of a placement abroad.",{"children":"Compare the work, supervision, learning objectives, hours and financial conditions. A recognisable organisation can still have a role that does not match your learning need or permitted work location. A stipend may not cover the full cost of a placement abroad."}],["$","p","Ask what you would produce, who would review it and how feedback is organised. For remote work, clarify equipment, internet, security and time-zone overlap. For an on-site role, confirm travel and immigration support before accepting.",{"children":"Ask what you would produce, who would review it and how feedback is organised. For remote work, clarify equipment, internet, security and time-zone overlap. For an on-site role, confirm travel and immigration support before accepting."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Questions before accepting a placement","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Questions before accepting a placement"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Area",{"scope":"col","children":"Area"}],["$","th","Question",{"scope":"col","children":"Question"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Work"}],["$","td","1",{"children":"What outputs and responsibilities would I have?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Support"}],["$","td","1",{"children":"Who supervises and how often is feedback given?"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Time"}],["$","td","1",{"children":"What hours, dates and time-zone overlap are required?"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Money"}],["$","td","1",{"children":"Which costs remain after stipend and support?"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Location"}],["$","td","1",{"children":"Am I permitted to work from the stated country?"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","6-Prepare for tests and interviews",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Prepare for tests and interviews"}],[["$","p","Selection may involve a technical task, written exercise or interview. Practise the format described by the employer and follow its rules on external assistance. Explain your reasoning, not just the final answer.",{"children":"Selection may involve a technical task, written exercise or interview. Practise the format described by the employer and follow its rules on external assistance. Explain your reasoning, not just the final answer."}],["$","p","Prepare examples of teamwork, feedback, a mistake and initiative. Keep them consistent with the CV and cover letter. If you have no previous internship, say what your project or volunteer experience demonstrates and where you still need training.",{"children":"Prepare examples of teamwork, feedback, a mistake and initiative. Keep them consistent with the CV and cover letter. If you have no previous internship, say what your project or volunteer experience demonstrates and where you still need training."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","7-Submit accurately and track the result",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Submit accurately and track the result"}],[["$","p","Check filenames, document format, contact details and required fields. Keep a copy of the final application and the confirmation. Monitor the official portal and email rather than relying on a social-media message.",{"children":"Check filenames, document format, contact details and required fields. Keep a copy of the final application and the confirmation. Monitor the official portal and email rather than relying on a social-media message."}],["$","p","Never pay for guaranteed selection or impersonate a referee. If someone contacts you, verify the vacancy and sender through the employer's public channels before sharing sensitive onboarding information.",{"children":"Never pay for guaranteed selection or impersonate a referee. If someone contacts you, verify the vacancy and sender through the employer's public channels before sharing sensitive onboarding information."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Submit accurately and track the result","children":[["$","$L4","/internships/",{"href":"/internships/","children":["Find internship routes",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/internships/remote/",{"href":"/internships/remote/","children":["Assess a remote placement",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/scholarship-cv/",{"href":"/guides/scholarship-cv/","children":["Improve your student CV",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/scholarship-interview/",{"href":"/guides/scholarship-interview/","children":["Practise evidence-based interview answers",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
