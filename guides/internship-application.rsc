1c:["$","section","1-Verify the opportunity",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Verify the opportunity"}],[["$","p","Open the organisation's own careers page, confirm the vacancy number and check whether applications are accepted through an official portal. Be cautious with copied listings and payment requests.",{"children":"Open the organisation's own careers page, confirm the vacancy number and check whether applications are accepted through an official portal. Be cautious with copied listings and payment requests."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","2-Translate experience into relevant evidence",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Translate experience into relevant evidence"}],[["$","p","Course projects, volunteering, part-time work and student societies can prove research, communication, analysis and delivery. Describe outputs and results rather than listing duties.",{"children":"Course projects, volunteering, part-time work and student societies can prove research, communication, analysis and delivery. Describe outputs and results rather than listing duties."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","3-Tailor the application",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Tailor the application"}],[["$","p","Mirror the employer's priorities in a natural way. Select three to five requirements and show evidence for each across your CV and cover letter.",{"children":"Mirror the employer's priorities in a natural way. Select three to five requirements and show evidence for each across your CV and cover letter."}]],"$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Why this team",{"children":"Why this team"}],["$","li","Relevant skills",{"children":"Relevant skills"}],["$","li","One strong project",{"children":"One strong project"}],["$","li","Availability and location",{"children":"Availability and location"}],["$","li","Clear learning goal",{"children":"Clear learning goal"}]]}],"$undefined","$undefined"]}]
1f:["$","section","4-Prepare for practical assessment",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Prepare for practical assessment"}],[["$","p","Internship selection may include written exercises, technical tests, case studies or recorded interviews. Practise under timed conditions and explain your reasoning clearly.",{"children":"Internship selection may include written exercises, technical tests, case studies or recorded interviews. Practise under timed conditions and explain your reasoning clearly."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","5-Read the vacancy like an assessment rubric",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Read the vacancy like an assessment rubric"}],[["$","p","Separate essential and preferred requirements. Beside each essential criterion, add one short piece of evidence and the location where it appears in your CV, form or cover letter. Do not claim a tool you have never used.",{"children":"Separate essential and preferred requirements. Beside each essential criterion, add one short piece of evidence and the location where it appears in your CV, form or cover letter. Do not claim a tool you have never used."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","6-Write a focused cover letter",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Write a focused cover letter"}],[["$","p","Open with the role and your strongest reason for fit, use one or two paragraphs to prove relevant skills, then explain why this team and placement support a clear learning goal. Avoid repeating every CV bullet.",{"children":"Open with the role and your strongest reason for fit, use one or two paragraphs to prove relevant skills, then explain why this team and placement support a clear learning goal. Avoid repeating every CV bullet."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","7-Check international eligibility",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Check international eligibility"}],[["$","p","Confirm student or recent-graduate status, nationality restrictions, work location, visa support, insurance and whether remote work is restricted to particular countries. A global organisation can still run a locally limited vacancy.",{"children":"Confirm student or recent-graduate status, nationality restrictions, work location, visa support, insurance and whether remote work is restricted to particular countries. A global organisation can still run a locally limited vacancy."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","8-Use a simple evidence structure",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Use a simple evidence structure"}],[["$","p","Describe the situation or goal, the action you personally took, the tool or method used and the result. Add a number when it genuinely clarifies scale, speed, accuracy or reach.",{"children":"Describe the situation or goal, the action you personally took, the tool or method used and the result. Add a number when it genuinely clarifies scale, speed, accuracy or reach."}],["$","p","For an interview, prepare one example each for teamwork, problem solving, initiative, feedback and a mistake. The example can come from study or volunteering when it demonstrates the required behaviour.",{"children":"For an interview, prepare one example each for teamwork, problem solving, initiative, feedback and a mistake. The example can come from study or volunteering when it demonstrates the required behaviour."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
