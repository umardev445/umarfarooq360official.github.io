25:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can I apply for an internship without formal work experience?",{"children":[["$","summary",null,{"children":["Can I apply for an internship without formal work experience?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes, when the vacancy permits it. Use coursework, projects, volunteering and student responsibilities as evidence of relevant skills and dependable delivery."}]]}],["$","details","Should I pay an internship placement fee?",{"children":[["$","summary",null,{"children":["Should I pay an internship placement fee?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Treat payment requests cautiously. Verify the employer and role independently, understand exactly what is being sold and never pay for a guaranteed job or selection outcome."}]]}],["$","details","What if I have no previous internship?",{"children":[["$","summary",null,{"children":["What if I have no previous internship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Use relevant academic projects, volunteering, student societies, freelance work or part-time responsibilities. Explain the skill and result rather than apologising for limited experience."}]]}],["$","details","Should I send the same CV to every internship?",{"children":[["$","summary",null,{"children":["Should I send the same CV to every internship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Keep one evidence bank, but reorder and rewrite the final CV for the responsibilities and keywords of each real vacancy."}]]}]]}]]}]
