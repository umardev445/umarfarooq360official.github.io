26:["$","section","3-2026/27 tuition: cohort and faculty matter",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"2026/27 tuition: cohort and faculty matter"}],[["$","p","The reviewed international schedule lists USD 1,200 per semester for engineering/architecture and specified sciences, and USD 800 for several other undergraduate groups, for those starting from fall 2023/24. It treats older cohorts and special programme categories separately.",{"children":"The reviewed international schedule lists USD 1,200 per semester for engineering/architecture and specified sciences, and USD 800 for several other undergraduate groups, for those starting from fall 2023/24. It treats older cohorts and special programme categories separately."}],["$","p","The schedule also specifies how USD-listed fees are converted for payment in TRY and includes preparation-year notes. Keep the PDF with your budget; do not treat a current online currency conversion as the university’s final invoice.",{"children":"The schedule also specifies how USD-listed fees are converted for payment in TRY and includes preparation-year notes. Keep the PDF with your budget; do not treat a current online currency conversion as the university’s final invoice."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://iso.metu.edu.tr/en/system/files/2026-2027_tuition_fees_14092026.pdf",{"children":["",["$","a",null,{"href":"https://iso.metu.edu.tr/en/system/files/2026-2027_tuition_fees_14092026.pdf","target":"_blank","rel":"noreferrer","children":"METU international tuition schedule 2026/27"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for 2026/27 tuition: cohort and faculty matter","children":[["$","$L4","/guides/turkey-university-tuition-fees/",{"href":"/guides/turkey-university-tuition-fees/","children":["Tuition comparison and unit checks",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
27:["$","section","4-Prepare the academic evidence before the portal deadline",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Prepare the academic evidence before the portal deadline"}],[["$","p","Build a short evidence index: main accepted qualification, transcripts, identity/category evidence and programme-relevant supporting records. Use the official application steps for the exact required file types and current deadlines.",{"children":"Build a short evidence index: main accepted qualification, transcripts, identity/category evidence and programme-relevant supporting records. Use the official application steps for the exact required file types and current deadlines."}],["$","p","If you have multiple qualifications, show clearly which one meets the main requirement. Supporting achievements can add context but do not repair a missing required result. Ask the office about an ambiguous category before submitting, especially where citizenship or school location changes the applicable route.",{"children":"If you have multiple qualifications, show clearly which one meets the main requirement. Supporting achievements can add context but do not repair a missing required result. Ask the office about an ambiguous category before submitting, especially where citizenship or school location changes the applicable route."}]],["$","ol",null,{"className":"process-steps","aria-label":"Prepare the academic evidence before the portal deadline","children":[["$","li","Confirm that you qualify for international admission at Ankara.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Confirm that you qualify for international admission at Ankara."}]]}],["$","li","Choose programmes and match one accepted primary qualification.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Choose programmes and match one accepted primary qualification."}]]}],["$","li","Read the current document and result-validity requirements.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Read the current document and result-validity requirements."}]]}],["$","li","Submit the application and preserve its confirmation.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Submit the application and preserve its confirmation."}]]}],["$","li","If admitted, meet registration, language and payment conditions.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"If admitted, meet registration, language and payment conditions."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://iso.metu.edu.tr/en/5-step-application-undergraduate-programs-metu-international-student",{"children":["",["$","a",null,{"href":"https://iso.metu.edu.tr/en/5-step-application-undergraduate-programs-metu-international-student","target":"_blank","rel":"noreferrer","children":"METU official undergraduate application steps"}]]}]]]}],"$undefined"]}]
28:["$","section","5-Ankara housing and arrival are separate from admission",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Ankara housing and arrival are separate from admission"}],[["$","p","An academic offer is not a guaranteed dormitory room. Confirm the actual housing application, allocation date and fallback before travel. Ask the International Students Office how the residence-file handover works for your cohort.",{"children":"An academic offer is not a guaranteed dormitory room. Confirm the actual housing application, allocation date and fallback before travel. Ask the International Students Office how the residence-file handover works for your cohort."}],["$","p","Build the living budget from current campus and nearby-housing evidence, with the same room type and months. Avoid mixing METU Northern Cyprus dormitory quotes into an Ankara plan.",{"children":"Build the living budget from current campus and nearby-housing evidence, with the same room type and months. Avoid mixing METU Northern Cyprus dormitory quotes into an Ankara plan."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Ankara housing and arrival are separate from admission","children":[["$","$L4","/guides/cost-of-living-in-turkey-for-students/",{"href":"/guides/cost-of-living-in-turkey-for-students/","children":["Ankara living-cost evidence",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/student-accommodation-turkey/",{"href":"/guides/student-accommodation-turkey/","children":["Dormitory and rental decisions",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/turkey-student-residence-permit/",{"href":"/guides/turkey-student-residence-permit/","children":["Residence permit: university handover",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
29:["$","section","6-A METU shortlist checkpoint",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"A METU shortlist checkpoint"}],[["$","p","Write down unresolved conditions next to the programme, not in a separate note you may forget when an offer arrives.",{"children":"Write down unresolved conditions next to the programme, not in a separate note you may forget when an offer arrives."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2a",null,{"id":"guides/metu-international-admissions:section-7","title":"Check your progress","items":["My programme and campus are METU Ankara.","My main qualification meets the full current route, including subjects.","I understand that a minimum result does not guarantee admission.","I have checked current English-test acceptance and preparation.","My tuition row and housing plan match my actual entry category."]}],"$undefined","$undefined"]}]
