19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"METU Ankara requires an accepted academic qualification and evaluates applicants within programme quotas. English instruction does not make an English-test score compulsory at initial undergraduate application; registration and preparation rules are separate."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Open the qualification matrix linked by the International Students Office, then check the programme, result validity and current application dates."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","/countries/turkey/",{"href":"/countries/turkey/","children":["Explore the Turkey study hub",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Keep four METU decisions separate",{"href":"#section-1","children":"Keep four METU decisions separate"}],["$","a","Qualification examples from the linked minimum matrix",{"href":"#section-2","children":"Qualification examples from the linked minimum matrix"}],["$","a","English: an importan