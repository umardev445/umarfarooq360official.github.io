1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/metu-international-admissions/\",\"name\":\"METU international admissions: Ankara campus\",\"description\":\"Check METU Ankara international qualifications, SAT/ACT examples, English preparation rules and 2026/27 tuition without mixing in Northern Cyprus fees.\",\"url\":\"https://aspirecompass.org/guides/metu-international-admissions/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-29\",\"dateModified\":\"2026-10-29\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/application-writing-1280.webp\",\"caption\":\"Illustrative student writing application notes beside a laptop\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"METU international admissions: Ankara campus\",\"item\":\"https://aspirecompass.org/guides/metu-international-admissions/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"METU international admissions: Ankara campus\",\"description\":\"Check METU Ankara international qualifications, SAT/ACT examples, English preparation rules and 2026/27 tuition without mixing in Northern Cyprus fees.\",\"image\":\"https://aspirecompass.org/images/application-writing-1280.webp\",\"datePublished\":\"2026-10-29\",\"dateModified\":\"2026-10-29\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/metu-international-admissions/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Does METU accept IELTS?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Its reviewed undergraduate English page says IELTS tests taken on or after 24 December 2022 are not accepted. Check the current official equivalence table for recognised evidence.\"}},{\"@type\":\"Question\",\"name\":\"Is SAT 1,200 enough for METU admission?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The linked January 2024 matrix lists that total minimum, with additional Maths conditions for some faculties. It does not guarantee admission, and the current matrix and programme evaluation must still be checked.\"}},{\"@type\":\"Question\",\"name\":\"Does this guide use Northern Cyprus campus fees?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The focus is the Ankara international undergraduate route. Campus-specific admission, tuition and housing information should be kept separate.\"}}]}"}}]],"$L18",false,"$L19","$L1a"]}]
