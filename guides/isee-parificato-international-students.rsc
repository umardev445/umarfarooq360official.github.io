1b:["$","section","1-Padua and ER.GO are different processes",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Padua and ER.GO are different processes"}],[["$","p","Padua directs eligible international applicants to its affiliated CAF for equivalent ISEE, followed by the Uniweb concession request. ER.GO uses its own foreign-document submission route. Do not buy a generic certificate and assume both authorities will accept it.",{"children":"Padua directs eligible international applicants to its affiliated CAF for equivalent ISEE, followed by the Uniweb concession request. ER.GO uses its own foreign-document submission route. Do not buy a generic certificate and assume both authorities will accept it."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Confirm the exact service on the official website, not an agency's screenshot.",{"children":"Confirm the exact service on the official website, not an agency's screenshot."}],["$","li","Keep evidence of assessment and the separate benefit application.",{"children":"Keep evidence of assessment and the separate benefit application."}],["$","li","Ask whether originals are required later and where to retain them.",{"children":"Ask whether originals are required later and where to retain them."}]]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Padua and ER.GO are different processes","children":[["$","$L4","https://www.unipd.it/en/isee",{"href":"https://www.unipd.it/en/isee","children":["Padua equivalent ISEE and concessions",["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.er-go.it/international-students/what-you-need/",{"href":"https://www.er-go.it/international-students/what-you-need/","children":["ER.GO international-student documents",["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1c:["$","section","2-Build a document folder before translation",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Build a document folder before translation"}],[["$","p","Use this as an organising worksheet, not a universal list. The current call decides who must be included, the required reference year, who may issue each record and how signatures are authenticated.",{"children":"Use this as an organising worksheet, not a universal list. The current call decides who must be included, the required reference year, who may issue each record and how signatures are authenticated."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Foreign-household document worksheet","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Foreign-household document worksheet"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Category",{"scope":"col","children":"Category"}],["$","th","Record to confirm",{"scope":"col","children":"Record to confirm"}],["$","th","Common gap",{"scope":"col","children":"Common gap"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Family"}],["$","td","1",{"children":"Household composition and relationships"}],["$","td","2",{"children":"A dependent member is left out"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Income"}],["$","td","1",{"children":"Earnings/status for relevant members"}],["$","td","2",{"children":"No-income status has no accepted evidence"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Property"}],["$","td","1",{"children":"Ownership or accepted no-property evidence"}],["$","td","2",{"children":"Values or measurement units are missing"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Financial assets"}],["$","td","1",{"children":"Bank and other assets for the required date"}],["$","td","2",{"children":"A current balance is used for a historical date"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Authentication"}],["$","td","1",{"children":"Translation and legalisation/apostille route"}],["$","td","2",{"children":"A stamp is on the wrong document"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","3-Keep three dates separate",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Keep three dates separate"}],[["$","p","Write down the deadline for the online benefit application, the deadline for submitting financial evidence and any deadline for correcting a deficient file. A later document-upload date does not necessarily extend the original scholarship application.",{"children":"Write down the deadline for the online benefit application, the deadline for submitting financial evidence and any deadline for correcting a deficient file. A later document-upload date does not necessarily extend the original scholarship application."}],["$","p","As an ER.GO example, its official instructions ask for current-year issued documentation describing the previous year's income and year-end assets. Reopen the annual call before ordering records; do not reuse this example as a national rule.",{"children":"As an ER.GO example, its official instructions ask for current-year issued documentation describing the previous year's income and year-end assets. Reopen the annual call before ordering records; do not reuse this example as a national rule."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","4-A practical sequence for your family",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"A practical sequence for your family"}],[["$","p","First make an inventory of available records. Next send a concise question to the authorised office about any missing category. Only then obtain the required versions, arrange accepted translation/authentication, upload through the stated route and save the confirmation.",{"children":"First make an inventory of available records. Next send a concise question to the authorised office about any missing category. Only then obtain the required versions, arrange accepted translation/authentication, upload through the stated route and save the confirmation."}],["$","p","Use consistent passport names across the file. If records use an older spelling, explain it through the accepted evidence instead of changing an official scan. Keep a simple log showing issuer, issue date, reference year, translation status and upload receipt.",{"children":"Use consistent passport names across the file. If records use an older spelling, explain it through the accepted evidence instead of changing an official scan. Keep a simple log showing issuer, issue date, reference year, translation status and upload receipt."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","One folder per application year.",{"children":"One folder per application year."}],["$","li","One row per document, with the person it relates to.",{"children":"One row per document, with the person it relates to."}],["$","li","One unresolved-question list for the authority.",{"children":"One unresolved-question list for the authority."}],["$","li","No passwords or unnecessary bank documents sent to strangers.",{"children":"No passwords or unnecessary bank documents sent to strangers."}]]}],"$undefined","$undefined"]}]
1f:["$","section","5-Zero income and independence are not shortcuts",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Zero income and independence are not shortcuts"}],[["$","p","Zero earnings are different from zero assets. A family member can have no salary while holding savings or property. Declare the full position in the format the authority requires.",{"children":"Zero earnings are different from zero assets. A family member can have no salary while holding savings or property. Declare the full position in the format the authority requires."}],["$","p","Living away from your parents is not, by itself, proof of financial independence. Ask for the published independence test and keep evidence for every condition. Do not omit the parental household just because you currently rent a room elsewhere.",{"children":"Living away from your parents is not, by itself, proof of financial independence. Ask for the published independence test and keep evidence for every condition. Do not omit the parental household just because you currently rent a room elsewhere."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","6-After submission: follow the file, not just the ranking",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"After submission: follow the file, not just the ranking"}],[["$","p","Check the official portal and inbox for clarification requests. Save the submitted application and final assessment separately. If a document is rejected, ask what defect needs correcting and whether a correction period is still available.",{"children":"Check the official portal and inbox for clarification requests. Save the submitted application and final assessment separately. If a document is rejected, ask what defect needs correcting and whether a correction period is still available."}],["$","p","Build a budget that works while the decision is pending. An economic assessment can support an application; it does not promise a grant, an available room or an immediate payment.",{"children":"Build a budget that works while the decision is pending. An economic assessment can support an application; it does not promise a grant, an available room or an immediate payment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for After submission: follow the file, not just the ranking","children":[["$","$L4","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Estimate the funding gap",["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/university-of-padua-admissions-scholarships/",{"href":"/guides/university-of-padua-admissions-scholarships/","children":["Padua application guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/university-of-bologna-admissions-scholarships/",{"href":"/guides/university-of-bologna-admissions-scholarships/","children":["Bologna application guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
21:["$","section","7-Your working checklist",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Your working checklist"}],[],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L25",null,{"id":"guides/isee-parificato-international-students:section-8","title":"Check your progress","items":["Confirm the university’s accepted assessor and process.","Record household, income and asset reference years.","Collect records from the competent issuing authorities.","Check translation and authentication rules.","Keep assessment, award request and enrolment dates separate."]}],"$undefined"]}]
