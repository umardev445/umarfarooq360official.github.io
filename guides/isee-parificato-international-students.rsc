1:["$","main",null,{"id":"main-content","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/isee-parificato-international-students/\",\"name\":\"ISEE parificato for international students: documents and steps\",\"description\":\"Prepare ISEE parificato and foreign-income evidence for Italy. Compare Padua and ER.GO routes, organise household documents and avoid deadline mistakes.\",\"url\":\"https://aspirecompass.org/guides/isee-parificato-international-students/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-05\",\"dateModified\":\"2026-10-13\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/programme-research-editorial.webp\",\"caption\":\"Students working through programme information and application notes\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"ISEE parificato for international students: documents and steps\",\"item\":\"https://aspirecompass.org/guides/isee-parificato-international-students/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"ISEE parificato for international students: documents and steps\",\"description\":\"Prepare ISEE parificato and foreign-income evidence for Italy. Compare Padua and ER.GO routes, organise household documents and avoid deadline mistakes.\",\"image\":\"https://aspirecompass.org/images/programme-research-editorial.webp\",\"datePublished\":\"2026-10-05\",\"dateModified\":\"2026-10-13\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/isee-parificato-international-students/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is ISEE parificato a scholarship?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. It assesses the household's financial position. You still need to apply for the specific benefit and meet its other conditions.\"}},{\"@type\":\"Question\",\"name\":\"Can I use the same certificate at every university?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Do not assume so. The authorised assessor, document years and accepted submission routes can differ.\"}},{\"@type\":\"Question\",\"name\":\"Can I estimate my ISEE with a GPA or study-cost calculator?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. These calculators do not assess household income and assets under Italian financial-aid rules.\"}}]}"}}]],["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--guide inner-hero--visual","children":"$L15"}],"$L16","$L17"]}]
