16:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"ISEE parificato is an equivalent household assessment used by some institutions for students with foreign income or assets. It is not a scholarship, and not every institution uses the same certificate or submission route."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Open your university's current financial-aid instructions. Identify the authorised assessor, document reference year and application deadline before requesting certificates."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","/guides/italy-dsu-scholarships/",{"href":"/guides/italy-dsu-scholarships/","children":["Understand DSU scholarships",["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Which route applies to you?",{"href":"#section-1","children":"Which route applies to you?"}],["$","a","Padua and ER.GO are different processes",{"href":"#section-2","children":"Padua and ER.GO are different processes"}],["$","a","Build a document folder before translation",{"href":"#section-3","children":"Build a document folder before translation"}],["$","a","Keep three dates separate",{"href":"#section-4","children":"Keep three dates separate"}],["$","a","A practical sequence for your family",{"href":"#section-5","children":"A practical sequence for your family"