1c:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"A conditional offer requires you to meet stated conditions, commonly grades or results. An unconditional offer means the academic entry requirements have been met, but the offer may still list administrative or other checks to arrange."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Open the actual offer in your UCAS account, record each condition and remaining task, and use the reply deadline shown for your application."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Compare the two offer types",{"href":"#section-1","children":"Compare the two offer types"}],["$","a","Break a conditional offer into separate checks",{"href":"#section-2","children":"Break a conditional offer into separate checks"}],["$","a","An unconditional offer can still have tasks to complete",{"href":"#section-3","children":"An unconditional offer can still have tasks to complete"}],["$","a","Compare fit before making a firm decision",{"href":"#section-4","children":"Compare fit before making a firm decision"}],["$","a","If results or circumstances change",{"href":"#section-5","children":"If results or circumstances change"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Compare the two offer types",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Compare the two offer types"}],[["$","p","UCAS distinguishes an offer still dependent on conditions from one for which entry requirements have already been met. Read the complete wording in either case. Neither label tells you whether the course is your best academic, financial or personal fit.",{"children":"UCAS distinguishes an offer still dependent on conditions from one for which entry requirements have already been met. Read the complete wording in either case. Neither label tells you whether the course is your best academic, financial or personal fit."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Conditional and unconditional offers compared","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Conditional and unconditional offers compared"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Question",{"scope":"col","children":"Question"}],["$","th","Conditional",{"scope":"col","children":"Conditional"}],["$","th","Unconditional",{"scope":"col","children":"Unconditional"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Have the stated entry requirements been met?"}],["$","td","1",{"children":"Conditions still need to be met"}],["$","td","2",{"children":"Academic entry requirements have been met"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"What should I read?"}],["$","td","1",{"children":"Exact grades, subjects, points and other cond