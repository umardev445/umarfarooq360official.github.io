23:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Break a conditional offer into separate checks",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Break a conditional offer into separate checks"}],[["$","p","A condition can be a tariff total, named subject grades, an accepted qualification route or a combination. Put each requirement on its own line. This prevents a good overall result from hiding a missing subject condition.",{"children":"A condition can be a tariff total, named subject grades, an accepted qualification route or a combination. Put each requirement on its own line. This prevents a good overall result from hiding a missing subject condition."}],["$","p","An illustrative 112-point condition including B in Mathematics needs both the required total and the required Mathematics grade. If an EPQ is excluded, do not use its points in the course-counted total. The exact wording matters more than a generic equivalence table.",{"children":"An illustrative 112-point condition including B in Mathematics needs both the required total and the required Mathematics grade. If an EPQ is excluded, do not use its points in the course-counted total. The exact wording matters more than a generic equivalence table."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"BBC in three A levels gives 112 points, but the position of C matters when Mathematics must be B. Keep the subject-level record beside the total."}]]}],"$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Break a conditional offer into separate checks","children":[["$","$L5","/tools/ucas-points-calculator/",{"href":"/tools/ucas-points-calculator/","children":["Calculate qualification points",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/112-ucas-points-in-grades/",{"href":"/guides/112-ucas-points-in-grades/","children":["Read 112-point examples",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],["$","section","2-An unconditional offer can still have tasks to complete",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"An unconditional offer can still have tasks to complete"}],[["$","p","UCAS notes that an unconditional offer can still involve evidence or arrangements such as proof of results or course-related checks. Read the offer rather than assuming that every administrative step is finished.",{"children":"UCAS notes that an unconditional offer can still involve evidence or arrangements such as proof of results or course-related checks. Read the offer rather than assuming that every administrative step is finished."}],["$","p","Keep a task list with the requested item, who issues it, where it is submitted and the provider deadline. Ask the university if an instruction is ambiguous. Do not confuse a general website example with a condition that actually appears in your offer.",{"children":"Keep a task list with the requested item, who issues it, where it is submitted and the provider deadline. Ask the university if an instruction is ambiguous. Do not confuse a general website example with a condition that actually appears in your offer."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Compare fit before making a firm decision",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Compare fit before making a firm decision"}],["$L27","$L28"],"$undefined","$undefined","$undefined","$undefined","$undefined","$L29","$undefined","$undefined"]}],"$L2a"]}]
