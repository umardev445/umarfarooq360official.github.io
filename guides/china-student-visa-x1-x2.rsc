18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/expansion-20261022/china-visa-1280.webp","srcSet":"/images/expansion-20261022/china-visa-640.webp 640w, /images/expansion-20261022/china-visa-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Shanghai skyline illuminated at night","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Destination or study photograph; not a photograph of the named university or scholarship."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Chinese visa guidance distinguishes X1 study exceeding 180 days from X2 study of no more than 180 days. The competent mission sets the applicable document and submission instructions for your situation."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Confirm your course duration with the university, then read the current X-category checklist from the mission serving your place of residence."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","X1 and X2: start with the purpose and duration",{"href":"#section-1","children":"X1 and X2: start with the purpose and duration"}],["$","a","Collect the university’s visa-support documents",{"href":"#section-2","children":"Collect the university’s visa-support documents"}],["$","a","Build the checklist for your country of residence",{"href":"#section-3","children":"Build the checklist for your country of residence"}],["$","a","Physical examination evidence is a separate document task",{"href":"#section-4","children":"Physical examination evidence is a separate document task"}],["$","a","Before travel and after arrival",{"href":"#section-5","children":"Before travel and after arrival"}],["$","a","Plan for uncertainty without treating an estimate as a promise",{"href":"#section-6","children":"Plan for uncertainty without treating an estimate as a promise"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-X1 and X2: start with the purpose and duration",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"X1 and X2: start with the purpose and duration"}],[["$","p","Use the actual study arrangement shown by your admission documents. Do not choose a tourist or business category because its process appears easier. If your programme duration or status changes, ask the responsible authority how that affects your application.",{"children":"Use the actual study arrangement shown by your admission documents. Do not choose a tourist or business category because its process appears easier. If your programme duration or status changes, ask the responsible authority how that affects your application."}],["$","p","The Chinese Embassy in Pakistan’s published guidance gives the X1/X2 duration distinction. It is an example of mission-specific instructions; applicants residing elsewhere must use their own competent mission and current local process.",{"children":"The Chinese Embassy in Pakistan’s published guidance gives the X1/X2 duration distinction. It is an example of mission-specific instructions; applicants residing elsewhere must use their own competent mission and current local process."}]],"$undefined","$L1a","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1b","$L1c","$L1d","$L1e","$L1f"]}],false,"$L20","$L21"]}],"$L22"]}]
