1a:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Study-visa planning distinction","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Study-visa planning distinction"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Category",{"scope":"col","children":"Category"}],["$","th","Study duration in the cited guidance",{"scope":"col","children":"Study duration in the cited guidance"}],["$","th","Next verification",{"scope":"col","children":"Next verification"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"X1"}],["$","td","1",{"children":"More than 180 days"}],["$","td","2",{"children":"Required study documents and post-arrival residence formalities"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"X2"}],["$","td","1",{"children":"No more than 180 days"}],["$","td","2",{"children":"Admission evidence and permitted stay conditions"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Other purpose"}],["$","td","1",{"children":"Not established by a study offer alone"}],["$","td","2",{"children":"Use the category matching the genuine purpose"}]],"$undefined"]}]]}]]}]}],"$undefined"]
1b:["$","section","1-Collect the university’s visa-support documents",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Collect the university’s visa-support documents"}],[["$","p","Ask the university which admission and study-confirmation documents it will issue for your programme and how you receive them. Follow the mission’s checklist for any JW201/JW202 or other required electronic or original evidence; do not assume every short course uses the same document.",{"children":"Ask the university which admission and study-confirmation documents it will issue for your programme and how you receive them. Follow the mission’s checklist for any JW201/JW202 or other required electronic or original evidence; do not assume every short course uses the same document."}],["$","p","Check your name, passport details, course and dates as soon as documents arrive. Ask the issuing university to correct an error before you submit a visa application. A personal edit to an official admission document is not an acceptable correction.",{"children":"Check your name, passport details, course and dates as soon as documents arrive. Ask the issuing university to correct an error before you submit a visa application. A personal edit to an official admission document is not an acceptable correction."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1c:["$","section","2-Build the checklist for your country of residence",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Build the checklist for your country of residence"}],[["$","p","A mission may require common documents such as the application record, passport and photograph plus evidence specific to study. Residence or nationality circumstances can create additional requirements. Use the current official instructions rather than a universal checklist copied from a different country.",{"children":"A mission may require common documents such as the application record, passport and photograph plus evidence specific to study. Residence or nationality circumstances can create additional requirements. Use the current official instructions rather than a universal checklist copied from a different country."}],["$","p","For applicants in Pakistan, the linked embassy guidance is the starting point. Check for later notices, the submission channel, appointments, fees and any identity or biometric instructions. Do not assume the same service arrangements apply to another mission.",{"children":"For applicants in Pakistan, the linked embassy guidance is the starting point. Check for later notices, the submission channel, appointments, fees and any identity or biometric instructions. Do not assume the same service arrangements apply to another mission."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L23",null,{"id":"guides/china-student-visa-x1-x2:section-3","title":"Check your progress","items":["Correct mission and visa purpose identified","Passport and admission details match","Study-support document requirements confirmed","Current submission and appointment instructions checked","Fees and processing information read from the responsible service"]}],"$undefined","$undefined"]}]
1d:["$","section","3-Physical examination evidence is a separate document task",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Physical examination evidence is a separate document task"}],[["$","p","A scholarship, university or residence process may request the Foreigner Physical Examination Form. Check which authority is asking for it, its required timing and whether supporting reports or originals must be retained. The form is not by itself a visa grant.",{"children":"A scholarship, university or residence process may request the Foreigner Physical Examination Form. Check which authority is asking for it, its required timing and whether supporting reports or originals must be retained. The form is not by itself a visa grant."}],["$","p","Use the official document and ask a qualified healthcare provider about completing the clinical sections. This website explains the administrative file; it does not assess health or decide whether an examination is medically appropriate.",{"children":"Use the official document and ask a qualified healthcare provider about completing the clinical sections. This website explains the administrative file; it does not assess health or decide whether an examination is medically appropriate."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Physical examination evidence is a separate document task","children":[["$","$L4","/guides/china-foreigner-physical-examination-form/",{"href":"/guides/china-foreigner-physical-examination-form/","children":["Official physical-examination form and document checklist",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1e:["$","section","4-Before travel and after arrival",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Before travel and after arrival"}],[["$","p","Read the issued visa carefully for entry validity, entries and stay conditions. Resolve a discrepancy with the responsible authority before departure. Carry the original documents the university or authorities instruct you to bring, rather than relying only on cloud copies.",{"children":"Read the issued visa carefully for entry validity, entries and stay conditions. Resolve a discrepancy with the responsible authority before departure. Carry the original documents the university or authorities instruct you to bring, rather than relying only on cloud copies."}],["$","p","For a long-term study route, coordinate the post-arrival registration and residence-permit process with your university’s international office. Follow the deadline printed or specified for your status. Visa issuance does not remove later local registration duties.",{"children":"For a long-term study route, coordinate the post-arrival registration and residence-permit process with your university’s international office. Follow the deadline printed or specified for your status. Visa issuance does not remove later local registration duties."}]],["$","ol",null,{"className":"process-steps","aria-label":"Before travel and after arrival","children":[["$","li","Check the issued visa against the admission plan",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Check the issued visa against the admission plan"}]]}],["$","li","Prepare required originals and secure copies",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Prepare required originals and secure copies"}]]}],["$","li","Confirm arrival instructions with the university",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Confirm arrival instructions with the university"}]]}],["$","li","Complete accommodation and university registration as instructed",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Complete accommodation and university registration as instructed"}]]}],["$","li","Follow the applicable residence-permit or stay formalities",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Follow the applicable residence-permit or stay formalities"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","5-Plan for uncertainty without treating an estimate as a promise",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Plan for uncertainty without treating an estimate as a promise"}],[["$","p","Processing times, additional-document requests and appointments can affect travel. Avoid a non-refundable booking based only on an estimated decision date. If a delay threatens your enrolment deadline, contact the university about the permitted next steps.",{"children":"Processing times, additional-document requests and appointments can affect travel. Avoid a non-refundable booking based only on an estimated decision date. If a delay threatens your enrolment deadline, contact the university about the permitted next steps."}],["$","p","Keep a document tracker with who must act next: you, the university, the visa service or the mission. Do not pay an agent who promises a guaranteed visa or offers to manufacture admission or financial evidence.",{"children":"Keep a document tracker with who must act next: you, the university, the visa service or the mission. Do not pay an agent who promises a guaranteed visa or offers to manufacture admission or financial evidence."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
