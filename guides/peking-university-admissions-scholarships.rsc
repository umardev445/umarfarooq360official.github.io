19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Peking University admission and funding are connected but separate. CGS, PKU Scholarship and other notices can serve different applicant groups. A scholarship notice for current students is not automatically an incoming-student opportunity."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Select your exact programme and degree, then confirm that the scholarship notice covers prospective students in your intended intake."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","#official-sources",{"href":"#official-sources","children":["Official sources",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/team/hafiz-umar-farooq/",{"href":"/team/hafiz-umar-farooq/","children":["Editorial contact",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Identify the programme and the actual cycle",{"href":"#section-1","children":"Identify the programme and the actual cycle"}],["$","a","Degree and programme requirements come first",{"href":"#section-2","children":"Degree and programme requirements come first"}],["$","a","Separate CGS, PKU Scholarship and other funding",{"href":"#section-3","children":"Separate CGS, PKU Scholarship and other funding"}],["$","a","Documents: build the file for your programme and intake",{"href":"#section-4","children":"Documents: build the file for your programme and intake"}],["$","a","Application sequence: read the rule for the specific scholarship",{"href":"#section-5","children":"Application sequence: read the rule for the specific scholarship"}],["$","a","Fees and living costs: compare coverage with actual payments",{"href":"#section-6","children":"Fees and living costs: compare coverage with actual payments"}],["$","a","Annual review and post-offer responsibilities",{"href":"#section-7","children":"Annual review and post-offer responsibilities"}],["$","a","A useful final decision: fit, funding and readiness",{"href":"#section-8","children":"A useful final decision: fit, funding and readiness"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Identify the programme and the actual cycle",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Identify the programme and the actual cycle"}],[["$","p","The official general graduate prospectus reviewed here is labelled 2026. Its application window is historical and must not be presented as an open 2027 round. English-taught programmes can have their own instructions; open the relevant programme notice rather than applying the general calendar indiscriminately.",{"children":"The official general graduate prospectus reviewed here is labelled 2026. Its application window is historical and must not be presented as an open 2027 round. English-taught programmes can have their own instructions; open the relevant programme notice rather than applying the general calendar indiscriminately."}],"$L1b"],"$undefined","$L1c","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23"]}],false,"$L24","$L25"]}],"$L26"]}]
