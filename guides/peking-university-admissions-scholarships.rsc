25:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is every PKU award for new international students?",{"children":[["$","summary",null,{"children":["Is every PKU award for new international students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The scholarship directory includes notices with different audiences, including current students. Read the title, applicant definition and cycle before using a notice for an incoming application."}]]}],["$","details","Is Yenching Academy the same as the general PKU Scholarship?",{"children":[["$","summary",null,{"children":["Is Yenching Academy the same as the general PKU Scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It is a specific programme with its own admissions and scholarship rules. Its funding must not be presented as the universal award for all PKU degrees."}]]}],["$","details","Can I use the 2026 passport requirement for 2027?",{"children":[["$","summary",null,{"children":["Can I use the 2026 passport requirement for 2027?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not as a verified rule. Read the new programme notice and check its actual validity requirement. An old calendar date should not be carried into a future application checklist."}]]}],["$","details","Are university scholarships unconditional for the full degree?",{"children":[["$","summary",null,{"children":["Are university scholarships unconditional for the full degree?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Read the individual award conditions. The official PKU Scholarship description includes annual review for renewal."}]]}]]}]]}]
