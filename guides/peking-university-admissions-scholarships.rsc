1d:["$","section","1-Degree and programme requirements come first",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Degree and programme requirements come first"}],[["$","p","A master’s, doctoral and undergraduate route should not share one undifferentiated checklist. Find the official programme catalogue, teaching language and responsible admissions office. Some professional or specialised degrees publish additional rules. Medical and special academy programmes may also use separate guidance.",{"children":"A master’s, doctoral and undergraduate route should not share one undifferentiated checklist. Find the official programme catalogue, teaching language and responsible admissions office. Some professional or specialised degrees publish additional rules. Medical and special academy programmes may also use separate guidance."}],["$","p","For a research application, explain the academic question you want to investigate and why your prior work prepares you for it. For a taught programme, connect relevant coursework and skills to the curriculum. This gives your statement a purpose beyond repeating the university’s reputation.",{"children":"For a research application, explain the academic question you want to investigate and why your prior work prepares you for it. For a taught programme, connect relevant coursework and skills to the curriculum. This gives your statement a purpose beyond repeating the university’s reputation."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://isd.pku.edu.cn/en/detail.php?id=730",{"children":["",["$","a",null,{"href":"https://isd.pku.edu.cn/en/detail.php?id=730","target":"_blank","rel":"noreferrer","children":"Official graduate prospectus: named 2026 cycle"}]]}],["$","span","https://isd.pku.edu.cn/en/",{"children":[" · ",["$","a",null,{"href":"https://isd.pku.edu.cn/en/","target":"_blank","rel":"noreferrer","children":"International student office"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Degree and programme requirements come first","children":[["$","$L4","/guides/statement-of-purpose/",{"href":"/guides/statement-of-purpose/","children":["Statement of purpose framework",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1e:["$","section","2-Separate CGS, PKU Scholarship and other funding",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Separate CGS, PKU Scholarship and other funding"}],[["$","p","The official PKU scholarship page describes university scholarship support, degree scope and annual review. The university’s scholarship directory also carries other funding notices. Do not combine several different benefits into one guaranteed “Peking full scholarship”.",{"children":"The official PKU scholarship page describes university scholarship support, degree scope and annual review. The university’s scholarship directory also carries other funding notices. Do not combine several different benefits into one guaranteed “Peking full scholarship”."}],["$","p","Make a comparison in which each row has a provider, audience, coverage, cycle and application route. If a notice names students already studying at PKU, keep it outside your incoming-student funding plan. If considering Yenching Academy, read its own programme call rather than using it as a synonym for every PKU scholarship.",{"children":"Make a comparison in which each row has a provider, audience, coverage, cycle and application route. If a notice names students already studying at PKU, keep it outside your incoming-student funding plan. If considering Yenching Academy, read its own programme call rather than using it as a synonym for every PKU scholarship."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Funding comparison questions for a prospective applicant","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Funding comparison questions for a prospective applicant"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route",{"scope":"col","children":"Route"}],["$","th","What to establish",{"scope":"col","children":"What to establish"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Chinese Government Scholarship"}],["$","td","1",{"children":"Which channel, programme and nomination process apply?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"PKU Scholarship"}],["$","td","1",{"children":"Degree eligibility, application stage, coverage and annual review"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Beijing Government or other awards"}],["$","td","1",{"children":"Prospective/current-student scope and the exact notice"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Yenching or another special programme"}],["$","td","1",{"children":"Separate degree, selection process and funding conditions"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://isd.pku.edu.cn/en/detail.php?id=525","target":"_blank","rel":"noreferrer","children":"Official guidance"}]]}]],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://isd.pku.edu.cn/en/scholarship.php",{"children":["",["$","a",null,{"href":"https://isd.pku.edu.cn/en/scholarship.php","target":"_blank","rel":"noreferrer","children":"Official scholarship notice directory"}]]}]]]}],"$undefined"]}]
1f:["$","section","3-Documents: build the file for your programme and intake",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Documents: build the file for your programme and intake"}],[["$","p","Use the current programme list to identify the exact academic, language and recommendation requirements. The general graduate prospectus is a useful guide to document categories, but it cannot establish a future cycle’s exact passport date or every specialist programme’s rule.",{"children":"Use the current programme list to identify the exact academic, language and recommendation requirements. The general graduate prospectus is a useful guide to document categories, but it cannot establish a future cycle’s exact passport date or every specialist programme’s rule."}],["$","p","Prepare a reconciliation sheet containing document name, issuer, reference period, translation requirement and submission channel. Ask referees early and confirm whether the portal sends them a private link. Keep final-degree authentication or provisional-degree requirements separate from writing tasks so that a polished statement does not conceal a missing compulsory certificate.",{"children":"Prepare a reconciliation sheet containing document name, issuer, reference period, translation requirement and submission channel. Ask referees early and confirm whether the portal sends them a private link. Keep final-degree authentication or provisional-degree requirements separate from writing tasks so that a polished statement does not conceal a missing compulsory certificate."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Identity and nationality-status evidence where applicable.",{"children":"Identity and nationality-status evidence where applicable."}],["$","li","Qualification, transcript and required authentication.",{"children":"Qualification, transcript and required authentication."}],["$","li","Programme-specific language proof.",{"children":"Programme-specific language proof."}],["$","li","Personal statement or research plan in the required format.",{"children":"Personal statement or research plan in the required format."}],["$","li","References submitted through the actual requested route.",{"children":"References submitted through the actual requested route."}],["$","li","Any programme-specific additional evidence.",{"children":"Any programme-specific additional evidence."}]]}],"$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://isd.pku.edu.cn/en/detail.php?id=730",{"children":["",["$","a",null,{"href":"https://isd.pku.edu.cn/en/detail.php?id=730","target":"_blank","rel":"noreferrer","children":"PKU graduate document instructions"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Documents: build the file for your programme and intake","children":[["$","$L4","/guides/recommendation-letter/",{"href":"/guides/recommendation-letter/","children":["Recommendation-letter planning",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/scholarship-cv/",{"href":"/guides/scholarship-cv/","children":["Scholarship CV preparation",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
20:["$","section","4-Application sequence: read the rule for the specific scholarship",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Application sequence: read the rule for the specific scholarship"}],[["$","p","For university admission, use the official international-student system and programme instructions. For funding, confirm whether consideration is automatic, separately requested or dependent on pre-admission or nomination. Do not assume the procedure for one scholarship applies to another.",{"children":"For university admission, use the official international-student system and programme instructions. For funding, confirm whether consideration is automatic, separately requested or dependent on pre-admission or nomination. Do not assume the procedure for one scholarship applies to another."}],["$","p","Keep the major, study level and identity consistent across the university and any scholarship system. If you select several academic options, check how the funding route treats that choice before submitting. A university evaluation result, a scholarship recommendation and a final award notification each need their own record.",{"children":"Keep the major, study level and identity consistent across the university and any scholarship system. If you select several academic options, check how the funding route treats that choice before submitting. A university evaluation result, a scholarship recommendation and a final award notification each need their own record."}]],["$","ol",null,{"className":"process-steps","aria-label":"Application sequence: read the rule for the specific scholarship","children":[["$","li","Find the programme and current admission notice.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Find the programme and current admission notice."}]]}],["$","li","Check academic and language eligibility.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Check academic and language eligibility."}]]}],["$","li","Submit the required university application.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Submit the required university application."}]]}],["$","li","Follow the exact scholarship consideration or separate application process.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Follow the exact scholarship consideration or separate application process."}]]}],["$","li","Monitor official requests and retain confirmation records.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Monitor official requests and retain confirmation records."}]]}],["$","li","After selection, complete final academic and arrival requirements.",{"children":[["$","span",null,{"children":6}],["$","strong",null,{"children":"After selection, complete final academic and arrival requirements."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://isd.pku.edu.cn/en/",{"children":["",["$","a",null,{"href":"https://isd.pku.edu.cn/en/","target":"_blank","rel":"noreferrer","children":"PKU international student system and admissions entry point"}]]}]]]}],"$undefined"]}]
21:["$","section","5-Fees and living costs: compare coverage with actual payments",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Fees and living costs: compare coverage with actual payments"}],[["$","p","Do not assume an application is free because scholarship funding exists. Check the current admission form and fee notice for your route before payment. Then separate tuition, housing, living allowance and insurance in the actual award. Partial support should be represented as partial support.",{"children":"Do not assume an application is free because scholarship funding exists. Check the current admission form and fee notice for your route before payment. Then separate tuition, housing, living allowance and insurance in the actual award. Partial support should be represented as partial support."}],["$","p","Create a small cash-flow plan for document preparation, tests, applications, travel and arrival. Mark which costs arise before a funding decision, which are paid directly to the university and which depend on later reimbursement or allowance. The result shows what you must finance independently rather than only the advertised award value.",{"children":"Create a small cash-flow plan for document preparation, tests, applications, travel and arrival. Mark which costs arise before a funding decision, which are paid directly to the university and which depend on later reimbursement or allowance. The result shows what you must finance independently rather than only the advertised award value."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Fees and living costs: compare coverage with actual payments","children":[["$","$L4","/guides/china-universities-without-application-fees/",{"href":"/guides/china-universities-without-application-fees/","children":["China application-fee comparison",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/chinese-government-scholarship/",{"href":"/scholarships/chinese-government-scholarship/","children":["Compare Chinese funding routes",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
22:["$","section","6-Annual review and post-offer responsibilities",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Annual review and post-offer responsibilities"}],[["$","p","The official PKU Scholarship description includes annual review for renewal. An initial award should therefore become a list of academic and administrative obligations, not an assumption that every later year is unconditional. Save the award letter and the rules that apply to it.",{"children":"The official PKU Scholarship description includes annual review for renewal. An initial award should therefore become a list of academic and administrative obligations, not an assumption that every later year is unconditional. Save the award letter and the rules that apply to it."}],["$","p","Before travel, resolve remaining degree conditions, the institution’s enrolment instructions and the official arrival documents. If an admission or scholarship message asks for action, respond through the stated official channel. Do not use an unofficial payment request as evidence that a scholarship has been awarded.",{"children":"Before travel, resolve remaining degree conditions, the institution’s enrolment instructions and the official arrival documents. If an admission or scholarship message asks for action, respond through the stated official channel. Do not use an unofficial payment request as evidence that a scholarship has been awarded."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://isd.pku.edu.cn/en/detail.php?id=525",{"children":["",["$","a",null,{"href":"https://isd.pku.edu.cn/en/detail.php?id=525","target":"_blank","rel":"noreferrer","children":"PKU Scholarship and annual review"}]]}]]]}],"$undefined"]}]
23:["$","section","7-A useful final decision: fit, funding and readiness",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"A useful final decision: fit, funding and readiness"}],[["$","p","Score your shortlist on academic fit, evidence readiness, cost and timing rather than fame alone. A lower-cost or better-aligned programme may be a stronger application than one requiring documents or funding you cannot obtain. Use the China hub to compare routes while keeping each university’s official conditions distinct.",{"children":"Score your shortlist on academic fit, evidence readiness, cost and timing rather than fame alone. A lower-cost or better-aligned programme may be a stronger application than one requiring documents or funding you cannot obtain. Use the China hub to compare routes while keeping each university’s official conditions distinct."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L27",null,{"id":"guides/peking-university-admissions-scholarships:section-8","title":"Check your progress","items":["Correct programme and intake notice identified.","Prospective/current-student funding scope checked.","Academic and language evidence ready.","Application and scholarship procedures tracked separately.","Funding exclusions and initial costs understood.","Renewal and final enrolment conditions retained."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for A useful final decision: fit, funding and readiness","children":[["$","$L4","/countries/china/",{"href":"/countries/china/","children":["China country pathway",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/tsinghua-university-admissions-scholarships/",{"href":"/guides/tsinghua-university-admissions-scholarships/","children":["Tsinghua admission and funding guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
24:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://isd.pku.edu.cn/en/",{"href":"https://isd.pku.edu.cn/en/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"PKU International Student Division"}],["$","span",null,{"children":"Checked 20 October 2026; the named programme and cycle control the rule."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://isd.pku.edu.cn/en/detail.php?id=730",{"href":"https://isd.pku.edu.cn/en/detail.php?id=730","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Graduate admission: 2026 named-cycle prospectus"}],["$","span",null,{"children":"Checked 20 October 2026; the named programme and cycle control the rule."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$24:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://isd.pku.edu.cn/en/detail.php?id=525",{"href":"https://isd.pku.edu.cn/en/detail.php?id=525","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"PKU Scholarship: scope, application and review"}],["$","span",null,{"children":"Checked 20 October 2026; the named programme and