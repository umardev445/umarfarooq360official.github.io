24:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.usefp.org/scholarships/fulbright-degree.cfm",{"children":["",["$","a",null,{"href":"https://www.usefp.org/scholarships/fulbright-degree.cfm","target":"_blank","rel":"noreferrer","children":"USEFP degree programme"}]]}],["$","span","https://usefp.org/scholarships/fulbright-degree-FAQ.cfm",{"children":[" · ",["$","a",null,{"href":"https://usefp.org/scholarships/fulbright-degree-FAQ.cfm","target":"_blank","rel":"noreferrer","children":"official FAQ"}]]}]]]}]
25:["$","section","3-Chevening: calculate the fee gap above the cap",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Chevening: calculate the fee gap above the cap"}],[["$","p","Chevening’s course guidance caps the tuition contribution for an MBA at GBP 22,000. Its Pakistan 2027/28 round is closed as of this review. Use the cap for understanding a route or preparing for a future call, not as an invitation to submit late.",{"children":"Chevening’s course guidance caps the tuition contribution for an MBA at GBP 22,000. Its Pakistan 2027/28 round is closed as of this review. Use the cap for understanding a route or preparing for a future call, not as an invitation to submit late."}],["$","p","Original hypothetical example: if an eligible MBA tuition bill is GBP 40,000 and the applicable tuition contribution is GBP 22,000, the tuition gap is GBP 18,000. That is 40,000 − 22,000. Compare other confirmed benefits and costs separately; do not assume the tuition cap is the entire award or convert currencies at an invented rate.",{"children":"Original hypothetical example: if an eligible MBA tuition bill is GBP 40,000 and the applicable tuition contribution is GBP 22,000, the tuition gap is GBP 18,000. That is 40,000 − 22,000. Compare other confirmed benefits and costs separately; do not assume the tuition cap is the entire award or convert currencies at an invented rate."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"Hypothetical tuition GBP 40,000 − applicable MBA fee support GBP 22,000 = GBP 18,000 remaining tuition. This is arithmetic, not a quotation for a named business school."}]]}],"$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.chevening.org/scholarship/pakistan/",{"children":["",["$","a",null,{"href":"https://www.chevening.org/scholarship/pakistan/","target":"_blank","rel":"noreferrer","children":"Chevening Pakistan status"}]]}],["$","span","https://www.chevening.org/resource-hub/guidance/courses/",{"children":[" · ",["$","a",null,{"href":"https://www.chevening.org/resource-hub/guidance/courses/","target":"_blank","rel":"noreferrer","children":"MBA course funding cap"}]]}]]]}],"$undefined"]}]
26:["$","section","4-LUMS: distinguish scholarships from repayable support",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"LUMS: distinguish scholarships from repayable support"}],[["$","p","The MBA programme describes graduate need-based aid as an interest-free loan. An interest-free loan is still repayable. Merit, women-focused or external funding products have their own rules and must not all be labelled the same scholarship.",{"children":"The MBA programme describes graduate need-based aid as an interest-free loan. An interest-free loan is still repayable. Merit, women-focused or external funding products have their own rules and must not all be labelled the same scholarship."}],["$","p","Ask for the actual aid decision: amount, what it pays, disbursement, repayment trigger, schedule and any continuation conditions.",{"children":"Ask for the actual aid decision: amount, what it pays, disbursement, repayment trigger, schedule and any continuation conditions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://lums.edu.pk/programmes/mba",{"children":["",["$","a",null,{"href":"https://lums.edu.pk/programmes/mba","target":"_blank","rel":"noreferrer","children":"LUMS MBA funding"}]]}]]]}],"$undefined"]}]
27:["$","section","5-INSEAD and other school awards: read the named award",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"INSEAD and other school awards: read the named award"}],[["$","p","INSEAD directs applicants into its scholarship process after the MBA application. Individual awards can target particular financial, geographic or professional profiles. The existence of a scholarship directory does not prove eligibility for every item or full funding.",{"children":"INSEAD directs applicants into its scholarship process after the MBA application. Individual awards can target particular financial, geographic or professional profiles. The existence of a scholarship directory does not prove eligibility for every item or full funding."}],["$","p","Record the award title, eligible campus/intake, need or merit criteria, amount, separate essays and whether several awards can be combined. A general marketing percentage should not replace the actual award letter.",{"children":"Record the award title, eligible campus/intake, need or merit criteria, amount, separate essays and whether several awards can be combined. A general marketing percentage should not replace the actual award letter."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.insead.edu/master-programmes/master-business-administration/insead-scholarships",{"children":["",["$","a",null,{"href":"https://www.insead.edu/master-programmes/master-business-administration/insead-scholarships","target":"_blank","rel":"noreferrer","children":"INSEAD MBA scholarships"}]]}]]]}],"$undefined"]}]
28:["$","section","6-MBA without experience and test-score searches",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"MBA without experience and test-score searches"}],[["$","p","There is no universal no-experience MBA scholarship route or universal GMAT cutoff. First check whether the MBA itself accepts your profile; then check the award. A scholarship cannot override an admission condition unless the institution explicitly provides that route.",{"children":"There is no universal no-experience MBA scholarship route or universal GMAT cutoff. First check whether the MBA itself accepts your profile; then check the award. A scholarship cannot override an admission condition unless the institution explicitly provides that route."}],["$","p","Keep an MBA separate from a general MSc in business, management or finance. If a fund excludes MBA degrees, do not relabel the programme to fit. The exact qualification and current scheme rules control eligibility.",{"children":"Keep an MBA separate from a general MSc in business, management or finance. If a fund excludes MBA degrees, do not relabel the programme to fit. The exact qualification and current scheme rules control eligibility."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","7-Your funding-gap checklist",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Your funding-gap checklist"}],[["$","p","Write one budget in the course currency, using confirmed tuition and award terms. Separate the supported tuition portion, living support, travel/insurance, deposits, uncovered fees and repayment obligations. Record the first payment date as well as the amount.",{"children":"Write one budget in the course currency, using confirmed tuition and award terms. Separate the supported tuition portion, living support, travel/insurance, deposits, uncovered fees and repayment obligations. Record the first payment date as well as the amount."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2e",null,{"id":"guides/mba-scholarships-for-pakistani-students:section-8","title":"Check your progress","items":["The award covers the actual MBA and my nationality/residence.","Admission experience and test requirements satisfied.","Tuition cap or percentage applied to the correct bill.","Living and arrival costs remain visible.","Grant, fee waiver and loan labelled separately.","Scholarship and MBA application stages both recorded."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Your funding-gap checklist","children":[["$","$L4","/guides/masters-scholarships-for-pakistani-students/",{"href":"/guides/masters-scholarships-for-pakistani-students/","children":["Non-MBA master’s scholarships",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/scholarships-in-pakistan/",{"href":"/guides/scholarships-in-pakistan/","children":["Study-in-Pakistan funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/scholarships-for-pakistani-students/",{"href":"/guides/scholarships-for-pakistani-students/","children":["Pakistan scholarship overview",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/statement-of-purpose/",{"href":"/guides/statement-of-purpose/","children":["Statement-of-purpose guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
