22:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Does Commonwealth Master’s fund an MBA?",{"children":[["$","summary",null,{"children":["Does Commonwealth Master’s fund an MBA?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The reviewed general Commonwealth Master’s scheme excludes MBA degrees."}]]}],["$","details","Does Chevening always pay the full MBA tuition bill?",{"children":[["$","summary",null,{"children":["Does Chevening always pay the full MBA tuition bill?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Its course guidance gives a GBP 22,000 MBA tuition cap; any amount above the applicable cap needs a separate plan."}]]}],["$","details","Is an interest-free student loan a scholarship?",{"children":[["$","summary",null,{"children":["Is an interest-free student loan a scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It remains repayable. Compare the actual repayment terms separately from non-repayable grants."}]]}],["$","details","Can I get an MBA scholarship without work experience?",{"children":[["$","summary",null,{"children":["Can I get an MBA scholarship without work experience?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Only if both the MBA and the named award permit your profile. USEFP’s MBA route requires at least two years of relevant experience."}]]}]]}]]}]
