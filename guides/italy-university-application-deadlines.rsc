27:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","What is the Italy university application deadline for 2027?",{"children":[["$","summary",null,{"children":["What is the Italy university application deadline for 2027?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"There is no single national deadline. Each university and programme publishes its own calls, and applicant category can change which round is available."}]]}],["$","details","When did Padua applications open for 2027–2028?",{"children":[["$","summary",null,{"children":["When did Padua applications open for 2027–2028?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The University of Padua states that the first call for most programmes opened on 15 September 2026 and closes on 15 November 2026. Check the exact programme for exceptions."}]]}],["$","details","Can non-EU students apply in the last call?",{"children":[["$","summary",null,{"children":["Can non-EU students apply in the last call?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not always. Some later calls are limited to EU applicants or non-EU applicants already resident in Italy, so verify the category written in the official call."}]]}],["$","details","Is the scholarship deadline the same as admission?",{"children":[["$","summary",null,{"children":["Is the scholarship deadline the same as admission?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Often it is separate and can be earlier. Track admission and every funding application independently."}]]}]]}]]}]
