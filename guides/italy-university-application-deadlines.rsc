2a:["$","p","Non-EU applicants living outside Italy should avoid relying on late rounds that may be limited to EU applicants or people already resident in Italy. Earlier submission also leaves more time for qualification recognition and visa preparation.",{"children":"Non-EU applicants living outside Italy should avoid relying on late rounds that may be limited to EU applicants or people already resident in Italy. Earlier submission also leaves more time for qualification recognition and visa preparation."}]
2b:["$","ul",null,{"children":[["$","li","September–October 2026: shortlist and prepare documents",{"children":"September–October 2026: shortlist and prepare documents"}],["$","li","October–December 2026: submit early university and scholarship applications",{"children":"October–December 2026: submit early university and scholarship applications"}],["$","li","January–March 2027: use eligible later calls",{"children":"January–March 2027: use eligible later calls"}],["$","li","After admission: complete Universitaly pre-enrolment",{"children":"After admission: complete Universitaly pre-enrolment"}],["$","li","Before travel: finish visa and accommodation planning",{"children":"Before travel: finish visa and accommodation planning"}]]}]
2c:["$","section","4-Separate four types of deadline",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Separate four types of deadline"}],[["$","p","A strong tracker has separate rows for university admission, scholarship or fee support, Universitaly pre-enrolment and the visa. Combining them into one date creates missed steps.",{"children":"A strong tracker has separate rows for university admission, scholarship or fee support, Universitaly pre-enrolment and the visa. Combining them into one date creates missed steps."}],["$","p","Also record document deadlines. A language certificate, portfolio, test, CIMEA statement or financial record may be due before final enrolment even when the initial application accepts a temporary document.",{"children":"Also record document deadlines. A language certificate, portfolio, test, CIMEA statement or financial record may be due before final enrolment even when the initial application accepts a temporary document."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Admission application",{"children":"Admission application"}],["$","li","Application fee payment",{"children":"Application fee payment"}],["$","li","Language or test evidence",{"children":"Language or test evidence"}],["$","li","Scholarship application",{"children":"Scholarship application"}],["$","li","Universitaly pre-enrolment",{"children":"Universitaly pre-enrolment"}],["$","li","Visa submission",{"children":"Visa submission"}],["$","li","Final enrolment and original documents",{"children":"Final enrolment and original documents"}]]}],"$undefined","$undefined","$undefined"]}]
2d:["$","section","5-How to verify a deadline in five minutes",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"How to verify a deadline in five minutes"}],[["$","p","Open the official programme page, locate the current academic year and identify your applicant category. Confirm whether the displayed time uses CET or CEST, then check whether payment and document upload must also finish before the same cut-off.",{"children":"Open the official programme page, locate the current academic year and identify your applicant category. Confirm whether the displayed time uses CET or CEST, then check whether payment and document upload must also finish before the same cut-off."}],["$","p","Recheck the page one week before submission and again on the day you apply. Keep the confirmation email and a copy of the submitted file.",{"children":"Recheck the page one week before submission and again on the day you apply. Keep the confirmation email and a copy of the submitted file."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2e:["$","section","6-Weekly tracker template",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Weekly tracker template"}],[["$","p","Review the tracker once a week. Mark each record as researching, preparing, submitted, decision received or closed. Add the last-checked date and the official URL instead of relying on a remembered date.",{"children":"Review the tracker once a week. Mark each record as researching, preparing, submitted, decision received or closed. Add the last-checked date and the official URL instead of relying on a remembered date."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","University and programme",{"children":"University and programme"}],["$","li","Degree level and teaching language",{"children":"Degree level and teaching language"}],["$","li","Applicant category",{"children":"Applicant category"}],["$","li","Open and close dates with time zone",{"children":"Open and close dates with time zone"}],["$","li","Fee and payment status",{"children":"Fee and payment status"}],["$","li","Required documents",{"children":"Required documents"}],["$","li","Scholarship dependency",{"children":"Scholarship dependency"}],["$","li","Official source and last-checked date",{"children":"Official source and last-checked date"}]]}],"$undefined","$undefined","$undefined"]}]
