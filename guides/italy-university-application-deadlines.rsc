1d:["$","section","1-Admission and scholarship dates at a glance",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Admission and scholarship dates at a glance"}],[["$","p","Admission and scholarship dates rechecked 13 October 2026 on the named Padua and Polimi pages. This remains a selected tracker, not a national calendar. Polimi's Engineering heading still differs from its September 2027 table rows; confirm the programme with admissions before relying on that route.",{"children":"Admission and scholarship dates rechecked 13 October 2026 on the named Padua and Polimi pages. This remains a selected tracker, not a national calendar. Polimi's Engineering heading still differs from its September 2027 table rows; confirm the programme with admissions before relying on that route."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Named calls and tasks: keep the academic year attached","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Named calls and tasks: keep the academic year attached"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Task",{"scope":"col","children":"Task"}],["$","th","Published date",{"scope":"col","children":"Published date"}],["$","th","Category/status",{"scope":"col","children":"Category/status"}]],["$","th",null,{"scope":"col","children":"Next step"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Padua first admission call"}],["$","td","1",{"children":"15 Sep–15 Nov 2026"}],["$","td","2",{"children":"Most 2027–2028 programmes; exceptions apply"}]],["$","td",null,{"children":["$","$L4",null,{"href":"/guides/university-of-padua-admissions-scholarships/","target":"$undefined","rel":"$undefined",