18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/expansion-20261022/germany-studienkolleg-1280.webp","srcSet":"/images/expansion-20261022/germany-studienkolleg-640.webp 640w, /images/expansion-20261022/germany-studienkolleg-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Book-lined reading space in a Berlin library","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Destination or study photograph; not a photograph of the named university or scholarship."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"A Studienkolleg prepares eligible applicants for study in Germany when their qualification does not provide the required direct entry. The appropriate track, language level and application route depend on the receiving institution and subject."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Ask your target university how it assesses your exact school qualification, then use that answer to choose a recognised preparation route."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Do you need Studienkolleg or another route?",{"href":"#section-1","children":"Do you need Studienkolleg or another route?"}],["$","a","Subject track and final assessment",{"href":"#section-2","children":"Subject track and final assessment"}],["$","a","Public and private providers: compare the outcome",{"href":"#section-3","children":"Public and private providers: compare the outcome"}],["$","a","German language and the entrance examination",{"href":"#section-4","children":"German language and the entrance examination"}],["$","a","Application sequence and document preparation",{"href":"#section-5","children":"Application sequence and document preparation"}],["$","a","Costs and progression planning",{"href":"#section-6","children":"Costs and progression planning"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Do you need Studienkolleg or another route?",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Do you need Studienkolleg or another route?"}],[["$","p","Begin with the university’s qualification assessment. Depending on your education, you may have direct access, subject-restricted access, a need for preparatory study or another requirement. A nationality alone is not enough to decide the route: the certificate, subjects and any previous university study matter.",{"children":"Begin with the university’s qualification assessment. Depending on your education, you may have direct access, subject-restricted access, a need for preparatory study or another requirement. A nationality alone is not enough to decide the route: the certificate, subjects and any previous university study matter."}],["$","p","Do not buy a preparatory course because an advertisement says every international student needs one. Keep the university’s written response or official assessment instructions, and check whether the route leads to your intended degree subject.",{"children":"Do not buy a preparatory course because an advertisement says every international student needs one. Keep the university’s written response or official assessment instructions, and check whether the route leads to your intended degree subject."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$L1a"]}],"$L1b","$L1c","$L1d","$L1e","$L1f"]}],false,"$L20","$L21"]}],"$L22"]}]
