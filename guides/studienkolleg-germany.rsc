1a:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Do you need Studienkolleg or another route?","children":[["$","$L4","/guides/study-in-germany-admission-requirements/",{"href":"/guides/study-in-germany-admission-requirements/","children":["Germany admission requirements",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
1b:["$","section","1-Subject track and final assessment",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Subject track and final assessment"}],[["$","p","Preparation is organised around subject pathways. Course names such as T, W, M, G or S are commonly used, but offerings and recognition must be checked at the provider and receiving university. A pathway aimed at technical study should not be assumed to qualify you for an unrelated subject.",{"children":"Preparation is organised around subject pathways. Course names such as T, W, M, G or S are commonly used, but offerings and recognition must be checked at the provider and receiving university. A pathway aimed at technical study should not be assumed to qualify you for an unrelated subject."}],["$","p","DAAD describes the usual preparation period as two semesters, with possible exceptions, and explains the final Feststellungsprüfung. Passing the relevant assessment establishes access within its recognised scope; it does not remove a degree programme’s selection or language requirements.",{"children":"DAAD describes the usual preparation period as two semesters, with possible exceptions, and explains the final Feststellungsprüfung. Passing the relevant assessment establishes access within its recognised scope; it does not remove a degree programme’s selection or language requirements."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Before choosing a preparation course","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Before choosing a preparation course"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Check",{"scope":"col","children":"Check"}],["$","th","Question to ask",{"scope":"col","children":"Question to ask"}],["$","th","Why it matters",{"scope":"col","children":"Why it matters"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Subject pathway"}],["$","td","1",{"children":"Which future degrees does this track support?"}],["$","td","2",{"children":"Avoid preparing for an incompatible subject"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Recognition"}],["$","td","1",{"children":"Who administers the assessment and accepts the certificate?"}],["$","td","2",{"children":"Provider marketing is not recognition evidence"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Language"}],["$","td","1",{"children":"What is required at entry and at degree admission?"}],["$","td","2",{"children":"Course admission and degree admission can differ"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Application route"}],["$","td","1",{"children":"University, uni-assist or provider?"}],["$","td","2",{"children":"Submitting to the wrong body can miss the intake"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1c:["$","section","2-Public and private providers: compare the outcome",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Public and private providers: compare the outcome"}],[["$","p","Compare the assessment, recognition and progression conditions before comparing tuition prices. Ask who issues the certificate and whether the receiving university accepts it for your degree. A privately delivered preparation course is not automatically equivalent to every public Studienkolleg route.",{"children":"Compare the assessment, recognition and progression conditions before comparing tuition prices. Ask who issues the certificate and whether the receiving university accepts it for your degree. A privately delivered preparation course is not automatically equivalent to every public Studienkolleg route."}],["$","p","Read the contract for course fees, exam fees, resit rules and refunds. Check whether the advertised package includes an external assessment or merely preparation for it. Keep written answers; a statement that “many students progress” does not confirm your admission eligibility.",{"children":"Read the contract for course fees, exam fees, resit rules and refunds. Check whether the advertised package includes an external assessment or merely preparation for it. Keep written answers; a statement that “many students progress” does not confirm your admission eligibility."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","3-German language and the entrance examination",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"German language and the entrance examination"}],[["$","p","Most Studienkollegs teach in German, according to DAAD. Check the actual language level and accepted certificate at your chosen provider. An English-taught degree later in your plan does not automatically make its preparatory route English-taught.",{"children":"Most Studienkollegs teach in German, according to DAAD. Check the actual language level and accepted certificate at your chosen provider. An English-taught degree later in your plan does not automatically make its preparatory route English-taught."}],["$","p","Use official sample tests where available. Build practice around the stated language and subject components, with timed attempts and review of mistakes. Do not assume that an external test such as TestAS replaces a Studienkolleg entrance examination.",{"children":"Use official sample tests where available. Build practice around the stated language and subject components, with timed attempts and review of mistakes. Do not assume that an external test such as TestAS replaces a Studienkolleg entrance examination."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for German language and the entrance examination","children":[["$","$L4","/guides/testas-exam-germany/",{"href":"/guides/testas-exam-germany/","children":["What TestAS measures",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1e:["$","section","4-Application sequence and document preparation",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Application sequence and document preparation"}],[["$","p","Record the Studienkolleg application deadline separately from the bachelor’s intake deadline. If the university uses uni-assist, check whether a VPD or a standard application is required for this route. Some tasks require document review before you can register for the entrance assessment.",{"children":"Record the Studienkolleg application deadline separately from the bachelor’s intake deadline. If the university uses uni-assist, check whether a VPD or a standard application is required for this route. Some tasks require document review before you can register for the entrance assessment."}],["$","p","Prepare your school certificate, subject results, language evidence and any prior study records in the form requested. Check translation and certification rules before sending documents. A complete file submitted late may still miss the intake.",{"children":"Prepare your school certificate, subject results, language evidence and any prior study records in the form requested. Check translation and certification rules before sending documents. A complete file submitted late may still miss the intake."}]],["$","ol",null,{"className":"process-steps","aria-label":"Application sequence and document preparation","children":[["$","li","Confirm your qualification route with the target university",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Confirm your qualification route with the target university"}]]}],["$","li","Select a compatible subject pathway and recognised assessment",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Select a compatible subject pathway and recognised assessment"}]]}],["$","li","Check language and entrance-exam requirements",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Check language and entrance-exam requirements"}]]}],["$","li","Submit to the correct institution or application service",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Submit to the correct institution or application service"}]]}],["$","li","Plan the final assessment and later degree application",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Plan the final assessment and later degree application"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","5-Costs and progression planning",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Costs and progression planning"}],[["$","p","Estimate course and examination charges, semester contributions where applicable, accommodation, insurance and daily living costs. A course advertised as tuition-free can still involve substantial living and administrative expenses.",{"children":"Estimate course and examination charges, semester contributions where applicable, accommodation, insurance and daily living costs. A course advertised as tuition-free can still involve substantial living and administrative expenses."}],["$","p","Build a backup route if you need another examination attempt or cannot start the intended degree immediately. Check the immigration implications with the competent authority rather than assuming every course or delay has the same treatment.",{"children":"Build a backup route if you need another examination attempt or cannot start the intended degree immediately. Check the immigration implications with the competent authority rather than assuming every course or delay has the same treatment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L23",null,{"id":"guides/studienkolleg-germany:section-6","title":"Check your progress","items":["Qualification route established","Target degree compatible with the track","Assessment recognition checked","Entrance and degree language rules recorded","Budget includes living costs and possible delay"]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Costs and progression planning","children":[["$","$L4","/guides/cost-of-living-in-germany-for-students/",{"href":"/guides/cost-of-living-in-germany-for-students/","children":["Germany student budget",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/germany-university-application-deadlines/",{"href":"/guides/germany-university-application-deadlines/","children":["Application deadlines",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
