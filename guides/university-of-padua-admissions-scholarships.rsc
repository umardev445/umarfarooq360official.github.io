nd curricular background.",{"children":"Padua's international route is for applicants holding a qualification obtained abroad. Bachelor's entry requires an eligible school qualification; master's entry requires a suitable prior degree and curricular background."}],"$L1c"],"$undefined","$L1d","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}],false,"$L25","$L26"]}],"$L27"]}]
