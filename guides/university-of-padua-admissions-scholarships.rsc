1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/university-of-padua-admissions-scholarships/\",\"name\":\"University of Padua: international admissions, fees and scholarships\",\"description\":\"Plan a University of Padua application: 2027–28 first-call dates, academic fit, current English evidence, fee categories and separate scholarship checks.\",\"url\":\"https://aspirecompass.org/guides/university-of-padua-admissions-scholarships/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-05\",\"dateModified\":\"2026-10-13\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/programme-research-editorial.webp\",\"caption\":\"Students working through programme information and application notes\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"University of Padua: international admissions, fees and scholarships\",\"item\":\"https://aspirecompass.org/guides/university-of-padua-admissions-scholarships/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"University of Padua: international admissions, fees and scholarships\",\"description\":\"Plan a University of Padua application: 2027–28 first-call dates, academic fit, current English evidence, fee categories and separate scholarship checks.\",\"image\":\"https://aspirecompass.org/images/programme-research-editorial.webp\",\"datePublished\":\"2026-10-05\",\"dateModified\":\"2026-10-13\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/university-of-padua-admissions-scholarships/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can I apply to Padua for 2027 now?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The first call for most 2027–2028 programmes is listed as 15 September–15 November 2026. Check your selected degree for exceptions and eligibility.\"}},{\"@type\":\"Question\",\"name\":\"Is the Padua scholarship guaranteed with admission?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Admission and scholarship selection are separate. Reopen the new scholarship call when available.\"}},{\"@type\":\"Question\",\"name\":\"Are the listed fees for 2027–2028?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The fee examples on this page are labelled 2026–2027; the new fee notice and your category determine the future amount.\"}}]}"}}]],"$L18",false,"$L19","$L1a"]}]
