1a:["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Intake"}],["$","td","1",{"children":"Read a dated official call"}],["$","td","2",{"children":"Do not carry last year’s deadline forward"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Route"}],["$","td","1",{"children":"Identify receiving authority and Type A or B"}],["$","td","2",{"children":"Record the official agency number"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Course"}],["$","td","1",{"children":"Confirm the international programme catalogue"}],["$","td","2",{"children":"Match language, qualification and scholarship eligibility"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Portals"}],["$","td","1",{"children":"List every required submission"}],["$","td","2",{"children":"CSC and university applications may both be needed"}]],"$undefined"]}]]}]
1b:["$","section","1-Step 1: capture the exact application instructions",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Step 1: capture the exact application instructions"}],[["$","p","Save the current call as a dated note with its URL. Record the degree, subject, teaching language, receiving organisation and deadline. If the notice links to an older detail page, do not silently combine dates or fees from different years. Ask the programme owner which instructions control the current cycle.",{"children":"Save the current call as a dated note with its URL. Record the degree, subject, teaching language, receiving organisation and deadline. If the notice links to an older detail page, do not silently combine dates or fees from different years. Ask the programme owner which instructions control the current cycle."}],["$","p","Use your own email address for accounts and retain access to it throughout review. Keep passwords private. An adviser can help organise an application without controlling your credentials. Start from the official university or authority website rather than from a payment request sent through social media.",{"children":"Use your own email address for accounts and retain access to it throughout review. Keep passwords private. An adviser can help organise an application without controlling your credentials. Start from the official university or authority website rather than from a payment request sent through social media."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1c:["$","section","2-Step 2: build a document register",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Step 2: build a document register"}],[["$","p","Separate documents you already possess from those requiring another person or organisation. Transcripts, degree certificates, translations, recommendations and test results can take different amounts of time. Check whether the current call requests originals, notarised scans or certified translations before buying a service.",{"children":"Separate documents you already possess from those requiring another person or organisation. Transcripts, degree certificates, translations, recommendations and test results can take different amounts of time. Check whether the current call requests originals, notarised scans or certified translations before buying a service."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Document register to adapt to the current call","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Document register to adapt to the current call"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Document",{"scope":"col","children":"Document"}],["$","th","Check before upload",{"scope":"col","children":"Check before upload"}],["$","th","Common failure",{"scope":"col","children":"Common failure"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Passport"}],["$","td","1",{"children":"Name spelling, expiry and scan clarity"}],["$","td","2",{"children":"Mismatch between account and passport"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Degree / graduation evidence"}],["$","td","1",{"children":"Accepted provisional status and final deadline"}],["$","td","2",{"children":"Assuming a provisional letter is always accepted"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Transcript"}],["$","td","1",{"children":"All pages and grading scale"}],["$","td","2",{"children":"Missing reverse-side grading explanation"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Language result"}],["$","td","1",{"children":"Accepted test, score and validity"}],["$","td","2",{"children":"Submitting medium-of-instruction evidence without permission"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"References"}],["$","td","1",{"children":"Required number, signature and recommender status"}],["$","td","2",{"children":"Generic or unsigned letters"}]],"$undefined"]}],["$","tr","5",{"children":[[["$","th","0",{"scope":"row","children":"Health / police documents"}],["$","td","1",{"children":"Format and validity window"}],["$","td","2",{"children":"Obtaining time-limited records too early"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","3-Step 3: write a programme-specific study plan",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Step 3: write a programme-specific study plan"}],[["$","p","Describe the question or skill gap you want to address, your relevant preparation and why the selected programme is suitable. For a research degree, explain a feasible research question, proposed approach and supervision fit. For a taught degree, connect the curriculum to a concrete academic or professional goal.",{"children":"Describe the question or skill gap you want to address, your relevant preparation and why the selected programme is suitable. For a research degree, explain a feasible research question, proposed approach and supervision fit. For a taught degree, connect the curriculum to a concrete academic or professional goal."}],["$","p","Use evidence rather than inflated claims. One well-explained project can be stronger than a list of unrelated achievements. State your own contribution, methods, result and what you learned. Respect the university’s language and word-count rules; this guide does not impose a national word count.",{"children":"Use evidence rather than inflated claims. One well-explained project can be stronger than a list of unrelated achievements. State your own contribution, methods, result and what you learned. Respect the university’s language and word-count rules; this guide does not impose a national word count."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"Planning example: connect an undergraduate project on irrigation data to a proposed master’s research question about sensor reliability. Explain the data you could access and the methods you need to learn. Do not claim results you have not produced."}]]}],"$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","4-Step 4: manage supervisors and references professionally",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Step 4: manage supervisors and references professionally"}],[["$","p","Where the programme requires supervisor agreement or pre-admission, begin that process before the portal deadline. Send a concise introduction, academic CV and focused research outline. A reply expressing interest is not necessarily the formal acceptance document required by the call.",{"children":"Where the programme requires supervisor agreement or pre-admission, begin that process before the portal deadline. Send a concise introduction, academic CV and focused research outline. A reply expressing interest is not necessarily the formal acceptance document required by the call."}],["$","p","Give recommenders the programme name, submission method and realistic deadline. Supply a factual summary of your work together so the letter can be specific. Never write a fictitious endorsement or upload someone’s signature without authorisation.",{"children":"Give recommenders the programme name, submission method and realistic deadline. Supply a factual summary of your work together so the letter can be specific. Never write a fictitious endorsement or upload someone’s signature without authorisation."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Step 4: manage supervisors and references professionally","children":[["$","$L4","/guides/scholarship-cv/",{"href":"/guides/scholarship-cv/","children":["Prepare a scholarship CV",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/recommendation-letter/",{"href":"/guides/recommendation-letter/","children":["Recommendation letter planning",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1f:["$","section","5-Step 5: review both systems before submitting",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Step 5: review both systems before submitting"}],[["$","p","Copying data across portals creates opportunities for contradictions. Compare degree title, start date, passport name and study language in every form. Review the generated application PDF as well as the input screen. Some portals restrict editing after submission; do not use the final submit action as a test.",{"children":"Copying data across portals creates opportunities for contradictions. Compare degree title, start date, passport name and study language in every form. Review the generated application PDF as well as the input screen. Some portals restrict editing after submission; do not use the final submit action as a test."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L25",null,{"id":"guides/csc-scholarship-application:section-6","title":"Check your progress","items":["Correct receiving organisation and programme type selected","Every required portal completed","Required attachments open and remain legible","Study plan matches the chosen department","Dates and qualifications agree across systems","Fee status and payment receipt saved where applicable","Final form and submission confirmation downloaded"]}],"$undefined","$undefined"]}]
20:["$","section","6-Step 6: track requests after submission",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Step 6: track requests after submission"}],[["$","p","Create a simple log of submission time, application number, portal status and any request for corrections or interviews. Check the portal as well as email and spam folders. Respond through the official channel and keep a copy of important replies. A status such as reviewed, nominated or pre-admitted should not be rewritten as awarded.",{"children":"Create a simple log of submission time, application number, portal status and any request for corrections or interviews. Check the portal as well as email and spam folders. Respond through the official channel and keep a copy of important replies. A status such as reviewed, nominated or pre-admitted should not be rewritten as awarded."}],["$","p","If a portal fails near the deadline, save screenshots showing the time and error and contact the responsible office promptly. There is no guarantee of an extension. After an offer, compare funding terms and registration requirements before making travel commitments.",{"children":"If a portal fails near the deadline, save screenshots showing the time and error and contact the responsible office promptly. There is no guarantee of an extension. After an offer, compare funding terms and registration requirements before making travel commitments."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
