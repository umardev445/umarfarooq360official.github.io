16:["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--guide inner-hero--visual","children":["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L4",null,{"href":"/","children":"Home"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/",{"children":[["$","$L4",null,{"href":"/guides/","children":"Guides"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/scholarship-cv/",{"children":[["$","span",null,{"aria-current":"page","children":"How to write a scholarship CV for international applications"}],false]}]]}],["$","span",null,{"data-slot":"badge","data-variant":"outline","className":"inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3 border-border text-foreground [a&]:hover:bg-accent [a&]:hover:text-accent-foreground inner-eyebrow","children":"Application guide"}],["$","h1",null,{"children":"How to write a scholarship CV for international applications"}],["$","p",null,{"children":"A scholarship CV is a selective evidence document, not a complete autobiography. Its job is to help a reviewer find your academic preparation, relevant experience, research potential, leadership and contribution quickly enough to understand why you fit the award."}],["$","div",null,{"className":"inner-hero__meta","children":[["$","span",null,{"children":[["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z","key":"oel41y"}],["path",{"d":"m9 12 2 2 4-4","key":"dzmm74"}]],"className":"lucide-shield-check","aria-hidden":"true"}]," Updated ","13 Oct 2026"]}],null]}]]}],["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/application-writing-1280.webp","srcSet":"/images/application-writing-640.webp 640w, /images/application-writing-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"A student reviewing notes and preparing an application at a desk","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Prepare your own evidence, then adapt it to the application instructions."}]]}]]}]}]
17:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"A scholarship CV is a selective evidence document, not a complete autobiography. Its job is to help a reviewer find your academic preparation, relevant experience, research potential, leadership and contribution quickly enough to understand why you fit the award."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Start with the comparison or checklist below, then open the current instructions for your exact programme or route."]}],"$undefined"]}],false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Arrange a CV around the selection criteria",{"href":"#section-1","children":"Arrange a CV around the selection criteria"}],["$","a","Scholarship CV, academic CV and job resume",{"href":"#section-2","children":"Scholarship CV, academic CV and job resume"}],["$","a","How long should a scholarship CV be?",{"href":"#section-3","children":"How long should a scholarship CV be?"}],["$","a","Choose the section order from the selection criteria",{"href":"#section-4","children":"Choose the section order from the selection criteria"}],["$","a","Write a clean header and useful academic profile",{"href":"#section-5","children":"Write a clean header and useful academic profile"}],["$","a","Present education so an international reader can understand it",{"href":"#section-6","children":"Present education so an international reader can understand it"}],["$","a","Turn research and academic projects into evidence",{"href":"#section-7","children":"Turn research and academic projects into evidence"}],["$","a","Write achievement bullets instead of duty lists",{"href":"#section-8","children":"Write achievement bullets instead of duty lists"}],["$","a","Present work, internships, leadership and service selectively",{"href":"#section-9","children":"Present work, internships, leadership and service selectively"}],["$","a","List publications and presentations honestly",{"href":"#section-10","children":"List publications and presentations honestly"}],["$","a","Build a strong CV without formal work experience",{"href":"#section-11","children":"Build a strong CV without formal work experience"}],["$","a","A practical scholarship CV skeleton",{"href":"#section-12","children":"A practical scholarship CV skeleton"}],["$","a","An illustrative before-and-after CV entry",{"href":"#section-13","children":"An illustrative before-and-after CV entry"}],["$","a","Tailor the CV without rewriting your history",{"href":"#section-14","children":"Tailor the CV without rewriting your history"}],["$","a","Use Europass only when it serves the application",{"href":"#section-15","children":"Use Europass only when it serves the application"}],["$","a","Keep the design quiet and readable",{"href":"#section-16","children":"Keep the design quiet and readable"}],["$","a","Additional CV checks for Pakistani applicants",{"href":"#section-17","children":"Additional CV checks for Pakistani applicants"}],["$","a","Common scholarship CV mistakes",{"href":"#section-18","children":"Common scholarship CV mistakes"}],["$","a","Final scholarship CV checklist",{"href":"#section-19","children":"Final scholarship CV checklist"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Arrange a CV around the selection criteria",{"className":"article-section","id":"section-1","children":["$L19",["$L1a"],"$undefined","$L1b","$undefined","$L1c","$undefined","$L1d","$undefined"]}],"$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"]}],false,null,"$L30"]}],"$L31"]}]
18:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","guides/scholarship-application",{"href":"/guides/scholarship-application/","children":[["$","span",null,{"children":"Application guide"}],["$","h3",null,{"children":"How to apply for international scholarships step by step"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/statement-of-purpose",{"href":"/guides/statement-of-purpose/","children":[["$","span",null,{"children":"Writing guide"}],["$","h3",null,{"children":"How to write a statement of purpose for scholarships and graduate study"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/recommendation-letter",{"href":"/guides/recommendation-letter/","children":[["$","span",null,{"children":"Reference guide"}],["$","h3",null,{"children":"How to get strong scholarship recommendation letters"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","scholarships/fully-funded",{"href":"/scholarships/fully-funded/","children":[["$","span",null,{"children":"Funding level"}],["$","h3",null,{"children":"Fully funded scholarships for international students"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
32:I["ab32ab9b14fd",[],"TaskChecklist",1]
19:["$","h2",null,{"children":"Arrange a CV around the selection criteria"}]
1a:["$","p","Use this outline only when it fits the official prompt. Examples teach a method and must not be copied as personal experience.",{"children":"Use this outline only when it fits the official prompt. Examples teach a method and must not be copied as personal experience."}]
1b:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A working evidence map","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A working evidence map"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Part",{"scope":"col","children":"Part"}],["$","th","Evidence to gather",{"scope":"col","children":"Evidence to gather"}],["$","th","What to explain",{"scope":"col","children":"What to explain"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Education"}],["$","td","1",{"children":"Degree, institution, dates and grading scale"}],["$","td","2",{"children":"Make qualification context readable"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Research / projects"}],["$","td","1",{"children":"Question, method, contribution and result"}],["$","td","2",{"children":"Show your own role"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Leadership / service"}],["$","td","1",{"children":"Responsibility, dates and concrete evidence"}],["$","td","2",{"children":"Use truthful outcomes"}]],"$undefined"]}]]}]]}]}],"$undefined"]
1c:["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"Before: “Helped with a student project.” After: “Coordinated a four-person project team, tracked weekly tasks and presented the final findings.” This is a format example, not a claim to copy into your CV."}]]}]
1d:["$","$L32",null,{"id":"guides/scholarship-cv:section-1","title":"Check your progress","items":["Use the required page limit and format.","State dates and qualification names consistently.","Write evidence-based bullets.","Check every number and claim."]}]
1e:["$","section","1-Scholarship CV, academic CV and job resume",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Scholarship CV, academic CV and job resume"}],[["$","p","The document name does not always tell you the required format. A scholarship CV often emphasises education, academic projects, research, awards, leadership and service. A job resume usually gives more space to employment achievements and skills matched to a vacancy. A full academic CV can extend further to publications, conferences, teaching, grants and professional activity.",{"children":"The document name does not always tell you the required format. A scholarship CV often emphasises education, academic projects, research, awards, leadership and service. A job resume usually gives more space to employment achievements and skills matched to a vacancy. A full academic CV can extend further to publications, conferences, teaching, grants and professional activity."}],["$","p","Read the application instructions before choosing a template. If a scholarship supplies its own form or CV template, use it exactly. The Rhodes Scholarship, for example, can provide constituency-specific CV instructions, while a postgraduate course may accept a conventional academic CV. General advice should never override the current application requirement.",{"children":"Read the application instructions before choosing a template. If a scholarship supplies its own form or CV template, use it exactly. The Rhodes Scholarship, for example, can provide constituency-specific CV instructions, while a postgraduate course may accept a conventional academic CV. General advice should never override the current application requirement."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","2-How long should a scholarship CV be?",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"How long should a scholarship CV be?"}],[["$","p","There is no universal page limit. Some scholarship processes request one or two pages, a supplied template may set a fixed limit and a research-focused academic application may allow a longer document. Oxford's academic application guidance advises applicants to remain concise and relevant rather than assuming one standard length.",{"children":"There is no universal page limit. Some scholarship processes request one or two pages, a supplied template may set a fixed limit and a research-focused academic application may allow a longer document. Oxford's academic application guidance advises applicants to remain concise and relevant rather than assuming one standard length."}],["$","p","When no limit is stated, early-stage applicants can usually present the strongest evidence within one or two focused pages. Do not remove important research or publications merely to follow an invented rule, but do not add weak activities to make the CV look longer. Relevance and scanability matter more than page count.",{"children":"When no limit is stated, early-stage applicants can usually present the strongest evidence within one or two focused pages. Do not remove important research or publications merely to follow an invented rule, but do not add weak activities to make the CV look longer. Relevance and scanability matter more than page count."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","3-Choose the section order from the selection criteria",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Choose the section order from the selection criteria"}],[["$","p","The best order depends on what the award evaluates and where your strongest proof sits. Education and research may lead for an academic master's or PhD scholarship. Leadership and community impact may move higher for an award that explicitly selects on those qualities. A professional fellowship may place relevant work before older academic detail.",{"children":"The best order depends on what the award evaluates and where your strongest proof sits. Education and research may lead for an academic master's or PhD scholarship. Leadership and community impact may move higher for an award that explicitly selects on those qualities. A professional fellowship may place relevant work before older academic detail."}],["$","p","Use reverse chronological order within most sections unless a required template says otherwise. Keep headings conventional so a reviewer can find information quickly.",{"children":"Use reverse chronological order within most sections unless a required template says otherwise. Keep headings conventional so a reviewer can find information quickly."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Name and professional contact details",{"children":"Name and professional contact details"}],["$","li","Optional academic profile",{"children":"Optional academic profile"}],["$","li","Education and academic distinctions",{"children":"Education and academic distinctions"}],["$","li","Research, thesis and selected projects",{"children":"Research, thesis and selected projects"}],["$","li","Relevant employment and internships",{"children":"Relevant employment and internships"}],["$","li","Leadership, volunteering and service",{"children":"Leadership, volunteering and service"}],["$","li","Publications, presentations and awards where relevant",{"children":"Publications, presentations and awards where relevant"}],["$","li","Technical skills, languages and professional memberships",{"children":"Technical skills, languages and professional memberships"}]]}],"$undefined","$undefined"]}]
21:["$","section","4-Write a clean header and useful academic profile",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Write a clean header and useful academic profile"}],[["$","p","Start with your full name, a professional email address, phone number with country code and current country or city when useful. Add LinkedIn, ORCID, Google Scholar, a portfolio or another professional link only when it is accurate, current and worth the reviewer's time. A complete street address is rarely necessary unless requested.",{"children":"Start with your full name, a professional email address, phone number with country code and current country or city when useful. Add LinkedIn, ORCID, Google Scholar, a portfolio or another professional link only when it is accurate, current and worth the reviewer's time. A complete street address is rarely necessary unless requested."}],["$","p","An academic profile is optional. If used, keep it to two or three lines describing your current level, field, strongest relevant capability and intended direction. Avoid generic objectives such as seeking a challenging opportunity or claiming to be passionate and hardworking without evidence.",{"children":"An academic profile is optional. If used, keep it to two or three lines describing your current level, field, strongest relevant capability and intended direction. Avoid generic objectives such as seeking a challenging opportunity or claiming to be passionate and hardworking without evidence."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","5-Present education so an international reader can understand it",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Present education so an international reader can understand it"}],[["$","p","List the official degree title, institution, location and completion or expected completion date. Include the grade, CGPA or classification when relevant and accurate. Do not convert a score to another scale unless the programme instructs you to do so or an authorised evaluation provides the conversion.",{"children":"List the official degree title, institution, location and completion or expected completion date. Include the grade, CGPA or classification when relevant and accurate. Do not convert a score to another scale unless the programme instructs you to do so or an authorised evaluation provides the conversion."}],["$","p","Add a thesis, dissertation, selected modules or academic distinction only when it supports the application. If the local grading system may be unfamiliar, provide a brief accurate note based on the transcript or institution's official scale instead of describing your result as equivalent to a foreign grade on your own authority.",{"children":"Add a thesis, dissertation, selected modules or academic distinction only when it supports the application. If the local grading system may be unfamiliar, provide a brief accurate note based on the transcript or institution's official scale instead of describing your result as equivalent to a foreign grade on your own authority."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Official degree and institution name",{"children":"Official degree and institution name"}],["$","li","Dates and expected graduation where applicable",{"children":"Dates and expected graduation where applicable"}],["$","li","Original grade or CGPA scale",{"children":"Original grade or CGPA scale"}],["$","li","Thesis or final project title",{"children":"Thesis or final project title"}],["$","li","Selected honours or relevant coursework",{"children":"Selected honours or relevant coursework"}]]}],"$undefined","$undefined"]}]
23:["$","section","6-Turn research and academic projects into evidence",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Turn research and academic projects into evidence"}],[["$","p","Research experience should show more than a project title. State the question or objective, your contribution, the methods or tools used and the output or learning. Distinguish your individual work from the work of a team or supervisor.",{"children":"Research experience should show more than a project title. State the question or objective, your contribution, the methods or tools used and the output or learning. Distinguish your individual work from the work of a team or supervisor."}],["$","p","Coursework can be valuable when formal experience is limited. Select projects that demonstrate the skills the programme needs, such as analysis, fieldwork, laboratory technique, design, coding, writing or community research. Describe one strong project clearly rather than listing every assignment.",{"children":"Coursework can be valuable when formal experience is limited. Select projects that demonstrate the skills the programme needs, such as analysis, fieldwork, laboratory technique, design, coding, writing or community research. Describe one strong project clearly rather than listing every assignment."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Research question or project objective",{"children":"Research question or project objective"}],["$","li","Your individual contribution",{"children":"Your individual contribution"}],["$","li","Method, data, tools or population",{"children":"Method, data, tools or population"}],["$","li","Result, output or presentation",{"children":"Result, output or presentation"}],["$","li","Capability relevant to the proposed programme",{"children":"Capability relevant to the proposed programme"}]]}],"$undefined","$undefined"]}]
24:["$","section","7-Write achievement bullets instead of duty lists",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Write achievement bullets instead of duty lists"}],[["$","p","A useful bullet combines an action, context and result. Replace responsible for organising events with evidence such as coordinated a five-member team to deliver three career workshops for 180 students, collecting feedback that informed the next semester's programme. Use numbers only when they are true and meaningful.",{"children":"A useful bullet combines an action, context and result. Replace responsible for organising events with evidence such as coordinated a five-member team to deliver three career workshops for 180 students, collecting feedback that informed the next semester's programme. Use numbers only when they are true and meaningful."}],["$","p","Not every result needs a percentage. Research quality, a report adopted by a department, a process improved, a participant group reached or a difficult problem solved can all be specific outcomes. Begin with a strong verb, make your contribution clear and remove unnecessary introductory phrases.",{"children":"Not every result needs a percentage. Research quality, a report adopted by a department, a process improved, a participant group reached or a difficult problem solved can all be specific outcomes. Begin with a strong verb, make your contribution clear and remove unnecessary introductory phrases."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","8-Present work, internships, leadership and service selectively",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Present work, internships, leadership and service selectively"}],[["$","p","Employment is relevant when it demonstrates preparation, judgement or impact connected to the award. Include the organisation, role, dates and two to four focused bullets. Do not copy a job description. Translate the experience into evidence the scholarship committee can evaluate.",{"children":"Employment is relevant when it demonstrates preparation, judgement or impact connected to the award. Include the organisation, role, dates and two to four focused bullets. Do not copy a job description. Translate the experience into evidence the scholarship committee can evaluate."}],["$","p","Leadership is not limited to holding a president title. Mentoring, coordinating volunteers, improving a process, representing students or initiating a community response can show leadership when your decisions and results are clear. List membership without explanation only when it is genuinely significant.",{"children":"Leadership is not limited to holding a president title. Mentoring, coordinating volunteers, improving a process, representing students or initiating a community response can show leadership when your decisions and results are clear. List membership without explanation only when it is genuinely significant."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","9-List publications and presentations honestly",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"List publications and presentations honestly"}],[["$","p","Use one consistent citation style and label the status accurately. Published, accepted, in press, submitted and in preparation are not interchangeable. Do not place an unfinished idea under publications, and do not imply first authorship or sole responsibility when the work was collaborative.",{"children":"Use one consistent citation style and label the status accurately. Published, accepted, in press, submitted and in preparation are not interchangeable. Do not place an unfinished idea under publications, and do not imply first authorship or sole responsibility when the work was collaborative."}],["$","p","Separate peer-reviewed publications, conference presentations, posters, reports or public writing when the distinctions matter. For a short scholarship CV, select the most relevant items and provide a complete professional profile link only if the programme allows it.",{"children":"Separate peer-reviewed publications, conference presentations, posters, reports or public writing when the distinctions matter. For a short scholarship CV, select the most relevant items and provide a complete professional profile link only if the programme allows it."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
27:["$","section","10-Build a strong CV without formal work experience",{"className":"article-section","id":"section-11","children":[["$","h2",null,{"children":"Build a strong CV without formal work experience"}],[["$","p","Students are not expected to invent employment. Use relevant academic projects, thesis work, laboratory or field experience, tutoring, volunteering, student societies, competitions, independent learning and family or community responsibilities that demonstrate real skills.",{"children":"Students are not expected to invent employment. Use relevant academic projects, thesis work, laboratory or field experience, tutoring, volunteering, student societies, competitions, independent learning and family or community responsibilities that demonstrate real skills."}],["$","p","The standard remains evidence. Explain what you produced, improved, analysed, organised or learned. A well-described final-year project can be more persuasive than an unrelated part-time role included only to fill space.",{"children":"The standard remains evidence. Explain what you produced, improved, analysed, organised or learned. A well-described final-year project can be more persuasive than an unrelated part-time role included only to fill space."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Thesis and substantial coursework",{"children":"Thesis and substantial coursework"}],["$","li","Research assistance or laboratory work",{"children":"Research assistance or laboratory work"}],["$","li","Volunteering and community initiatives",{"children":"Volunteering and community initiatives"}],["$","li","Student leadership and event delivery",{"children":"Student leadership and event delivery"}],["$","li","Competitions, portfolios and verified certifications",{"children":"Competitions, portfolios and verified certifications"}],["$","li","Relevant independent or collaborative projects",{"children":"Relevant independent or collaborative projects"}]]}],"$undefined","$undefined"]}]
28:["$","section","11-A practical scholarship CV skeleton",{"className":"article-section","id":"section-12","children":[["$","h2",null,{"children":"A practical scholarship CV skeleton"}],[["$","p","Use this as a planning outline, not a fixed template. Remove sections that contain no useful evidence and reorder the remainder for the award's current criteria.",{"children":"Use this as a planning outline, not a fixed template. Remove sections that contain no useful evidence and reorder the remainder for the award's current criteria."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","FULL NAME — professional email | phone with country code | location | relevant profile link",{"children":"FULL NAME — professional email | phone with country code | location | relevant profile link"}],["$","li","ACADEMIC PROFILE — current discipline, strongest relevant evidence and future direction",{"children":"ACADEMIC PROFILE — current discipline, strongest relevant evidence and future direction"}],["$","li","EDUCATION — degree, institution, dates, original grade, thesis and selected distinction",{"children":"EDUCATION — degree, institution, dates, original grade, thesis and selected distinction"}],["$","li","RESEARCH OR PROJECTS — objective, contribution, methods and outcome",{"children":"RESEARCH OR PROJECTS — objective, contribution, methods and outcome"}],["$","li","EXPERIENCE — role, organisation, dates and evidence-based bullets",{"children":"EXPERIENCE — role, organisation, dates and evidence-based bullets"}],["$","li","LEADERSHIP AND SERVICE — action, people or problem involved and result",{"children":"LEADERSHIP AND SERVICE — action, people or problem involved and result"}],["$","li","PUBLICATIONS OR PRESENTATIONS — complete citation and honest status",{"children":"PUBLICATIONS OR PRESENTATIONS — complete citation and honest status"}],["$","li","AWARDS, SKILLS AND LANGUAGES — selected, specific and supportable information",{"children":"AWARDS, SKILLS AND LANGUAGES — selected, specific and supportable information"}]]}],"$undefined","$undefined"]}]
29:["$","section","12-An illustrative before-and-after CV entry",{"className":"article-section","id":"section-13","children":[["$","h2",null,{"children":"An illustrative before-and-after CV entry"}],[["$","p","Weak: Worked on a water-quality research project and helped with data analysis. Stronger: Analysed 240 water samples from six collection sites using the team's approved protocol, identified two recurring contamination patterns and prepared figures used in the department's final report.",{"children":"Weak: Worked on a water-quality research project and helped with data analysis. Stronger: Analysed 240 water samples from six collection sites using the team's approved protocol, identified two recurring contamination patterns and prepared figures used in the department's final report."}],["$","p","The stronger version gives scope, contribution and output without inventing impact. Build each bullet from your own records. Scholarship committees may verify claims through transcripts, supervisors, references or interviews.",{"children":"The stronger version gives scope, contribution and output without inventing impact. Build each bullet from your own records. Scholarship committees may verify claims through transcripts, supervisors, references or interviews."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2a:["$","section","13-Tailor the CV without rewriting your history",{"className":"article-section","id":"section-14","children":[["$","h2",null,{"children":"Tailor the CV without rewriting your history"}],[["$","p","Tailoring means selecting and ordering accurate evidence for the reader. Read the scholarship criteria and mark the experiences that prove academic readiness, leadership, service, research potential or professional impact. Move the most relevant evidence higher and use terminology that is natural for the field.",{"children":"Tailoring means selecting and ordering accurate evidence for the reader. Read the scholarship criteria and mark the experiences that prove academic readiness, leadership, service, research potential or professional impact. Move the most relevant evidence higher and use terminology that is natural for the field."}],["$","p","Maintain a master CV containing your complete verified history, then create a focused version for each application. Do not change dates, inflate titles or add keywords you cannot explain. The application form, CV, essays and references should agree.",{"children":"Maintain a master CV containing your complete verified history, then create a focused version for each application. Do not change dates, inflate titles or add keywords you cannot explain. The application form, CV, essays and references should agree."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2b:["$","section","14-Use Europass only when it serves the application",{"className":"article-section","id":"section-15","children":[["$","h2",null,{"children":"Use Europass only when it serves the application"}],[["$","p","Europass is an official European tool that can create CVs for employment, education, training and volunteering. It is useful when a programme requests or accepts that format, or when you need a consistent starting structure. It is not automatically the best format for every scholarship.",{"children":"Europass is an official European tool that can create CVs for employment, education, training and volunteering. It is useful when a programme requests or accepts that format, or when you need a consistent starting structure. It is not automatically the best format for every scholarship."}],["$","p","If no template is required, compare the Europass output with the selection criteria and available space. A simpler custom document may present academic projects or research more efficiently. Whichever format you choose, tailor the content rather than submitting a complete profile containing every activity.",{"children":"If no template is required, compare the Europass output with the selection criteria and available space. A simpler custom document may present academic projects or research more efficiently. Whichever format you choose, tailor the content rather than submitting a complete profile containing every activity."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2c:["$","section","15-Keep the design quiet and readable",{"className":"article-section","id":"section-16","children":[["$","h2",null,{"children":"Keep the design quiet and readable"}],[["$","p","Use a readable typeface, consistent dates, clear headings, adequate white space and restrained emphasis. Avoid rating bars, excessive colours, icons that replace important labels and multi-column layouts that make the reading order unclear. A scholarship CV should look organised rather than decorative.",{"children":"Use a readable typeface, consistent dates, clear headings, adequate white space and restrained emphasis. Avoid rating bars, excessive colours, icons that replace important labels and multi-column layouts that make the reading order unclear. A scholarship CV should look organised rather than decorative."}],["$","p","Submit PDF unless the portal requests another format. Open the final file on a phone and computer, confirm that links work, check that no line has been cut off and use a professional file name such as Firstname-Lastname-Scholarship-CV.pdf. Do not include a photograph, age, identity number, marital status or other sensitive information unless the current instructions genuinely require it.",{"children":"Submit PDF unless the portal requests another format. Open the final file on a phone and computer, confirm that links work, check that no line has been cut off and use a professional file name such as Firstname-Lastname-Scholarship-CV.pdf. Do not include a photograph, age, identity number, marital status or other sensitive information unless the current instructions genuinely require it."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2d:["$","section","16-Additional CV checks for Pakistani applicants",{"className":"article-section","id":"section-17","children":[["$","h2",null,{"children":"Additional CV checks for Pakistani applicants"}],[["$","p","Use the exact English degree and institution names shown on official records where available. Keep Pakistani grades on their original scale unless the programme requests a conversion, and explain expected graduation, result awaiting or degree completion accurately.",{"children":"Use the exact English degree and institution names shown on official records where available. Keep Pakistani grades on their original scale unless the programme requests a conversion, and explain expected graduation, result awaiting or degree completion accurately."}],["$","p","Local society work, volunteering, teaching, internships and community responsibilities can be strong evidence when described with context and results. Avoid unexplained abbreviations that an international reviewer may not recognise. If a certification, award or organisation is important, give enough information to show what it represents without turning the CV into an essay.",{"children":"Local society work, volunteering, teaching, internships and community responsibilities can be strong evidence when described with context and results. Avoid unexplained abbreviations that an international reviewer may not recognise. If a certification, award or organisation is important, give enough information to show what it represents without turning the CV into an essay."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2e:["$","section","17-Common scholarship CV mistakes",{"className":"article-section","id":"section-18","children":[["$","h2",null,{"children":"Common scholarship CV mistakes"}],[["$","p","Most weak CVs are difficult to evaluate rather than visually unattractive. The reviewer cannot quickly identify relevance, contribution or progression. Remove anything that creates uncertainty without adding useful evidence.",{"children":"Most weak CVs are difficult to evaluate rather than visually unattractive. The reviewer cannot quickly identify relevance, contribution or progression. Remove anything that creates uncertainty without adding useful evidence."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Using one generic job resume for every scholarship",{"children":"Using one generic job resume for every scholarship"}],["$","li","Writing an unsupported objective or long personal biography",{"children":"Writing an unsupported objective or long personal biography"}],["$","li","Listing duties, memberships and skills without evidence",{"children":"Listing duties, memberships and skills without evidence"}],["$","li","Converting grades or exaggerating publication status",{"children":"Converting grades or exaggerating publication status"}],["$","li","Including every activity regardless of relevance",{"children":"Including every activity regardless of relevance"}],["$","li","Using inconsistent dates, titles or formatting",{"children":"Using inconsistent dates, titles or formatting"}],["$","li","Adding decorative skill bars, graphics or excessive colours",{"children":"Adding decorative skill bars, graphics or excessive colours"}],["$","li","Ignoring a required template or page limit",{"children":"Ignoring a required template or page limit"}],["$","li","Submitting a file that is unreadable or incorrectly named",{"children":"Submitting a file that is unreadable or incorrectly named"}]]}],"$undefined","$undefined"]}]
2f:["$","section","18-Final scholarship CV checklist",{"className":"article-section","id":"section-19","children":[["$","h2",null,{"children":"Final scholarship CV checklist"}],[["$","p","Review the CV against the actual selection criteria, then ask whether a reader can locate your strongest evidence within a short scan. Complete a factual review before correcting language and layout.",{"children":"Review the CV against the actual selection criteria, then ask whether a reader can locate your strongest evidence within a short scan. Complete a factual review before correcting language and layout."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","The required template, length and file type are followed",{"children":"The required template, length and file type are followed"}],["$","li","Contact details and professional links are current",{"children":"Contact details and professional links are current"}],["$","li","The strongest relevant section appears early",{"children":"The strongest relevant section appears early"}],["$","li","Degrees, grades, dates and role titles are accurate",{"children":"Degrees, grades, dates and role titles are accurate"}],["$","li","Bullets show contribution and outcome",{"children":"Bullets show contribution and outcome"}],["$","li","Publication and project status is honest",{"children":"Publication and project status is honest"}],["$","li","Unfamiliar abbreviations and grading information are clear",{"children":"Unfamiliar abbreviations and grading information are clear"}],["$","li","The CV matches the form, essays and references",{"children":"The CV matches the form, essays and references"}],["$","li","Spelling, alignment, page breaks and file name are correct",{"children":"Spelling, alignment, page breaks and file name are correct"}]]}],"$undefined","$undefined"]}]
30:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","How long should a CV for a scholarship application be?",{"children":[["$","summary",null,{"children":["How long should a CV for a scholarship application be?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Follow the scholarship's stated limit or template. When no rule is given, many early-stage applicants can present their strongest evidence in one or two pages, while a research-focused academic CV may need more space. Keep every section concise and relevant."}]]}],["$","details","What is the difference between a scholarship CV and a job resume?",{"children":[["$","summary",null,{"children":["What is the difference between a scholarship CV and a job resume?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"A scholarship CV usually places greater emphasis on education, research, projects, academic achievements, leadership and service. A job resume normally prioritises experience and skills matched to an employer. The scholarship's selection criteria should decide the final emphasis."}]]}],["$","details","Can I make a scholarship CV without work experience?",{"children":[["$","summary",null,{"children":["Can I make a scholarship CV without work experience?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Use substantial coursework, thesis research, academic projects, volunteering, student leadership, tutoring, competitions and relevant independent work. Describe your contribution, method and result rather than inventing employment or filling space with unsupported skills."}]]}],["$","details","Should I use a Europass CV for scholarships?",{"children":[["$","summary",null,{"children":["Should I use a Europass CV for scholarships?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Use Europass when the programme requests it or when its structure suits the application. It is not universally required. If no format is specified, choose the clearest document for presenting evidence and tailor it to the scholarship criteria."}]]}],["$","details","Should a scholarship CV include a photo?",{"children":[["$","summary",null,{"children":["Should a scholarship CV include a photo?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Do not add a photo automatically. Include one only when the current application instructions or accepted local format clearly require it. Avoid unnecessary personal details that do not help the committee assess your eligibility or merit."}]]}],["$","details","Should I include references on my scholarship CV?",{"children":[["$","summary",null,{"children":["Should I include references on my scholarship CV?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Include referee details only if the programme requests them on the CV. Most applications collect references in a separate section or portal. Do not use valuable space for references available on request unless instructed."}]]}]]}]]}]
31:["$","aside",null,{"className":"content-sidebar","children":[["$","div",null,{"className":"sidebar-card sidebar-card--contents","children":[["$","span",null,{"children":"On this page"}],["$","nav",null,{"aria-label":"Page contents","children":[["$","a","Arrange a CV around the selection criteria",{"href":"#section-1","children":[["$","b",null,{"children":"01"}],"Arrange a CV around the selection criteria"]}],["$","a","Scholarship CV, academic CV and job resume",{"href":"#section-2","children":[["$","b",null,{"children":"02"}],"Scholarship CV, academic CV and job resume"]}],["$","a","How long should a scholarship CV be?",{"href":"#section-3","children":[["$","b",null,{"children":"03"}],"How long should a scholarship CV be?"]}],["$","a","Choose the section order from the selection criteria",{"href":"#section-4","children":[["$","b",null,{"children":"04"}],"Choose the section order from the selection criteria"]}],["$","a","Write a clean header and useful academic profile",{"href":"#section-5","children":[["$","b",null,{"children":"05"}],"Write a clean header and useful academic profile"]}],["$","a","Present education so an international reader can understand it",{"href":"#section-6","children":[["$","b",null,{"children":"06"}],"Present education so an international reader can understand it"]}],["$","a","Turn research and academic projects into evidence",{"href":"#section-7","children":[["$","b",null,{"children":"07"}],"Turn research and academic projects into evidence"]}],["$","a","Write achievement bullets instead of duty lists",{"href":"#section-8","children":[["$","b",null,{"children":"08"}],"Write achievement bullets instead of duty lists"]}],["$","a","Present work, internships, leadership and service selectively",{"href":"#section-9","children":[["$","b",null,{"children":"09"}],"Present work, internships, leadership and service selectively"]}],["$","a","List publications and presentations honestly",{"href":"#section-10","children":[["$","b",null,{"children":"10"}],"List publications and presentations honestly"]}],["$","a","Build a strong CV without formal work experience",{"href":"#section-11","children":[["$","b",null,{"children":"11"}],"Build a strong CV without formal work experience"]}],["$","a","A practical scholarship CV skeleton",{"href":"#section-12","children":[["$","b",null,{"children":"12"}],"A practical scholarship CV skeleton"]}],["$","a","An illustrative before-and-after CV entry",{"href":"#section-13","children":[["$","b",null,{"children":"13"}],"An illustrative before-and-after CV entry"]}],["$","a","Tailor the CV without rewriting your history",{"href":"#section-14","children":[["$","b",null,{"children":"14"}],"Tailor the CV without rewriting your history"]}],["$","a","Use Europass only when it serves the application",{"href":"#section-15","children":[["$","b",null,{"children":"15"}],"Use Europass only when it serves the application"]}],["$","a","Keep the design quiet and readable",{"href":"#section-16","children":[["$","b",null,{"children":"16"}],"Keep the design quiet and readable"]}],["$","a","Additional CV checks for Pakistani applicants",{"href":"#section-17","children":[["$","b",null,{"children":"17"}],"Additional CV checks for Pakistani applicants"]}],["$","a","Common scholarship CV mistakes",{"href":"#section-18","children":[["$","b",null,{"children":"18"}],"Common scholarship CV mistakes"]}],["$","a","Final scholarship CV checklist",{"href":"#section-19","children":[["$","b",null,{"children":"19"}],"Final scholarship CV checklist"]}]]}]]}],["$","div",null,{"className":"sidebar-card","children":[["$","h2",null,{"children":"Next useful step"}],[["$","$L4","guides/scholarship-application",{"href":"/guides/scholarship-application/","children":["How to apply for international scholarships step by step"," ",["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/statement-of-purpose",{"href":"/guides/statement-of-purpose/","children":["How to write a statement of purpose for scholarships and graduate study"," ",["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]]}]]}]
