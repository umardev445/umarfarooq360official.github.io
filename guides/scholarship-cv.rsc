15:T92c,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long should a CV for a scholarship application be?","acceptedAnswer":{"@type":"Answer","text":"Follow the scholarship's stated limit or template. When no rule is given, many early-stage applicants can present their strongest evidence in one or two pages, while a research-focused academic CV may need more space. Keep every section concise and relevant."}},{"@type":"Question","name":"What is the difference between a scholarship CV and a job resume?","acceptedAnswer":{"@type":"Answer","text":"A scholarship CV usually places greater emphasis on education, research, projects, academic achievements, leadership and service. A job resume normally prioritises experience and skills matched to an employer. The scholarship's selection criteria should decide the final emphasis."}},{"@type":"Question","name":"Can I make a scholarship CV without work experience?","acceptedAnswer":{"@type":"Answer","text":"Yes. Use substantial coursework, thesis research, academic projects, volunteering, student leadership, tutoring, competitions and relevant independent work. Describe your contribution, method and result rather than inventing employment or filling space with unsupported skills."}},{"@type":"Question","name":"Should I use a Europass CV for scholarships?","acceptedAnswer":{"@type":"Answer","text":"Use Europass when the programme requests it or when its structure suits the application. It is not universally required. If no format is specified, choose the clearest document for presenting evidence and tailor it to the scholarship criteria."}},{"@type":"Question","name":"Should a scholarship CV include a photo?","acceptedAnswer":{"@type":"Answer","text":"Do not add a photo automatically. Include one only when the current application instructions or accepted local format clearly require it. Avoid unnecessary personal details that do not help the committee assess your eligibility or merit."}},{"@type":"Question","name":"Should I include references on my scholarship CV?","acceptedAnswer":{"@type":"Answer","text":"Include referee details only if the programme requests them on the CV. Most applications collect references in a separate section or portal. Do not use valuable space for references available on request unless instructed."}}]}1:["$","main",null,{"id":"main-content","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/scholarship-cv/\",\"name\":\"How to write a scholarship CV for international applications\",\"description\":\"Build a scholarship CV for 2027 with the right sections, evidence-based bullets, academic examples, formatting guidance and a final application checklist.\",\"url\":\"https://aspirecompass.org/guides/scholarship-cv/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-08-31\",\"dateModified\":\"2026-10-13\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/application-writing-1280.webp\",\"caption\":\"A student reviewing notes and preparing an application at a desk\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"How to write a scholarship CV for international applications\",\"item\":\"https://aspirecompass.org/guides/scholarship-cv/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"How to write a scholarship CV for international applications\",\"description\":\"Build a scholarship CV for 2027 with the right sections, evidence-based bullets, academic examples, formatting guidance and a final application checklist.\",\"image\":\"https://aspirecompass.org/images/application-writing-1280.webp\",\"datePublished\":\"2026-08-31\",\"dateModified\":\"2026-10-13\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/scholarship-cv/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$15"}}]],"$L16","$L17","$L18"]}]
