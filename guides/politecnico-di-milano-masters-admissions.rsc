1d:["$","div",null,{"className":"article-body","children":[["$","section","First check academic fit and applicant category",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"First check academic fit and applicant category"}],[["$","p","Start with the exact MSc, campus and teaching language. Read country-specific qualification and minimum-CGPA instructions before choosing a course. A planning GPA conversion does not replace the university's assessment of your original transcript.",{"children":"Start with the exact MSc, campus and teaching language. Read country-specific qualification and minimum-CGPA instructions before choosing a course. A planning GPA conversion does not replace the university's assessment of your original transcript."}],["$","p","Make a short evidence map: programme requirement, your relevant subjects, course descriptions and any missing prerequisite. This is more useful than submitting the same generic motivation letter to unrelated degrees. Applicants to design-related courses should also check the portfolio requirement.",{"children":"Make a short evidence map: programme requirement, your relevant subjects, course descriptions and any missing prerequisite. This is more useful than submitting the same generic motivation letter to unrelated degrees. Applicants to design-related courses should also check the portfolio requirement."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","Admission windows: do not mix study areas",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Admission windows: do not mix study areas"}],[["$","p","The official deadlines page currently labels one Engineering heading with a different academic year while its rows refer to September 2027. Read the dated row and confirm any ambiguity with admissions.",{"children":"The official deadlines page currently labels one Engineering heading with a different academic year while its rows refer to September 2027. Read the dated row and confirm any ambiguity with admissions."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"September 2027 intake: published general windows, rechecked 13 October 2026","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"September 2027 intake: published general windows, rechecked 13 October 2026"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Area",{"scope":"col","children":"Area"}],["$","th","Window",{"scope":"col","children":"Window"}],["$","th","Important check",{"scope":"col","children":"Important check"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Engineering: first call"}],["$","td","1",{"children":"1 Oct–1 Dec 2026; 23:59 CET"}],["$","td","2",{"children":"Confirm programme/heading discrepancy with admissions"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Engineering: second call"}],["$","td","1",{"children":"12 Jan–25 Feb 2027; 23:59 CET"}],["$","td","2",{"children":"Not the early-bird scholarship route"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Architecture/Design"}],["$","td","1",{"children":"1 Oct 2026–28 Jan 2027; 23:59 CET"}],["$","td","2",{"children":"Early-bird payment cut-off is separate"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Additional March round"}],["$","td","1",{"children":"1–18 Mar 2027"}],["$","td","2",{"children":"Restricted to stated EEA/equivalent residence categories"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"h