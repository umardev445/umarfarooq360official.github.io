25:["$","section","5-Tuition and arrival costs",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Tuition and arrival costs"}],[["$","p","Polimi's published 2026–2027 standard-load system runs up to €3,943.04, with ECTS and category conditions. Reserved non-EU master's students with a foreign qualification and without qualifying funding can be charged the maximum. This is a historical budget reference, not a confirmed 2027–2028 invoice.",{"children":"Polimi's published 2026–2027 standard-load system runs up to €3,943.04, with ECTS and category conditions. Reserved non-EU master's students with a foreign qualification and without qualifying funding can be charged the maximum. This is a historical budget reference, not a confirmed 2027–2028 invoice."}],["$","p","Choose the campus before estimating rent. Record tuition without an award, tuition if funded and cash needed before disbursement as three separate figures. Check official accommodation information, then compare actual room offers and commuting costs.",{"children":"Choose the campus before estimating rent. Record tuition without an award, tuition if funded and cash needed before disbursement as three separate figures. Check official accommodation information, then compare actual room offers and commuting costs."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Tuition and arrival costs","children":[["$","$L5","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Build your first-year budget",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
26:["$","section","6-Before submission and after admission",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Before submission and after admission"}],[["$","p","Apply only when the document audit is complete. Save proof of admission and funding submissions separately. After a positive decision, follow qualification checks and Universitaly instructions for your situation; do not assume an academic offer resolves the visa.",{"children":"Apply only when the document audit is complete. Save proof of admission and funding submissions separately. After a positive decision, follow qualification checks and Universitaly instructions for your situation; do not assume an academic offer resolves the visa."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Exact MSc and campus selected.",{"children":"Exact MSc and campus selected."}],["$","li","Qualification and CGPA eligibility checked.",{"children":"Qualification and CGPA eligibility checked."}],["$","li","Documents reviewed before payment.",{"children":"Documents reviewed before payment."}],["$","li","Admission and scholarship receipts saved.",{"children":"Admission and scholarship receipts saved."}],["$","li","English deadline recorded.",{"children":"English deadline recorded."}],["$","li","Unfunded budget and after-admission conditions understood.",{"children":"Unfunded budget and after-admission conditions understood."}]]}],"$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Before submission and after admission","children":[["$","$L5","/guides/universitaly-pre-enrolment/",{"href":"/guides/universitaly-pre-enrolment/","children":["Universitaly next steps",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/italy-dsu-scholarships/",{"href":"/guides/italy-dsu-scholarships