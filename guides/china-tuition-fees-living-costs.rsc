1b:["$","section","1-The spending categories to collect",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"The spending categories to collect"}],[["$","p","Ask whether accommodation is included, subsidised or charged separately. Record room type and the period covered. An academic-year residence quote may not cover a vacation period or a full twelve months.",{"children":"Ask whether accommodation is included, subsidised or charged separately. Record room type and the period covered. An academic-year residence quote may not cover a vacation period or a full twelve months."}],["$","p","Add insurance, any application charge, document preparation, visa or residence tasks, travel and arrival purchases when they apply. This is a budgeting checklist, not a claim that every authority charges the same fees.",{"children":"Add insurance, any application charge, document preparation, visa or residence tasks, travel and arrival purchases when they apply. This is a budgeting checklist, not a claim that every authority charges the same fees."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A China study-cost worksheet","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A China study-cost worksheet"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Cost",{"scope":"col","children":"Cost"}],["$","th","Basis to record",{"scope":"col","children":"Basis to record"}],["$","th","Common comparison mistake",{"scope":"col","children":"Common comparison mistake"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Tuition"}],["$","td","1",{"children":"Exact programme and charging period"}],["$","td","2",{"children":"Using another degree’s scholarship benefit as a fee"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Accommodation"}],["$","td","1",{"children":"Room type, deposit and months covered"}],["$","td","2",{"children":"Treating an academic-year quote as twelve months"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Food and daily living"}],["$","td","1",{"children":"Your monthly estimate and number of months"}],["$","td","2",{"children":"Subtracting meals that are not actually included"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Insurance and administration"}],["$","td","1",{"children":"Current required charges"}],["$","td","2",{"children":"Assuming tuition covers everything"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Travel and arrival"}],["$","td","1",{"children":"Flights, temporary stay and setup"}],["$","td","2",{"children":"Ignoring cash needed before the first stipend"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1c:["$","section","2-A worked first-year example",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"A worked first-year example"}],[["$","p","These figures are illustrative assumptions chosen to show the calculation, not an estimate of national prices. Replace every line with information from your university and your own spending plan.",{"children":"These figures are illustrative assumptions chosen to show the calculation, not an estimate of national prices. Replace every line with information from your university and your own spending plan."}],["$","p","If the housing quote covers ten months, add the accommodation needed for the remaining stay before using this example. Keep the deposit separate if refundable, while still including it in the cash needed initially.",{"children":"If the housing quote covers ten months, add the accommodation needed for the remaining stay before using this example. Keep the deposit separate if refundable, while still including it in the cash needed initially."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"Example: tuition CNY 24,000 + housing CNY 9,600 + monthly living CNY 2,000 × 12 + insurance/administration CNY 1,200 + arrival/travel CNY 5,000 = CNY 63,800. If an award confirms tuition and housing only, the remaining plan is CNY 30,200 before any other confirmed support. Do not subtract a requested stipend as if it were awarded."}]]}],"$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","3-Scholarship coverage and payment timing",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Scholarship coverage and payment timing"}],[["$","p","Read the actual award category, not just the phrase “fully funded”. Check tuition, accommodation, stipend, insurance, travel and continuation conditions individually. An institutional fellowship and a government scholarship can have different rules.",{"children":"Read the actual award category, not just the phrase “fully funded”. Check tuition, accommodation, stipend, insurance, travel and continuation conditions individually. An institutional fellowship and a government scholarship can have different rules."}],["$","p","The first payment date matters. An annual award may reduce your ultimate funding gap while leaving a cash shortage during travel and registration. Calculate both the total year and the period before the first confirmed payment.",{"children":"The first payment date matters. An annual award may reduce your ultimate funding gap while leaving a cash shortage during travel and registration. Calculate both the total year and the period before the first confirmed payment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Scholarship coverage and payment timing","children":[["$","$L4","/guides/csc-scholarship-application/",{"href":"/guides/csc-scholarship-application/","children":["CSC scholarship application route",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/ustc-scholarships-admissions/",{"href":"/guides/ustc-scholarships-admissions/","children":["USTC funding categories",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/cas-anso/",{"href":"/scholarships/cas-anso/","children":["CAS-ANSO coverage checks",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1e:["$","section","4-Compare universities with a consistent worksheet",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Compare universities with a consistent worksheet"}],[["$","p","Use one currency for the first comparison and record any exchange-rate assumption separately. Give every quote a source, date and period. Do not round away a large difference caused by a ten-month versus twelve-month housing calculation.",{"children":"Use one currency for the first comparison and record any exchange-rate assumption separately. Give every quote a source, date and period. Do not round away a large difference caused by a ten-month versus twelve-month housing calculation."}],["$","p","Use a second scenario for higher rent or delayed funding. If you need to reduce cost, identify a real change such as confirmed residence housing or a documented fee waiver. Do not assume employment will be available or permitted to cover an unplanned gap.",{"children":"Use a second scenario for higher rent or delayed funding. If you need to reduce cost, identify a real change such as confirmed residence housing or a documented fee waiver. Do not assume employment will be available or permitted to cover an unplanned gap."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L23",null,{"id":"guides/china-tuition-fees-living-costs:section-5","title":"Check your progress","items":["Same degree profile used across options","Fees matched to the correct intake","Housing period and deposit confirmed","Award coverage checked line by line","Arrival cash separated from annual spending","Currency conversion assumptions labelled"]}],"$undefined","$undefined"]}]
1f:["$","section","5-Costs you should confirm after receiving an offer",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Costs you should confirm after receiving an offer"}],[["$","p","Ask the university about payment methods, deadlines and official account details. Verify a payment request through the published institutional contact before sending money, especially if it arrives from a personal address.",{"children":"Ask the university about payment methods, deadlines and official account details. Verify a payment request through the published institutional contact before sending money, especially if it arrives from a personal address."}],["$","p","If your course or funding arrangement changes, rebuild the budget. A deferred intake, different campus or alternative award can alter both charges and payment timing. Retain the earlier calculation so you can see exactly what changed.",{"children":"If your course or funding arrangement changes, rebuild the budget. A deferred intake, different campus or alternative award can alter both charges and payment timing. Retain the earlier calculation so you can see exactly what changed."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
