19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/expansion-20261022/china-cost-1280.webp","srcSet":"/images/expansion-20261022/china-cost-640.webp 640w, /images/expansion-20261022/china-cost-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"City architecture and trees in Nanjing","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Destination or study photograph; not a photograph of the named university or scholarship."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Your China study budget is tuition plus living and one-off expenses, minus confirmed usable funding. Costs vary by university, degree, teaching language, city and accommodation; there is no single fee that fits every international student."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Collect your programme’s fee schedule, housing quote and award terms, then separate recurring costs from money needed before arrival."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Compare the same programme profile",{"href":"#section-1","children":"Compare the same programme profile"}],["$","a","The spending categories to collect",{"href":"#section-2","children":"The spending categories to collect"}],["$","a","A worked first-year example",{"href":"#section-3","children":"A worked first-year example"}],["$","a","Scholarship coverage and payment timing",{"href":"#section-4","children":"Scholarship coverage and payment timing"}],["$","a","Compare universities with a consistent worksheet",{"href":"#section-5","children":"Compare universities with a consistent worksheet"}],["$","a","Costs you should confirm after receiving an offer",{"href":"#section-6","children":"Costs you should confirm after receiving an offer"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Compare the same programme profile",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Compare the same programme profile"}],[["$","p","Write down the university, campus, degree, programme duration and teaching language. A language course, engineering master’s and clinical degree cannot be compared using one tuition figure. Check whether the programme charges annually, per semester or for the entire course.",{"children":"Write down the university, campus, degree, programme duration and teaching language. A language course, engineering master’s and clinical degree cannot be compared using one tuition figure. Check whether the programme charges annually, per semester or for the entire course."}],["$","p","Save the actual fee schedule and its academic year. A scholarship overview may show support rather than the underlying fee, while an admission offer can include additional charges. Use the specific programme record as your starting evidence.",{"children":"Save the actual fee schedule and its academic year. A scholarship overview may show support rather than the underlying fee, while an admission offer can include additional charges. Use the specific programme record as your starting evidence."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1b","$L1c","$L1d","$L1e","$L1f"]}],false,"$L20","$L21"]}],"$L22"]}]
