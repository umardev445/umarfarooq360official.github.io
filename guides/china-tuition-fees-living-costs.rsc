1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide china-page research-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/china-tuition-fees-living-costs/\",\"name\":\"Study costs in China: tuition, accommodation and living budget\",\"description\":\"Compare tuition and living costs in China, budget by city and study level, and check what scholarships cover before planning your first year.\",\"url\":\"https://aspirecompass.org/guides/china-tuition-fees-living-costs/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-22\",\"dateModified\":\"2026-10-22\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/expansion-20261022/china-cost-1280.webp\",\"caption\":\"City architecture and trees in Nanjing\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Study costs in China: tuition, accommodation and living budget\",\"item\":\"https://aspirecompass.org/guides/china-tuition-fees-living-costs/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"Study costs in China: tuition, accommodation and living budget\",\"description\":\"Compare tuition and living costs in China, budget by city and study level, and check what scholarships cover before planning your first year.\",\"image\":\"https://aspirecompass.org/images/expansion-20261022/china-cost-1280.webp\",\"datePublished\":\"2026-10-22\",\"dateModified\":\"2026-10-22\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/china-tuition-fees-living-costs/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Are the example amounts official China averages?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. They are illustrative inputs for a transparent calculation. Use the fee schedule and housing quote for your actual programme.\"}},{\"@type\":\"Question\",\"name\":\"Does fully funded always include flights and free housing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Do not assume so. Confirm each component in the current scheme and your award letter.\"}},{\"@type\":\"Question\",\"name\":\"Should I budget twelve months of housing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Use your real stay and accommodation contract. If a university quote covers fewer months, account for the remaining period separately.\"}}]}"}}]],["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--guide inner-hero--visual","children":"$L18"}],false,"$L19","$L1a"]}]
