17:["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L4",null,{"href":"/","children":"Home"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/",{"children":[["$","$L4",null,{"href":"/guides/","children":"Guides"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/find-phd-supervisor/",{"children":[["$","span",null,{"aria-current":"page","children":"Find a PhD supervisor: shortlist, email and follow up"}],false]}]]}],["$","span",null,{"data-slot":"badge","data-variant":"outline","className":"inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3 border-border text-foreground [a&]:hover:bg-accent [a&]:hover:text-accent-foreground inner-eyebrow","children":"Applications & opportunity planning"}],false,["$","h1",null,{"children":"Find a PhD supervisor: shortlist, email and follow up"}],["$","p",null,{"children":"The right supervisor search starts with a research direction and the programme’s contact policy. A tailored shortlist is more useful than sending the same email to hundreds of academics."}],["$","div",null,{"className":"inner-hero__meta","children":[["$","span",null,{"children":[["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z","key":"oel41y"}],["path",{"d":"m9 12 2 2 4-4","key":"dzmm74"}]],"className":"lucide-shield-check","aria-hidden":"true"}]," Updated ","24 Oct 2026"]}],["$","a",null,{"href":"#official-sources","children":"Official source record ↓"}]]}]]}],["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/opportunities-20261024/supervisor-1280.webp","srcSet":"/images/opportunities-20261024/supervisor-640.webp 640w, /images/opportunities-20261024/supervisor-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Illustrative conversation between a prospective researcher and an academic","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Illustrative scene; not a photograph of a named institution or programme participants."}]]}]]}]
18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Find a supervisor through research fit and the programme’s official contact policy. Use a focused, personalised enquiry; supervision interest, admission and funding are separate decisions."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Check the programme route and build a shortlist with a specific research connection for each academic."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Check whether supervisor contact is part of the route",{"href":"#section-1","children":"Check whether supervisor contact is part of the route"}],["$","a","Turn a broad interest into a research direction",{"href":"#section-2","children":"Turn a broad interest into a research direction"}],["$","a","Make a shortlist with evidence",{"href":"#section-3","children":"Make a shortlist with evidence"}],["$","a","Write a short first email that is easy to answer",{"href":"#section-4","children":"Write a short first email that is easy to answer"}],["$","a","An advertised project needs a different question",{"href":"#section-5","children":"An advertised project needs a different question"}],["$","a","Follow up with judgement, not a mass-mailing schedule",{"href":"#section-6","children":"Follow up with judgement, not a mass-mailing schedule"}],["$","a","Use the meeting to test fit in both directions",{"href":"#section-7","children":"Use the meeting to test fit in both directions"}],["$","a","Keep the research story consistent across documents",{"href":"#section-8","children":"Keep the research story consistent across documents"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Check whether supervisor contact is part of the route",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Check whether supervisor contact is part of the route"}],[["$","p","An advertised funded project may already identify a supervisor and a formal application process. A self-proposed project may require you to identify a suitable academic first. Some programmes discourage speculative contact or make allocations after admission. Read the programme instructions before emailing.",{"children":"An advertised funded project may already identify a supervisor and a formal application process. A self-proposed project may require you to identify a suitable academic first. Some programmes discourage speculative contact or make allocations after admission. Read the programme instructions before emailing."}],["$","p","Your first decision is therefore procedural: is contact required, encouraged, optional or inappropriate? Do not use a generic email template to bypass the published route. A staff member cannot usually replace the central application or waive its mandatory requirements.",{"children":"Your first decision is therefore procedural: is contact required, encouraged, optional or inappropriate? Do not use a generic email template to bypass the published route. A staff member cannot usually replace the central application or waive its mandatory requirements."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}],false,"$L21","$L22"]}],"$L23"]}]
19:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","scholarships/phd",{"href":"/scholarships/phd/","children":[["$","span",null,{"children":"Doctoral funding"}],["$","h3",null,{"children":"PhD scholarships and funded doctoral opportunities"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","scholarships/kaust",{"href":"/scholarships/kaust/","children":[["$","span",null,{"children":"Official-source graduate guide"}],["$","h3",null,{"children":"KAUST Graduate Admission and Fellowship 2027 guide"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/recommendation-letter",{"href":"/guides/recommendation-letter/","children":[["$","span",null,{"children":"Reference guide"}],["$","h3",null,{"children":"How to get strong scholarship recommendation letters"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/fellowship-vs-scholarship",{"href":"/guides/fellowship-vs-scholarship/","children":[["$","span",null,{"children":"Applications & opportunity planning"}],["$","h3",null,{"children":"Fellowship vs scholarship: choose by purpose and terms"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
1a:["$","section","1-Turn a broad interest into a research direction",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Turn a broad interest into a research direction"}],[["$","p","Write a working paragraph containing the problem, the setting or population, the method you hope to develop and why you are prepared to start. It can change during discussion; its purpose is to make your search specific enough to find relevant people.",{"children":"Write a working paragraph containing the problem, the setting or population, the method you hope to develop and why you are prepared to start. It can change during discussion; its purpose is to make your search specific enough to find relevant people."}],["$","p","For example, “I want to work on sustainable energy” is too broad for a shortlist. “I want to investigate reliable low-cost sensing for small energy systems, building on an undergraduate instrumentation project” gives you methods and expertise to search. Do not imply expertise in a method you have only read about.",{"children":"For example, “I want to work on sustainable energy” is too broad for a shortlist. “I want to investigate reliable low-cost sensing for small energy systems, building on an undergraduate instrumentation project” gives you methods and expertise to search. Do not imply expertise in a method you have only read about."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1b:["$","section","2-Make a shortlist with evidence",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Make a shortlist with evidence"}],[["$","p","Search department research groups, staff profiles, project advertisements and recent publications. Check whether the academic is active in your area and whether the programme can host your intended work. An old publication is a lead, not proof of current supervision availability.",{"children":"Search department research groups, staff profiles, project advertisements and recent publications. Check whether the academic is active in your area and whether the programme can host your intended work. An old publication is a lead, not proof of current supervision availability."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Copy this shortlist structure into your tracker","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Copy this shortlist structure into your tracker"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Column",{"scope":"col","children":"Column"}],["$","th","What to record",{"scope":"col","children":"What to record"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Research overlap"}],["$","td","1",{"children":"One specific topic or method shared with your proposed work"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Evidence"}],["$","td","1",{"children":"A staff profile, project or publication you have actually read"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Programme route"}],["$","td","1",{"children":"Advertised project, self-proposal or central allocation"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Availability"}],["$","td","1",{"children":"Confirmed / unknown; source and date"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Funding"}],["$","td","1",{"children":"Named funded position, separate award or unresolved"}]],"$undefined"]}],["$","tr","5",{"children":[[["$","th","0",{"scope":"row","children":"Next action"}],["$","td","1",{"children":"Apply, ask one focused question or remove from the shortlist"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1c:["$","section","3-Write a short first email that is easy to answer",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Write a short first email that is easy to answer"}],[["$","p","Use the academic’s correct name and title. Explain your current stage, the concrete overlap and the question you need answered. Mention one relevant item of their work only if you understand it. A long list of publications without a connection adds little.",{"children":"Use the academic’s correct name and title. Explain your current stage, the concrete overlap and the question you need answered. Mention one relevant item of their work only if you understand it. A long list of publications without a connection adds little."}],["$","p","Attach only what the institution asks for or what is proportionate to the enquiry. A concise CV or research outline may help; a large bundle of certificates and personal identity documents usually does not. Never send bank details or passport scans in a speculative enquiry.",{"children":"Attach only what the institution asks for or what is proportionate to the enquiry. A concise CV or research outline may help; a large bundle of certificates and personal identity documents usually does not. Never send bank details or passport scans in a speculative enquiry."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"Example: a self-proposed research enquiry"}],[["$","p","0",{"children":"Subject: Prospective PhD enquiry — low-cost sensor validation"}],["$","p","1",{"children":"Dear Dr [Surname], I am completing [degree] at [institution]. My recent project involved [specific task and method]. I read your group’s work on [verified topic] and was interested in [one concrete connection]."}],["$","p","2",{"children":"I am investigating PhD routes for [intake] and would like to ask whether you expect to consider projects in [focused direction]. I have attached a brief CV and a one-page outline, as permitted by the programme guidance. I understand admission and funding require the formal process. Thank you for considering my enquiry."}]],["$","p",null,{"className":"sample-card__note","children":"Fictional adaptable example. Replace all brackets, follow the programme contact policy and never imply you read work you have not read."}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","4-An advertised project needs a different question",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"An advertised project needs a different question"}],[["$","p","If the project already gives a detailed brief and a submission link, do not ask the supervisor to repeat the advert. Identify a substantive point that affects your fit: a method, prerequisite, available direction or practical project constraint.",{"children":"If the project already gives a detailed brief and a submission link, do not ask the supervisor to repeat the advert. Identify a substantive point that affects your fit: a method, prerequisite, available direction or practical project constraint."}],["$","p","An enquiry should help you decide whether to apply; it should not ask for an informal admission offer.",{"children":"An enquiry should help you decide whether to apply; it should not ask for an informal admission offer."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"Example: a question about an advertised project"}],[["$","p","0",{"children":"Subject: Question about [project reference] before applying"}],["$","p","1",{"children":"Dear Professor [Surname], I am preparing an application for [verified project title]. My [project/course] included [relevant method]. The advert mentions [specific requirement]; could you clarify whether [focused, unanswered question]? I will submit through the stated portal if the project is a suitable fit. Thank you for your time."}]],["$","p",null,{"className":"sample-card__note","children":"Original teaching example. Do not send this unchanged or ask questions already answered in the advert."}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","5-Follow up with judgement, not a mass-mailing schedule",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Follow up with judgement, not a mass-mailing schedule"}],[["$","p","Allow reasonable time for a response, taking account of the programme deadline, leave and any stated office policy. There is no universal number of days that guarantees a good follow-up. If the institution specifies a response channel, use it.",{"children":"Allow reasonable time for a response, taking account of the programme deadline, leave and any stated office policy. There is no universal number of days that guarantees a good follow-up. If the institution specifies a response channel, use it."}],["$","p","A single concise follow-up can restate the enquiry and add relevant information. If there is no response, use the programme coordinator or another genuinely suitable contact rather than repeatedly chasing the same person. Silence does not prove your academic work is poor; availability and workload are often unknown.",{"children":"A single concise follow-up can restate the enquiry and add relevant information. If there is no response, use the programme coordinator or another genuinely suitable contact rather than repeatedly chasing the same person. Silence does not prove your academic work is poor; availability and workload are often unknown."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Choose the next action from the response","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Choose the next action from the response"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Response",{"scope":"col","children":"Response"}],["$","th","Useful next step",{"scope":"col","children":"Useful next step"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Interested in discussing"}],["$","td","1",{"children":"Arrange a meeting and prepare focused questions"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"No capacity"}],["$","td","1",{"children":"Thank them; consider other suitable academics"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Use the formal process"}],["$","td","1",{"children":"Apply through that route; do not negotiate around it"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"No reply"}],["$","td","1",{"children":"Check contact policy and deadline; consider one proportionate follow-up"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Unclear funding"}],["$","td","1",{"children":"Ask which formal funding routes may be relevant, without assuming support"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","6-Use the meeting to test fit in both directions",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Use the meeting to test fit in both directions"}],[["$","p","Prepare questions on project scope, supervision style, training, collaboration, facilities and the milestones expected in the first year. Ask what you should read or develop before applying. Be ready to explain your previous work and its limitations.",{"children":"Prepare questions on project scope, supervision style, training, collaboration, facilities and the milestones expected in the first year. Ask what you should read or develop before applying. Be ready to explain your previous work and its limitations."}],["$","p","If funding is relevant, ask what the advertised support covers, whether international fees are included and how long it lasts. A friendly meeting or an expression of interest is not a formal scholarship offer, contract or admission decision.",{"children":"If funding is relevant, ask what the advertised support covers, whether international fees are included and how long it lasts. A friendly meeting or an expression of interest is not a formal scholarship offer, contract or admission decision."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","7-Keep the research story consistent across documents",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Keep the research story consistent across documents"}],[["$","p","Your email, proposal, CV and formal application should describe the same preparation accurately. Update the research direction when a conversation changes it, but do not invent a new background for each academic.",{"children":"Your email, proposal, CV and formal application should describe the same preparation accurately. Update the research direction when a conversation changes it, but do not invent a new background for each academic."}],["$","p","Before submitting, check the required proposal length, ethics considerations and reference process. Retain a tracker of contacts and outcomes so that you can make a considered shortlist instead of applying to every institution that replies.",{"children":"Before submitting, check the required proposal length, ethics considerations and reference process. Retain a tracker of contacts and outcomes so that you can make a considered shortlist instead of applying to every institution that replies."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Keep the research story consistent across documents","children":[["$","$L4","/scholarships/phd/",{"href":"/scholarships/phd/","children":["Explore PhD funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/kaust/",{"href":"/scholarships/kaust/","children":["Compare KAUST research admission",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/fellowship-vs-scholarship/",{"href":"/guides/fellowship-vs-scholarship/","children":["Understand fellowship funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
