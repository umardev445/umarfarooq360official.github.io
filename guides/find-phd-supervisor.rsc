22:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Must I contact a supervisor before every PhD application?",{"children":[["$","summary",null,{"children":["Must I contact a supervisor before every PhD application?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Advertised projects, self-proposed research and centrally allocated programmes can use different procedures. Read the programme’s contact policy first."}]]}],["$","details","How many academics should I email?",{"children":[["$","summary",null,{"children":["How many academics should I email?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"There is no useful universal target. Contact genuinely relevant people through the permitted process instead of sending bulk messages."}]]}],["$","details","Does a positive reply guarantee funding?",{"children":[["$","summary",null,{"children":["Does a positive reply guarantee funding?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Confirm the formal admission and funding processes, conditions and written offer separately."}]]}]]}]]}]
