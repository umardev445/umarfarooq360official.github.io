1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide opportunity-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/find-phd-supervisor/\",\"name\":\"Find a PhD supervisor: shortlist, email and follow up\",\"description\":\"Build a PhD supervisor shortlist, write a focused first email and plan follow-up. Use original examples and separate research interest from admission and funding.\",\"url\":\"https://aspirecompass.org/guides/find-phd-supervisor/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-24\",\"dateModified\":\"2026-10-24\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/opportunities-20261024/supervisor-1280.webp\",\"caption\":\"Illustrative conversation between a prospective researcher and an academic\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Find a PhD supervisor: shortlist, email and follow up\",\"item\":\"https://aspirecompass.org/guides/find-phd-supervisor/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"Find a PhD supervisor: shortlist, email and follow up\",\"description\":\"Build a PhD supervisor shortlist, write a focused first email and plan follow-up. Use original examples and separate research interest from admission and funding.\",\"image\":\"https://aspirecompass.org/images/opportunities-20261024/supervisor-1280.webp\",\"datePublished\":\"2026-10-24\",\"dateModified\":\"2026-10-24\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/find-phd-supervisor/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Must I contact a supervisor before every PhD application?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Advertised projects, self-proposed research and centrally allocated programmes can use different procedures. Read the programme’s contact policy first.\"}},{\"@type\":\"Question\",\"name\":\"How many academics should I email?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"There is no useful universal target. Contact genuinely relevant people through the permitted process instead of sending bulk messages.\"}},{\"@type\":\"Question\",\"name\":\"Does a positive reply guarantee funding?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Confirm the formal admission and funding processes, conditions and written offer separately.\"}}]}"}}]],["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--guide inner-hero--visual","children":"$L17"}],false,"$L18","$L19"]}]
