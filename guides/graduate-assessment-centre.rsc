1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide opportunity-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/graduate-assessment-centre/\",\"name\":\"Graduate assessment centres: practise the decisions\",\"description\":\"Prepare for graduate assessment centres with an original case study, in-tray exercise, group-task examples and a practical seven-day rehearsal plan.\",\"url\":\"https://aspirecompass.org/guides/graduate-assessment-centre/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-24\",\"dateModified\":\"2026-10-24\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/opportunities-20261024/career-1280.webp\",\"caption\":\"Illustrative graduate workshop with participants comparing ideas around a table\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Graduate assessment centres: practise the decisions\",\"item\":\"https://aspirecompass.org/guides/graduate-assessment-centre/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"Graduate assessment centres: practise the decisions\",\"description\":\"Prepare for graduate assessment centres with an original case study, in-tray exercise, group-task examples and a practical seven-day rehearsal plan.\",\"image\":\"https://aspirecompass.org/images/opportunities-20261024/career-1280.webp\",\"datePublished\":\"2026-10-24\",\"dateModified\":\"2026-10-24\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/graduate-assessment-centre/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is there one correct case-study answer?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Not always. A recommendation should respect the facts and constraints, identify assumptions and explain the reasoning. The practice case illustrates that approach.\"}},{\"@type\":\"Question\",\"name\":\"Should I lead every group exercise?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Help the group achieve the task through relevant contributions, listening, clear reasoning and time awareness. Dominating a discussion can obstruct the work.\"}},{\"@type\":\"Question\",\"name\":\"Are these exercises used by a real employer?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The data and scenarios are original fictional teaching examples. Follow the actual employer’s instructions for your assessment.\"}}]}"}}]],"$L1a",false,"$L1b","$L1c"]}]
1a:["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--guide inner-hero--visual","children":["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L5",null,{"href":"/","children":"Home"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/",{"children":[["$","$L5",null,{"href":"/guides/","children":"Guides"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/graduate-assessment-centre/",{"children":[["$","span",null,{"aria-current":"page","children":"Graduate assessment centres: practise the decisions"}],false]}]]}],["$","span",null,{"data-slot":"badge","data-variant":"outline","className":"inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3 border-border text-foreground [a&]:hover:bg-accent [a&]:hover:text-accent-foreground inner-eyebrow","children":"Applications & opportunity planning"}],false,["$","h1",null,{"children":"Graduate assessment centres: practise the decisions"}],["$","p",null,{"children":"Assessment centres let recruiters observe how you work across several tasks. Prepare by practising your reasoning, communication and collaboration—not by trying to memorise a model personality or dominate the group."}],["$","div",null,{"className":"inner-hero__meta","children":[["$","span",null,{"children":[["$","$L6",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.5