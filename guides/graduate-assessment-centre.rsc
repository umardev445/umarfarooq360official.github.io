28:I["ab32ab9b14fd",[],"TaskChecklist",1]
23:["$","p","Practise a two-minute verbal version. State the recommendation first, explain two reasons and close with a risk and next step. If challenged, revisit the evidence instead of defending the first answer at any cost. Employers may assess how you respond to new information as well as the original recommendation.",{"children":"Practise a two-minute verbal version. State the recommendation first, explain two reasons and close with a risk and next step. If challenged, revisit the evidence instead of defending the first answer at any cost. Employers may assess how you respond to new information as well as the original recommendation."}]
24:["$","section","4-In-tray exercise: decide what to do first",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"In-tray exercise: decide what to do first"}],[["$","p","Fictional scenario: you join a project team at 09:00. You have a client call at 10:00, a slide deck to check, a request to approve an invoice with missing information and a team member reporting that the figures in the deck may be wrong. You cannot do everything immediately.",{"children":"Fictional scenario: you join a project team at 09:00. You have a client call at 10:00, a slide deck to check, a request to approve an invoice with missing information and a team member reporting that the figures in the deck may be wrong. You cannot do everything immediately."}],["$","p","A defensible sequence is to clarify the potentially incorrect figures, notify the meeting owner of any material risk and prepare a safe update for the call. Seek the missing invoice evidence before approval. Explain dependencies and who needs a message; do not simply label every task urgent.",{"children":"A defensible sequence is to clarify the potentially incorrect figures, notify the meeting owner of any material risk and prepare a safe update for the call. Seek the missing invoice evidence before approval. Explain dependencies and who needs a message; do not simply label every task urgent."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L28",null,{"id":"guides/graduate-assessment-centre:section-5","title":"Check your progress","items":["Identify deadlines and the consequence of getting a task wrong.","Separate an irreversible approval from a task you can safely defer.","Ask for the specific missing information.","Communicate a delay before the affected person has to chase you.","Explain your priorities and reassess if new evidence arrives."]}],"$undefined","$undefined"]}]
25:["$","section","5-Group exercises: make the discussion usable",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Group exercises: make the discussion usable"}],[["$","p","Useful participation combines contributing, listening and helping the group make progress. Agree the objective and timing, ask what evidence supports an option and invite another view when relevant. Speaking first or longest is not a substitute for collaboration.",{"children":"Useful participation combines contributing, listening and helping the group make progress. Agree the objective and timing, ask what evidence supports an option and invite another view when relevant. Speaking first or longest is not a substitute for collaboration."}],["$","p","Try phrases such as “Which constraint rules out an option?”, “We have five minutes; what do we still need to decide?” or “How does that change our recommendation?” Do not assign yourself a leadership role without considering the group. If someone challenges your suggestion, summarise their point accurately before responding.",{"children":"Try phrases such as “Which constraint rules out an option?”, “We have five minutes; what do we still need to decide?” or “How does that change our recommendation?” Do not assign yourself a leadership role without considering the group. If someone challenges your suggestion, summarise their point accurately before responding."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","6-Virtual logistics and reasonable adjustments",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Virtual logistics and reasonable adjustments"}],[["$","p","Test the actual meeting platform, microphone, camera and screen sharing. Keep the invitation and recruiter contact accessible if the connection fails. Ask in advance how to report a technical interruption; do not assume that leaving the call and returning later will be accepted.",{"children":"Test the actual meeting platform, microphone, camera and screen sharing. Keep the invitation and recruiter contact accessible if the connection fails. Ask in advance how to report a technical interruption; do not assume that leaving the call and returning later will be accepted."}],["$","p","If you need an adjustment or accessible format, contact the recruiter early. Oxford’s careers guidance includes examples of access needs and possible adjustments. Your request should focus on the barrier and what would help you demonstrate the relevant skills.",{"children":"If you need an adjustment or accessible format, contact the recruiter early. Oxford’s careers guidance includes examples of access needs and possible adjustments. Your request should focus on the barrier and what would help you demonstrate the relevant skills."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
27:["$","section","7-Use feedback to decide the next practice task",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Use feedback to decide the next practice task"}],[["$","p","After a rehearsal, score the process rather than your confidence: did you use the evidence accurately, explain assumptions, manage time and listen? Write one behaviour to repeat and one to change. A practice rubric is not an employer’s pass mark.",{"children":"After a rehearsal, score the process rather than your confidence: did you use the evidence accurately, explain assumptions, manage time and listen? Write one behaviour to repeat and one to change. A practice rubric is not an employer’s pass mark."}],["$","p","After the real event, follow the employer’s feedback process. One difficult task does not tell you the final outcome. If unsuccessful, use specific feedback to choose your next exercise rather than rewriting your entire application strategy.",{"children":"After the real event, follow the employer’s feedback process. One difficult task does not tell you the final outcome. If unsuccessful, use specific feedback to choose your next exercise rather than rewriting your entire application strategy."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Use feedback to decide the next practice task","children":[["$","$L5","/graduate-programs/",{"href":"/graduate-programs/","children":["Understand graduate programmes",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/entry-level-jobs/",{"href":"/entry-level-jobs/","children":["Explore entry-level opportunities",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
