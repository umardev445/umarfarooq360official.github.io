1b:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Prepare for the employer’s stated format, then practise explaining decisions under time constraints. The original exercises below help you test evidence, priorities and teamwork; they are not leaked employer tasks."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Read your invitation and complete one timed exercise, then review the reasoning rather than memorising the sample answer."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Find out what your assessment actually includes",{"href":"#section-1","children":"Find out what your assessment actually includes"}],["$","a","Build a realistic seven-day preparation plan",{"href":"#section-2","children":"Build a realistic seven-day preparation plan"}],["$","a","Worked case: choose a campus service improvement",{"href":"#section-3","children":"Worked case: choose a campus service improvement"}],["$","a","Debrief the case before trying another",{"href":"#section-4","children":"Debrief the case before trying another"}],["$","a","In-tray exercise: decide what to do first",{"href":"#section-5","children":"In-tray exercise: decide what to do first"}],["$","a","Group exercises: make the discussion usable",{"href":"#section-6","children":"Group exercises: make the discussion usable"}],["$","a","Virtual logistics and reasonable adjustments",{"href":"#section-7","children":"Virtual logistics and reasonable adjustments"}],["$","a","Use feedback to decide the next practice task",{"href":"#section-8","children":"Use feedback to decide the next practice task"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Find out what your assessment actually includes",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Find out what your assessment actually includes"}],[["$","p","Start with the invitation, role description and any preparation pack. Assessment days can include interviews, group tasks, written work, presentations and simulations, but the exact format belongs to the employer. Ask the recruiter about missing timing, technology or access details.",{"children":"Start with the invitation, role description and any preparation pack. Assessment days can include interviews, group tasks, written work, presentations and simulations, but the exact format belongs to the employer. Ask the recruiter about missing timing, technology or access details."}],["$","p","Mark which activities are confirmed and which are only possible. Preparation for an announced case study is more useful than rehearsing every task mentioned on the internet. Check the employer’s rules on notes, external tools and assistance, especially for remote tasks.",{"children":"Mark which activities are confirmed and which are only possible. Preparation for an announced case study is more useful than rehearsing every task mentioned on the internet. Check the employer’s rules on notes, external tools and assistance, especially for remote tasks."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1d"]}],"$L1e",false,false,false,"$L1f",false,"$L20","$L21"]}],"$L22"]}]
1c:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L5","graduate-programs",{"href":"/graduate-programs/","children":[["$","span",null,{"children":"First career step"}],["$","h3",null,{"children":"Graduate programmes for international applicants"}],["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","entry-level-jobs",{"href":"/entry-level-jobs/","children":[["$","span",null,{"children":"Launch your career"}],["$","h3",null,{"children":"Entry-level jobs and early-career pathways"}],["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","guides/internship-application",{"href":"/guides/internship-application/","children":[["$","span",null,{"children":"Career guide"}],["$","h3",null,{"children":"How to apply for international internships"}],["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
1d:["$","section","Build a realistic seven-day preparation plan",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Build a realistic seven-day preparation plan"}],[["$","p","Use this sequence as an adaptable rehearsal plan, not a claim that seven days is enough for every role. Spend more time on an unfamiliar task and less on polishing work you already understand.",{"children":"Use this sequence as an adaptable rehearsal plan, not a claim that seven days is enough for every role. Spend more time on an unfamiliar task and less on polishing work you already understand."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"An original preparation timetable","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"An original preparation timetable"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Day",{"scope":"col","children":"Day"}],["$","th","Main task",{"scope":"col","children":"Main task"}],["$","th","Output",{"scope":"col","children":"Output"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"1"}],["$","td","1",{"children":"Read the role and invitation"}],["$","td","2",{"children":"Confirmed formats and competency list"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"2"}],["$","td","1",{"children":"Research the employer and sector"}],["$","td","2",{"children":"One-page briefing with sources"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"3"}],["$","td","1",{"children":"Practise the worked case below"}],["$","td","2",{"children":"Timed recommendation with assumptions"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"4"}],["$","td","1",{"children":"Try a group discussion or explain a case to a friend"}],["$","td","2",{"children":"Feedback on clarity and listening"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"5"}],["$","td","1",{"children":"Practise a presentation and interview examples"}],["$","td","2",{"children":"A timed explanation with evidence"}]],"$undefined"]}],["$","tr","5",{"children":[[["$","th","0",{"scope":"row","children":"6"}],["$","td","1",{"children":"Complete a short in-tray rehearsal"}],["$","td","2",{"children":"Priority order and reasons"}]],"$undefined"]}],["$","tr","6",{"children":[[["$","th","0",{"scope":"row","children":"7"}],["$","td","1",{"children":"Check logistics and rest"}],["$","td","2",{"children":"Working equipment, route and contact details"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","figure",null,{"className":"page-visual page-visual--inline","children":[["$","img",null,{"src":"/images/opportunities-20261024/career-1280.webp","srcSet":"/images/opportunities-20261024/career-640.webp 640w, /images/opportunities-20261024/career-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Illustrative graduate workshop with participants comparing ideas around a table","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Illustrative scene; not a photograph of a named institution or programme participants."}]]}]
1f:["$","article",null,{"className":"article-body article-body--guide","children":[null,null,["$","section","2-Worked case: choose a campus service improvement",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Worked case: choose a campus service improvement"}],[["$","p","Fictional practice task: you have 15 minutes to recommend one pilot for a student advice service. The maximum budget is £10,000. Your recommendation should identify the choice, the main risk and a measure of success. These are invented exercise data, not figures from an actual employer.",{"children":"Fictional practice task: you have 15 minutes to recommend one pilot for a student advice service. The maximum budget is £10,000. Your recommendation should identify the choice, the main risk and a measure of success. These are invented exercise data, not figures from an actual employer."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Practice case data","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Practice case data"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Option",{"scope":"col","children":"Option"}],["$","th","Pilot cost",{"scope":"col","children":"Pilot cost"}],["$","th","Expected monthly use",{"scope":"col","children":"Expected monthly use"}],["$","th","Important limitation",{"scope":"col","children":"Important limitation"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"A: late-evening appointments"}],["$","td","1",{"children":"£8,000"}],["$","td","2",{"children":"160 visits"}],["$","td","3",{"children":"Only two evenings per week"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"B: self-service booking redesign"}],["$","td","1",{"children":"£6,000"}],["$","td","2",{"children":"300 bookings"}],["$","td","3",{"children":"A booking is not a completed advice session"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"C: mobile advice desk"}],["$","td","1",{"children":"£11,000"}],["$","td","2",{"children":"240 visits"}],["$","td","3",{"children":"Exceeds the available pilot budget"}]],"$undefined"]}]]}]]}]}],"$undefined"],["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"A reasoned answer, not the only correct answer"}],[["$","p","0",{"children":"I would pilot A within the £10,000 budget. It directly tests whether evening access helps students who cannot attend during the day. B may be valuable, but its booking metric is not comparable to completed advice visits. I would ask for attendance and cancellation data before claiming it delivers more advice. C needs a lower-cost proposal or extra funding."}],["$","p","1",{"children":"I would measure completed evening sessions, missed appointments and feedback from the intended users. The main risk is staffing availability. I would agree the pilot timetable and review point before spending the full budget."}]],["$","p",null,{"className":"sample-card__note","children":"Original teaching case. Different recommendations can be reasonable if they respect the constraints and explain the evidence."}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Debrief the case before trying another",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Debrief the case before trying another"}],[["$","p","Notice the three reasoning moves: apply a hard budget constraint, compare measures on the same basis and name missing information. A weak answer might rank the largest number without noticing that bookings and visits mean different things.",{"children":"Notice the three reasoning moves: apply a hard budget constraint, compare measures on the same basis and name missing information. A weak answer might rank the largest number without noticing that bookings and visits mean different things."}],"$L23"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L24","$L25","$L26","$L27"]}]
20:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L5","https://www.ox.ac.uk/careers/careers-guidance/job-search-and-applications/assessment-centres",{"href":"https://www.ox.ac.uk/careers/careers-guidance/job-search-and-applications/assessment-centres","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Oxford Careers: assessment centres"}],["$","span",null,{"children":"Official guidance checked 24 October 2026; the live programme instructions take precedence."}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L5","https://www.prospects.ac.uk/careers-advice/interview-tips/assessment-centres/",{"href":"https://www.prospects.ac.uk/careers-advice/interview-tips/assessment-centres/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Prospects: assessment formats and preparation"}],["$","span",null,{"children":"Background careers guidance. The exercises and schedule on this AspireCompass page are original fictional teaching material."}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":"$20:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
21:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is there one correct case-study answer?",{"children":[["$","summary",null,{"children":["Is there one correct case-study answer?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not always. A recommendation should respect the facts and constraints, identify assumptions and explain the reasoning. The practice case illustrates that approach."}]]}],["$","details","Should I lead every group exercise?",{"children":[["$","summary",null,{"children":["Should I lead every group exercise?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Help the group achieve the task through relevant contributions, listening, clear reasoning and time awareness. Dominating a discussion can obstruct the work."}]]}],["$","details","Are these exercises used by a real employer?",{"children":[["$","summary",null,{"children":["Are these exercises used by a real employer?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The data and scenarios are original fictional teaching examples. Follow the actual employer’s instructions for your assessment."}]]}]]}]]}]
22:["$","aside",null,{"className":"content-sidebar","children":[["$","div",null,{"className":"sidebar-card sidebar-card--contents","children":[["$","span",null,{"children":"On this page"}],["$","nav",null,{"aria-label":"Page contents","children":[["$","a","Find out what your assessment actually includes",{"href":"#section-1","children":[["$","b",null,{"children":"01"}],"Find out what your assessment actually includes"]}],["$","a","Build a realistic seven-day preparation plan",{"href":"#section-2","children":[["$","b",null,{"children":"02"}],"Build a realistic seven-day preparation plan"]}],["$","a","Worked case: choose a campus service improvement",{"href":"#section-3","children":[["$","b",null,{"children":"03"}],"Worked case: choose a campus service improvement"]}],["$","a","Debrief the case before trying another",{"href":"#section-4","children":[["$","b",null,{"children":"04"}],"Debrief the case before trying another"]}],["$","a","In-tray exercise: decide what to do first",{"href":"#section-5","children":[["$","b",null,{"children":"05"}],"In-tray exercise: decide what to do first"]}],["$","a","Group exercises: make the discussion usable",{"href":"#section-6","children":[["$","b",null,{"children":"06"}],"Group exercises: make the discussion usable"]}],["$","a","Virtual logistics and reasonable adjustments",{"href":"#section-7","children":[["$","b",null,{"children":"07"}],"Virtual logistics and reasonable adjustments"]}],["$","a","Use feedback to decide the next practice task",{"href":"#section-8","children":[["$","b",null,{"children":"08"}],"Use feedback to decide the next practice task"]}]]}]]}],["$","div",null,{"className":"sidebar-card","children":[["$","h2",null,{"children":"Next useful step"}],[["$","$L5","graduate-programs",{"href":"/graduate-programs/","children":["Graduate programmes for international applicants"," ",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]