15:T8e1,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long should a statement of purpose be?","acceptedAnswer":{"@type":"Answer","text":"Follow the programme's exact limit. Requirements vary widely: some applications use about 500 words, while others allow up to 1,000 words or provide separate short questions. Never exceed the stated word, character or page limit."}},{"@type":"Question","name":"What is the difference between an SOP and a personal statement?","acceptedAnswer":{"@type":"Answer","text":"An SOP normally focuses on academic or professional preparation, interests, programme fit and future goals. A personal statement usually gives more space to background, experiences, values and community contribution. The application's own prompt is the final authority."}},{"@type":"Question","name":"Should I use the same SOP for every university?","acceptedAnswer":{"@type":"Answer","text":"You can reuse a core account of your direction and strongest evidence, but the programme-fit section and any prompt-specific material must be rewritten. If changing only the university name still produces a plausible essay, the statement is too generic."}},{"@type":"Question","name":"Can I mention a low GPA or study gap in my SOP?","acceptedAnswer":{"@type":"Answer","text":"Yes, when the context is relevant or requested. Explain it briefly, focus on the actions you took and support the explanation with stronger recent evidence. Do not allow the explanation to dominate the statement."}},{"@type":"Question","name":"Should a PhD SOP name potential supervisors?","acceptedAnswer":{"@type":"Answer","text":"Name potential supervisors only when their current research genuinely aligns with your interests and the programme encourages it. Explain the research connection rather than listing names, and verify that the faculty members are active in the relevant area."}},{"@type":"Question","name":"Can I use AI to write a statement of purpose?","acceptedAnswer":{"@type":"Answer","text":"Check each institution's current AI and authorship policy. Tools may help with brainstorming or proofreading where permitted, but the evidence, reasoning and final voice must be your own. Never submit invented experiences or copied text."}}]}1:["$","main",null,{"id":"main-content","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/statement-of-purpose/\",\"name\":\"How to write a statement of purpose for scholarships and graduate study\",\"description\":\"Write a focused statement of purpose for scholarships, master's and PhD applications using a clear structure, strong examples and an editing checklist.\",\"url\":\"https://aspirecompass.org/guides/statement-of-purpose/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-08-31\",\"dateModified\":\"2026-10-13\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/application-writing-1280.webp\",\"caption\":\"A student reviewing notes and preparing an application at a desk\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"How to write a statement of purpose for scholarships and graduate study\",\"item\":\"https://aspirecompass.org/guides/statement-of-purpose/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"How to write a statement of purpose for scholarships and graduate study\",\"description\":\"Write a focused statement of purpose for scholarships, master's and PhD applications using a clear structure, strong examples and an editing checklist.\",\"image\":\"https://aspirecompass.org/images/application-writing-1280.webp\",\"datePublished\":\"2026-08-31\",\"dateModified\":\"2026-10-13\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/statement-of-purpose/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$15"}}]],"$L16","$L17","$L18"]}]
