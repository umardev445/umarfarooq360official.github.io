16:["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--guide inner-hero--visual","children":["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L4",null,{"href":"/","children":"Home"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/",{"children":[["$","$L4",null,{"href":"/guides/","children":"Guides"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/statement-of-purpose/",{"children":[["$","span",null,{"aria-current":"page","children":"How to write a statement of purpose for scholarships and graduate study"}],false]}]]}],["$","span",null,{"data-slot":"badge","data-variant":"outline","className":"inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3 border-border text-foreground [a&]:hover:bg-accent [a&]:hover:text-accent-foreground inner-eyebrow","children":"Writing guide"}],["$","h1",null,{"children":"How to write a statement of purpose for scholarships and graduate study"}],["$","p",null,{"children":"A strong statement of purpose is not a longer version of your CV. It is a focused argument that connects your preparation, academic direction, programme fit and future plans in the order an admissions or scholarship committee needs to understand them."}],["$","div",null,{"className":"inner-hero__meta","children":[["$","span",null,{"children":[["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z","key":"oel41y"}],["path",{"d":"m9 12 2 2 4-4","key":"dzmm74"}]],"className":"lucide-shield-check","aria-hidden":"true"}]," Updated ","13 Oct 2026"]}],null]}]]}],["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/application-writing-1280.webp","srcSet":"/images/application-writing-640.webp 640w, /images/application-writing-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"A student reviewing notes and preparing an application at a desk","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Prepare your own evidence, then adapt it to the application instructions."}]]}]]}]}]
17:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"A strong statement of purpose is not a longer version of your CV. It is a focused argument that connects your preparation, academic direction, programme fit and future plans in the order an admissions or scholarship committee needs to understand them."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Start with the comparison or checklist below, then open the current instructions for your exact programme or route."]}],"$undefined"]}],false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Build your SOP evidence outline",{"href":"#section-1","children":"Build your SOP evidence outline"}],["$","a","What a statement of purpose must prove",{"href":"#section-2","children":"What a statement of purpose must prove"}],["$","a","Read the exact prompt before choosing a format",{"href":"#section-3","children":"Read the exact prompt before choosing a format"}],["$","a","Statement of purpose, personal statement and motivation letter",{"href":"#section-4","children":"Statement of purpose, personal statement and motivation letter"}],["$","a","How a master's SOP differs from a PhD SOP",{"href":"#section-5","children":"How a master's SOP differs from a PhD SOP"}],["$","a","A reliable six-part SOP structure",{"href":"#section-6","children":"A reliable six-part SOP structure"}],["$","a","Write an opening that gives immediate direction",{"href":"#section-7","children":"Write an opening that gives immediate direction"}],["$","a","Turn experience into evidence",{"href":"#section-8","children":"Turn experience into evidence"}],["$","a","Make programme fit specific without copying the website",{"href":"#section-9","children":"Make programme fit specific without copying the website"}],["$","a","Adapt the SOP for a scholarship",{"href":"#section-10","children":"Adapt the SOP for a scholarship"}],["$","a","Address a study gap, low grade or career change briefly",{"href":"#section-11","children":"Address a study gap, low grade or career change briefly"}],["$","a","An illustrative SOP paragraph",{"href":"#section-12","children":"An illustrative SOP paragraph"}],["$","a","Common SOP mistakes",{"href":"#section-13","children":"Common SOP mistakes"}],["$","a","Final editing checklist",{"href":"#section-14","children":"Final editing checklist"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Build your SOP evidence outline",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Build your SOP evidence outline"}],[["$","p","Use this outline only when it fits the official prompt. Examples teach a method and must not be copied as personal experience.",{"children":"Use this outline only when it fits the official prompt. Examples teach a method and must not be copied as personal experience."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A working evidence map","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A working evidence map"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Part",{"scope":"col","children":"Part"}],["$","th","Evidence to gather",{"scope":"col","children":"Evidence to gather"}],["$","th","What to explain",{"scope":"col","children":"What to explain"}]],"$undefined"]}]}],"$L19"]}]}],"$undefined"],"$undefined","$L1a","$undefined","$L1b","$undefined"]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}],false,null,"$L29"]}],"$L2a"]}]
18:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","guides/motivation-letter",{"href":"/guides/motivation-letter/","children":[["$","span",null,{"children":"Writing guide"}],["$","h3",null,{"children":"How to write a scholarship motivation letter"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/scholarship-application",{"href":"/guides/scholarship-application/","children":[["$","span",null,{"children":"Application guide"}],["$","h3",null,{"children":"How to apply for international scholarships step by step"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/recommendation-letter",{"href":"/guides/recommendation-letter/","children":[["$","span",null,{"children":"Reference guide"}],["$","h3",null,{"children":"How to get strong scholarship recommendation letters"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","scholarships/phd",{"href":"/scholarships/phd/","children":[["$","span",null,{"children":"Doctoral funding"}],["$","h3",null,{"children":"PhD scholarships and funded doctoral opportunities"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
2b:I["ab32ab9b14fd",[],"TaskChecklist",1]
19:["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Preparation"}],["$","td","1",{"children":"Relevant courses, project or research"}],["$","td","2",{"children":"What you did and what it taught you"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Programme fit"}],["$","td","1",{"children":"Named modules, lab or academic approach"}],["$","td","2",{"children":"How it supports your next question"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Future direction"}],["$","td","1",{"children":"Specific feasible next step"}],["$","td","2",{"children":"Why this programme prepares you"}]],"$undefined"]}]]}]
1a:["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"Weak: “I am passionate about research.” Stronger example: “In my final-year project I compared two water-filter designs, recorded their limitations and identified a question I want to study further.”"}]]}]
1b:["$","$L2b",null,{"id":"guides/statement-of-purpose:section-1","title":"Check your progress","items":["Read the actual prompt and word limit.","Select evidence you can substantiate.","Explain programme fit using verified details.","Check consistency with your CV and transcript."]}]
1c:["$","section","1-What a statement of purpose must prove",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"What a statement of purpose must prove"}],[["$","p","A statement of purpose, often shortened to SOP, helps a selection committee understand what you want to study, how your previous work has prepared you, why the chosen programme is the right next step and what you intend to do afterwards. It should add meaning to your transcript and CV rather than repeat them line by line.",{"children":"A statement of purpose, often shortened to SOP, helps a selection committee understand what you want to study, how your previous work has prepared you, why the chosen programme is the right next step and what you intend to do afterwards. It should add meaning to your transcript and CV rather than repeat them line by line."}],["$","p","The strongest SOPs make a coherent case. The reader should be able to identify your academic direction, see evidence that you can succeed and understand why this particular opportunity fits your next stage. Clear reasoning is more persuasive than dramatic language or unsupported claims about passion.",{"children":"The strongest SOPs make a coherent case. The reader should be able to identify your academic direction, see evidence that you can succeed and understand why this particular opportunity fits your next stage. Clear reasoning is more persuasive than dramatic language or unsupported claims about passion."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","A clear academic, professional or research direction",{"children":"A clear academic, professional or research direction"}],["$","li","Relevant preparation supported by specific evidence",{"children":"Relevant preparation supported by specific evidence"}],["$","li","A credible reason for choosing the programme",{"children":"A credible reason for choosing the programme"}],["$","li","Realistic short-term and long-term goals",{"children":"Realistic short-term and long-term goals"}],["$","li","A writing style that is focused, accurate and easy to follow",{"children":"A writing style that is focused, accurate and easy to follow"}]]}],"$undefined","$undefined"]}]
1d:["$","section","2-Read the exact prompt before choosing a format",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Read the exact prompt before choosing a format"}],[["$","p","There is no universal SOP length or structure. Some universities ask for 500 words, while others permit up to 1,000 words or provide several short questions instead of one essay. The programme's current instructions always override general advice, including advice on this page.",{"children":"There is no universal SOP length or structure. Some universities ask for 500 words, while others permit up to 1,000 words or provide several short questions instead of one essay. The programme's current instructions always override general advice, including advice on this page."}],["$","p","Copy the prompt into a planning document and underline every task. If it asks about preparation, research interests, programme fit and career plans, give each requirement a clear place in the draft. Check whether a separate personal statement, diversity statement, research proposal or scholarship essay is also required so that the documents do not repeat one another.",{"children":"Copy the prompt into a planning document and underline every task. If it asks about preparation, research interests, programme fit and career plans, give each requirement a clear place in the draft. Check whether a separate personal statement, diversity statement, research proposal or scholarship essay is also required so that the documents do not repeat one another."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Confirm the word, character or page limit",{"children":"Confirm the word, character or page limit"}],["$","li","Identify every question contained in the prompt",{"children":"Identify every question contained in the prompt"}],["$","li","Check formatting and file-type requirements",{"children":"Check formatting and file-type requirements"}],["$","li","Separate the SOP from any personal or research statement",{"children":"Separate the SOP from any personal or research statement"}],["$","li","Follow programme-specific guidance before general templates",{"children":"Follow programme-specific guidance before general templates"}]]}],"$undefined","$undefined"]}]
1e:["$","section","3-Statement of purpose, personal statement and motivation letter",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Statement of purpose, personal statement and motivation letter"}],[["$","p","These documents can overlap, but they are not automatically interchangeable. A statement of purpose usually gives greatest weight to academic or professional preparation, intellectual interests, programme fit and career direction. A personal statement normally gives more space to formative experiences, context, values and the perspective you would bring to a community.",{"children":"These documents can overlap, but they are not automatically interchangeable. A statement of purpose usually gives greatest weight to academic or professional preparation, intellectual interests, programme fit and career direction. A personal statement normally gives more space to formative experiences, context, values and the perspective you would bring to a community."}],["$","p","A scholarship motivation letter may focus more directly on the funder's purpose, your reasons for seeking support, leadership or service evidence and the impact you plan to create. If an application uses one of these titles without defining it, analyse the actual prompt rather than relying on the document name.",{"children":"A scholarship motivation letter may focus more directly on the funder's purpose, your reasons for seeking support, leadership or service evidence and the impact you plan to create. If an application uses one of these titles without defining it, analyse the actual prompt rather than relying on the document name."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","4-How a master's SOP differs from a PhD SOP",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"How a master's SOP differs from a PhD SOP"}],[["$","p","For a taught or professional master's degree, explain the skills or knowledge gap you need to close, the experiences that created this direction, the programme features that address the gap and the career outcome you are working towards. Show readiness without pretending that you already know everything the course is designed to teach.",{"children":"For a taught or professional master's degree, explain the skills or knowledge gap you need to close, the experiences that created this direction, the programme features that address the gap and the career outcome you are working towards. Show readiness without pretending that you already know everything the course is designed to teach."}],["$","p","For a research master's or PhD, move research fit closer to the centre. Describe the problem area or questions that interest you, relevant methods or projects, what you learned from previous research and why the department, research group or potential supervisors provide a suitable environment. Avoid presenting a rigid project that ignores the programme's actual expertise.",{"children":"For a research master's or PhD, move research fit closer to the centre. Describe the problem area or questions that interest you, relevant methods or projects, what you learned from previous research and why the department, research group or potential supervisors provide a suitable environment. Avoid presenting a rigid project that ignores the programme's actual expertise."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Master's: preparation, skills gap, course fit and career application",{"children":"Master's: preparation, skills gap, course fit and career application"}],["$","li","PhD: research direction, methods, prior research and faculty fit",{"children":"PhD: research direction, methods, prior research and faculty fit"}],["$","li","Professional programmes: decisions, responsibility and measurable outcomes",{"children":"Professional programmes: decisions, responsibility and measurable outcomes"}],["$","li","Scholarship applications: selection criteria, public value and future impact",{"children":"Scholarship applications: selection criteria, public value and future impact"}]]}],"$undefined","$undefined"]}]
20:["$","section","5-A reliable six-part SOP structure",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"A reliable six-part SOP structure"}],[["$","p","Use structure to control the argument, not to make every SOP sound identical. The outline below is a practical starting point that can be shortened, expanded or reordered to match the official prompt.",{"children":"Use structure to control the argument, not to make every SOP sound identical. The outline below is a practical starting point that can be shortened, expanded or reordered to match the official prompt."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","1. Direction: state the field, problem or goal that motivates the application",{"children":"1. Direction: state the field, problem or goal that motivates the application"}],["$","li","2. Foundation: show the academic or professional background most relevant to that direction",{"children":"2. Foundation: show the academic or professional background most relevant to that direction"}],["$","li","3. Evidence: explain one or two projects, research experiences or responsibilities in useful detail",{"children":"3. Evidence: explain one or two projects, research experiences or responsibilities in useful detail"}],["$","li","4. Current interests: identify the questions, skills or problems you now want to explore",{"children":"4. Current interests: identify the questions, skills or problems you now want to explore"}],["$","li","5. Programme fit: connect specific course features to your preparation and goals",{"children":"5. Programme fit: connect specific course features to your preparation and goals"}],["$","li","6. Trajectory: close with a credible plan for using the degree, research or scholarship",{"children":"6. Trajectory: close with a credible plan for using the degree, research or scholarship"}]]}],"$undefined","$undefined"]}]
21:["$","section","6-Write an opening that gives immediate direction",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Write an opening that gives immediate direction"}],[["$","p","An effective opening tells the reader where the statement is going. You do not need a famous quotation, a dictionary definition or a childhood story unless it directly explains your present academic direction. Begin with a problem, observation, project or decision that can be connected to the rest of the application.",{"children":"An effective opening tells the reader where the statement is going. You do not need a famous quotation, a dictionary definition or a childhood story unless it directly explains your present academic direction. Begin with a problem, observation, project or decision that can be connected to the rest of the application."}],["$","p","A weak opening might say, 'Since childhood, I have always been passionate about technology.' A stronger opening would name the work and the question it created: 'While analysing repeated production delays in a small manufacturing operation, I saw how weak process data turned everyday decisions into guesswork. That experience shaped my interest in data-led operations management.' The second version creates a direction that later paragraphs can support.",{"children":"A weak opening might say, 'Since childhood, I have always been passionate about technology.' A stronger opening would name the work and the question it created: 'While analysing repeated production delays in a small manufacturing operation, I saw how weak process data turned everyday decisions into guesswork. That experience shaped my interest in data-led operations management.' The second version creates a direction that later paragraphs can support."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","7-Turn experience into evidence",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Turn experience into evidence"}],[["$","p","Do not simply announce that you completed a project, internship or thesis. Explain the problem, your responsibility, the method or decision you used, the outcome and the capability you developed. Select evidence for relevance, not because it sounds prestigious.",{"children":"Do not simply announce that you completed a project, internship or thesis. Explain the problem, your responsibility, the method or decision you used, the outcome and the capability you developed. Select evidence for relevance, not because it sounds prestigious."}],["$","p","For research experience, name the question, method, your individual contribution and what the result taught you. For professional experience, describe the situation, the action you owned and a measurable or observable outcome. Reflection matters because it shows how experience changed your judgement or prepared you for more advanced work.",{"children":"For research experience, name the question, method, your individual contribution and what the result taught you. For professional experience, describe the situation, the action you owned and a measurable or observable outcome. Reflection matters because it shows how experience changed your judgement or prepared you for more advanced work."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","What problem or question were you addressing?",{"children":"What problem or question were you addressing?"}],["$","li","What did you personally do?",{"children":"What did you personally do?"}],["$","li","Which method, tool or reasoning did you use?",{"children":"Which method, tool or reasoning did you use?"}],["$","li","What changed or what did you learn?",{"children":"What changed or what did you learn?"}],["$","li","How does this evidence support your proposed next step?",{"children":"How does this evidence support your proposed next step?"}]]}],"$undefined","$undefined"]}]
23:["$","section","8-Make programme fit specific without copying the website",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Make programme fit specific without copying the website"}],[["$","p","Programme fit is not a paragraph praising rankings, reputation or an international environment. Identify the modules, research groups, faculty expertise, facilities, practical projects or learning model that genuinely matter to your goal. Then explain the connection between each selected feature and your existing preparation or intended development.",{"children":"Programme fit is not a paragraph praising rankings, reputation or an international environment. Identify the modules, research groups, faculty expertise, facilities, practical projects or learning model that genuinely matter to your goal. Then explain the connection between each selected feature and your existing preparation or intended development."}],["$","p","For research programmes, mention faculty only when the alignment is real and current. Refer to a research area or method you understand rather than listing several famous names. For taught programmes, two or three well-explained features are usually stronger than a catalogue of modules.",{"children":"For research programmes, mention faculty only when the alignment is real and current. Refer to a research area or method you understand rather than listing several famous names. For taught programmes, two or three well-explained features are usually stronger than a catalogue of modules."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","9-Adapt the SOP for a scholarship",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"Adapt the SOP for a scholarship"}],[["$","p","A scholarship committee may assess more than admission readiness. Read its published criteria and connect your evidence to the qualities it actually values, which might include academic merit, leadership, service, development impact or a commitment to a particular sector. Do not insert generic claims about changing the world.",{"children":"A scholarship committee may assess more than admission readiness. Read its published criteria and connect your evidence to the qualities it actually values, which might include academic merit, leadership, service, development impact or a commitment to a particular sector. Do not insert generic claims about changing the world."}],["$","p","Explain what the funding would make possible, why the selected course is necessary and how the opportunity fits a realistic sequence of future steps. If the scholarship requires a separate leadership or impact essay, keep the SOP focused on academic purpose and programme fit instead of duplicating the other response.",{"children":"Explain what the funding would make possible, why the selected course is necessary and how the opportunity fits a realistic sequence of future steps. If the scholarship requires a separate leadership or impact essay, keep the SOP focused on academic purpose and programme fit instead of duplicating the other response."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","10-Address a study gap, low grade or career change briefly",{"className":"article-section","id":"section-11","children":[["$","h2",null,{"children":"Address a study gap, low grade or career change briefly"}],[["$","p","Include difficult context only when it helps the committee interpret the application or when the prompt asks for it. State the relevant fact without a long defence, explain the action you took and point to stronger recent evidence. The goal is clarity and recovery, not an appeal for sympathy.",{"children":"Include difficult context only when it helps the committee interpret the application or when the prompt asks for it. State the relevant fact without a long defence, explain the action you took and point to stronger recent evidence. The goal is clarity and recovery, not an appeal for sympathy."}],["$","p","For a career change, connect transferable skills and show the work already completed to test the new direction, such as a project, course, research activity or relevant responsibility. A convincing transition looks deliberate rather than sudden.",{"children":"For a career change, connect transferable skills and show the work already completed to test the new direction, such as a project, course, research activity or relevant responsibility. A convincing transition looks deliberate rather than sudden."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","11-An illustrative SOP paragraph",{"className":"article-section","id":"section-12","children":[["$","h2",null,{"children":"An illustrative SOP paragraph"}],[["$","p","The following short example demonstrates evidence and fit; it is not a template to copy: 'In my final-year project, I examined why a community solar installation produced irregular output despite stable equipment specifications. I cleaned twelve months of sensor records, compared weather-adjusted performance and traced the largest losses to inconsistent maintenance intervals. The project strengthened my statistical analysis skills, but it also showed me that technical optimisation must account for operational behaviour. I now want to study energy systems modelling and implementation, particularly through the programme's applied optimisation module and interdisciplinary energy lab.'",{"children":"The following short example demonstrates evidence and fit; it is not a template to copy: 'In my final-year project, I examined why a community solar installation produced irregular output despite stable equipment specifications. I cleaned twelve months of sensor records, compared weather-adjusted performance and traced the largest losses to inconsistent maintenance intervals. The project strengthened my statistical analysis skills, but it also showed me that technical optimisation must account for operational behaviour. I now want to study energy systems modelling and implementation, particularly through the programme's applied optimisation module and interdisciplinary energy lab.'"}],["$","p","Notice the sequence: a specific problem, the applicant's action, an outcome, reflection and a programme connection. Replace every element with your own evidence. Copied examples weaken authenticity and may violate an institution's application or AI-use rules.",{"children":"Notice the sequence: a specific problem, the applicant's action, an outcome, reflection and a programme connection. Replace every element with your own evidence. Copied examples weaken authenticity and may violate an institution's application or AI-use rules."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
27:["$","section","12-Common SOP mistakes",{"className":"article-section","id":"section-13","children":[["$","h2",null,{"children":"Common SOP mistakes"}],[["$","p","Most weak statements are not ruined by one dramatic error. They lose force through generic language, missing evidence and poor alignment with the prompt. Use the checks below before polishing individual sentences.",{"children":"Most weak statements are not ruined by one dramatic error. They lose force through generic language, missing evidence and poor alignment with the prompt. Use the checks below before polishing individual sentences."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Repeating the CV or transcript without interpretation",{"children":"Repeating the CV or transcript without interpretation"}],["$","li","Using one unchanged SOP for every university",{"children":"Using one unchanged SOP for every university"}],["$","li","Opening with quotations, definitions or exaggerated claims",{"children":"Opening with quotations, definitions or exaggerated claims"}],["$","li","Naming modules or professors without explaining the fit",{"children":"Naming modules or professors without explaining the fit"}],["$","li","Making claims about leadership or passion without evidence",{"children":"Making claims about leadership or passion without evidence"}],["$","li","Spending too many words on childhood or unrelated biography",{"children":"Spending too many words on childhood or unrelated biography"}],["$","li","Ignoring a required question or exceeding the official limit",{"children":"Ignoring a required question or exceeding the official limit"}],["$","li","Copying a sample, template or AI-generated draft without rebuilding it in your own voice",{"children":"Copying a sample, template or AI-generated draft without rebuilding it in your own voice"}]]}],"$undefined","$undefined"]}]
28:["$","section","13-Final editing checklist",{"className":"article-section","id":"section-14","children":[["$","h2",null,{"children":"Final editing checklist"}],[["$","p","Complete a content edit before a grammar edit. First check the argument, evidence and programme fit. Then improve transitions, remove repetition and correct language. Ask one reader who knows your field and another who does not to identify your main direction after a single reading.",{"children":"Complete a content edit before a grammar edit. First check the argument, evidence and programme fit. Then improve transitions, remove repetition and correct language. Ask one reader who knows your field and another who does not to identify your main direction after a single reading."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Every paragraph has one clear purpose",{"children":"Every paragraph has one clear purpose"}],["$","li","Every important claim is supported by evidence",{"children":"Every important claim is supported by evidence"}],["$","li","The programme name, course details and faculty references are accurate",{"children":"The programme name, course details and faculty references are accurate"}],["$","li","The opening and conclusion point in the same direction",{"children":"The opening and conclusion point in the same direction"}],["$","li","The statement answers every part of the prompt",{"children":"The statement answers every part of the prompt"}],["$","li","The final document meets the exact word and formatting limits",{"children":"The final document meets the exact word and formatting limits"}],["$","li","Spelling, dates, degree names and institution names are correct",{"children":"Spelling, dates, degree names and institution names are correct"}],["$","li","The final voice sounds like the applicant, not a generic template",{"children":"The final voice sounds like the applicant, not a generic template"}]]}],"$undefined","$undefined"]}]
29:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","How long should a statement of purpose be?",{"children":[["$","summary",null,{"children":["How long should a statement of purpose be?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Follow the programme's exact limit. Requirements vary widely: some applications use about 500 words, while others allow up to 1,000 words or provide separate short questions. Never exceed the stated word, character or page limit."}]]}],["$","details","What is the difference between an SOP and a personal statement?",{"children":[["$","summary",null,{"children":["What is the difference between an SOP and a personal statement?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"An SOP normally focuses on academic or professional preparation, interests, programme fit and future goals. A personal statement usually gives more space to background, experiences, values and community contribution. The application's own prompt is the final authority."}]]}],["$","details","Should I use the same SOP for every university?",{"children":[["$","summary",null,{"children":["Should I use the same SOP for every university?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"You can reuse a core account of your direction and strongest evidence, but the programme-fit section and any prompt-specific material must be rewritten. If changing only the university name still produces a plausible essay, the statement is too generic."}]]}],["$","details","Can I mention a low GPA or study gap in my SOP?",{"children":[["$","summary",null,{"children":["Can I mention a low GPA or study gap in my SOP?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes, when the context is relevant or requested. Explain it briefly, focus on the actions you took and support the explanation with stronger recent evidence. Do not allow the explanation to dominate the statement."}]]}],["$","details","Should a PhD SOP name potential supervisors?",{"children":[["$","summary",null,{"children":["Should a PhD SOP name potential supervisors?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Name potential supervisors only when their current research genuinely aligns with your interests and the programme encourages it. Explain the research connection rather than listing names, and verify that the faculty members are active in the relevant area."}]]}],["$","details","Can I use AI to write a statement of purpose?",{"children":[["$","summary",null,{"children":["Can I use AI to write a statement of purpose?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Check each institution's current AI and authorship policy. Tools may help with brainstorming or proofreading where permitted, but the evidence, reasoning and final voice must be your own. Never submit invented experiences or copied text."}]]}]]}]]}]
2a:["$","aside",null,{"className":"content-sidebar","children":[["$","div",null,{"className":"sidebar-card sidebar-card--contents","children":[["$","span",null,{"children":"On this page"}],["$","nav",null,{"aria-label":"Page contents","children":[["$","a","Build your SOP evidence outline",{"href":"#section-1","children":[["$","b",null,{"children":"01"}],"Build your SOP evidence outline"]}],["$","a","What a statement of purpose must prove",{"href":"#section-2","children":[["$","b",null,{"children":"02"}],"What a statement of purpose must prove"]}],["$","a","Read the exact prompt before choosing a format",{"href":"#section-3","children":[["$","b",null,{"children":"03"}],"Read the exact prompt before choosing a format"]}],["$","a","Statement of purpose, personal statement and motivation letter",{"href":"#section-4","children":[["$","b",null,{"children":"04"}],"Statement of purpose, personal statement and motivation letter"]}],["$","a","How a master's SOP differs from a PhD SOP",{"href":"#section-5","children":[["$","b",null,{"children":"05"}],"How a master's SOP differs from a PhD SOP"]}],["$","a","A reliable six-part SOP structure",{"href":"#section-6","children":[["$","b",null,{"children":"06"}],"A reliable six-part SOP structure"]}],["$","a","Write an opening that gives immediate direction",{"href":"#section-7","children":[["$","b",null,{"children":"07"}],"Write an opening that gives immediate direction"]}],["$","a","Turn experience into evidence",{"href":"#section-8","children":[["$","b",null,{"children":"08"}],"Turn experience into evidence"]}],["$","a","Make programme fit specific without copying the website",{"href":"#section-9","children":[["$","b",null,{"children":"09"}],"Make programme fit specific without copying the website"]}],["$","a","Adapt the SOP for a scholarship",{"href":"#section-10","children":[["$","b",null,{"children":"10"}],"Adapt the SOP for a scholarship"]}],["$","a","Address a study gap, low grade or career change briefly",{"href":"#section-11","children":[["$","b",null,{"children":"11"}],"Address a study gap, low grade or career change briefly"]}],["$","a","An illustrative SOP paragraph",{"href":"#section-12","children":[["$","b",null,{"children":"12"}],"An illustrative SOP paragraph"]}],["$","a","Common SOP mistakes",{"href":"#section-13","children":[["$","b",null,{"children":"13"}],"Common SOP mistakes"]}],["$","a","Final editing checklist",{"href":"#section-14","children":[["$","b",null,{"children":"14"}],"Final editing checklist"]}]]}]]}],["$","div",null,{"className":"sidebar-card","children":[["$","h2",null,{"children":"Next useful step"}],[["$","$L4","guides/motivation-letter",{"href":"/guides/motivation-letter/","children":["How to write a scholarship motivation letter"," ",["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/scholarship-application",{"href":"/guides/scholarship-application/","children":["How to apply for international scholarships step by step"," ",["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]]}]]}]
