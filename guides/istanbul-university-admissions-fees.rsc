2a:["$","section","3-Read the fee table without doubling the wrong amount",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Read the fee table without doubling the wrong amount"}],[["$","p","The schedule states that half of the annual tuition is paid in fall and half in spring. It also says preparation students pay the fee set for their registered faculty/school/institute. Open/distance-education and other rows must be kept separate from a campus first-education degree.",{"children":"The schedule states that half of the annual tuition is paid in fall and half in spring. It also says preparation students pay the fee set for their registered faculty/school/institute. Open/distance-education and other rows must be kept separate from a campus first-education degree."}],["$","p","Worked example: the Faculty of Science row is TRY 166,635 annually. Two semester payments of TRY 83,317.50 already produce that annual amount. Multiplying the annual figure by two would double-count tuition. Add accommodation and other expenses separately.",{"children":"Worked example: the Faculty of Science row is TRY 166,635 annually. Two semester payments of TRY 83,317.50 already produce that annual amount. Multiplying the annual figure by two would double-count tuition. Add accommodation and other expenses separately."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://cdn.istanbul.edu.tr/FileHandler2.ashx?f=ogrenim_ucretleri_2026-2027.pdf",{"children":["",["$","a",null,{"href":"https://cdn.istanbul.edu.tr/FileHandler2.ashx?f=ogrenim_ucretleri_2026-2027.pdf","target":"_blank","rel":"noreferrer","children":"Istanbul fee-schedule notes"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Read the fee table without doubling the wrong amount","children":[["$","$L4","/guides/turkey-university-tuition-fees/",{"href":"/guides/turkey-university-tuition-fees/","children":["Compare Turkey tuition fees",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2b:["$","section","4-Language and document checks before accepting",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Language and document checks before accepting"}],[["$","p","Use the exact programme language and the faculty’s registration instructions. Do not infer that a degree is taught in English because the university has an English admissions page. If a preparation route is required, include its time and tuition treatment in the plan.",{"children":"Use the exact programme language and the faculty’s registration instructions. Do not infer that a degree is taught in English because the university has an English admissions page. If a preparation route is required, include its time and tuition treatment in the plan."}],["$","p","Build two document sets: the evidence used for application evaluation and the originals or equivalence evidence needed for final registration. Confirm the delivery deadline for any missing final diploma. School-level MEB Denklik and university admission are separate processes.",{"children":"Build two document sets: the evidence used for application evaluation and the originals or equivalence evidence needed for final registration. Confirm the delivery deadline for any missing final diploma. School-level MEB Denklik and university admission are separate processes."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Language and document checks before accepting","children":[["$","$L4","/guides/turkey-university-admission-requirements/",{"href":"/guides/turkey-university-admission-requirements/","children":["Admission documents and school Denklik",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2c:["$","section","5-An Istanbul offer needs a campus-specific living plan",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"An Istanbul offer needs a campus-specific living plan"}],[["$","p","Record where your faculty teaches, then compare actual room locations and travel routes. The cost of living near a different university in Istanbul is not automatically a good budget for your programme.",{"children":"Record where your faculty teaches, then compare actual room locations and travel routes. The cost of living near a different university in Istanbul is not automatically a good budget for your programme."}],["$","p","Original example: two rooms have the same monthly price, but one requires a long transfer-heavy commute and does not issue acceptable residence-address evidence. The cheaper-looking contract may create both travel and registration problems. Check these conditions before reserving.",{"children":"Original example: two rooms have the same monthly price, but one requires a long transfer-heavy commute and does not issue acceptable residence-address evidence. The cheaper-looking contract may create both travel and registration problems. Check these conditions before reserving."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for An Istanbul offer needs a campus-specific living plan","children":[["$","$L4","/guides/student-accommodation-turkey/",{"href":"/guides/student-accommodation-turkey/","children":["Accommodation and address evidence",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/cost-of-living-in-turkey-for-students/",{"href":"/guides/cost-of-living-in-turkey-for-students/","children":["Istanbul versus Ankara planning",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/turkey-student-visa-requirements/",{"href":"/guides/turkey-student-visa-requirements/","children":["Visa and entry documents",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2d:["$","section","6-Your Istanbul University application checklist",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Your Istanbul University application checklist"}],[["$","p","Keep every number attached to its year and source. If a page cannot be retrieved, ask the university for the current call instead of substituting a commercial estimate.",{"children":"Keep every number attached to its year and source. If a page cannot be retrieved, ask the university for the current call instead of substituting a commercial estimate."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2e",null,{"id":"guides/istanbul-university-admissions-fees:section-7","title":"Check your progress","items":["My institution is Istanbul University, not Cerrahpaşa or ITU.","I have the correct degree, language and faculty.","My qualification is accepted in the named call.","My fee row matches the programme type and academic year.","I have a plan for final documents, housing and arrival."]}],"$undefined","$undefined"]}]
