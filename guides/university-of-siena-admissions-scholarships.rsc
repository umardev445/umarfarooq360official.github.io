19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Siena requires programme-specific admission steps and publishes the application fee in its application system. DSU Toscana and named scholarships have separate conditions; paying an application fee does not guarantee a visa."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose your degree on the official application portal and record its fee, selection conditions and intake before submitting."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Choose the programme and use the official application system",{"href":"#section-1","children":"Choose the programme and use the official application system"}],["$","a","Application fee: a small administrative detail that can block submission",{"href":"#section-2","children":"Application fee: a small administrative detail that can block submission"}],["$","a","Application, enrolment and visa are not the same approval",{"href":"#section-3","children":"Application, enrolment and visa are not the same approval"}],["$","a","DSU Toscana and named scholarship routes",{"href":"#section-4","children":"DSU Toscana and named scholarship routes"}],["$","a","Tuition calculation and a useful Siena budget",{"href":"#section-5","children":"Tuition calculation and a useful Siena budget"}],["$","a","Your final pre-submission review",{"href":"#section-6","children":"Your final pre-submission review"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Choose the programme and use the official application system",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Choose the programme and use the official application system"}],[["$","p","Start from the University of Siena international admissions site and follow its link to apply.unisi.it. Confirm the teaching language, degree level and current intake. Use the programme record to find academic preparation and document requirements.",{"children":"Start from the University of Siena international admissions site and follow its link to apply.unisi.it. Confirm the teaching language, degree level and current intake. Use the programme record to find academic preparation and document requirements."}],["$","p","If you are unsure whether your previous degree fits a master’s course, compare its subject requirements with your transcript. Prepare the requested academic evidence rather than relying only on a degree title that sounds similar.",{"children":"If you are unsure whether your previous degree fits a master’s course, compare its subject requirements with your transcript. Prepare the requested academic evidence rather than relying only on a degree title that sounds similar."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","1-Application fee: a small administrative detail that can block submission",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Application fee: a small administrative detail that can block submission"}],["$L1b","$L1c"],"$undefined","$undefined","$undefined","$L1d","$undefined","$undefined","$L1e","$undefined"]}],"$L1f","$L20","$L21","$L22"]}],false,"$L23","$L24"]}],"$L25"]}]
1a:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","scholarships/dsu-toscana",{"href":"/scholarships/dsu-toscana/","children":[["$","span",null,{"children":"Italy study pathway"}],["$","h3",null,{"children":"DSU Toscana scholarship: documents, renewal and application"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/university-of-pisa-admissions-scholarships",{"href":"/guides/university-of-pisa-admissions-scholarships/","children":[["$","span",null,{"children":"Italy study pathway"}],["$","h3",null,{"children":"University of Pisa admissions, DSU scholarships and fees"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/university-of-florence-admissions-scholarships",{"href":"/guides/university-of-florence-admissions-scholarships/","children":[["$","span",null,{"children":"Italy study pathway"}],["$","h3",null,{"children":"University of Florence admissions and scholarship routes"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/italy-universities-tuition-fees",{"href":"/guides/italy-universities-tuition-fees/","children":[["$","span",null,{"children":"University cost comparison"}],["$","h3",null,{"children":"Italian universities and tuition fees for international students"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]