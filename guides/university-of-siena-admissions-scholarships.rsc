1b:["$","p","Siena’s admission-fee page says that each programme has an application charge shown in the application system, and the fee is non-refundable. The page allows up to three admission applications; check the current portal instructions before using that limit.",{"children":"Siena’s admission-fee page says that each programme has an application charge shown in the application system, and the fee is non-refundable. The page allows up to three admission applications; check the current portal instructions before using that limit."}]
1c:["$","p","The university warns that payment processing can take up to two hours. Do not leave the payment until the closing minutes. Save the transaction and confirm that the application system recognises it. A card charge alone is not proof that the application was submitted successfully.",{"children":"The university warns that payment processing can take up to two hours. Do not leave the payment until the closing minutes. Save the transaction and confirm that the application system recognises it. A card charge alone is not proof that the application was submitted successfully."}]
1d:["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"If your deadline is in the evening, submit and check the payment status earlier rather than planning to pay a few minutes before closure. Keep both the payment receipt and final application confirmation."}]]}]
1e:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://admission.unisi.it/?p=1204",{"children":["",["$","a",null,{"href":"https://admission.unisi.it/?p=1204","target":"_blank","rel":"noreferrer","children":"Siena admission and enrolment fees"}]]}]]]}]
1f:["$","section","2-Application, enrolment and visa are not the same approval",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Application, enrolment and visa are not the same approval"}],[["$","p","An academic offer can still require completion of enrolment, final qualification evidence or payment. If you need a visa, follow the university’s pre-enrolment and consular instructions as a separate track.",{"children":"An academic offer can still require completion of enrolment, final qualification evidence or payment. If you need a visa, follow the university’s pre-enrolment and consular instructions as a separate track."}],["$","p","Siena explicitly states that paying the admission fee creates no guarantee or right relating to a visa. Use that distinction when planning travel and housing. Request guidance if the programme schedule and visa appointment cannot be reconciled, instead of assuming a payment protects your place.",{"children":"Siena explicitly states that paying the admission fee creates no guarantee or right relating to a visa. Use that distinction when planning travel and housing. Request guidance if the programme schedule and visa appointment cannot be reconciled, instead of assuming a payment protects your place."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Keep four separate statuses","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Keep four separate statuses"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Stage",{"scope":"col","children":"Stage"}],["$","th","What it establishes",{"scope":"col","children":"What it establishes"}],["$","th","What remains separate",{"scope":"col","children":"What remains separate"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Application submitted"}],["$","td","1",{"children":"Your file entered the selection route"}],["$","td","2",{"children":"Admission result"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Academic offer"}],["$","td","1",{"children":"A place subject to its conditions"}],["$","td","2",{"children":"Enrolment and qualification checks"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Funding award"}],["$","td","1",{"children":"Support under the named call"}],["$","td","2",{"children":"Visa and payment timing"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Visa decision"}],["$","td","1",{"children":"Permission under the mission’s decision"}],["$","td","2",{"children":"Final university registration and arrival tasks"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","3-DSU Toscana and named scholarship routes",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"DSU Toscana and named scholarship routes"}],[["$","p","The Siena funding page directs students to DSU Toscana for regional benefits based on income and merit. Accommodation is subject to availability. Prepare the regional financial file using the DSU instructions rather than the admission document list.",{"children":"The Siena funding page directs students to DSU Toscana for regional benefits based on income and merit. Accommodation is subject to availability. Prepare the regional financial file using the DSU instructions rather than the admission document list."}],["$","p","Other funding mentioned by the university, including government or partner programmes, can restrict subjects and eligible countries. Compare your profile against the current call before treating a named award as an option. A university funding overview is a starting directory, not an award confirmation.",{"children":"Other funding mentioned by the university, including government or partner programmes, can restrict subjects and eligible countries. Compare your profile against the current call before treating a named award as an option. A university funding overview is a starting directory, not an award confirmation."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for DSU Toscana and named scholarship routes","children":[["$","$L4","/scholarships/dsu-toscana/",{"href":"/scholarships/dsu-toscana/","children":["DSU Toscana: first application and renewal",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/italy/",{"href":"/scholarships/italy/","children":["Italy scholarship routes",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
21:["$","section","4-Tuition calculation and a useful Siena budget",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Tuition calculation and a useful Siena budget"}],[["$","p","The admissions site links a university tuition simulator. Use the current tool and fee rules for your circumstances; do not confuse the admission application fee with the annual tuition amount or the first enrolment instalment.",{"children":"The admissions site links a university tuition simulator. Use the current tool and fee rules for your circumstances; do not confuse the admission application fee with the annual tuition amount or the first enrolment instalment."}],["$","p","Prepare the financial evidence required for any reduction and record when it must be submitted. Add accommodation, deposit, transport and document costs to the fee estimate. Keep a separate cash-flow line for expenses due before a scholarship payment.",{"children":"Prepare the financial evidence required for any reduction and record when it must be submitted. Add accommodation, deposit, transport and document costs to the fee estimate. Keep a separate cash-flow line for expenses due before a scholarship payment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Tuition calculation and a useful Siena budget","children":[["$","$L4","/guides/italy-universities-tuition-fees/",{"href":"/guides/italy-universities-tuition-fees/","children":["Compare Italy tuition rules",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Estimate an Italy study budget",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
22:["$","section","5-Your final pre-submission review",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Your final pre-submission review"}],[["$","p","Read the programme file as if you were the reviewer: is every mandatory document present, readable and assigned to the right field? Check names, the qualification date, the grading scale and the teaching-language evidence. An unrelated certificate does not repair a missing required item.",{"children":"Read the programme file as if you were the reviewer: is every mandatory document present, readable and assigned to the right field? Check names, the qualification date, the grading scale and the teaching-language evidence. An unrelated certificate does not repair a missing required item."}],["$","p","After submission, retain the final file and use the official portal or university messages to track the result. If selected, follow the offer’s next steps rather than assuming your admission account also handles funding and the visa.",{"children":"After submission, retain the final file and use the official portal or university messages to track the result. If selected, follow the offer’s next steps rather than assuming your admission account also handles funding and the visa."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L26",null,{"id":"guides/university-of-siena-admissions-scholarships:section-6","title":"Check your progress","items":["Programme, language and intake confirmed","Required evidence uploaded in the right fields","Fee paid with time for processing","Final submission confirmation saved","DSU and visa tasks tracked independently"]}],"$undefined","$undefined"]}]
