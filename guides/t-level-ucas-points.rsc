1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide student-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/guides/t-level-ucas-points/\",\"name\":\"T Level UCAS points: full awards and partial achievement\",\"description\":\"See full T Level UCAS points, understand the two Pass bands, and follow the official route for partial achievement and university acceptance checks.\",\"url\":\"https://aspirecompass.org/guides/t-level-ucas-points/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"T Level UCAS points: full awards and partial achievement\",\"item\":\"https://aspirecompass.org/guides/t-level-ucas-points/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"T Level UCAS points: full awards and partial achievement\",\"description\":\"See full T Level UCAS points, understand the two Pass bands, and follow the official route for partial achievement and university acceptance checks.\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"