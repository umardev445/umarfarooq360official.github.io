1e:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[null,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"A full T Level carries 168 points at Distinction*, 144 at Distinction, 120 at Merit, and either 96 or 72 at Pass depending on the core grade. Partial achievement needs a separate official lookup."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Confirm whether your record is a full T Level or partial achievement, then read the course requirements for the named subject and result."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Full T Level points by overall grade",{"href":"#section-1","children":"Full T Level points by overall grade"}],["$","a","Why Pass can mean 96 or 72",{"href":"#section-2","children":"Why Pass can mean 96 or 72"}],["$","a","Partial achievement is a different lookup",{"href":"#section-3","children":"Partial achievement is a different lookup"}],["$","a","Tariff comparison does not decide university acceptance",{"href":"#section-4","children":"Tariff comparison does not decide university acceptance"}],["$","a","Use the next step that matches your situation",{"href":"#section-5","children":"Use the next step that matches your situation"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Full T Level points by overall grade",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Full T Level points by overall grade"}],[["$","p","The Department for Education lists the full-award tariff below. A Pass with core C or above has a different value from a Pass with core D or E. The core grade therefore matters even when two results both say Pass.",{"children":"The Department for Education lists the full-award tariff below. A Pass with core C or above has a different value from a Pass with core D or E. The core grade therefore matters even when two results both say Pass."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Full T Level overall grade and tariff","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Full T Level overall grade and tariff"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Overall result",{"scope":"col","children":"Overall result"}],["$","th","UCAS points",{"scope":"col","children":"UCAS points"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Distinction*"}],["$","td","1",{"children":"168"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Distinction"}],["$","td","1",{"children":"144"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Merit"}],["$","td","1",{"children":"120"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Pass: core C or above"}],["$","td","1",{"children":"96"}]],"$undefined"]}],["$","tr","4