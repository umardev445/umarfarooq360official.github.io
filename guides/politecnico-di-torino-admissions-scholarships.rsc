1c:["$","p","On 20 October 2026, the first two published calls have ended. The listed November call is upcoming and restricted; it is not a general invitation for all international applicants or all degrees.",{"children":"On 20 October 2026, the first two published calls have ended. The listed November call is upcoming and restricted; it is not a general invitation for all international applicants or all degrees."}]
1d:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Selected facts from the checked 2026/27 master’s route","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Selected facts from the checked 2026/27 master’s route"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Item",{"scope":"col","children":"Item"}],["$","th","Published detail",{"scope":"col","children":"Published detail"}],["$","th","Meaning",{"scope":"col","children":"Meaning"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Application fee"}],["$","td","1",{"children":"€50, non-refundable"}],["$","td","2",{"children":"Specific to the checked master’s procedure"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Later call"}],["$","td","1",{"children":"3–17 November 2026; closing 14:00 Italian time"}],["$","td","2",{"children":"Only the listed applicant groups and programmes"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Visa pre-enrolment"}],["$","td","1",{"children":"Separate Universitaly process"}],["$","td","2",{"children":"Eligibility confirmation is not a substitute"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"New academic cycle"}],["$","td","1",{"children":"Check the newly published notice"}],["$","td","2",{"children":"Do not roll a past date forward"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://www.polito.it/en/education/applying-studying-graduating/admissions-and-enrolment/master-s-degree-programmes/applicants-with-a-non-italian-qualification","target":"_blank","rel":"noreferrer","children":"Official guidance"}]]}]]
1e:["$","section","1-Choose degree, programme and qualification route",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Choose degree, programme and qualification route"}],[["$","p","Start from the official prospective-student entry point, then select bachelor’s or master’s instructions. Engineering, architecture and design applications can require different evidence and assessments. The master’s instructions for a non-Italian qualification are not a bachelor’s entrance-test guide.",{"children":"Start from the official prospective-student entry point, then select bachelor’s or master’s instructions. Engineering, architecture and design applications can require different evidence and assessments. The master’s instructions for a non-Italian qualification are not a bachelor’s entrance-test guide."}],["$","p","Read the curriculum requirement alongside your transcript. For a technical master’s, identify relevant subject preparation and any additional assessment requested by the course. For design-related study, check whether a portfolio is required. A strong academic record is useful, but it cannot replace a missing compulsory prerequisite.",{"children":"Read the curriculum requirement alongside your transcript. For a technical master’s, identify relevant subject preparation and any additional assessment requested by the course. For design-related study, check whether a portfolio is required. A strong academic record is useful, but it cannot replace a missing compulsory prerequisite."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.polito.it/en/education/international-students/prospective-students",{"children":["",["$","a",null,{"href":"https://www.polito.it/en/education/international-students/prospective-students","target":"_blank","rel":"noreferrer","children":"PoliTO prospective-student routes"}]]}]]]}],"$undefined"]}]
1f:["$","section","2-Language and documents: confirm the programme-specific evidence",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Language and documents: confirm the programme-specific evidence"}],[["$","p","Record the required teaching language and accepted proof for the selected programme. Do not apply one internet IELTS score to every course. Where exemptions exist, use the stated evidence and submit it in the required form; studying in English previously is not automatically an exemption.",{"children":"Record the required teaching language and accepted proof for the selected programme. Do not apply one internet IELTS score to every course. Where exemptions exist, use the stated evidence and submit it in the required form; studying in English previously is not automatically an exemption."}],["$","p","Organise the qualification, transcript, required academic details and programme-specific materials before starting the application. Pay attention to the distinction between the university’s academic documentation and any extra documents requested by the consular authority later. Keep both tasks visible without claiming that every applicant must buy the same recognition document at the same stage.",{"children":"Organise the qualification, transcript, required academic details and programme-specific materials before starting the application. Pay attention to the distinction between the university’s academic documentation and any extra documents requested by the consular authority later. Keep both tasks visible without claiming that every applicant must buy the same recognition document at the same stage."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.polito.it/en/education/applying-studying-graduating/admissions-and-enrolment/master-s-degree-programmes/applicants-with-a-non-italian-qualification",{"children":["",["$","a",null,{"href":"https://www.polito.it/en/education/applying-studying-graduating/admissions-and-enrolment/master-s-degree-programmes/applicants-with-a-non-italian-qualification","target":"_blank","rel":"noreferrer","children":"Official requirements and documentation"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Language and documents: confirm the programme-specific evidence","children":[["$","$L4","/guides/study-in-italy-admission-english-requirements/",{"href":"/guides/study-in-italy-admission-english-requirements/","children":["Italy English requirements explained",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/cimea-vs-declaration-of-value-italy/",{"href":"/guides/cimea-vs-declaration-of-value-italy/","children":["Recognition document comparison",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
20:["$","section","3-Apply@PoliTO: payment and final submission are separate checks",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Apply@PoliTO: payment and final submission are separate checks"}],[["$","p","The checked master’s guidance states a €50 non-refundable fee and directs candidates to confirm submission in the application system. Make time for both payment and the final submission step. A payment confirmation alone is not the same evidence as a submitted application.",{"children":"The checked master’s guidance states a €50 non-refundable fee and directs candidates to confirm submission in the application system. Make time for both payment and the final submission step. A payment confirmation alone is not the same evidence as a submitted application."}],["$","p","If a payment behaves unexpectedly, check the official payment instructions and whether the first transaction was processed before trying repeatedly. Retain the application record and receipt together. After submission, monitor the relevant evaluation area and use the official support route if a required file or status is unclear.",{"children":"If a payment behaves unexpectedly, check the official payment instructions and whether the first transaction was processed before trying repeatedly. Retain the application record and receipt together. After submission, monitor the relevant evaluation area and use the official support route if a required file or status is unclear."}]],["$","ol",null,{"className":"process-steps","aria-label":"Apply@PoliTO: payment and final submission are separate checks","children":[["$","li","Confirm the correct call and course.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Confirm the correct call and course."}]]}],["$","li","Prepare and upload the required evidence.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Prepare and upload the required evidence."}]]}],["$","li","Complete payment using the official instructions.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Complete payment using the official instructions."}]]}],["$","li","Confirm the final submission in Apply@PoliTO.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Confirm the final submission in Apply@PoliTO."}]]}],["$","li","Save the receipt and inspect evaluation messages.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Save the receipt and inspect evaluation messages."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.polito.it/en/education/applying-studying-graduating/admissions-and-enrolment/master-s-degree-programmes/applicants-with-a-non-italian-qualification",{"children":["",["$","a",null,{"href":"https://www.polito.it/en/education/applying-studying-graduating/admissions-and-enrolment/master-s-degree-programmes/applicants-with-a-non-italian-qualification","target":"_blank","rel":"noreferrer","children":"Application fee, submission and evaluation instructions"}]]}]]]}],"$undefined"]}]
21:["$","section","4-Turn the admission result into a next action",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Turn the admission result into a next action"}],[["$","p","An eligible result, a conditional offer and a negative decision have different consequences. If your degree is incomplete, identify what must be supplied before final enrolment. Do not assume an offer can be carried to another academic year without checking the institution’s deferral rule.",{"children":"An eligible result, a conditional offer and a negative decision have different consequences. If your degree is incomplete, identify what must be supplied before final enrolment. Do not assume an offer can be carried to another academic year without checking the institution’s deferral rule."}],["$","p","When a result is negative, read whether the issue is missing basic requirements or academic/curricular suitability. The remedy can differ, and a new upload is not always accepted after evaluation. A precise question citing your application and the university’s result wording is more useful than asking an unofficial adviser to predict admission.",{"children":"When a result is negative, read whether the issue is missing basic requirements or academic/curricular suitability. The remedy can differ, and a new upload is not always accepted after evaluation. A precise question citing your application and the university’s result wording is more useful than asking an unofficial adviser to predict admission."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Read the result with the official action beside it","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Read the result with the official action beside it"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Result type",{"scope":"col","children":"Result type"}],["$","th","Practical next question",{"scope":"col","children":"Practical next question"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Eligible"}],["$","td","1",{"children":"Which offer confirmation and enrolment actions remain?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Conditional"}],["$","td","1",{"children":"Which final qualification or evidence must arrive, and by when?"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Not eligible"}],["$","td","1",{"children":"What reason is given and what procedure is actually permitted?"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Funding nomination"}],["$","td","1",{"children":"Has a separate final funding decision been made?"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://www.polito.it/en/education/applying-studying-graduating/admissions-and-enrolment/master-s-degree-programmes/applicants-with-a-non-italian-qualification","target":"_blank","rel":"noreferrer","children":"Official guidance"}]]}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","5-Funding: compare university awards with EDISU Piemonte",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Funding: compare university awards with EDISU Piemonte"}],[["$","p","PoliTO publishes scholarship and award opportunities with different target groups. A scholarship for a particular programme, nationality or project is not an entitlement for all international students. Check the named call before using an amount in your budget.",{"children":"PoliTO publishes scholarship and award opportunities with different target groups. A scholarship for a particular programme, nationality or project is not an entitlement for all international students. Check the named call before using an amount in your budget."}],["$","p","EDISU Piemonte is a separate regional application with economic, academic and enrolment rules. Keep the university award and EDISU on different tracker rows. For either route, record coverage, application deadline, acceptance conditions and whether support arrives as cash, a service or a fee adjustment.",{"children":"EDISU Piemonte is a separate regional application with economic, academic and enrolment rules. Keep the university award and EDISU on different tracker rows. For either route, record coverage, application deadline, acceptance conditions and whether support arrives as cash, a service or a fee adjustment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.polito.it/en/education/services-and-life-at-politecnico/right-to-education-and-tuition-fees/scholarships-and-awards",{"children":["",["$","a",null,{"href":"https://www.polito.it/en/education/services-and-life-at-politecnico/right-to-education-and-tuition-fees/scholarships-and-awards","target":"_blank","rel":"noreferrer","children":"PoliTO scholarship and award notices"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Funding: compare university awards with EDISU Piemonte","children":[["$","$L4","/scholarships/edisu-piemonte/",{"href":"/scholarships/edisu-piemonte/","children":["EDISU Piemonte documents and housing",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/italy/",{"href":"/scholarships/italy/","children":["Compare Italy funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
23:["$","section","6-After eligibility: Universitaly and final enrolment",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"After eligibility: Universitaly and final enrolment"}],[["$","p","For relevant non-EU applicants abroad, the university requires the separate pre-enrolment route on Universitaly. The official guidance states that admission does not guarantee a visa. Read the final enrolment requirements as well; travelling to Italy does not complete the academic administration.",{"children":"For relevant non-EU applicants abroad, the university requires the separate pre-enrolment route on Universitaly. The official guidance states that admission does not guarantee a visa. Read the final enrolment requirements as well; travelling to Italy does not complete the academic administration."}],["$","p","Keep a post-offer list containing the final degree evidence, qualification checks, pre-enrolment, competent consular procedure and university enrolment actions. Use the exact dates attached to your call and applicant group. Another student’s deadline, even for the same university, may not be yours.",{"children":"Keep a post-offer list containing the final degree evidence, qualification checks, pre-enrolment, competent consular procedure and university enrolment actions. Use the exact dates attached to your call and applicant group. Another student’s deadline, even for the same university, may not be yours."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L27",null,{"id":"guides/politecnico-di-torino-admissions-scholarships:section-7","title":"Check your progress","items":["Call available to my applicant category.","Academic and language requirements checked.","Payment and final submission both confirmed.","Funding tracked independently.","Offer conditions and pre-enrolment tasks understood.","Tuition and initial living costs budgeted."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for After eligibility: Universitaly and final enrolment","children":[["$","$L4","/guides/universitaly-pre-enrolment/",{"href":"/guides/universitaly-pre-enrolment/","children":["Universitaly guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Italy cost calculator",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
24:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://www.polito.it/en/education/applying-studying-graduating/admissions-and-enrolment/master-s-degree-programmes/applicants-with-a-non-italian-qualification",{"href":"https://www.polito.it/en/education/applying-studying-graduating/admissions-and-enrolment/master-s-degree-programmes/applicants-with-a-non-italian-qualification","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Master’s route for non-Italian qualifications"}],["$","span",null,{"children":"Checked 20 October 2026; the named programme and cycle control the rule."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://www.polito.it/en/education/international-students/prospective-students",{"href":"https://www.polito.it/en/education/international-students/prospective-students","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Prospective student entry point"}],["$","span",null,{"children":"Checked 20 October 2026; the named programme and cycle control the rule."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$24:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https: