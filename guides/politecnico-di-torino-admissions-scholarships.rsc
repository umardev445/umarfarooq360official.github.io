25:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is the November PoliTO call open to all international applicants?",{"children":[["$","summary",null,{"children":["Is the November PoliTO call open to all international applicants?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The checked 2026/27 master’s page restricts that call to the specified EU/resident applicant groups and listed programmes. Check your category before relying on it."}]]}],["$","details","What application fee does the checked master’s page state?",{"children":[["$","summary",null,{"children":["What application fee does the checked master’s page state?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"It states a €50 non-refundable fee. This should not be copied onto exchange or bachelor’s routes without checking their separate instructions."}]]}],["$","details","Does an eligible result guarantee funding?",{"children":[["$","summary",null,{"children":["Does an eligible result guarantee funding?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Academic admission, scholarship selection and regional EDISU benefits are separate decisions."}]]}],["$","details","Is PoliTO the same as Politecnico di Milano?",{"children":[["$","summary",null,{"children":["Is PoliTO the same as Politecnico di Milano?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Politecnico di Torino is in Turin and Politecnico di Milano is a different institution. Use the correct university portal and programme call."}]]}]]}]]}]
