27:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-How funding works in the United States",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"How funding works in the United States"}],[["$","p","Undergraduate aid may be need-based, merit-based or a combination, while doctoral admission commonly includes a departmental funding package. Many professional master's degrees expect students to combine partial scholarships, savings and external funding.",{"children":"Undergraduate aid may be need-based, merit-based or a combination, while doctoral admission commonly includes a departmental funding package. Many professional master's degrees expect students to combine partial scholarships, savings and external funding."}],["$","p","International applicants should distinguish a university admission deadline from a priority funding deadline. For Fulbright, application and placement rules are managed by the commission or U.S. embassy serving your home country.",{"children":"International applicants should distinguish a university admission deadline from a priority funding deadline. For Fulbright, application and placement rules are managed by the commission or U.S. embassy serving your home country."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Use each university's international financial-aid page",{"children":"Use each university's international financial-aid page"}],["$","li","Check assistantship and tuition-remission terms",{"children":"Check assistantship and tuition-remission terms"}],["$","li","Submit tests early enough for score delivery",{"children":"Submit tests early enough for score delivery"}],["$","li","Budget health insurance and campus fees",{"children":"Budget health insurance and campus fees"}],["$","li","Confirm whether funding is renewable",{"children":"Confirm whether funding is renewable"}]]}],"$undefined","$undefined","$undefined"]}],["$","section","2-Calculate the funding gap before applying",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Calculate the funding gap before applying"}],[["$","p","Compare tuition, mandatory fees, health insurance, housing, food, travel, visa-related costs and the timing of the first payment. A tuition award can still leave a large living-cost gap.",{"children":"Compare tuition, mandatory fees, health insurance, housing, food, travel, visa-related costs and the timing of the first payment. A tuition award can still leave a large living-cost gap."}],["$","p","Ask whether funding is guaranteed for the full programme, renewable subject to performance, or dependent on a separate job appointment. Keep the written offer and funding conditions together.",{"children":"Ask whether funding is guaranteed for the full programme, renewable subject to performance, or dependent on a separate job appointment. Keep the written offer and funding conditions together."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Plan a two-track US application",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Plan a two-track US application"}],[["$","p","Build one shortlist of universities where admission is academically realistic and another of funding routes attached to those universities. Note test requirements, transcript evaluation, financial forms, assistantship deadlines and whether the department admits before considering funding.",{"children":"Build one shortlist of universities where admission is academically realistic and another of funding routes attached to those universities. Note test requirements, transcript evaluation, financial forms, assistantship deadlines and whether the department admits before considering funding."}],"$L2c"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L2d","$L2e","$L2f","$L30","$L31"]}]
