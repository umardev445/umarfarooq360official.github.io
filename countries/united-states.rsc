2c:["$","p","Submit the strongest-fit applications rather than relying on a single famous institution. Official university pages are the final source for current admission and aid decisions.",{"children":"Submit the strongest-fit applications rather than relying on a single famous institution. Official university pages are the final source for current admission and aid decisions."}]
2d:["$","section","4-Undergraduate, professional master’s and research funding differ",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Undergraduate, professional master’s and research funding differ"}],[["$","p","A US funding search needs a degree-specific strategy. At undergraduate level, investigate each institution’s international aid and merit policies. For a master’s degree, check the department, graduate school and external award routes. For a doctorate, inspect the written funding package, not only the admissions headline.",{"children":"A US funding search needs a degree-specific strategy. At undergraduate level, investigate each institution’s international aid and merit policies. For a master’s degree, check the department, graduate school and external award routes. For a doctorate, inspect the written funding package, not only the admissions headline."}],["$","p","Fulbright’s Foreign Student Program directs applicants through the process serving their home country. It is not a single worldwide deadline. University aid, assistantships and external scholarships have their own conditions and decision owners.",{"children":"Fulbright’s Foreign Student Program directs applicants through the process serving their home country. It is not a single worldwide deadline. University aid, assistantships and external scholarships have their own conditions and decision owners."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Choose the right funding question","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Choose the right funding question"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Study route",{"scope":"col","children":"Study route"}],["$","th","Where to research",{"scope":"col","children":"Where to research"}],["$","th","What to verify",{"scope":"col","children":"What to verify"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Undergraduate"}],["$","td","1",{"children":"University international admissions and aid"}],["$","td","2",{"children":"Required forms, aid eligibility and renewal"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Professional master’s"}],["$","td","1",{"children":"Programme and university funding pages"}],["$","td","2",{"children":"Partial support, total fees and personal gap"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Research master’s or PhD"}],["$","td","1",{"children":"Department and graduate faculty"}],["$","td","2",{"children":"Stipend, fee coverage, duration and duties"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"External award"}],["$","td","1",{"children":"Official programme and home-country process"}],["$","td","2",{"children":"Placement, programme rules and dates"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2e:["$","section","5-Read a funding package as several components",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Read a funding package as several components"}],[["$","p","Ask whether tuition is fully remitted, which mandatory fees remain, whether health insurance is included and how the stipend is paid. If teaching or research work forms part of the package, read the appointment, hours, eligibility and renewal conditions.",{"children":"Ask whether tuition is fully remitted, which mandatory fees remain, whether health insurance is included and how the stipend is paid. If teaching or research work forms part of the package, read the appointment, hours, eligibility and renewal conditions."}],["$","p","A total that includes a job can change if the appointment ends or the terms change. A multi-year offer may still require academic progress or other conditions. Save the official offer and ask the department to explain any ambiguous component before accepting.",{"children":"A total that includes a job can change if the appointment ends or the terms change. A multi-year offer may still require academic progress or other conditions. Save the official offer and ask the department to explain any ambiguous component before accepting."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2f:["$","section","6-Worked example: compare net funding rather than headline amounts",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Worked example: compare net funding rather than headline amounts"}],[["$","p","Suppose fictional offer A provides 24,000 units of annual support but leaves 6,000 in tuition and compulsory charges. Its net support is 18,000 before living costs. Offer B provides 21,000 and separately covers those academic charges, leaving 21,000 before living costs. The larger headline is not necessarily the larger usable budget.",{"children":"Suppose fictional offer A provides 24,000 units of annual support but leaves 6,000 in tuition and compulsory charges. Its net support is 18,000 before living costs. Offer B provides 21,000 and separately covers those academic charges, leaving 21,000 before living costs. The larger headline is not necessarily the larger usable budget."}],["$","p","These are invented teaching figures, not stipend recommendations or prices. Replace the currency, amounts, tax treatment and benefit terms with your actual offer. Do not count a tuition remission twice by including it both as cash income and as a reduction of expenses.",{"children":"These are invented teaching figures, not stipend recommendations or prices. Replace the currency, amounts, tax treatment and benefit terms with your actual offer. Do not count a tuition remission twice by including it both as cash income and as a reduction of expenses."}],["$","p","Budget for the location, period and household that actually apply. Confirm the payment start and arrival costs; do not assume that every expense is reimbursed immediately.",{"children":"Budget for the location, period and household that actually apply. Confirm the payment start and arrival costs; do not assume that every expense is reimbursed immediately."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
30:["$","section","7-Build a shortlist you can finance and explain",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Build a shortlist you can finance and explain"}],[["$","p","Choose programmes with subject fit, attainable admission conditions and a plausible funding route. Record whether aid consideration is automatic, separate or nomination-based. A priority funding deadline may be earlier than the general admission deadline.",{"children":"Choose programmes with subject fit, attainable admission conditions and a plausible funding route. Record whether aid consideration is automatic, separate or nomination-based. A priority funding deadline may be earlier than the general admission deadline."}],["$","p","For each option, write why the curriculum or research environment supports your next learning need. Then compare tests, transcript requirements, references and any financial forms. Avoid treating one university’s policy as a national rule.",{"children":"For each option, write why the curriculum or research environment supports your next learning need. Then compare tests, transcript requirements, references and any financial forms. Avoid treating one university’s policy as a national rule."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L32",null,{"id":"countries/united-states:section-8","title":"Check your progress","items":["Programme fit established","International aid policy read","Funding deadline separate from admission","Assistantship conditions understood","Net budget and arrival cash estimated"]}],"$undefined","$undefined"]}]
31:["$","section","8-Questions to send to the department",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Questions to send to the department"}],[["$","p","A useful enquiry names the programme and cycle, describes the relevant qualification and asks one specific question. For example: “Does your published funding offer cover mandatory fees and insurance, and is the stipend guaranteed for the stated period?”",{"children":"A useful enquiry names the programme and cycle, describes the relevant qualification and asks one specific question. For example: “Does your published funding offer cover mandatory fees and insurance, and is the stipend guaranteed for the stated period?”"}],["$","p","Do not ask a supervisor to promise admission outside the published process. If the programme expects research contact, explain a precise academic connection and respect its instructions. A clear enquiry is more effective than mass-mailing a generic request for a full scholarship.",{"children":"Do not ask a supervisor to promise admission outside the published process. If the programme expects research contact, explain a precise academic connection and respect its instructions. A clear enquiry is more effective than mass-mailing a generic request for a full scholarship."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Questions to send to the department","children":[["$","$L4","/scholarships/phd/",{"href":"/scholarships/phd/","children":["Compare doctoral funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/statement-of-purpose/",{"href":"/guides/statement-of-purpose/","children":["Prepare a research-focused SOP",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/fully-funded/",{"href":"/scholarships/fully-funded/","children":["Compare full funding scope",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
