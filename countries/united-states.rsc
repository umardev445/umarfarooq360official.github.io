29:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Does a funded offer cover every personal cost?",{"children":[["$","summary",null,{"children":["Does a funded offer cover every personal cost?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not automatically. Check fee remission, cash support, insurance, remaining charges and payment timing."}]]}],["$","details","Is an assistantship identical to a scholarship?",{"children":[["$","summary",null,{"children":["Is an assistantship identical to a scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It can include a work appointment with duties and renewal terms. Read the actual package."}]]}],["$","details","Does every US university use the same aid policy?",{"children":[["$","summary",null,{"children":["Does every US university use the same aid policy?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Research the programme and institution’s current international admissions and funding instructions."}]]}]]}]]}]
