21:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is studying in Germany free for every international student?",{"children":[["$","summary",null,{"children":["Is studying in Germany free for every international student?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Tuition and fees depend on the state, institution and programme, and living costs still apply. Confirm the current fee schedule for the exact course."}]]}],["$","details","Where do I apply for DAAD EPOS?",{"children":[["$","summary",null,{"children":["Where do I apply for DAAD EPOS?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Applications are normally submitted to the selected eligible postgraduate course according to its instructions, not through one universal DAAD application. Check the current DAAD listing and course deadline."}]]}],["$","details","Is studying in Germany completely free for international students?",{"children":[["$","summary",null,{"children":["Is studying in Germany completely free for international students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not always. Tuition policy varies by institution and programme, and students still need to plan semester contributions, insurance, housing, food, travel and other costs."}]]}],["$","details","Does every DAAD scholarship require work experience?",{"children":[["$","summary",null,{"children":["Does every DAAD scholarship require work experience?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Requirements differ by programme. DAAD EPOS generally targets development-related postgraduate courses and relevant professional experience, but other awards use different rules."}]]}]]}]]}]
