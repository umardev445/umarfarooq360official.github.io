23:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can I study in Turkey in English?",{"children":[["$","summary",null,{"children":["Can I study in Turkey in English?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes, English-taught routes exist, but check the exact programme and its preparation or exemption rules. An English-language university website does not prove that every degree is taught in English."}]]}],["$","details","Is study in Turkey free for international students?",{"children":[["$","summary",null,{"children":["Is study in Turkey free for international students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Admission itself does not make study free. Tuition and everyday costs remain unless your actual scholarship or exemption covers them. Compare the net offer and excluded costs."}]]}],["$","details","Can Pakistani students apply to Turkish universities?",{"children":[["$","summary",null,{"children":["Can Pakistani students apply to Turkish universities?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Eligible Pakistani applicants can use the institution’s international admission route. University entry, scholarship eligibility and the consular visa process each require separate checks."}]]}],["$","details","Are 2027 scholarship applications open?",{"children":[["$","summary",null,{"children":["Are 2027 scholarship applications open?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"This guide does not confirm an open 2027 Türkiye Bursları or joint IsDB–YTB call. Use the named official announcement rather than extending a previous year’s deadline."}]]}]]}]]}]
