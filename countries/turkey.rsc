26:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Compare public and foundation universities","children":[["$","$L5","/guides/universities-in-turkey-for-international-students/",{"href":"/guides/universities-in-turkey-for-international-students/","children":["Universities and English programmes",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/metu-international-admissions/",{"href":"/guides/metu-international-admissions/","children":["METU Ankara",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/istanbul-university-admissions-fees/",{"href":"/guides/istanbul-university-admissions-fees/","children":["Istanbul University",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/sabanci-university-admissions-scholarships/",{"href":"/guides/sabanci-university-admissions-scholarships/","children":["Sabancı University",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/koc-university-admissions-scholarships/",{"href":"/guides/koc-university-admissions-scholarships/","children":["Koç University",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/bilkent-university-admissions-scholarships/",{"href":"/guides/bilkent-university-admissions-scholarships/","children":["Bilkent University",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
27:["$","section","3-Separate three scholarship decisions",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Separate three scholarship decisions"}],[["$","p","Türkiye Bursları, the joint IsDB–YTB route and a university tuition award are separate funding decisions. A university discount should not be entered into the budget as a cash stipend. Read the award letter for duration, accommodation, language preparation and payments still due.",{"children":"Türkiye Bursları, the joint IsDB–YTB route and a university tuition award are separate funding decisions. A university discount should not be entered into the budget as a cash stipend. Read the award letter for duration, accommodation, language preparation and payments still due."}],["$","p","The reviewed 2026 IsDB–YTB application period ended on 20 February 2026. This hub does not announce a 2027 reopening. Prepare documents while waiting for a named official call, and keep a self-funded alternative only if its cost is realistic.",{"children":"The reviewed 2026 IsDB–YTB application period ended on 20 February 2026. This hub does not announce a 2027 reopening. Prepare documents while waiting for a named official call, and keep a self-funded alternative only if its cost is realistic."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://turkiyeburslari.gov.tr/announcements/ytb-islamic-development-bank-isdb-joint-scholarship-program-2026-applicaiton-period-122",{"children":["",["$","a",null,{"href":"https://turkiyeburslari.gov.tr/announcements/ytb-islamic-development-bank-isdb-joint-scholarship-program-2026-applicaiton-period-122","target":"_blank","rel":"noreferrer","children":"YTB joint-programme announcement"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Separate three scholarship decisions","children":[["$","$L5","/scholarships/turkiye-burslari/",{"href":"/scholarships/turkiye-burslari/","children":["Türkiye Bursları application guide",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/scholarships/isdb-ytb/",{"href":"/scholarships/isdb-ytb/","children":["IsDB–YTB: country and degree checks",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
28:["$","section","4-Build the cost before choosing a city",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Build the cost before choosing a city"}],[["$","p","Add tuition, occupied months of accommodation, everyday spending and arrival expenses. Keep USD and TRY in separate columns until you choose and date an exchange rate. A dorm bill for the teaching year is not automatically a twelve-month housing quote.",{"children":"Add tuition, occupied months of accommodation, everyday spending and arrival expenses. Keep USD and TRY in separate columns until you choose and date an exchange rate. A dorm bill for the teaching year is not automatically a twelve-month housing quote."}],["$","p","Istanbul versus Ankara is useful only when the room type, commute, bills and months match. Compare the university-specific housing examples in our living-cost guide; they are not city-wide average rents.",{"children":"Istanbul versus Ankara is useful only when the room type, commute, bills and months match. Compare the university-specific housing examples in our living-cost guide; they are not city-wide average rents."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"Fictional planning case: an applicant receives two offers. Offer A has lower tuition but no confirmed room; Offer B has a tuition waiver and an actual dorm quote. Compare the remaining annual cost and the cash due before arrival, rather than choosing the larger scholarship percentage."}]]}],"$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Build the cost before choosing a city","children":[["$","$L5","/guides/turkey-university-tuition-fees/",{"href":"/guides/turkey-university-tuition-fees/","children":["Verified tuition examples",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/cost-of-living-in-turkey-for-students/",{"href":"/guides/cost-of-living-in-turkey-for-students/","children":["Istanbul and Ankara budgets",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/student-accommodation-turkey/",{"href":"/guides/student-accommodation-turkey/","children":["Dorms and rental decisions",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
29:["$","section","5-Follow the application and arrival sequence",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Follow the application and arrival sequence"}],[["$","p","Make one calendar with separate academic, funding and legal tasks. Keep conditional offer requirements visible until the university confirms they have been satisfied.",{"children":"Make one calendar with separate academic, funding and legal tasks. Keep conditional offer requirements visible until the university confirms they have been satisfied."}]],["$","ol",null,{"className":"process-steps","aria-label":"Follow the application and arrival sequence","children":[["$","li","Choose degree level, programme language, campus and recognition requirements.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Choose degree level, programme language, campus and recognition requirements."}]]}],["$","li","Match your school qualification or prior degree to the institution’s accepted route.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Match your school qualification or prior degree to the institution’s accepted route."}]]}],["$","li","Submit the university and relevant scholarship applications separately.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Submit the university and relevant scholarship applications separately."}]]}],["$","li","Confirm the written offer, net tuition, refundable payments and housing.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Confirm the written offer, net tuition, refundable payments and housing."}]]}],["$","li","Use the competent Turkish mission’s entry instructions for your nationality.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Use the competent Turkish mission’s entry instructions for your nationality."}]]}],["$","li","After enrolment, follow the university and migration authority’s residence process.",{"children":[["$","span",null,{"children":6}],["$","strong",null,{"children":"After enrolment, follow the university and migration authority’s residence process."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Follow the application and arrival sequence","children":[["$","$L5","/guides/turkey-university-admission-requirements/",{"href":"/guides/turkey-university-admission-requirements/","children":["Admission, SAT/ACT and school Denklik",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/turkey-student-visa-requirements/",{"href":"/guides/turkey-student-visa-requirements/","children":["Student visa and Pakistan checklist",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/turkey-student-residence-permit/",{"href":"/guides/turkey-student-residence-permit/","children":["Student residence and health insurance",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2a:["$","section","6-Erasmus+ exchange is an institution-led route",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Erasmus+ exchange is an institution-led route"}],[["$","p","If you are already studying at a university, ask its international office whether a relevant Turkish partner and funded mobility call exist. The Turkish National Agency describes higher-education mobility through participating institutions. An exchange place is different from admission to a complete Turkish degree.",{"children":"If you are already studying at a university, ask its international office whether a relevant Turkish partner and funded mobility call exist. The Turkish National Agency describes higher-education mobility through participating institutions. An exchange place is different from admission to a complete Turkish degree."}],["$","p","Before accepting a mobility offer, agree course recognition, study dates and funding with the sending institution. Ask which costs the grant actually meets and who arranges housing. Do not assume a university on your preferred city list has an active agreement for your department.",{"children":"Before accepting a mobility offer, agree course recognition, study dates and funding with the sending institution. Ask which costs the grant actually meets and who arranges housing. Do not assume a university on your preferred city list has an active agreement for your department."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.ua.gov.tr/programlar/firsatlar/ka1-ka131-program-ulkelerinde-ogrenim-2/",{"children":["",["$","a",null,{"href":"https://www.ua.gov.tr/programlar/firsatlar/ka1-ka131-program-ulkelerinde-ogrenim-2/","target":"_blank","rel":"noreferrer","children":"Turkish National Agency: higher-education learning mobility"}]]}]]]}],"$undefined"]}]
2b:["$","section","7-Work and plans after graduation",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Work and plans after graduation"}],[["$","p","A student residence permit is not an unrestricted work permission. The labour ministry’s current criteria distinguish associate/bachelor’s students from graduate students; the first group can be considered for part-time work after completing the first year, through the work-permit process.",{"children":"A student residence permit is not an unrestricted work permission. The labour ministry’s current criteria distinguish associate/bachelor’s students from graduate students; the first group can be considered for part-time work after completing the first year, through the work-permit process."}],["$","p","Do not use hoped-for earnings to close a compulsory tuition or visa-funding gap. Before graduation, ask the university and migration authority about your actual residence position. A possible residence route and permission to work are separate questions.",{"children":"Do not use hoped-for earnings to close a compulsory tuition or visa-funding gap. Before graduation, ask the university and migration authority about your actual residence position. A possible residence route and permission to work are separate questions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://csgb.gov.tr/uigm/en/calisma-izni/calisma-izni-degerlendirme-kriterleri/",{"children":["",["$","a",null,{"href":"https://csgb.gov.tr/uigm/en/calisma-izni/calisma-izni-degerlendirme-kriterleri/","target":"_blank","rel":"noreferrer","children":"Ministry of Labour: foreign-student criteria"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Work and plans after graduation","children":[["$","$L5","/guides/turkey-student-residence-permit/",{"href":"/guides/turkey-student-residence-permit/","children":["Residence, insurance and work boundaries",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2c:["$","section","8-Keep a usable Turkey shortlist",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Keep a usable Turkey shortlist"}],[["$","p","Save a dated copy of each programme page and write down the owner of every unanswered question. Do not store passport or bank details in a shared public worksheet.",{"children":"Save a dated copy of each programme page and write down the owner of every unanswered question. Do not store passport or bank details in a shared public worksheet."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2d",null,{"id":"countries/turkey:section-9","title":"Check your progress","items":["I have the exact programme title, campus and teaching language.","I know which qualification or exam makes my application eligible.","I have separated the scholarship deadline from university admission.","I can meet the remaining costs and the first payments due.","I have a housing fallback and the correct entry/residence route."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Keep a usable Turkey shortlist","children":[["$","a","/downloads/turkey-programme-shortlist.csv",{"href":"/downloads/turkey-programme-shortlist.csv","download":true,"children":["Download the Turkey shortlist (CSV)",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
