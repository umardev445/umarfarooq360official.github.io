20:["$","$L25",null,{"items":[{"id":"chevening-2027","title":"Chevening Scholarships 2027–2028","provider":"UK Government","type":"Scholarship","level":"Master's","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"6 October 2026, 11:00 UTC","deadlineDate":"2026-10-06","deadlineAt":"2026-10-06T11:00:00Z","status":"Closed","summary":"The 2027–2028 scholarship application round is closed. Existing applicants should follow the official assessment, interview and later university-offer instructions.","tags":["Leadership","International students","One-year master's"],"source":"https://www.chevening.org/scholarships/","sourceLabel":"Chevening official website","checked":"13 October 2026","featured":false},{"id":"rhodes-2027","title":"Rhodes Scholarship 2027","provider":"Rhodes Trust","type":"Scholarship","level":"Graduate","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"Varies by constituency","status":"Check official site","summary":"Postgraduate study at the University of Oxford for academically excellent, service-oriented young leaders.","tags":["Oxford","Postgraduate","Leadership"],"source":"https://www.rhodeshouse.ox.ac.uk/scholarships/applications/","sourceLabel":"Rhodes Trust official website","checked":"13 October 2026","featured":true},{"id":"gates-cambridge-2027","title":"Gates Cambridge Scholarship","provider":"University of Cambridge","type":"Scholarship","level":"Graduate","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"US citizens residing in the US: 14 Oct 2026; other applicants: check the course funding deadline","deadlineDate":"$undefined","milestones":"$undefined","status":"Check official site","summary":"Cambridge confirms 14 October 2026 for US citizens residing in the US. Other eligible applicants use an international round linked to their course funding deadline; verify that date in the current course portal.","tags":["Cambridge","Master's","PhD"],"source":"https://www.student-funding.cam.ac.uk/fund/gates-us-fund-2026","sourceLabel":"University of Cambridge: 2027–2028 Gates US round","checked":"13 October 2026","featured":true},{"id":"commonwealth-masters-2027","title":"Commonwealth Master's Scholarships 2027–2028","provider":"Commonwealth Scholarship Commission","type":"Scholarship","level":"Master's","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"20 October 2026, 16:00 BST","deadlineDate":"2026-10-20","status":"Open","summary":"UK master's funding for eligible candidates with the potential to contribute to sustainable development in their home countries. Published CSC deadline: 20 October 2026 at 16:00 BST; the nominator may set an earlier date.","tags":["Commonwealth","Development","Master's"],"source":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-masters-scholarships/","sourceLabel":"Commonwealth Scholarship Commission","checked":"13 October 2026","deadlineAt":"2026-10-20T16:00:00+01:00"},{"id":"commonwealth-phd-2027","title":"Commonwealth PhD Scholarships 2027–2028","provider":"Commonwealth Scholarship Commission","type":"Scholarship","level":"PhD","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"20 October 2026, 16:00 BST","deadlineDate":"2026-10-20","status":"Open","summary":"Doctoral funding for applicants from eligible least-developed countries and vulnerable Commonwealth states. Published CSC deadline: 20 October 2026 at 16:00 BST; the nominator may set an earlier date.","tags":["Commonwealth","Research","PhD"],"source":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-phd-scholarships-for-least-developed-countries-and-vulnerable-states/","sourceLabel":"Commonwealth Scholarship Commission","checked":"13 October 2026","deadlineAt":"2026-10-20T16:00:00+01:00"}],"showTypeFilter":false}]
21:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-Plan two applications, not one",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Plan two applications, not one"}],[["$","p","For many UK awards, scholarship selection and university admission are connected but not identical. Chevening asks applicants to identify eligible courses, while Commonwealth routes can involve a nominating body. Gates Cambridge is considered through the Cambridge graduate application.",{"children":"For many UK awards, scholarship selection and university admission are connected but not identical. Chevening asks applicants to identify eligible courses, while Commonwealth routes can involve a nominating body. Gates Cambridge is considered through the Cambridge graduate application."}],["$","p","Create one calendar for scholarship deadlines and another for course admission, references, English tests and document uploads.",{"children":"Create one calendar for scholarship deadlines and another for course admission, references, English tests and document uploads."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Check course eligibility for the award",{"children":"Check course eligibility for the award"}],["$","li","Understand conditional and unconditional offers",{"children":"Understand conditional and unconditional offers"}],["$","li","Confirm reference submission rules",{"children":"Confirm reference submission rules"}],["$","li","Budget visa and immigration health costs if not covered",{"children":"Budget visa and immigration health costs if not covered"}],["$","li","Track deposit deadlines while awaiting funding decisions",{"children":"Track deposit deadlines while awaiting funding decisions"}]]}],"$undefined","$undefined"]}],["$","section","2-Compare the amount you will actually receive",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Compare the amount you will actually receive"}],[["$","p","Record tuition coverage, stipend, travel, visa or arrival support, dependants, deposits and any fee cap. For partial university awards, subtract the discount from total tuition and add living costs for the actual city.",{"children":"Record tuition coverage, stipend, travel, visa or arrival support, dependants, deposits and any fee cap. For partial university awards, subtract the discount from total tuition and add living costs for the actual city."}],["$","p","Confirm whether the scholarship requires a return-home commitment, leadership evidence, work experience or an unconditional offer by a later date.",{"children":"Confirm whether the scholarship requires a return-home commitment, leadership evidence, work experience or an unconditional offer by a later date."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Choose a UK funding route for your degree level",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Choose a UK funding route for your degree level"}],[["$","p","A country shortlist becomes useful when it distinguishes the award, university place and remaining personal costs. Start with your intended degree, field and citizenship, then compare only routes that could accept that profile. A funding brand is not a guarantee that every course or applicant is eligible.",{"children":"A country shortlist becomes useful when it distinguishes the award, university place and remaining personal costs. Start with your intended degree, field and citizenship, then compare only routes that could accept that profile. A funding brand is not a guarantee that every course or applicant is eligible."}],"$L26"],"$undefined","$L27","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L28","$L29","$L2a"]}]
