23:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can I apply for funding before receiving an offer?",{"children":[["$","summary",null,{"children":["Can I apply for funding before receiving an offer?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"It depends on the award. Check the order of scholarship and university applications and any later offer requirement."}]]}],["$","details","Does the scholarship waive course language requirements?",{"children":[["$","summary",null,{"children":["Does the scholarship waive course language requirements?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Do not assume so. The university and scholarship can have different evidence requirements."}]]}],["$","details","Should I pay a deposit while waiting for a scholarship?",{"children":[["$","summary",null,{"children":["Should I pay a deposit while waiting for a scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Read the payment and refund conditions and evaluate your confirmed budget. A pending award is not money already available."}]]}]]}]]}]
