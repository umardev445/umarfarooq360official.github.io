19:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-Plan two applications, not one",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Plan two applications, not one"}],[["$","p","For many UK awards, scholarship selection and university admission are connected but not identical. Chevening asks applicants to identify eligible courses, while Commonwealth routes can involve a nominating body. Gates Cambridge is considered through the Cambridge graduate application.",{"children":"For many UK awards, scholarship selection and university admission are connected but not identical. Chevening asks applicants to identify eligible courses, while Commonwealth routes can involve a nominating body. Gates Cambridge is considered through the Cambridge graduate application."}],["$","p","Create one calendar for scholarship deadlines and another for course admission, references, English tests and document uploads.",{"children":"Create one calendar for scholarship deadlines and another for course admission, references, English tests and document uploads."}]],"$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Check course eligibility for the award",{"children":"Check course eligibility for the award"}],["$","li","Understand conditional and unconditional offers",{"children":"Understand conditional and unconditional offers"}],["$","li","Confirm reference submission rules",{"children":"Confirm reference submission rules"}],["$","li","Budget visa and immigration health costs if not covered",{"children":"Budget visa and immigration health costs if not covered"}],["$","li","Track deposit deadlines while awaiting funding decisions",{"children":"Track deposit deadlines while awaiting funding decisions"}]]}],"$undefined","$undefined"]}],["$","section","2-Compare the amount you will actually receive",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Compare the 