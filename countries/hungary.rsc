22:["$","ul",null,{"children":[["$","li","Tuition and institutional charges",{"children":"Tuition and institutional charges"}],["$","li","Monthly award and first-payment timing",{"children":"Monthly award and first-payment timing"}],["$","li","Dormitory eligibility or housing contribution",{"children":"Dormitory eligibility or housing contribution"}],["$","li","Health coverage and out-of-pocket expenses",{"children":"Health coverage and out-of-pocket expenses"}],["$","li","Travel, visa and dependants where applicable",{"children":"Travel, visa and dependants where applicable"}]]}]
23:["$","section","3-Understand the two application checks",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Understand the two application checks"}],[["$","p","Stipendium Hungaricum is more than one website form. Applicants apply through the scholarship system and follow their sending partner's local submission and nomination process. Partners may impose different deadlines or documents; a scholarship application without the required nomination can fail before university review.",{"children":"Stipendium Hungaricum is more than one website form. Applicants apply through the scholarship system and follow their sending partner's local submission and nomination process. Partners may impose different deadlines or documents; a scholarship application without the required nomination can fail before university review."}],["$","p","The host institution then assesses academic and language eligibility, potentially through a test or interview. Read the exact degree page and keep a record of the scholarship-system, partner and university requirements separately.",{"children":"The host institution then assesses academic and language eligibility, potentially through a test or interview. Read the exact degree page and keep a record of the scholarship-system, partner and university requirements separately."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","4-Check language proof for your chosen programme",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Check language proof for your chosen programme"}],[["$","p","A previous qualification taught in English may be useful evidence, but an English-medium course can still request an accepted test or a particular certificate. The admitting university sets the course rule. For a Hungarian-medium course, find out whether language preparation is included and whether completion is required before the degree begins.",{"children":"A previous qualification taught in English may be useful evidence, but an English-medium course can still request an accepted test or a particular certificate. The admitting university sets the course rule. For a Hungarian-medium course, find out whether language preparation is included and whether completion is required before the degree begins."}],["$","p","Ask admissions about your previous institution and exact intake if the published rule is ambiguous. Check immigration requirements independently before assuming a university waiver settles every stage.",{"children":"Ask admissions about your previous institution and exact intake if the published rule is ambiguous. Check immigration requirements independently before assuming a university waiver settles every stage."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","5-A practical Hungary shortlist",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"A practical Hungary shortlist"}],[["$","p","For each option, write down the institution, degree title, teaching language, sending-partner eligibility, official application link and three separate deadlines if they apply. Rank options by academic fit and affordable living costs, not by a broad 'fully funded' label.",{"children":"For each option, write down the institution, degree title, teaching language, sending-partner eligibility, official application link and three separate deadlines if they apply. Rank options by academic fit and affordable living costs, not by a broad 'fully funded' label."}],["$","p","If your sending partner does not cover the field you want, look for a genuinely eligible university award or a different destination. Never submit a mismatched application only because the destination appears in a scholarship roundup.",{"children":"If your sending partner does not cover the field you want, look for a genuinely eligible university award or a different destination. Never submit a mismatched application only because the destination appears in a scholarship roundup."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
