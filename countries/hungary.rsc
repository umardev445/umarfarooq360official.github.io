1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--country","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/countries/hungary/\",\"name\":\"Scholarships in Hungary for international students\",\"description\":\"Compare Hungary scholarship routes, Stipendium Hungaricum funding, sending-partner rules, language evidence and living costs before choosing a course.\",\"url\":\"https://aspirecompass.org/countries/hungary/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-09-20\",\"dateModified\":\"2026-10-13\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/study-planning-1280.webp\",\"caption\":\"Students comparing study options with a laptop, notes and a map\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Countries\",\"item\":\"https://aspirecompass.org/countries/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Scholarships in Hungary for international students\",\"item\":\"https://aspirecompass.org/countries/hungary/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"Scholarships in Hungary for international students\",\"description\":\"Compare Hungary scholarship routes, Stipendium Hungaricum funding, sending-partner rules, language evidence and living costs before choosing a course.\",\"image\":\"https://aspirecompass.org/images/study