1c:["$","$L21",null,{"items":[{"id":"stipendium-hungaricum","title":"Stipendium Hungaricum Scholarship","provider":"Government of Hungary","type":"Scholarship","level":"Any degree","country":"Hungary","region":"Europe","funding":"Funded","deadline":"2027–2028 call not confirmed on the official apply page checked 13 October","status":"Check official site","summary":"The official apply page still describes 2026–2027 and its past 15 January 2026 deadline. Prepare by sending-partner route; do not reuse that date for an unannounced future cycle.","tags":["Hungary","Bachelor's","Master's","PhD"],"source":"https://stipendiumhungaricum.hu/apply/","sourceLabel":"Stipendium Hungaricum official website","checked":"13 October 2026"}],"showTypeFilter":false}]
1d:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-Choose a scholarship route before choosing a city",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Choose a scholarship route before choosing a city"}],[["$","p","The Stipendium Hungaricum programme is managed by the Tempus Public Foundation and is available through agreements with sending partners. Its eligible degrees and study fields depend on the applicant's country. Start with the current sending-partner list, then compare the universities and courses actually offered to that partner.",{"children":"The Stipendium Hungaricum programme is managed by the Tempus Public Foundation and is available through agreements with sending partners. Its eligible degrees and study fields depend on the applicant's country. Start with the current sending-partner list, then compare the universities and courses actually offered to that partner."}],["$","p","A university may also publish its own merit or research funding. Do not assume that an award for one institution, nationality or degree level applies to every Hungarian course. Compare each official offer for eligibility, application sequence, tuition and renewal conditions.",{"children":"A university may also publish its own merit or research funding. Do not assume that an award for one institution, nationality or degree level applies to every Hungarian course. Compare each official offer for eligibility, application sequence, tuition and renewal conditions."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Identify your citizenship and sending partner",{"children":"Identify your citizenship and sending partner"}],["$","li","Find eligible degrees in your intended field",{"children":"Find eligible degrees in your intended field"}],["$","li","Check teaching language and admission tests",{"children":"Check teaching language and admission tests"}],["$","li","Compare funding and costs in the actual host city",{"children":"Compare funding and costs in the actual host city"}]]}],"$undefined","$undefined","$undefined"]}],["$","section","2-What Stipendium Hungaricum covers, and what it does not",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"What Stipendium Hungaricum covers, and what it does not"}],[["$","p","The programme's official overview describes tuition exemption, a monthly stipend, a dormitory place or a contribution toward accommodation, and health care support. Doctoral funding differs from bachelor's and master's funding. These provisions contribute toward living costs; the programme explicitly warns that they do not cover all expenses.",{"children":"The programme's official overview describes tuition exemption, a monthly stipend, a dormitory place or a contribution toward accommodation, and health care support. Doctoral funding differs from bachelor's and master's funding. These provisions contribute toward living costs; the programme explicitly warns that they do not cover all expenses."}],["$","p","Create a monthly budget for rent, utilities, transport, food, insurance gaps and the period before your first payment. If a dormitory is unavailable, compare the accommodation contribution with actual rental quotes. Check current benefit amounts on the official page rather than relying on an old social-media figure.",{"children":"Create a monthly budget for rent, utilities, transport, food, insurance gaps and the period before your first payment. If a dormitory is unavailable, compare the accommodation contribution with actual rental quotes. Check current benefit amounts on the official page rather than relying on an old social-media figure."}]],"$undefined","$undefined","$undefined","$undefined","$L22","$undefined","$undefined","$undefined"]}],"$L23","$L24","$L25"]}]
