2b:["$","section","4-Separate scholarship language rules from course language",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Separate scholarship language rules from course language"}],[["$","p","Some categories use Japanese or English examinations during screening, and university programmes can set their own language evidence. The absence of IELTS from one central checklist does not prove a universal waiver.",{"children":"Some categories use Japanese or English examinations during screening, and university programmes can set their own language evidence. The absence of IELTS from one central checklist does not prove a universal waiver."}],["$","p","Record the teaching language, accepted evidence and stage at which it is required. Ask the embassy or university only after reading the newest route-specific guidance.",{"children":"Record the teaching language, accepted evidence and stage at which it is required. Ask the embassy or university only after reading the newest route-specific guidance."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2c:["$","section","5-Match the MEXT category to your qualification and goal",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Match the MEXT category to your qualification and goal"}],[["$","p","Choose the scholarship category before comparing deadlines or collecting documents. The official MEXT information lists different routes and categories. A school graduate, a research applicant and a specialist training applicant may need different qualifications, screening and placement steps.",{"children":"Choose the scholarship category before comparing deadlines or collecting documents. The official MEXT information lists different routes and categories. A school graduate, a research applicant and a specialist training applicant may need different qualifications, screening and placement steps."}],["$","p","The comparison below is an orientation aid. The current category guidelines and local mission or nominating university decide the exact criteria. Do not transfer age limits, tests or document rules from one category to another.",{"children":"The comparison below is an orientation aid. The current category guidelines and local mission or nominating university decide the exact criteria. Do not transfer age limits, tests or document rules from one category to another."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Category questions to resolve first","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Category questions to resolve first"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Your situation",{"scope":"col","children":"Your situation"}],["$","th","Research question",{"scope":"col","children":"Research question"}],["$","th","Evidence to locate",{"scope":"col","children":"Evidence to locate"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Leaving school"}],["$","td","1",{"children":"Which undergraduate or training category fits?"}],["$","td","2",{"children":"Current category guideline and local announcement"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Completed a first degree"}],["$","td","1",{"children":"Which research or graduate route fits the intended work?"}],["$","td","2",{"children":"Degree requirements and research instructions"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Seeking a specialist route"}],["$","td","1",{"children":"Is the field and training category eligible?"}],["$","td","2",{"children":"Category-specific qualification and screening"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"University nomination"}],["$","td","1",{"children":"Does the institution offer the relevant nomination?"}],["$","td","2",{"children":"University’s own call and internal deadline"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2d:["$","section","6-Use a research plan to explain a question, not only an ambition",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Use a research plan to explain a question, not only an ambition"}],[["$","p","For a route that asks for a research plan, define the problem, what you already know, the question you want to investigate and the method you could realistically learn or use. Explain what evidence would answer the question and what could limit the work.",{"children":"For a route that asks for a research plan, define the problem, what you already know, the question you want to investigate and the method you could realistically learn or use. Explain what evidence would answer the question and what could limit the work."}],["$","p","A list of attractive topics is not a research plan. Narrow the scope until you can connect the question to your preparation and an appropriate academic environment. Follow the official format and do not promise access to a laboratory, dataset or supervisor without confirmation.",{"children":"A list of attractive topics is not a research plan. Narrow the scope until you can connect the question to your preparation and an appropriate academic environment. Follow the official format and do not promise access to a laboratory, dataset or supervisor without confirmation."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2e:["$","section","7-Example: avoid combining two incompatible routes",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Example: avoid combining two incompatible routes"}],[["$","p","A fictional graduate sees an embassy announcement and a university nomination page. They first compare category, qualifications, dates and rules on simultaneous applications. They do not assume that submitting twice is permitted or increases the chance of selection.",{"children":"A fictional graduate sees an embassy announcement and a university nomination page. They first compare category, qualifications, dates and rules on simultaneous applications. They do not assume that submitting twice is permitted or increases the chance of selection."}],["$","p","After choosing an applicable route, they use only that route’s document list and cycle. An old PDF may still be online with a valid-looking application form. Saving the year and issuing authority beside each file prevents documents from different calls entering the same folder.",{"children":"After choosing an applicable route, they use only that route’s document list and cycle. An old PDF may still be online with a valid-looking application form. Saving the year and issuing authority beside each file prevents documents from different calls entering the same folder."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2f:["$","section","8-Plan language and preparation realistically",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Plan language and preparation realistically"}],[["$","p","Check the degree’s actual teaching language and the route’s screening evidence. An English-taught programme does not remove every category-specific examination or language condition. Preparatory education, when available, depends on the scholarship route.",{"children":"Check the degree’s actual teaching language and the route’s screening evidence. An English-taught programme does not remove every category-specific examination or language condition. Preparatory education, when available, depends on the scholarship route."}],["$","p","Beyond formal admission, consider daily communication, research collaboration and the support you would need on arrival. Set a learning plan you can maintain rather than claiming fluency in a language you have only begun studying.",{"children":"Beyond formal admission, consider daily communication, research collaboration and the support you would need on arrival. Set a learning plan you can maintain rather than claiming fluency in a language you have only begun studying."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
30:["$","section","9-Build a route-specific tracker",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"Build a route-specific tracker"}],[["$","p","Keep the local deadline, documents, screening stages, nomination and placement conditions separate. Your tracker should show the official owner of each decision and the task needed before it. If the next cycle is not announced, mark the date as unconfirmed rather than copying a prior year.",{"children":"Keep the local deadline, documents, screening stages, nomination and placement conditions separate. Your tracker should show the official owner of each decision and the task needed before it. If the next cycle is not announced, mark the date as unconfirmed rather than copying a prior year."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L31",null,{"id":"countries/japan:section-10","title":"Check your progress","items":["MEXT category and cycle identified","Embassy or university route confirmed","Parallel-application rules checked","Relevant qualification and language requirements saved","Document list belongs to one cycle","Research plan prepared only when requested"]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Build a route-specific tracker","children":[["$","$L4","/guides/mext-application-routes/",{"href":"/guides/mext-application-routes/","children":["Detailed MEXT route guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/motivation-letter/",{"href":"/guides/motivation-letter/","children":["Prepare academic motivation",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/recommendation-letter/",{"href":"/guides/recommendation-letter/","children":["Plan references",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
