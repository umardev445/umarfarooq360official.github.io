1e:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can I apply to MEXT through both routes?",{"children":[["$","summary",null,{"children":["Can I apply to MEXT through both routes?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Rules can restrict simultaneous or duplicate applications. Read the current category guidelines and ask the relevant embassy or university before starting parallel submissions."}]]}],["$","details","Does MEXT use one global deadline?",{"children":[["$","summary",null,{"children":["Does MEXT use one global deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Embassy and university schedules differ by country, institution, route and scholarship category. Use the current local official announcement."}]]}],["$","details","Does MEXT have one worldwide application deadline?",{"children":[["$","summary",null,{"children":["Does MEXT have one worldwide application deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Deadlines vary by country, university, category and route. Use the current local embassy or participating-university notice."}]]}],["$","details","Can I apply through both MEXT routes at the same time?",{"children":[["$","summary",null,{"children":["Can I apply through both MEXT routes at the same time?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Do not assume this is allowed. Follow the current category and local instructions, which may restrict parallel applications or nominations."}]]}]]}]]}]
