25:["$","section",null,{"className":"content-block","aria-labelledby":"relevant-listings","children":[["$","div",null,{"className":"content-block__heading","children":[["$","h2",null,{"id":"relevant-listings","children":"Relevant opportunities"}],["$","p",null,{"children":"1 official-source records match this topic. Check category and applicant conditions before applying."}]]}],["$","$L2a",null,{"items":[{"id":"mext-2027","title":"Japanese Government MEXT Scholarships","provider":"Government of Japan","type":"Scholarship","level":"Any degree","country":"Japan","region":"Asia","funding":"Fully funded","deadline":"Varies by embassy or university route","status":"Check official site","summary":"Japanese government scholarships for international students selected through embassy, university or authority recommendation routes.","tags":["Japan","Embassy route","University route"],"source":"https://www.mext.go.jp/en/policy/education/highered/title02/detail02/sdetail02/1373897.htm","sourceLabel":"MEXT official website","checked":"13 October 2026","featured":true}],"showTypeFilter":false}]]}]
26:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-Choose the correct MEXT route",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Choose the correct MEXT route"}],[["$","p","Embassy recommendation normally begins through the Japanese diplomatic mission in your country. University recommendation depends on nomination by a participating Japanese university and its internal schedule. The routes, categories and calendars are not interchangeable.",{"children":"Embassy recommendation normally begins through the Japanese diplomatic mission in your country. University recommendation depends on nomination by a participating Japanese university and its internal schedule. The routes, categories and calendars are not interchangeable."}],["$","p","Use MEXT and the relevant embassy or university as your authoritative sources. Older downloadable guidelines can remain online, so confirm the year on every document.",{"children":"Use MEXT and the relevant embassy or university as your authoritative sources. Older downloadable guidelines can remain online, so confirm the year on every document."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Identify the scholarship category",{"children":"Identify the scholarship category"}],["$","li","Confirm age and academic requirements",{"children":"Confirm age and academic requirements"}],["$","li","Check route-specific documents",{"children":"Check route-specific documents"}],["$","li","Prepare a research plan where required",{"children":"Prepare a research plan where required"}],["$","li","Follow the exact local deadline",{"children":"Follow the exact local deadline"}]]}],"$undefined","$undefined","$undefined"]}],["$","section","2-Embassy and university recommendation are different routes",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Embassy and university recommendation are different routes"}],[["$","p","For embassy recommendation, follow the Japanese embassy or consulate serving your country and use its local calendar. For university recommendation, the Japanese institution selects candidates under its own internal process before nomination to MEXT.",{"children":"For embassy recommendation, follow the Japanese embassy or consulate serving your country and use its local calendar. For university recommendation, the Japanese institution selects candidates under its own internal process before nomination to MEXT."}],["$","p","Do not combine documents from different years or categories. Undergraduate, research student, teacher training and other MEXT routes can use different age, qualification, test and placement rules.",{"children":"Do not combine documents from different years or categories. Undergraduate, research student, teacher training and other MEXT routes can use different age, qualification, test and placement rules."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Prepare for academic fit and language reality",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Prepare for academic fit and language reality"}],[["$","p","Some degrees are taught in English, but daily life, research collaboration and career options may benefit from Japanese. Check the actual language of instruction and any preparatory education included in the scholarship category.",{"children":"Some degrees are taught in English, but daily life, research collaboration and career options may benefit from Japanese. Check the actual language of instruction and any preparatory education included in the scholarship category."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L2b","$L2c","$L2d","$L2e","$L2f","$L30"]}]
