28:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Does MEXT have one worldwide deadline?",{"children":[["$","summary",null,{"children":["Does MEXT have one worldwide deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Category, country and nomination route can use different calendars. Follow the current local mission or university notice."}]]}],["$","details","Can I apply through two routes at once?",{"children":[["$","summary",null,{"children":["Can I apply through two routes at once?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Do not assume that is permitted. Read the applicable guidelines and clarify restrictions before parallel submissions."}]]}],["$","details","Does an English-taught degree remove all language conditions?",{"children":[["$","summary",null,{"children":["Does an English-taught degree remove all language conditions?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No universal conclusion follows. Check both the scholarship screening and programme’s current evidence requirements."}]]}]]}]]}]
