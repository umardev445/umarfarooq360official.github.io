2b:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Current planning status: checked 5 October 2026","children":[["$","$L4","https://www.unipd.it/en/ammissione-studenti-internazionali",{"href":"https://www.unipd.it/en/ammissione-studenti-internazionali","children":["Padua international admissions",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification/deadlines",{"href":"https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification/deadlines","children":["Polimi admission windows by study area",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.polimi.it/fileadmin/user_upload/futuri_studenti/borse-di-studio/Merit_Based_Call_For_Applications_a.y._2027-2028.pdf",{"href":"https://www.polimi.it/fileadmin/user_upload/futuri_studenti/borse-di-studio/Merit_Based_Call_For_Applications_a.y._2027-2028.pdf","children":["Polimi merit-scholarship call: 2027–2028 PDF",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.unipd.it/en/padua-international-excellence-scholarship-programme",{"href":"https://www.unipd.it/en/padua-international-excellence-scholarship-programme","children":["Padua International Excellence: award and future-call notice",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
2c:["$","section","3-Choose a degree before choosing a funding headline",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Choose a degree before choosing a funding headline"}],[["$","p","Start with the exact bachelor's, single-cycle, master's or doctoral programme. Record the teaching language, academic prerequisites, intake, application portal and whether admission is limited by a test or ranking. For a bachelor's route, a foreign school qualification normally needs to represent at least 12 years of education; university-specific rules explain how shorter school systems are assessed.",{"children":"Start with the exact bachelor's, single-cycle, master's or doctoral programme. Record the teaching language, academic prerequisites, intake, application portal and whether admission is limited by a test or ranking. For a bachelor's route, a foreign school qualification normally needs to represent at least 12 years of education; university-specific rules explain how shorter school systems are assessed."}],["$","p","For a master's application, compare your previous degree, subjects, credits and grades with the programme requirements. A university can reject an academically mismatched application even when the applicant qualifies for a general scholarship category.",{"children":"For a master's application, compare your previous degree, subjects, credits and grades with the programme requirements. A university can reject an academically mismatched application even when the applicant qualifies for a general scholarship category."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Exact programme and campus",{"children":"Exact programme and campus"}],["$","li","Degree level and prior qualification",{"children":"Degree level and prior qualification"}],["$","li","Teaching language",{"children":"Teaching language"}],["$","li","Admission call and deadline",{"children":"Admission call and deadline"}],["$","li","Application fee and document format",{"children":"Application fee and document format"}],["$","li","Separate funding deadline",{"children":"Separate funding deadline"}]]}],"$undefined","$undefined","$undefined"]}]
2d:["$","section","4-English requirements are programme-specific",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"English requirements are programme-specific"}],[["$","p","Italy does not have one IELTS score for every university. English-taught programmes commonly ask for a CEFR level such as B1 or B2 and publish their own accepted certificates, minimum scores and deadlines. Some institutions may accept a completed qualification taught entirely in English when the official documents clearly state the language of instruction.",{"children":"Italy does not have one IELTS score for every university. English-taught programmes commonly ask for a CEFR level such as B1 or B2 and publish their own accepted certificates, minimum scores and deadlines. Some institutions may accept a completed qualification taught entirely in English when the official documents clearly state the language of instruction."}],["$","p","Treat a Medium of Instruction letter as evidence to be checked, not a universal IELTS waiver. Verify the exact course notice, scholarship condition and consular checklist. An English-taught degree can also carry a later Italian-language learning requirement at some institutions.",{"children":"Treat a Medium of Instruction letter as evidence to be checked, not a universal IELTS waiver. Verify the exact course notice, scholarship condition and consular checklist. An English-taught degree can also carry a later Italian-language learning requirement at some institutions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2e:["$","section","5-Understand tuition before estimating the scholarship gap",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Understand tuition before estimating the scholarship gap"}],[["$","p","Public-university tuition can depend on the programme, study load, citizenship or residence category and the family's economic documentation. For 2026–2027, the University of Padua describes general degree costs from zero to about €3,000 a year. Politecnico di Milano shows a standard annual range from €157.04 up to €3,943.04, while reserved non-EU master's students with a foreign qualification may be charged the maximum when no qualifying scholarship applies.",{"children":"Public-university tuition can depend on the programme, study load, citizenship or residence category and the family's economic documentation. For 2026–2027, the University of Padua describes general degree costs from zero to about €3,000 a year. Politecnico di Milano shows a standard annual range from €157.04 up to €3,943.04, while reserved non-EU master's students with a foreign qualification may be charged the maximum when no qualifying scholarship applies."}],["$","p","The University of Bologna uses a fixed €157.04 component plus a variable programme and economic component. These examples are planning references for a named academic year. Your final amount comes from the university account after your documents are assessed.",{"children":"The University of Bologna uses a fixed €157.04 component plus a variable programme and economic component. These examples are planning references for a named academic year. Your final amount comes from the university account after your documents are assessed."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2f:["$","section","6-Follow the admission, Universitaly and visa sequence",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Follow the admission, Universitaly and visa sequence"}],[["$","p","Apply first through the university's stated admission system. After a positive evaluation, non-EU applicants living abroad generally complete the required pre-enrolment through Universitaly. The university validates the request so it can support the study-visa process with the relevant Italian diplomatic mission.",{"children":"Apply first through the university's stated admission system. After a positive evaluation, non-EU applicants living abroad generally complete the required pre-enrolment through Universitaly. The university validates the request so it can support the study-visa process with the relevant Italian diplomatic mission."}],["$","p","University validation does not guarantee a visa. Follow the embassy or consulate serving your place of residence for financial, accommodation, insurance and document requirements. Keep university admission, scholarship, Universitaly and visa tasks as four separate rows in your tracker.",{"children":"University validation does not guarantee a visa. Follow the embassy or consulate serving your place of residence for financial, accommodation, insurance and document requirements. Keep university admission, scholarship, Universitaly and visa tasks as four separate rows in your tracker."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
30:["$","section","7-A practical Italy shortlist",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"A practical Italy shortlist"}],[["$","p","For every programme, create one record containing the official degree page, admission call, tuition page, language rule, scholarship owner and current deadline. Add a personal budget showing tuition after any waiver, housing, food, transport, insurance, visa-related costs and money needed before the first benefit payment.",{"children":"For every programme, create one record containing the official degree page, admission call, tuition page, language rule, scholarship owner and current deadline. Add a personal budget showing tuition after any waiver, housing, food, transport, insurance, visa-related costs and money needed before the first benefit payment."}],["$","p","Use the dedicated AspireCompass guides below for the detailed checks. Return to the original university or government page immediately before submission because annual calls and document rules can change.",{"children":"Use the dedicated AspireCompass guides below for the detailed checks. Return to the original university or government page immediately before submission because annual calls and document rules can change."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Italy scholarships and current-cycle status",{"children":"Italy scholarships and current-cycle status"}],["$","li","DSU and foreign-income documents",{"children":"DSU and foreign-income documents"}],["$","li","Selected universities and 2026–2027 fees",{"children":"Selected universities and 2026–2027 fees"}],["$","li","English evidence and admission sequence",{"children":"English evidence and admission sequence"}]]}],"$undefined","$undefined","$undefined"]}]
31:["$","section","8-Build one connected Italy application plan",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Build one connected Italy application plan"}],[["$","p","Choose a degree first, then connect its admission rule to the exact deadline, funding route, document process and first-year budget. These guides cover the tasks that most often depend on one another.",{"children":"Choose a degree first, then connect its admission rule to the exact deadline, funding route, document process and first-year budget. These guides cover the tasks that most often depend on one another."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Build one connected Italy application plan","children":[["$","$L4","/guides/study-in-italy-admission-english-requirements/",{"href":"/guides/study-in-italy-admission-english-requirements/","children":["Admission and English requirements",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/italy-university-application-deadlines/",{"href":"/guides/italy-university-application-deadlines/","children":["Italy university deadlines",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/italy-dsu-scholarships/",{"href":"/guides/italy-dsu-scholarships/","children":["DSU scholarship guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Italy study cost calculator",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
32:["$","section","9-Italy: continue with the right admission and funding route",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"Italy: continue with the right admission and funding route"}],[["$","p","Use these connected guides to compare institution rules, funding conditions and the next application task. Each guide identifies the official sources and the cycle it describes.",{"children":"Use these connected guides to compare institution rules, funding conditions and the next application task. Each guide identifies the official sources and the cycle it describes."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Italy: continue with the right admission and funding route","children":[["$","$L4","/scholarships/maeci-scholarship/",{"href":"/scholarships/maeci-scholarship/","children":["MAECI Italian Government Scholarship: eligibility, funding and application",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/ergo-scholarship/",{"href":"/scholarships/ergo-scholarship/","children":["ER.GO scholarship for international students: documents, status and application",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/edisu-piemonte/",{"href":"/scholarships/edisu-piemonte/","children":["EDISU Piemonte scholarship: documents, housing and the correct application route",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/university-of-turin-admissions-scholarships/",{"href":"/guides/university-of-turin-admissions-scholarships/","children":["University of Turin admissions and scholarships for international students",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/university-of-pavia-admissions-scholarships/",{"href":"/guides/university-of-pavia-admissions-scholarships/","children":["University of Pavia admissions and scholarships: a practical application guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/politecnico-di-torino-admissions-scholarships/",{"href":"/guides/politecnico-di-torino-admissions-scholarships/","children":["Politecnico di Torino admissions and scholarships: choose your application route",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
33:["$","section","10-Explore the next steps in this study pathway",{"className":"article-section","id":"section-11","children":[["$","h2",null,{"children":"Explore the next steps in this study pathway"}],[["$","p","Choose the institution, funding or preparation task that matches your situation. The guides separate admission, funding and administrative decisions.",{"children":"Choose the institution, funding or preparation task that matches your situation. The guides separate admission, funding and administrative decisions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Explore the next steps in this study pathway","children":[["$","$L4","/scholarships/lazio-disco/",{"href":"/scholarships/lazio-disco/","children":["Lazio DiSCo scholarship: eligibility, documents and application",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/dsu-toscana/",{"href":"/scholarships/dsu-toscana/","children":["DSU Toscana scholarship: documents, renewal and application",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/sapienza-university-admissions-scholarships/",{"href":"/guides/sapienza-university-admissions-scholarships/","children":["Sapienza admissions and scholarships for international students",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/university-of-milan-admissions-scholarships/",{"href":"/guides/university-of-milan-admissions-scholarships/","children":["University of Milan admissions, fees and scholarships",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:pro