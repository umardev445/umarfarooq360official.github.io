teps in this study pathway",{"href":"#section-11","children":[["$","b",null,{"children":"11"}],"Explore the next steps in this study pathway"]}]]}]]}],["$","div",null,{"className":"sidebar-card","children":[["$","h2",null,{"children":"Next useful step"}],[["$","$L4","scholarships/italy",{"href":"/scholarships/italy/","children":["Scholarships in Italy for international students"," ",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/study-in-italy-admission-english-requirements",{"href":"/guides/study-in-italy-admission-english-requirements/","children":["Italy IELTS requirements, accepted tests and MOI rules"," ",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]]}]]}]
