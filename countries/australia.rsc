2d:["$","section","4-Compare city costs with the award",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Compare city costs with the award"}],[["$","p","Calculate tuition, student health cover, accommodation, transport, food, travel and initial deposits. Ask when the stipend starts and whether relocation, fieldwork or dependants receive support.",{"children":"Calculate tuition, student health cover, accommodation, transport, food, travel and initial deposits. Ask when the stipend starts and whether relocation, fieldwork or dependants receive support."}],["$","p","For research funding, confirm the normal degree duration and the conditions for extension. Keep admission, scholarship and visa planning as separate tasks.",{"children":"For research funding, confirm the normal degree duration and the conditions for extension. Keep admission, scholarship and visa planning as separate tasks."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2e:["$","section","5-Compare three funding routes before choosing a course",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Compare three funding routes before choosing a course"}],[["$","p","For Australia, first distinguish research training, coursework and country-based awards. The Australian Government’s Research Training Program is administered by eligible universities, with provider-specific selection and support. Australia Awards depends on participating-country arrangements. University coursework awards use their own eligibility and coverage.",{"children":"For Australia, first distinguish research training, coursework and country-based awards. The Australian Government’s Research Training Program is administered by eligible universities, with provider-specific selection and support. Australia Awards depends on participating-country arrangements. University coursework awards use their own eligibility and coverage."}],["$","p","These routes do not share one central application or a universal deadline. Read the official provider or country profile for your situation before collecting documents.",{"children":"These routes do not share one central application or a universal deadline. Read the official provider or country profile for your situation before collecting documents."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Australia funding route comparison","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Australia funding route comparison"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route",{"scope":"col","children":"Route"}],["$","th","Decision owner",{"scope":"col","children":"Decision owner"}],["$","th","Main check",{"scope":"col","children":"Main check"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Research Training Program"}],["$","td","1",{"children":"Eligible university"}],["$","td","2",{"children":"Research admission, selection round and benefit package"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Australia Awards"}],["$","td","1",{"children":"Official country arrangements"}],["$","td","2",{"children":"Citizenship, priority fields and programme conditions"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"University coursework award"}],["$","td","1",{"children":"University or programme"}],["$","td","2",{"children":"Admission, discount, renewal and living-cost gap"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2f:["$","section","6-For research, investigate supervision and project fit",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"For research, investigate supervision and project fit"}],[["$","p","Read whether the university expects a supervisor agreement, project application or a separate expression of interest. A general email asking for funding is less useful than a concise connection between your preparation and the proposed research.",{"children":"Read whether the university expects a supervisor agreement, project application or a separate expression of interest. A general email asking for funding is less useful than a concise connection between your preparation and the proposed research."}],["$","p","Describe your question, relevant methods, existing work and a plausible learning need. Do not claim that a supervisor has accepted you until you have confirmation under the institution’s process. Admission and scholarship consideration can still be separate decisions.",{"children":"Describe your question, relevant methods, existing work and a plausible learning need. Do not claim that a supervisor has accepted you until you have confirmation under the institution’s process. Admission and scholarship consideration can still be separate decisions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
30:["$","section","7-For coursework, calculate what remains after the award",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"For coursework, calculate what remains after the award"}],[["$","p","A tuition discount can make a programme more affordable without funding housing, insurance, travel or other costs. Ask what the percentage applies to, whether it lasts for the full programme and whether renewal has conditions.",{"children":"A tuition discount can make a programme more affordable without funding housing, insurance, travel or other costs. Ask what the percentage applies to, whether it lasts for the full programme and whether renewal has conditions."}],["$","p","Use a fictional example: a 25 percent reduction on a 20,000-unit fee would leave 15,000 before other expenses. If the award applies only to the first term, the overall programme calculation changes. These figures illustrate arithmetic and are not Australian tuition estimates.",{"children":"Use a fictional example: a 25 percent reduction on a 20,000-unit fee would leave 15,000 before other expenses. If the award applies only to the first term, the overall programme calculation changes. These figures illustrate arithmetic and are not Australian tuition estimates."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
31:["$","section","8-Read duration and obligations before accepting",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Read duration and obligations before accepting"}],[["$","p","Record tuition offset, stipend, health cover, establishment support, travel and any other benefits as separate components. Confirm the period, payment start, renewal and possible extension. Personal or family expenses may need their own budget.",{"children":"Record tuition offset, stipend, health cover, establishment support, travel and any other benefits as separate components. Confirm the period, payment start, renewal and possible extension. Personal or family expenses may need their own budget."}],["$","p","For a country-based award, read conditions concerning study area, return and other obligations in the actual offer. Do not generalise one applicant’s conditions to every nationality or funding programme.",{"children":"For a country-based award, read conditions concerning study area, return and other obligations in the actual offer. Do not generalise one applicant’s conditions to every nationality or funding programme."}],["$","p","Keep the offer, university handbook and relevant funding conditions together. If they appear inconsistent, seek written clarification from the decision owner before making a financial commitment.",{"children":"Keep the offer, university handbook and relevant funding conditions together. If they appear inconsistent, seek written clarification from the decision owner before making a financial commitment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
32:["$","section","9-Turn the shortlist into a complete application plan",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"Turn the shortlist into a complete application plan"}],[["$","p","A fictional applicant finds a suitable research group but discovers that scholarship selection closes earlier than general admission. They organise references and a proposal around the funding round instead of waiting for the later date. Another applicant seeking coursework researches partial aid and confirms a viable personal budget.",{"children":"A fictional applicant finds a suitable research group but discovers that scholarship selection closes earlier than general admission. They organise references and a proposal around the funding round instead of waiting for the later date. Another applicant seeking coursework researches partial aid and confirms a viable personal budget."}],["$","p","The correct next step depends on the funding model. Start a separate row for each programme and record documents, conditions, course and funding dates, and decisions pending.",{"children":"The correct next step depends on the funding model. Start a separate row for each programme and record documents, conditions, course and funding dates, and decisions pending."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L33",null,{"id":"countries/australia:section-10","title":"Check your progress","items":["Research or coursework route established","Official funding owner identified","Supervisor requirements checked where relevant","Benefit components and duration recorded","Insurance and arrival costs planned","Conditions and deadline sources saved"]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Turn the shortlist into a complete application plan","children":[["$","$L4","/scholarships/phd/",{"href":"/scholarships/phd/","children":["Compare doctoral funding models",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/scholarship-application/",{"href":"/guides/scholarship-application/","children":["Build the complete application plan",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/fully-funded/",{"href":"/scholarships/fully-funded/","children":["Check what full funding covers",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
