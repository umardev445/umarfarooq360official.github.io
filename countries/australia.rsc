29:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Do I apply for RTP through one government portal?",{"children":[["$","summary",null,{"children":["Do I apply for RTP through one government portal?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The government directs applicants to eligible universities. Follow the provider’s research admission and scholarship process."}]]}],["$","details","Are Australia Awards available to every nationality?",{"children":[["$","summary",null,{"children":["Are Australia Awards available to every nationality?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Confirm participation and conditions in the official country or regional information."}]]}],["$","details","Does a tuition discount pay my living expenses?",{"children":[["$","summary",null,{"children":["Does a tuition discount pay my living expenses?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not unless the award explicitly covers them. Budget the remaining fee, housing, insurance, travel and other costs separately."}]]}]]}]]}]
