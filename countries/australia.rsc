27:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-Research and coursework routes differ",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Research and coursework routes differ"}],[["$","p","Research degrees may be supported through university Research Training Program allocations and institution scholarships. Coursework awards are more often partial tuition discounts based on academic merit.",{"children":"Research degrees may be supported through university Research Training Program allocations and institution scholarships. Coursework awards are more often partial tuition discounts based on academic merit."}],["$","p","Read whether scholarship consideration is automatic with admission or requires a separate form, and confirm health-cover arrangements.",{"children":"Read whether scholarship consideration is automatic with admission or requires a separate form, and confirm health-cover arrangements."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Separate research and coursework funding searches",{"children":"Separate research and coursework funding searches"}],["$","li","Check scholarship closing rounds",{"children":"Check scholarship closing rounds"}],["$","li","Confirm supervisor requirements",{"children":"Confirm supervisor requirements"}],["$","li","Budget Overseas Student Health Cover",{"children":"Budget Overseas Student Health Cover"}],["$","li","Read renewal and academic-progress conditions",{"children":"Read renewal and academic-progress conditions"}]]}],"$undefined","$undefined","$undefined"]}],["$","section","2-Apply through the correct Australian route",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Apply through the correct Australian route"}],[["$","p","Research Training Program support is administered by eligible universities, so applicants contact and apply through the chosen provider rather than sending an application to the Australian Government department. Universities set their own selection process, closing rounds and scholarship package.",{"children":"Research Training Program support is administered by eligible universities, so applicants contact and apply through the chosen provider rather than sending an application to the Australian Government department. Universities set their own selection process, closing rounds and scholarship package."}],["$","p","Australia Awards uses participating-country profiles and local application arrangements. Eligibility, priority study areas and dates can differ by citizenship. The official DFAT page and the relevant country profile are the final sources.",{"children":"Australia Awards uses participating-country profiles and local application arrangements. Eligibility, priority study areas and dates can differ by citizenship. The official DFAT page and the relevant country profile are the final sources."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Compare award value, conditions and timing",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Compare award value, conditions and timing"}],[["$","p","Check whether an award provides a tuition-fee offset, living stipend, establishment support, travel and health cover, and whether each benefit lasts for the full degree. Also read progress, deferral, work and return-home conditions before accepting.",{"children":"Check whether an award provides a tuition-fee offset, living stipend, establishment support, travel and health cover, and whether each benefit lasts for the full degree. Also read progress, deferral, work and return-home conditions before accepting."}]],"$undefined","$undefined","$undefined","$undefined","$L2c","$undefined","$undefined","$undefined"]}],"$L2d","$L2e","$L2f","$L30","$L31","$L32"]}]
