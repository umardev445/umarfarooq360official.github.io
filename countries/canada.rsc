1d:["$","section",null,{"className":"content-block","aria-labelledby":"relevant-listings","children":[["$","div",null,{"className":"content-block__heading","children":[["$","h2",null,{"id":"relevant-listings","children":"Relevant opportunities"}],["$","p",null,{"children":"1 official-source records match this topic. Check category and applicant conditions before applying."}]]}],["$","$L22",null,{"items":[{"id":"lester-b-pearson-2027","title":"Lester B. Pearson International Scholarship 2027","provider":"University of Toronto","type":"Scholarship","level":"Bachelor's","country":"Canada","region":"North America","funding":"Fully funded","deadline":"School nomination: 9 Oct; admission: 16 Oct; scholarship: 6 Nov 2026","deadlineDate":"2026-10-09","milestones":[{"label":"School nomination","date":"2026-10-09","detail":"School acts first; later deadlines do not replace nomination."},{"label":"Undergraduate admission","date":"2026-10-16","detail":"Student follows the University of Toronto route."},{"label":"Scholarship form and documents","date":"2026-11-06","detail":"Nominated student uses the official invitation."}],"status":"Open","summary":"School nomination and the required admission deadline have passed. Applicants who completed both steps can submit their scholarship form and documents by 6 November 2026 through their private university invitation.","tags":["University of Toronto","School nomination","Undergraduate"],"source":"https://future.utoronto.ca/pearson-scholarships","sourceLabel":"University of Toronto official scholarship page","checked":"23 October 2026","featured":true,"entryDeadlineDate":"2026-10-09","entryClosedNote":"School nomination closed on 9 October. Remaining admission and award deadlines apply to already nominated candidates."}],"showTypeFilter":false}]]}]
1e:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-Where Canadian funding is found",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Where Canadian funding is found"}],[["$","p","Start at the department and graduate faculty, not only the central scholarship page. Funding packages can combine teaching assistantships, research assistantships, entrance awards and supervisor support.",{"children":"Start at the department and graduate faculty, not only the central scholarship page. Funding packages can combine teaching assistantships, research assistantships, entrance awards and supervisor support."}],["$","p","At undergraduate level, large entrance awards are highly selective and usually require early admission applications or school nomination.",{"children":"At undergraduate level, large entrance awards are highly selective and usually require early admission applications or school nomination."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Compare gross funding with tuition and city costs",{"children":"Compare gross funding with tuition and city costs"}],["$","li","Ask whether funding is guaranteed each year",{"children":"Ask whether funding is guaranteed each year"}],["$","li","Check supervisor contact expectations",{"children":"Check supervisor contact expectations"}],["$","li","Review province-specific study requirements",{"children":"Review province-specific study requirements"}],["$","li","Confirm award eligibility for international status",{"children":"Confirm award eligibility for international status"}]]}],"$undefined","$undefined","$undefined"]}],["$","section","2-Separate undergraduate awards from graduate funding packages",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Separate undergraduate awards from graduate funding packages"}],[["$","p","Major undergraduate awards can require nomination before the normal application closes. For the University of Toronto's 2027 Lester B. Pearson cycle, the official page lists a school-nomination deadline, an admission deadline and a later scholarship-application deadline. Missing the first step cannot be repaired by submitting only the scholarship form.",{"children":"Major undergraduate awards can require nomination before the normal application closes. For the University of Toronto's 2027 Lester B. Pearson cycle, the official page lists a school-nomination deadline, an admission deadline and a later scholarship-application deadline. Missing the first step cannot be repaired by submitting only the scholarship form."}],["$","p","Research master's and doctoral funding is often assembled by the university or department from an entrance award, supervisor grant and teaching or research work. Compare the written package after tuition and mandatory fees, and ask whether each component is guaranteed or conditional.",{"children":"Research master's and doctoral funding is often assembled by the university or department from an entrance award, supervisor grant and teaching or research work. Compare the written package after tuition and mandatory fees, and ask whether each component is guaranteed or conditional."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Questions to ask before accepting Canadian funding",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Questions to ask before accepting Canadian funding"}],[["$","p","Read the offer and programme handbook together. A headline annual amount may include employment that has separate hours, duties and renewal rules.",{"children":"Read the offer and programme handbook together. A headline annual amount may include employment that has separate hours, duties and renewal rules."}]],"$undefined","$undefined","$undefined","$undefined","$L23","$undefined","$undefined","$undefined"]}],"$L24","$L25","$L26"]}]
1f:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://future.utoronto.ca/pearson-scholarships",{"href":"https://future.utoronto.ca/pearson-scholarships","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Lester B. Pearson International Scholarship"}],["$","span",null,{"children":"University of Toronto official eligibility and 2027 deadlines"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://www.mcgill.ca/gradapplicants/funding",{"href":"https://www.mcgill.ca/gradapplicants/funding","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"McGill graduate funding overview"}],["$","span",null,{"children":"Example of institution-led graduate funding"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$1f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
20:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Are Canadian scholarships automatically considered with admission?",{"children":[["$","summary",null,{"children":["Are Canadian scholarships automatically considered with admission?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Some are, but many are not. Major awards may require a separate form, early admission or school nomination. Read the official award page and the department's funding instructions."}]]}],["$","details","Does a funded PhD offer cover the full cost of living in Canada?",{"children":[["$","summary",null,{"children":["Does a funded PhD offer cover the full cost of living in Canada?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not necessarily. Compare the net amount after tuition and fees with housing, food, transport and insurance in the specific city, and check whether part of the package requires paid work."}]]}],["$","details","Do Canadian scholarships use one national application system?",{"children":[["$","summary",null,{"children":["Do Canadian scholarships use one national application system?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. University awards, research funding and external scholarships can have different application routes. Check the specific institution and award owner."}]]}],["$","details","Can an undergraduate scholarship require school nomination?",{"children":[["$","summary",null,{"children":["Can an undergraduate scholarship require school nomination?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Some major awards, including the University of Toronto Pearson route, use a school nomination before later admission and scholarship steps. Follow the current official sequence."}]]}],["$","details","How should I evaluate a graduate funding offer in Canada?",{"children":[["$","summary",null,{"children":["How should I evaluate a graduate funding offer in Canada?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Ask for the guaranteed amount, duration, tuition and compulsory fees, assistantship duties, renewal conditions and what remains after charges. Then compare the net amount with costs in the actual city."}]]}]]}]]}]
