32:["$","section","3-Match the application owner to your route",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Match the application owner to your route"}],[["$","p","A Type A application normally follows a dispatching authority such as an embassy or national nominating body. A Type B application follows the designated university’s instructions. Shanghai and university awards have their own processes. A university admission account and a scholarship account can be separate submissions; completing one does not automatically complete the other.",{"children":"A Type A application normally follows a dispatching authority such as an embassy or national nominating body. A Type B application follows the designated university’s instructions. Shanghai and university awards have their own processes. A university admission account and a scholarship account can be separate submissions; completing one does not automatically complete the other."}],["$","p","Pakistani applicants using HEC should use the dedicated HEC guide in this cluster. Its reviewed 2026/27 round is closed. That does not mean all university routes are closed, and a university opening does not reopen HEC’s national nomination round.",{"children":"Pakistani applicants using HEC should use the dedicated HEC guide in this cluster. Its reviewed 2026/27 round is closed. That does not mean all university routes are closed, and a university opening does not reopen HEC’s national nomination round."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
33:["$","section","4-Build a shortlist you can actually complete",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Build a shortlist you can actually complete"}],[["$","p","Create a working shortlist of three to five programmes. Record the official URL, intake, deadline, timezone when stated, required tests, fee and required portals. Mark a deadline as unverified if the page describes another year. Remove a course when you cannot meet a compulsory requirement; a longer list does not compensate for an ineligible application.",{"children":"Create a working shortlist of three to five programmes. Record the official URL, intake, deadline, timezone when stated, required tests, fee and required portals. Mark a deadline as unverified if the page describes another year. Remove a course when you cannot meet a compulsory requirement; a longer list does not compensate for an ineligible application."}]],["$","ol",null,{"className":"process-steps","aria-label":"Build a shortlist you can actually complete","children":[["$","li","Confirm programme and funding eligibility together",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Confirm programme and funding eligibility together"}]]}],["$","li","Reserve time for language tests and undergraduate CSCA requirements where applicable",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Reserve time for language tests and undergraduate CSCA requirements where applicable"}]]}],["$","li","Request transcripts, translations and references early",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Request transcripts, translations and references early"}]]}],["$","li","Prepare a course-specific study plan or research proposal",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Prepare a course-specific study plan or research proposal"}]]}],["$","li","Complete each required portal and save submission evidence",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Complete each required portal and save submission evidence"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
34:["$","section","5-Use the ten-guide China pathway",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Use the ten-guide China pathway"}],[["$","p","The funding overview explains CSC coverage and selection. The application guide handles documents and submission. The Type A versus Type B comparison resolves route choice. University guides then show the differences that matter for a particular institution. Use those pages as a linked workflow instead of submitting a generic document pack everywhere.",{"children":"The funding overview explains CSC coverage and selection. The application guide handles documents and submission. The Type A versus Type B comparison resolves route choice. University guides then show the differences that matter for a particular institution. Use those pages as a linked workflow instead of submitting a generic document pack everywhere."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Use the ten-guide China pathway","children":[["$","$L4","/scholarships/chinese-government-scholarship/",{"href":"/scholarships/chinese-government-scholarship/","children":["CSC funding overview",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/csc-scholarship-application/",{"href":"/guides/csc-scholarship-application/","children":["CSC application steps",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/csc-scholarship-type-a-vs-type-b/",{"href":"/guides/csc-scholarship-type-a-vs-type-b/","children":["Type A vs Type B",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/hec-chinese-government-scholarship/",{"href":"/guides/hec-chinese-government-scholarship/","children":["HEC Pakistan route",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/shanghai-government-scholarship/",{"href":"/scholarships/shanghai-government-scholarship/","children":["Shanghai scholarship",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/zhejiang-university-admissions-scholarships/",{"href":"/guides/zhejiang-university-admissions-scholarships/","children":["Zhejiang admissions",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/xiamen-university-admissions-scholarships/",{"href":"/guides/xiamen-university-admissions-scholarships/","children":["Xiamen admissions",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/jiangsu-university-admissions-scholarships/",{"href":"/guides/jiangsu-university-admissions-scholarships/","children":["Jiangsu admissions",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/shandong-university-admissions-scholarships/",{"href":"/guides/shandong-university-admissions-scholarships/","children":["Shandong admissions",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
35:["$","section","6-Admission, scholarship and travel are separate decisions",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Admission, scholarship and travel are separate decisions"}],[["$","p","An academic offer is not always a scholarship award. A scholarship nomination is not necessarily the final result. Wait for the official decision and read its conditions before making non-refundable travel commitments. Verify the study location, start date and original-document checks in the university’s registration instructions.",{"children":"An academic offer is not always a scholarship award. A scholarship nomination is not necessarily the final result. Wait for the official decision and read its conditions before making non-refundable travel commitments. Verify the study location, start date and original-document checks in the university’s registration instructions."}],["$","p","Keep a copy of every submitted form and of the notice used to prepare it. If the programme changes a requirement, you can ask a precise question rather than relying on an agent’s summary. AspireCompass provides independent guidance and does not accept scholarship applications or promise selection.",{"children":"Keep a copy of every submitted form and of the notice used to prepare it. If the programme changes a requirement, you can ask a precise question rather than relying on an agent’s summary. AspireCompass provides independent guidance and does not accept scholarship applications or promise selection."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
36:["$","section","7-China: continue with the right admission and funding route",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"China: continue with the right admission and funding route"}],[["$","p","Use these connected guides to compare institution rules, funding conditions and the next application task. Each guide identifies the official sources and the cycle it describes.",{"children":"Use these connected guides to compare institution rules, funding conditions and the next application task. Each guide identifies the official sources and the cycle it describes."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for China: continue with the right admission and funding route","children":[["$","$L4","/guides/tsinghua-university-admissions-scholarships/",{"href":"/guides/tsinghua-university-admissions-scholarships/","children":["Tsinghua University admissions and scholarships for international students",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/peking-university-admissions-scholarships/",{"href":"/guides/peking-university-admissions-scholarships/","children":["Peking University admissions and scholarships: choose the right funding route",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/china-universities-without-application-fees/",{"href":"/guides/china-universities-without-application-fees/","children":["Chinese universities without application fees: verified routes and conditions",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
37:["$","section","8-Explore the next steps in this study pathway",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Explore the next steps in this study pathway"}],[["$","p","Choose the institution, funding or preparation task that matches your situation. The guides separate admission, funding and administrative decisions.",{"children":"Choose the institution, funding or preparation task that matches your situation. The guides separate admission, funding and administrative decisions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Explore the next steps in this study pathway","children":[["$","$L4","/guides/csca-exam/",{"href":"/guides/csca-exam/","children":["CSCA exam: requirements, subjects and registration",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/china-student-visa-x1-x2/",{"href":"/guides/china-student-visa-x1-x2/","children":["China student visa: X1, X2 and the document pathway",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/ustc-scholarships-admissions/",{"href":"/guides/ustc-scholarships-admissions/","children":["USTC scholarships and international admissions",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/cas-anso/",{"href":"/scholarships/cas-anso/","children":["CAS-ANSO scholarship: USTC, UCAS and the application route",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides