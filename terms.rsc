1f:["$","section","3-Your responsibilities",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Your responsibilities"}],[["$","p","You are responsible for checking current official eligibility, deadlines, time zones, costs, document rules and application routes. You are also responsible for the accuracy and legality of material you submit to an external programme.",{"children":"You are responsible for checking current official eligibility, deadlines, time zones, costs, document rules and application routes. You are also responsible for the accuracy and legality of material you submit to an external programme."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Use the official programme portal",{"children":"Use the official programme portal"}],["$","li","Protect account credentials and personal documents",{"children":"Protect account credentials and personal documents"}],["$","li","Respect deadlines and local law",{"children":"Respect deadlines and local law"}],["$","li","Do not misrepresent qualifications or experience",{"children":"Do not misrepresent qualifications or experience"}],["$","li","Keep independent copies of applications and receipts",{"children":"Keep independent copies of applications and receipts"}]]}],"$undefined","$undefined","$undefined"]}]
20:["$","section","4-Acceptable use",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Acceptable use"}],[["$","p","You may browse, link to and use limited extracts for personal, non-commercial research with appropriate attribution. You may not interfere with the site, bypass controls, introduce malicious code, impersonate AspireCompass, harvest personal data or copy substantial parts of the database for republication or sale.",{"children":"You may browse, link to and use limited extracts for personal, non-commercial research with appropriate attribution. You may not interfere with the site, bypass controls, introduce malicious code, impersonate AspireCompass, harvest personal data or copy substantial parts of the database for republication or sale."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","5-Intellectual property and programme names",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Intellectual property and programme names"}],[["$","p","Original site design, explanations, selection frameworks and compilations are protected to the extent permitted by law. Scholarship, university, organisation and employer names and marks belong to their respective owners. Mentioning them does not imply sponsorship or endorsement.",{"children":"Original site design, explanations, selection frameworks and compilations are protected to the extent permitted by law. Scholarship, university, organisation and employer names and marks belong to their respective owners. Mentioning them does not imply sponsorship or endorsement."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","6-External links and third-party services",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"External links and third-party services"}],[["$","p","Links are provided for convenience and verification. AspireCompass does not control an external site's availability, content, security, fees or data practices. Your relationship with a programme, advertiser or other third party is governed by its own terms and policies.",{"children":"Links are provided for convenience and verification. AspireCompass does not control an external site's availability, content, security, fees or data practices. Your relationship with a programme, advertiser or other third party is governed by its own terms and policies."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","7-Service changes and liability",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Service changes and liability"}],[["$","p","The website, pages and features may be corrected, changed, suspended or withdrawn. To the maximum extent permitted by applicable law, AspireCompass is not liable for losses arising from reliance on outdated information, an external site, missed deadlines, application decisions, malware outside our control or interruption of the service. Nothing in these terms excludes liability that cannot legally be excluded.",{"children":"The website, pages and features may be corrected, changed, suspended or withdrawn. To the maximum extent permitted by applicable law, AspireCompass is not liable for losses arising from reliance on outdated information, an external site, missed deadlines, application decisions, malware outside our control or interruption of the service. Nothing in these terms excludes liability that cannot legally be excluded."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","8-Changes and contact",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Changes and contact"}],[["$","p","These terms may be revised as the website changes. Continued use after an update means the revised terms apply from the stated date. Questions or reports of misuse can be sent through the contact information published on AspireCompass.",{"children":"These terms may be revised as the website changes. Continued use after an update means the revised terms apply from the stated date. Questions or reports of misuse can be sent through the contact information published on AspireCompass."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
