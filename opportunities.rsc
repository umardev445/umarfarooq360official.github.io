23:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","How do I know whether an opportunity shown here is still open?",{"children":[["$","summary",null,{"children":["How do I know whether an opportunity shown here is still open?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Use the status and deadline as a screening signal, then open the linked programme-owner page before preparing or submitting an application. The official call is the final authority."}]]}],["$","details","Why are scholarships, internships and fellowships separated?",{"children":[["$","summary",null,{"children":["Why are scholarships, internships and fellowships separated?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"They use different eligibility and selection models. Filtering by opportunity type prevents a student scholarship requirement from being confused with an employer or fellowship requirement."}]]}],["$","details","What should I record before adding an opportunity to my shortlist?",{"children":[["$","summary",null,{"children":["What should I record before adding an opportunity to my shortlist?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Record the official owner, applicant eligibility, degree or career level, deadline with time zone, funding or pay, application route and any separate university or nomination step."}]]}]]}]]}]
