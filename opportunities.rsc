19:T40b,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I know whether an opportunity shown here is still open?","acceptedAnswer":{"@type":"Answer","text":"Use the status and deadline as a screening signal, then open the linked programme-owner page before preparing or submitting an application. The official call is the final authority."}},{"@type":"Question","name":"Why are scholarships, internships and fellowships separated?","acceptedAnswer":{"@type":"Answer","text":"They use different eligibility and selection models. Filtering by opportunity type prevents a student scholarship requirement from being confused with an employer or fellowship requirement."}},{"@type":"Question","name":"What should I record before adding an opportunity to my shortlist?","acceptedAnswer":{"@type":"Answer","text":"Record the official owner, applicant eligibility, degree or career level, deadline with time zone, funding or pay, application route and any separate university or nomination step."}}]}1:["$","main",null,{"id":"main-content","className":"$undefined","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CollectionPage\",\"@id\":\"https://aspirecompass.org/opportunities/\",\"name\":\"Scholarships, internships and early-career opportunities\",\"description\":\"Browse scholarships, internships, fellowships and graduate programmes with status, deadlines, eligibility guidance and direct official programme links.\",\"url\":\"https://aspirecompass.org/opportunities/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-08-31\",\"dateModified\":\"2026-10-13\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/study-planning-1280.webp\",\"caption\":\"Students comparing study options with a laptop, notes and a map\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompa