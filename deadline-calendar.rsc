1a:T5fc,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Why is my local deadline different?","acceptedAnswer":{"@type":"Answer","text":"Programme deadlines can be stated in UTC, UK time, U.S. time or the host-country time zone. Convert the exact date and time and account for daylight-saving rules."}},{"@type":"Question","name":"Are nomination deadlines shown here?","acceptedAnswer":{"@type":"Answer","text":"Not always. Commonwealth, exchange and government routes may have a university, embassy or national nominator deadline earlier than the central deadline. Check every required organisation."}},{"@type":"Question","name":"Why can one scholarship have more than one deadline?","acceptedAnswer":{"@type":"Answer","text":"Some programmes separate nomination, university admission, scholarship submission, references and later offer requirements. Treat each required action as its own dated task."}},{"@type":"Question","name":"Which deadline should I trust if two websites show different dates?","acceptedAnswer":{"@type":"Answer","text":"Use the current programme-owner or university page for the relevant intake. Check the year and time zone, because archived calls and copied listings can remain searchable."}},{"@type":"Question","name":"How early should I plan to submit?","acceptedAnswer":{"@type":"Answer","text":"Aim to finish before the final day so references, uploads and portal issues do not become last-minute failures. The official deadline remains the controlling date."}}]}1:["$","main",null,{"id":"main-content","className":"$undefined","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/deadline-calendar/\",\"name\":\"Scholarship and opportunity deadline calendar\",\"description\":\"Track scholarship and opportunity deadlines, distinguish nomination and admission dates, and reopen offi