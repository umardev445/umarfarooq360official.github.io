23:["$","article",null,{"className":"article-body ","children":[["$","section","0-Work backwards from submission",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Work backwards from submission"}],[["$","p","A deadline is the final moment, not the target submission date. Allow extra time for referees, certified documents, test scores, portal errors and time-zone differences.",{"children":"A deadline is the final moment, not the target submission date. Allow extra time for referees, certified documents, test scores, portal errors and time-zone differences."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Six to eight weeks: shortlist and request references",{"children":"Six to eight weeks: shortlist and request references"}],["$","li","Four weeks: complete first essays and document checks",{"children":"Four weeks: complete first essays and document checks"}],["$","li","Two weeks: finalise programme-specific answers",{"children":"Two weeks: finalise programme-specific answers"}],["$","li","Three days: submit and save confirmation",{"children":"Three days: submit and save confirmation"}]]}],"$undefined","$undefined","$undefined"]}],["$","section","1-Understand every status label",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Understand every status label"}],[["$","p","Open means an official current cycle is accepting applications; opening soon means the owner has announced a future window; rolling means vacancies or reviews continue without one universal date; check official site means the date varies or a new cycle is not confirmed; closed means the listed cycle has passed.",{"children":"Open means an official current cycle is accepting applications; opening soon means the owner has announced a future window; rolling means vacancies or reviews continue without one universal date; check official site means the date varies or a new cycle is not confirmed; closed means the listed cycle has passed."}],["$","p","A date can be correct while a local submission time is different. Convert the stated time zone, check whether a nominating body has an earlier deadline and aim to submit at least several days early.",{"children":"A date can be correct while a local submission time is different. Convert the stated time zone, check whether a nominating body has an earlier deadline and aim to submit at least several days early."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","2-What to do when a deadline is unconfirmed",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"What to do when a deadline is unconfirmed"}],[["$","p","Use the previous cycle only to estimate preparation time, never as a current deadline. Subscribe to the programme owner's updates if available, prepare reusable documents and wait for the official call before finalising programme-specific answers.",{"children":"Use the previous cycle only to estimate preparation time, never as a current deadline. Subscribe to the programme owner's updates if available, prepare reusable documents and wait for the official call before finalising programme-specific answers."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-A weekly deadline routine",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"A weekly deadline routine"}],[["$","p","Review your shortlist once a week. Reopen each official page, record changes, follow up with referees and move your internal submission date earlier when a portal or nomination step is complicated.",{"children":"Review your shortlist once a week. Reopen each official page, record changes, follow up with referees and move your internal submission date earlier when a portal or nomination step is complicated."}]],"$undefined","$undefined","$undefined","$undefined","$L25","$undefined","$undefined","$undefined"]}],"$L26"]}]
24:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Why is my local deadline different?",{"children":[["$","summary",null,{"children":["Why is my local deadline different?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Programme deadlines can be stated in UTC, UK time, U.S. time or the host-country time zone. Convert the exact date and time and account for daylight-saving rules."}]]}],["$","details","Are nomination deadlines shown here?",{"children":[["$","summary",null,{"children":["Are nomination deadlines shown here?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not always. Commonwealth, exchange and government routes may have a university, embassy or national nominator deadline earlier than the central deadline. Check every required organisation."}]]}],["$","details","Why can one scholarship have more than one deadline?",{"children":[["$","summary",null,{"children":["Why can one scholarship have more than one deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Some programmes separate nomination, university admission, scholarship submission, references and later offer requirements. Treat each required action as its own dated task."}]]}],["$","details","Which deadline should I trust if two websites show different dates?",{"children":[["$","summary",null,{"children":["Which deadline should I trust if two websites show different dates?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Use the current programme-owner or university page for the relevant intake. Check the year and time zone, because archived calls and copied listings can remain searchable."}]]}],["$","details","How early should I plan to submit?",{"children":[["$","summary",null,{"children":["How early should I plan to submit?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Aim to finish before the final day so references, uploads and portal issues do not become last-minute failures. The official deadline remains the controlling date."}]]}]]}]]}]
25:["$","ul",null,{"children":[["$","li","Monday: check official notices",{"children":"Monday: check official notices"}],["$","li","Tuesday: update documents and evidence",{"children":"Tuesday: update documents and evidence"}],["$","li","Wednesday: draft programme-specific responses",{"children":"Wednesday: draft programme-specific responses"}],["$","li","Thursday: obtain feedback",{"children":"Thursday: obtain feedback"}],["$","li","Friday: submit completed applications and save receipts",{"children":"Friday: submit completed applications and save receipts"}]]}]
26:["$","section","4-One award can have multiple deadlines",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"One award can have multiple deadlines"}],[["$","p","Pearson's school nomination closed on 9 October 2026. Its later admission and scholarship-form dates are for already nominated students. The calendar keeps those remaining tasks visible with a continuing-applicant label instead of presenting a fresh nomination opportunity.",{"children":"Pearson's school nomination closed on 9 October 2026. Its later admission and scholarship-form dates are for already nominated students. The calendar keeps those remaining tasks visible with a continuing-applicant label instead of presenting a fresh nomination opportunity."}],["$","p","Chevening and Knight-Hennessy's named 2027 rounds are closed. Commonwealth's listed central closing time is 20 October 2026 at 16:00 BST, and nominators can close earlier. KAUST's published Fall 2027 deadline is 3 January 2027, subject to the official timeline's tentative-date notice.",{"children":"Chevening and Knight-Hennessy's named 2027 rounds are closed. Commonwealth's listed central closing time is 20 October 2026 at 16:00 BST, and nominators can close earlier. KAUST's published Fall 2027 deadline is 3 January 2027, subject to the official timeline's tentative-date notice."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","School or sending-partner nomination",{"children":"School or sending-partner nomination"}],["$","li","Scholarship portal submission",{"children":"Scholarship portal submission"}],["$","li","University admission or offer",{"children":"University admission or offer"}],["$","li","Language documents and interview",{"children":"Language documents and interview"}],["$","li","Exact local time and time zone",{"children":"Exact local time and time zone"}]]}],"$undefined","$undefined","$undefined"]}]
