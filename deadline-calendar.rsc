20:["$","div",null,{"className":"site-shell content-layout content-layout--wide","children":[["$","div",null,{"className":"content-main","children":[false,["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Use dated records to see the next milestone, and check rolling or variable-date programmes separately."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Identify the deadline owner, applicant category, year, closing time and required submission."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents mobile-contents--wide","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Work backwards from submission",{"href":"#section-1","children":"Work backwards from submission"}],["$","a","Understand every status label",{"href":"#section-2","children":"Understand every status label"}],["$","a","What to do when a deadline is unconfirmed",{"href":"#section-3","children":"What to do when a deadline is unconfirmed"}],["$","a","A weekly deadline routine",{"href":"#section-4","children":"A weekly deadline routine"}],["$","a","One award can have multiple deadlines",{"href":"#section-5","children":"One award can have multiple deadlines"}]]}]]}],false,false,false,false,false,false,false,false,false,["$","$L22",null,{"items":[{"id":"chevening-2027","title":"Chevening Scholarships 2027–2028","provider":"UK Government","type":"Scholarship","level":"Master's","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"6 October 2026, 11:00 UTC","deadlineDate":"2026-10-06","deadlineAt":"2026-10-06T11:00:00Z","status":"Closed","summary":"The 2027–2028 scholarship application round is closed. Existing applicants should follow the official assessment, interview and later university-offer instructions.","tags":["Leadership","International students","One-year master's"],"source":"https://www.chevening.org/scholarships/","sourceLabel":"Chevening official website","checked":"13 October 2026","featured":false},{"id":"schwarzman-2027","title":"Schwarzman Scholars 2027–2028","provider":"Schwarzman Scholars","type":"Scholarship","level":"Master's","country":"China","region":"Asia","funding":"Fully funded","deadline":"9 September 2026, 3:00 p.m. EDT","deadlineDate":"2026-09-09","status":"Closed","summary":"The 2027–2028 global application is closed. The next U.S./Global application cycle is expected from April to September 2027.","tags":["Global affairs","Leadership","Tsinghua University"],"source":"https://www.schwarzmanscholars.org/admissions/application-instructions/","sourceLabel":"Schwarzman Scholars official website","checked":"13 October 2026","featured":true},{"id":"knight-hennessy-2027","title":"Knight-Hennessy Scholars 2027","provider":"Stanford University","type":"Scholarship","level":"Graduate","country":"United States","region":"North America","funding":"Fully funded","deadline":"6 October 2026, 1:00 p.m. PT","deadlineDate":"2026-10-06","deadlineAt":"2026-10-06T13:00:00-07:00","status":"Closed","summary":"The 2027 KHS application is closed. Existing candidates must still follow their separate Stanford degree deadlines; the next KHS cohort is announced to open in summer 2027.","tags":["Stanford","Graduate study","Leadership"],"source":"https://knight-hennessy.stanford.edu/admission","sourceLabel":"Knight-Hennessy official website","checked":"13 October 2026","featured":false},{"id":"rhodes-2027","title":"Rhodes Scholarship 2027","provider":"Rhodes Trust","type":"Scholarship","level":"Graduate","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"Varies by constituency","status":"Check official site","summary":"Postgraduate study at the University of Oxford for academically excellent, service-oriented young leaders.","tags":["Oxford","Postgraduate","Leadership"],"source":"https://www.rhodeshouse.ox.ac.uk/scholarships/applications/","sourceLabel":"Rhodes Trust official website","checked":"13 October 2026","featured":true},{"id":"gates-cambridge-2027","title":"Gates Cambridge Scholarship","provider":"University of Cambridge","type":"Scholarship","level":"Graduate","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"US citizens residing in the US: 14 Oct 2026; other applicants: check the course funding deadline","deadlineDate":"$undefined","milestones":"$undefined","status":"Check official site","summary":"Cambridge confirms 14 October 2026 for US citizens residing in the US. Other eligible applicants use an international round linked to their course funding deadline; verify that date in the current course portal.","tags":["Cambridge","Master's","PhD"],"source":"https://www.student-funding.cam.ac.uk/fund/gates-us-fund-2026","sourceLabel":"University of Cambridge: 2027–2028 Gates US round","checked":"13 October 2026","featured":true},{"id":"commonwealth-masters-2027","title":"Commonwealth Master's Scholarships 2027–2028","provider":"Commonwealth Scholarship Commission","type":"Scholarship","level":"Master's","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"20 October 2026, 16:00 BST","deadlineDate":"2026-10-20","status":"Closed","summary":"The published central 2027–2028 deadline of 20 October 2026 at 16:00 BST has passed. Existing applicants should retain confirmations and follow CSC and nominator instructions; check the official portal for any amendment.","tags":["Commonwealth","Development","Master's"],"source":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-masters-scholarships/","sourceLabel":"Commonwealth Scholarship Commission","checked":"21 October 2026","featured":false,"deadlineAt":"2026-10-20T16:00:00+01:00"},{"id":"commonwealth-phd-2027","title":"Commonwealth PhD Scholarships 2027–2028","provider":"Commonwealth Scholarship Commission","type":"Scholarship","level":"PhD","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"20 October 2026, 16:00 BST","deadlineDate":"2026-10-20","status":"Closed","summary":"The published central 2027–2028 deadline of 20 October 2026 at 16:00 BST has passed. Existing applicants should retain confirmations and follow CSC and nominator instructions; check the official portal for any amendment.","tags":["Commonwealth","Research","PhD"],"source":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-phd-scholarships-for-least-developed-countries-and-vulnerable-states/","sourceLabel":"Commonwealth Scholarship Commission","checked":"21 October 2026","featured":false,"deadlineAt":"2026-10-20T16:00:00+01:00"},{"id":"erasmus-mundus-2027","title":"Erasmus Mundus Joint Masters 2027","provider":"European Union","type":"Scholarship","level":"Master's","country":"Multiple European countries","region":"Europe","funding":"Fully funded","deadline":"Consortium-specific; check the current programme call","status":"Check official site","summary":"Joint master's programmes use their own calls and scholarship deadlines. The European Commission describes many applications between October and January, but this umbrella record is not a confirmed open call.","tags":["Europe","Joint degree","Mobility"],"source":"https://erasmus-plus.ec.europa.eu/opportunities/individuals/students/erasmus-mundus-joint-masters","sourceLabel":"European Commission – Erasmus+","checked":"13 October 2026","featured":true},{"id":"daad-epos-2027","title":"DAAD EPOS Scholarships 2027–2028","provider":"DAAD","type":"Scholarship","level":"Graduate","country":"Germany","region":"Europe","funding":"Fully funded","deadline":"Varies by selected postgraduate course","status":"Check official site","summary":"Development-related postgraduate funding for graduates from eligible countries, generally requiring at least two years of professional experience.","tags":["Germany","Development","Professional experience"],"source":"https://www2.daad.de/deutschland/stipendium/datenbank/en/21148-scholarship-database/?detail=50076777","sourceLabel":"DAAD scholarship database","checked":"13 October 2026","featured":true},{"id":"kaust-2027","title":"KAUST Graduate Admission & Fellowship 2027","provider":"King Abdullah University of Science and Technology","type":"Graduate Program","level":"Graduate","country":"Saudi Arabia","region":"Middle East","funding":"Fully funded","deadline":"Fall 2027: 3 January 2027","deadlineDate":"2027-01-03","status":"Open","summary":"Fall 2027 applications are open for MS, MS/PhD and PhD study with KAUST Fellowship support for admitted graduate students.","tags":["STEM","MS","PhD"],"source":"https://admissions.kaust.edu.sa/how-to-apply/admission-timelines","sourceLabel":"KAUST Admissions","checked":"13 October 2026","featured":true},{"id":"mext-2027","title":"Japanese Government MEXT Scholarships","provider":"Government of Japan","type":"Scholarship","level":"Any degree","country":"Japan","region":"Asia","funding":"Fully funded","deadline":"Varies by embassy or university route","status":"Check official site","summary":"Japanese government scholarships for international students selected through embassy, university or authority recommendation routes.","tags":["Japan","Embassy route","University route"],"source":"https://www.mext.go.jp/en/policy/education/highered/title02/detail02/sdetail02/1373897.htm","sourceLabel":"MEXT official website","checked":"13 October 2026","featured":true},{"id":"fulbright-foreign-student","title":"Fulbright Foreign Student Program","provider":"U.S. Department of State","type":"Scholarship","level":"Graduate","country":"United States","region":"North America","funding":"Funded","deadline":"Varies by home country","status":"Check official site","summary":"Approximately 4,000 annual grants for foreign graduate students, young professionals and artists; local rules vary by country.","tags":["USA","Master's","Research"],"source":"https://foreign.fulbrightonline.org/apply","sourceLabel":"Foreign Fulbright Program","checked":"13 October 2026"},{"id":"stipendium-hungaricum","title":"Stipendium Hungaricum Scholarship","provider":"Government of Hungary","type":"Scholarship","level":"Any degree","country":"Hungary","region":"Europe","funding":"Funded","deadline":"2027–2028 call not confirmed on the official apply page checked 13 October","status":"Check official site","summary":"The official apply page still describes 2026–2027 and its past 15 January 2026 deadline. Prepare by sending-partner route; do not reuse that date for an unannounced future cycle.","tags":["Hungary","Bachelor's","Master's","PhD"],"source":"https://stipendiumhungaricum.hu/apply/","sourceLabel":"Stipendium Hungaricum official website","checked":"13 October 2026"},{"id":"lester-b-pearson-2027","title":"Lester B. Pearson International Scholarship 2027","provider":"University of Toronto","type":"Scholarship","level":"Bachelor's","country":"Canada","region":"North America","funding":"Fully funded","deadline":"School nomination: 9 Oct; admission: 16 Oct; scholarship: 6 Nov 2026","deadlineDate":"2026-10-09","milestones":[{"label":"School nomination","date":"2026-10-09","detail":"School acts first; later deadlines do not replace nomination."},{"label":"Undergraduate admission","date":"2026-10-16","detail":"Student follows the University of Toronto route."},{"label":"Scholarship form and documents","date":"2026-11-06","detail":"Nominated student uses the official invitation."}],"status":"Open","summary":"School nomination is closed. Already nominated students must complete university admission by 16 October and the scholarship form by 6 November 2026. Later deadlines do not replace nomination.","tags":["University of Toronto","School nomination","Undergraduate"],"source":"https://future.utoronto.ca/pearson-scholarships","sourceLabel":"University of Toronto official scholarship page","checked":"13 October 2026","featured":true,"entryDeadlineDate":"2026-10-09","entryClosedNote":"School nomination closed on 9 October. Remaining admission and award deadlines apply to already nominated candidates."},{"id":"australia-awards-scholarships","title":"Australia Awards Scholarships","provider":"Australian Government Department of Foreign Affairs and Trade","type":"Scholarship","level":"Any degree","country":"Australia","region":"Oceania","funding":"Fully funded","deadline":"Country-specific; check the participating-country profile","status":"Check official site","summary":"Long-term undergraduate and postgraduate awards for eligible developing-country applicants, with benefits generally including tuition, travel, living support and health cover.","tags":["Developing countries","Government scholarship","Return-home condition"],"source":"https://www.dfat.gov.au/people-to-people/australia-awards/australia-awards-scholarships","sourceLabel":"Australian Government DFAT","checked":"13 October 2026","featured":true},{"id":"australia-rtp","title":"Australian Government Research Training Program","provider":"Australian Government Department of Education","type":"Scholarship","level":"PhD","country":"Australia","region":"Oceania","funding":"Funded","deadline":"University-specific; apply through an eligible Australian provider","status":"Check official site","summary":"University-administered support for eligible research doctorate and research master's students that may include a tuition-fee offset, stipend and research-related allowances.","tags":["Research degree","University application","Tuition and stipend"],"source":"https://www.education.gov.au/research-block-grants/research-training-program","sourceLabel":"Australian Government Department of Education","checked":"13 October 2026"},{"id":"unicef-internships","title":"UNICEF Internship Programme","provider":"UNICEF","type":"Internship","level":"Student","country":"Multiple countries","region":"Global","funding":"Paid","deadline":"Vacancy-specific","status":"Rolling","summary":"Hands-on global internship opportunities for students and recent graduates from diverse academic backgrounds.","tags":["United Nations","Students","Recent graduates"],"source":"https://www.unicef.org/careers/internships","sourceLabel":"UNICEF Careers","checked":"13 October 2026","featured":true},{"id":"cern-short-term","title":"CERN Short-Term Internship","provider":"CERN","type":"Internship","level":"Student","country":"Switzerland","region":"Europe","funding":"Funded","deadline":"Live position and nationality restrictions apply","status":"Check official site","summary":"Student internships use live positions and enrolment conditions. The official page currently excludes several nationalities, including Pakistani nationals, because an associate-membership ceiling has been reached.","tags":["STEM","Europe","1–6 months"],"source":"https://careers.cern/programmes/short-term-internship/","sourceLabel":"CERN Careers","checked":"13 October 2026"},{"id":"cern-summer","title":"CERN Summer Studentship","provider":"CERN","type":"Internship","level":"Student","country":"Switzerland","region":"Europe","funding":"Funded","deadline":"Annual cycle; check programme page","status":"Check official site","summary":"Scientific and technical project work, expert lectures and an international research experience for eligible university students.","tags":["Summer","Physics","Engineering","Computing"],"source":"https://careers.cern/programmes/summer-studentship/","sourceLabel":"CERN Careers","checked":"13 October 2026"},{"id":"oecd-internship","title":"OECD Internship Programme","provider":"OECD","type":"Internship","level":"Student","country":"France / Remote","region":"Global","funding":"Paid","deadline":"Applications accepted throughout the year","status":"Rolling","summary":"Policy-focused internships for students who remain enrolled in an accredited degree programme for the internship duration.","tags":["Policy","Hybrid","Remote possible"],"source":"https://www.oecd.org/en/about/careers/internships.html","sourceLabel":"OECD Careers","checked":"13 October 2026","featured":true},{"id":"un-internships","title":"United Nations Internships","provider":"United Nations","type":"Internship","level":"Student","country":"Multiple countries","region":"Global","funding":"Varies","deadline":"Vacancy-specific","status":"Rolling","summary":"Internship openings across UN duty stations and functions for students and recent graduates; conditions vary by vacancy.","tags":["United Nations","Global","Multiple fields"],"source":"https://careers.un.org/","sourceLabel":"UN Careers","checked":"2 October 2026"},{"id":"oecd-young-associates","title":"OECD Young Associates Programme","provider":"OECD","type":"Graduate Program","level":"Graduate","country":"France","region":"Europe","funding":"Paid","deadline":"Cohort-specific","status":"Check official site","summary":"A two-year early-career programme for recent undergraduates interested in policy making, research and analysis.","tags":["Early career","Policy","Two years"],"source":"https://www.oecd.org/en/about/careers/young-associates.html","sourceLabel":"OECD Careers","checked":"13 October 2026"},{"id":"humphrey-fellowship","title":"Hubert H. Humphrey Fellowship Program","provider":"U.S. Department of State","type":"Fellowship","level":"Graduate","country":"United States","region":"North America","funding":"Funded","deadline":"Varies by U.S. embassy or Fulbright commission","status":"Check official site","summary":"A ten-month non-degree professional enrichment programme for eligible mid-career leaders with a public-service commitment.","tags":["Mid-career","Professional development","Public service"],"source":"https://www.humphreyfellowship.org/how-to-apply/","sourceLabel":"Humphrey Fellowship official website","checked":"13 October 2026","featured":true},{"id":"erasmus-study-exchange","title":"Erasmus+ Study Abroad Exchange","provider":"European Union","type":"Exchange","level":"Student","country":"Multiple European countries","region":"Europe","funding":"Funded","deadline":"Set by the participating home institution","status":"Check official site","summary":"Supported study mobility for eligible short-cycle, bachelor's, master's and doctoral students through participating institutions.","tags":["Student mobility","Europe","Institution nomination"],"source":"https://erasmus-plus.ec.europa.eu/opportunities/individuals/students/studying-abroad","sourceLabel":"European Commission – Erasmus+","checked":"13 October 2026"},{"id":"un-young-professionals","title":"United Nations Young Professionals Programme","provider":"United Nations","type":"Entry-Level","level":"Graduate","country":"Multiple duty stations","region":"Global","funding":"Paid","deadline":"Annual exam cycle; participating countries vary","status":"Check official site","summary":"A competitive examination and recruitment initiative for qualified nationals of participating countries to begin a UN professional career.","tags":["International civil service","Competitive exam","Early career"],"source":"https://careers.un.org/young-professionals-programme","sourceLabel":"UN Careers","checked":"2 October 2026","featured":true},{"id":"cern-origin","title":"CERN Origin Programme for University Graduates","provider":"CERN","type":"Graduate Program","level":"Graduate","country":"Switzerland","region":"Europe","funding":"Paid","deadline":"Position-specific","status":"Rolling","summary":"Entry-level scientific, technical and administrative roles for recent graduates. Current nationality ceilings apply to some countries, including Pakistan.","tags":["Early graduate","STEM","Administration"],"source":"https://careers.cern/programmes/entry-level-university-graduates/","sourceLabel":"CERN Careers","checked":"13 October 2026","featured":true},{"id":"italy-maeci-2026-27","title":"MAECI Italian Government Grants 2026–2027","provider":"Italian Ministry of Foreign Affairs and International Cooperation","type":"Scholarship","level":"Graduate","country":"Italy","region":"Europe","funding":"Funded","deadline":"26 March 2026, 14:00 Italian time — closed","deadlineDate":"2026-03-26","status":"Closed","summary":"The current call is closed. MAECI grants use an annual eligible-country list and the official Study in Italy application portal for study carried out in Italy.","tags":["Italian Government","MAECI","Study in Italy"],"source":"https://www.esteri.it/en/servizi-opportunita/opportunita/borse-di-studio/per-cittadini-stranieri/borsestudio_stranieri/","sourceLabel":"Italian Ministry of Foreign Affairs","checked":"13 October 2026"},{"id":"italy-ergo-dsu-2026-27","title":"ER.GO Regional Scholarship 2026–2027","provider":"ER.GO Emilia-Romagna","type":"Scholarship","level":"Any degree","country":"Italy","region":"Europe","funding":"Funded","deadline":"24 August 2026, 16:00 — main scholarship deadline closed","deadlineDate":"2026-08-24","status":"Closed","summary":"Regional right-to-study support assessed under ER.GO's economic, enrolment and merit rules, with separate guidance for families holding income or assets abroad.","tags":["DSU","Emilia-Romagna","Income assessed"],"source":"https://www.er-go.it/cosa-fare-per/bandi-di-concorso/leggi-il-bando","sourceLabel":"ER.GO official 2026–2027 call","checked":"13 October 2026"},{"id":"padua-international-excellence-2026-27","title":"Padua International Excellence Scholarship","provider":"University of Padua","type":"Scholarship","level":"Any degree","country":"Italy","region":"Europe","funding":"Funded","deadline":"2027–2028 award terms: verify on the official scholarship page","status":"Check official site","summary":"The 2026–2027 scheme offered €8,000 gross per year plus a tuition-fee exemption for selected international students in eligible English-taught degrees.","tags":["Padua","Merit","English-taught degree"],"source":"https://www.unipd.it/en/padua-international-excellence-scholarship-programme","sourceLabel":"University of Padua","checked":"13 October 2026","featured":true},{"id":"polimi-merit-scholarships-2027-28","title":"Politecnico di Milano International Merit Scholarships","provider":"Politecnico di Milano","type":"Scholarship","level":"Master's","country":"Italy","region":"Europe","funding":"Funded","deadline":"15 December 2026, noon Italian time; early admission payment required by 1 December","deadlineDate":"2026-12-15","deadlineAt":"2026-12-15T12:00:00+01:00","milestones":[{"label":"Required early admission payment","date":"2026-12-01","detail":"Confirm your eligible early-bird route and closing time."},{"label":"Merit scholarship form","date":"2026-12-15","at":"2026-12-15T12:00:00+01:00","detail":"Noon Italian time; prior admission conditions apply."}],"status":"Open","summary":"The 2027–2028 merit call has a separate form closing 15 December at noon Italian time, after qualifying early admission payment by 1 December. The PDF lists an acceptance administrative fee around €190; check award-specific benefits and English evidence.","tags":["Polimi","Master of Science","Tuition waiver"],"source":"https://www.polimi.it/en/prospective-students/how-much-does-it-cost/scholarships","sourceLabel":"Politecnico di Milano","checked":"13 October 2026","featured":true},{"id":"schwarzman-2028-announced","title":"Schwarzman Scholars 2028–2029 — announced next cycle","provider":"Schwarzman Scholars","type":"Scholarship","level":"Master's","country":"China","region":"Asia","funding":"Fully funded","status":"Opening soon","deadline":"U.S./Global application period: April–September 2027; exact dates to verify","summary":"The official instructions announce the next U.S./Global cycle for April–September 2027, with the programme beginning August 2028. Chinese-citizenship applicants have a different March–May 2027 period. Applications are not open in this record.","tags":["Announced future cycle","Leadership","Different citizenship routes"],"source":"https://www.schwarzmanscholars.org/admissions/application-instructions/","sourceLabel":"Schwarzman official application instructions","checked":"13 October 2026"}],"initialNow":"2026-10-22T14:46:03.183Z"}],false,false,false,false,false,false,"$L23",false,null,"$L24"]}],false]}]
