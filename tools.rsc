20:["$","article",null,{"className":"article-body ","children":[["$","section","0-Choose the right tool for your next decision",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Choose the right tool for your next decision"}],[["$","p","Start with the scholarship finder when you need a shortlist by degree level, destination, funding and application status. Use the GPA calculator to understand a credit-weighted result, the IELTS calculator to compare an estimated overall band with a course target, and the Italy calculator to separate living, academic and arrival costs.",{"children":"Start with the scholarship finder when you need a shortlist by degree level, destination, funding and application status. Use the GPA calculator to understand a credit-weighted result, the IELTS calculator to compare an estimated overall band with a course target, and the Italy calculator to separate living, academic and arrival costs."}],["$","p","The tools work without an account and do not ask you to upload a transcript, test report or identity document. Read the explanation below each result so you understand what the number can and cannot establish.",{"children":"The tools work without an account and do not ask you to upload a transcript, test report or identity document. Read the explanation below each result so you understand what the number can and cannot establish."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","1-A safer scholarship research workflow",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"A safer scholarship research workflow"}],[["$","p","A calculator can organise information, but it cannot confirm eligibility. After using a tool, open the linked official programme or university source and check the current intake, nationality rules, academic threshold, language condition, funding and deadline.",{"children":"A calculator can organise information, but it cannot confirm eligibility. After using a tool, open the linked official programme or university source and check the current intake, nationality rules, academic threshold, language condition, funding and deadline."}],["$","p","Keep a research sheet with the official URL, the date checked and any unanswered requirement. This reduces the risk of relying on an old summary or applying to a programme that does not fit your profile.",{"children":"Keep a research sheet with the official URL, the date checked and any unanswered requirement. This reduces the risk of relying on an old summary or applying to a programme that does not fit your profile."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Shortlist programmes with the scholarship finder",{"children":"Shortlist programmes with the scholarship finder"}],["$","li","Compare your original academic scale with the published threshold",{"children":"Compare your original academic scale with the published threshold"}],["$","li","Check both overall and component language requirements",{"children":"Check both overall and component language requirements"}],["$","li","Verify every condition on the official source",{"children":"Verify every condition on the official source"}],["$","li","Save evidence and deadlines in one application tracker",{"children":"Save evidence and deadlines in one application tracker"}]]}],"$undefined","$undefined","$undefined"]}],["$","section","2-Privacy and result limitations",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Privacy and result limitations"}],[["$","p","The calculators run in your browser. AspireCompass does not ask for account credentials or store the grades and bands you enter in these tools. Avoid sharing passports, transcripts, bank records or login details with unofficial scholarship services.",{"children":"The calculators run in your browser. AspireCompass does not ask for account credentials or store the grades and bands you enter in these tools. Avoid sharing passports, transcripts, bank records or login details with unofficial scholarship services."}],"$L22"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L23"]}]
21:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Are the AspireCompass tools free?",{"children":[["$","summary",null,{"children":["Are the AspireCompass tools free?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. The GPA and IELTS calculators and scholarship finder are free to use and do not require an account."}]]}],["$","details","Do the tools confirm scholarship eligibility?",{"children":[["$","summary",null,{"children":["Do the tools confirm scholarship eligibility?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. They support planning and shortlisting. Only the programme owner can confirm eligibility under the current official rules."}]]}],["$","details","Does AspireCompass store grades or IELTS bands entered here?",{"children":[["$","summary",null,{"children":["Does AspireCompass store grades or IELTS bands entered here?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The calculator inputs are processed in your browser and are not submitted as an application or official record."}]]}],["$","details","What should I do after using a calculator?",{"children":[["$","summary",null,{"children":["What should I do after using a calculator?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Open the relevant official university or programme source, verify the current requirement and record the source and date checked."}]]}]]}]]}]
22:["$","p","Universities can use institution-specific grade conversions, and courses can require minimum IELTS component scores in addition to an overall band. Always preserve the original result and follow the receiving institution's stated method.",{"children":"Universities can use institution-specific grade conversions, and courses can require minimum IELTS component scores in addition to an overall band. Always preserve the original result and follow the receiving institution's stated method."}]
