1a:["$","section","3-No admission, funding or employment guarantee",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"No admission, funding or employment guarantee"}],[["$","p","Eligibility does not guarantee selection, and a strong application does not create a right to an award. AspireCompass cannot predict or influence admissions, scholarships, interviews, jobs, fellowships, exchange nominations or immigration decisions.",{"children":"Eligibility does not guarantee selection, and a strong application does not create a right to an award. AspireCompass cannot predict or influence admissions, scholarships, interviews, jobs, fellowships, exchange nominations or immigration decisions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1b:["$","section","4-Funding labels need verification",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Funding labels need verification"}],[["$","p","Terms such as fully funded, funded and paid summarise a programme's published description. Benefits may exclude tests, document preparation, dependants, deposits, visa-related charges, insurance, travel or costs above a stipend. Build a personal budget from the official award terms.",{"children":"Terms such as fully funded, funded and paid summarise a programme's published description. Benefits may exclude tests, document preparation, dependants, deposits, visa-related charges, insurance, travel or costs above a stipend. Build a personal budget from the official award terms."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1c:["$","section","5-No legal, immigration, financial or medical advice",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"No legal, immigration, financial or medical advice"}],[["$","p","Country, visa, work-right, tax, cost and safety discussion is general. Seek current information from the relevant authority and a qualified professional when your situation requires personalised advice. Do not make a financial commitment solely from an AspireCompass page.",{"children":"Country, visa, work-right, tax, cost and safety discussion is general. Seek current information from the relevant authority and a qualified professional when your situation requires personalised advice. Do not make a financial commitment solely from an AspireCompass page."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","6-Examples and application guidance",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Examples and application guidance"}],[["$","p","Writing examples are illustrative and must not be copied as personal work. Applicants are responsible for truthfulness, originality, privacy and compliance with each institution's rules, including any limits on AI or third-party assistance.",{"children":"Writing examples are illustrative and must not be copied as personal work. Applicants are responsible for truthfulness, originality, privacy and compliance with each institution's rules, including any limits on AI or third-party assistance."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","7-External websites and advertising",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"External websites and advertising"}],[["$","p","AspireCompass does not control external content or transactions. Advertising, if displayed, helps support the website but does not convert an advertiser into an endorsed opportunity or give it influence over editorial conclusions.",{"children":"AspireCompass does not control external content or transactions. Advertising, if displayed, helps support the website but does not convert an advertiser into an endorsed opportunity or give it influence over editorial conclusions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
