57:["$","section","2-A four-week improvement cycle",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"A four-week improvement cycle"}],[["$","p","In week one, map the official criteria and gather facts. In week two, build document outlines from evidence. In week three, tailor the programme fit and obtain feedback. In week four, check consistency, uploads, time zones and submission receipts.",{"children":"In week one, map the official criteria and gather facts. In week two, build document outlines from evidence. In week three, tailor the programme fit and obtain feedback. In week four, check consistency, uploads, time zones and submission receipts."}],["$","p","Extend the timeline when you need testing, a passport, certification, translation or references. Compressing those dependencies into the final week creates errors that better writing cannot solve.",{"children":"Extend the timeline when you need testing, a passport, certification, translation or references. Compressing those dependencies into the final week creates errors that better writing cannot solve."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
58:["$","section","3-Use examples as instruction, never as copy",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Use examples as instruction, never as copy"}],[["$","p","Any illustrative sentence on AspireCompass demonstrates a principle such as evidence, reflection or programme connection. Replace it entirely with your own facts and voice. Copied applications can breach institutional rules and usually sound generic in an interview.",{"children":"Any illustrative sentence on AspireCompass demonstrates a principle such as evidence, reflection or programme connection. Replace it entirely with your own facts and voice. Copied applications can breach institutional rules and usually sound generic in an interview."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
59:["$","section","4-Keep official instructions beside the guide",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Keep official instructions beside the guide"}],[["$","p","Open the programme prompt while using a guide. If its required structure, word limit, document name or AI policy conflicts with general advice, the programme instruction wins. Save the final version and submission confirmation in a secure personal folder.",{"children":"Open the programme prompt while using a guide. If its required structure, word limit, document name or AI policy conflicts with general advice, the programme instruction wins. Save the final version and submission confirmation in a secure personal folder."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
