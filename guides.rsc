2d:["$","article",null,{"className":"article-body ","children":[["$","section","0-Start with the decision before the document",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Start with the decision before the document"}],[["$","p","A polished essay cannot repair a failed eligibility rule or a missed nomination step. Begin with the scholarship application guide, define your target profile and confirm the official process. Then use the specialist guides for the document or stage creating the next bottleneck.",{"children":"A polished essay cannot repair a failed eligibility rule or a missed nomination step. Begin with the scholarship application guide, define your target profile and confirm the official process. Then use the specialist guides for the document or stage creating the next bottleneck."}],["$","p","The resource directory groups application and destination pages, while this guide centre explains how the advice fits together. You do not need to complete every article before applying; select the one that helps you make the next accurate decision.",{"children":"The resource directory groups application and destination pages, while this guide centre explains how the advice fits together. You do not need to complete every article before applying; select the one that helps you make the next accurate decision."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Research: eligibility, funding and application route",{"children":"Research: eligibility, funding and application route"}],["$","li","Evidence: CV and achievement bank",{"children":"Evidence: CV and achievement bank"}],["$","li","Writing: SOP, motivation letter and programme fit",{"children":"Writing: SOP, motivation letter and programme fit"}],["$","li","Support: referees and document checks",{"children":"Support: referees and document checks"}],["$","li","Selection: interviews and practical assessments",{"children":"Selection: interviews and practical assessments"}]]}],"$undefined","$undefined","$undefined"]}],["$","section","1-A four-week improvement cycle",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"A four-week improvement cycle"}],[["$","p","In week one, map the official criteria and gather facts. In week two, build document outlines from evidence. In week three, tailor the programme fit and obtain feedback. In week four, check consistency, uploads, time zones and submission receipts.",{"children":"In week one, map the official criteria and gather facts. In week two, build document outlines from evidence. In week three, tailor the programme fit and obtain feedback. In week four, check consistency, uploads, time zones and submission receipts."}],["$","p","Extend the timeline when you need testing, a passport, certification, translation or references. Compressing those dependencies into the final week creates errors that better writing cannot solve.",{"children":"Extend the timeline when you need testing, a passport, certification, translation or references. Compressing those dependencies into the final week creates errors that better writing cannot solve."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","2-Use examples as instruction, never as copy",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Use examples as instruction, never as copy"}],[["$","p","Any illustrative sentence on AspireCompass demonstrates a principle such as evidence, reflection or programme connection. Replace it entirely with your own facts and voice. Copied applications can breach institutional rules and usually sound generic in an interview.",{"children":"Any illustrative sentence on AspireCompass demonstrates a principle such as evidence, reflection or programme connection. Replace it entirely with your own facts and voice. Copied applications can breach institutional rules and usually sound generic in an interview."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L40","$L41","$L42"]}]
2e:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Which AspireCompass guide should I read first?",{"children":[["$","summary",null,{"children":["Which AspireCompass guide should I read first?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Start with the complete scholarship application guide unless you have already verified eligibility and process. Then choose the document-specific guide that matches your next task."}]]}],["$","details","Are the guides written for one country?",{"children":[["$","summary",null,{"children":["Are the guides written for one country?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Most principles are global, but programme and country rules vary. Destination pages and official sources provide context that a general guide cannot replace."}]]}],["$","details","Do the guides guarantee a scholarship?",{"children":[["$","summary",null,{"children":["Do the guides guarantee a scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. They help you make a clearer, safer application. Selection belongs entirely to the programme owner and depends on eligibility, competition and its published criteria."}]]}],["$","details","Can I use AI to write my application?",{"children":[["$","summary",null,{"children":["Can I use AI to write my application?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Check the programme's policy. Where assistance is permitted, protect private data, verify every fact and ensure the final work is genuinely yours. Never fabricate evidence or conceal prohibited assistance."}]]}]]}]]}]
