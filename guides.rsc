30:["$","section","3-Keep official instructions beside the guide",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Keep official instructions beside the guide"}],[["$","p","Open the programme prompt while using a guide. If its required structure, word limit, document name or AI policy conflicts with general advice, the programme instruction wins. Save the final version and submission confirmation in a secure personal folder.",{"children":"Open the programme prompt while using a guide. If its required structure, word limit, document name or AI policy conflicts with general advice, the programme instruction wins. Save the final version and submission confirmation in a secure personal folder."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
