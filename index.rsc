21:["$","section",null,{"id":"home-discovery","className":"section site-shell home-discovery","aria-labelledby":"finder-heading","children":[["$","div",null,{"className":"section-heading section-heading--split","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"Start with fit"}],["$","h2",null,{"id":"finder-heading","children":"Search less. Shortlist better."}],["$","p",null,{"children":"Compare programme routes by level and destination. Available and rolling routes appear before closed rounds; every card links to its official owner."}]]}],["$","$L5",null,{"className":"text-link","href":"/opportunities/","children":["Explore the full database ",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}],["$","$L34",null,{"items":[{"id":"chevening-2027","title":"Chevening Scholarships 2027–2028","provider":"UK Government","type":"Scholarship","level":"Master's","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"2027–2028 application round closed; follow the existing-applicant timeline","deadlineDate":"$undefined","deadlineAt":"$undefined","status":"Closed","summary":"The 2027–2028 scholarship application round is closed. Existing applicants should follow the official assessment, interview and later university-offer instructions.","tags":["Leadership","International students","One-year master's"],"source":"https://www.chevening.org/scholarship/pakistan/","sourceLabel":"Chevening Pakistan: current application status","checked":"28 October 2026","featured":false},{"id":"schwarzman-2027","title":"Schwarzman Scholars 2027–2028","provider":"Schwarzman Scholars","type":"Scholarship","level":"Master's","country":"China","region":"Asia","funding":"Fully funded","deadline":"9 September 2026, 3:00 p.m. EDT","deadlineDate":"2026-09-09","status":"Closed","summary":"The 2027–2028 global application is closed. The next U.S./Global application cycle is expected from April to September 2027.","tags":["Global affairs","Leadership","Tsinghua University"],"source":"https://www.schwarzmanscholars.org/admissions/application-instructions/","sourceLabel":"Schwarzman Scholars official website","checked":"23 October 2026","featured":true},{"id":"knight-hennessy-2027","title":"Knight-Hennessy Scholars 2027","provider":"Stanford University","type":"Scholarship","level":"Graduate","country":"United States","region":"North America","funding":"Fully funded","deadline":"6 October 2026, 1:00 p.m. PT","deadlineDate":"2026-10-06","deadlineAt":"2026-10-06T13:00:00-07:00","status":"Closed","summary":"The 2027 KHS application is closed. Existing candidates must still follow their separate Stanford degree deadlines; the next KHS cohort is announced to open in summer 2027.","tags":["Stanford","Graduate study","Leadership"],"source":"https://knight-hennessy.stanford.edu/admission","sourceLabel":"Knight-Hennessy official website","checked":"23 October 2026","featured":false},{"id":"rhodes-2027","title":"Rhodes Scholarship 2027","provider":"Rhodes Trust","type":"Scholarship","level":"Graduate","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"2027-entry round closed; next applications reopen in 2027 for 2028 entry","status":"Closed","summary":"Applications are closed. Prepare by constituency and eligible Oxford course; future-cycle exact dates must come from the next official call.","tags":["Oxford","Postgraduate","Leadership"],"source":"https://www.rhodeshouse.ox.ac.uk/scholarships/the-rhodes-scholarship/","sourceLabel":"Rhodes Trust: current application status","checked":"24 October 2026","featured":false},{"id":"gates-cambridge-2027","title":"Gates Cambridge Scholarship","provider":"University of Cambridge","type":"Scholarship","level":"Graduate","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"Course-specific: 8 Dec 2026 or 6 Jan 2027 at 23:59 GMT; US round closed","deadlineDate":"$undefined","milestones":"$undefined","status":"Check official site","summary":"Other eligible applicants use the exact course funding deadline. The January date is not an alternative for a December course; complete references by the applicable date.","tags":["Cambridge","Master's","PhD"],"source":"https://www.student-funding.cam.ac.uk/fund/gates-cambridge-scholarship-2026","sourceLabel":"Cambridge: Gates international round for 2027/28","checked":"3 November 2026","featured":true,"deadlineAt":"$undefined"},{"id":"commonwealth-masters-2027","title":"Commonwealth Master's Scholarships 2027–2028","provider":"Commonwealth Scholarship Commission","type":"Scholarship","level":"Master's","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"20 October 2026, 16:00 BST","deadlineDate":"2026-10-20","status":"Closed","summary":"The published central 2027–2028 deadline of 20 October 2026 at 16:00 BST has passed. Existing applicants should retain confirmations and follow CSC and nominator instructions; check the official portal for any amendment.","tags":["Commonwealth","Development","Master's"],"source":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-masters-scholarships/","sourceLabel":"Commonwealth Scholarship Commission","checked":"23 October 2026","featured":false,"deadlineAt":"2026-10-20T16:00:00+01:00"},{"id":"commonwealth-phd-2027","title":"Commonwealth PhD Scholarships 2027–2028","provider":"Commonwealth Scholarship Commission","type":"Scholarship","level":"PhD","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"20 October 2026, 16:00 BST","deadlineDate":"2026-10-20","status":"Closed","summary":"The published central 2027–2028 deadline of 20 October 2026 at 16:00 BST has passed. Existing applicants should retain confirmations and follow CSC and nominator instructions; check the official portal for any amendment.","tags":["Commonwealth","Research","PhD"],"source":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-phd-scholarships-for-least-developed-countries-and-vulnerable-states/","sourceLabel":"Commonwealth Scholarship Commission","checked":"23 October 2026","featured":false,"deadlineAt":"2026-10-20T16:00:00+01:00"},{"id":"erasmus-mundus-2027","title":"Erasmus Mundus Joint Masters 2027","provider":"European Union","type":"Scholarship","level":"Master's","country":"Multiple European countries","region":"Europe","funding":"Fully funded","deadline":"Consortium-specific; check the current programme call","status":"Check official site","summary":"Joint master's programmes use their own calls and scholarship deadlines. The European Commission describes many applications between October and January, but this umbrella record is not a confirmed open call.","tags":["Europe","Joint degree","Mobility"],"source":"https://erasmus-plus.ec.europa.eu/opportunities/individuals/students/erasmus-mundus-joint-masters","sourceLabel":"European Commission – Erasmus+","checked":"28 October 2026","featured":true,"deadlineDate":"$undefined","deadlineAt":"$undefined"},{"id":"daad-epos-2027","title":"DAAD EPOS Scholarships 2027–2028","provider":"DAAD","type":"Scholarship","level":"Graduate","country":"Germany","region":"Europe","funding":"Fully funded","deadline":"2027–2028 course list published; scholarship deadlines vary by course","status":"Check official site","summary":"DAAD links the 2027–2028 EPOS course list. Check eligible country, relevant degree and at least two years of related experience after the bachelor's degree. Submit to the selected course by its own scholarship deadline; an umbrella listing is not a confirmed open call.","tags":["Germany","Development","Professional experience"],"source":"https://www2.daad.de/deutschland/stipendium/datenbank/en/21148-scholarship-database/?detail=50076777","sourceLabel":"DAAD scholarship database","checked":"28 October 2026","featured":true,"deadlineDate":"$undefined","deadlineAt":"$undefined"},{"id":"kaust-2027","title":"KAUST Graduate Admission & Fellowship 2027","provider":"King Abdullah University of Science and Technology","type":"Graduate Program","level":"Graduate","country":"Saudi Arabia","region":"Middle East","funding":"Fully funded","deadline":"3 January 2027; Fall MS, MS/PhD and PhD; confirm portal cutoff","deadlineDate":"2027-01-03","status":"Open","summary":"Fall 2027 graduate admission with fellowship support, subject to sponsorship terms. Check current English requirements; Spring 2027 entry is closed to new applications.","tags":["STEM","MS","PhD"],"source":"https://admissions.kaust.edu.sa/how-to-apply/admission-timelines","sourceLabel":"KAUST current admission timeline","checked":"3 November 2026","featured":true,"deadlineAt":"$undefined","milestones":"$undefined"},{"id":"mext-2027","title":"Japanese Government MEXT Scholarships","provider":"Government of Japan","type":"Scholarship","level":"Any degree","country":"Japan","region":"Asia","funding":"Fully funded","deadline":"Varies by embassy or university route","status":"Check official site","summary":"Japanese government scholarships for international students selected through embassy, university or authority recommendation routes.","tags":["Japan","Embassy route","University route"],"source":"https://www.mext.go.jp/en/policy/education/highered/title02/detail02/sdetail02/1373897.htm","sourceLabel":"MEXT official website","checked":"13 October 2026","featured":true},{"id":"fulbright-foreign-student","title":"Fulbright Foreign Student Program","provider":"U.S. Department of State","type":"Scholarship","level":"Graduate","country":"United States","region":"North America","funding":"Funded","deadline":"Varies by home country","status":"Check official site","summary":"Approximately 4,000 annual grants for foreign graduate students, young professionals and artists; local rules vary by country.","tags":["USA","Master's","Research"],"source":"https://foreign.fulbrightonline.org/apply","sourceLabel":"Foreign Fulbright Program","checked":"13 October 2026"},{"id":"stipendium-hungaricum","title":"Stipendium Hungaricum Scholarship","provider":"Government of Hungary","type":"Scholarship","level":"Any degree","country":"Hungary","region":"Europe","funding":"Funded","deadline":"Apply page still labels 2026–2027; a 2027–2028 deadline is not confirmed here","status":"Check official site","summary":"On 28 October the official apply page still labels its calls 2026–2027. A registration button does not establish that a new funding round is open. Confirm the new call and sending-partner requirements before submitting.","tags":["Hungary","Bachelor's","Master's","PhD"],"source":"https://stipendiumhungaricum.hu/apply/","sourceLabel":"Stipendium Hungaricum official website","checked":"28 October 2026","deadlineDate":"$undefined","deadlineAt":"$undefined"},{"id":"lester-b-pearson-2027","title":"Lester B. Pearson International Scholarship 2027","provider":"University of Toronto","type":"Scholarship","level":"Bachelor's","country":"Canada","region":"North America","funding":"Fully funded","deadline":"School nomination: 9 Oct; admission: 16 Oct; scholarship: 6 Nov 2026","deadlineDate":"2026-10-09","milestones":[{"label":"School nomination","date":"2026-10-09","detail":"School acts first; later deadlines do not replace nomination."},{"label":"Undergraduate admission","date":"2026-10-16","detail":"Student follows the University of Toronto route."},{"label":"Scholarship form and documents","date":"2026-11-06","detail":"Nominated student uses the official invitation."}],"status":"Open","summary":"School nomination and the required admission deadline have passed. Applicants who completed both steps can submit their scholarship form and documents by 6 November 2026 through their private university invitation.","tags":["University of Toronto","School nomination","Undergraduate"],"source":"https://future.utoronto.ca/pearson-scholarships","sourceLabel":"University of Toronto official scholarship page","checked":"23 October 2026","featured":true,"entryDeadlineDate":"2026-10-09","entryClosedNote":"School nomination closed on 9 October. Remaining admission and award deadlines apply to already nominated candidates."},{"id":"australia-awards-scholarships","title":"Australia Awards Scholarships","provider":"Australian Government Department of Foreign Affairs and Trade","type":"Scholarship","level":"Any degree","country":"Australia","region":"Oceania","funding":"Fully funded","deadline":"Country-specific; check the participating-country profile","status":"Check official site","summary":"Long-term undergraduate and postgraduate awards for eligible developing-country applicants, with benefits generally including tuition, travel, living support and health cover.","tags":["Developing countries","Government scholarship","Return-home condition"],"source":"https://www.dfat.gov.au/people-to-people/australia-awards/australia-awards-scholarships","sourceLabel":"Australian Government DFAT","checked":"13 October 2026","featured":true},{"id":"australia-rtp","title":"Australian Government Research Training Program","provider":"Australian Government Department of Education","type":"Scholarship","level":"PhD","country":"Australia","region":"Oceania","funding":"Funded","deadline":"University-specific; apply through an eligible Australian provider","status":"Check official site","summary":"University-administered support for eligible research doctorate and research master's students that may include a tuition-fee offset, stipend and research-related allowances.","tags":["Research degree","University application","Tuition and stipend"],"source":"https://www.education.gov.au/research-block-grants/research-training-program","sourceLabel":"Australian Government Department of Education","checked":"13 October 2026"},{"id":"unicef-internships","title":"UNICEF Internship Programme","provider":"UNICEF","type":"Internship","level":"Student","country":"Multiple countries","region":"Global","funding":"Paid","deadline":"Vacancy-specific","status":"Rolling","summary":"Hands-on global internship opportunities for students and recent graduates from diverse academic backgrounds.","tags":["United Nations","Students","Recent graduates"],"source":"https://www.unicef.org/careers/internships","sourceLabel":"UNICEF Careers","checked":"13 October 2026","featured":true},{"id":"cern-short-term","title":"CERN Short-Term Internship","provider":"CERN","type":"Internship","level":"Student","country":"Switzerland","region":"Europe","funding":"Funded","deadline":"Live position and nationality restrictions apply","status":"Check official site","summary":"Student internships use live positions and enrolment conditions. The official page currently excludes several nationalities, including Pakistani nationals, because an associate-membership ceiling has been reached.","tags":["STEM","Europe","1–6 months"],"source":"https://careers.cern/programmes/short-term-internship/","sourceLabel":"CERN Careers","checked":"23 October 2026"},{"id":"cern-summer","title":"CERN Summer Studentship","provider":"CERN","type":"Internship","level":"Student","country":"Switzerland","region":"Europe","funding":"Funded","deadline":"Annual cycle; check programme page","status":"Check official site","summary":"Scientific and technical project work, expert lectures and an international research experience for eligible university students.","tags":["Summer","Physics","Engineering","Computing"],"source":"https://careers.cern/programmes/summer-studentship/","sourceLabel":"CERN Careers","checked":"13 October 2026"},{"id":"oecd-internship","title":"OECD Internship Programme","provider":"OECD","type":"Internship","level":"Student","country":"France","region":"Europe","funding":"Paid","deadline":"Applications accepted throughout the year","status":"Rolling","summary":"For eligible students enrolled throughout the placement. Most internships are in Paris. Check location and nationality rules; no general remote arrangement is assumed.","tags":["Policy","Enrolment required","Mostly Paris-based"],"source":"https://www.oecd.org/en/about/careers/internships.html","sourceLabel":"OECD Careers","checked":"2 November 2026","featured":true},{"id":"un-internships","title":"United Nations Internships","provider":"United Nations","type":"Internship","level":"Student","country":"Multiple countries","region":"Global","funding":"Varies","deadline":"Vacancy-specific","status":"Rolling","summary":"Internship openings across UN duty stations and functions for students and recent graduates; conditions vary by vacancy.","tags":["United Nations","Global","Multiple fields"],"source":"https://careers.un.org/","sourceLabel":"UN Careers","checked":"2 October 2026"},{"id":"oecd-young-associates","title":"OECD Young Associates Programme","provider":"OECD","type":"Graduate Program","level":"Graduate","country":"France","region":"Europe","funding":"Paid","deadline":"2026–2028 application period ended; next round not confirmed","status":"Closed","summary":"The 2026–2028 round is closed. This undergraduate route has OECD-member nationality and qualification restrictions. Retained for future planning.","tags":["Early career","Policy","Two years"],"source":"https://www.oecd.org/en/about/careers/young-associates.html","sourceLabel":"OECD Careers","checked":"2 November 2026"},{"id":"humphrey-fellowship","title":"Hubert H. Humphrey Fellowship Program","provider":"U.S. Department of State","type":"Fellowship","level":"Graduate","country":"United States","region":"North America","funding":"Funded","deadline":"Varies by U.S. embassy or Fulbright commission","status":"Check official site","summary":"A ten-month non-degree professional enrichment programme for eligible mid-career leaders with a public-service commitment.","tags":["Mid-career","Professional development","Public service"],"source":"https://www.humphreyfellowship.org/how-to-apply/","sourceLabel":"Humphrey Fellowship official website","checked":"13 October 2026","featured":true},{"id":"erasmus-study-exchange","title":"Erasmus+ Study Abroad Exchange","provider":"European Union","type":"Exchange","level":"Student","country":"Multiple European countries","region":"Europe","funding":"Funded","deadline":"Set by the participating home institution","status":"Check official site","summary":"Supported study mobility for eligible short-cycle, bachelor's, master's and doctoral students through participating institutions.","tags":["Student mobility","Europe","Institution nomination"],"source":"https://erasmus-plus.ec.europa.eu/opportunities/individuals/students/studying-abroad","sourceLabel":"European Commission – Erasmus+","checked":"13 October 2026"},{"id":"un-young-professionals","title":"United Nations Young Professionals Programme","provider":"United Nations","type":"Entry-Level","level":"Graduate","country":"Multiple duty stations","region":"Global","funding":"Paid","deadline":"Annual exam cycle; participating countries vary","status":"Check official site","summary":"An examination route for eligible nationals of the current participating-country list. A roster place does not guarantee employment; check the actual exam notice.","tags":["International civil service","Competitive exam","Early career"],"source":"https://careers.un.org/ypp","sourceLabel":"UN Careers","checked":"2 November 2026","featured":true},{"id":"cern-origin","title":"CERN Origin Programme for University Graduates","provider":"CERN","type":"Graduate Program","level":"Graduate","country":"Switzerland","region":"Europe","funding":"Paid","deadline":"Position-specific","status":"Rolling","summary":"Entry-level scientific, technical and administrative roles for recent graduates. Current nationality ceilings apply to some countries, including Pakistan.","tags":["Early graduate","STEM","Administration"],"source":"https://careers.cern/programmes/entry-level-university-graduates/","sourceLabel":"CERN Careers","checked":"13 October 2026","featured":true},{"id":"italy-maeci-2026-27","title":"MAECI Italian Government Grants 2026–2027","provider":"Italian Ministry of Foreign Affairs and International Cooperation","type":"Scholarship","level":"Graduate","country":"Italy","region":"Europe","funding":"Funded","deadline":"26 March 2026, 14:00 Italian time — closed","deadlineDate":"2026-03-26","status":"Closed","summary":"The current call is closed. MAECI grants use an annual eligible-country list and the official Study in Italy application portal for study carried out in Italy.","tags":["Italian Government","MAECI","Study in Italy"],"source":"https://www.esteri.it/en/servizi-opportunita/opportunita/borse-di-studio/per-cittadini-stranieri/borsestudio_stranieri/","sourceLabel":"Italian Ministry of Foreign Affairs","checked":"13 October 2026"},{"id":"italy-ergo-dsu-2026-27","title":"ER.GO Regional Scholarship 2026–2027","provider":"ER.GO Emilia-Romagna","type":"Scholarship","level":"Any degree","country":"Italy","region":"Europe","funding":"Funded","deadline":"24 August 2026, 16:00 — main scholarship deadline closed","deadlineDate":"2026-08-24","status":"Closed","summary":"Regional right-to-study support assessed under ER.GO's economic, enrolment and merit rules, with separate guidance for families holding income or assets abroad.","tags":["DSU","Emilia-Romagna","Income assessed"],"source":"https://www.er-go.it/cosa-fare-per/bandi-di-concorso/leggi-il-bando","sourceLabel":"ER.GO official 2026–2027 call","checked":"13 October 2026"},{"id":"padua-international-excellence-2026-27","title":"Padua International Excellence Scholarship","provider":"University of Padua","type":"Scholarship","level":"Any degree","country":"Italy","region":"Europe","funding":"Funded","deadline":"2027–2028 award terms: verify on the official scholarship page","status":"Check official site","summary":"The 2026–2027 scheme offered €8,000 gross per year plus a tuition-fee exemption for selected international students in eligible English-taught degrees.","tags":["Padua","Merit","English-taught degree"],"source":"https://www.unipd.it/en/padua-international-excellence-scholarship-programme","sourceLabel":"University of Padua","checked":"13 October 2026","featured":true},{"id":"polimi-merit-scholarships-2027-28","title":"Politecnico di Milano International Merit Scholarships","provider":"Politecnico di Milano","type":"Scholarship","level":"Master's","country":"Italy","region":"Europe","funding":"Funded","deadline":"15 December 2026, noon Italian time; early admission payment required by 1 December","deadlineDate":"2026-12-15","deadlineAt":"2026-12-15T12:00:00+01:00","milestones":[{"label":"Required early admission payment","date":"2026-12-01","detail":"Confirm your eligible early-bird route and closing time."},{"label":"Merit scholarship form","date":"2026-12-15","at":"2026-12-15T12:00:00+01:00","detail":"Noon Italian time; prior admission conditions apply."}],"status":"Open","summary":"The 2027–2028 merit call has a separate form closing 15 December at noon Italian time, after qualifying early admission payment by 1 December. The PDF lists an acceptance administrative fee around €190; check award-specific benefits and English evidence.","tags":["Polimi","Master of Science","Tuition waiver"],"source":"https://www.polimi.it/en/prospective-students/how-much-does-it-cost/scholarships","sourceLabel":"Politecnico di Milano","checked":"23 October 2026","featured":true},{"id":"schwarzman-2028-announced","title":"Schwarzman Scholars 2028–2029 — announced next cycle","provider":"Schwarzman Scholars","type":"Scholarship","level":"Master's","country":"China","region":"Asia","funding":"Fully funded","status":"Opening soon","deadline":"U.S./Global application period: April–September 2027; exact dates to verify","summary":"The official instructions announce the next U.S./Global cycle for April–September 2027, with the programme beginning August 2028. Chinese-citizenship applicants have a different March–May 2027 period. Applications are not open in this record.","tags":["Announced future cycle","Leadership","Different citizenship routes"],"source":"https://www.schwarzmanscholars.org/admissions/application-instructions/","sourceLabel":"Schwarzman official application instructions","checked":"23 October 2026"},{"id":"open-doors-2026","title":"Open Doors: 2026 competition for study in Russia","provider":"Global Universities Association","type":"Scholarship","level":"Graduate","supportedDegrees":["Bachelor's","Master's","PhD"],"country":"Russia","region":"Europe","funding":"Funded","deadline":"Registration closed 1 November 2026; later stages for existing candidates","deadlineDate":"2026-11-01","status":"Closed","summary":"New registration is closed. Existing candidates should follow results and next-stage instructions in their account. Later dates are not a new application window.","tags":["Bachelor’s","Master’s","PhD","Track-specific rules"],"source":"https://od.globaluni.ru/","sourceLabel":"Official Open Doors rules, schedule and FAQ","checked":"2 November 2026","featured":false},{"id":"kaust-vsrp","title":"KAUST Visiting Student Research Program","provider":"KAUST","type":"Internship","level":"Student","country":"Saudi Arabia","region":"Middle East","funding":"Fully funded","deadline":"Year-round; project availability and dates to confirm","status":"Rolling","summary":"A 2–6 month research placement with published student/recent-graduate conditions, project-specific fit and a nominated-referee process. Separate from degree admission.","tags":["Research","STEM","Project application"],"source":"https://admissions.kaust.edu.sa/study/internships","sourceLabel":"KAUST official internship requirements and FAQ","checked":"24 October 2026"},{"id":"flex-global-2027","title":"FLEX Global high-school exchange 2027–28","provider":"U.S. Department of State / American Councils and partners","type":"Exchange","level":"Student","country":"United States","region":"North America","funding":"Fully funded","deadline":"Country-specific recruitment dates; contact the official office","status":"Check official site","summary":"Eligible students from participating countries spend an academic year in the U.S. Pakistan applicants start with the country office. Global Abroad is a different outbound route.","tags":["High school","Country-specific eligibility","Host family"],"source":"https://www.discoverflexglobal.org/apply-to-flex","sourceLabel":"FLEX Global official country application routes","checked":"24 October 2026"},{"id":"turkiye-next","title":"Türkiye Scholarships: prepare for the next degree call","provider":"Türkiye Scholarships / YTB","type":"Scholarship","level":"Graduate","supportedDegrees":["Bachelor's","Master's","PhD"],"country":"Türkiye","region":"Europe","funding":"Fully funded","deadline":"Annual Jan–Feb calendar; next named call must be verified","status":"Check official site","summary":"Degree funding with placement and level-specific academic/age conditions. The published annual calendar does not confirm that the next intake is open.","tags":["Degree placement","TBBS","Level-specific requirements"],"source":"https://www.turkiyeburslari.gov.tr/fulltimeprograms","sourceLabel":"Türkiye Scholarships official full-time programme","checked":"29 October 2026"},{"id":"kfupm-graduate","title":"KFUPM graduate scholarship routes","provider":"King Fahd University of Petroleum and Minerals","type":"Scholarship","level":"Graduate","supportedDegrees":["Master's","PhD"],"country":"Saudi Arabia","region":"Middle East","funding":"Varies","deadline":"Programme and intake-specific; verify current graduate call","status":"Check official site","summary":"Compare thesis MS, project MS and doctoral requirements. Minimum admission eligibility, scholarship selection and self-sponsored fees are separate decisions.","tags":["Thesis / project","Graduate research","Funding conditions"],"source":"https://cgis.kfupm.edu.sa/admission/kfupm-scholarship","sourceLabel":"KFUPM official scholarship terms","checked":"24 October 2026"},{"id":"isdb-ytb-2026","title":"IsDB–YTB joint scholarship 2026 — closed","provider":"Türkiye Scholarships / YTB and IsDB","type":"Scholarship","level":"Graduate","supportedDegrees":["Bachelor's","Master's","PhD"],"country":"Türkiye","region":"Europe","funding":"Fully funded","status":"Closed","deadline":"2026 call closed 20 February 2026; next joint call not confirmed","deadlineDate":"2026-02-20","summary":"Historical joint call with degree-specific country and field lists. Pakistan and Indonesia appear in the reviewed PhD country group; membership alone does not establish eligibility at every level.","tags":["Closed 2026 call","Country-by-degree eligibility","TBBS joint route"],"source":"https://turkiyeburslari.gov.tr/announcements/ytb-islamic-development-bank-isdb-joint-scholarship-program-2026-applicaiton-period-122","sourceLabel":"YTB official joint programme announcement","checked":"29 October 2026"},{"id":"epfl-srp-2027","title":"EPFL Life Sciences Summer Research Program 2027","provider":"EPFL School of Life Sciences","type":"Internship","level":"Student","supportedDegrees":["Bachelor's","Master's"],"country":"Switzerland","region":"Europe","funding":"Funded","status":"Open","deadline":"15 November 2026, 23:59 CET","deadlineDate":"2026-11-15","deadlineAt":"2026-11-15T23:59:00+01:00","summary":"Life-sciences research from 5 July to 27 August 2027. Check enrolment, study stage and the published academic criterion. Prepare short answers and a referee before the one-sitting application. Housing is paid from the stipend.","tags":["Life sciences","Bachelor's and first-year master's","Research","2027"],"source":"https://www.epfl.ch/schools/sv/education/summer-research-program/","sourceLabel":"EPFL official SRP","checked":"1 November 2026","featured":true},{"id":"fulbright-pakistan","title":"Fulbright Pakistan degree programme — closed call","provider":"USEFP","type":"Scholarship","level":"Master's","supportedDegrees":["Master's","PhD"],"country":"United States","region":"North America","funding":"Fully funded","status":"Closed","deadline":"Reviewed call closed 1 April 2026; next deadline not confirmed","deadlineDate":"2026-04-01","summary":"Pakistan-specific graduate route through USEFP. The reviewed call is closed. Prepare the study rationale and documents, then wait for the next official announcement before treating applications as available.","tags":["Pakistani applicants","USEFP","Graduate study","Closed call"],"source":"https://usefp.org/scholarships/fulbright-degree.cfm","sourceLabel":"USEFP Fulbright degree programme","checked":"1 November 2026"},{"id":"hec-nbs","title":"HEC Need-Based Scholarship — institutional route","provider":"HEC / participating university Financial Aid Office","type":"Scholarship","level":"Bachelor's","country":"Pakistan","region":"Asia","funding":"Funded","status":"Check official site","deadline":"University-specific call; confirm with your Financial Aid Office","summary":"Undergraduate need-based support at selected public-sector institutions. The university assesses need and controls its application window. Check your campus, programme and admission category; a national overview does not confirm a local opening.","tags":["Pakistan domestic funding","Undergraduate","Financial Aid Office","Need-based"],"source":"https://www.hec.gov.pk/english/scholarshipsgrants/NBS/Pages/Eligibility-Criteria.aspx","sourceLabel":"HEC NBS eligibility","checked":"1 November 2026"},{"id":"humboldt-research-fellowship","title":"Humboldt Research Fellowship","provider":"Alexander von Humboldt Foundation","type":"Fellowship","level":"PhD","country":"Germany","region":"Europe","funding":"Funded","status":"Check official site","deadline":"Next scheduled opening: 15 November 2026; capacity-limited call","summary":"Postdoctoral and experienced-researcher routes with a German host. Check doctoral-date, residence and host requirements. A scheduled opening is not a current application window.","tags":["Research","Host required","Doctoral stage"],"source":"https://www.humboldt-foundation.de/en/apply/sponsorship-programmes/humboldt-research-fellowship","sourceLabel":"Humboldt Foundation","checked":"2 November 2026"},{"id":"msca-postdoctoral-fellowships","title":"MSCA Postdoctoral Fellowships","provider":"European Commission","type":"Fellowship","level":"PhD","country":"Multiple European countries","region":"Europe","funding":"Funded","status":"Check official site","deadline":"Call-specific; check current funding portal and host deadline","summary":"Host-based research with doctoral, experience and mobility conditions. European and Global routes have different nationality rules. This overview does not confirm an open call.","tags":["Postdoctoral","Research","Mobility rules"],"source":"https://marie-sklodowska-curie-actions.ec.europa.eu/actions/postdoctoral-fellowships","sourceLabel":"European Commission: MSCA","checked":"2 November 2026"},{"id":"undp-internships","title":"UNDP internships — vacancy-specific remote or in-person routes","provider":"UNDP","type":"Internship","level":"Student","country":"Multiple countries","region":"Global","funding":"Paid","status":"Check official site","deadline":"Each vacancy has its own deadline and work-location rules","summary":"Remote work applies only where a posting states it. Verify student/recent-graduate eligibility and the applicable stipend. This overview is not a live home-based vacancy.","tags":["Remote: vacancy-specific","Development","Student and recent-graduate rules"],"source":"https://www.undp.org/careers/people-programmes","sourceLabel":"UNDP People Programmes","checked":"2 November 2026"},{"id":"undp-graduate-programme","title":"UNDP Graduate Programme — next call unconfirmed","provider":"UNDP","type":"Graduate Program","level":"Graduate","supportedDegrees":["Bachelor's","Master's"],"country":"Multiple countries","region":"Global","funding":"Varies","status":"Check official site","deadline":"Dedicated page: next campaign under consideration","summary":"For eligible programme-country graduates, with degree-specific experience conditions. The dedicated page has not confirmed a new call; monitor official vacancies.","tags":["Early career","International development","Degree-specific experience"],"source":"https://www.undp.org/careers/undp-graduate-programme","sourceLabel":"UNDP Graduate Programme","checked":"2 November 2026"},{"id":"ubc-international-scholars-2027","title":"UBC International Scholars Program 2027","provider":"University of British Columbia","type":"Scholarship","level":"Bachelor's","country":"Canada","region":"North America","funding":"Varies","deadline":"Extended to 2 December 2026, noon Pacific Time; admission and award application required","deadlineDate":"2026-12-02","deadlineAt":"2026-12-02T12:00:00-08:00","status":"Open","summary":"Need-based undergraduate awards. Complete UBC admission and coordinate a school nominator and separate teacher referee; the award amount is individually assessed.","tags":["Undergraduate","Financial need","School nomination","UBC"],"source":"https://you.ubc.ca/financial-planning/scholarships-awards-international-students/international-scholars/","sourceLabel":"UBC International Scholars official instructions","checked":"10 November 2026"},{"id":"oist-phd-2027","title":"OIST PhD Programme 2027 admissions","provider":"Okinawa Institute of Science and Technology","type":"Scholarship","level":"PhD","country":"Japan","region":"Asia","funding":"Fully funded","deadline":"15 November 2026, 23:59 JST (UTC+9)","deadlineDate":"2026-11-15","deadlineAt":"2026-11-15T23:59:00+09:00","status":"Open","summary":"Funded doctoral route with a ¥5,000 application fee. Two references must arrive before submission; shortlisted candidates attend the 2027 online workshop.","tags":["PhD","Research","OIST","Application fee"],"source":"https://www.oist.jp/admissions/phd-program/apply-phd","sourceLabel":"OIST PhD application instructions","checked":"3 November 2026"},{"id":"yenching-academy-2027","title":"Yenching Academy Scholarship 2027","provider":"Peking University · Yenching Academy","type":"Scholarship","level":"Master's","country":"China","region":"Asia","funding":"Funded","deadline":"30 November 2026, 09:00 Beijing time; partner pre-selection may be earlier","deadlineDate":"2026-11-30","deadlineAt":"2026-11-30T09:00:00+08:00","status":"Open","summary":"China Studies master's with a first-year fellowship. Second-year support is conditional; partner-university applicants complete internal pre-selection first.","tags":["China Studies","Peking University","Yenching","Research statement"],"source":"https://yenchingacademy.pku.edu.cn/ADMISSIONS.htm","sourceLabel":"Yenching official admissions instructions","checked":"3 November 2026"},{"id":"eth-esop-2027","title":"ETH Zurich ESOP 2027","provider":"ETH Zurich","type":"Scholarship","level":"Master's","country":"Switzerland","region":"Europe","funding":"Fully funded","deadline":"30 November 2026; confirm exact eApply cutoff (published as 11.59h MEZ)","deadlineDate":"2026-11-30","status":"Open","summary":"First-window master's funding: CHF13,500 per semester from autumn 2027 and a tuition waiver. Check first-master's eligibility and the independent pre-proposal.","tags":["ESOP","ETH Zurich","Master's","Pre-proposal"],"source":"https://ethz.ch/students/en/studies/financial/scholarships/excellencescholarship.html","sourceLabel":"ETH official ESOP instructions","checked":"3 November 2026"},{"id":"hkpfs-2027","title":"Hong Kong PhD Fellowship Scheme 2027/28","provider":"Research Grants Council · Hong Kong","type":"Scholarship","level":"PhD","country":"Hong Kong","region":"Asia","funding":"Funded","deadline":"1 December 2026, 12:00 noon HKT; university applications are separate","deadlineDate":"2026-12-01","deadlineAt":"2026-12-01T12:00:00+08:00","status":"Open","summary":"Obtain the HKPFS reference number before submitting separate PhD applications to the selected universities. Check each university's funding additions and requirements.","tags":["HKPFS","PhD","Research","Hong Kong"],"source":"https://cerg1.ugc.edu.hk/hkpfs/apply.html","sourceLabel":"RGC official two-stage application instructions","checked":"3 November 2026"}],"compact":true}]]}]
