1b:T476,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is the scholarship finder free?","acceptedAnswer":{"@type":"Answer","text":"Yes. It does not require an account or payment. Applications must be submitted on the official programme or university portal."}},{"@type":"Question","name":"Does a match mean I am eligible?","acceptedAnswer":{"@type":"Answer","text":"No. It is a preliminary shortlist based on structured listing fields. Verify citizenship, academics, experience, language, admission and nomination rules on the official source."}},{"@type":"Question","name":"Can I find fully funded scholarships only?","acceptedAnswer":{"@type":"Answer","text":"Yes. Use the funding filter to display fully funded listings, then read what each award actually covers and which costs remain your responsibility."}},{"@type":"Question","name":"Why does a scholarship not appear?","acceptedAnswer":{"@type":"Answer","text":"AspireCompass adds opportunities only after an official source can be checked. A programme may also be excluded because its current cycle is unclear, closed or not yet researched."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--tool","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/matcher/\",\"name\":\"Scholarship finder for international students\",\"description\":\"Filter scholarships by degree, destination, funding and status, then use a practical eligibility checklist before opening the official application source.\",\"url\":\"https://aspirecompass.org/matcher/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-08-31\",\"dateModified\":\"2026-10-13\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/study-planning-1280.webp\",\"caption\":\"Students comparing study options with a laptop, notes 