22:[["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Filter scholarship routes by degree, destination, funding and status. A result is a research lead, not confirmed eligibility."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Open a programme guide or the official source and check nationality, category, documents and deadlines."]}],"$undefined"]}],["$","nav",null,{"className":"tool-jump-nav","aria-label":"More free planning tools","children":[["$","span",null,{"children":"Free tools"}],[["$","$L4","/tools/final-grade-calculator",{"href":"/tools/final-grade-calculator/","aria-current":"$undefined","children":"Final grade"}],["$","$L4","/tools/ects-workload-calculator",{"href":"/tools/ects-workload-calculator/","aria-current":"$undefined","children":"ECTS workload"}],["$","$L4","/tools/gpa-cgpa-calculator",{"href":"/tools/gpa-cgpa-calculator/","aria-current":"$undefined","children":"GPA calculator"}],["$","$L4","/tools/ielts-band-calculator",{"href":"/tools/ielts-band-calculator/","aria-current":"$undefined","children":"IELTS calculator"}],["$","$L4","/tools/italy-study-cost-calculator",{"href":"/tools/italy-study-cost-calculator/","aria-current":"$undefined","children":"Italy cost calculator"}],["$","$L4","/tools/germany-blocked-account-calculator",{"href":"/tools/germany-blocked-account-calculator/","aria-current":"$undefined","children":"Germany funding calculator"}],["$","$L4","/matcher",{"href":"/matcher/","aria-current":"page","children":"Scholarship finder"}]]]}],["$","figure",null,{"className":"page-visual page-visual--inline","children":[["$","img",null,{"src":"/images/study-planning-1280.webp","srcSet":"/images/study-planning-640.webp 640w, /images/study-planning-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"hei