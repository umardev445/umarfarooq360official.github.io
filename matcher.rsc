25:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is the scholarship finder free?",{"children":[["$","summary",null,{"children":["Is the scholarship finder free?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. It does not require an account or payment. Applications must be submitted on the official programme or university portal."}]]}],["$","details","Does a match mean I am eligible?",{"children":[["$","summary",null,{"children":["Does a match mean I am eligible?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It is a preliminary shortlist based on structured listing fields. Verify citizenship, academics, experience, language, admission and nomination rules on the official source."}]]}],["$","details","Can I find fully funded scholarships only?",{"children":[["$","summary",null,{"children":["Can I find fully funded scholarships only?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Use the funding filter to display fully funded listings, then read what each award actually covers and which costs remain your responsibility."}]]}],["$","details","Why does a scholarship not appear?",{"children":[["$","summary",null,{"children":["Why does a scholarship not appear?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"AspireCompass adds opportunities only after an official source can be checked. A programme may also be excluded because its current cycle is unclear, closed or not yet researched."}]]}]]}]]}]
