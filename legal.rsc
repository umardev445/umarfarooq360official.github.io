1f:["$","section","4-Opportunity safety checklist",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Opportunity safety checklist"}],[["$","p","Government, university and established employer programmes normally publish on recognisable official domains and use documented selection processes.",{"children":"Government, university and established employer programmes normally publish on recognisable official domains and use documented selection processes."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Never pay for a guaranteed scholarship or job",{"children":"Never pay for a guaranteed scholarship or job"}],["$","li","Do not send money to a personal account",{"children":"Do not send money to a personal account"}],["$","li","Check email domains and portal URLs",{"children":"Check email domains and portal URLs"}],["$","li","Do not share passwords or one-time codes",{"children":"Do not share passwords or one-time codes"}],["$","li","Report suspicious copies to the programme owner",{"children":"Report suspicious copies to the programme owner"}]]}],"$undefined","$undefined","$undefined"]}]
20:["$","section","5-Acceptable use and copyright",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Acceptable use and copyright"}],[["$","p","You may use AspireCompass for personal opportunity research. Do not scrape, republish or sell substantial portions of the database or misrepresent AspireCompass content as official programme material. Programme names belong to their respective owners.",{"children":"You may use AspireCompass for personal opportunity research. Do not scrape, republish or sell substantial portions of the database or misrepresent AspireCompass content as official programme material. Programme names belong to their respective owners."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","6-Policy documents",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Policy documents"}],[["$","p","Use the related-page links below to read the Privacy Policy, Terms of Use, Disclaimer and Editorial Policy. They explain data handling, advertising, acceptable use, sourcing, corrections and the limits of the information on this website.",{"children":"Use the related-page links below to read the Privacy Policy, Terms of Use, Disclaimer and Editorial Policy. They explain data handling, advertising, acceptable use, sourcing, corrections and the limits of the information on this website."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","7-A five-minute opportunity verification",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"A five-minute opportunity verification"}],[["$","p","Before sharing documents, open the programme through its official organisation domain, confirm the current intake and search the organisation's own site for the opportunity name. Compare the contact email, application portal and fee information with the official page.",{"children":"Before sharing documents, open the programme through its official organisation domain, confirm the current intake and search the organisation's own site for the opportunity name. Compare the contact email, application portal and fee information with the official page."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Check the full domain character by character",{"children":"Check the full domain character by character"}],["$","li","Confirm the named intake and deadline",{"children":"Confirm the named intake and deadline"}],["$","li","Read eligibility on the programme owner's page",{"children":"Read eligibility on the programme owner's page"}],["$","li","Verify any fee with the university or programme",{"children":"Verify any fee with the university or programme"}],["$","li","Save the submission confirmation",{"children":"Save the submission confirmation"}]]}],"$undefined","$undefined","$undefined"]}]
23:["$","section","8-Red flags that require a pause",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Red flags that require a pause"}],[["$","p","Stop when a contact promises a guaranteed award, demands urgent payment to a personal account, asks for passwords or one-time codes, or avoids providing a verifiable programme page. Report an impersonation to the organisation being copied and the relevant platform or authority.",{"children":"Stop when a contact promises a guaranteed award, demands urgent payment to a personal account, asks for passwords or one-time codes, or avoids providing a verifiable programme page. Report an impersonation to the organisation being copied and the relevant platform or authority."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
