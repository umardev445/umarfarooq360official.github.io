1c:["$","section","1-Ask these questions before applying",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Ask these questions before applying"}],[["$","p","Exchange programmes often involve both a home and host institution. A nomination deadline can occur weeks before the public deadline, so contact your international office early.",{"children":"Exchange programmes often involve both a home and host institution. A nomination deadline can occur weeks before the public deadline, so contact your international office early."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Is home-university nomination required?",{"children":"Is home-university nomination required?"}],["$","li","Will credits transfer to your degree?",{"children":"Will credits transfer to your degree?"}],["$","li","Which tuition and living costs are covered?",{"children":"Which tuition and living costs are covered?"}],["$","li","Are language courses included?",{"children":"Are language courses included?"}],["$","li","What visa and insurance documents are needed?",{"children":"What visa and insurance documents are needed?"}]]}],"$undefined","$undefined"]}]
1d:["$","section","2-Protect your degree progress",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Protect your degree progress"}],[["$","p","Ask your academic department to confirm in writing how proposed host courses will transfer. Course availability can change, so prepare alternatives that still meet your home-degree requirements.",{"children":"Ask your academic department to confirm in writing how proposed host courses will transfer. Course availability can change, so prepare alternatives that still meet your home-degree requirements."}],["$","p","Check the academic calendar, assessment dates and housing period before booking travel. An exchange grant may arrive after departure, which means you may need a temporary cash plan even when funding is approved.",{"children":"Check the academic calendar, assessment dates and housing period before booking travel. An exchange grant may arrive after departure, which means you may need a temporary cash plan even when funding is approved."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","3-Budget beyond the programme grant",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Budget beyond the programme grant"}],[["$","p","Compare flights, visa or residence fees, insurance, housing deposits, local transport and exchange-rate risk. Ask whether tuition is waived at the host institution and which fees remain payable at home.",{"children":"Compare flights, visa or residence fees, insurance, housing deposits, local transport and exchange-rate risk. Ask whether tuition is waived at the host institution and which fees remain payable at home."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","4-Build one exchange timeline",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Build one exchange timeline"}],[["$","p","Record the internal nomination deadline separately from the host or funding deadline. Ask your academic department to approve likely courses before travel where possible.",{"children":"Record the internal nomination deadline separately from the host or funding deadline. Ask your academic department to approve likely courses before travel where possible."}],["$","p","Keep alternative courses and a realistic budget because schedules, accommodation and funding decisions can change after nomination.",{"children":"Keep alternative courses and a realistic budget because schedules, accommodation and funding decisions can change after nomination."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
