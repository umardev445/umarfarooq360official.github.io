21:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Do exchange students pay tuition twice?",{"children":[["$","summary",null,{"children":["Do exchange students pay tuition twice?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"It depends on the agreement. Some continue paying the home institution, some pay the host, and some programmes waive specific fees. Obtain written fee information."}]]}],["$","details","Does nomination guarantee acceptance?",{"children":[["$","summary",null,{"children":["Does nomination guarantee acceptance?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. A home institution nomination can be followed by host admission, funding, document and visa decisions."}]]}]]}]]}]
