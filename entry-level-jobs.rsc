1e:["$","article",null,{"className":"article-body ","children":[["$","section","0-Compare recruitment pathways before treating them as jobs",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Compare recruitment pathways before treating them as jobs"}],[["$","p","A direct job advert, a competitive examination and a graduate cohort are different routes. The cards below retain closed programmes for planning with their status visible. They are not a list of jobs accepting every nationality today. Start with the actual qualification, location and work evidence you can document.",{"children":"A direct job advert, a competitive examination and a graduate cohort are different routes. The cards below retain closed programmes for planning with their status visible. They are not a list of jobs accepting every nationality today. Start with the actual qualification, location and work evidence you can document."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"International early-career routes and their limiting conditions","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"International early-career routes and their limiting conditions"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route",{"scope":"col","children":"Route"}],["$","th","Main eligibility gate",{"scope":"col","children":"Main eligibility gate"}],["$","th","What the listing establishes",{"scope":"col","children":"What the listing establishes"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"UN Young Professionals Programme"}],["$","td","1",{"children":"Participating nationality, relevant degree, age and language"}],["$","td","2",{"children":"Examination route; a roster place does not guarantee a job"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"UNDP Graduate Programme"}],["$","td","1",{"children":"Programme-country nationality and degree/experience combination"}],["$","td","2",{"children":"No new call confirmed on the dedicated programme page"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"OECD Young Associates"}],["$","td","1",{"children":"OECD-member nationality and undergraduate cohort rules"}],["$","td","2",{"children":"2026–2028 applications ended; future planning only"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.un.org/en/academic-impact/work4un-young-professionals-programme",{"children":["",["$","a",null,{"href":"https://www.un.org/en/academic-impact/work4un-young-professionals-programme","target":"_blank","rel":"noreferrer","children":"UN: how YPP recruitment works"}]]}],["$","span","https://www.undp.org/careers/undp-graduate-programme",{"children":[" · ",["$","a",null,{"href":"https://www.undp.org/careers/undp-graduate-programme","target":"_blank","rel":"noreferrer","children":"UNDP Graduate Programme"}]]}],["$","span","https://www.oecd.org/en/about/careers/young-associates.html",{"children":[" · ",["$","a",null,{"href":"https://www.oecd.org/en/about/careers/young-associates.html","target":"_blank","rel":"noreferrer","children":"OECD Young Associates"}]]}]]]}],"$undefined"]}],["$","section","1-Three checks that can save an unsuitable application",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Three checks that can save an unsuitable application"}],[["$","p","UN YPP's participating-country list changes each year. Its general criteria include a relevant first degree, age 32 or younger in the exam year and English or French. Check the current notice, not a country's inclusion in a previous round.",{"children":"UN YPP's participating-country list changes each year. Its general criteria include a relevant first degree, age 32 or younger in the exam year and English or French. Check the current notice, not a country's inclusion in a previous round."}],"$L21","$L22"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}]
1f:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L5","https://www.un.org/en/academic-impact/work4un-young-professionals-programme",{"href":"https://www.un.org/en/academic-impact/work4un-young-professionals-programme","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"UN YPP recruitment process"}],["$","span",null,{"children":"Programme overview checked 2 November 2026. An overview is not proof of a live vacancy."}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L5","https://www.undp.org/careers/undp-graduate-programme",{"href":"https://www.undp.org/careers/undp-graduate-programme","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"UNDP Graduate Programme"}],["$","span",null,{"children":"Dedicated page says the next campaign is under consideration; overview wording differs. No open call is asserted."}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":"$1f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L5","https://www.oecd.org/en/about/careers/young-associates.html",{"href":"https://www.oecd.org/en/about/careers/young-associates.html","target":"_blank","rel":"noreferrer","children":[["$","div",null,{