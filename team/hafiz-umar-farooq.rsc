1c:["$","section","2-Education, background and SEO experience",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Education, background and SEO experience"}],[["$","p","Umar is currently a Computer Engineering student at IIUI. His student perspective informs his interest in making complex application information easier to navigate. His engineering studies sit alongside his work developing and organizing AspireCompass.",{"children":"Umar is currently a Computer Engineering student at IIUI. His student perspective informs his interest in making complex application information easier to navigate. His engineering studies sit alongside his work developing and organizing AspireCompass."}],["$","p","His three years of SEO experience are part of his professional background. On AspireCompass, the emphasis is on clear page organization, descriptive headings and helping readers move between relevant guides. Search visibility is useful when it helps a reader find an accurate answer; it does not replace checking a university or scholarship provider’s rules.",{"children":"His three years of SEO experience are part of his professional background. On AspireCompass, the emphasis is on clear page organization, descriptive headings and helping readers move between relevant guides. Search visibility is useful when it helps a reader find an accurate answer; it does not replace checking a university or scholarship provider’s rules."}],["$","p","His LinkedIn profile connects this biography with his professional identity. For scholarship and university information, readers can follow the official sources provided on the relevant AspireCompass guides.",{"children":"His LinkedIn profile connects this biography with his professional identity. For scholarship and university information, readers can follow the official sources provided on the relevant AspireCompass guides."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","3-The approach behind the website",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"The approach behind the website"}],[["$","p","AspireCompass organizes study information around the decisions a reader needs to make: where to study, which funding route fits, what to prepare and which official portal to use. Country hubs connect those decisions rather than treating each article as an isolated list.",{"children":"AspireCompass organizes study information around the decisions a reader needs to make: where to study, which funding route fits, what to prepare and which official portal to use. Country hubs connect those decisions rather than treating each article as an isolated list."}],["$","p","The editorial policy explains how published information, closed calls, estimates and uncertain future dates should be distinguished. Tools provide planning estimates and explain their assumptions. They do not issue admission decisions, scholarships, financial guarantees or visas.",{"children":"The editorial policy explains how published information, closed calls, estimates and uncertain future dates should be distinguished. Tools provide planning estimates and explain their assumptions. They do not issue admission decisions, scholarships, financial guarantees or visas."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for The approach behind the website","children":[["$","$L4","/countries/italy/",{"href":"/countries/italy/","children":["Italy study pathway",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/countries/germany/",{"href":"/countries/germany/","children":["Germany study pathway",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/countries/china/",{"href":"/countries/china/","children":["China study pathway",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/",{"href":"/tools/","children":["Explore the planning tools",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1e:["$","section","4-Contact Umar or report a correction",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Contact Umar or report a correction"}],[["$","p","For an editorial correction, include the AspireCompass page URL, the statement that needs attention and a current official source. For a professional enquiry, briefly explain the purpose of your message and the best way to reply.",{"children":"For an editorial correction, include the AspireCompass page URL, the statement that needs attention and a current official source. For a professional enquiry, briefly explain the purpose of your message and the best way to reply."}],["$","p","Public contact email: umarfarooq360official@gmail.com. You can also find Umar through the LinkedIn profile linked below. Do not send passports, bank records, passwords or other sensitive application documents. AspireCompass does not accept scholarship applications on behalf of universities.",{"children":"Public contact email: umarfarooq360official@gmail.com. You can also find Umar through the LinkedIn profile linked below. Do not send passports, bank records, passwords or other sensitive application documents. AspireCompass does not accept scholarship applications on behalf of universities."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Contact Umar or report a correction","children":[["$","$L4","mailto:umarfarooq360official@gmail.com",{"href":"mailto:umarfarooq360official@gmail.com","children":["Email Hafiz Umar Farooq",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.linkedin.com/in/umar-farooq-838337418/",{"href":"https://www.linkedin.com/in/umar-farooq-838337418/","children":["Connect on LinkedIn",["$","$L5",null,{"ref":"$undefined","iconNod