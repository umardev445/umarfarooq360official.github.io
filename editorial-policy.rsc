ildren":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Plain-language page summary","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Plain-language page summary"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Topic",{"scope":"col","children":"Topic"}],["$","th","Meaning",{"scope":"col","children":"Meaning"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Open"}],["$","td","1",{"children":"Published route is marked open; verify the official portal now"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Opening soon"}],["$","td","1",{"children":"Future/expected cycle; not confirmed available to every applicant"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Rolling"}],["$","td","1",{"children":"Continuous or vacancy-based route; individual openings can close"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Check official site"}],["$","td","1",{"children":"Date/category varies or current call is unconfirmed"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Closed"}],["$","td","1",{"children":"Manual closed status or a past dated milestone; future cycles need a new check"}]],"$undefined"]}],["$","tr","5",{"children":[[["$","th","0",{"scope":"row","children":"Continuing applicants"}],["$","td","1",{"children":"An entry or nomination deadline passed; remaining dates concern candidates already in the process"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","1-Source hierarchy",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Source hierarchy"}],[["$","p","Primary sources come first: the programme owner, government, university, foundation, employer or authorised application body. We use their current programme page, call, application instructions or careers listing wherever available.",{"children":"Primary sources come first: the programme owner, government, university, foundation, employer or authorised application body. We use their current programme page, call, application instructions or careers listing wherever available."}],"$L1e"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27"]}],false,null,"$L28"]}],"$L29"]}]
1d:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","about",{"href":"/about/","children":[["$","span",null,{"children":"About AspireCompass"}],["$","h3",null,{"children":"A clearer path to global opportunity"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","contact",{"href":"/contact/","children":[["$","span",null,{"children":"Contact"}],["$","h3",null,{"children":"Help us keep opportunity information useful"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","disclaimer",{"href":"/disclaimer/","children":[["$","span",null,{"children":"Information disclaimer"}],["$","h3",null,{"children":"Important limits of AspireCompass information"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","privacy-policy",{"href":"/privacy-policy/","children":[["$","span",null,{"children":"Privacy policy"}],["$","h3",null,{"children":"How AspireCompass handles data, cookies and advertising"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
1e:["$","p","A reputable secondary source may help locate or understand an opportunity, but it does not replace the owner for a deadline or mandatory eligibility rule. Social posts, copied lists and search snippets are leads, not final evidence.",{"children":"A reputable secondary source may help locate or understand an opportunity, but it does not replace the owner for a deadline or mandatory eligibility rule. Social posts, copied lists and search snippets are leads, not final evidence."}]
1f:["$","section","2-What is checked in a listing",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"What is checked in a listing"}],[["$","p","Editors review the programme identity, opportunity type, intended level, destination, funding description, deadline wording, application route and source domain. Complex details are summarised conservatively, and readers are directed to the owner for the complete call.",{"children":"Editors review the programme identity, opportunity type, intended level, destination, funding description, deadline wording, application route and source domain. Complex details are summarised conservatively, and readers are directed to the owner for the complete call."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Correct programme and intake",{"children":"Correct programme and intake"}],["$","li","Current application status",{"children":"Current application status"}],["$","li","Eligibility audience and major restrictions",{"children":"Eligibility audience and major restrictions"}],["$","li","Funding description and material caveats",{"children":"Funding description and material caveats"}],["$","li","Deadline, time zone and nomination route",{"children":"Deadline, time zone and nomination route"}],["$","li","Working official source",{"children":"Working official source"}]]}],"$undefined","$undefined","$undefined"]}]
20:["$","section","3-Meaning of status labels",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Meaning of status labels"}],[["$","p","Open is used when a current official cycle is accepting applications. Opening soon requires an official future window or clear announcement. Rolling describes vacancies or review without one universal closing date. Check official site is used for variable, uncertain or not-yet-announced cycles. Closed means the named cycle has passed or the owner states that it is closed.",{"children":"Open is used when a current official cycle is accepting applications. Opening soon requires an official future window or clear announcement. Rolling describes vacancies or review without one universal closing date. Check official site is used for variable, uncertain or not-yet-announced cycles. Closed means the named cycle has passed or the owner states that it is closed."}],["$","p","Status is a snapshot, not a live guarantee. Every card includes a checked date so readers can judge freshness and repeat the official check before acting.",{"children":"Status is a snapshot, not a live guarantee. Every card includes a checked date so readers can judge freshness and repeat the official check before acting."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","4-Original guides and responsible assistance",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Original guides and responsible assistance"}],[["$","p","Application guides add original structure, examples, checklists and decision frameworks rather than copying programme pages. Examples are fictional or general and are clearly presented as instruction, not text to submit.",{"children":"Application guides add original structure, examples, checklists and decision frameworks rather than copying programme pages. Examples are fictional or general and are clearly presented as instruction, not text to submit."}],["$","p","Research and editing tools may assist organisation, comparison or language review, but published claims must be checked against sources and reviewed for accuracy, usefulness and safety. We do not invent applicant stories, outcomes or programme rules.",{"children":"Research and editing tools may assist organisation, comparison or language review, but published claims must be checked against sources and reviewed for accuracy, usefulness and safety. We do not invent applicant stories, outcomes or programme rules."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","5-Corrections and material updates",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Corrections and material updates"}],[["$","p","Reports are compared with a current primary source. A material deadline, status or eligibility error is prioritised. Minor style changes may not receive a public note, while checked dates and page update dates help readers understand when substantive information was reviewed.",{"children":"Reports are compared with a current primary source. A material deadline, status or eligibility error is prioritised. Minor style changes may not receive a public note, while checked dates and page update dates help readers understand when substantive information was reviewed."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","6-Editorial independence and advertising",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Editorial independence and advertising"}],[["$","p","Advertising and technical monetisation do not determine whether an opportunity is listed, its status or its editorial description. Advertisers do not receive favourable eligibility treatment. Paid or sponsored editorial material, if ever introduced, will be clearly labelled and will not be presented as independent verification.",{"children":"Advertising and technical monetisation do not determine whether an opportunity is listed, its status or its editorial description. Advertisers do not receive favourable eligibility treatment. Paid or sponsored editorial material, if ever introduced, will be clearly labelled and will not be presented as independent verification."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","7-What publication does not mean",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"What publication does not mean"}],[["$","p","Inclusion is not an endorsement or guarantee. AspireCompass cannot test every external portal, predict every applicant's eligibility or monitor every change instantly. Readers must use the official source, protect personal data and exercise independent judgement.",{"children":"Inclusion is not an endorsement or guarantee. AspireCompass cannot test every external portal, predict every applicant's eligibility or monitor every change instantly. Readers must use the official source, protect personal data and exercise independent judgement."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","8-How to report a problem",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"How to report a problem"}],[["$","p","Use the contact page and include the AspireCompass URL, the exact statement at issue, the current official source and a short explanation. Do not send private application documents. Good-faith corrections are welcome from readers and programme owners.",{"children":"Use the contact page and include the AspireCompass URL, the exact statement at issue, the current official source and a short explanation. Do not send private application documents. Good-faith corrections are welcome from readers and programme owners."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","9-Illustrative images and original examples",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"Illustrative images and original examples"}],[["$","p","Some study scenes are generated illustrations; they do not depict named universities, actual award recipients or programme endorsements. Images support reading and orientation, while eligibility, costs and deadlines are supported by the linked institutional sources.",{"children":"Some study scenes are generated illustrations; they do not depict named universities, actual award recipients or programme endorsements. Images support reading and orientation, while eligibility, costs and deadlines are supported by the linked institutional sources."}],["$","p","Worked letters, budgets and applicant cases are fictional teaching examples. Use them to understand the method, then use your own evidence and comply with the application's rules. An editorial update date does not claim that every external rule was reverified on the same day.",{"children":"Worked letters, budgets and applicant cases are fictional teaching examples. Use them to understand the method, then use your own evidence and comply with the application's rules. An editorial update date does not claim that every external rule was reverified on the same day."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
27:["$","section","10-Meet the founder and editorial contact",{"className":"article-section","id":"section-11","children":[["$","h2",null,{"children":"Meet the founder and editorial contact"}],[["$","p","Hafiz Umar Farooq is the founder, CEO and editor of AspireCompass. He is a Computer Engineering student at International Islamic University Islamabad and has three years of SEO experience. His profile explains his role and provides direct contact details.",{"children":"Hafiz Umar Farooq is the founder, CEO and editor of AspireCompass. He is a Computer Engineering student at International Islamic University Islamabad and has three years of SEO experience. His profile explains his role and provides direct contact details."}],["$","p","Guides remain attributed to AspireCompass unless an individual author is explicitly named. The founder profile is an identity and editorial contact page, rather than a claim of personal scholarship or university experience.",{"children":"Guides remain attributed to AspireCompass unless an individual author is explicitly named. The founder profile is an identity and editorial contact page, rather than a claim of personal scholarship or university experience."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Meet the founder and editorial contact","children":[["$","$L4","/team/hafiz-umar-farooq/",{"href":"/team/hafiz-umar-farooq/","children":["Hafiz Umar Farooq: founder, CEO & editor",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
28:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Does AspireCompass use primary sources?",{"children":[["$","summary",null,{"children":["Does AspireCompass use primary sources?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Programme owners, governments, universities and employers are the preferred evidence for dates, eligibility and application procedures."}]]}],["$","details","How often is every page checked?",{"children":[["$","summary",null,{"children":["How often is every page checked?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Pages are reviewed according to deadline urgency and material changes rather than a guaranteed fixed interval. The visible checked or updated date lets readers judge freshness."}]]}],["$","details","Can an advertiser change a listing?",{"children":[["$","summary",null,{"children":["Can an advertiser change a listing?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Advertising does not control editorial status, eligibility summaries or conclusions. Any sponsored content would require clear labelling."}]]}],["$","details","How can I report an expired deadline?",{"children":[["$","summary",null,{"children":["How can I report an expired deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Send the page URL, exact issue and current programme-owner source through the contact address. Do not include personal application documents."}]]}],["$","details","Does AspireCompass copy official scholarship pages?",{"children":[["$","summary",null,{"children":["Does AspireCompass copy official scholarship pages?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It summarises essential facts conservatively and adds original comparison and application guidance while linking readers to the complete official call."}]]}]]}]]}]
