17:T576,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does AspireCompass use primary sources?","acceptedAnswer":{"@type":"Answer","text":"Yes. Programme owners, governments, universities and employers are the preferred evidence for dates, eligibility and application procedures."}},{"@type":"Question","name":"How often is every page checked?","acceptedAnswer":{"@type":"Answer","text":"Pages are reviewed according to deadline urgency and material changes rather than a guaranteed fixed interval. The visible checked or updated date lets readers judge freshness."}},{"@type":"Question","name":"Can an advertiser change a listing?","acceptedAnswer":{"@type":"Answer","text":"No. Advertising does not control editorial status, eligibility summaries or conclusions. Any sponsored content would require clear labelling."}},{"@type":"Question","name":"How can I report an expired deadline?","acceptedAnswer":{"@type":"Answer","text":"Send the page URL, exact issue and current programme-owner source through the contact address. Do not include personal application documents."}},{"@type":"Question","name":"Does AspireCompass copy official scholarship pages?","acceptedAnswer":{"@type":"Answer","text":"No. It summarises essential facts conservatively and adds original comparison and application guidance while linking readers to the complete official call."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--company","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/editorial-policy/\",\"name\":\"How AspireCompass researches, writes and corrects information\",\"description\":\"See how AspireCompass uses primary sources, status labels, review dates, corrections and editorial independence for opportunity content.\",\"url\":\"https://aspirecompass.org/editorial-policy/\",