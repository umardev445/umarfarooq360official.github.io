1c:["$","section",null,{"className":"content-block","aria-labelledby":"relevant-listings","children":[["$","div",null,{"className":"content-block__heading","children":[["$","h2",null,{"id":"relevant-listings","children":"Relevant opportunities"}],["$","p",null,{"children":"8 official-source records match this topic. Check category and applicant conditions before applying."}]]}],["$","$L20",null,{"items":[{"id":"unicef-internships","title":"UNICEF Internship Programme","provider":"UNICEF","type":"Internship","level":"Student","country":"Multiple countries","region":"Global","funding":"Paid","deadline":"Vacancy-specific","status":"Rolling","summary":"Hands-on global internship opportunities for students and recent graduates from diverse academic backgrounds.","tags":["United Nations","Students","Recent graduates"],"source":"https://www.unicef.org/careers/internships","sourceLabel":"UNICEF Careers","checked":"13 October 2026","featured":true},{"id":"cern-short-term","title":"CERN Short-Term Internship","provider":"CERN","type":"Internship","level":"Student","country":"Switzerland","region":"Europe","funding":"Funded","deadline":"Live position and nationality restrictions apply","status":"Check official site","summary":"Student internships use live positions and enrolment conditions. The official page currently excludes several nationalities, including Pakistani nationals, because an associate-membership ceiling has been reached.","tags":["STEM","Europe","1–6 months"],"source":"https://careers.cern/programmes/short-term-internship/","sourceLabel":"CERN Careers","checked":"23 October 2026"},{"id":"cern-summer","title":"CERN Summer Studentship","provider":"CERN","type":"Internship","level":"Student","country":"Switzerland","region":"Europe","funding":"Funded","deadline":"Annual cycle; check programme page","status":"Check official site","summary":"Scientific and technical project work, expert lectures and an international research experience for eligible university students.","tags":["Summer","Physics","Engineering","Computing"],"source":"https://careers.cern/programmes/summer-studentship/","sourceLabel":"CERN Careers","checked":"13 October 2026"},{"id":"oecd-internship","title":"OECD Internship Programme","provider":"OECD","type":"Internship","level":"Student","country":"France","region":"Europe","funding":"Paid","deadline":"Applications accepted throughout the year","status":"Rolling","summary":"For eligible students enrolled throughout the placement. Most internships are in Paris. Check location and nationality rules; no general remote arrangement is assumed.","tags":["Policy","Enrolment required","Mostly Paris-based"],"source":"https://www.oecd.org/en/about/careers/internships.html","sourceLabel":"OECD Careers","checked":"2 November 2026","featured":true},{"id":"un-internships","title":"United Nations Internships","provider":"United Nations","type":"Internship","level":"Student","country":"Multiple countries","region":"Global","funding":"Varies","deadline":"Vacancy-specific","status":"Rolling","summary":"Internship openings across UN duty stations and functions for students and recent graduates; conditions vary by vacancy.","tags":["United Nations","Global","Multiple fields"],"source":"https://careers.un.org/","sourceLabel":"UN Careers","checked":"2 October 2026"},{"id":"kaust-vsrp","title":"KAUST Visiting Student Research Program","provider":"KAUST","type":"Internship","level":"Student","country":"Saudi Arabia","region":"Middle East","funding":"Fully funded","deadline":"Year-round; project availability and dates to confirm","status":"Rolling","summary":"A 2–6 month research placement with published student/recent-graduate conditions, project-specific fit and a nominated-referee process. Separate from degree admission.","tags":["Research","STEM","Project application"],"source":"https://admissions.kaust.edu.sa/study/internships","sourceLabel":"KAUST official internship requirements and FAQ","checked":"24 October 2026"},{"id":"epfl-srp-2027","title":"EPFL Life Sciences Summer Research Program 2027","provider":"EPFL School of Life Sciences","type":"Internship","level":"Student","supportedDegrees":["Bachelor's","Master's"],"country":"Switzerland","region":"Europe","funding":"Funded","status":"Open","deadline":"15 November 2026, 23:59 CET","deadlineDate":"2026-11-15","deadlineAt":"2026-11-15T23:59:00+01:00","summary":"Life-sciences research from 5 July to 27 August 2027. Check enrolment, study stage and the published academic criterion. Prepare short answers and a referee before the one-sitting application. Housing is paid from the stipend.","tags":["Life sciences","Bachelor's and first-year master's","Research","2027"],"source":"https://www.epfl.ch/schools/sv/education/summer-research-program/","sourceLabel":"EPFL official SRP","checked":"1 November 2026","featured":true},{"id":"undp-internships","title":"UNDP internships — vacancy-specific remote or in-person routes","provider":"UNDP","type":"Internship","level":"Student","country":"Multiple countries","region":"Global","funding":"Paid","status":"Check official site","deadline":"Each vacancy has its own deadline and work-location rules","summary":"Remote work applies only where a posting states it. Verify student/recent-graduate eligibility and the applicable stipend. This overview is not a live home-based vacancy.","tags":["Remote: vacancy-specific","Development","Student and recent-graduate rules"],"source":"https://www.undp.org/careers/people-programmes","sourceLabel":"UNDP People Programmes","checked":"2 November 2026"}],"showTypeFilter":true}]]}]
