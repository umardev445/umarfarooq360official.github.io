23:["$","section","2-Check the practical details first",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Check the practical details first"}],[["$","p","A prestigious name does not automatically make an internship accessible. Before writing an application, confirm enrolment rules, nationality restrictions, work location, visa support, pay and start date.",{"children":"A prestigious name does not automatically make an internship accessible. Before writing an application, confirm enrolment rules, nationality restrictions, work location, visa support, pay and start date."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Current-student or recent-graduate requirement",{"children":"Current-student or recent-graduate requirement"}],["$","li","On-site, hybrid or remote arrangement",{"children":"On-site, hybrid or remote arrangement"}],["$","li","Monthly stipend and relocation support",{"children":"Monthly stipend and relocation support"}],["$","li","Visa and work-authorisation responsibility",{"children":"Visa and work-authorisation responsibility"}],["$","li","Expected hours and programme duration",{"children":"Expected hours and programme duration"}]]}],"$undefined","$undefined","$undefined"]}]
24:["$","section","3-Make the placement financially and legally workable",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Make the placement financially and legally workable"}],[["$","p","A paid internship can still be unaffordable if the stipend does not cover the location, travel, insurance or visa. Calculate the full placement cost and confirm whether the employer provides immigration support before accepting.",{"children":"A paid internship can still be unaffordable if the stipend does not cover the location, travel, insurance or visa. Calculate the full placement cost and confirm whether the employer provides immigration support before accepting."}],["$","p","Some international organisations use nationality or membership-country rules, and these can change. CERN currently notes nationality ceilings for several countries, including Pakistan, on selected internship and graduate routes; the live programme page is the final authority.",{"children":"Some international organisations use nationality or membership-country rules, and these can change. CERN currently notes nationality ceilings for several countries, including Pakistan, on selected internship and graduate routes; the live programme page is the final authority."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","4-Recognise a legitimate selection process",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Recognise a legitimate selection process"}],[["$","p","A credible vacancy identifies the organisation, role, location, duration, responsibilities and application portal. Be especially cautious when a message moves immediately to private chat, asks for a payment or promises selection without assessment.",{"children":"A credible vacancy identifies the organisation, role, location, duration, responsibilities and application portal. Be especially cautious when a message moves immediately to private chat, asks for a payment or promises selection without assessment."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Search for the role on the employer's own domain",{"children":"Search for the role on the employer's own domain"}],["$","li","Check the sender's full email address",{"children":"Check the sender's full email address"}],["$","li","Never pay for a guaranteed interview",{"children":"Never pay for a guaranteed interview"}],["$","li","Do not share banking passwords or one-time codes",{"children":"Do not share banking passwords or one-time codes"}],["$","li","Keep copies of the vacancy and submission receipt",{"children":"Keep copies of the vacancy and submission receipt"}]]}],"$undefined","$undefined","$undefined"]}]
26:["$","section","5-Choose an internship search and application route",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Choose an internship search and application route"}],[["$","p","Decide whether location, remote access or graduate eligibility is the main constraint, then use the matching route and prepare evidence for the vacancy itself.",{"children":"Decide whether location, remote access or graduate eligibility is the main constraint, then use the matching route and prepare evidence for the vacancy itself."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Choose an internship search and application route","children":[["$","$L5","/internships/remote/",{"href":"/internships/remote/","children":["Remote internships",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/internship-application/",{"href":"/guides/internship-application/","children":["Internship application guide",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/entry-level-jobs/",{"href":"/entry-level-jobs/","children":["Entry-level jobs",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/graduate-programs/",{"href":"/graduate-programs/","children":["Graduate programmes",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
27:["$","section","6-From discovery to a research placement",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"From discovery to a research placement"}],[["$","p","For a research internship, check your academic stage, project fit and referee process. KAUST VSRP has its own requirements; it is separate from graduate degree admission.",{"children":"For a research internship, check your academic stage, project fit and referee process. KAUST VSRP has its own requirements; it is separate from graduate degree admission."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for From discovery to a research placement","children":[["$","$L5","/internships/kaust-vsrp/",{"href":"/internships/kaust-vsrp/","children":["KAUST VSRP internship: eligibility, projects and application",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
