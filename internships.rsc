18:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-Check the practical details first",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Check the practical details first"}],[["$","p","A prestigious name does not automatically make an internship accessible. Before writing an application, confirm enrolment rules, nationality restrictions, work location, visa support, pay and start date.",{"children":"A prestigious name does not automatically make an internship accessible. Before writing an application, confirm enrolment rules, nationality restrictions, work location, visa support, pay and start date."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Current-student or recent-graduate requirement",{"children":"Current-student or recent-graduate requirement"}],["$","li","On-site, hybrid or remote arrangement",{"children":"On-site, hybrid or remote arrangement"}],["$","li","Monthly stipend and relocation support",{"children":"Monthly stipend and relocation support"}],["$","li","Visa and work-authorisation responsibility",{"children":"Visa and work-authorisation responsibility"}],["$","li","Expected hours and programme duration",{"children":"Expected hours and programme duration"}]]}],"$undefined","$undefined"]}],["$","section","2-Make the placement financially and legally workable",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Make the placement financially and legally workable"}],[["$","p","A paid internship can still be unaffordable if the stipend does not cover the location, travel, insurance or visa. Calculate the full placement cost and confirm whether the employer provides immigration support before accepting.",{"children":"A paid internship can still be unaffordable if the stipend does not cover the location, travel, insurance or visa. Calculate the full placement cost and confirm whether the employer provides immigration support before accepting."}],["$","p","Some international organisations use nationality or membership-country rules, and these can change. CERN currently notes nationality ceilings for several countries, including Pakistan, on selected internship and graduate routes; the live programme page is the final authority.",{"children":"Some international organisations use nationality or membership-country rules, and these can change. CERN currently notes nationality ceilings for several countries, including Pakistan, on selected internship and graduate routes; the live programme page is the final authority."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Recognise a legitimate selection process",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Recognise a legitimate selection process"}],[["$","p","A credible vacancy identifies the organisation, role, location, duration, responsibilities and application portal. Be especially cautious when a message moves immediately to private chat, asks for a payment or promises selection without assessment.",{"children":"A credible vacancy identifies the organisation, role, location, duration, responsibilities and application portal. Be especially cautious when a message moves immediately to private chat, asks for a payment or promises selection without assessment."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Search for the role on the employer's own domain",{"children":"Search for the role on the employer's own domain"}],["$","li","Check the sender's full email address",{"children":"Check the sender's full email address"}],["$","li","Never pay for a guaranteed interview",{"children":"Never pay for a guaranteed interview"}],"$L1a","$L1b"]}],"$undefined","$undefined"]}],"$L1c"]}]
