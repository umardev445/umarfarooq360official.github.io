24:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Does AspireCompass require an account?",{"children":[["$","summary",null,{"children":["Does AspireCompass require an account?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Public pages and the opportunity matcher can be used without creating a reader account."}]]}],["$","details","Does AspireCompass collect scholarship applications?",{"children":[["$","summary",null,{"children":["Does AspireCompass collect scholarship applications?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Apply through the official programme portal. Do not email AspireCompass passports, transcripts, banking information or complete application files."}]]}],["$","details","Can Google use cookies for ads on this site?",{"children":[["$","summary",null,{"children":["Can Google use cookies for ads on this site?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"When Google advertising is active and permitted by applicable consent choices, Google and its partners may use cookies or similar identifiers to serve and measure ads."}]]}],["$","details","How can I control personalised Google ads?",{"children":[["$","summary",null,{"children":["How can I control personalised Google ads?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Use Google Ads Settings and the consent choices presented on the site where applicable. Browser and industry opt-out controls may also be available."}]]}],["$","details","Do external scholarship portals follow this policy?",{"children":[["$","summary",null,{"children":["Do external scholarship portals follow this policy?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Each external programme or institution has its own privacy policy and controls the data submitted to its portal."}]]}]]}]]}]
