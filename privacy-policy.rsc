1f:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,null,false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Scope and privacy contact",{"href":"#section-1","children":"Scope and privacy contact"}],["$","a","Information you choose to send",{"href":"#section-2","children":"Information you choose to send"}],["$","a","Optional analytics: one choice in English and Spanish",{"href":"#section-3","children":"Optional analytics: one choice in English and Spanish"}],["$","a","Local tools, saved opportunities and files",{"href":"#section-4","children":"Local tools, saved opportunities and files"}],["$","a","Hosting and necessary technical access",{"href":"#section-5","children":"Hosting and necessary technical access"}],["$","a","Advertising and separate consent controls",{"href":"#section-6","children":"Advertising and separate consent controls"}],["$","a","External websites and your choices",{"href":"#section-7","children":"External websites and your choices"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body ","children":[["$","section","0-Scope and privacy contact",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Scope and privacy contact"}],[["$","p","This policy applies to aspirecompass.org, an independent information website. No reader account or application-document upload is required. Privacy questions can be sent to umarfarooq360official@gmail.com. Provide only what is needed to explain a request, without passports, passwords, banking records or complete application files.",{"children":"This policy applies to aspirecompass.org, an independent information website. No reader account or application-document upload is required. Privacy questions can be sent to umarfarooq360official@gmail.com. Provide only what is needed to explain a request, without passports, passwords, banking records or complete application files."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","1-Information you choose to send",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Information you choose to send"}],[["$","p","If you email a question or correction, we receive your address and the content you provide. We use it to understand the report, respond when appropriate and retain a reasonable editorial record. Correspondence is retained only as reasonably needed for its purpose, operational security and applicable obligations.",{"children":"If you email a question or correction, we receive your address and the content you provide. We use it to understand the report, respond when appropriate and retain a reasonable editorial record. Correspondence is retained only as reasonably needed for its purpose, operational security and applicable obligations."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","2-Optional analytics: one choice in English and Spanish",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Optional analytics: one choice in English and Spanish"}],[["$","p","Google Analytics measurement code is not loaded until you allow analytics. English and Spanish pages share that choice on this domain in the same browser. Guides, calculators, downloads and saved opportunities work with either choice.",{"children":"Google Analytics measurement code is not loaded until you allow analytics. English and Spanish pages share that choice on this domain in the same browser. Guides, calculators, downloads and saved opportunities work with either choice."}],"$L21","$L22","$L23"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L24","$L25","$L26","$L27"]}],false,"$L28","$L29"]}],"$L2a"]}]
20:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L5","terms",{"href":"/terms/","children":[["$","span",null,{"children":"Terms of use"}],["$","h3",null,{"children":"Terms for using AspireCompass"}],["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","disclaimer",{"href":"/disclaimer/","children":[["$","span",null,{"children":"Information disclaimer"}],["$","h3",null,{"children":"Important limits of AspireCompass information"}],["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","editorial-policy",{"href":"/editorial-policy/","children":[["$","span",null,{"children":"Editorial standards"}],["$","h3",null,{"children":"How AspireCompass researches, writes and corrects information"}],["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","contact",{"href":"/contact/","children":[["$","span",null,{"children":"Contact"}],["$","h3",null,{"children":"Help us keep opportunity information useful"}],["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
21:["$","p","The preference is stored in localStorage as aspirecompass_analytics_choice_v1. Change it using Analytics preferences in the English footer or Preferencias de analítica in Spanish. When storage is blocked, your choice applies on the current page but may need to be repeated after navigation.",{"children":"The preference is stored in localStorage as aspirecompass_analytics_choice_v1. Change it using Analytics preferences in the English footer or Preferencias de analítica in Spanish. When storage is blocked, your choice applies on the current page but may need to be repeated after navigation."}]
22:["$","p","If allowed, Google Analytics can receive page and technical usage information and interaction events, such as guide navigation, source clicks and calculator use. Our custom events do not include entered grades, financial amounts, search terms or application documents. Google processes information under its own service terms and practices.",{"children":"If allowed, Google Analytics can receive page and technical usage information and interaction events, such as guide navigation, source clicks and calculator use. Our custom events do not include entered grades, financial amounts, search terms or application documents. Google processes information under its own service terms and practices."}]
23:["$","p","Rejecting or withdrawing analytics disables subsequent site measurement and attempts to delete Google Analytics cookies readable on this domain. It does not erase information already received by Google or cookies outside this site's control. Browser settings provide further cookie and storage controls. The analytics preference does not grant advertising consent.",{"children":"Rejecting or withdrawing analytics disables subsequent site measurement and attempts to delete Google Analytics cookies readable on this domain. It does not erase information already received by Google or cookies outside this site's control. Browser settings provide further cookie and storage controls. The analytics preference does not grant advertising consent."}]
24:["$","section","3-Local tools, saved opportunities and files",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Local tools, saved opportunities and files"}],[["$","p","Calculations and checklists run in your browser. Saving an opportunity stores its record identifier locally, up to 50 routes. Remove entries or clear the shortlist in the finder. It does not sync between devices; blocked storage can leave it only in tab memory.",{"children":"Calculations and checklists run in your browser. Saving an opportunity stores its record identifier locally, up to 50 routes. Remove entries or clear the shortlist in the finder. It does not sync between devices; blocked storage can leave it only in tab memory."}],["$","p","The Spanish planner and Pomodoro history save locally only when their save options are enabled. Passing a planner task to the timer uses temporary session storage. The APA list stays in tab memory. A Crossref lookup happens only when you request it and sends the DOI to api.crossref.org. See the Spanish policy for these tool-specific controls.",{"children":"The Spanish planner and Pomodoro history save locally only when their save options are enabled. Passing a planner task to the timer uses temporary session storage. The APA list stays in tab memory. A Crossref lookup happens only when you request it and sends the DOI to api.crossref.org. See the Spanish policy for these tool-specific controls."}],["$","p","Downloads, copying and printing create or use information on your device. AspireCompass does not receive information you later enter into a downloaded worksheet or CV template.",{"children":"Downloads, copying and printing create or use information on your device. AspireCompass does not receive information you later enter into a downloaded worksheet or CV template."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Local tools, saved opportunities and files","children":[["$","$L5","/es/privacidad/",{"href":"/es/privacidad/","children":["Spanish privacy and tool-storage details",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
25:["$","section","4-Hosting and necessary technical access",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Hosting and necessary technical access"}],[["$","p","Hosting and security services may process IP address, URL, browser information, referral data, timestamps and error or security records to deliver and protect the site. Rejecting optional analytics does not prevent technical access processing. Retention depends on the provider's role and operational or legal requirements.",{"children":"Hosting and security services may process IP address, URL, browser information, referral data, timestamps and error or security records to deliver and protect the site. Rejecting optional analytics does not prevent technical access processing. Retention depends on the provider's role and operational or legal requirements."}],["$","p","Providers supporting hosting, security, email, measurement or advertising process information according to their services and settings. Information may also be disclosed where reasonably necessary to meet applicable obligations, protect rights or investigate abuse. No internet transmission or storage system is completely secure.",{"children":"Providers supporting hosting, security, email, measurement or advertising process information according to their services and settings. Information may also be disclosed where reasonably necessary to meet applicable obligations, protect rights or investigate abuse. No internet transmission or storage system is completely secure."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","5-Advertising and separate consent controls",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Advertising and separate consent controls"}],[["$","p","AspireCompass may use Google AdSense to support its costs. When ads are enabled, third-party vendors including Google may use cookies or similar technologies to serve and measure ads, prevent abuse and, where permitted, personalise advertising based on visits to this and other websites.",{"children":"AspireCompass may use Google AdSense to support its costs. When ads are enabled, third-party vendors including Google may use cookies or similar technologies to serve and measure ads, prevent abuse and, where permitted, personalise advertising based on visits to this and other websites."}],["$","p","Applicable advertising controls are separate from the analytics preference. Personalised Google ads for visitors in the EEA, United Kingdom and Switzerland require an appropriate Google-certified consent management platform. These analytics buttons are not such a platform. Review the advertising message when ads are active and use Google Ads Settings to manage Google's personalised-ad choices.",{"children":"Applicable advertising controls are separate from the analytics preference. Personalised Google ads for visitors in the EEA, United Kingdom and Switzerland require an appropriate Google-certified consent management platform. These analytics buttons are not such a platform. Review the advertising message when ads are active and use Google Ads Settings to manage Google's personalised-ad choices."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://policies.google.com/technologies/partner-sites",{"children":["",["$","a",null,{"href":"https://policies.google.com/technologies/partner-sites","target":"_blank","rel":"noreferrer","children":"Google: data use on partner sites"}]]}],["$","span","https://adssettings.google.com/",{"children":[" · ",["$","a",null,{"href":"https://adssettings.google.com/","target":"_blank","rel":"noreferrer","children":"Google Ads Settings"}]]}],["$","span","https://support.google.com/adsense/answer/13554116?hl=en",{"children":[" · ",["$","a",null,{"href":"https://support.google.com/adsense/answer/13554116?hl=en","target":"_blank","rel":"noreferrer","children":"Google publisher consent requirements"}]]}]]]}],"$undefined"]}]
27:["$","section","6-External websites and your choices",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"External websites and your choices"}],[["$","p","Programme owners control their application portals, accounts, cookies and privacy practices. Read their policies before providing personal or academic information. This policy does not govern their processing.",{"children":"Programme owners control their application portals, accounts, cookies and privacy practices. Read their policies before providing personal or academic information. This policy does not govern their processing."}],["$","p","You can change your analytics choice, clear browser cookies and storage, or limit what you email. Applicable law may provide access, correction, deletion, objection or restriction rights. Send a focused request to the privacy contact; proportionate identity verification may be needed. The visible revision date changes when the policy or relevant features are updated.",{"children":"You can change your analytics choice, clear browser cookies and storage, or limit what you email. Applicable law may provide access, correction, deletion, objection or restriction rights. Send a focused request to the privacy contact; proportionate identity verification may be needed. The visible revision date changes when the policy or relevant features are updated."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
28:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L5","https://policies.google.com/technologies/ads",{"href":"https://policies.google.com/technologies/ads","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Google advertising privacy and policies"}],["$","span",null,{"children":"How Google uses information for advertising"}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L5","https://policies.google.com/technologies/partner-sites",{"href":"https://policies.google.com/technologies/partner-sites","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"How Google uses data on partner sites"}],["$","span",null,{"children":"Google's required partner-sites disclosure"}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":"$28:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L5","https://adssettings.google.com/",{"href":"https://adssettings.google.com/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Google Ads Settings"}],["$","span",null,{"children":"Manage personalised advertising"}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":"$28:props:children: