n","aria-label":"Plain-language page summary","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Plain-language page summary"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Topic",{"scope":"col","children":"Topic"}],["$","th","Meaning",{"scope":"col","children":"Meaning"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Contact email"}],["$","td","1",{"children":"Only the information you choose to send; omit sensitive application records"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Analytics"}],["$","td","1",{"children":"Page usage and actions such as guide links, filters and tool interaction"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Tool inputs"}],["$","td","1",{"children":"Calculated in the browser; custom action events omit entered grades and financial values"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"External applications"}],["$","td","1",{"children":"Programme owners control their own forms and privacy practices"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","1-Scope and data controller contact",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Scope and data controller contact"}],[["$","p","This policy applies to the public website at aspirecompass.org. AspireCompass is an independent information website and does not operate scholarship, university or employer application portals.",{"children":"This policy applies to the public website at aspirecompass.org. AspireCompass is an independent information website and does not operate scholarship, university or employer application portals."}],["$","p","Privacy questions can be sent to umarfarooq360official@gmail.com. Do not include passports, transcripts, banking information, passwords or other sensitive application documents in an email to us.",{"children":"Privacy questions can be sent to umarfarooq360official@gmail.com. Do not include passports, transcripts, banking information, passwords or other sensitive application documents in an email to us."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],false,"$L23","$L24"]}],"$L25"]}]
1b:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","terms",{"href":"/terms/","children":[["$","span",null,{"children":"Terms of use"}],["$","h3",null,{"children":"Terms for using AspireCompass"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","disclaimer",{"href":"/disclaimer/","children":[["$","span",null,{"children":"Information disclaimer"}],["$","h3",null,{"children":"Important limits of AspireCompass information"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","editorial-policy",{"href":"/editorial-policy/","children":[["$","span",null,{"children":"Editorial standards"}],["$","h3",null,{"children":"How AspireCompass researches, writes and corrects information"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","contact",{"href":"/contact/","children":[["$","span",null,{"children":"Contact"}],["$","h3",null,{"children":"Help us keep opportunity information useful"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$12:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
1c:["$","section","2-Information you choose to provide",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Information you choose to provide"}],[["$","p","The website does not require a reader account. If you email a correction, opportunity suggestion or question, we receive the information contained in the message, such as your email address, name if supplied, public URLs and the text of your request.",{"children":"The website does not require a reader account. If you email a correction, opportunity suggestion or question, we receive the information contained in the message, such as your email address, name if supplied, public URLs and the text of your request."}],["$","p","We use that information to understand and respond to the message, review a reported issue, protect the website and retain a reasonable record of editorial corrections. Please provide only what is necessary for that purpose.",{"children":"We use that information to understand and respond to the message, review a reported issue, protect the website and retain a reasonable record of editorial corrections. Please provide only what is necessary for that purpose."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","3-Technical and usage information",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Technical and usage information"}],[["$","p","Hosting, security and measurement services may process basic technical information such as IP address, browser type, device information, requested pages, referral information, approximate location, timestamps and error or security events. This information may be recorded automatically in server logs or aggregated analytics.",{"children":"Hosting, security and measurement services may process basic technical information such as IP address, browser type, device information, requested pages, referral information, approximate location, timestamps and error or security events. This information may be recorded automatically in server logs or aggregated analytics."}],["$","p","It is used to deliver pages, detect abuse, diagnose failures, understand broad usage and improve navigation. Retention depends on operational and legal needs and on the settings of the service provider involved.",{"children":"It is used to deliver pages, detect abuse, diagnose failures, understand broad usage and improve navigation. Retention depends on operational and legal needs and on the settings of the service provider involved."}],["$","p","Google Analytics receives page-usage and action events, including guide/source clicks, filter result counts, checklist use and the first calculator interaction. Custom action events do not include entered grades, financial amounts, search terms or application documents. Calculators and checklists work locally in the browser.",{"children":"Google Analytics receives page-usage and action events, including guide/source clicks, filter result counts, checklist use and the first calculator interaction. Custom action events do not include entered grades, financial amounts, search terms or application documents. Calculators and checklists work locally in the browser."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","4-Google advertising and cookies",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Google advertising and cookies"}],[["$","p","AspireCompass may use Google AdSense to display advertising. When Google advertising is active, Google and its partners may use cookies or similar identifiers to serve, personalise and measure ads, limit repeated ads, detect fraud and produce reporting. Depending on your region and consent choices, ads may be personalised or non-personalised.",{"children":"AspireCompass may use Google AdSense to display advertising. When Google advertising is active, Google and its partners may use cookies or similar identifiers to serve, personalise and measure ads, limit repeated ads, detect fraud and produce reporting. Depending on your region and consent choices, ads may be personalised or non-personalised."}],["$","p","Third-party vendors, including Google, may place or read cookies in a visitor's browser or use web beacons and similar technologies to collect information as a result of ad serving. Google advertising cookies can support ads based on previous visits to this or other websites. Users can manage personalised advertising through Google Ads Settings, and may learn about additional industry opt-out choices through AboutAds where available.",{"children":"Third-party vendors, including Google, may place or read cookies in a visitor's browser or use web beacons and similar technologies to collect information as a result of ad serving. Google advertising cookies can support ads based on previous visits to this or other websites. Users can manage personalised advertising through Google Ads Settings, and may learn about additional industry opt-out choices through AboutAds where available."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","5-Consent for visitors in the EEA, United Kingdom and Switzerland",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Consent for visitors in the EEA, United Kingdom and Switzerland"}],[["$","p","Advertising and analytics processing depend on the services active on the site and applicable regional requirements. Use any consent or privacy controls presented on the site to review your choices. Browser settings can also block or delete cookies. External programme websites operate their own consent and privacy controls.",{"children":"Advertising and analytics processing depend on the services active on the site and applicable regional requirements. Use any consent or privacy controls presented on the site to review your choices. Browser settings can also block or delete cookies. External programme websites operate their own consent and privacy controls."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","6-External websites and application portals",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"External websites and application portals"}],[["$","p","AspireCompass links to programme owners and other external websites. Those organisations control their own forms, cookies, accounts and privacy practices. Read their policies before submitting personal or academic records; this policy does not govern their processing.",{"children":"AspireCompass links to programme owners and other external websites. Those organisations control their own forms, cookies, accounts and privacy practices. Read their policies before submitting personal or academic records; this policy does not govern their processing."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","7-Sharing, retention and security",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Sharing, retention and security"}],[["$","p","Information may be processed by service providers that support hosting, security, email, analytics, consent or advertising, subject to their role and terms. It may also be disclosed when reasonably necessary to comply with law, protect rights or investigate abuse. AspireCompass does not sell application documents and does not ask users to upload them.",{"children":"Information may be processed by service providers that support hosting, security, email, analytics, consent or advertising, subject to their role and terms. It may also be disclosed when reasonably necessary to comply with law, protect rights or investigate abuse. AspireCompass does not sell application documents and does not ask users to upload them."}],["$","p","Reasonable technical and organisational safeguards are used, but no internet transmission or storage system is guaranteed completely secure. Contact correspondence is retained only as long as reasonably needed for its purpose, record keeping, security or legal obligations.",{"children":"Reasonable technical and organisational safeguards are used, but no internet transmission or storage system is guaranteed completely secure. Contact correspondence is retained only as long as reasonably needed for its purpose, record keeping, security or legal obligations."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","8-Your choices and policy changes",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Your choices and policy changes"}],[["$","p","Depending on where you live, applicable law may provide rights concerning access, correction, deletion, objection or restriction. Send a focused request to the contact address above; identity may need to be verified without collecting unnecessary information.",{"children":"Depending on where you live, applicable law may provide rights concerning access, correction, deletion, objection or restriction. Send a focused request to the contact address above; identity may need to be verified without collecting unnecessary information."}],["$","p","Browser controls can block or delete cookies, though this may affect features or saved consent choices. This policy may be updated when services or legal requirements change. The latest revision date will appear at the top of this page.",{"children":"Browser controls can block or delete cookies, though this may affect features or saved consent choices. This policy may be updated when services or legal requirements change. The latest revision date will appear at the top of this page."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
