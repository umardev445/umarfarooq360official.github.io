1b:["$","section","1-What to include",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"What to include"}],[["$","p","Send the listing title, the page URL, the specific correction and an official source that confirms the change. For new opportunities, include the programme owner's application page and current deadline.",{"children":"Send the listing title, the page URL, the specific correction and an official source that confirms the change. For new opportunities, include the programme owner's application page and current deadline."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Correction or submission type",{"children":"Correction or submission type"}],["$","li","AspireCompass page URL",{"children":"AspireCompass page URL"}],["$","li","Official programme URL",{"children":"Official programme URL"}],["$","li","Exact detail to update",{"children":"Exact detail to update"}],["$","li","Your contact email",{"children":"Your contact email"}]]}],"$undefined","$undefined"]}]
1c:["$","section","2-Editorial independence",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Editorial independence"}],[["$","p","Submission does not guarantee publication. We prioritise legitimate, clearly documented opportunities and may decline unclear, fee-based or unverifiable programmes.",{"children":"Submission does not guarantee publication. We prioritise legitimate, clearly documented opportunities and may decline unclear, fee-based or unverifiable programmes."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","3-What AspireCompass can and cannot answer",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"What AspireCompass can and cannot answer"}],[["$","p","We can review reports about a page, broken official link or material programme change. We cannot make an official eligibility decision, review confidential application documents, contact a university on your behalf or predict a selection result.",{"children":"We can review reports about a page, broken official link or material programme change. We cannot make an official eligibility decision, review confidential application documents, contact a university on your behalf or predict a selection result."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","4-Protect your personal information",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Protect your personal information"}],[["$","p","Do not email passports, national identity cards, transcripts, bank records, account passwords, one-time codes or full application files. A correction normally needs only the public page URL, the exact issue and a supporting official source.",{"children":"Do not email passports, national identity cards, transcripts, bank records, account passwords, one-time codes or full application files. A correction normally needs only the public page URL, the exact issue and a supporting official source."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","5-How submissions are reviewed",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"How submissions are reviewed"}],[["$","p","A suggestion is assessed for source quality, applicant value, transparency and safety. AspireCompass may edit a submitted description, wait for clearer official evidence or decline a programme. Submission does not create a commercial or advisory relationship.",{"children":"A suggestion is assessed for source quality, applicant value, transparency and safety. AspireCompass may edit a submitted description, wait for clearer official evidence or decline a programme. Submission does not create a commercial or advisory relationship."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
