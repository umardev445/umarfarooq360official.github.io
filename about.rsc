1d:["$","section","3-Coverage transparency",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Coverage transparency"}],[["$","p","AspireCompass expands coverage carefully, with priority given to official programmes, high-intent country pages and practical application resources. We prefer an honest gap over an unverified listing.",{"children":"AspireCompass expands coverage carefully, with priority given to official programmes, high-intent country pages and practical application resources. We prefer an honest gap over an unverified listing."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","4-How the editorial process works",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"How the editorial process works"}],[["$","p","A listing begins with a programme owner, government, university or employer source. We record the programme name, audience, funding description, application route, deadline wording and the date checked. When a current cycle cannot be confirmed, the page says so rather than presenting an old date as open.",{"children":"A listing begins with a programme owner, government, university or employer source. We record the programme name, audience, funding description, application route, deadline wording and the date checked. When a current cycle cannot be confirmed, the page says so rather than presenting an old date as open."}],["$","p","Guides are written to add practical value: decision frameworks, checklists, risk warnings and document strategies. They are not copied versions of official calls, and official instructions always take priority.",{"children":"Guides are written to add practical value: decision frameworks, checklists, risk warnings and document strategies. They are not copied versions of official calls, and official instructions always take priority."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","5-Corrections, updates and accountability",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Corrections, updates and accountability"}],[["$","p","Readers and programme owners can report an error through the contact page. A useful correction includes the AspireCompass URL, the disputed detail and a current primary source. Material deadline or eligibility changes are reviewed and updated as quickly as practical.",{"children":"Readers and programme owners can report an error through the contact page. A useful correction includes the AspireCompass URL, the disputed detail and a current primary source. Material deadline or eligibility changes are reviewed and updated as quickly as practical."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","6-Advertising and editorial independence",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Advertising and editorial independence"}],[["$","p","Advertising may support the cost of operating AspireCompass, but advertisers do not receive control over eligibility summaries, status labels, rankings or editorial conclusions. Sponsored material, if introduced, will be identified clearly and kept distinct from independent opportunity listings.",{"children":"Advertising may support the cost of operating AspireCompass, but advertisers do not receive control over eligibility summaries, status labels, rankings or editorial conclusions. Sponsored material, if introduced, will be identified clearly and kept distinct from independent opportunity listings."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","7-Who the site serves",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Who the site serves"}],[["$","p","The platform serves English- and Spanish-language readers, including applicants who are navigating international admissions for the first time. The Spanish section has its own academic tools, preparation guides and navigation. We use plain language, explain uncertainty and avoid promises of admission, funding, employment or visas.",{"children":"The platform serves English- and Spanish-language readers, including applicants who are navigating international admissions for the first time. The Spanish section has its own academic tools, preparation guides and navigation. We use plain language, explain uncertainty and avoid promises of admission, funding, employment or visas."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","8-Meet the founder and editorial contact",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Meet the founder and editorial contact"}],[["$","p","Hafiz Umar Farooq is the founder, CEO and editor of AspireCompass. He is a Computer Engineering student at International Islamic University Islamabad and has three years of SEO experience. His profile explains his role and provides direct contact details.",{"children":"Hafiz Umar Farooq is the founder, CEO and editor of AspireCompass. He is a Computer Engineering student at International Islamic University Islamabad and has three years of SEO experience. His profile explains his role and provides direct contact details."}],["$","p","Guides remain attributed to AspireCompass unless an individual author is explicitly named. The founder profile is an identity and editorial contact page, rather than a claim of personal scholarship or university experience.",{"children":"Guides remain attributed to AspireCompass unless an individual author is explicitly named. The founder profile is an identity and editorial contact page, rather than a claim of personal scholarship or university experience."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Meet the founder and editorial contact","children":[["$","$L4","/team/hafiz-umar-farooq/",{"href":"/team/hafiz-umar-farooq/","children":["Hafiz Umar Farooq: founder, CEO & editor",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
23:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is AspireCompass a scholarship provider?",{"children":[["$","summary",null,{"children":["Is AspireCompass a scholarship provider?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass does not award funding, accept applications or influence programme decisions. It is an independent discovery and education website."}]]}],["$","details","How does AspireCompass make money?",{"children":[["$","summary",null,{"children":["How does AspireCompass make money?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The site may use advertising to support operating costs. Advertising is separated from editorial decisions, and a paid placement would need clear disclosure."}]]}],["$","details","Who writes the guides?",{"children":[["$","summary",null,{"children":["Who writes the guides?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Guides are published by the AspireCompass Editorial Team using official programme instructions and original application-planning frameworks. The editorial policy explains sourcing, review and corrections."}]]}]]}]]}]
