1b:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"The 2027–28 offer requires country-specific checks and formal academic support for research. Pakistan’s listed 31 October 2026 deadline is past; Indonesia’s 30 November 2026 row differs. Use the current country list and GO ESKAS instructions."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Confirm your country and scholarship type first, then map your proposal to the host evidence you need."]}],"$undefined"]}],["$","figure",null,{"className":"page-visual day15-guide-visual page-visual--inline","children":[["$","img",null,{"src":"/images/day25/application-workspace-1280.webp","srcSet":"/images/day25/application-workspace-640.webp 640w, /images/day25/application-workspace-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), (max-width: 1150px) calc(100vw - 64px), 760px","width":1280,"height":853,"alt":"Illustrative scene of two students comparing application folders in a library","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Illustrative study scene. The people do not represent this programme or university."}]]}],false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Read your country row before contacting a host",{"href":"#section-1","children":"Read your country row before contacting a host"}],["$","a","Separate the research, PhD and art routes",{"href":"#section-2","children":"Separate the research, PhD and art routes"}],["$","a","Build a host-evidence matrix around a real project",{"href":"#section-3","children":"Build a host-evidence matrix around a real project"}],["$","a","Interpret a host reply without upgrading its meaning",{"href":"#section-4","children":"Interpret a host reply without upgrading its meaning"}],["$","a","Prepare a feasible proposal before polishing its language",{"href":"#section-5","children":"Prepare a feasible proposal before polishing its language"}],["$","a","Use the current online channel and check the cost gap",{"href":"#section-6","children":"Use the current online channel and check the cost gap"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Read your country row before contacting a host",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Read your country row before contacting a host"}],[["$","p","The country list controls available scholarship types and deadlines. Its 2027–28 Asia table lists Pakistan’s close as 31 October 2026 and Indonesia’s as 30 November 2026, both at 23:59 Swiss local time. On this review date the Pakistan cutoff is past. Another country’s later date does not extend it.",{"children":"The country list controls available scholarship types and deadlines. Its 2027–28 Asia table lists Pakistan’s close as 31 October 2026 and Indonesia’s as 30 November 2026, both at 23:59 Swiss local time. On this review date the Pakistan cutoff is past. Another country’s later date does not extend it."}],["$","p","Create one country-offer record before drafting emails: nationality or origin category used by the scheme, scholarship type, closing date, time zone and official contact. If your personal circumstances make the category unclear, obtain an answer through the named official route rather than selecting the row with more time available. Keep the source version beside the record.",{"children":"Create one country-offer record before drafting emails: nationality or origin category used by the scheme, scholarship type, closing date, time zone and official contact. If your personal circumstances make the category unclear, obtain an answer through the named official route rather than selecting the row with more time available. Keep the source version beside the record."}]],"$undefined","$L1d","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]]}],false,false,false,false,"$L1e",false,"$L1f","$L20"]}],"$L21"]}]
