dmin.ch/en/faq-swiss-government-excellence-scholarships","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"SERI: applicant and supervisor FAQ"}],["$","span",null,{"children":"Reviewed 23 November 2026. Distinguishes ordinary PhD and graduate-school admission evidence; postdoctoral awards cease from 2027/28."}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":"$1f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L5","https://www.sbfi.admin.ch/dam/en/sd-web/ETBRLVHEDk7K/2026-08-04_Asia_List_of_countries_and_territories_complete.pdf",{"href":"https://www.sbfi.admin.ch/dam/en/sd-web/ETBRLVHEDk7K/2026-08-04_Asia_List_of_countries_and_territories_complete.pdf","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"SERI:2027–28 Asia country offer list PDF"}],["$","span",null,{"children":"PDF text and screenshots pages 1 and 4 reviewed 23 November 2026. Country rows differ; times stated as 23:59 Swiss local time."}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":"$1f:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
