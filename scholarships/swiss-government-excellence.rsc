22:["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original proposal-to-host evidence matrix"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Project element",{"scope":"col","children":"Project element"}],["$","th","Your evidence",{"scope":"col","children":"Your evidence"}],["$","th","Question for the host",{"scope":"col","children":"Question for the host"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Question"}],["$","td","1",{"children":"One answerable research problem"}],["$","td","2",{"children":"Does it fit the group’s current work?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Method"}],["$","td","1",{"children":"A technique you can explain"}],["$","td","2",{"children":"What training or supervision is needed?"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Resources"}],["$","td","1",{"children":"Data or facilities actually identified"}],["$","td","2",{"children":"Is access feasible for this project?"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Collaboration"}],["$","td","1",{"children":"A realistic shared output"}],["$","td","2",{"children":"What support can be formally confirmed?"}]],"$undefined"]}]]}]]}]
23:["$","section","3-Interpret a host reply without upgrading its meaning",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Interpret a host reply without upgrading its meaning"}],[["$","p","Keep a small status vocabulary in your notes: enquiry sent, discussion invited, project under review and formal support received. An encouraging reply belongs in the discussion stage until the required document is actually provided. It should not be described in your application as a scholarship award.",{"children":"Keep a small status vocabulary in your notes: enquiry sent, discussion invited, project under review and formal support received. An encouraging reply belongs in the discussion stage until the required document is actually provided. It should not be described in your application as a scholarship award."}],["$","p","The federal FAQ distinguishes an ordinary supervised PhD from a doctoral-school route: the latter can require admission evidence alongside the host-support document. If a school’s process prevents obtaining required evidence before the scholarship deadline, ask the school and scheme contact about the actual route. A missing prerequisite cannot be repaired by replacing it with an informal email.",{"children":"The federal FAQ distinguishes an ordinary supervised PhD from a doctoral-school route: the latter can require admission evidence alongside the host-support document. If a school’s process prevents obtaining required evidence before the scholarship deadline, ask the school and scheme contact about the actual route. A missing prerequisite cannot be repaired by replacing it with an informal email."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original host-reply interpretation","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original host-reply interpretation"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Message",{"scope":"col","children":"Message"}],["$","th","Record as",{"scope":"col","children":"Record as"}],["$","th","Do next",{"scope":"col","children":"Do next"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Interesting; send details"}],["$","td","1",{"children":"Discussion invited"}],["$","td","2",{"children":"Answer the specific request"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"I can consider this project"}],["$","td","1",{"children":"Host assessment pending"}],["$","td","2",{"children":"Clarify required support evidence"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Formal support supplied"}],["$","td","1",{"children":"Support document received"}],["$","td","2",{"children":"Check scholarship and admission requirements separately"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","4-Prepare a feasible proposal before polishing its language",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Prepare a feasible proposal before polishing its language"}],[["$","p","Use a one-page private outline before writing the official version: question, prior evidence, proposed method, milestones and main uncertainty. Test whether each planned activity answers the question. If an activity requires data that will not be accessible, narrow the question or describe an alternative that you can actually carry out.",{"children":"Use a one-page private outline before writing the official version: question, prior evidence, proposed method, milestones and main uncertainty. Test whether each planned activity answers the question. If an activity requires data that will not be accessible, narrow the question or describe an alternative that you can actually carry out."}],["$","p","For a fictional six-stage plan, the first tasks might be reading, confirming data access and testing one method before attempting the full analysis. The exact timeline should follow the real project and prescribed form. Avoid promising a result you cannot guarantee; a proposal should show how evidence will be evaluated, including an inconclusive result.",{"children":"For a fictional six-stage plan, the first tasks might be reading, confirming data access and testing one method before attempting the full analysis. The exact timeline should follow the real project and prescribed form. Avoid promising a result you cannot guarantee; a proposal should show how evidence will be evaluated, including an inconclusive result."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","5-Use the current online channel and check the cost gap",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Use the current online channel and check the cost gap"}],[["$","p","The current detailed guidance directs applications through GO ESKAS and says not to send applications by email or paper. Follow the live form for evidence and submission status. Keep the final receipt and monitor referee or supporting-document requests separately.",{"children":"The current detailed guidance directs applications through GO ESKAS and says not to send applications by email or paper. Follow the live form for evidence and submission status. Keep the final receipt and monitor referee or supporting-document requests separately."}],["$","p","Build a budget from the actual benefit terms and host costs rather than assuming that the word excellence covers every expense. Record fees, initial housing costs and research activities separately. Ask about an unresolved item before making commitments. Your personal worksheet should distinguish confirmed support, expected support and money still to arrange.",{"children":"Build a budget from the actual benefit terms and host costs rather than assuming that the word excellence covers every expense. Record fees, initial housing costs and research activities separately. Ask about an unresolved item before making commitments. Your personal worksheet should distinguish confirmed support, expected support and money still to arrange."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Use the current online channel and check the cost gap","children":[["$","$L5","/guides/find-phd-supervisor/",{"href":"/guides/find-phd-supervisor/","children":["Find a supervisor with evidence",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/scholarships/phd/",{"href":"/scholarships/phd/","children":["Compare PhD routes",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","https://www.sbfi.admin.ch/en/swiss-government-excellence-scholarships-at-a-glance",{"href":"https://www.sbfi.admin.ch/en/swiss-government-excellence-scholarships-at-a-glance","children":["Check the official research guidance",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
