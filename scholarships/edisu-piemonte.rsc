27:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is EDISU Piemonte the same as EDiSU Pavia?",{"children":[["$","summary",null,{"children":["Is EDISU Piemonte the same as EDiSU Pavia?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. They are separate authorities. Use the benefit notice linked by your intended institution, not simply the first page matching the word EDISU."}]]}],["$","details","Is every part of the international application online?",{"children":[["$","summary",null,{"children":["Is every part of the international application online?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No blanket claim is safe. The official international-student page distinguishes online submission and the delivery required for relevant consular documentation. Follow your category in the notice."}]]}],["$","details","Can I request accommodation later?",{"children":[["$","summary",null,{"children":["Can I request accommodation later?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"EDISU’s scholarship page says to select accommodation at the same time as the scholarship request. Check the current notice before submitting if housing is important to your plan."}]]}],["$","details","Will EDISU email my result?",{"children":[["$","summary",null,{"children":["Will EDISU email my result?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The checked official guidance says rankings are available in the personal area and individual notifications are not sent. Monitor your portal and the ranking schedule."}]]}],["$","details","Can a master’s applicant use the November PhD deadline?",{"children":[["$","summary",null,{"children":["Can a master’s applicant use the November PhD deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The later window is for the categories named in that notice. A closed ordinary degree-student deadline is not extended by a different category’s window."}]]}]]}]]}]
