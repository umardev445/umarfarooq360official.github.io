25:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Do not collapse the two submission channels","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Do not collapse the two submission channels"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Task",{"scope":"col","children":"Task"}],["$","th","Record to retain",{"scope":"col","children":"Record to retain"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Benefit application online"}],["$","td","1",{"children":"Final application receipt and submitted benefit choices"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Required foreign economic evidence"}],["$","td","1",{"children":"Original, translation and authentication records required by the notice"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Required physical delivery"}],["$","td","1",{"children":"Tracking and proof of delivery when your category requires it"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Correction or appeal"}],["$","td","1",{"children":"The official submission record within its own window"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://www.edisu.piemonte.it/en/international-students","target":"_blank","rel":"noreferrer","children":"Official guidance"}]]}]]
26:["$","section","3-In sede, pendolare and fuori sede: why the classification matters",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"In sede, pendolare and fuori sede: why the classification matters"}],[["$","p","The call classifies students by residence/travel and accommodation conditions. The classification affects the grant calculation and services; nationality alone does not establish fuori sede status.",{"children":"The call classifies students by residence/travel and accommodation conditions. The classification affects the grant calculation and services; nationality alone does not establish fuori sede status."}],["$","p","Use the current notice’s definitions, travel/residence conditions and any accommodation-contract evidence. A student can need both economic eligibility and the evidence for the claimed residence category. Do not add a headline grant to the full value of housing or meals if the notice deducts those services.",{"children":"Use the current notice’s definitions, travel/residence conditions and any accommodation-contract evidence. A student can need both economic eligibility and the evidence for the claimed residence category. Do not add a headline grant to the full value of housing or meals if the notice deducts those services."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Read the residence category before comparing a grant","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Read the residence category before comparing a grant"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Category",{"scope":"col","children":"Category"}],["$","th","Meaning to investigate",{"scope":"col","children":"Meaning to investigate"}],["$","th","Evidence to verify in the notice",{"scope":"col","children":"Evidence to verify in the notice"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"In sede"}],["$","td","1",{"children":"Student within the defined study-location area"}],["$","td","2",{"children":"Residence and covered municipalities."}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Pendolare"}],["$","td","1",{"children":"Commuting category under the notice"}],["$","td","2",{"children":"Residence/travel conditions and authority classification."}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Fuori sede"}],["$","td","1",{"children":"Away-from-home category under the notice"}],["$","td","2",{"children":"Required accommodation, contract/duration and any residence exceptions."}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.edisu.piemonte.it/sites/default/files/documentazione/bandi-di-concorso/Notice_of_competition_scholarship_accomodation_degree_award_and_contribution_for_students_with_a_disability_of_46_p._or_more_registered_for_targeted_employment_a.y_2026_27_1.pdf",{"children":["",["$","a",null,{"href":"https://www.edisu.piemonte.it/sites/default/files/documentazione/bandi-di-concorso/Notice_of_competition_scholarship_accomodation_degree_award_and_contribution_for_students_with_a_disability_of_46_p._or_more_registered_for_targeted_employment_a.y_2026_27_1.pdf","target":"_blank","rel":"noreferrer","children":"EDISU 2026–2027 notice: definitions and benefit calculations"}]]}]]]}],"$undefined"]}]
27:["$","section","4-Confirm that Piemonte is the right authority",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Confirm that Piemonte is the right authority"}],[["$","p","Start with the institution and benefit in the current notice. EDISU Piemonte supports the covered Piedmont institutions; the similar name EDiSU Pavia refers to a different authority. The correct university admission portal is also a different service from the EDISU benefit application.",{"children":"Start with the institution and benefit in the current notice. EDISU Piemonte supports the covered Piedmont institutions; the similar name EDiSU Pavia refers to a different authority. The correct university admission portal is also a different service from the EDISU benefit application."}],["$","p","Record three official addresses in your tracker: the university programme page, the EDISU annual notice and the benefit portal. This small separation prevents an admission receipt from being mistaken for a scholarship submission or a funding document from being sent to the wrong office.",{"children":"Record three official addresses in your tracker: the university programme page, the EDISU annual notice and the benefit portal. This small separation prevents an admission receipt from being mistaken for a scholarship submission or a funding document from being sent to the wrong office."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Confirm that Piemonte is the right authority","children":[["$","$L5","/guides/university-of-turin-admissions-scholarships/",{"href":"/guides/university-of-turin-admissions-scholarships/","children":["University of Turin admission and funding",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/politecnico-di-torino-admissions-scholarships/",{"href":"/guides/politecnico-di-torino-admissions-scholarships/","children":["Politecnico di Torino admission and funding",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/university-of-pavia-admissions-scholarships/",{"href":"/guides/university-of-pavia-admissions-scholarships/","children":["Pavia’s separate route",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
28:["$","section","5-Portal access: request the correct credentials early",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Portal access: request the correct credentials early"}],[["$","p","The official EDISU page permits SPID or CIE access and describes a Temporary Access Code route for relevant international students without those credentials. The code is used for the personal area, applications and later records; it should not be shared with an unofficial intermediary.",{"children":"The official EDISU page permits SPID or CIE access and describes a Temporary Access Code route for relevant international students without those credentials. The code is used for the personal area, applications and later records; it should not be shared with an unofficial intermediary."}],["$","p","Access is only the beginning. Once your account works, identify the precise benefit, academic year and applicant category. Check that your email is usable and that you can reopen saved records. A registration email or a saved draft is not the final scholarship receipt.",{"children":"Access is only the beginning. Once your account works, identify the precise benefit, academic year and applicant category. Check that your email is usable and that you can reopen saved records. A registration email or a saved draft is not the final scholarship receipt."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.edisu.piemonte.it/en/international-students",{"children":["",["$","a",null,{"href":"https://www.edisu.piemonte.it/en/international-students","target":"_blank","rel":"noreferrer","children":"Temporary Access Code and international-student instructions"}]]}]]]}],"$undefined"]}]
29:["$","section","6-Build an economic file that explains the household",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Build an economic file that explains the household"}],[["$","p","Read the current financial and merit rules before ordering certificates. Work through household composition, relevant income and assets using the reference periods and forms specified by the notice. A property certificate covering the wrong year can be as unhelpful as a missing certificate.",{"children":"Read the current financial and merit rules before ordering certificates. Work through household composition, relevant income and assets using the reference periods and forms specified by the notice. A property certificate covering the wrong year can be as unhelpful as a missing certificate."}],["$","p","Keep a reconciliation sheet alongside the documents: person, document, reference period, language and status. Where a fact is zero, ask what evidence is accepted rather than leaving it unexplained. When translation or legalisation is required, keep the relationship between the source document and its translation clear. Do not guess an Italian financial indicator by converting one bank balance into euros.",{"children":"Keep a reconciliation sheet alongside the documents: person, document, reference period, language and status. Where a fact is zero, ask what evidence is accepted rather than leaving it unexplained. When translation or legalisation is required, keep the relationship between the source document and its translation clear. Do not guess an Italian financial indicator by converting one bank balance into euros."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2e",null,{"id":"scholarships/edisu-piemonte:section-7","title":"Check your progress","items":["Correct academic year and category selected.","Every relevant household member is accounted for.","Income and asset reference periods match the notice.","Translations and authentication meet the relevant instructions.","Portal and delivery requirements are both tracked."]}],["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.edisu.piemonte.it/en/scholarships-and-grants/financial-benefits/scholarship-and-grants",{"children":["",["$","a",null,{"href":"https://www.edisu.piemonte.it/en/scholarships-and-grants/financial-benefits/scholarship-and-grants","target":"_blank","rel":"noreferrer","children":"Read the notice and its annexes"}]]}]]]}],"$undefined"]}]
2a:["$","section","7-Housing: request it within the benefit process",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Housing: request it within the benefit process"}],[["$","p","EDISU states that accommodation must be requested together with the scholarship by selecting the relevant option. Researching housing after the scholarship submission can therefore be too late for that benefit. A request is also different from a residence place being assigned.",{"children":"EDISU states that accommodation must be requested together with the scholarship by selecting the relevant option. Researching housing after the scholarship submission can therefore be too late for that benefit. A request is also different from a residence place being assigned."}],["$","p","Compare the support as cash plus services. If a residence benefit changes the cash quota, do not count the full cash headline and the full service value twice. Keep a realistic alternative for a housing deposit and temporary accommodation while you await the relevant result.",{"children":"Compare the support as cash plus services. If a residence benefit changes the cash quota, do not count the full cash headline and the full service value twice. Keep a realistic alternative for a housing deposit and temporary accommodation while you await the relevant result."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.edisu.piemonte.it/en/scholarships-and-grants/financial-benefits/scholarship-and-grants",{"children":["",["$","a",null,{"href":"https://www.edisu.piemonte.it/en/scholarships-and-grants/financial-benefits/scholarship-and-grants","target":"_blank","rel":"noreferrer","children":"Official accommodation application explanation"}]]}]]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Housing: request it within the benefit process","children":[["$","$L5","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Build a realistic Italy budget",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2b:["$","section","8-Rankings, appeals and academic conditions after applying",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Rankings, appeals and academic conditions after applying"}],[["$","p","The official page directs applicants to provisional and final rankings in their personal area and says that individual notifications are not sent. Schedule your own checks; waiting for an email is not an adequate result-tracking method.",{"children":"The official page directs applicants to provisional and final rankings in their personal area and says that individual notifications are not sent. Schedule your own checks; waiting for an email is not an adequate result-tracking method."}],["$","p","Read the exact reason for any condition or exclusion and the notice’s correction procedure. Save the record before seeking help. If a deadline for academic merit applies later, add it to your study planner now. A benefit can involve obligations after the application has been accepted; admission to the university does not remove those conditions.",{"children":"Read the exact reason for any condition or exclusion and the notice’s correction procedure. Save the record before seeking help. If a deadline for academic merit applies later, add it to your study planner now. A benefit can involve obligations after the application has been accepted; admission to the university does not remove those conditions."}]],["$","ol",null,{"className":"process-steps","aria-label":"Rankings, appeals and academic conditions after applying","children":[["$","li","Check the published ranking schedule.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Check the published ranking schedule."}]]}],["$","li","Open your own official record.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Open your own official record."}]]}],["$","li","Identify the benefit and any condition or exclusion.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Identify the benefit and any condition or exclusion."}]]}],["$","li","Use the prescribed review channel if a correction is permitted.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Use the prescribed review channel if a correction is permitted."}]]}],["$","li","Record the final outcome and later merit/payment tasks.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Record the final outcome and later merit/payment tasks."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.edisu.piemonte.it/en/scholarships-and-grants/financial-benefits/scholarship-and-grants",{"children":["",["$","a",null,{"href":"https://www.edisu.piemonte.it/en/scholarships-and-grants/financial-benefits/scholarship-and-grants","target":"_blank","rel":"noreferrer","children":"Official rankings and results guidance"}]]}]]]}],"$undefined"]}]
2c:["$","section","9-Use the support channel for a precise question",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"Use the support channel for a precise question"}],[["$","p","A useful support request identifies your application number, academic year, category and the particular article you cannot apply to your case. Ask whether the rule or document fits the situation; do not send a large collection of personal documents to unrelated inboxes. Keep the authority’s written response with your records.",{"children":"A useful support request identifies your application number, academic year, category and the particular article you cannot apply to your case. Ask whether the rule or document fits the situation; do not send a large collection of personal documents to unrelated inboxes. Keep the authority’s written response with your records."}],["$","p","For broader planning, use the DSU overview to understand regional assistance and the university-specific guide to arrange admission. Return to EDISU for the authoritative funding decision.",{"children":"For broader planning, use the DSU overview to understand regional assistance and the university-specific guide to arrange admission. Return to EDISU for the authoritative funding decision."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Use the support channel for a precise question","children":[["$","$L5","/guides/italy-dsu-scholarships/",{"href":"/guides/italy-dsu-scholarships/","children":["Understand regional DSU support",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/isee-parificato-international-students/",{"href":"/guides/isee-parificato-international-students/","children":["Prepare ISEE-related evidence",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2d:["$","section","10-Compare regional deadlines separately",{"className":"article-section","id":"section-11","children":[["$","h2",null,{"children":"Compare regional deadlines separately"}],[["$","p","A later ranking or document date does not reopen an expired main scholarship application. Use the cross-authority comparison for another university or regional route.",{"children":"A later ranking or document date does not reopen an expired main scholarship application. Use the cross-authority comparison for another university or regional route."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Compare regional deadlines separately","children":[["$","$L5","/guides/dsu-italy-deadlines-by-region/",{"href":"/guides/dsu-italy-deadlines-by-region/","children":["DSU Italy deadlines by region: current status and next steps",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
