1a:T5e8,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is EDISU Piemonte the same as EDiSU Pavia?","acceptedAnswer":{"@type":"Answer","text":"No. They are separate authorities. Use the benefit notice linked by your intended institution, not simply the first page matching the word EDISU."}},{"@type":"Question","name":"Is every part of the international application online?","acceptedAnswer":{"@type":"Answer","text":"No blanket claim is safe. The official international-student page distinguishes online submission and the delivery required for relevant consular documentation. Follow your category in the notice."}},{"@type":"Question","name":"Can I request accommodation later?","acceptedAnswer":{"@type":"Answer","text":"EDISU’s scholarship page says to select accommodation at the same time as the scholarship request. Check the current notice before submitting if housing is important to your plan."}},{"@type":"Question","name":"Will EDISU email my result?","acceptedAnswer":{"@type":"Answer","text":"The checked official guidance says rankings are available in the personal area and individual notifications are not sent. Monitor your portal and the ranking schedule."}},{"@type":"Question","name":"Can a master’s applicant use the November PhD deadline?","acceptedAnswer":{"@type":"Answer","text":"No. The later window is for the categories named in that notice. A closed ordinary degree-student deadline is not extended by a different category’s window."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide gsc-release","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/scholarships/edisu-piemonte/\",\"name\":\"EDISU Piemonte scholarship: dates, portal and documents\",\"description\":\"Find the correct EDISU Piemonte portal, 2026/27 category dates, internat