19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/research-2026-10/edisu-1280.webp","srcSet":"/images/research-2026-10/edisu-640.webp 640w, /images/research-2026-10/edisu-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Conceptual illustration for edisu piemonte scholarship: documents, housing and the correct application route","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Original conceptual illustration; not a photograph of a named university or scholarship recipient."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"EDISU Piemonte is regional study support, separate from university admission and from EDiSU Pavia. The ordinary 2026/27 degree-student window is closed. The official page lists a separate PhD/specialisation window beginning 28 October 2026."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose your study category and family-document route before opening the application; an online form may not complete the documentary requirement."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","#official-sources",{"href":"#official-sources","children":["Official sources",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":