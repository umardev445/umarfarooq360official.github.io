21:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-EDISU login, scholarship application and rankings",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"EDISU login, scholarship application and rankings"}],[["$","p","If you searched for EDISU login or the application portal, use the authority’s own service links. You should not enter portal credentials on AspireCompass or an intermediary’s form.",{"children":"If you searched for EDISU login or the application portal, use the authority’s own service links. You should not enter portal credentials on AspireCompass or an intermediary’s form."}],["$","p","The personal area is used for benefit applications, receipts and rankings. For relevant international students without SPID/CIE, EDISU explains the Temporary Access Code procedure; check the annual validity and request it through the linked instructions.",{"children":"The personal area is used for benefit applications, receipts and rankings. For relevant international students without SPID/CIE, EDISU explains the Temporary Access Code procedure; check the annual validity and request it through the linked instructions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for EDISU login, scholarship application and rankings","children":[["$","$L5","https://clio.edisu-piemonte.it/",{"href":"https://clio.edisu-piemonte.it/","children":["Official EDISU online services",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","https://www.edisu.piemonte.it/en/international-students",{"href":"https://www.edisu.piemonte.it/en/international-students","children":["International-student access instructions",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconN