24:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can Pakistani students apply?",{"children":[["$","summary",null,{"children":["Can Pakistani students apply?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Pakistani applicants should check the current eligible-applicant rules and the programmes available to their profile. Nationality alone does not establish eligibility or guarantee selection."}]]}],["$","details","Is IELTS compulsory for every programme?",{"children":[["$","summary",null,{"children":["Is IELTS compulsory for every programme?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No single rule covers every programme. A chosen teaching language or university may require an accepted certificate or another admission test."}]]}],["$","details","Do I apply separately to a university?",{"children":[["$","summary",null,{"children":["Do I apply separately to a university?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The full-time scholarship includes placement. Follow the scholarship portal instructions for your preferences rather than assuming a separate admission route applies."}]]}]]}]]}]
