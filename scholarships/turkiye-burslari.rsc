1b:["$","p","Use the months before applications to obtain missing academic records, compare courses and ask suitable referees. A polished statement cannot repair an ineligible age, qualification or programme choice. Keep research and short-term schemes separate from the full-time degree route described here.",{"children":"Use the months before applications to obtain missing academic records, compare courses and ask suitable referees. A polished statement cannot repair an ineligible age, qualification or programme choice. Keep research and short-term schemes separate from the full-time degree route described here."}]
1c:["$","section","1-Check the level-specific rules first",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Check the level-specific rules first"}],[["$","p","The official criteria distinguish undergraduate and graduate applicants. The figures below are minimum screening conditions, not an indication that an applicant with that mark will be selected. Your qualification and the current call must also satisfy the published rules.",{"children":"The official criteria distinguish undergraduate and graduate applicants. The figures below are minimum screening conditions, not an indication that an applicant with that mark will be selected. Your qualification and the current call must also satisfy the published rules."}],["$","p","The official criteria exclude Turkish citizens and people who have lost Turkish citizenship, as well as applicants already enrolled at a Turkish university at the same level they intend to apply for. Graduating applicants should check the published completion timing, including the before-August condition.",{"children":"The official criteria exclude Turkish citizens and people who have lost Turkish citizenship, as well as applicants already enrolled at a Turkish university at the same level they intend to apply for. Graduating applicants should check the published completion timing, including the before-August condition."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Published academic and age thresholds","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Published academic and age thresholds"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route",{"scope":"col","children":"Route"}],["$","th","Minimum academic achievement",{"scope":"col","children":"Minimum academic achievement"}],["$","th","Age condition",{"scope":"col","children":"Age condition"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Associate / bachelor’s"}],["$","td","1",{"children":"70%; health-science conditions may differ"}],["$","td","2",{"children":"Under 21"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Master’s"}],["$","td","1",{"children":"75%"}],["$","td","2",{"children":"Under 30"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"PhD"}],["$","td","1",{"children":"75%"}],["$","td","2",{"children":"Under 35"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Medicine, dentistry and pharmacy"}],["$","td","1",{"children":"90% academic criterion"}],["$","td","2",{"children":"Check the eligible level and programme"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.turkiyeburslari.gov.tr/scholarshipsprograms",{"children":["",["$","a",null,{"href":"https://www.turkiyeburslari.gov.tr/scholarshipsprograms","target":"_blank","rel":"noreferrer","children":"Türkiye Scholarships criteria"}]]}]]]}],"$undefined"]}]
1d:["$","section","2-Programme language is a separate decision",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Programme language is a separate decision"}],[["$","p","Do not read “without IELTS” as “no language evidence is ever required”. English-taught and other non-Turkish programmes can require an accepted language certificate, and some programmes require an admission test. Check the actual university requirements shown for the course.",{"children":"Do not read “without IELTS” as “no language evidence is ever required”. English-taught and other non-Turkish programmes can require an accepted language certificate, and some programmes require an admission test. Check the actual university requirements shown for the course."}],["$","p","Create a short programme sheet with teaching language, subject prerequisites, accepted certificates and your missing evidence. Keep the name of each qualification exactly as it appears on your transcript. A programme that looks attractive but does not match your preparation is a weak preference.",{"children":"Create a short programme sheet with teaching language, subject prerequisites, accepted certificates and your missing evidence. Keep the name of each qualification exactly as it appears on your transcript. A programme that looks attractive but does not match your preparation is a weak preference."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","3-Understand placement, funding and your own budget",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Understand placement, funding and your own budget"}],[["$","p","The full-time programme includes university/department placement, tuition, accommodation, health insurance, a Turkish-language year and specified flight support. Use the current award terms for allowance amounts and conditions. Do not substitute a social-media stipend figure for your award letter.",{"children":"The full-time programme includes university/department placement, tuition, accommodation, health insurance, a Turkish-language year and specified flight support. Use the current award terms for allowance amounts and conditions. Do not substitute a social-media stipend figure for your award letter."}],["$","p","Separate covered benefits from costs you may incur before selection: obtaining documents, translations, tests, passport arrangements or travel to an interview. These are planning categories, not a claim that every applicant must pay each item. Do not spend on an agent who promises a scholarship place.",{"children":"Separate covered benefits from costs you may incur before selection: obtaining documents, translations, tests, passport arrangements or travel to an interview. These are planning categories, not a claim that every applicant must pay each item. Do not spend on an agent who promises a scholarship place."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","4-Build a document file that matches your chosen route",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Build a document file that matches your chosen route"}],[["$","p","Use one folder per application with an evidence index. Mark an item as ready only after checking legibility, correct name, full pages and the format requested by the portal. When your degree is not yet complete, establish whether the call accepts a provisional certificate and by which date.",{"children":"Use one folder per application with an evidence index. Mark an item as ready only after checking legibility, correct name, full pages and the format requested by the portal. When your degree is not yet complete, establish whether the call accepts a provisional certificate and by which date."}],["$","p","Documents such as international examination results, language certificates and a research proposal are conditional on level or programme. Do not upload an invented proposal or irrelevant test just to make a checklist longer.",{"children":"Documents such as international examination results, language certificates and a research proposal are conditional on level or programme. Do not upload an invented proposal or irrelevant test just to make a checklist longer."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L26",null,{"id":"scholarships/turkiye-burslari:section-5","title":"Check your progress","items":["Confirm identity details match your passport or accepted identity document.","Collect the academic transcript and qualification/completion evidence requested by the call.","Check whether each chosen programme needs a language or admission test.","Prepare an honest activities and achievements record with supporting evidence.","For a research route, check the proposal and research-sample instructions."]}],"$undefined","$undefined"]}]
20:["$","section","5-Use TBBS as a sequence of decisions",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Use TBBS as a sequence of decisions"}],[["$","p","Apply yourself through the official scholarship system. Draft long answers locally so that you can check spelling and preserve a copy; then follow the current field limits in the portal. A draft saved on your computer is not a submitted application.",{"children":"Apply yourself through the official scholarship system. Draft long answers locally so that you can check spelling and preserve a copy; then follow the current field limits in the portal. A draft saved on your computer is not a submitted application."}]],["$","ol",null,{"className":"process-steps","aria-label":"Use TBBS as a sequence of decisions","children":[["$","li","Create or access your own TBBS account on the official domain.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Create or access your own TBBS account on the official domain."}]]}],["$","li","Complete identity, education and other requested profile fields accurately.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Complete identity, education and other requested profile fields accurately."}]]}],["$","li","Compare the eligible programmes actually available to your profile.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Compare the eligible programmes actually available to your profile."}]]}],["$","li","Enter preferences and explain the academic reason behind them.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Enter preferences and explain the academic reason behind them."}]]}],["$","li","Upload the required evidence, review every section and submit when the call is open.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Upload the required evidence, review every section and submit when the call is open."}]]}],["$","li","Save the confirmation and monitor the official account for further instructions.",{"children":[["$","span",null,{"children":6}],["$","strong",null,{"children":"Save the confirmation and monitor the official account for further instructions."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","6-A letter of intent should explain a real academic choice",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"A letter of intent should explain a real academic choice"}],[["$","p","A useful answer connects previous preparation, the intended course and a credible next step. Avoid generic praise of Türkiye that would work for every subject. Explain one relevant project, what it taught you and which learning gap the chosen degree would address.",{"children":"A useful answer connects previous preparation, the intended course and a credible next step. Avoid generic praise of Türkiye that would work for every subject. Explain one relevant project, what it taught you and which learning gap the chosen degree would address."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"A programme-fit paragraph"}],[["$","p","0",{"children":"In my final-year water-quality project, I compared low-cost monitoring methods and learned that our sampling design limited the conclusions. I now want structured training in environmental data analysis. When choosing programmes, I am comparing their methods modules and research opportunities rather than selecting by city alone."}]],["$","p",null,{"className":"sample-card__note","children":"Fictional teaching example. Use only your own project, verified programme information and the actual application prompt."}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","7-Review before you submit, not after the deadline",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Review before you submit, not after the deadline"}],[["$","p","Read the complete application once as a reviewer who does not know you. Do the preferences agree with your subject background? Do dates, grades and activities match the evidence? Does each answer address the actual question?",{"children":"Read the complete application once as a reviewer who does not know you. Do the preferences agree with your subject background? Do dates, grades and activities match the evidence? Does each answer address the actual question?"}],["$","p","For an interview invitation, use the official selection instructions to prepare. Retain your submitted answers so that you can discuss your choices honestly. The next useful action is to resolve the weakest required item, not to add more unrelated achievements.",{"children":"For an interview invitation, use the official selection instructions to prepare. Retain your submitted answers so that you can discuss your choices honestly. The next useful action is to resolve the weakest required item, not to add more unrelated achievements."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Review before you submit, not after the deadline","children":[["$","$L4","/guides/motivation-letter/",{"href":"/guides/motivation-letter/","children":["Prepare a motivation letter",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/fully-funded/",{"href":"/scholarships/fully-funded/","children":["Compare fully funded scholarships",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
23:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://www.turkiyeburslari.gov.tr/scholarshipsprograms",{"href":"https://www.turkiyeburslari.gov.tr/scholarshipsprograms","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Türkiye Scholarships: criteria"}],["$","span",null,{"children":"Official guidance checked 24 October 2026; the live programme instructions take precedence."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://www.turkiyeburslari.gov.tr/fulltimeprograms",{"href":"https://www.turkiyeburslari.gov.tr/fulltimeprograms","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Full-time funding and calendar"}],["$","span",null,{"children":"Official guidance checked 24 October 2026; the live programme instructions take precedence."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$23:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://www.turkiyeburslari.gov.tr/applysteps",{"href":"https://www.turkiyeburslari.gov.tr/applysteps","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Official application steps"}],["$