18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Türkiye Scholarships has different academic, age and programme conditions by level. Its annual full-time calendar is not the same as confirmation that the next call is open."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Check your route on the official criteria page, then shortlist programmes in TBBS when the relevant call is available."]}],"$undefined"]}],false,false,["$","$L1a",null,{"records":[{"id":"turkiye-next","title":"Türkiye Scholarships: prepare for the next degree call","provider":"Türkiye Scholarships / YTB","type":"Scholarship","level":"Graduate","supportedDegrees":["Bachelor's","Master's","PhD"],"country":"Türkiye","region":"Europe","funding":"Fully funded","deadline":"Annual Jan–Feb calendar; next named call must be verified","status":"Check official site","summary":"Degree funding with placement and level-specific academic/age conditions. The published annual calendar does not confirm that the next intake is open.","tags":["Degree placement","TBBS","Level-specific requirements"],"source":"https://www.turkiyeburslari.gov.tr/fulltimeprograms","sourceLabel":"Türkiye Scholarships official full-time programme","checked":"24 October 2026"}]}],["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Current status: prepare before the next full-time call",{"href":"#section-1","children":"Current status: prepare before the next full-time call"}],["$","a","Check the level-specific rules first",{"href":"#section-2","children":"Check the level-specific rules first"}],["$","a","Programme language is a separate decision",{"href":"#section-3","children":"Programme language is a separate decision"}],["$","a","Understand placement, funding and your own budget",{"href":"#section-4","children":"Understand placement, funding and your own budget"}],["$","a","Build a document file that matches your chosen route",{"href":"#section-5","children":"Build a document file that matches your chosen route"}],["$","a","Use TBBS as a sequence of decisions",{"href":"#section-6","children":"Use TBBS as a sequence of decisions"}],["$","a","A letter of intent should explain a real academic choice",{"href":"#section-7","children":"A letter of intent should explain a real academic choice"}],["$","a","Review before you submit, not after the deadline",{"href":"#section-8","children":"Review before you submit, not after the deadline"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Current status: prepare before the next full-time call",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Current status: prepare before the next full-time call"}],[["$","p","The official full-time programme page describes the recurring application period as 10 January–20 February. That calendar is useful for preparation; it is not evidence that a new application round is already open in October 2026. Confirm the named intake in TBBS before relying on a deadline.",{"children":"The official full-time programme page describes the recurring application period as 10 January–20 February. That calendar is useful for preparation; it is not evidence that a new application round is already open in October 2026. Confirm the named intake in TBBS before relying on a deadline."}],"$L1b"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],false,"$L23","$L24"]}],"$L25"]}]
19:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","scholarships",{"href":"/scholarships/","children":[["$","span",null,{"children":"International funding"}],["$","h3",null,{"children":"Scholarships for international students in 2026–2027"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/motivation-letter",{"href":"/guides/motivation-letter/","children":[["$","span",null,{"children":"Writing guide"}],["$","h3",null,{"children":"How to write a scholarship motivation letter"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/scholarships-for-pakistani-students",{"href":"/guides/scholarships-for-pakistani-students/","children":[["$","span",null,{"children":"Pakistan applicant guide"}],["$","h3",null,{"children":"Fully funded scholarships for Pakistani students in 2027"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
