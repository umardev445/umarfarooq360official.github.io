18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Open Doors has four tracks with different academic and selection requirements. The current registration date is 1 November 2026; check the official account for cut-off details. Extra funding must not be assumed from the headline alone."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose the correct track and read the official schedule, funding FAQ and rules before submitting."]}],"$undefined"]}],false,false,["$","$L1a",null,{"records":[{"id":"open-doors-2026","title":"Open Doors: 2026 competition for study in Russia","provider":"Global Universities Association","type":"Scholarship","level":"Graduate","supportedDegrees":["Bachelor's","Master's","PhD"],"country":"Russia","region":"Europe","funding":"Funded","deadline":"Registration: 1 November 2026; confirm account cut-off","deadlineDate":"2026-11-01","status":"Open","summary":"Tuition-free study routes with university-dependent stipend; additional support has separate conditions. Choose the correct academic track and follow the official stages.","tags":["Bachelor’s","Master’s","PhD","Track-specific rules"],"source":"https://od.globaluni.ru/","sourceLabel":"Official Open Doors rules, schedule and FAQ","checked":"24 October 2026"}]}],["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","2026 competition: registration closes on 1 November",{"href":"#section-1","children":"2026 competition: registration closes on 1 November"}],["$","a","Choose the track that fits your next qualification",{"href":"#section-2","children":"Choose the track that fits your next qualification"}],["$","a","Separate the base scholarship from conditional extra support",{"href":"#section-3","children":"Separate the base scholarship from conditional extra support"}],["$","a","Build a relevant portfolio, not a certificate collection",{"href":"#section-4","children":"Build a relevant portfolio, not a certificate collection"}],["$","a","A practical motivation-letter plan",{"href":"#section-5","children":"A practical motivation-letter plan"}],["$","a","Prepare for the second stage before the result",{"href":"#section-6","children":"Prepare for the second stage before the result"}],["$","a","University preferences and winning are separate steps",{"href":"#section-7","children":"University preferences and winning are separate steps"}],["$","a","Plan for an offer, an unsuccessful result or a technical problem",{"href":"#section-8","children":"Plan for an offer, an unsuccessful result or a technical problem"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-2026 competition: registration closes on 1 November",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"2026 competition: registration closes on 1 November"}],[["$","p","The official schedule checked on 24 October lists 1 November 2026 as the registration deadline. It lists 13 November as the first-stage result date; that later date is not a new application deadline. Use the account instructions for the final submission cut-off and time zone.",{"children":"The official schedule checked on 24 October lists 1 November 2026 as the registration deadline. It lists 13 November as the first-stage result date; that later date is not a new application deadline. Use the account instructions for the final submission cut-off and time zone."}],"$L1b"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],false,"$L23","$L24"]}],"$L25"]}]
