1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide opportunity-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/scholarships/open-doors/\",\"name\":\"Open Doors Scholarship: tracks, portfolio and funding\",\"description\":\"Compare Open Doors tracks, portfolio steps, funding limits and the 2026 competition timeline for study in Russia. Follow official application and result routes.\",\"url\":\"https://aspirecompass.org/scholarships/open-doors/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-24\",\"dateModified\":\"2026-10-24\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/opportunities-20261024/russia-1280.webp\",\"caption\":\"Illustrative university reading room overlooking a winter garden\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Scholarships\",\"item\":\"https://aspirecompass.org/scholarships/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Open Doors Scholarship: tracks, portfolio and funding\",\"item\":\"https://aspirecompass.org/scholarships/open-doors/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"Open Doors Scholarship: tracks, portfolio and funding\",\"description\":\"Compare Open Doors tracks, portfolio steps, funding limits and the 2026 competition timeline for study in Russia. Follow official