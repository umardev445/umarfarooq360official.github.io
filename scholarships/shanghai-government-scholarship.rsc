1a:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","countries/china",{"href":"/countries/china/","children":[["$","span",null,{"children":"China study & funding · Independent guide"}],["$","h3",null,{"children":"China scholarships for international students: choose your route"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/csc-scholarship-application",{"href":"/guides/csc-scholarship-application/","children":[["$","span",null,{"children":"China study & funding · Independent guide"}],["$","h3",null,{"children":"How to apply for a CSC scholarship: a submission checklist"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/csc-scholarship-type-a-vs-type-b",{"href":"/guides/csc-scholarship-type-a-vs-type-b/","children":[["$","span",null,{"children":"China study & funding · Independent guide"}],["$","h3",null,{"children":"CSC Type A vs Type B: which application route fits you?"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
