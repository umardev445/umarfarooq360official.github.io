1b:["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Graduate programmes"}],["$","td","1",{"children":"1 October 2026–1 February 2027"}],["$","td","2",{"children":"Check the eligible subject catalogue"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Bachelor programmes"}],["$","td","1",{"children":"1 October 2026–30 May 2027"}],["$","td","2",{"children":"Confirm language and CSCA requirements"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"1+4 preparatory route"}],["$","td","1",{"children":"1 October 2026–30 April 2027"}],["$","td","2",{"children":"Read progression and award conditions"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Deadline precision"}],["$","td","1",{"children":"The notice does not state a cutoff time/timezone"}],["$","td","2",{"children":"Ask the host; submit ahead of the closing date"}]],"$undefined"]}]]}]
1c:["$","section","1-SGS Type A and B are not CSC programme types",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"SGS Type A and B are not CSC programme types"}],[["$","p","Shanghai’s funding classes use the labels Type A and Type B, but these refer to SGS coverage. They must not be confused with CSC Type A and Type B application routes. Always include the scholarship’s full name when recording an award.",{"children":"Shanghai’s funding classes use the labels Type A and Type B, but these refer to SGS coverage. They must not be confused with CSC Type A and Type B application routes. Always include the scholarship’s full name when recording an award."}],["$","p","In the reviewed SHOU notice, SGS Type A includes tuition, shared accommodation, medical insurance and a stipend. SGS Type B covers tuition and insurance. A partial award therefore leaves substantial living costs to plan. Check the host’s final offer for duration, payment timing and renewal conditions.",{"children":"In the reviewed SHOU notice, SGS Type A includes tuition, shared accommodation, medical insurance and a stipend. SGS Type B covers tuition and insurance. A partial award therefore leaves substantial living costs to plan. Check the host’s final offer for duration, payment timing and renewal conditions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","2-Choose a participating host that fits your subject",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Choose a participating host that fits your subject"}],[["$","p","Start with the university’s eligible international programme catalogue. A city scholarship does not mean every Shanghai institution, course or teaching language is available. Compare department requirements before investing time in a scholarship application.",{"children":"Start with the university’s eligible international programme catalogue. A city scholarship does not mean every Shanghai institution, course or teaching language is available. Compare department requirements before investing time in a scholarship application."}],["$","p","The verified Shanghai Ocean example includes specified graduate and undergraduate subjects. It is not evidence that unrelated degrees at that university receive the same award. A student looking for a different discipline should check another participating host’s current SGS notice rather than stretching the example to fit.",{"children":"The verified Shanghai Ocean example includes specified graduate and undergraduate subjects. It is not evidence that unrelated degrees at that university receive the same award. A student looking for a different discipline should check another participating host’s current SGS notice rather than stretching the example to fit."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","3-Host requirements can be stricter than a general overview",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Host requirements can be stricter than a general overview"}],[["$","p","City-level guidance provides context, while the university’s dated call supplies the actual host conditions. SHOU’s 2027 notice uses different age limits for different qualifications and requires strong academic performance. Check those details directly instead of assuming that broad city limits are sufficient.",{"children":"City-level guidance provides context, while the university’s dated call supplies the actual host conditions. SHOU’s 2027 notice uses different age limits for different qualifications and requires strong academic performance. Check those details directly instead of assuming that broad city limits are sufficient."}],["$","p","Bachelor’s applicants should review the host’s CSCA subject requirements. Graduate applicants should check whether supervisor contact or a research proposal is required in the degree prospectus. Language requirements belong to the programme, not to an informal promise that all SGS applicants can avoid tests.",{"children":"Bachelor’s applicants should review the host’s CSCA subject requirements. Graduate applicants should check whether supervisor contact or a research proposal is required in the degree prospectus. Language requirements belong to the programme, not to an informal promise that all SGS applicants can avoid tests."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","4-Map admission and scholarship steps together",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Map admission and scholarship steps together"}],[["$","p","Read the host’s scholarship notice and degree prospectus side by side. Record whether the scholarship is requested inside the admission form or through an additional step. SHOU directs applicants to its designated online system and specifies a non-refundable application fee; do not generalise fee-free application across Shanghai.",{"children":"Read the host’s scholarship notice and degree prospectus side by side. Record whether the scholarship is requested inside the admission form or through an additional step. SHOU directs applicants to its designated online system and specifies a non-refundable application fee; do not generalise fee-free application across Shanghai."}]],["$","ol",null,{"className":"process-steps","aria-label":"Map admission and scholarship steps together","children":[["$","li","Confirm host, degree and eligible programme",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Confirm host, degree and eligible programme"}]]}],["$","li","Check the exact SGS funding class",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Check the exact SGS funding class"}]]}],["$","li","Gather academic and language evidence",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Gather academic and language evidence"}]]}],["$","li","Complete the host’s application and required fee step",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Complete the host’s application and required fee step"}]]}],["$","li","Track academic review and separate scholarship notification",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Track academic review and separate scholarship notification"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","5-Compare the financial gap before accepting",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Compare the financial gap before accepting"}],[["$","p","A tuition-and-insurance award can still be useful, but it is not a full living-cost solution. Estimate accommodation, food, transport, phone, travel and initial deposits. Consider how you would cover the interval before any stipend begins. Request clarification if the offer uses an award label without describing its benefits.",{"children":"A tuition-and-insurance award can still be useful, but it is not a full living-cost solution. Estimate accommodation, food, transport, phone, travel and initial deposits. Consider how you would cover the interval before any stipend begins. Request clarification if the offer uses an award label without describing its benefits."}],["$","p","Do not assume that a preparatory-year scholarship guarantees the same award for the following bachelor’s degree. Read the academic progression and reassessment conditions. Keep the official final award letter, rather than relying on a screenshot of the application option you selected.",{"children":"Do not assume that a preparatory-year scholarship guarantees the same award for the following bachelor’s degree. Read the academic progression and reassessment conditions. Keep the official final award letter, rather than relying on a screenshot of the application option you selected."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","6-Avoid overlapping-award and deadline mistakes",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Avoid overlapping-award and deadline mistakes"}],[["$","p","Check restrictions on holding other government or organisational funding at the same time. Applications and concurrent award acceptance are different matters; read the applicable rules before committing to more than one award.",{"children":"Check restrictions on holding other government or organisational funding at the same time. Applications and concurrent award acceptance are different matters; read the applicable rules before committing to more than one award."}],["$","p","Maintain a separate deadline for each host. A closing date at Shanghai Ocean does not establish the deadline at another university. If a host has only published an old call, mark it as a preparation option until a current notice appears.",{"children":"Maintain a separate deadline for each host. A closing date at Shanghai Ocean does not establish the deadline at another university. If a host has only published an old call, mark it as a preparation option until a current notice appears."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L25",null,{"id":"scholarships/shanghai-government-scholarship:section-7","title":"Check your progress","items":["Current host notice saved","Eligible course and teaching language verified","SGS class and uncovered costs recorded","Host portal and fee instructions followed","Other-award restrictions checked","Final scholarship decision distinguished from admission"]}],"$undefined","$undefined"]}]
22:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://ieo.shou.edu.cn/2026/0922/c18719a355611/page.htm",{"href":"https://ieo.shou.edu.cn/2026/0922/c18719a355611/page.htm","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Shanghai Ocean University 2027 SGS call"}],["$","span",null,{"children":"Official source reviewed 19 October 2026. Intake and programme-specific rules apply."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://english.shanghai.gov.cn/en-Individuals-HigherEducation-Scholarships/20260813/f1060aadeac645bfa23ac14a0ae29af2.html",{"href":"https://english.shanghai.gov.cn/en-Individuals-HigherEducation-Scholarships/20260813/f1060aadeac645bfa23ac14a0ae29af2.html","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Shanghai government scholarship overview"}],["$","span",null,{"children":"Official source reviewed 19 October 2026. Intake and programme-specific rules apply."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$22:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
