29:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is UBC International Scholars automatically fully funded?",{"children":[["$","summary",null,{"children":["Is UBC International Scholars automatically fully funded?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No fixed package applies to every applicant. UBC assesses financial need and the applicable award conditions. Use the official assessment and eventual award letter when planning what remains to pay."}]]}],["$","details","Can the same person nominate me and provide the teacher reference?",{"children":[["$","summary",null,{"children":["Can the same person nominate me and provide the teacher reference?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. UBC requires different people for these roles. Confirm the school nomination before inviting them through the application system."}]]}],["$","details","Can I finish the scholarship form before applying for admission?",{"children":[["$","summary",null,{"children":["Can I finish the scholarship form before applying for admission?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"UBC's current sequence requires admission submission first. You also cannot finish the award application until the nominator and teacher referee have submitted their forms."}]]}],["$","details","What time is the deadline in Pakistan?",{"children":[["$","summary",null,{"children":["What time is the deadline in Pakistan?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The extended 2 December 2026 noon Pacific deadline converts to 3 December at 01:00 Pakistan Standard Time. UBC labels the deadline as extended; verify its current portal before submitting. Submit early and use the official portal's clock."}]]}]]}]]}]
