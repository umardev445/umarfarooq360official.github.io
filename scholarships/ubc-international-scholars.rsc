1c:T53c,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is UBC International Scholars automatically fully funded?","acceptedAnswer":{"@type":"Answer","text":"No fixed package applies to every applicant. UBC assesses financial need and the applicable award conditions. Use the official assessment and eventual award letter when planning what remains to pay."}},{"@type":"Question","name":"Can the same person nominate me and provide the teacher reference?","acceptedAnswer":{"@type":"Answer","text":"No. UBC requires different people for these roles. Confirm the school nomination before inviting them through the application system."}},{"@type":"Question","name":"Can I finish the scholarship form before applying for admission?","acceptedAnswer":{"@type":"Answer","text":"UBC's current sequence requires admission submission first. You also cannot finish the award application until the nominator and teacher referee have submitted their forms."}},{"@type":"Question","name":"What time is the deadline in Pakistan?","acceptedAnswer":{"@type":"Answer","text":"The extended 2 December 2026 noon Pacific deadline converts to 3 December at 01:00 Pakistan Standard Time. UBC labels the deadline as extended; verify its current portal before submitting. Submit early and use the official portal's clock."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page scholarship-release editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/scholarships/ubc-international-scholars/\",\"name\":\"UBC International Scholars Program 2027: application guide\",\"description\":\"Check UBC International Scholars 2027 eligibility, need-based funding, nomination and referee steps before the extended 2 December 2026 application deadline.\",\"url\":\"https://aspirecompass.org/scholarships/ubc-in