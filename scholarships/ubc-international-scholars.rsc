27:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Eligibility: school background, need and course choice",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Eligibility: school background, need and course choice"}],[["$","p","UBC requires international study-permit status, direct entry from an accredited secondary school and strong academic results. For this intake, high-school graduation must be June 2026 or later. The official page lists excluded degree combinations and requires the relevant English-language admission standard.",{"children":"UBC requires international study-permit status, direct entry from an accredited secondary school and strong academic results. For this intake, high-school graduation must be June 2026 or later. The official page lists excluded degree combinations and requires the relevant English-language admission standard."}],["$","p","Read your intended degree name carefully against those exclusions. A general statement that international students can apply does not establish eligibility for a nursing, joint or other excluded programme. If your educational pathway is unusual, obtain an answer from UBC before preparing financial records.",{"children":"Read your intended degree name carefully against those exclusions. A general statement that international students can apply does not establish eligibility for a nursing, joint or other excluded programme. If your educational pathway is unusual, obtain an answer from UBC before preparing financial records."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://you.ubc.ca/financial-planning/scholarships-awards-international-students/international-scholars/",{"children":["",["$","a",null,{"href":"https://you.ubc.ca/financial-planning/scholarships-awards-international-students/international-scholars/","target":"_blank","rel":"noreferrer","children":"UBC eligibility and excluded programmes"}]]}]]]}],"$undefined"]}],["$","section","2-Nomination and admission: complete the steps in order",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Nomination and admission: complete the steps in order"}],[["$","p","Your application depends on other people's submissions. Ask about the school's campus-specific nomination allocation before treating a willingness to write a letter as an actual nomination. Send each person the correct invitation and agree a follow-up date.",{"children":"Your application depends on other people's submissions. Ask about the school's campus-specific nomination allocation before treating a willingness to write a letter as an actual nomination. Send each person the correct invitation and agree a follow-up date."}]],["$","ol",null,{"className":"process-steps","aria-label":"Nomination and admission: complete the steps in order","children":[["$","li","Choose the campus and first-choice programme, and confirm the school's nomination process.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Choose the campus and first-choice programme, and confirm the school's nomination process."}]]}],["$","li","Complete the UBC admission application and retain its confirmation.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Complete the UBC admission application and retain its confirmation."}]]}],["$","li","Create the award application and invite the nominator and separate teacher referee.",{"children":[["$","span",null,{"children":3}],"$L2b"]}],"$L2c","$L2d"]}],"$undefined","$undefined","$L2e","$undefined","$undefined","$undefined","$undefined"]}],"$L2f","$L30","$L31","$L32","$L33"]}]
