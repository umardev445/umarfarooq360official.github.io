29:["$","section","5-Funding and costs to verify",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Funding and costs to verify"}],[["$","p","The official programme describes scholarship payments and applicable support such as insurance, travel or study-related assistance under its terms. Duration depends on the selected course. Verify pre-arrival costs, housing deposits, visa evidence and any amount not covered before accepting.",{"children":"The official programme describes scholarship payments and applicable support such as insurance, travel or study-related assistance under its terms. Duration depends on the selected course. Verify pre-arrival costs, housing deposits, visa evidence and any amount not covered before accepting."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2a:["$","section","6-Connect professional experience to development impact",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Connect professional experience to development impact"}],[["$","p","Describe the problem you worked on, the responsibility you personally held, the result and the capability still missing. Then explain how the selected German course addresses that gap and how you can apply the learning in a realistic institutional or sector role.",{"children":"Describe the problem you worked on, the responsibility you personally held, the result and the capability still missing. Then explain how the selected German course addresses that gap and how you can apply the learning in a realistic institutional or sector role."}],["$","p","An employment certificate proves dates and duties, while the motivation letter explains judgement and impact. Make sure the two documents agree without duplicating each other line by line.",{"children":"An employment certificate proves dates and duties, while the motivation letter explains judgement and impact. Make sure the two documents agree without duplicating each other line by line."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2b:["$","section","7-DAAD EPOS application checklist",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"DAAD EPOS application checklist"}],[["$","p","Build the final checklist from the current course and DAAD instructions. Requirements may include a DAAD form, CV, motivation, academic records, employment evidence, language proof and references.",{"children":"Build the final checklist from the current course and DAAD instructions. Requirements may include a DAAD form, CV, motivation, academic records, employment evidence, language proof and references."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Eligible country confirmed",{"children":"Eligible country confirmed"}],["$","li","Relevant degree and course prerequisites met",{"children":"Relevant degree and course prerequisites met"}],["$","li","Required professional experience documented",{"children":"Required professional experience documented"}],["$","li","Correct 2027–2028 course deadline recorded",{"children":"Correct 2027–2028 course deadline recorded"}],["$","li","Application sent to the stated recipient",{"children":"Application sent to the stated recipient"}],["$","li","Documents use the requested format",{"children":"Documents use the requested format"}],["$","li","Development plan is specific and credible",{"children":"Development plan is specific and credible"}]]}],"$undefined","$undefined","$undefined"]}]
