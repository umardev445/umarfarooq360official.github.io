26:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is there one DAAD EPOS deadline for 2027–2028?",{"children":[["$","summary",null,{"children":["Is there one DAAD EPOS deadline for 2027–2028?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Deadlines vary by eligible postgraduate course. Use the current DAAD course list and the selected programme's own instructions."}]]}],["$","details","How much work experience does DAAD EPOS require?",{"children":[["$","summary",null,{"children":["How much work experience does DAAD EPOS require?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The official programme generally requires at least two years of relevant professional experience. The selected course may define additional expectations."}]]}],["$","details","Do I apply directly to DAAD?",{"children":[["$","summary",null,{"children":["Do I apply directly to DAAD?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Applications are generally sent to the selected eligible postgraduate course according to its stated procedure. Confirm the current route before submission."}]]}],["$","details","Can Pakistani applicants apply for DAAD EPOS?",{"children":[["$","summary",null,{"children":["Can Pakistani applicants apply for DAAD EPOS?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"They may apply when Pakistan and the applicant fall within the current eligible framework and all course, degree and experience requirements are met."}]]}],["$","details","Is DAAD EPOS fully funded?",{"children":[["$","summary",null,{"children":["Is DAAD EPOS fully funded?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"EPOS provides a defined scholarship package under current terms, but candidates should verify the exact payments, duration, additional support and uncovered costs for their course."}]]}]]}