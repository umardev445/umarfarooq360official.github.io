18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"KFUPM thesis MS, project MS, direct PhD and PhD routes have different requirements. Scholarship selection is separate from minimum admission eligibility; confirm funding and dates for the actual route."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose a graduate route and read its official requirements and current application call before preparing documents."]}],"$undefined"]}],false,false,["$","$L1a",null,{"records":[{"id":"kfupm-graduate","title":"KFUPM graduate scholarship routes","provider":"King Fahd University of Petroleum and Minerals","type":"Scholarship","level":"Graduate","supportedDegrees":["Master's","PhD"],"country":"Saudi Arabia","region":"Middle East","funding":"Varies","deadline":"Programme and intake-specific; verify current graduate call","status":"Check official site","summary":"Compare thesis MS, project MS and doctoral requirements. Minimum admission eligibility, scholarship selection and self-sponsored fees are separate decisions.","tags":["Thesis / project","Graduate research","Funding conditions"],"source":"https://cgis.kfupm.edu.sa/admission/kfupm-scholarship","sourceLabel":"KFUPM official scholarship terms","checked":"24 October 2026"}]}],["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav"