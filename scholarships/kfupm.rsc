1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide opportunity-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/scholarships/kfupm/\",\"name\":\"KFUPM scholarships: choose the right graduate route\",\"description\":\"Compare KFUPM thesis, project master’s and PhD routes. Check scholarship versus self-funded requirements, application documents and official funding conditions.\",\"url\":\"https://aspirecompass.org/scholarships/kfupm/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-24\",\"dateModified\":\"2026-10-24\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/opportunities-20261024/kfupm-1280.webp\",\"caption\":\"Illustrative Saudi engineering campus with shaded paths and graduate students\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Scholarships\",\"item\":\"https://aspirecompass.org/scholarships/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"KFUPM scholarships: choose the right graduate route\",\"item\":\"https://aspirecompass.org/scholarships/kfupm/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"KFUPM scholarships: choose the right graduate route\",\"description\":\"Compare KFUPM thesis, project master’s and PhD routes. Check scholarship versus self-funded requirements, application documents and official funding conditions.\",\"image\":\"https://aspirecompass.org/images/opportunities-20261024/kfupm-1280.webp\",\"datePublished\":\"2026-10-24\",\"dateModified\":\"2026-10-24\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/scholarships/kfupm/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Does a 2.5 GPA guarantee a scholarship?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The current requirements distinguish routes and scholarship versus non-scholarship applications. Meeting a minimum is not an admission or funding guarantee.\"}},{\"@type\":\"Question\",\"name\":\"Is direct PhD funding automatically five years?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The scholarship page describes a five-year direct PhD programme but support for the first four years. Confirm the conditions in your actual offer.\"}},{\"@type\":\"Question\",\"name\":\"Is there one KFUPM deadline?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Do not assume that. Programmes and intakes have separate calls; use the route-specific official application page for the current deadline.\"}}]}"}}]],["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--guide inner-hero--visual","children":"$L17"}],false,"$L18","$L19"]}]
