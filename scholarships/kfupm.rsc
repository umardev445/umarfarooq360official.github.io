24:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Does a 2.5 GPA guarantee a scholarship?",{"children":[["$","summary",null,{"children":["Does a 2.5 GPA guarantee a scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The current requirements distinguish routes and scholarship versus non-scholarship applications. Meeting a minimum is not an admission or funding guarantee."}]]}],["$","details","Is direct PhD funding automatically five years?",{"children":[["$","summary",null,{"children":["Is direct PhD funding automatically five years?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The scholarship page describes a five-year direct PhD programme but support for the first four years. Confirm the conditions in your actual offer."}]]}],["$","details","Is there one KFUPM deadline?",{"children":[["$","summary",null,{"children":["Is there one KFUPM deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Do not assume that. Programmes and intakes have separate calls; use the route-specific official application page for the current deadline."}]]}]]}]]}]
