29:["$","section","5-Compare funding using the same fields",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Compare funding using the same fields"}],[["$","p","Write down tuition coverage, mandatory charges, cash stipend, accommodation, meals, travel, insurance, duration, payment schedule and renewal conditions. A fee waiver and a living-cost scholarship solve different parts of the budget.",{"children":"Write down tuition coverage, mandatory charges, cash stipend, accommodation, meals, travel, insurance, duration, payment schedule and renewal conditions. A fee waiver and a living-cost scholarship solve different parts of the budget."}],["$","p","Calculate how much cash you need before arrival and before the first payment. Housing deposits, visa-related costs and initial travel can be due earlier than scholarship disbursement.",{"children":"Calculate how much cash you need before arrival and before the first payment. Housing deposits, visa-related costs and initial travel can be due earlier than scholarship disbursement."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Academic year and current status",{"children":"Academic year and current status"}],["$","li","Eligible nationality and degree level",{"children":"Eligible nationality and degree level"}],["$","li","Separate admission required",{"children":"Separate admission required"}],["$","li","Income or merit assessment",{"children":"Income or merit assessment"}],["$","li","Covered and excluded costs",{"children":"Covered and excluded costs"}],["$","li","Renewal and credit requirements",{"children":"Renewal and credit requirements"}]]}],"$undefined","$undefined","$undefined"]}]
2a:["$","section","6-Build a safe application sequence",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Build a safe application sequence"}],[["$","p","Open the official call, confirm eligibility and save the dated document. Apply through the named government, regional or university portal. Record every dependent action, including admission, financial documentation, language evidence and pre-enrolment.",{"children":"Open the official call, confirm eligibility and save the dated document. Apply through the named government, regional or university portal. Record every dependent action, including admission, financial documentation, language evidence and pre-enrolment."}],["$","p","Avoid anyone promising a guaranteed DSU, MAECI or university award. Never send passwords or pay a private account to secure selection. Use the contacts published on the official domain when a rule is unclear.",{"children":"Avoid anyone promising a guaranteed DSU, MAECI or university award. Never send passwords or pay a private account to secure selection. Use the contacts published on the official domain when a rule is unclear."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
