21:["$","section",null,{"className":"content-block","aria-labelledby":"relevant-listings","children":[["$","div",null,{"className":"content-block__heading","children":[["$","h2",null,{"id":"relevant-listings","children":"Relevant opportunities"}],["$","p",null,{"children":"4 official-source records match this topic. Check category and applicant conditions before applying."}]]}],["$","$L25",null,{"items":["$1d:props:children:0:props:children:5:props:records:0",{"id":"italy-ergo-dsu-2026-27","title":"ER.GO Regional Scholarship 2026–2027","provider":"ER.GO Emilia-Romagna","type":"Scholarship","level":"Any degree","country":"Italy","region":"Europe","funding":"Funded","deadline":"24 August 2026, 16:00 — main scholarship deadline closed","deadlineDate":"2026-08-24","status":"Closed","summary":"Regional right-to-study support assessed under ER.GO's economic, enrolment and merit rules, with separate guidance for families holding income or assets abroad.","tags":["DSU","Emilia-Romagna","Income assessed"],"source":"https://www.er-go.it/cosa-fare-per/bandi-di-concorso/leggi-il-bando","sourceLabel":"ER.GO official 2026–2027 call","checked":"13 October 2026"},{"id":"padua-international-excellence-2026-27","title":"Padua International Excellence Scholarship","provider":"University of Padua","type":"Scholarship","level":"Any degree","country":"Italy","region":"Europe","funding":"Funded","deadline":"2027–2028 award terms: verify on the official scholarship page","status":"Check official site","summary":"The 2026–2027 scheme offered €8,000 gross per year plus a tuition-fee exemption for selected international students in eligible English-taught degrees.","tags":["Padua","Merit","English-taught degree"],"source":"https://www.unipd.it/en/padua-international-excellence-scholarship-programme","sourceLabel":"University of Padua","checked":"13 October 2026","featured":true},{"id":"polimi-merit-scholarships-2027-28","title":"Politecnico di Milano International Merit Scholarships","provider":"Politecnico di Milano","type":"Scholarship","level":"Master's","country":"Italy","region":"Europe","funding":"Funded","deadline":"15 December 2026, noon Italian time; early admission payment required by 1 December","deadlineDate":"2026-12-15","deadlineAt":"2026-12-15T12:00:00+01:00","milestones":[{"label":"Required early admission payment","date":"2026-12-01","detail":"Confirm your eligible early-bird route and closing time."},{"label":"Merit scholarship form","date":"2026-12-15","at":"2026-12-15T12:00:00+01:00","detail":"Noon Italian time; prior admission conditions apply."}],"status":"Open","summary":"The 2027–2028 merit call has a separate form closing 15 December at noon Italian time, after qualifying early admission payment by 1 December. The PDF lists an acceptance administrative fee around €190; check award-specific benefits and English evidence.","tags":["Polimi","Master of Science","Tuition waiver"],"source":"https://www.polimi.it/en/prospective-students/how-much-does-it-cost/scholarships","sourceLabel":"Politecnico di Milano","checked":"23 October 2026","featured":true}],"showTypeFilter":false}]]}]
22:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-What changed in the latest funding review",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"What changed in the latest funding review"}],[["$","p","As checked on 5 October 2026, Polimi has a 2027–2028 merit call. Its official PDF is linked below. Padua's Excellence page says further call information will be available in November 2026. Open admission does not mean the full future award conditions are already confirmed.",{"children":"As checked on 5 October 2026, Polimi has a 2027–2028 merit call. Its official PDF is linked below. Padua's Excellence page says further call information will be available in November 2026. Open admission does not mean the full future award conditions are already confirmed."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","2-MAECI Italian Government grants",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"MAECI Italian Government grants"}],[["$","p","MAECI publishes an annual call for foreign citizens and Italians living abroad, an eligible-country list and instructions for the Study in Italy portal. The 2026–2027 call closed at 14:00 Italian time on 26 March 2026 and covered study carried out in Italy.",{"children":"MAECI publishes an annual call for foreign citizens and Italians living abroad, an eligible-country list and instructions for the Study in Italy portal. The 2026–2027 call closed at 14:00 Italian time on 26 March 2026 and covered study carried out in Italy."}],["$","p","Before a future application, verify that your country, course type, age, academic background and language evidence meet the new call. Also confirm the grant duration, health-insurance terms, tuition treatment and any costs that remain yours.",{"children":"Before a future application, verify that your country, course type, age, academic background and language evidence meet the new call. Also confirm the grant duration, health-insurance terms, tuition treatment and any costs that remain yours."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Regional DSU scholarships",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Regional DSU scholarships"}],[["$","p","DSU is a right-to-study system administered through regional or institution-linked bodies. Names, portals, deadlines, benefit amounts and document rules vary. ER.GO serves institutions in Emilia-Romagna; other regions use different bodies and calls.",{"children":"DSU is a right-to-study system administered through regional or institution-linked bodies. Names, portals, deadlines, benefit amounts and document rules vary. ER.GO serves institutions in Emilia-Romagna; other regions use different bodies and calls."}],["$","p","Applicants whose family income or assets are outside Italy commonly need official financial and family documents, translations and legalisation or authentication that meet the relevant call. Start these documents early because admission documents alone are not enough for an economic assessment.",{"children":"Applicants whose family income or assets are outside Italy commonly need official financial and family documents, translations and legalisation or authentication that meet the relevant call. Start these documents early because admission documents alone are not enough for an economic assessment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","4-University merit scholarships and fee waivers",{"className":"article-section","id":"section-5","children":["$L26",["$L27"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$L28"]}],"$L29","$L2a","$L2b","$L2c"]}]
