2f:["$","section","10-Check the 2027 scholarship application route",{"className":"article-section","id":"section-11","children":[["$","h2",null,{"children":"Check the 2027 scholarship application route"}],[["$","p","These programme guides separate the entry qualification, funding conditions and submission dependencies. Recheck the official instructions for the intended intake before applying; a school nomination, referee form or university application can be a separate task.",{"children":"These programme guides separate the entry qualification, funding conditions and submission dependencies. Recheck the official instructions for the intended intake before applying; a school nomination, referee form or university application can be a separate task."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Check the 2027 scholarship application route","children":[["$","$L5","/scholarships/ubc-international-scholars/",{"href":"/scholarships/ubc-international-scholars/","children":["UBC International Scholars Program 2027: application guide",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
