country":"Canada","region":"North America","funding":"Fully funded","deadline":"All published milestones passed: 9 October, 16 October and 6 November 2026","deadlineDate":"2026-10-09","milestones":[{"label":"School nomination","date":"2026-10-09","detail":"School acts first; later deadlines do not replace nomination."},{"label":"Undergraduate admission","date":"2026-10-16","detail":"Student follows the University of Toronto route."},{"label":"Scholarship form and documents","date":"2026-11-06","detail":"Nominated student uses the official invitation."}],"status":"Closed","summary":"Nomination, university admission and scholarship/document deadlines for September 2027 entry have passed. Existing applicants should retain their submitted record and follow university communications.","tags":["University of Toronto","School nomination","Undergraduate"],"source":"https://future.utoronto.ca/pearson-scholarships","sourceLabel":"University of Toronto official scholarship page","checked":"16 November 2026","featured":false,"entryDeadlineDate":"2026-10-09","entryClosedNote":"All published nomination, admission and scholarship/document milestones have passed; follow existing-applicant communications."},{"id":"australia-awards-scholarships","title":"Australia Awards Scholarships","provider":"Australian Government Department of Foreign Affairs and Trade","type":"Scholarship","level":"Any degree","country":"Australia","region":"Oceania","funding":"Fully funded","deadline":"Country-specific; check the participating-country profile","status":"Check official site","summary":"Long-term undergraduate and postgraduate awards for eligible developing-country applicants, with benefits generally including tuition, travel, living support and health cover.","tags":["Developing countries","Government scholarship","Return-home condition"],"source":"https://www.dfat.gov.au/people-to-people/australia-awards/australia-awards-scholarships","sourceLabel":"Australian Government DFAT","checked":"13 October 2026","featured":true},{"id":"cern-summer","title":"CERN Summer Student Programme 2027","provider":"CERN","type":"Internship","level":"Student","country":"Switzerland","region":"Europe","funding":"Paid","deadline":"21 January 2027, 23:59 Geneva (CET)","status":"Open","summary":"Standard SUMM-2027 vacancy in Geneva, separate from openlab. Check full-time enrolment, completed study and previous-CERN conditions in the exact vacancy before applying.","tags":["Summer research","Physics","Engineering","Computing"],"source":"https://careers.cern/jobs/cern-summer-student-programme-2026-member-and-non-member-state/","sourceLabel":"CERN official SUMM-2027 vacancy (URL retains older year)","checked":"15 November 2026","supportedDegrees":["Bachelor's","Master's"],"deadlineDate":"2027-01-21","deadlineAt":"2027-01-21T23:59:00+01:00"},{"id":"italy-ergo-dsu-2026-27","title":"ER.GO Regional Scholarship 2026–2027","provider":"ER.GO Emilia-Romagna","type":"Scholarship","level":"Any degree","country":"Italy","region":"Europe","funding":"Funded","deadline":"24 August 2026, 16:00 — main scholarship deadline closed","deadlineDate":"2026-08-24","status":"Closed","summary":"Regional right-to-study support assessed under ER.GO's economic, enrolment and merit rules, with separate guidance for families holding income or assets abroad.","tags":["DSU","Emilia-Romagna","Income assessed"],"source":"https://www.er-go.it/cosa-fare-per/bandi-di-concorso/leggi-il-bando","sourceLabel":"ER.GO official 2026–2027 call","checked":"13 October 2026"},{"id":"padua-international-excellence-2026-27","title":"Padua International Excellence Scholarship","provider":"University of Padua","type":"Scholarship","level":"Any degree","country":"Italy","region":"Europe","funding":"Funded","deadline":"2027–2028 award terms: verify on the official scholarship page","status":"Check official site","summary":"The 2026–2027 scheme offered €8,000 gross per year plus a tuition-fee exemption for selected international students in eligible English-taught degrees.","tags":["Padua","Merit","English-taught degree"],"source":"https://www.unipd.it/en/padua-international-excellence-scholarship-programme","sourceLabel":"University of Padua","checked":"13 October 2026","featured":true},{"id":"open-doors-2026","title":"Open Doors: 2026 competition for study in Russia","provider":"Global Universities Association","type":"Scholarship","level":"Graduate","supportedDegrees":["Bachelor's","Master's","PhD"],"country":"Russia","region":"Europe","funding":"Funded","deadline":"New registration closed 1 November; published second-stage booking date 16 November has passed at retrieval","deadlineDate":"2026-11-01","status":"Closed","summary":"New entry is closed. Existing participants should check their account: the published 16 November booking date has passed at the 17 November UTC retrieval. No exact cutoff time or extension inferred. Track-specific second-stage tasks continue separately.","tags":["Bachelor’s","Master’s","PhD","Track-specific rules"],"source":"https://od.globaluni.ru/","sourceLabel":"Official Open Doors rules, schedule and FAQ","checked":"16 November 2026","featured":false},{"id":"turkiye-next","title":"Türkiye Scholarships: prepare for the next degree call","provider":"Türkiye Scholarships / YTB","type":"Scholarship","level":"Graduate","supportedDegrees":["Bachelor's","Master's","PhD"],"country":"Türkiye","region":"Europe","funding":"Fully funded","deadline":"Annual Jan–Feb calendar; next named call must be verified","status":"Check official site","summary":"Degree funding with placement and level-specific academic/age conditions. The published annual calendar does not confirm that the next intake is open.","tags":["Degree placement","TBBS","Level-specific requirements"],"source":"https://www.turkiyeburslari.gov.tr/fulltimeprograms","sourceLabel":"Türkiye Scholarships official full-time programme","checked":"29 October 2026"},{"id":"isdb-ytb-2026","title":"IsDB–YTB joint scholarship 2026 — closed","provider":"Türkiye Scholarships / YTB and IsDB","type":"Scholarship","level":"Graduate","supportedDegrees":["Bachelor's","Master's","PhD"],"country":"Türkiye","region":"Europe","funding":"Funded","status":"Closed","deadline":"2026 call closed 20 February 2026; next joint call not confirmed","deadlineDate":"2026-02-20","summary":"Closed 2026 joint call with country-by-degree and field restrictions. The owner specifies repayment obligations for associate and bachelor recipients; read the terms before treating support as a non-repayable grant. The next joint call is not confirmed.","tags":["Closed 2026 call","Country-by-degree eligibility","TBBS joint route","Associate/bachelor repayment terms"],"source":"https://turkiyeburslari.gov.tr/announcements/ytb-islamic-development-bank-isdb-joint-scholarship-program-2026-applicaiton-period-122","sourceLabel":"YTB official joint programme announcement","checked":"23 November 2026"},{"id":"epfl-srp-2027","title":"EPFL Life Sciences Summer Research Program 2027","provider":"EPFL School of Life Sciences","type":"Internship","level":"Student","supportedDegrees":["Bachelor's","Master's"],"country":"Switzerland","region":"Europe","funding":"Funded","status":"Closed","deadline":"15 November 2026, 23:59 CET","deadlineDate":"2026-11-15","deadlineAt":"2026-11-15T23:59:00+01:00","summary":"Published 15 November 2026 cutoff passed at the dated review (16 November 05:00 UTC / 15 November Los Angeles). No extension verified. Follow the owner’s instructions for submitted applicants or a newly announced call.","tags":["Life sciences","Bachelor's and first-year master's","Research","2027"],"source":"https://www.epfl.ch/schools/sv/education/summer-research-program/","sourceLabel":"EPFL official SRP","checked":"15 November 2026","featured":true},{"id":"hec-nbs","title":"HEC Need-Based Scholarship — institutional route","provider":"HEC / participating university Financial Aid Office","type":"Scholarship","level":"Bachelor's","country":"Pakistan","region":"Asia","funding":"Funded","status":"Check official site","deadline":"University-specific call; confirm with your Financial Aid Office","summary":"Undergraduate need-based support at selected public-sector institutions. The university assesses need and controls its application window. Check your campus, programme and admission category; a national overview does not confirm a local opening.","tags":["Pakistan domestic funding","Undergraduate","Financial Aid Office","Need-based"],"source":"https://www.hec.gov.pk/english/scholarshipsgrants/NBS/Pages/Eligibility-Criteria.aspx","sourceLabel":"HEC NBS eligibility","checked":"1 November 2026"},{"id":"undp-graduate-programme","title":"UNDP Graduate Programme — next call unconfirmed","provider":"UNDP","type":"Graduate Program","level":"Graduate","supportedDegrees":["Bachelor's","Master's"],"country":"Multiple countries","region":"Global","funding":"Varies","status":"Check official site","deadline":"Dedicated page: next campaign under consideration","summary":"For eligible programme-country graduates, with degree-specific experience conditions. The dedicated page has not confirmed a new call; monitor official vacancies.","tags":["Early career","International development","Degree-specific experience"],"source":"https://www.undp.org/careers/undp-graduate-programme","sourceLabel":"UNDP Graduate Programme","checked":"2 November 2026"},{"id":"ubc-international-scholars-2027","title":"UBC International Scholars Program 2027","provider":"University of British Columbia","type":"Scholarship","level":"Bachelor's","country":"Canada","region":"North America","funding":"Varies","deadline":"Extended to 2 December 2026, noon Pacific Time; admission and award application required","deadlineDate":"2026-12-02","deadlineAt":"2026-12-02T12:00:00-08:00","status":"Open","summary":"The owner reports admission-portal technical issues and allows starting the award application first, then admission when available. Both are due by 2 December 2026 at noon Pacific. Coordinate the school nominator and separate teacher referee; award amounts are assessed individually.","tags":["Undergraduate","Financial need","School nomination","UBC"],"source":"https://you.ubc.ca/financial-planning/scholarships-awards-international-students/international-scholars/","sourceLabel":"UBC International Scholars official instructions","checked":"19 November 2026"},{"id":"hec-cgsp-pakistan","title":"HEC Chinese Government Scholarship 2027–28","provider":"HEC Pakistan / Chinese Government Scholarship","type":"Scholarship","level":"Graduate","supportedDegrees":["Bachelor's","Master's","PhD"],"country":"China","region":"Asia","funding":"Funded","status":"Open","deadline":"HEC portal: 5 January 2027, 16:00 Pakistan Standard Time; separate test tasks apply","deadlineDate":"2027-01-05","deadlineAt":"2027-01-05T16:00:00+05:00","summary":"Pakistan Type A nomination route requires both HEC and CSC submissions. Follow the current degree/test conditions and earlier test registration instructions; saved drafts do not count as submitted applications.","tags":["Pakistan Type A","Both portals required","Separate test tasks"],"source":"https://www.hec.gov.pk/english/scholarshipsgrants/lao/CGSP/Pages/default.aspx","sourceLabel":"HEC official 2027–28 call","checked":"16 November 2026"}],"showTypeFilter":false}]]}]
