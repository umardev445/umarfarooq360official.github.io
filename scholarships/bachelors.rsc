27:["$","section","2-Build a strong undergraduate funding plan",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Build a strong undergraduate funding plan"}],[["$","p","Unlike many postgraduate awards, undergraduate scholarships may be automatically considered with admission or require a separate institutional form. Government programmes can also require nomination by an embassy or national sending partner.",{"children":"Unlike many postgraduate awards, undergraduate scholarships may be automatically considered with admission or require a separate institutional form. Government programmes can also require nomination by an embassy or national sending partner."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Prepare certified school transcripts",{"children":"Prepare certified school transcripts"}],["$","li","Check subject prerequisites",{"children":"Check subject prerequisites"}],["$","li","Plan language or standardised tests",{"children":"Plan language or standardised tests"}],["$","li","Compare automatic and separate scholarship applications",{"children":"Compare automatic and separate scholarship applications"}],["$","li","Keep a family financial evidence folder if need-based aid is offered",{"children":"Keep a family financial evidence folder if need-based aid is offered"}]]}],"$undefined","$undefined","$undefined"]}]
28:["$","section","3-Plan admission and funding as one timeline",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Plan admission and funding as one timeline"}],[["$","p","Undergraduate applicants may need school nomination, predicted grades, standardised tests or financial-aid forms before the normal admission deadline. Create a calendar that includes each dependency and ask the school counsellor early about documents that cannot be produced instantly.",{"children":"Undergraduate applicants may need school nomination, predicted grades, standardised tests or financial-aid forms before the normal admission deadline. Create a calendar that includes each dependency and ask the school counsellor early about documents that cannot be produced instantly."}],["$","p","Compare renewable funding across the full degree. A large first-year award can still leave a serious gap later if renewal depends on grades, credit load or residence conditions.",{"children":"Compare renewable funding across the full degree. A large first-year award can still leave a serious gap later if renewal depends on grades, credit load or residence conditions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","4-Documents to prepare early",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Documents to prepare early"}],[["$","p","Requirements vary, but the slowest items are often official school records, translations, a passport and referee submissions. Never alter a transcript or create an unofficial certification.",{"children":"Requirements vary, but the slowest items are often official school records, translations, a passport and referee submissions. Never alter a transcript or create an unofficial certification."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Current and final school transcripts",{"children":"Current and final school transcripts"}],["$","li","Official grading-scale explanation",{"children":"Official grading-scale explanation"}],["$","li","Passport or accepted identity evidence",{"children":"Passport or accepted identity evidence"}],["$","li","Language or admission tests where required",{"children":"Language or admission tests where required"}],["$","li","School nomination and references",{"children":"School nomination and references"}],["$","li","Family financial information for need-based aid",{"children":"Family financial information for need-based aid"}]]}],"$undefined","$undefined","$undefined"]}]
2a:["$","section","5-Plan the undergraduate dependencies",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Plan the undergraduate dependencies"}],[["$","p","Use the listing cards to find possibilities, then compare the model that actually fits your qualification, goal and financing needs. Routes with similar funding labels can require different application owners and documents.",{"children":"Use the listing cards to find possibilities, then compare the model that actually fits your qualification, goal and financing needs. Routes with similar funding labels can require different application owners and documents."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A route comparison before you apply","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A route comparison before you apply"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Model or stage",{"scope":"col","children":"Model or stage"}],["$","th","What to verify",{"scope":"col","children":"What to verify"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"School nomination"}],["$","td","1",{"children":"Ask whether the school must act before your form"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"University admission"}],["$","td","1",{"children":"Subject, qualification and applicant conditions"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Need-based aid"}],["$","td","1",{"children":"Permitted financial evidence and aid policy"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Renewable merit funding"}],["$","td","1",{"children":"Conditions for the full degree, not just year one"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2b:["$","section","6-Keep a small, evidence-based shortlist",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Keep a small, evidence-based shortlist"}],[["$","p","For each option, save the official source, cycle, nationality or residence conditions, programme, required documents and deadline. Mark a condition as unconfirmed when the current source is silent. A pending call is not an open application.",{"children":"For each option, save the official source, cycle, nationality or residence conditions, programme, required documents and deadline. Mark a condition as unconfirmed when the current source is silent. A pending call is not an open application."}],["$","p","Prepare documents around the earliest dependent task. References, school nomination, programme admission and a scholarship form may have separate dates. Keep academic fit and net cost visible so a well-written application does not lead to an unaffordable offer.",{"children":"Prepare documents around the earliest dependent task. References, school nomination, programme admission and a scholarship form may have separate dates. Keep academic fit and net cost visible so a well-written application does not lead to an unaffordable offer."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Keep a small, evidence-based shortlist","children":[["$","$L5","/scholarships/lester-b-pearson/",{"href":"/scholarships/lester-b-pearson/","children":["Pearson nomination and application",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/scholarship-application/",{"href":"/guides/scholarship-application/","children":["Build your evidence bank",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2c:["$","section","7-Separate degree scholarships from a school exchange",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Separate degree scholarships from a school exchange"}],[["$","p","Türkiye Scholarships includes degree-level routes. FLEX Global is a high-school exchange, not an undergraduate degree scholarship. Use the correct category and official eligibility before drafting.",{"children":"Türkiye Scholarships includes degree-level routes. FLEX Global is a high-school exchange, not an undergraduate degree scholarship. Use the correct category and official eligibility before drafting."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Separate degree scholarships from a school exchange","children":[["$","$L5","/scholarships/turkiye-burslari/",{"href":"/scholarships/turkiye-burslari/","children":["Türkiye Scholarships: eligibility and a stronger application",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/flex-global-exchange-program/",{"href":"/guides/flex-global-exchange-program/","children":["FLEX Global: choose the right country application route",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2d:["$","section","8-Pakistani applicants: domestic or overseas study?",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Pakistani applicants: domestic or overseas study?"}],[["$","p","School nomination, course admission and the final scholarship form may have different deadlines. Use the degree-specific comparison for overseas study and the domestic guide for study within Pakistan.",{"children":"School nomination, course admission and the final scholarship form may have different deadlines. Use the degree-specific comparison for overseas study and the domestic guide for study within Pakistan."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Pakistani applicants: domestic or overseas study?","children":[["$","$L5","/guides/undergraduate-scholarships-for-pakistani-students/",{"href":"/guides/undergraduate-scholarships-for-pakistani-students/","children":["Undergraduate scholarships for Pakistani students: routes and requirements",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/scholarships-in-pakistan/",{"href":"/guides/scholarships-in-pakistan/","children":["Scholarships in Pakistan for students studying locally",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
