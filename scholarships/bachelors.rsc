1b:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-Build a strong undergraduate funding plan",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Build a strong undergraduate funding plan"}],[["$","p","Unlike many postgraduate awards, undergraduate scholarships may be automatically considered with admission or require a separate institutional form. Government programmes can also require nomination by an embassy or national sending partner.",{"children":"Unlike many postgraduate awards, undergraduate scholarships may be automatically considered with admission or require a separate institutional form. Government programmes can also require nomination by an embassy or national sending partner."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Prepare certified school transcripts",{"children":"Prepare certified school transcripts"}],["$","li","Check subject prerequisites",{"children":"Check subject prerequisites"}],["$","li","Plan language or standardised tests",{"children":"Plan language or standardised tests"}],["$","li","Compare automatic and separate scholarship applications",{"children":"Compare automatic and separate scholarship applications"}],["$","li","Keep a family financial evidence folder if need-based aid is offered",{"children":"Keep a family financial evidence folder if need-based aid is offered"}]]}],"$undefined","$undefined","$undefined"]}],["$","section","2-Plan admission and funding as one timeline",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Plan admission and funding as one timeline"}],[["$","p","Undergraduate applicants may need school nomination, predicted grades, standardised tests or financial-aid forms before the normal admission deadline. Create a calendar that includes each dependency and ask the school counsellor early about documents that cannot be produced instantly.",{"children":"Undergraduate applicants may need school nomination, predicted grades, standardised tests or financial-aid forms before the normal admission deadline. Create a calendar that includes each dependency and ask the school counsellor early about documents that cannot be produced instantly."}],["$","p","Compare renewable funding across the full degree. A large first-year award can still leave a serious gap later if renewal depends on grades, credit load or residence conditions.",{"children":"Compare renewable funding across the full degree. A large first-year award can still leave a serious gap later if renewal depends on grades, credit load or residence conditions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Documents to prepare early",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Documents to prepare early"}],[["$","p","Requirements vary, but the slowest items are often official school records, translations, a passport and referee submissions. Never alter a transcript or create an unofficial certification.",{"children":"Requirements vary, but the slowest items are often official school records, translations, a passport and referee submissions. Never alter a transcript or create an unofficial certification."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Current and final school transcripts",{"children":"Current and final school transcripts"}],["$","li","Official grading-scale explanation",{"children":"Official grading-scale explanation"}],["$","li","Passport or accepted identity evidence",{"children":"Passport or accepted identity evidence"}],["$","li","Language or admission tests where required",{"children":"Language or admission tests where required"}],"$L1c","$L1d"]}],"$undefined","$undefined","$undefined"]}],"$L1e","$L1f","$L20","$L21"]}]
