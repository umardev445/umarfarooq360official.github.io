17:["$","section",null,{"className":"content-block","aria-labelledby":"relevant-listings","children":[["$","div",null,{"className":"content-block__heading","children":[["$","h2",null,{"id":"relevant-listings","children":"Relevant opportunities"}],["$","p",null,{"children":"6 official-source records match this topic. Check category and applicant conditions before applying."}]]}],["$","$L1a",null,{"items":[{"id":"mext-2027","title":"Japanese Government MEXT Scholarships","provider":"Government of Japan","type":"Scholarship","level":"Any degree","country":"Japan","region":"Asia","funding":"Fully funded","deadline":"Varies by embassy or university route","status":"Check official site","summary":"Japanese government scholarships for international students selected through embassy, university or authority recommendation routes.","tags":["Japan","Embassy route","University route"],"source":"https://www.mext.go.jp/en/policy/education/highered/title02/detail02/sdetail02/1373897.htm","sourceLabel":"MEXT official website","checked":"20 September 2026","featured":true},{"id":"stipendium-hungaricum","title":"Stipendium Hungaricum Scholarship","provider":"Government of Hungary","type":"Scholarship","level":"Any degree","country":"Hungary","region":"Europe","funding":"Funded","deadline":"Next cycle to be announced; current official page shows the prior intake","status":"Check official site","summary":"Tuition exemption with living and accommodation contributions; official guidance says the support may not meet all living costs.","tags":["Hungary","Bachelor's","Master's","PhD"],"source":"https://stipendiumhungaricum.hu/apply/","sourceLabel":"Stipendium Hungaricum official website","checked":"20 September 2026"},{"id":"lester-b-pearson-2027","title":"Lester B. Pearson International Scholarship 2027","provider":"University of Toronto","type":"Scholarship","level":"Bachelor's","country":"Canada","region":"North America","funding":"Fully funded","deadline":"School nomination: 9 Oct; admission: 16 Oct; scholarship: 6 Nov 2026","deadlineDate":"2026-10-09","milestones":[{"label":"School nomination","date":"2026-10-09","detail":"School acts first; later deadlines do not replace nomination."},{"label":"Undergraduate admission","date":"2026-10-16","detail":"Student follows the University of Toronto route."},{"label":"Scholarship form and documents","date":"2026-11-06","detail":"Nominated student uses the official invitation."}],"status":"Open","summary":"A four-year undergraduate award covering tuition, books, incidental fees and full residence support for exceptional international students nominated by their schools.","tags":["University of Toronto","School nomination","Undergraduate"],"source":"https://future.utoronto.ca/pearson-scholarships","sourceLabel":"University of Toronto official scholarship page","checked":"20 September 2026","featured":true},{"id":"australia-awards-scholarships","title":"Australia Awards Scholarships","provider":"Australian Government Department of Foreign Affairs and Trade","type":"Scholarship","level":"Any degree","country":"Australia","region":"Oceania","funding":"Fully funded","deadline":"Country-specific; check the participating-country profile","status":"Check official site","summary":"Long-term undergraduate and postgraduate awards for eligible developing-country applicants, with benefits generally including tuition, travel, living support and health cover.","tags":["Developing countries","Government scholarship","Return-home condition"],"source":"https://www.dfat.gov.au/people-to-people/australia-awards/australia-awards-scholarships","sourceLabel":"Australian Government DFAT","checked":"2 October 2026","featured":true},{"id":"italy-ergo-dsu-2026-27","title":"ER.GO Regional Scholarship 2026–2027","provider":"ER.GO Emilia-Romagna","type":"Scholarship","level":"Any degree","country":"Italy","region":"Europe","funding":"Funded","deadline":"24 August 2026, 16:00 — main scholarship deadline closed","deadlineDate":"2026-08-24","status":"Closed","summary":"Regional right-to-study support assessed under ER.GO's economic, enrolment and merit rules, with separate guidance for families holding income or assets abroad.","tags":["DSU","Emilia-Romagna","Income assessed"],"source":"https://www.er-go.it/cosa-fare-per/bandi-di-concorso/leggi-il-bando","sourceLabel":"ER.GO official 2026–2027 call","checked":"29 September 2026"},{"id":"padua-international-excellence-2026-27","title":"Padua International Excellence Scholarship","provider":"University of Padua","type":"Scholarship","level":"Any degree","country":"Italy","region":"Europe","funding":"Funded","deadline":"2027–2028 award terms: verify on the official scholarship page","status":"Check official site","summary":"The 2026–2027 scheme offered €8,000 gross per year plus a tuition-fee exemption for selected international students in eligible English-taught degrees.","tags":["Padua","Merit","English-taught degree"],"source":"https://www.unipd.it/en/padua-international-excellence-scholarship-programme","sourceLabel":"University of Padua","checked":"29 September 2026","featured":true}],"showTypeFilter":false}]]}]
18:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-Build a strong undergraduate funding plan",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Build a strong undergraduate funding plan"}],[["$","p","Unlike many postgraduate awards, undergraduate scholarships may be automatically considered with admission or require a separate institutional form. Government programmes can also require nomination by an embassy or national sending partner.",{"children":"Unlike many postgraduate awards, undergraduate scholarships may be automatically considered with admission or require a separate institutional form. Government programmes can also require nomination by an embassy or national sending partner."}]],"$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Prepare certified school transcripts",{"children":"Prepare certified school transcripts"}],["$","li","Check subject prerequisites",{"children":"Check subject prerequisites"}],["$","li","Plan language or standardised tests",{"children":"Plan language or standardised tests"}],["$","li","Compare automatic and separate scholarship applications",{"children":"Compare automatic and separate scholarship applications"}],["$","li","Keep a family financial evidence folder if need-based aid is offered",{"children":"Keep a family financial evidence folder if need-based aid is offered"}]]}],"$undefined","$undefined"]}],["$","section","2-Plan admission and funding as one timeline",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Plan admission and funding as one timeline"}],[["$","p","Undergraduate applicants may need school nomination, predicted grades, standardised tests or financial-aid forms before the normal admission deadline. Create a calendar that includes each dependency and ask the school counsellor early about documents that cannot be produced instantly.",{"children":"Undergraduate applicants may need school nomination, predicted grades, standardised tests or financial-aid forms before the normal admission deadline. Create a calendar that includes each dependency and ask the school counsellor early about documents that cannot be produced instantly."}],["$","p","Compare renewable funding across the full degree. A large first-year award can still leave a serious gap later if renewal depends on grades, credit load or residence conditions.",{"children":"Compare renewable funding across the full degree. A large first-year award can still leave a serious gap later if renewal depends on grades, credit load or residence conditions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Documents to prepare early",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Documents to prepare early"}],[["$","p","Requirements vary, but the slowest items are often official school records, translations, a passport and referee submissions. Never alter a transcript or create an unofficial certification.",{"children":"Requirements vary, but the slowest items are often official school records, translations, a passport and referee submissions. Never alter a transcript or create an unofficial certification."}]],"$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Current and final school transcripts",{"children":"Current and final school transcripts"}],["$","li","Official grading-scale explanation",{"children":"Official grading-scale explanation"}],["$","li","Passport or accepted identity evidence",{"children":"Passport or accepted identity evidence"}],["$","li","Language or admission tests where required",{"children":"Language or admission tests where required"}],"$L1b","$L1c"]}],"$undefined","$undefined"]}]]}]
