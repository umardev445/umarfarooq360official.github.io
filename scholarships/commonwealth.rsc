24:["$","section","2-Master's and PhD routes are not interchangeable",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Master's and PhD routes are not interchangeable"}],[["$","p","The Master's scholarship supports eligible candidates who could not otherwise afford UK study and are positioned to contribute to sustainable development. The PhD route covered here is intended for candidates from eligible least-developed countries and vulnerable Commonwealth states and supports full-time doctoral study.",{"children":"The Master's scholarship supports eligible candidates who could not otherwise afford UK study and are positioned to contribute to sustainable development. The PhD route covered here is intended for candidates from eligible least-developed countries and vulnerable Commonwealth states and supports full-time doctoral study."}],["$","p","Do not assume that eligibility for the Master's route proves eligibility for the PhD route. Check the current country list, academic requirements, development theme and all scheme-specific conditions.",{"children":"Do not assume that eligibility for the Master's route proves eligibility for the PhD route. Check the current country list, academic requirements, development theme and all scheme-specific conditions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","3-Understand the two-part application route",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Understand the two-part application route"}],[["$","p","Candidates apply through the CSC's stated online application system and must also use an approved nominating body. The CSC does not accept a candidate submitted only as a direct independent application outside the required nomination structure.",{"children":"Candidates apply through the CSC's stated online application system and must also use an approved nominating body. The CSC does not accept a candidate submitted only as a direct independent application outside the required nomination structure."}],["$","p","A national nominator, university or other approved organisation can impose its own documents, tests or earlier deadline. Identify the correct nominator for your country and route before drafting the final form.",{"children":"A national nominator, university or other approved organisation can impose its own documents, tests or earlier deadline. Identify the correct nominator for your country and route before drafting the final form."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","4-What the funding may cover",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"What the funding may cover"}],[["$","p","The official pages describe approved tuition, travel to and from the United Kingdom, a living allowance and other applicable support such as study travel or thesis-related help. Some family or disability support may apply under stated conditions. Read the current terms instead of assuming every personal cost is covered.",{"children":"The official pages describe approved tuition, travel to and from the United Kingdom, a living allowance and other applicable support such as study travel or thesis-related help. Some family or disability support may apply under stated conditions. Read the current terms instead of assuming every personal cost is covered."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
27:["$","section","5-Build the development-impact case",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Build the development-impact case"}],[["$","p","Define a development problem you understand, support it with context and explain why the chosen course or research route provides a missing capability. Then describe achievable outcomes, beneficiaries and the role you can realistically take after the award.",{"children":"Define a development problem you understand, support it with context and explain why the chosen course or research route provides a missing capability. Then describe achievable outcomes, beneficiaries and the role you can realistically take after the award."}],["$","p","Connect past evidence to future plans. A candidate who has already taken relevant action can make a more credible case than one relying only on ambitious language.",{"children":"Connect past evidence to future plans. A candidate who has already taken relevant action can make a more credible case than one relying only on ambitious language."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Problem and relevant evidence",{"children":"Problem and relevant evidence"}],["$","li","Your previous contribution",{"children":"Your previous contribution"}],["$","li","Skill or research gap",{"children":"Skill or research gap"}],["$","li","Why the selected UK programme fits",{"children":"Why the selected UK programme fits"}],["$","li","Short-term application after return",{"children":"Short-term application after return"}],["$","li","Longer-term measurable direction",{"children":"Longer-term measurable direction"}]]}],"$undefined","$undefined","$undefined"]}]
28:["$","section","6-Advice for applicants from Pakistan",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Advice for applicants from Pakistan"}],[["$","p","Pakistan appears on the current Master's eligible-country list. Applicants must still satisfy all criteria and follow the approved Pakistani nominator process. For PhD funding, check the exact current eligible-country list rather than assuming the Master's country list applies.",{"children":"Pakistan appears on the current Master's eligible-country list. Applicants must still satisfy all criteria and follow the approved Pakistani nominator process. For PhD funding, check the exact current eligible-country list rather than assuming the Master's country list applies."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","7-Application and document checklist",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Application and document checklist"}],[["$","p","Use the official page and nominator instructions to create one combined checklist. Keep degree names, dates, employment and proposed programme information consistent across both systems.",{"children":"Use the official page and nominator instructions to create one combined checklist. Keep degree names, dates, employment and proposed programme information consistent across both systems."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Correct scholarship route selected",{"children":"Correct scholarship route selected"}],["$","li","Country eligibility confirmed",{"children":"Country eligibility confirmed"}],["$","li","Approved nominator and local deadline identified",{"children":"Approved nominator and local deadline identified"}],["$","li","CSC online application completed",{"children":"CSC online application completed"}],["$","li","Academic documents meet stated standards",{"children":"Academic documents meet stated standards"}],["$","li","References follow the required process",{"children":"References follow the required process"}],["$","li","Development impact is specific and evidence-based",{"children":"Development impact is specific and evidence-based"}],["$","li","Submission confirmations retained",{"children":"Submission confirmations retained"}]]}],"$undefined","$undefined","$undefined"]}]
