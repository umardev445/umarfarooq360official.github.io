1f:["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Check both application responsibilities",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Check both application responsibilities"}],[["$","p","A commission portal submission does not automatically complete a separate nomination process.",{"children":"A commission portal submission does not automatically complete a separate nomination process."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Master’s and PhD routes need their own checks","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Master’s and PhD routes need their own checks"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Check",{"scope":"col","children":"Check"}],["$","th","Master’s / PhD detail",{"scope":"col","children":"Master’s / PhD detail"}],["$","th","Record",{"scope":"col","children":"Record"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Degree and nationality"}],["$","td","1",{"children":"Current eligible country/degree list"}],["$","td","2",{"children":"Exact route and intake"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Nominating body"}],["$","td","1",{"children":"Applicable national or other approved route"}],["$","td","2",{"children":"Local instructions and deadline"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Commission submission"}],["$","td","1",{"children":"Required scholarship application and documents"}],["$","td","2",{"children":"Portal confirmation"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","chi