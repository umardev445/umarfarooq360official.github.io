21:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","When is the Commonwealth Scholarship 2027 deadline?",{"children":[["$","summary",null,{"children":["When is the Commonwealth Scholarship 2027 deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The published central deadline for the listed 2027–2028 Master’s and PhD schemes was 20 October 2026 at 16:00 BST and has passed. Check the official portal for any amendment. A later nomination or university task does not itself reopen the CSC application."}]]}],["$","details","Can I apply directly to the CSC without a nominator?",{"children":[["$","summary",null,{"children":["Can I apply directly to the CSC without a nominator?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The current scheme requires an application through the stated CSC system and an approved nominating body. A central form alone does not replace nomination."}]]}],["$","details","Is Pakistan eligible for Commonwealth Master's Scholarships?",{"children":[["$","summary",null,{"children":["Is Pakistan eligible for Commonwealth Master's Scholarships?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Pakistan is on the current eligible-country list for the Master's route. All personal eligibility and nominator requirements still apply."}]]}],["$","details","Is the Commonwealth Scholarship fully funded?",{"children":[["$","summary",null,{"children":["Is the Commonwealth Scholarship fully funded?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The official scheme describes tuition, travel, living support and other applicable allowances. Read the exact current benefits and conditions for your route and circumstances."}]]}],["$","details","Do I need university admission separately?",{"children":[["$","summary",null,{"children":["Do I need university admission separately?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Follow the current CSC and nominator instructions for course choices and admission. Scholarship nomination does not remove university academic requirements."}]]}]]}]]}]
