1b:T4dc,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How much does ETH ESOP pay for 2027 entry?","acceptedAnswer":{"@type":"Answer","text":"ETH specifies CHF13,500 per semester from autumn 2027, plus a tuition fee waiver, for the regular three- or four-semester master's duration. Check your offer for the actual payment arrangements."}},{"@type":"Question","name":"Can I apply if I already hold a master's degree?","acceptedAnswer":{"@type":"Answer","text":"The ESOP page excludes applicants who hold a master's degree and those already enrolled in an ETH master's. Check the current eligibility rule before investing in the application."}},{"@type":"Question","name":"Is the ESOP pre-proposal my final thesis topic?","acceptedAnswer":{"@type":"Answer","text":"No. ETH describes it as an independently developed possible project that demonstrates research planning. The final topic is defined during the master's with the supervisor."}},{"@type":"Question","name":"Can I use a later master's application window for ESOP?","acceptedAnswer":{"@type":"Answer","text":"ETH requires ESOP applications in the first application window. A later admission opportunity does not reopen the scholarship window."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page scholarship-release editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/scholarships/eth-zurich-esop/\",\"name\":\"ETH Zurich ESOP Scholarship 2027: eligibility and pre-proposal\",\"description\":\"Check ETH Zurich ESOP 2027 eligibility, CHF13,500 per semester, tuition waiver, November application window and the independent thesis pre-proposal.\",\"url\":\"https://aspirecompass.org/scholarships/eth-zurich-esop/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-11-03\",\"dateModified\":\"2026-11-03\",\"primaryIma