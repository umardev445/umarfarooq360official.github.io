29:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"An original planning structure before drafting the pre-proposal","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"An original planning structure before drafting the pre-proposal"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Part",{"scope":"col","children":"Part"}],["$","th","Question to answer",{"scope":"col","children":"Question to answer"}],["$","th","Common revision",{"scope":"col","children":"Common revision"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Question"}],["$","td","1",{"children":"What exactly would you investigate?"}],["$","td","2",{"children":"Narrow a broad theme to one answerable question"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Evidence"}],["$","td","1",{"children":"What data or material could support the work?"}],["$","td","2",{"children":"Identify access limits and a feasible alternative"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Method"}],["$","td","1",{"children":"How would the evidence answer the question?"}],["$","td","2",{"children":"Explain why the method fits, rather than listing tools"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Milestones"}],["$","td","1",{"children":"What can be achieved during the thesis period?"}],["$","td","2",{"children":"Separate preparation, analysis and evaluation"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"References"}],["$","td","1",{"children":"Which claims or ideas came from other work?"}],["$","td","2",{"children":"Check every citation against a source you read"}]],"$undefined"]}]]}]]}]}],"$undefined"]
