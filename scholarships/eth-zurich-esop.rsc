27:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","How much does ETH ESOP pay for 2027 entry?",{"children":[["$","summary",null,{"children":["How much does ETH ESOP pay for 2027 entry?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"ETH specifies CHF13,500 per semester from autumn 2027, plus a tuition fee waiver, for the regular three- or four-semester master's duration. Check your offer for the actual payment arrangements."}]]}],["$","details","Can I apply if I already hold a master's degree?",{"children":[["$","summary",null,{"children":["Can I apply if I already hold a master's degree?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The ESOP page excludes applicants who hold a master's degree and those already enrolled in an ETH master's. Check the current eligibility rule before investing in the application."}]]}],["$","details","Is the ESOP pre-proposal my final thesis topic?",{"children":[["$","summary",null,{"children":["Is the ESOP pre-proposal my final thesis topic?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. ETH describes it as an independently developed possible project that demonstrates research planning. The final topic is defined during the master's with the supervisor."}]]}],["$","details","Can I use a later master's application window for ESOP?",{"children":[["$","summary",null,{"children":["Can I use a later master's application window for ESOP?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"ETH requires ESOP applications in the first application window. A later admission opportunity does not reopen the scholarship window."}]]}]]}]]}]
