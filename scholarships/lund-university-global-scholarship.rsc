1d:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Lund’s reviewed scholarship page is closed, with 16 February 2026 as its last stated deadline. A future window must be announced separately. The award concerns tuition; living-cost funding remains your responsibility."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose an eligible first-choice programme, complete the degree-application requirements and monitor Lund’s official scholarship page."]}],"$undefined"]}],"$undefined",false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Read admission and scholarship status separately",{"href":"#section-1","children":"Read admission and scholarship status separately"}],["$","a","Check the route before investing in the scholarship file",{"href":"#section-2","children":"Check the route before investing in the scholarship file"}],["$","a","A two-portal dependency checklist",{"href":"#section-3","children":"A two-portal dependency checklist"}],["$","a","Keep the scholarship case distinct from the programme case",{"href":"#section-4","children":"Keep the scholarship case distinct from the programme case"}],["$","a","A tuition award still leaves a separate living budget",{"href":"#section-5","children":"A tuition award still leaves a separate living budget"}],["$","a","Review the offer as a new set of tasks",{"href":"#section-6","children":"Review the offer as a new set of tasks"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Read admission and scholarship status separately",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Read admission and scholarship status separately"}],[["$","p","At this review, the Global Scholarship page still shows the closed 2026 round. Its usual early-February timing is background, not a confirmed 2027 opening. By contrast, Lund’s Mathematics master’s page explicitly gives 15 October 2026–15 January 2027 for autumn 2027 admission. That programme example cannot supply a scholarship cutoff.",{"children":"At this review, the Global Scholarship page still shows the closed 2026 round. Its usual early-February timing is background, not a confirmed 2027 opening. By contrast, Lund’s Mathematics master’s page explicitly gives 15 October 2026–15 January 2027 for autumn 2027 admission. That programme example cannot supply a scholarship cutoff."}],["$","p","Keep admission and scholarship statuses separate. Finish the governed admission tasks while monitoring the scholarship owner; never add twelve months to an archived deadline.",{"children":"Keep admission and scholarship statuses separate. Finish the governed admission tasks while monitoring the scholarship owner; never add twelve months to an archived deadline."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Verified status boundaries, not a complete university calendar","tabIndex":0,"children":"$L1f"}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$L20","$undefined"]}]]}],"$L21",false,false,false,"$L22",false,"$L23",null]}],"$L24"]}]
