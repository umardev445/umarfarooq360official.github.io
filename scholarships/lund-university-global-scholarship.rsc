20:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.lunduniversity.lu.se/study/admission-degree-studies/scholarships-and-awards/lund-university-global-scholarship",{"children":["",["$","a",null,{"href":"https://www.lunduniversity.lu.se/study/admission-degree-studies/scholarships-and-awards/lund-university-global-scholarship","target":"_blank","rel":"noreferrer","children":"Lund: Global Scholarship conditions and status"}]]}],["$","span","https://www.maths.lu.se/english/education/mathematics-masters-programme/",{"children":[" · ",["$","a",null,{"href":"https://www.maths.lu.se/english/education/mathematics-masters-programme/","target":"_blank","rel":"noreferrer","children":"Lund Mathematics: explicit autumn 2027 admission window"}]]}],["$","span","https://www.lunduniversity.lu.se/study/admission-degree-studies/applying-studies-when-apply",{"children":[" · ",["$","a",null,{"href":"https://www.lunduniversity.lu.se/study/admission-degree-studies/applying-studies-when-apply","target":"_blank","rel":"noreferrer","children":"Lund: when to apply for degree studies"}]]}]]]}]
