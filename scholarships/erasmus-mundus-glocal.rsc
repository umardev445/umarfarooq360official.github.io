1c:T439,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I use a self-funded deadline for scholarship consideration?","acceptedAnswer":{"@type":"Answer","text":"No. The published funding routes have separate deadlines. Use the scholarship row and its complete-file requirements."}},{"@type":"Question","name":"Can I apply to Track H for 2027?","acceptedAnswer":{"@type":"Answer","text":"The reviewed How to Apply page says Track H is not recruiting. Choose from the current active options and recheck before submission."}},{"@type":"Question","name":"Does an agreed reference count as received?","acceptedAnswer":{"@type":"Answer","text":"No. Track the reference through the permitted submission route and confirm the state required by the programme."}},{"@type":"Question","name":"Does this guide settle the offer-status sequence?","acceptedAnswer":{"@type":"Answer","text":"No. The owner pages describe the sequence differently. Ask the named programme/admissions contact about your actual status and retain the written clarification."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/scholarships/erasmus-mundus-glocal/\",\"name\":\"Erasmus Mundus GLOCAL: track, funding route and a complete application\",\"description\":\"Choose an active GLOCAL track, distinguish scholarship and self-funded deadlines, and use an original track-fit and reference-dependency worksheet.\",\"url\":\"https://aspirecompass.org/scholarships/erasmus-mundus-glocal/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-11-16\",\"dateModified\":\"2026-11-16\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerH