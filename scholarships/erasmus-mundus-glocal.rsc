1e:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"The published GLOCAL 2027/29 scholarship deadline is 14 January 2027 at 13:00 UK time. Choose one active track and the scholarship form; later self-funded dates are different routes. Track H is not recruiting for this intake."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Match your academic preparation to an active track, then audit the required English evidence and two references against the live application instructions."]}],"$undefined"]}],"$undefined",false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Match the funding form to the exact deadline",{"href":"#section-1","children":"Match the funding form to the exact deadline"}],["$","a","Choose an active track from the curriculum, not the destination photo",{"href":"#section-2","children":"Choose an active track from the curriculum, not the destination photo"}],["$","a","Treat references as a dependency with a received state",{"href":"#section-3","children":"Treat references as a dependency with a received state"}],["$","a","Audit the academic and English evidence as separate items",{"href":"#section-4","children":"Audit the academic and English evidence as separate items"}],["$","a","Write your own statement from an evidence bank",{"href":"#section-5","children":"Write your own statement from an evidence bank"}],["$","a","Plan mobility costs without adding the same scholarship money twice",{"href":"#section-6","children":"Plan mobility costs without adding the same scholarship money twice"}],["$","a","Check the final file against the chosen route",{"href":"#section-7","children":"Check the final file against the chosen route"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Match the funding form to the exact deadline",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Match the funding form to the exact deadline"}],[["$","p","GLOCAL’s entry page separates the scholarship cutoff from its self-funded deadlines. In January, UK time is GMT, so the scholarship closing instant is also 13:00 UTC on 14 January 2027. For July and August, keep the stated UK local time rather than assume a year-round UTC offset.",{"children":"GLOCAL’s entry page separates the scholarship cutoff from its self-funded deadlines. In January, UK time is GMT, so the scholarship closing instant is also 13:00 UTC on 14 January 2027. For July and August, keep the stated UK local time rather than assume a year-round UTC offset."}],["$","p","The table is a route map, not an eligibility result. Check how the programme classifies your fee/application category; citizenship alone may not answer every fee-status question. A later self-funded date cannot rescue a scholarship file that missed the earlier required complete state.",{"children":"The table is a route map, not an eligibility result. Check how the programme classifies your fee/application category; citizenship alone may not answer every fee-status question. A later self-funded date cannot rescue a scholarship file that missed the earlier required complete state."}],"$L20"],"$undefined","$L21","$undefined","$undefined","$undefined","$undefined","$undefined","$L22"]}]]}],"$L23",false,false,false,"$L24",false,"$L25","$L26"]}],"$L27"]}]
