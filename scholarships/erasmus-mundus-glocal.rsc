22:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Match the funding form to the exact deadline","children":[["$","$L5","https://globallocal-erasmusmundus.eu/how-to-apply/",{"href":"https://globallocal-erasmusmundus.eu/how-to-apply/","children":["Open GLOCAL’s official application instructions",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
