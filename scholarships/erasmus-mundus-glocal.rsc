2a:["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Learning gap"}],["$","td","1",{"children":"One honest methodological gap"}],["$","td","2",{"children":"Is the track designed to develop that skill?"}]],"$undefined"]}]
2b:["$","section","2-Treat references as a dependency with a received state",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Treat references as a dependency with a received state"}],[["$","p","The application page requires two references, with at least one academic. It specifies recent, signed institutional-headed/stamped evidence and gives institutional-email or applicant-upload routes with official contact details. Read its exact rules for when a professional reference is permitted; a personal email address or typed name is not a substitute.",{"children":"The application page requires two references, with at least one academic. It specifies recent, signed institutional-headed/stamped evidence and gives institutional-email or applicant-upload routes with official contact details. Read its exact rules for when a professional reference is permitted; a personal email address or typed name is not a substitute."}],["$","p","Ask early and provide the referee with your genuine work, the selected track and the owner’s instructions. Keep requested, agreed, sent and received as different states. A lecturer’s promise to help is valuable, but it is not evidence that the correct reference has reached the permitted channel.",{"children":"Ask early and provide the referee with your genuine work, the selected track and the owner’s instructions. Keep requested, agreed, sent and received as different states. A lecturer’s promise to help is valuable, but it is not evidence that the correct reference has reached the permitted channel."}],["$","p","Original fictional dependency check: one referee has returned a compliant letter, while the second has only agreed by message. The applicant labels the second item pending and checks its accepted submission method. They do not upload their own summary of the relationship as though it were the referee’s endorsement.",{"children":"Original fictional dependency check: one referee has returned a compliant letter, while the second has only agreed by message. The applicant labels the second item pending and checks its accepted submission method. They do not upload their own summary of the relationship as though it were the referee’s endorsement."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Treat references as a dependency with a received state","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Treat references as a dependency with a received state"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Reference state",{"scope":"col","children":"Reference state"}],["$","th","Evidence to retain privately",{"scope":"col","children":"Evidence to retain privately"}],["$","th","Next action",{"scope":"col","children":"Next action"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Agreed"}],["$","td","1",{"children":"Referee understands route and deadline"}],["$","td","2",{"children":"Provide accurate instructions and context"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Sent"}],["$","td","1",{"children":"Correct channel and official sender details"}],["$","td","2",{"children":"Check the programme’s required received state"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Received/attached"}],["$","td","1",{"children":"Actual compliant reference in the permitted process"}],["$","td","2",{"children":"Inspect the rest of the file before submission"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2c:["$","section","3-Audit the academic and English evidence as separate items",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Audit the academic and English evidence as separate items"}],[["$","p","The owner’s application list includes university-level transcripts and certificates, CV, identity and English evidence alongside the relevant funding form. Scholarship applicants are told to provide the required English evidence by the scholarship deadline. Use the programme’s current country/qualification rules instead of a generic GPA conversion or a universal MOI assumption.",{"children":"The owner’s application list includes university-level transcripts and certificates, CV, identity and English evidence alongside the relevant funding form. Scholarship applicants are told to provide the required English evidence by the scholarship deadline. Use the programme’s current country/qualification rules instead of a generic GPA conversion or a universal MOI assumption."}],["$","p","Prepare a document register with original language, required translation, issue date and the exact upload state. Do not assume that an unconditional-offer condition can be left until enrolment if scholarship consideration requires it earlier.",{"children":"Prepare a document register with original language, required translation, issue date and the exact upload state. Do not assume that an unconditional-offer condition can be left until enrolment if scholarship consideration requires it earlier."}],["$","p","Read the programme’s offer-status instructions carefully. The scholarship page describes an eligible offer state and excludes a file held for documents, while How to Apply describes admission offers following scholarship outcomes. If your status or sequence is unclear, seek clarification through the named programme/admissions contact rather than infer that a pending file qualifies. Retain the written response with its cycle and scope.",{"children":"Read the programme’s offer-status instructions carefully. The scholarship page describes an eligible offer state and excludes a file held for documents, while How to Apply describes admission offers following scholarship outcomes. If your status or sequence is unclear, seek clarification through the named programme/admissions contact rather than infer that a pending file qualifies. Retain the written response with its cycle and scope."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2d:["$","section","4-Write your own statement from an evidence bank",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Write your own statement from an evidence bank"}],[["$","p","Use the statement to connect your actual preparation, the selected curriculum and a future learning or research question. This is an original planning method, not a statement to submit. The programme publishes its own prompt and word limit; read those before turning notes into an application answer.",{"children":"Use the statement to connect your actual preparation, the selected curriculum and a future learning or research question. This is an original planning method, not a statement to submit. The programme publishes its own prompt and word limit; read those before turning notes into an application answer."}],["$","p","For every claim, identify an example you could explain in an interview: the task, your own contribution, a result and what remains uncertain. Work experience is useful when connected to the programme’s learning goals, not merely listed as a sequence of impressive titles.",{"children":"For every claim, identify an example you could explain in an interview: the task, your own contribution, a result and what remains uncertain. Work experience is useful when connected to the programme’s learning goals, not merely listed as a sequence of impressive titles."}],["$","p","Fictional example: an applicant examined how a local firm changed suppliers after a market disruption. Their possible research question concerns how firms and local institutions respond to international pressures. They distinguish what they observed in that one assignment from a broad causal claim about all firms or countries. The application should remain in the applicant’s own words.",{"children":"Fictional example: an applicant examined how a local firm changed suppliers after a market disruption. Their possible research question concerns how firms and local institutions respond to international pressures. They distinguish what they observed in that one assignment from a broad causal claim about all firms or countries. The application should remain in the applicant’s own words."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2e:["$","section","5-Plan mobility costs without adding the same scholarship money twice",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Plan mobility costs without adding the same scholarship money twice"}],[["$","p","GLOCAL’s scholarship page describes tuition coverage, insurance and two payment arrangements. One provides advance instalments deducted from the overall award with lower monthly payments; the other uses the stated full monthly allowance without those advance payments. Compare the actual offer and payment option, not the largest number from each alternative.",{"children":"GLOCAL’s scholarship page describes tuition coverage, insurance and two payment arrangements. One provides advance instalments deducted from the overall award with lower monthly payments; the other uses the stated full monthly allowance without those advance payments. Compare the actual offer and payment option, not the largest number from each alternative."}],["$","p","Original cash-timing exercise: an invented €600 deposit and €350 travel bill create €950 to arrange before arrival. If a verified advance will be received beforehand, record its date and amount once. If timing is uncertain, keep the pre-arrival gap unresolved instead of assuming a later monthly payment pays an earlier bill.",{"children":"Original cash-timing exercise: an invented €600 deposit and €350 travel bill create €950 to arrange before arrival. If a verified advance will be received beforehand, record its date and amount once. If timing is uncertain, keep the pre-arrival gap unresolved instead of assuming a later monthly payment pays an earlier bill."}],["$","p","For a self-funded plan, replace scholarship expectations with verified personal funding and real quotations for every mobility location. An admission offer, scholarship shortlist or reserve position does not establish money available to spend.",{"children":"For a self-funded plan, replace scholarship expectations with verified personal funding and real quotations for every mobility location. An admission offer, scholarship shortlist or reserve position does not establish money available to spend."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2f:["$","section","6-Check the final file against the chosen route",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Check the final file against the chosen route"}],[["$","p","Open the current track and funding instructions again before submission. Confirm that the selected track is recruiting, every required reference/document is in its permitted state and the final form uses the same programme choice as your statement.",{"children":"Open the current track and funding instructions again before submission. Confirm that the selected track is recruiting, every required reference/document is in its permitted state and the final form uses the same programme choice as your statement."}],["$","p","After submission, retain the official confirmation and the exact final files privately. Follow the published programme channel for changes or follow-up. This worksheet helps organise a complete application; the consortium and university still assess academic eligibility, admission and funding.",{"children":"After submission, retain the official confirmation and the exact final files privately. Follow the published programme channel for changes or follow-up. This worksheet helps organise a complete application; the consortium and university still assess academic eligibility, admission and funding."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
