22:["$","div",null,{"className":"article-body","children":[["$","section","Gates Cambridge 2027: choose the correct round",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Gates Cambridge 2027: choose the correct round"}],[["$","p","The 2027/28 scholarship is tied to an eligible postgraduate course application. For applicants outside the US-resident US-citizen round, use the exact course funding deadline. An admission deadline later in the year is not the scholarship deadline.",{"children":"The 2027/28 scholarship is tied to an eligible postgraduate course application. For applicants outside the US-resident US-citizen round, use the exact course funding deadline. An admission deadline later in the year is not the scholarship deadline."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Applicant category and course deadline decide the route","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Applicant category and course deadline decide the route"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Applicant or task",{"scope":"col","children":"Applicant or task"}],["$","th","Date or instruction",{"scope":"col","children":"Date or instruction"}],["$","th","What to do",{"scope":"col","children":"What to do"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"US citizens resident in the US"}],["$","td","1",{"children":"14 October 2026 round has closed"}],["$","td","2",{"children":"Existing applicants follow assessment instructions"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"All other eligible applicants"}],["$","td","1",{"children":"Course funding deadline: 8 Decemb