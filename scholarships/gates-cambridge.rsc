1:["$","main",null,{"id":"main-content","className":"editorial-page scholarship-release editorial-page--guide opportunity-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/scholarships/gates-cambridge/\",\"name\":\"Gates Cambridge Scholarship 2027: deadlines and application\",\"description\":\"Find your Gates Cambridge 2027 course funding deadline, check the correct applicant round and prepare scholarship evidence and references in order.\",\"url\":\"https://aspirecompass.org/scholarships/gates-cambridge/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-24\",\"dateModified\":\"2026-11-03\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/opportunities-20261024/cambridge-1280.webp\",\"caption\":\"Illustrative English riverside university courtyard with postgraduate students\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Scholarships\",\"item\":\"https://aspirecompass.org/scholarships/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Gates Cambridge Scholarship 2027: deadlines and application\",\"item\":\"https://aspirecompass.org/scholarships/gates-cambridge/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"inLanguage\":\"en\",\"headline\":\"Gates Cambridge Scholarship 2027: deadlines and application\",\"description\":\"Find your Gates Cambridge 2027 course funding deadline, check the correct applicant round and prepare scholarship evidence and references in order.\",\"image\":\"https://aspirecompass.org/images/opportunities-20261024/cambridge-1280.webp\",\"datePublished\":\"2026-10-24\",\"dateModified\":\"2026-11-03\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/scholarships/gates-cambridge/\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can I choose either the December or January Gates deadline?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The applicable course funding deadline controls your application. Check the course page; a later admission closing date does not extend funding consideration.\"}},{\"@type\":\"Question\",\"name\":\"Do references have to be in by the funding deadline?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Cambridge states that the complete application, including references, must arrive by 23:59 GMT on the relevant deadline. Check any Gates-specific reference request as well as course references.\"}},{\"@type\":\"Question\",\"name\":\"Can Pakistani applicants use the main round?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Eligible applicants outside the US-resident US-citizen category use the international route. Nationality alone does not establish eligibility for the selected course or award.\"}}]}"}}]],"$L1b",false,"$L1c","$L1d"]}]
