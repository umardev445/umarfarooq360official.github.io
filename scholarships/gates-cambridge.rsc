2a:["$","section","3-Application and reference sequence",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Application and reference sequence"}],[["$","p","Cambridge requires a complete application, including references, by the relevant funding deadline. Create an internal follow-up date for each referee. Verify any Gates-specific reference request in the current funding section rather than assuming that academic references alone finish the task.",{"children":"Cambridge requires a complete application, including references, by the relevant funding deadline. Create an internal follow-up date for each referee. Verify any Gates-specific reference request in the current funding section rather than assuming that academic references alone finish the task."}]],["$","ol",null,{"className":"process-steps","aria-label":"Application and reference sequence","children":[["$","li","Select an eligible course and save its funding deadline.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Select an eligible course and save its funding deadline."}]]}],["$","li","Open the course application and follow the funding section's Gates instructions.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Open the course application and follow the funding section's Gates instructions."}]]}],["$","li","Invite the required referees and agree a submission plan.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Invite the required referees and agree a submission plan."}]]}],["$","li","Prepare the course documents and additional scholarship answers.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Prepare the course documents and additional scholarship answers."}]]}],["$","li","Check the complete portal record, submit before the funding deadline and save confirmation.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Check the complete portal record, submit before the funding deadline and save confirmation."}]]}]]}],"$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"A fictional course has an 8 December funding deadline and a later admission closing date. Submitting on 6 January does not create a second chance for that course's funding. Record 8 December as the controlling date and work backwards from it."}]]}],"$undefined","$undefined","$undefined","$undefined"]}]
2b:["$","section","4-Funding scope and costs to verify",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Funding scope and costs to verify"}],[["$","p","Cambridge describes the Gates award as full-cost support covering the composition fee and maintenance, with travel, visa and immigration-health support. Some additional components are discretionary. Use the current award terms and your offer rather than treating a headline package valuation as a cash payment.",{"children":"Cambridge describes the Gates award as full-cost support covering the composition fee and maintenance, with travel, visa and immigration-health support. Some additional components are discretionary. Use the current award terms and your offer rather than treating a headline package valuation as a cash payment."}],["$","p","Make a timing budget as well as an annual budget. Identify payments needed before departure and when support becomes available. For research costs, dependants or a change of course, ask the appropriate office which rules apply and keep its response with your plan.",{"children":"Make a timing budget as well as an annual budget. Identify payments needed before departure and when support becomes available. For research costs, dependants or a change of course, ask the appropriate office which rules apply and keep its response with your plan."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.student-funding.cam.ac.uk/fund/gates-cambridge-scholarship-2026",{"children":["",["$","a",null,{"href":"https://www.student-funding.cam.ac.uk/fund/gates-cambridge-scholarship-2026","target":"_blank","rel":"noreferrer","children":"Official Gates funding scope in Cambridge's award record"}]]}]]]}],"$undefined"]}]
2c:["$","section","5-Before submitting for Gates consideration",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Before submitting for Gates consideration"}],[["$","p","Review the full course and funding application together. A form marked submitted can still have an outstanding reference or a required document that affects its completeness.",{"children":"Review the full course and funding application together. A form marked submitted can still have an outstanding reference or a required document that affects its completeness."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2e",null,{"id":"scholarships/gates-cambridge:section-6","title":"Check your progress","items":["I selected the correct citizenship/residence round.","I verified course eligibility for the intended award year.","I recorded the course funding deadline, not only admission closing.","My answers meet the current portal's questions and limits.","I checked academic and Gates-specific reference requirements.","All required references are complete by the funding deadline.","I saved the course and funding submission evidence."]}],"$undefined","$undefined"]}]
2d:["$","section","6-Check the submission, then save the evidence",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Check the submission, then save the evidence"}],[["$","p","A saved draft and a submitted application are different states. Reopen the application summary, inspect every attachment and check the referee indicators. Keep the confirmation email or reference number with the version of the instructions you used. Put any later transcript, offer-acceptance or enrolment task in a separate calendar entry.",{"children":"A saved draft and a submitted application are different states. Reopen the application summary, inspect every attachment and check the referee indicators. Keep the confirmation email or reference number with the version of the instructions you used. Put any later transcript, offer-acceptance or enrolment task in a separate calendar entry."}],["$","p","The tracker is an editable planning sheet, not an application form or eligibility assessment. Its suggested next actions belong to you; deadlines and requirements remain controlled by the institution. Replace the blank owner, internal deadline and confirmation fields with your own plan.",{"children":"The tracker is an editable planning sheet, not an application form or eligibility assessment. Its suggested next actions belong to you; deadlines and requirements remain controlled by the institution. Replace the blank owner, internal deadline and confirmation fields with your own plan."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Check the submission, then save the evidence","children":[["$","a","/downloads/scholarship-application-tracker-2027.csv",{"href":"/downloads/scholarship-application-tracker-2027.csv","download":true,"children":["Download the scholarship application tracker (CSV)",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/deadline-calendar/",{"href":"/deadline-calendar/","children":["Compare other scholarship deadlines",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
