23:["$","figure",null,{"className":"page-visual page-visual--inline","children":[["$","img",null,{"src":"/images/opportunities-20261024/cambridge-1280.webp","srcSet":"/images/opportunities-20261024/cambridge-640.webp 640w, /images/opportunities-20261024/cambridge-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Illustrative English riverside university courtyard with postgraduate students","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Illustrative scene; not a photograph of a named institution or programme participants."}]]}]
24:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Check course eligibility before writing the scholarship answers",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Check course eligibility before writing the scholarship answers"}],[["$","p","Use the Cambridge funding search entry for the award year and your intended course. The official international record describes master's and PhD funding for eligible applicants outside the UK and directs US citizens resident in the US to their separate round. Course mode and excluded qualifications require particular attention; a general postgraduate label does not make every course eligible.",{"children":"Use the Cambridge funding search entry for the award year and your intended course. The official international record describes master's and PhD funding for eligible applicants outside the UK and directs US citizens resident in the US to their separate round. Course mode and excluded qualifications require particular attention; a general postgraduate label does not make every course eligible."}],["$","p","Save the course title, code, start date and funding deadline in one place. For research degrees, follow the department's instructions on supervisor contact and research proposals. Being interested in Cambridge is not a substitute for explaining why the specific academic route fits your preparation.",{"children":"Save the course title, code, start date and funding deadline in one place. For research degrees, follow the department's instructions on supervisor contact and research proposals. Being interested in Cambridge is not a substitute for explaining why the specific academic route fits your preparation."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.student-funding.cam.ac.uk/fund/gates-cambridge-scholarship-2026",{"children":["",["$","a",null,{"href":"https://www.student-funding.cam.ac.uk/fund/gates-cambridge-scholarship-2026","target":"_blank","rel":"noreferrer","children":"Cambridge: Gates international award record for 2027/28"}]]}]]]}],"$undefined"]}],["$","section","2-Match your evidence to the selection criteria",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Match your evidence to the selection criteria"}],[["$","p","The official award record names academic excellence, reasons for the course, commitment to improving lives and leadership capacity. Build a small evidence bank before drafting. For each criterion, identify an actual event, your contribution and what you learned; avoid repeating the same broad claim in every answer.",{"children":"The official award record names academic excellence, reasons for the course, commitment to improving lives and leadership capacity. Build a small evidence bank before drafting. For each criterion, identify an actual event, your contribution and what you learned; avoid repeating the same broad claim in every answer."}],["$","p","The Applicant Portal controls the current questions and limits. Read those fields directly and preserve your own voice. A reference should help assess the scholarship criteria using evidence known to the referee, rather than merely repeat a transcript.",{"children":"The Applicant Portal controls the current questions and limits. Read those fields directly and preserve your own voice. A reference should help assess the scholarship criteria using evidence known to the referee, rather than merely repeat a transcript."}]],"$undefined","$L28","$undefined","$undefined","$undefined","$undefined","$undefined","$L29"]}],"$L2a","$L2b","$L2c","$L2d"]}]
