1f:["$","section","Choose one host route before requesting references",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Choose one host route before requesting references"}],[["$","p","The new 2027 CAS-ANSO call opened on 17 November 2026 and gives 28 February 2027 Beijing time as the deadline for applicants and referees. It expressly prohibits concurrent CAS-ANSO applications to both USTC and UCAS. Do not treat two host systems as harmless backup submissions under this scholarship.",{"children":"The new 2027 CAS-ANSO call opened on 17 November 2026 and gives 28 February 2027 Beijing time as the deadline for applicants and referees. It expressly prohibits concurrent CAS-ANSO applications to both USTC and UCAS. Do not treat two host systems as harmless backup submissions under this scholarship."}],["$","p","Use an original route-decision worksheet before inviting a referee. Record the chosen degree, academic match, university or institute arrangement and required application system. If you are still deciding between hosts, compare the evidence first and resolve the choice before making concurrent scholarship applications. An informal research-group conversation is not the same as a submitted scholarship application, but it also does not override the published restriction.",{"children":"Use an original route-decision worksheet before inviting a referee. Record the chosen degree, academic match, university or institute arrangement and required application system. If you are still deciding between hosts, compare the evidence first and resolve the choice before making concurrent scholarship applications. An informal research-group conversation is not the same as a submitted scholarship application, but it also does not override the published restriction."}],["$","p","Plan references as part of the same deadline dependency. A completed applicant form with an outstanding reference is not the whole evidence chain. Agree an earlier personal follow-up date, check the host’s instructions and keep submitted confirmations. The owner notice supplies a date and Beijing-time label; this guide does not invent a closing hour that the retrieved notice does not state. Read any later host clarification before setting an exact-time reminder.",{"children":"Plan references as part of the same deadline dependency. A completed applicant form with an outstanding reference is not the whole evidence chain. Agree an earlier personal follow-up date, check the host’s instructions and keep submitted confirmations. The owner notice supplies a date and Beijing-time label; this guide does not invent a closing hour that the retrieved notice does not state. Read any later host clarification before setting an exact-time reminder."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original one-host decision record","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original one-host decision record"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Field",{"scope":"col","children":"Field"}],["$","th","Record once chosen",{"scope":"col","children":"Record once chosen"}],["$","th","Unresolved state",{"scope":"col","children":"Unresolved state"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[["$L25","$L26","$L27"],"$undefined"]}],"$L28","$L29"]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$L2a","$undefined"]}]
20:["$","figure",null,{"className":"page-visual page-visual--inline","children":[["$","img",null,{"src":"/images/expansion-20261022/china-anso-1280.webp","srcSet":"/images/expansion-20261022/china-anso-640.webp 640w, /images/expansion-20261022/china-anso-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), (max-width: 1150px) calc(100vw - 64px), 760px","width":1280,"height":853,"alt":"Shanghai buildings reflected in the river at night","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Destination or study photograph; not a photograph of the named university or scholarship."}]]}]
21:["$","article",null,{"className":"article-body article-body--guide","children":[null,null,["$","section","2-USTC, UCAS and CAS: choose a route, not just a name",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"USTC, UCAS and CAS: choose a route, not just a name"}],[["$","p","The official degree call identifies USTC and UCAS, with CAS institutes participating through the relevant host arrangements. Choose a programme and supervisor route that matches your field, rather than selecting an institution solely because it appears in a scholarship list.",{"children":"The official degree call identifies USTC and UCAS, with CAS institutes participating through the relevant host arrangements. Choose a programme and supervisor route that matches your field, rather than selecting an institution solely because it appears in a scholarship list."}],["$","p","Admission requirements and application systems are set by the host. Read the host guide alongside the ANSO conditions. A CAS research group’s interest does not remove the need to complete formal university admission and funding steps.",{"children":"Admission requirements and application systems are set by the host. Read the host guide alongside the ANSO conditions. A CAS research group’s interest does not remove the need to complete formal university admission and funding steps."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Two official tracks to investigate","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Two official tracks to investigate"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Host route",{"scope":"col","children":"Host route"}],["$","th","Where to start",{"scope":"col","children":"Where to start"}],["$","th","Question to settle",{"scope":"col","children":"Question to settle"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"USTC"}],["$","td","1",{"children":"International College admissions and fellowship guide"}],["$","td","2",{"children":"Which programme and funding category match my degree?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"UCAS / relevant CAS institute"}],["$","td","1",{"children":"UCAS international admission and ANSO instructions"}],["$","td","2",{"children":"Which institute, supervisor and application procedure apply?"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for USTC, UCAS and CAS: choose a route, not just a name","children":[["$","$L5","/guides/ustc-scholarships-admissions/",{"href":"/guides/ustc-scholarships-admissions/","children":["USTC scholarships and admission",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],["$","section","3-Eligibility is a set of conditions, not just a good GPA",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Eligibility is a set of conditions, not just a good GPA"}],[["$","p","Compare your nationality, previous qualification, age or date-of-birth condition, language evidence and other restrictions against the current call. Use the actual wording and cutoff date; do not carry a previous year’s age threshold into a new intake without checking.",{"children":"Compare your nationality, previous qualification, age or date-of-birth condition, language evidence and other restrictions against the current call. Use the actual wording and cutoff date; do not carry a previous year’s age threshold into a new intake without checking."}],"$L2b"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L2c","$L2d","$L2e"]}]
