23:["$","p","The official degree call identifies USTC and UCAS, with CAS institutes participating through the relevant host arrangements. Choose a programme and supervisor route that matches your field, rather than selecting an institution solely because it appears in a scholarship list.",{"children":"The official degree call identifies USTC and UCAS, with CAS institutes participating through the relevant host arrangements. Choose a programme and supervisor route that matches your field, rather than selecting an institution solely because it appears in a scholarship list."}]
24:["$","p","Admission requirements and application systems are set by the host. Read the host guide alongside the ANSO conditions. A CAS research group’s interest does not remove the need to complete formal university admission and funding steps.",{"children":"Admission requirements and application systems are set by the host. Read the host guide alongside the ANSO conditions. A CAS research group’s interest does not remove the need to complete formal university admission and funding steps."}]
25:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Two official tracks to investigate","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Two official tracks to investigate"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Host route",{"scope":"col","children":"Host route"}],["$","th","Where to start",{"scope":"col","children":"Where to start"}],["$","th","Question to settle",{"scope":"col","children":"Question to settle"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"USTC"}],["$","td","1",{"children":"International College admissions and fellowship guide"}],["$","td","2",{"children":"Which programme and funding category match my degree?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"UCAS / relevant CAS institute"}],["$","td","1",{"children":"UCAS international admission and ANSO instructions"}],["$","td","2",{"children":"Which institute, supervisor and application procedure apply?"}]],"$undefined"]}]]}]]}]}],"$undefined"]
26:["$","nav",null,{"className":"answer-links","aria-label":"Next steps for USTC, UCAS and CAS: choose a route, not just a name","children":[["$","$L4","/guides/ustc-scholarships-admissions/",{"href":"/guides/ustc-scholarships-admissions/","children":["USTC scholarships and admission",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]
27:["$","section","2-Eligibility is a set of conditions, not just a good GPA",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Eligibility is a set of conditions, not just a good GPA"}],[["$","p","Compare your nationality, previous qualification, age or date-of-birth condition, language evidence and other restrictions against the current call. Use the actual wording and cutoff date; do not carry a previous year’s age threshold into a new intake without checking.",{"children":"Compare your nationality, previous qualification, age or date-of-birth condition, language evidence and other restrictions against the current call. Use the actual wording and cutoff date; do not carry a previous year’s age threshold into a new intake without checking."}],["$","p","If you are already studying in China or applying under another award, read any restrictions and compatibility clauses carefully. Prepare a list of unclear conditions and ask the responsible host office using your exact situation. Do not ask an agent to guess eligibility from a GPA alone.",{"children":"If you are already studying in China or applying under another award, read any restrictions and compatibility clauses carefully. Prepare a list of unclear conditions and ask the responsible host office using your exact situation. Do not ask an agent to guess eligibility from a GPA alone."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
28:["$","section","3-Research fit and the proposal",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Research fit and the proposal"}],[["$","p","A useful proposal explains the problem, why it matters, the method and why the host is suitable. Show that you understand the group’s actual work without copying its website into your statement. Keep the scope realistic for your intended degree.",{"children":"A useful proposal explains the problem, why it matters, the method and why the host is suitable. Show that you understand the group’s actual work without copying its website into your statement. Keep the scope realistic for your intended degree."}],["$","p","For supervisor contact, use the host’s instructions. Introduce your academic preparation, a concise research interest and the relevant attachment if requested. An unanswered email is not an official rejection, while a positive reply is not a scholarship award.",{"children":"For supervisor contact, use the host’s instructions. Introduce your academic preparation, a concise research interest and the relevant attachment if requested. An unanswered email is not an official rejection, while a positive reply is not a scholarship award."}]],["$","ol",null,{"className":"process-steps","aria-label":"Research fit and the proposal","children":[["$","li","Identify the field and a realistic research question",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Identify the field and a realistic research question"}]]}],["$","li","Check host programmes and relevant supervisors",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Check host programmes and relevant supervisors"}]]}],["$","li","Read contact or acceptance-letter instructions",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Read contact or acceptance-letter instructions"}]]}],["$","li","Draft a proposal linked to available expertise",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Draft a proposal linked to available expertise"}]]}],["$","li","Prepare references and submit through the formal route",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Prepare references and submit through the formal route"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","4-Funding and what you should verify in writing",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Funding and what you should verify in writing"}],[["$","p","Read the package under the exact call and host route. Separate tuition support, stipend, insurance, travel and accommodation rather than applying the phrase “fully funded” to every possible cost. Check the award duration and the academic review needed for continuation.",{"children":"Read the package under the exact call and host route. Separate tuition support, stipend, insurance, travel and accommodation rather than applying the phrase “fully funded” to every possible cost. Check the award duration and the academic review needed for continuation."}],["$","p","Housing is particularly easy to misunderstand: a stipend or tuition waiver does not establish that a residence room is free. Confirm housing charges, availability and deductions with the host and award letter before calculating the remaining budget.",{"children":"Housing is particularly easy to misunderstand: a stipend or tuition waiver does not establish that a residence room is free. Confirm housing charges, availability and deductions with the host and award letter before calculating the remaining budget."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2e",null,{"id":"scholarships/cas-anso:section-5","title":"Check your progress","items":["Current cycle and deadline verified","Host and degree selected","Eligibility checked against exact cutoff dates","Funding components and continuation conditions recorded","Housing and arrival expenses checked independently"]}],"$undefined","$undefined"]}]
2a:["$","section","5-Submission and later decisions",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Submission and later decisions"}],[["$","p","Follow both the scholarship and host instructions for the systems and selections required. Save final submission records and the research materials you sent. If the host requests an interview or additional evidence, use the official channel and respond within the stated time.",{"children":"Follow both the scholarship and host instructions for the systems and selections required. Save final submission records and the research materials you sent. If the host requests an interview or additional evidence, use the official channel and respond within the stated time."}],["$","p","Do not accept a paid promise of selection. Final admission, scholarship decisions and visa assessment belong to different authorities. After an award, read the host’s enrolment and arrival conditions before making non-refundable arrangements.",{"children":"Do not accept a paid promise of selection. Final admission, scholarship decisions and visa assessment belong to different authorities. After an award, read the host’s enrolment and arrival conditions before making non-refundable arrangements."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Submission and later decisions","children":[["$","$L4","/guides/china-student-visa-x1-x2/",{"href":"/guides/china-student-visa-x1-x2/","children":["China visa documents and arrival tasks",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/china-tuition-fees-living-costs/",{"href":"/guides/china-tuition-fees-living-costs/","children":["China cost planning",["$","$L5",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
