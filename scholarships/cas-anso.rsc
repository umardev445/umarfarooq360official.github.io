21:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"The published CAS-ANSO degree programme supports master’s and doctoral study through USTC, UCAS and relevant CAS institutions. Use the current call and host instructions together; do not assume a new cycle is open because an older call remains online."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose the degree and host route, read the current ANSO eligibility conditions, then match a suitable programme or research group."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Published call and current application status",{"href":"#section-1","children":"Published call and current application status"}],["$","a","USTC, UCAS and CAS: choose a route, not just a name",{"href":"#section-2","children":"USTC, UCAS and CAS: choose a route, not just a name"}],["$","a","Eligibility is a set of conditions, not just a good GPA",{"href":"#section-3","children":"Eligibility is a set of conditions, not just a good GPA"}],["$","a","Research fit and the proposal",{"href":"#section-4","children":"Research fit and the proposal"}],["$","a","Funding and what you should verify in writing",{"href":"#section-5","children":"Funding and what you should verify in writing"}],["$","a","Submission and later decisions",{"href":"#section-6","children":"Submission and later decisions"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Published call and current application status",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Published call and current application status"}],[["$","p","The official call reviewed is labelled the 2026 CAS-ANSO degree scholarship and was published on 15 October 2025. It is an earlier-cycle reference, not proof that a 2027 round is accepting applications. Check the ANSO programme page and the host’s newest notice for a later call.",{"children":"The official call reviewed is labelled the 2026 CAS-ANSO degree scholarship and was published on 15 October 2025. It is an earlier-cycle reference, not proof that a 2027 round is accepting applications. Check the ANSO programme page and the host’s newest notice for a later call."}],["$","p","If you are preparing before a new call appears, work on academic fit, transcripts and research planning without claiming an unannounced deadline. Already selected candidates should follow the host’s award and arrival instructions rather than an old application article.",{"children":"If you are preparing before a new call appears, work on academic fit, transcripts and research planning without claiming an unannounced deadline. Already selected candidates should follow the host’s award and arrival instructions rather than an old application article."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","1-USTC, UCAS and CAS: choose a route, not just a name",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"USTC, UCAS and CAS: choose a route, not just a name"}],["$L23","