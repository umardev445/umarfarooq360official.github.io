2a:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.anso.org.cn/programmes/talent/scholarship/202611/t20261117_865081.html",{"children":["",["$","a",null,{"href":"https://www.anso.org.cn/programmes/talent/scholarship/202611/t20261117_865081.html","target":"_blank","rel":"noreferrer","children":"CAS-ANSO:2027 degree scholarship call"}]]}]]]}]
2b:["$","p","If you are already studying in China or applying under another award, read any restrictions and compatibility clauses carefully. Prepare a list of unclear conditions and ask the responsible host office using your exact situation. Do not ask an agent to guess eligibility from a GPA alone.",{"children":"If you are already studying in China or applying under another award, read any restrictions and compatibility clauses carefully. Prepare a list of unclear conditions and ask the responsible host office using your exact situation. Do not ask an agent to guess eligibility from a GPA alone."}]
2c:["$","section","4-Research fit and the proposal",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Research fit and the proposal"}],[["$","p","A useful proposal explains the problem, why it matters, the method and why the host is suitable. Show that you understand the group’s actual work without copying its website into your statement. Keep the scope realistic for your intended degree.",{"children":"A useful proposal explains the problem, why it matters, the method and why the host is suitable. Show that you understand the group’s actual work without copying its website into your statement. Keep the scope realistic for your intended degree."}],["$","p","For supervisor contact, use the host’s instructions. Introduce your academic preparation, a concise research interest and the relevant attachment if requested. An unanswered email is not an official rejection, while a positive reply is not a scholarship award.",{"children":"For supervisor contact, use the host’s instructions. Introduce your academic preparation, a concise research interest and the relevant attachment if requested. An unanswered email is not an official rejection, while a positive reply is not a scholarship award."}]],["$","ol",null,{"className":"process-steps","aria-label":"Research fit and the proposal","children":[["$","li","Identify the field and a realistic research question",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Identify the field and a realistic research question"}]]}],["$","li","Check host programmes and relevant supervisors",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Check host programmes and relevant supervisors"}]]}],["$","li","Read contact or acceptance-letter instructions",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Read contact or acceptance-letter instructions"}]]}],["$","li","Draft a proposal linked to available expertise",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Draft a proposal linked to available expertise"}]]}],["$","li","Prepare references and submit through the formal route",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Prepare references and submit through the formal route"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2d:["$","section","5-Funding and what you should verify in writing",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Funding and what you should verify in writing"}],[["$","p","Read the package under the exact call and host route. Separate tuition support, stipend, insurance, travel and accommodation rather than applying the phrase “fully funded” to every possible cost. Check the award duration and the academic review needed for continuation.",{"children":"Read the package under the exact call and host route. Separate tuition support, stipend, insurance, travel and accommodation rather than applying the phrase “fully funded” to every possible cost. Check the award duration and the academic review needed for continuation."}],["$","p","Housing is particularly easy to misunderstand: a stipend or tuition waiver does not establish that a residence room is free. Confirm housing charges, availability and deductions with the host and award letter before calculating the remaining budget.",{"children":"Housing is particularly easy to misunderstand: a stipend or tuition waiver does not establish that a residence room is free. Confirm housing charges, availability and deductions with the host and award letter before calculating the remaining budget."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2f",null,{"id":"scholarships/cas-anso:section-6","title":"Check your progress","items":["Current cycle and deadline verified","Host and degree selected","Eligibility checked against exact cutoff dates","Funding components and continuation conditions recorded","Housing and arrival expenses checked independently"]}],"$undefined","$undefined"]}]
2e:["$","section","6-Submission and later decisions",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Submission and later decisions"}],[["$","p","Follow both the scholarship and host instructions for the systems and selections required. Save final submission records and the research materials you sent. If the host requests an interview or additional evidence, use the official channel and respond within the stated time.",{"children":"Follow both the scholarship and host instructions for the systems and selections required. Save final submission records and the research materials you sent. If the host requests an interview or additional evidence, use the official channel and respond within the stated time."}],["$","p","Do not accept a paid promise of selection. Final admission, scholarship decisions and visa assessment belong to different authorities. After an award, read the host’s enrolment and arrival conditions before making non-refundable arrangements.",{"children":"Do not accept a paid promise of selection. Final admission, scholarship decisions and visa assessment belong to different authorities. After an award, read the host’s enrolment and arrival conditions before making non-refundable arrangements."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Submission and later decisions","children":[["$","$L5","/guides/china-student-visa-x1-x2/",{"href":"/guides/china-student-visa-x1-x2/","children":["China visa documents and arrival tasks",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/china-tuition-fees-living-costs/",{"href":"/guides/china-tuition-fees-living-costs/","children":["China cost planning",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
