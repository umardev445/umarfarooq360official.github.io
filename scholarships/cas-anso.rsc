1d:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"The 2027 CAS-ANSO degree scholarship call is published and open. Applicants and referees share a 28 February 2027 Beijing-time deadline. Choose one USTC or UCAS host route; concurrent CAS-ANSO applications to both are prohibited."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Check the current 2027 call and host requirements, resolve the host choice and plan reference submission before the common date."]}],"$undefined"]}],false,false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Published call and current application status",{"href":"#section-1","children":"Published call and current application status"}],["$","a","Choose one host route before requesting references",{"href":"#section-2","children":"Choose one host route before requesting references"}],["$","a","USTC, UCAS and CAS: choose a route, not just a name",{"href":"#section-3","children":"USTC, UCAS and CAS: choose a route, not just a name"}],["$","a","Eligibility is a set of conditions, not just a good GPA",{"href":"#section-4","children":"Eligibility is a set of conditions, not just a good GPA"}],["$","a","Research fit and the proposal",{"href":"#section-5","children":"Research fit and the proposal"}],["$","a","Funding and what you should verify in writing",{"href":"#section-6","children":"Funding and what you should verify in writing"}],["$","a","Submission and later decisions",{"href":"#section-7","children":"Submission and later decisions"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Published call and current application status",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Published call and current application status"}],[["$","p","The official 2027 CAS-ANSO degree scholarship call was published on 17 November 2026 and is open for applications. It lists 28 February 2027 Beijing time as the deadline for applicants and referees. Use the current host instructions alongside this call; no exact closing hour is inferred here.",{"children":"The official 2027 CAS-ANSO degree scholarship call was published on 17 November 2026 and is open for applications. It lists 28 February 2027 Beijing time as the deadline for applicants and referees. Use the current host instructions alongside this call; no exact closing hour is inferred here."}],["$","p","Choose the degree and one host route, check the current eligibility conditions and prepare the required academic and reference evidence. The 2027 call prohibits concurrent CAS-ANSO applications to both USTC and UCAS; follow that restriction rather than submitting a second scholarship file as a backup.",{"children":"Choose the degree and one host route, check the current eligibility conditions and prepare the required academic and reference evidence. The 2027 call prohibits concurrent CAS-ANSO applications to both USTC and UCAS; follow that restriction rather than submitting a second scholarship file as a backup."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1f"]