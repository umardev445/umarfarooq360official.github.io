18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"The current Rhodes round is closed. The Trust says applications reopen in 2027 for Oxford entry in 2028; eligibility and application arrangements depend on the constituency."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Use the official checker and your constituency page, then research eligible Oxford courses and potential referees."]}],"$undefined"]}],false,false,["$","$L1a",null,{"records":[{"id":"rhodes-2027","title":"Rhodes Scholarship 2027","provider":"Rhodes Trust","type":"Scholarship","level":"Graduate","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"2027-entry round closed; next applications reopen in 2027 for 2028 entry","status":"Closed","summary":"Applications are closed. Prepare by constituency and eligible Oxford course; future-cycle exact dates must come from the next official call.","tags":["Oxford","Postgraduate","Leadership"],"source":"https://www.rhodeshouse.ox.ac.uk/scholarships/the-rhodes-scholarship/","sourceLabel":"Rhodes Trust: current application status","checked":"24 October 2026","featured":false}]}],["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Current status: applications are closed",{"href":"#section-1","children":"Current status: applications are closed"}],["$","a","Your constituency decides the detailed eligibility check",{"href":"#section-2","children":"Your constituency decides the detailed eligibility check"}],["$","a","Choose a course you can justify",{"href":"#section-3","children":"Choose a course you can justify"}],["$","a","Understand what the scholarship pays for",{"href":"#section-4","children":"Understand what the scholarship pays for"}],["$","a","Collect evidence of responsibility, service and learning",{"href":"#section-5","children":"Collect evidence of responsibility, service and learning"}],["$","a","Ask referees who know the relevant work",{"href":"#section-6","children":"Ask referees who know the relevant work"}],["$","a","Keep the application truthful and internally consistent",{"href":"#section-7","children":"Keep the application truthful and internally consistent"}],["$","a","Prepare for discussion, not a memorised performance",{"href":"#section-8","children":"Prepare for discussion, not a memorised performance"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Current status: applications are closed",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Current status: applications are closed"}],[["$","p","Checked 24 October 2026: the Rhodes Trust says applications are closed and will reopen in 2027 for entry to Oxford in 2028. Do not mistake an old article announcing the 2027-entry round for a current invitation to apply. A future opening month or deadline should not be inferred from last year.",{"children":"Checked 24 October 2026: the Rhodes Trust says applications are closed and will reopen in 2027 for entry to Oxford in 2028. Do not mistake an old article announcing the 2027-entry round for a current invitation to apply. A future opening month or deadline should not be inferred from last year."}],"$L1b"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],false,"$L23","$L24"]}],"$L25"]}]
19:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","countries/united-kingdom",{"href":"/countries/united-kingdom/","children":[["$","span",null,{"children":"Destination guide"}],["$","h3",null,{"children":"UK scholarships for international students"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","scholarships/masters",{"href":"/scholarships/masters/","children":[["$","span",null,{"children":"Postgraduate funding"}],["$","h3",null,{"children":"Master's scholarships for international students"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/recommendation-letter",{"href":"/guides/recommendation-letter/","children":[["$","span",null,{"children":"Reference guide"}],["$","h3",null,{"children":"How to get strong scholarship recommendation letters"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/scholarship-interview",{"href":"/guides/scholarship-interview/","children":[["$","span",null,{"children":"Interview guide"}],["$","h3",null,{"children":"How to prepare for a scholarship interview"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
1b:["$","p","Use the closed period to research courses, understand constituency eligibility and prepare potential referees. If you applied in the previous round, follow your existing application communications rather than starting a new form from an outdated link.",{"children":"Use the closed period to research courses, understand constituency eligibility and prepare potential referees. If you applied in the previous round, follow your existing application communications rather than starting a new form from an outdated link."}]
1c:["$","section","1-Your constituency decides the detailed eligibility check",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Your constituency decides the detailed eligibility check"}],[["$","p","Use the official eligibility checker and constituency information. Citizenship, residence or other connections, age, education and application arrangements can interact. One country’s age limit or document list is not a universal Rhodes requirement.",{"children":"Use the official eligibility checker and constituency information. Citizenship, residence or other connections, age, education and application arrangements can interact. One country’s age limit or document list is not a universal Rhodes requirement."}],["$","p","For Pakistani applicants, begin with the Trust’s Pakistan page and the current constituency guidance. If more than one route might appear relevant, ask the Trust which one applies instead of selecting whichever deadline is later.",{"children":"For Pakistani applicants, begin with the Trust’s Pakistan page and the current constituency guidance. If more than one route might appear relevant, ask the Trust which one applies instead of selecting whichever deadline is later."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Before drafting a Rhodes application","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Before drafting a Rhodes application"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Check",{"scope":"col","children":"Check"}],["$","th","Evidence to locate",{"scope":"col","children":"Evidence to locate"}],["$","th","Avoid this assumption",{"scope":"col","children":"Avoid this assumption"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Constituency"}],["$","td","1",{"children":"Official checker and country guidance"}],["$","td","2",{"children":"Every applicant uses the same route"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Age / dates"}],["$","td","1",{"children":"The actual birth-date or age rule for the call"}],["$","td","2",{"children":"A generic internet age limit decides eligibility"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Education"}],["$","td","1",{"children":"Degree completion and academic conditions"}],["$","td","2",{"children":"Any completed bachelor’s degree is enough"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Course"}],["$","td","1",{"children":"Oxford course and Conditions of Tenure"}],["$","td","2",{"children":"All Oxford courses or combinations are eligible"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","2-Choose a course you can justify",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Choose a course you can justify"}],[["$","p","Read the course curriculum, entry requirements and research expectations. Where a proposed combination of degrees is involved, check the Conditions of Tenure rather than assuming the scholarship funds any sequence. Make a shortlist with the academic reason for each choice.",{"children":"Read the course curriculum, entry requirements and research expectations. Where a proposed combination of degrees is involved, check the Conditions of Tenure rather than assuming the scholarship funds any sequence. Make a shortlist with the academic reason for each choice."}],["$","p","Your reason should survive removal of the Oxford name. Which training or research opportunity fits your preparation? What could you do with that knowledge afterwards? These questions turn general ambition into a defensible plan, while the university still decides admission.",{"children":"Your reason should survive removal of the Oxford name. Which training or research opportunity fits your preparation? What could you do with that knowledge afterwards? These questions turn general ambition into a defensible plan, while the university still decides admission."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","3-Understand what the scholarship pays for",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Understand what the scholarship pays for"}],[["$","p","The Trust describes course fees and a living stipend, with additional specified application, immigration and travel support. Its published stipend figure names an academic year; it is not a guaranteed amount for a future cohort. Accommodation is paid from living support rather than being a universal separate free-housing benefit.",{"children":"The Trust describes course fees and a living stipend, with additional specified application, immigration and travel support. Its published stipend figure names an academic year; it is not a guaranteed amount for a future cohort. Accommodation is paid from living support rather than being a universal separate free-housing benefit."}],["$","p","Build a budget around the current award terms when the next call is published. Confirm any dependant needs and unusual course costs individually. A prestigious scholarship can still have limits that matter to your household; resolve them before accepting an offer.",{"children":"Build a budget around the current award terms when the next call is published. Confirm any dependant needs and unusual course costs individually. A prestigious scholarship can still have limits that matter to your household; resolve them before accepting an offer."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","4-Collect evidence of responsibility, service and learning",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Collect evidence of responsibility, service and learning"}],[["$","p","Create a working record of genuine examples from study, employment, volunteering or community responsibilities. For each, write the problem, your role, the action, the outcome and what you learned. Measured outcomes are useful only when you can explain how they were measured.",{"children":"Create a working record of genuine examples from study, employment, volunteering or community responsibilities. For each, write the problem, your role, the action, the outcome and what you learned. Measured outcomes are useful only when you can explain how they were measured."}],["$","p","Do not inflate an ordinary responsibility into a national impact claim. Selection readers can ask detailed questions. Honest reflection on a small project often says more about judgement than unsupported adjectives.",{"children":"Do not inflate an ordinary responsibility into a national impact claim. Selection readers can ask detailed questions. Honest reflection on a small project often says more about judgement than unsupported adjectives."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"A responsibility record"}],[["$","p","0",{"children":"I coordinated weekly peer-study sessions for a difficult module. Attendance varied, so I asked classmates which topics were useful and changed the session format. I can describe what improved in the sessions, but I cannot claim that I caused everyone’s final grades."}]],["$","p",null,{"className":"sample-card__note","children":"Fictional example for preparation, not a Rhodes-winning response or official selection formula."}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","5-Ask referees who know the relevant work",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Ask referees who know the relevant work"}],[["$","p","Map each potential referee to something they have directly observed: academic reasoning, reliability, collaboration or service. Follow the number, category and submission rules of your actual constituency call. A generic reference written for another scholarship may not meet them.",{"children":"Map each potential referee to something they have directly observed: academic reasoning, reliability, collaboration or service. Follow the number, category and submission rules of your actual constituency call. A generic reference written for another scholarship may not meet them."}],["$","p","Give referees time and a compact pack containing your course choices, CV, the official guidance and a reminder of work they supervised. Ask whether they can provide a strong and specific reference. Allow them to decline rather than assuming a title guarantees an endorsement.",{"children":"Give referees time and a compact pack containing your course choices, CV, the official guidance and a reminder of work they supervised. Ask whether they can provide a strong and specific reference. Allow them to decline rather than assuming a title guarantees an endorsement."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","6-Keep the application truthful and internally consistent",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Keep the application truthful and internally consistent"}],[["$","p","When the next form is available, copy its exact requirements into a checklist before drafting. Check the rules on assistance, personal statements and declarations. A preparation guide does not override the Trust’s instructions on how your work must be produced.",{"children":"When the next form is available, copy its exact requirements into a checklist before drafting. Check the rules on assistance, personal statements and declarations. A preparation guide does not override the Trust’s instructions on how your work must be produced."}],["$","p","Compare dates, activity descriptions and claims across the CV, statements and references. Remove statements you cannot support. Do not promise a particular leadership outcome or use someone else’s story because it sounds impressive.",{"children":"Compare dates, activity descriptions and claims across the CV, statements and references. Remove statements you cannot support. Do not promise a particular leadership outcome or use someone else’s story because it sounds impressive."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","7-Prepare for discussion, not a memorised performance",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Prepare for discussion, not a memorised performance"}],[["$","p","A useful preparation exercise is to explain a course choice, an ethical difficulty and a limitation in your own work without notes. Ask a trusted person to question the assumptions behind your answer. If you do not know something, practise saying what you would need to find out.",{"children":"A useful preparation exercise is to explain a course choice, an ethical difficulty and a limitation in your own work without notes. Ask a trusted person to question the assumptions behind your answer. If you do not know something, practise saying what you would need to find out."}],["$","p","Keep other funding routes active. Rhodes is highly selective; preparing a strong application is not a reason to abandon academically suitable alternatives. Your next step while the round is closed is a verified eligibility and course shortlist.",{"children":"Keep other funding routes active. Rhodes is highly selective; preparing a strong application is not a reason to abandon academically suitable alternatives. Your next step while the round is closed is a verified eligibility and course shortlist."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Prepare for discussion, not a memorised performance","children":[["$","$L4","https://www.rhodeshouse.ox.ac.uk/scholarships/applying-for-the-scholarship/",{"href":"https://www.rhodeshouse.ox.ac.uk/scholarships/applying-for-the-scholarship/","children":["Official Rhodes eligibility checker",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/masters/",{"href":"/scholarships/masters/","children":["Compare postgraduate funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
23:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://www.rhodeshouse.ox.ac.uk/scholarships/the-rhodes-scholarship/",{"href":"https://www.rhodeshouse.ox.ac.uk/scholarships/the-rhodes-scholarship/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Rhodes Trust: current status and funding"}],["$","span",null,{"children":"Official guidance checked 24 October 2026; the live programme instructions take precedence."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://www.rhodeshouse.ox.ac.uk/scholarships/applications/pakistan/",{"href":"https://www.rhodeshouse.ox.ac.uk/scholarships/applications/pakistan/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Rhodes Pakistan constituency"}],["$","span",null,{"children":"Official guidance checked 24 October 2026; the live programme instructions take precedence."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$23:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://www.rhodeshouse.ox.ac.uk/scholarships/applying-for-the-scholarship/",{"href":"https://www.rhodeshouse.ox.ac.uk/scholarships/applying-for-the-scholarship/","target":"_bl