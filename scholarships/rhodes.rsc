24:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is Rhodes open now?",{"children":[["$","summary",null,{"children":["Is Rhodes open now?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The Trust page checked on 24 October 2026 says closed. It directs prospective applicants to the next reopening in 2027 for 2028 entry."}]]}],["$","details","Is there one Rhodes age limit?",{"children":[["$","summary",null,{"children":["Is there one Rhodes age limit?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No single number should be applied to all constituencies. Use the current official checker and your country’s published conditions."}]]}],["$","details","Is accommodation a separate free benefit?",{"children":[["$","summary",null,{"children":["Is accommodation a separate free benefit?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The Trust describes a living stipend from which scholars pay living costs, including accommodation. Use the actual award terms for your cohort."}]]}]]}]]}]
