25:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is the OIST PhD application free?",{"children":[["$","summary",null,{"children":["Is the OIST PhD application free?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The current official PhD page lists a non-refundable ¥5,000 application fee. This is separate from the funding provided after admission."}]]}],["$","details","Can a bachelor's graduate apply directly to OIST's PhD?",{"children":[["$","summary",null,{"children":["Can a bachelor's graduate apply directly to OIST's PhD?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes, the published route accepts a completed bachelor's, master's or equivalent qualification before admission. Academic fit and competitive selection still apply."}]]}],["$","details","Do I need a professor's acceptance before applying?",{"children":[["$","summary",null,{"children":["Do I need a professor's acceptance before applying?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"OIST asks applicants to identify faculty of interest but admits to the programme. Its FAQ advises against contacting faculty to obtain approval or support before applying; follow the central admissions process."}]]}],["$","details","What is the OIST deadline in Pakistan?",{"children":[["$","summary",null,{"children":["What is the OIST deadline in Pakistan?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"15 November 2026 at 23:59 JST converts to 15 November at 19:59 Pakistan Standard Time. Complete the submission and reference requirements before that time."}]]}]]}]]}]
