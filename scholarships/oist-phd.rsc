21:["$","div",null,{"className":"article-body","children":[["$","section","OIST PhD 2027: deadline, fee and selection route",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"OIST PhD 2027: deadline, fee and selection route"}],[["$","p","Start with the degree route and research fit. Funding supports admitted PhD students, but it does not remove the selection process or the application charge.",{"children":"Start with the degree route and research fit. Funding supports admitted PhD students, but it does not remove the selection process or the application charge."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"What to plan for the current OIST doctoral round","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"What to plan for the current OIST doctoral round"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Item",{"scope":"col","children":"Item"}],["$","th","Published position",{"scope":"col","children":"Published position"}],["$","th","Planning consequence",{"scope":"col","children":"Planning consequence"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Deadline"}],["$","td","1",{"children":"15 November 2026, 23:59 JST"}],["$","td","2",{"children":"Finish before your local equivalent of the closing time"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Application fee"}],["$","td","1",{"children":"¥5,000; non-refundable"}],["$","td","2",{"children":"Budget for payment before relying on submission"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"References"}],["$","td","1",{"children":"Two to five; at least two received before submission"}],["$","td","2",{"children":"Follow the PhD rules for professorial-level referees"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Workshop"}],["$","td","1",{"children":"Online, 18 January–7 February 2027"}],["$","td","2",{"children":"Keep the interview period available if shortlisted"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Enrolment options"}],["$","td","1",{"children":"1 May 2027, 1 September 2027 or 1 January 2028"}],["$","td","2",{"children":"Match graduation to the actual start you request"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://www.oist.jp/admissions/phd-program/apply-phd","target":"_blank","rel":"noreferrer","children":"OIST PhD application and selection schedule"}]]}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]]}]
22:["$","figure",null,{"className":"page-visual page-visual--inline","children":[["$","img",null,{"src":"/images/design/es/research-1280.webp","srcSet":"/images/design/es/research-640.webp 640w, /images/design/es/research-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Two students discussing charts on a laptop in an illustrative academic workspace","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Illustrative research scene; not a photograph of the named university or scholarship recipients."}]]}]
23:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Eligibility and English-language evidence",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Eligibility and English-language evidence"}],[["$","p","A bachelor's, master's or equivalent qualification must be completed before admission. OIST admits to the programme rather than promising a place in a named professor's unit. Read the available research areas and explain why the programme's approach fits the work you want to learn.",{"children":"A bachelor's, master's or equivalent qualification must be completed before admission. OIST admits to the programme rather than promising a place in a named professor's unit. Read the available research areas and explain why the programme's approach fits the work you want to learn."}],["$","p","The official FAQ permits evidence of English-medium education for the language-test exemption. Other applicants should follow the PhD page's TOEFL or IELTS instructions. Do not infer a waiver from nationality, or import the research internship's English-test rules into this degree application.",{"children":"The official FAQ permits evidence of English-medium education for the language-test exemption. Other applicants should follow the PhD page's TOEFL or IELTS instructions. Do not infer a waiver from nationality, or import the research internship's English-test rules into this degree application."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.oist.jp/admissions/phd-program/apply-phd",{"children":["",["$","a",null,{"href":"https://www.oist.jp/admissions/phd-program/apply-phd","target":"_blank","rel":"noreferrer","children":"OIST PhD eligibility"}]]}],["$","span","https://www.oist.jp/admissions/faq",{"children":[" · ",["$","a",null,{"href":"https://www.oist.jp/admissions/faq","target":"_blank","rel":"noreferrer","children":"OIST FAQ: English-medium evidence and faculty selection"}]]}]]]}],"$undefined"]}],["$","section","2-Funding does not mean every upfront expense disappears",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Funding does not mean every upfront expense disappears"}],[["$","p","OIST describes its five-year PhD as fully funded and its FAQ explains support through a research assistantship. The same FAQ says students cannot take outside part-time work. Use the offer and current terms to evaluate your own living arrangements, rather than planning to close an unknown budget gap with another job.",{"children":"OIST describes its five-year PhD as fully funded and its FAQ explains support through a research assistantship. The same FAQ says students cannot take outside part-time work. Use the offer and current terms to evaluate your own living arrangements, rather than planning to close an unknown budget gap with another job."}],["$","p","List the application charge, document preparation and any expenses incurred before support begins. For each cost, distinguish an included benefit, a later reimbursement and a payment you must make yourself. The current PhD application page states that personal financial circumstances do not qualify for a fee waiver; use OIST's contact instructions if sanctions prevent payment.",{"children":"List the application charge, document preparation and any expenses incurred before support begins. For each cost, distinguish an included benefit, a later reimbursement and a payment you must make yourself. The current PhD application page states that personal financial circumstances do not qualify for a fee waiver; use OIST's contact instructions if sanctions prevent payment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$L27","$undefined"]}],"$L28","$L29","$L2a","$L2b"]}]
