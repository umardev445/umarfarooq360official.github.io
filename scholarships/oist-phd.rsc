1a:T4c4,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is the OIST PhD application free?","acceptedAnswer":{"@type":"Answer","text":"No. The current official PhD page lists a non-refundable ¥5,000 application fee. This is separate from the funding provided after admission."}},{"@type":"Question","name":"Can a bachelor's graduate apply directly to OIST's PhD?","acceptedAnswer":{"@type":"Answer","text":"Yes, the published route accepts a completed bachelor's, master's or equivalent qualification before admission. Academic fit and competitive selection still apply."}},{"@type":"Question","name":"Do I need a professor's acceptance before applying?","acceptedAnswer":{"@type":"Answer","text":"OIST asks applicants to identify faculty of interest but admits to the programme. Its FAQ advises against contacting faculty to obtain approval or support before applying; follow the central admissions process."}},{"@type":"Question","name":"What is the OIST deadline in Pakistan?","acceptedAnswer":{"@type":"Answer","text":"15 November 2026 at 23:59 JST converts to 15 November at 19:59 Pakistan Standard Time. Complete the submission and reference requirements before that time."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page scholarship-release editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/scholarships/oist-phd/\",\"name\":\"OIST PhD Scholarship 2027: funding and application guide\",\"description\":\"Plan your OIST PhD application for 2027: 15 November deadline, ¥5,000 application fee, reference requirements, English evidence and research fit.\",\"url\":\"https://aspirecompass.org/scholarships/oist-phd/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-11-03\",\"dateModified\":\"2026-11-03\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"