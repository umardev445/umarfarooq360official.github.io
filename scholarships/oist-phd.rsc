28:["$","section","3-Prepare a research-fit statement you can discuss",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Prepare a research-fit statement you can discuss"}],[["$","p","Choose a research question you understand well enough to explain without slides. Connect a past project to a question you now want to investigate, then identify the methods or training you lack. A list of famous laboratories does less work than a clear connection between the question and the programme.",{"children":"Choose a research question you understand well enough to explain without slides. Connect a past project to a question you now want to investigate, then identify the methods or training you lack. A list of famous laboratories does less work than a clear connection between the question and the programme."}],["$","p","The published statement instructions list both 800 words and 3,000 English characters. Check the live form and satisfy both limits; do not assume that a document under the word count will fit into a character-limited field. Keep optional publications and test results separate from required evidence.",{"children":"The published statement instructions list both 800 words and 3,000 English characters. Check the live form and satisfy both limits; do not assume that a document under the word count will fit into a character-limited field. Keep optional publications and test results separate from required evidence."}]],"$undefined","$undefined",["$","div",null,{"className":"sample-card","children":[["$","span",null,{"className":"sample-card__label","children":"Teaching example"}],["$","h3",null,{"children":"A research-fit planning prompt"}],[["$","p","0",{"children":"In [your actual project], I investigated [question] using [method]. The result left [specific limitation]. I now want to learn [approach] to examine [next question], and have identified [relevant OIST research area] as a possible training fit."}]],["$","p",null,{"className":"sample-card__note","children":"Original planning scaffold. Replace the brackets with your own work; this is not an accepted statement or a promise of admission."}]]}],"$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Prepare a research-fit statement you can discuss","children":[["$","$L5","/guides/statement-of-purpose/",{"href":"/guides/statement-of-purpose/","children":["Develop your statement of purpose",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
29:["$","section","4-Reference and submission workflow",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Reference and submission workflow"}],[["$","p","Use referees who can discuss the research ability they have observed. Follow the current rules on eligible recommenders and direct system submission. Being able to upload your CV does not mean the reference dependency has been satisfied.",{"children":"Use referees who can discuss the research ability they have observed. Follow the current rules on eligible recommenders and direct system submission. Being able to upload your CV does not mean the reference dependency has been satisfied."}]],["$","ol",null,{"className":"process-steps","aria-label":"Reference and submission workflow","children":[["$","li","Check degree timing and identify relevant faculty from the programme's published research information.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Check degree timing and identify relevant faculty from the programme's published research information."}]]}],["$","li","Create the PhD application and send eligible referees their system invitations.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Create the PhD application and send eligible referees their system invitations."}]]}],["$","li","Prepare the academic record, statement, CV, language evidence and identification.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Prepare the academic record, statement, CV, language evidence and identification."}]]}],["$","li","Check receipt of at least two references, the live form limits and payment instructions.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Check receipt of at least two references, the live form limits and payment instructions."}]]}],["$","li","Review the complete application, submit and retain the confirmation.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Review the complete application, submit and retain the confirmation."}]]}]]}],"$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"A fictional final-year applicant expects to graduate in June 2027. They should not select May enrolment on that assumption. They can investigate the September or January options and provide accurate expected-completion evidence, subject to OIST accepting their qualification and timing."}]]}],"$undefined","$undefined","$undefined","$undefined"]}]
2a:["$","section","5-Final OIST application checklist",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Final OIST application checklist"}],[["$","p","Use this check after reading the current form. Keep the interview invitation separate from an offer of admission.",{"children":"Use this check after reading the current form. Keep the interview invitation separate from an offer of admission."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2c",null,{"id":"scholarships/oist-phd:section-6","title":"Check your progress","items":["I selected the PhD route, not the research internship.","My expected degree completion fits the requested enrolment date.","My statement fits the live form's word and character limits.","Two eligible references are recorded as received.","I have the required English evidence or permitted exemption evidence.","I checked the ¥5,000 payment instructions.","I saved the final submission confirmation and workshop period."]}],"$undefined","$undefined"]}]
2b:["$","section","6-Check the submission, then save the evidence",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Check the submission, then save the evidence"}],[["$","p","A saved draft and a submitted application are different states. Reopen the application summary, inspect every attachment and check the referee indicators. Keep the confirmation email or reference number with the version of the instructions you used. Put any later transcript, offer-acceptance or enrolment task in a separate calendar entry.",{"children":"A saved draft and a submitted application are different states. Reopen the application summary, inspect every attachment and check the referee indicators. Keep the confirmation email or reference number with the version of the instructions you used. Put any later transcript, offer-acceptance or enrolment task in a separate calendar entry."}],["$","p","The tracker is an editable planning sheet, not an application form or eligibility assessment. Its suggested next actions belong to you; deadlines and requirements remain controlled by the institution. Replace the blank owner, internal deadline and confirmation fields with your own plan.",{"children":"The tracker is an editable planning sheet, not an application form or eligibility assessment. Its suggested next actions belong to you; deadlines and requirements remain controlled by the institution. Replace the blank owner, internal deadline and confirmation fields with your own plan."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Check the submission, then save the evidence","children":[["$","a","/downloads/scholarship-application-tracker-2027.csv",{"href":"/downloads/scholarship-application-tracker-2027.csv","download":true,"children":["Download the scholarship application tracker (CSV)",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/deadline-calendar/",{"href":"/deadline-calendar/","children":["Compare other scholarship deadlines",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
