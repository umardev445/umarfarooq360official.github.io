23:["$","div",null,{"className":"article-body","children":[["$","section","Yenching Academy 2027: the decisions to make first",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Yenching Academy 2027: the decisions to make first"}],[["$","p","Applicants can come from different academic fields, but the degree is specifically China Studies. Explain the intellectual connection between your background and the China-related question you propose to study.",{"children":"Applicants can come from different academic fields, but the degree is specifically China Studies. Explain the intellectual connection between your background and the China-related question you propose to study."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Application route, deadline and fellowship conditions","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Application route, deadline and fellowship conditions"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Item",{"scope":"col","children":"Item"}],["$","th","Current rule",{"scope":"col","children":"Current rule"}],["$","th","Your next check",{"scope":"col","children":"Your next check"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Degree"}],["$","td","1",{"children":"Two-year master's in China Studies"}],["$","td","2",{"children":"Choose a research direction, not any unrelated master's"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"International deadline"}],["$","td","1",{"children":"30 November 2026, 09:00 Beijing time"}],["$","td","2",{"children":"Allow time for documents and score delivery"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Partner institutions"}],["$","td","1",{"children":"Internal pre-selection precedes Yenching submission"}],["$","td","2",{"children":"Ask the home university for its own deadline"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"First-year support"}],["$","td","1",{"children":"Fellowship for admitted scholars"}],["$","td","2",{"children":"Read the coverage and travel conditions"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Second-year support"}],["$","td","1",{"children":"Application subject to academic standing and staying in Beijing"}],["$","td","2",{"children":"Plan the second year separately"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://yenchingacademy.pku.edu.cn/ADMISSIONS/Frequently_Asked_Questions.htm","target":"_blank","rel":"noreferrer","children":"Yenching admissions and fellowship FAQ"}]]}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]]}]
24:["$","figure",null,{"className":"page-visual page-visual--inline","children":[["$","img",null,{"src":"/images/research-2026-10/peking-1280.webp","srcSet":"/images/research-2026-10/peking-640.webp 640w, /images/research-2026-10/peking-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Illustrative Chinese garden with a lake, stone bridge and traditional pavilion","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Illustrative Chinese garden; not a documentary photograph of Peking University or Yenching Scholars."}]]}]
25:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Eligibility and the correct applicant route",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Eligibility and the correct applicant route"}],[["$","p","A bachelor's degree in any field is the minimum academic qualification, with completion required by August of the intended enrolment year. Strong academic preparation and a convincing interest in interdisciplinary China Studies matter. Peking University does not permit concurrent enrolment in another degree.",{"children":"A bachelor's degree in any field is the minimum academic qualification, with completion required by August of the intended enrolment year. Strong academic preparation and a convincing interest in interdisciplinary China Studies matter. Peking University does not permit concurrent enrolment in another degree."}],["$","p","The international route requires non-Chinese citizenship and a valid passport; former Chinese citizens have additional documentary rules. Mainland Chinese and Hong Kong, Macao and Taiwan applicants use different instructions. If you are a student or alumnus of a listed partner institution, check its pre-selection procedure rather than assuming direct portal submission completes the process.",{"children":"The international route requires non-Chinese citizenship and a valid passport; former Chinese citizens have additional documentary rules. Mainland Chinese and Hong Kong, Macao and Taiwan applicants use different instructions. If you are a student or alumnus of a listed partner institution, check its pre-selection procedure rather than assuming direct portal submission completes the process."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://yenchingacademy.pku.edu.cn/info/1040/5413.htm",{"children":["",["$","a",null,{"href":"https://yenchingacademy.pku.edu.cn/info/1040/5413.htm","target":"_blank","rel":"noreferrer","children":"Yenching 2027 call and applicant routes"}]]}]]]}],"$undefined"]}],["$","section","2-Funding: separate the first and second academic years",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Funding: separate the first and second academic years"}],[["$","p","The official FAQ describes first-year tuition, accommodation, a monthly stipend, basic medical insurance, research expenses and a travel allowance for one return journey under its conditions. Students in good academic standing who remain in Beijing can apply for the second-year fellowship. It is inaccurate to turn that conditional second year into an unconditional two-year cash promise.",{"children":"The official FAQ describes first-year tuition, accommodation, a monthly stipend, basic medical insurance, research expenses and a travel allowance for one return journey under its conditions. Students in good academic standing who remain in Beijing can apply for the second-year fellowship. It is inaccurate to turn that conditional second year into an unconditional two-year cash promise."}],["$","p","Create a two-column budget: confirmed coverage and costs still to resolve. Ask about the timing and method of travel support, any costs incurred before arrival and the second-year residence plan. Keep personal travel and additional family expenses out of the confirmed award column unless the offer explicitly covers them.",{"children":"Create a two-column budget: confirmed coverage and costs still to resolve. Ask about the timing and method of travel support, any costs incurred before arrival and the second-year residence plan. Keep personal travel and additional family expenses out of the confirmed award column unless the offer explicitly covers them."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$L29","$undefined"]}],"$L2a","$L2b","$L2c","$L2d","$L2e"]}]
