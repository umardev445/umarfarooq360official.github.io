27:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is Yenching Academy a scholarship for any master's subject?",{"children":[["$","summary",null,{"children":["Is Yenching Academy a scholarship for any master's subject?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Applicants may have different undergraduate backgrounds, but the Yenching degree is an interdisciplinary master's in China Studies. Show a clear connection to that academic purpose."}]]}],["$","details","Is second-year Yenching funding automatic?",{"children":[["$","summary",null,{"children":["Is second-year Yenching funding automatic?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The FAQ says eligible students in good academic standing who remain in Beijing can apply for second-year support. Read those conditions and the eventual award terms instead of assuming unconditional renewal."}]]}],["$","details","Does Yenching still require TOEFL 100?",{"children":[["$","summary",null,{"children":["Does Yenching still require TOEFL 100?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The current page distinguishes the newer TOEFL scale from a defined window of older scores. Check its exact test-date and delivery rules; do not rely on an undated TOEFL 100 summary."}]]}],["$","details","What is the deadline in Pakistan?",{"children":[["$","summary",null,{"children":["What is the deadline in Pakistan?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"30 November 2026 at 09:00 Beijing time is 30 November at 06:00 Pakistan Standard Time. It is a morning deadline, so do not wait until that evening."}]]}]]}]]}]
