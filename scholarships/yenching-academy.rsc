29:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://yenchingacademy.pku.edu.cn/ADMISSIONS/Frequently_Asked_Questions.htm",{"children":["",["$","a",null,{"href":"https://yenchingacademy.pku.edu.cn/ADMISSIONS/Frequently_Asked_Questions.htm","target":"_blank","rel":"noreferrer","children":"Yenching FAQ: funding duration and second-year conditions"}]]}]]]}]
2a:["$","section","3-Personal statement and research interest serve different jobs",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Personal statement and research interest serve different jobs"}],[["$","p","The application lists a personal statement of up to 750 words and a research-interest statement of up to 1,500 words excluding citations. Use the personal statement to connect your experiences, motivation and future direction. Use the research statement to frame a question, explain its significance and outline a feasible approach.",{"children":"The application lists a personal statement of up to 750 words and a research-interest statement of up to 1,500 words excluding citations. Use the personal statement to connect your experiences, motivation and future direction. Use the research statement to frame a question, explain its significance and outline a feasible approach."}],["$","p","Before writing, make an evidence map. Identify a small set of relevant sources, the question they leave open and what material or method could help you investigate it. State limitations. If you cannot access a dataset or read a source language, explain the training or alternative evidence you would need rather than claiming expertise you do not have.",{"children":"Before writing, make an evidence map. Identify a small set of relevant sources, the question they leave open and what material or method could help you investigate it. State limitations. If you cannot access a dataset or read a source language, explain the training or alternative evidence you would need rather than claiming expertise you do not have."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original exercise: make a broad interest researchable","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original exercise: make a broad interest researchable"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Draft idea",{"scope":"col","children":"Draft idea"}],["$","th","Problem",{"scope":"col","children":"Problem"}],["$","th","A more workable planning question",{"scope":"col","children":"A more workable planning question"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Study all China–Pakistan relations"}],["$","td","1",{"children":"Too broad to explain a method"}],["$","td","2",{"children":"Choose one policy, sector, period and evidence base"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Prove a policy succeeded"}],["$","td","1",{"children":"Assumes the answer"}],["$","td","2",{"children":"Ask what changed and what alternative explanation fits"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Use a famous theory"}],["$","td","1",{"children":"Does not identify evidence"}],["$","td","2",{"children":"Explain which observations could support or challenge it"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://yenchingacademy.pku.edu.cn/ADMISSIONS.htm",{"children":["",["$","a",null,{"href":"https://yenchingacademy.pku.edu.cn/ADMISSIONS.htm","target":"_blank","rel":"noreferrer","children":"Yenching application materials"}]]}]]]}],"$undefined"]}]
2b:["$","section","4-English evidence: use the current test scale and date rules",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"English evidence: use the current test scale and date rules"}],[["$","p","The current page lists IELTS Academic 7.0 and a TOEFL iBT score of 5 on the newer scale. It accepts old-scale TOEFL results of at least 100 only within the specified September 2025–January 2026 test window. Read the page for exact dates, permitted tests and direct score delivery; an older article's blanket TOEFL 100 rule is incomplete.",{"children":"The current page lists IELTS Academic 7.0 and a TOEFL iBT score of 5 on the newer scale. It accepts old-scale TOEFL results of at least 100 only within the specified September 2025–January 2026 test window. Read the page for exact dates, permitted tests and direct score delivery; an older article's blanket TOEFL 100 rule is incomplete."}],["$","p","Eligible international applicants with an English-taught degree may use the stated exemption, but regional applicant rules differ. Check your own category and supporting evidence. A certificate you have not yet obtained is an unresolved task, not a confirmed exemption. Plan the test organisation's delivery time as well as the application upload.",{"children":"Eligible international applicants with an English-taught degree may use the stated exemption, but regional applicant rules differ. Check your own category and supporting evidence. A certificate you have not yet obtained is an unresolved task, not a confirmed exemption. Plan the test organisation's delivery time as well as the application upload."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://yenchingacademy.pku.edu.cn/ADMISSIONS.htm",{"children":["",["$","a",null,{"href":"https://yenchingacademy.pku.edu.cn/ADMISSIONS.htm","target":"_blank","rel":"noreferrer","children":"Current Yenching English requirements and delivery rules"}]]}]]]}],"$undefined"]}]
2c:["$","section","5-Required documents: give each item a purpose",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Required documents: give each item a purpose"}],[["$","p","The official materials list includes a CV, academic transcripts, a diploma or enrolment certificate, the two statements, English evidence where required and two academic references. The reference rules specify full or associate professors, or equivalent titles, in the intended field. Check the current portal for file and delivery instructions.",{"children":"The official materials list includes a CV, academic transcripts, a diploma or enrolment certificate, the two statements, English evidence where required and two academic references. The reference rules specify full or associate professors, or equivalent titles, in the intended field. Check the current portal for file and delivery instructions."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"An original document-control sheet for the Yenching application","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"An original document-control sheet for the Yenching application"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Item",{"scope":"col","children":"Item"}],["$","th","What to inspect",{"scope":"col","children":"What to inspect"}],["$","th","Completion evidence",{"scope":"col","children":"Completion evidence"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Academic record"}],["$","td","1",{"children":"Names, institution, grading and completion timing"}],["$","td","2",{"children":"The required transcript and diploma or enrolment evidence"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Statements and CV"}],["$","td","1",{"children":"Distinct purposes and consistent dates"}],["$","td","2",{"children":"Final files matching the live limits"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Two academic references"}],["$","td","1",{"children":"Referee title, field and submission instructions"}],["$","td","2",{"children":"Portal receipt, not only an invitation"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"English evidence"}],["$","td","1",{"children":"Applicant category, test date and accepted scale"}],["$","td","2",{"children":"Score delivery or permitted exemption evidence"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://yenchingacademy.pku.edu.cn/ADMISSIONS.htm",{"children":["",["$","a",null,{"href":"https://yenchingacademy.pku.edu.cn/ADMISSIONS.htm","target":"_blank","rel":"noreferrer","children":"Yenching official application materials"}]]}]]]}],"$undefined"]}]
2d:["$","section","6-Application sequence and final checks",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Application sequence and final checks"}],[["$","p","Invite academic referees who meet the current title and subject requirements. Give them your research direction and factual academic record; do not draft a recommendation pretending to be the referee.",{"children":"Invite academic referees who meet the current title and subject requirements. Give them your research direction and factual academic record; do not draft a recommendation pretending to be the referee."}]],["$","ol",null,{"className":"process-steps","aria-label":"Application sequence and final checks","children":[["$","li","Identify your applicant category and any partner-university pre-selection.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Identify your applicant category and any partner-university pre-selection."}]]}],["$","li","Check degree completion, English evidence and document instructions.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Check degree completion, English evidence and document instructions."}]]}],["$","li","Develop the personal and research statements for their different purposes.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Develop the personal and research statements for their different purposes."}]]}],["$","li","Arrange academic references and official score delivery where required.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Arrange academic references and official score delivery where required."}]]}],["$","li","Review the complete portal record and submit before 09:00 Beijing time.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Review the complete portal record and submit before 09:00 Beijing time."}]]}]]}],"$undefined","$undefined","$undefined","$undefined",["$","$L2f",null,{"id":"scholarships/yenching-academy:section-7","title":"Check your progress","items":["I confirmed whether an earlier home-university selection applies.","My current degree can be completed by the required date.","The research question is about China Studies and has a feasible evidence base.","My English evidence follows the current scale and applicant-category rules.","I checked reference eligibility and submission status.","My second-year funding plan reflects the published conditions."]}],"$undefined","$undefined"]}]
2e:["$","section","7-Check the submission, then save the evidence",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Check the submission, then save the evidence"}],[["$","p","A saved draft and a submitted application are different states. Reopen the application summary, inspect every attachment and check the referee indicators. Keep the confirmation email or reference number with the version of the instructions you used. Put any later transcript, offer-acceptance or enrolment task in a separate calendar entry.",{"children":"A saved draft and a submitted application are different states. Reopen the application summary, inspect every attachment and check the referee indicators. Keep the confirmation email or reference number with the version of the instructions you used. Put any later transcript, offer-acceptance or enrolment task in a separate calendar entry."}],["$","p","The tracker is an editable planning sheet, not an application form or eligibility assessment. Its suggested next actions belong to you; deadlines and requirements remain controlled by the institution. Replace the blank owner, internal deadline and confirmation fields with your own plan.",{"children":"The tracker is an editable planning sheet, not an application form or eligibility assessment. Its suggested next actions belong to you; deadlines and requirements remain controlled by the institution. Replace the blank owner, internal deadline and confirmation fields with your own plan."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Check the submission, then save the evidence","children":[["$","a","/downloads/scholarship-application-tracker-2027.csv",{"href":"/downloads/scholarship-application-tracker-2027.csv","download":true,"children":["Download the scholarship application tracker (CSV)",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/deadline-calendar/",{"href":"/deadline-calendar/","children":["Compare other scholarship deadlines",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
