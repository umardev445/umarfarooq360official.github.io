19:["$","section",null,{"className":"content-block","aria-labelledby":"relevant-listings","children":[["$","div",null,{"className":"content-block__heading","children":[["$","h2",null,{"id":"relevant-listings","children":"Relevant opportunities"}],["$","p",null,{"children":"18 official-source records match this topic. Check category and applicant conditions before applying."}]]}],["$","$L1d",null,{"items":[{"id":"chevening-2027","title":"Chevening Scholarships 2027–2028","provider":"UK Government","type":"Scholarship","level":"Master's","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"6 October 2026, 11:00 UTC","deadlineDate":"2026-10-06","deadlineAt":"2026-10-06T11:00:00Z","status":"Open","summary":"One-year master's funding for emerging leaders with strong academic, professional and community impact potential.","tags":["Leadership","International students","One-year master's"],"source":"https://www.chevening.org/scholarships/","sourceLabel":"Chevening official website","checked":"20 September 2026","featured":true},{"id":"schwarzman-2027","title":"Schwarzman Scholars 2027–2028","provider":"Schwarzman Scholars","type":"Scholarship","level":"Master's","country":"China","region":"Asia","funding":"Fully funded","deadline":"9 September 2026, 3:00 p.m. EDT","deadlineDate":"2026-09-09","status":"Closed","summary":"The 2027–2028 global application is closed. The next U.S./Global application cycle is expected from April to September 2027.","tags":["Global affairs","Leadership","Tsinghua University"],"source":"https://www.schwarzmanscholars.org/admissions/application-instructions/","sourceLabel":"Schwarzman Scholars official website","checked":"2 October 2026","featured":true},{"id":"knight-hennessy-2027","title":"Knight-Hennessy Scholars 2027","provider":"Stanford University","type":"Scholarship","level":"Graduate","country":"United States","region":"North America","funding":"Fully funded","deadline":"6 October 2026, 1:00 p.m. PT","deadlineDate":"2026-10-06","deadlineAt":"2026-10-06T13:00:00-07:00","status":"Open","summary":"Graduate funding and leadership development for applicants to eligible Stanford graduate degree programmes.","tags":["Stanford","Graduate study","Leadership"],"source":"https://knight-hennessy.stanford.edu/admission","sourceLabel":"Knight-Hennessy official website","checked":"2 October 2026","featured":true},{"id":"rhodes-2027","title":"Rhodes Scholarship 2027","provider":"Rhodes Trust","type":"Scholarship","level":"Graduate","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"Varies by constituency","status":"Check official site","summary":"Postgraduate study at the University of Oxford for academically excellent, service-oriented young leaders.","tags":["Oxford","Postgraduate","Leadership"],"source":"https://www.rhodeshouse.ox.ac.uk/scholarships/applications/","sourceLabel":"Rhodes Trust official website","checked":"2 October 2026","featured":true},{"id":"gates-cambridge-2027","title":"Gates Cambridge Scholarship","provider":"University of Cambridge","type":"Scholarship","level":"Graduate","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"US round: 14 Oct 2026; international: 8 Dec 2026 or 6 Jan 2027","deadlineDate":"2026-10-14","milestones":[{"label":"US applicant round","date":"2026-10-14","detail":"Check citizenship/category rules."},{"label":"International round: course-dependent option","date":"2026-12-08","detail":"The course determines whether this or January applies."},{"label":"International round: course-dependent option","date":"2027-01-06","detail":"The course determines whether this or December applies."}],"status":"Open","summary":"Full-cost postgraduate scholarships for eligible applicants from outside the UK; international deadlines follow the selected Cambridge course's funding deadline.","tags":["Cambridge","Master's","PhD"],"source":"https://www.gatescambridge.org/apply/timeline/","sourceLabel":"Gates Cambridge official timeline","checked":"29 September 2026","featured":true},{"id":"commonwealth-masters-2027","title":"Commonwealth Master's Scholarships 2027–2028","provider":"Commonwealth Scholarship Commission","type":"Scholarship","level":"Master's","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"20 October 2026, 16:00 BST","deadlineDate":"2026-10-20","status":"Open","summary":"UK master's funding for eligible candidates with the potential to contribute to sustainable development in their home countries.","tags":["Commonwealth","Development","Master's"],"source":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-masters-scholarships/","sourceLabel":"Commonwealth Scholarship Commission","checked":"2 October 2026"},{"id":"erasmus-mundus-2027","title":"Erasmus Mundus Joint Masters 2027","provider":"European Union","type":"Scholarship","level":"Master's","country":"Multiple European countries","region":"Europe","funding":"Fully funded","deadline":"Programme-specific; most open from autumn 2026","status":"Opening soon","summary":"Joint master's degrees delivered by international university consortia, with EU-funded scholarships available to top students worldwide.","tags":["Europe","Joint degree","Mobility"],"source":"https://erasmus-plus.ec.europa.eu/opportunities/individuals/students/erasmus-mundus-joint-masters","sourceLabel":"European Commission – Erasmus+","checked":"2 October 2026","featured":true},{"id":"daad-epos-2027","title":"DAAD EPOS Scholarships 2027–2028","provider":"DAAD","type":"Scholarship","level":"Graduate","country":"Germany","region":"Europe","funding":"Fully funded","deadline":"Varies by selected postgraduate course","status":"Check official site","summary":"Development-related postgraduate funding for graduates from eligible countries, generally requiring at least two years of professional experience.","tags":["Germany","Development","Professional experience"],"source":"https://www2.daad.de/deutschland/stipendium/datenbank/en/21148-scholarship-database/?detail=50076777","sourceLabel":"DAAD scholarship database","checked":"2 October 2026","featured":true},{"id":"kaust-2027","title":"KAUST Graduate Admission & Fellowship 2027","provider":"King Abdullah University of Science and Technology","type":"Graduate Program","level":"Graduate","country":"Saudi Arabia","region":"Middle East","funding":"Fully funded","deadline":"Fall 2027: 3 January 2027","deadlineDate":"2027-01-03","status":"Open","summary":"Fall 2027 applications are open for MS, MS/PhD and PhD study with KAUST Fellowship support for admitted graduate students.","tags":["STEM","MS","PhD"],"source":"https://admissions.kaust.edu.sa/how-to-apply/admission-timelines","sourceLabel":"KAUST Admissions","checked":"29 September 2026","featured":true},{"id":"mext-2027","title":"Japanese Government MEXT Scholarships","provider":"Government of Japan","type":"Scholarship","level":"Any degree","country":"Japan","region":"Asia","funding":"Fully funded","deadline":"Varies by embassy or university route","status":"Check official site","summary":"Japanese government scholarships for international students selected through embassy, university or authority recommendation routes.","tags":["Japan","Embassy route","University route"],"source":"https://www.mext.go.jp/en/policy/education/highered/title02/detail02/sdetail02/1373897.htm","sourceLabel":"MEXT official website","checked":"20 September 2026","featured":true},{"id":"fulbright-foreign-student","title":"Fulbright Foreign Student Program","provider":"U.S. Department of State","type":"Scholarship","level":"Graduate","country":"United States","region":"North America","funding":"Funded","deadline":"Varies by home country","status":"Check official site","summary":"Approximately 4,000 annual grants for foreign graduate students, young professionals and artists; local rules vary by country.","tags":["USA","Master's","Research"],"source":"https://foreign.fulbrightonline.org/apply","sourceLabel":"Foreign Fulbright Program","checked":"2 October 2026"},{"id":"stipendium-hungaricum","title":"Stipendium Hungaricum Scholarship","provider":"Government of Hungary","type":"Scholarship","level":"Any degree","country":"Hungary","region":"Europe","funding":"Funded","deadline":"Next cycle to be announced; current official page shows the prior intake","status":"Check official site","summary":"Tuition exemption with living and accommodation contributions; official guidance says the support may not meet all living costs.","tags":["Hungary","Bachelor's","Master's","PhD"],"source":"https://stipendiumhungaricum.hu/apply/","sourceLabel":"Stipendium Hungaricum official website","checked":"20 September 2026"},{"id":"australia-awards-scholarships","title":"Australia Awards Scholarships","provider":"Australian Government Department of Foreign Affairs and Trade","type":"Scholarship","level":"Any degree","country":"Australia","region":"Oceania","funding":"Fully funded","deadline":"Country-specific; check the participating-country profile","status":"Check official site","summary":"Long-term undergraduate and postgraduate awards for eligible developing-country applicants, with benefits generally including tuition, travel, living support and health cover.","tags":["Developing countries","Government scholarship","Return-home condition"],"source":"https://www.dfat.gov.au/people-to-people/australia-awards/australia-awards-scholarships","sourceLabel":"Australian Government DFAT","checked":"2 October 2026","featured":true},{"id":"australia-rtp","title":"Australian Government Research Training Program","provider":"Australian Government Department of Education","type":"Scholarship","level":"PhD","country":"Australia","region":"Oceania","funding":"Funded","deadline":"University-specific; apply through an eligible Australian provider","status":"Check official site","summary":"University-administered support for eligible research doctorate and research master's students that may include a tuition-fee offset, stipend and research-related allowances.","tags":["Research degree","University application","Tuition and stipend"],"source":"https://www.education.gov.au/research-block-grants/research-training-program","sourceLabel":"Australian Government Department of Education","checked":"2 October 2026"},{"id":"italy-maeci-2026-27","title":"MAECI Italian Government Grants 2026–2027","provider":"Italian Ministry of Foreign Affairs and International Cooperation","type":"Scholarship","level":"Graduate","country":"Italy","region":"Europe","funding":"Funded","deadline":"26 March 2026, 14:00 Italian time — closed","deadlineDate":"2026-03-26","status":"Closed","summary":"The current call is closed. MAECI grants use an annual eligible-country list and the official Study in Italy application portal for study carried out in Italy.","tags":["Italian Government","MAECI","Study in Italy"],"source":"https://www.esteri.it/en/servizi-opportunita/opportunita/borse-di-studio/per-cittadini-stranieri/borsestudio_stranieri/","sourceLabel":"Italian Ministry of Foreign Affairs","checked":"29 September 2026"},{"id":"italy-ergo-dsu-2026-27","title":"ER.GO Regional Scholarship 2026–2027","provider":"ER.GO Emilia-Romagna","type":"Scholarship","level":"Any degree","country":"Italy","region":"Europe","funding":"Funded","deadline":"24 August 2026, 16:00 — main scholarship deadline closed","deadlineDate":"2026-08-24","status":"Closed","summary":"Regional right-to-study support assessed under ER.GO's economic, enrolment and merit rules, with separate guidance for families holding income or assets abroad.","tags":["DSU","Emilia-Romagna","Income assessed"],"source":"https://www.er-go.it/cosa-fare-per/bandi-di-concorso/leggi-il-bando","sourceLabel":"ER.GO official 2026–2027 call","checked":"29 September 2026"},{"id":"padua-international-excellence-2026-27","title":"Padua International Excellence Scholarship","provider":"University of Padua","type":"Scholarship","level":"Any degree","country":"Italy","region":"Europe","funding":"Funded","deadline":"2027–2028 award terms: verify on the official scholarship page","status":"Check official site","summary":"The 2026–2027 scheme offered €8,000 gross per year plus a tuition-fee exemption for selected international students in eligible English-taught degrees.","tags":["Padua","Merit","English-taught degree"],"source":"https://www.unipd.it/en/padua-international-excellence-scholarship-programme","sourceLabel":"University of Padua","checked":"29 September 2026","featured":true},{"id":"polimi-merit-scholarships-2027-28","title":"Politecnico di Milano International Merit Scholarships","provider":"Politecnico di Milano","type":"Scholarship","level":"Master's","country":"Italy","region":"Europe","funding":"Funded","deadline":"15 December 2026, noon Italian time; early admission payment required by 1 December","deadlineDate":"2026-12-15","deadlineAt":"2026-12-15T12:00:00+01:00","milestones":[{"label":"Required early admission payment","date":"2026-12-01","detail":"Confirm your eligible early-bird route and closing time."},{"label":"Merit scholarship form","date":"2026-12-15","at":"2026-12-15T12:00:00+01:00","detail":"Noon Italian time; prior admission conditions apply."}],"status":"Open","summary":"The 2027–2028 merit call requires a separate scholarship form and qualifying early MSc admission application. Awards waive tuition; some include an allowance. Follow the official PDF for conditions and remaining charges.","tags":["Polimi","Master of Science","Tuition waiver"],"source":"https://www.polimi.it/en/prospective-students/how-much-does-it-cost/scholarships","sourceLabel":"Politecnico di Milano","checked":"5 October 2026","featured":true}],"showTypeFilter":false}]]}]
1a:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-What selectors want to see",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"What selectors want to see"}],[["$","p","Competitive master's awards look beyond grades. They want a credible reason for the course, evidence that you can succeed and a plan for using the degree after graduation.",{"children":"Competitive master's awards look beyond grades. They want a credible reason for the course, evidence that you can succeed and a plan for using the degree after graduation."}]],"$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","A focused academic and career story",{"children":"A focused academic and career story"}],["$","li","Evidence of leadership, service or professional impact",{"children":"Evidence of leadership, service or professional impact"}],["$","li","Course choices that solve a real skills gap",{"children":"Course choices that solve a real skills gap"}],["$","li","Specific examples rather than broad claims",{"children":"Specific examples rather than broad claims"}],["$","li","References who can evaluate your readiness",{"children":"References who can evaluate your readiness"}]]}],"$undefined","$undefined"]}]]}]
