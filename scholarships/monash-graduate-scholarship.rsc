1d:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Monash advertises an MGS stipend ofAUD 41,100 per year at the 2027 rate. International tuition scholarships can be packaged separately. The central international Round 1 deadline for 2027 has moved to 28 February; minimum entry requirements do not guarantee funding."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Confirm the faculty, supervisor process, Australian campus and applicant category, then check the current course and scholarship instructions together."]}],"$undefined"]}],["$","figure",null,{"className":"page-visual day15-guide-visual page-visual--inline","children":[["$","img",null,{"src":"/images/day25/application-workspace-1280.webp","srcSet":"/images/day25/application-workspace-640.webp 640w, /images/day25/application-workspace-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), (max-width: 1150px) calc(100vw - 64px), 760px","width":1280,"height":853,"alt":"Illustrative scene of two students comparing application folders in a library","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Illustrative study scene. The people do not represent this programme or university."}]]}],false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","First establish what the award actually pays",{"href":"#section-1","children":"First establish what the award actually pays"}],["$","a","Use the 2027 Round 1 change, then check your faculty",{"href":"#section-2","children":"Use the 2027 Round 1 change, then check your faculty"}],["$","a","Prepare a research case before opening myApp",{"href":"#section-3","children":"Prepare a research case before opening myApp"}],["$","a","Keep admission and scholarship completion in one task list",{"href":"#section-4","children":"Keep admission and scholarship completion in one task list"}],["$","a","Original example: compare an admission offer and a funding package",{"href":"#section-5","children":"Original example: compare an admission offer and a funding package"}],["$","a","Review the issued terms before accepting",{"href":"#section-6","children":"Review the issued terms before accepting"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","First establish what the award actually pays",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"First establish what the award actually pays"}],[["$","p","The MGS owner page describes support for research master’s and research doctorate students at Monash campuses in Australia. It provides a living allowance and relocation support where eligible. Tuition scholarships for international students are a separate package question. The listed 2027 annual stipend isAUD 41,100; do not turn that headline into an individual award decision or a promise that every cost is covered.",{"children":"The MGS owner page describes support for research master’s and research doctorate students at Monash campuses in Australia. It provides a living allowance and relocation support where eligible. Tuition scholarships for international students are a separate package question. The listed 2027 annual stipend isAUD 41,100; do not turn that headline into an individual award decision or a promise that every cost is covered."}],"$L1f"],"$undefined","$L20","$undefined","$undefined","$undefined","$undefined","$L21","$undefined"]}]]}],false,false,false,false,"$L22",false,"$L23","$L24"]}],"$L25"]}]
