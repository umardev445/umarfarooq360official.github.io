1b:["$","div",null,{"className":"site-shell content-layout content-layout--wide","children":[["$","div",null,{"className":"content-main","children":[false,false,["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"A focused list of flagship awards that advertise comprehensive support, followed by the checks you should complete before calling any scholarship fully funded."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose the matching route below and check its official eligibility, funding and deadlines."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents mobile-contents--wide","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Compare fit before opening an application",{"href":"#section-1","children":"Compare fit before opening an application"}],["$","a","What fully funded should mean",{"href":"#section-2","children":"What fully funded should mean"}],["$","a","Compare coverage with a personal budget",{"href":"#section-3","children":"Compare coverage with a personal budget"}],["$","a","Find the right award for your degree level",{"href":"#section-4","children":"Find the right award for your degree level"}],["$","a","Build a one-page funding comparison",{"href":"#section-5","children":"Build a one-page funding comparison"}],["$","a","Italy: distinguish MAECI, DSU and university awards",{"href":"#section-6","children":"Italy: distinguish MAECI, DSU and university awards"}],["$","a","Compare coverage as covered, capped, conditional or self-funded",{"href":"#section-7","children":"Compare coverage as covered, capped, conditional or self-funded"}],["$","a","A fictional funding-gap calculation",{"href":"#section-8","children":"A fi