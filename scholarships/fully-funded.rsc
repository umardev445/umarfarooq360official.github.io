1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--listing","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CollectionPage\",\"@id\":\"https://aspirecompass.org/scholarships/fully-funded/\",\"name\":\"Fully funded scholarships for international students\",\"description\":\"Compare fully funded scholarships for international students by tuition, stipend, travel, eligibility and application route, with direct official sources.\",\"url\":\"https://aspirecompass.org/scholarships/fully-funded/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-08-31\",\"dateModified\":\"2026-10-24\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/study-planning-1280.webp\",\"caption\":\"Students comparing study options with a laptop, notes and a map\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Scholarships\",\"item\":\"https://aspirecompass.org/scholarships/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Fully funded scholarships for international students\",\"item\":\"https://aspirecompass.org/scholarships/fully-funded/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Does fully funded always mean I will pay nothing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. An award can cover tuition and a stipend while excluding dependants, deposits, tests, visa costs or part of travel. Build a personal budget from the current official benefit list.\"}},{\"@type\":\"Question\",\"name\":\"How should I compare two fully funded scholarships?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Compare eligibility, degree fit, tuition, stipend, housing, insurance, travel, renewal conditions and costs that remain yours. Also compare the application route and decision timeline.\"}},{\"@type\":\"Question\",\"name\":\"Can the scholarship and university have separate applications?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Some awards have a separate scholarship portal or nomination stage, while others are tied directly to university admission. Follow the exact sequence stated by the programme owner.\"}}]}"}}]],["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--listing inner-hero--visual","children":["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L4",null,{"href":"/","children":"Home"}],["$","i",null,{"children":"/"}]]}],["$","span","/scholarships/",{"children":[["$","$L4",null,{"href":"/scholarships/","children":"Scholarships"}],["$","i",null,{"children":"/"}]]}],["$","span","/scholarships/fully-funded/",{"children":[["$","span",null,{"aria-current":"page","children":"Fully funded scholarships for international students"}],false]}]]}],["$","span",null,{"data-slot":"badge","data-variant":"outline","className":"inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3 bor