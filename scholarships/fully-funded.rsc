]}]}],false,["$","section",null,{"className":"content-block","aria-labelledby":"relevant-listings","children":[["$","div",null,{"className":"content-block__heading","children":[["$","h2",null,{"id":"relevant-listings","children":"Relevant opportunities"}],["$","p",null,{"children":"17 official-source records match this topic. Check category and applicant conditions before applying."}]]}],["$","$L1d",null,{"items":[{"id":"chevening-2027","title":"Chevening Scholarships 2027–2028","provider":"UK Government","type":"Scholarship","level":"Master's","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"6 October 2026, 11:00 UTC","deadlineDate":"2026-10-06","deadlineAt":"2026-10-06T11:00:00Z","status":"Closed","summary":"The 2027–2028 scholarship application round is closed. Existing applicants should follow the official assessment, interview and later university-offer instructions.","tags":["Leadership","International students","One-year master's"],"source":"https://www.chevening.org/scholarships/","sourceLabel":"Chevening official website","checked":"23 October 2026","featured":false},{"id":"schwarzman-2027","title":"Schwarzman Scholars 2027–2028","provider":"Schwarzman Scholars","type":"Scholarship","level":"Master's","country":"China","region":"Asia","funding":"Fully funded","deadline":"9 September 2026, 3:00 p.m. EDT","deadlineDate":"2026-09-09","status":"Closed","summary":"The 2027–2028 global application is closed. The next U.S./Global application cycle is expected from April to September 2027.","tags":["Global affairs","Leadership","Tsinghua University"],"source":"https://www.schwarzmanscholars.org/admissions/application-instructions/","sourceLabel":"Schwarzman Scholars official website","checked":"23 October 2026","featured":true},{"id":"knight-hennessy-2027","title":"Knight-Hennessy Scholars 2027","provider":"Stanford University","type":"Scholarship","level":"Graduate","country":"United States","region":"North America","funding":"Fully funded","deadline":"6 October 2026, 1:00 p.m. PT","deadlineDate":"2026-10-06","deadlineAt":"2026-10-06T13:00:00-07:00","status":"Closed","summary":"The 2027 KHS application is closed. Existing candidates must still follow their separate Stanford degree deadlines; the next KHS cohort is announced to open in summer 2027.","tags":["Stanford","Graduate study","Leadership"],"source":"https://knight-hennessy.stanford.edu/admission","sourceLabel":"Knight-Hennessy official website","checked":"23 October 2026","featured":false},{"id":"rhodes-2027","title":"Rhodes Scholarship 2027","provider":"Rhodes Trust","type":"Scholarship","level":"Graduate","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"2027-entry round closed; next applications reopen in 2027 for 2028 entry","status":"Closed","summary":"Applications are closed. Prepare by constituency and eligible Oxford course; future-cycle exact dates must come from the next official call.","tags":["Oxford","Postgraduate","Leadership"],"source":"https://www.rhodeshouse.ox.ac.uk/scholarships/the-rhodes-scholarship/","sourceLabel":"Rhodes Trust: current application status","checked":"24 October 2026","featured":false},{"id":"gates-cambridge-2027","title":"Gates Cambridge Scholarship","provider":"University of Cambridge","type":"Scholarship","level":"Graduate","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"International: 8 Dec 2026 or 6 Jan 2027, course-dependent; U.S. round closed","deadlineDate":"$undefined","milestones":[{"label":"International funding deadline: course-dependent December option","date":"2026-12-08","at":"2026-12-08T23:59:00Z","detail":"Your course determines whether December or January applies; references must be complete."},{"label":"International funding deadline: course-dependent January option","date":"2027-01-06","at":"2027-01-06T23:59:00Z","detail":"Not a second chance after a December deadline. Check your course and Gates route."}],"status":"Check official site","summary":"The U.S. deadline has passed. Other eligible applicants must check the exact course funding deadline and Gates route; a complete application includes references.","tags":["Cambridge","Master's","PhD"],"source":"https://www.postgraduate.study.cam.ac.uk/funding","sourceLabel":"Cambridge: 2027–28 funding deadlines","checked":"24 October 2026","featured":true},{"id":"commonwealth-masters-2027","title":"Commonwealth Master's Scholarships 2027–2028","provider":"Commonwealth Scholarship Commission","type":"Scholarship","level":"Master's","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"20 October 2026, 16:00 BST","deadlineDate":"2026-10-20","status":"Closed","summary":"The published central 2027–2028 deadline of 20 October 2026 at 16:00 BST has passed. Existing applicants should retain confirmations and follow CSC and nominator instructions; check the official portal for any amendment.","tags":["Commonwealth","Development","Master's"],"source":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-masters-scholarships/","sourceLabel":"Commonwealth Scholarship Commission","checked":"23 October 2026","featured":false,"deadlineAt":"2026-10-20T16:00:00+01:00"},{"id":"commonwealth-phd-2027","title":"Commonwealth PhD Scholarships 2027–2028","provider":"Commonwealth Scholarship Commission","type":"Scholarship","level":"PhD","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"20 October 2026, 16:00 BST","deadlineDate":"2026-10-20","status":"Closed","summary":"The published central 2027–2028 deadline of 20 October 2026 at 16:00 BST has passed. Existing applicants should retain confirmations and follow CSC and nominator instructions; check the official portal for any amendment.","tags":["Commonwealth","Research","PhD"],"source":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-phd-scholarships-for-least-developed-countries-and-vulnerable-states/","sourceLabel":"Commonwealth Scholarship Commission","checked":"23 October 2026","featured":false,"deadlineAt":"2026-10-20T16:00:00+01:00"},{"id":"erasmus-mundus-2027","title":"Erasmus Mundus Joint Masters 2027","provider":"European Union","type":"Scholarship","level":"Master's","country":"Multiple European countries","region":"Europe","funding":"Fully funded","deadline":"Consortium-specific; check the current programme call","status":"Check official site","summary":"Joint master's programmes use their own calls and scholarship deadlines. The European Commission describes many applications between October and January, but this umbrella record is not a confirmed open call.","tags":["Europe","Joint degree","Mobility"],"source":"https://erasmus-plus.ec.europa.eu/opportunities/individuals/students/erasmus-mundus-joint-masters","sourceLabel":"European Commission – Erasmus+","checked":"13 October 2026","featured":true},{"id":"daad-epos-2027","title":"DAAD EPOS Scholarships 2027–2028","provider":"DAAD","type":"Scholarship","level":"Graduate","country":"Germany","region":"Europe","funding":"Fully funded","deadline":"Varies by selected postgraduate course","status":"Check official site","summary":"Development-related postgraduate funding for graduates from eligible countries, generally requiring at least two years of professional experience.","tags":["Germany","Development","Professional experience"],"source":"https://www2.daad.de/deutschland/stipendium/datenbank/en/21148-scholarship-database/?detail=50076777","sourceLabel":"DAAD scholarship database","checked":"13 October 2026","featured":true},{"id":"kaust-2027","title":"KAUST Graduate Admission & Fellowship 2027","provider":"King Abdullah University of Science and Technology","type":"Graduate Program","level":"Graduate","country":"Saudi Arabia","region":"Middle East","funding":"Fully funded","deadline":"Fall 2027: 3 January 2027","deadlineDate":"2027-01-03","status":"Open","summary":"Fall 2027 applications are open for MS, MS/PhD and PhD study with KAUST Fellowship support for admitted graduate students.","tags":["STEM","MS","PhD"],"source":"https://admissions.kaust.edu.sa/how-to-apply/admission-timelines","sourceLabel":"KAUST Admissions","checked":"23 October 2026","featured":true},{"id":"mext-2027","title":"Japanese Government MEXT Scholarships","provider":"Government of Japan","type":"Scholarship","level":"Any degree","country":"Japan","region":"Asia","funding":"Fully funded","deadline":"Varies by embassy or university route","status":"Check official site","summary":"Japanese government scholarships for international students selected through embassy, university or authority recommendation routes.","tags":["Japan","Embassy route","University route"],"source":"https://www.mext.go.jp/en/policy/education/highered/title02/detail02/sdetail02/1373897.htm","sourceLabel":"MEXT official website","checked":"13 October 2026","featured":true},{"id":"lester-b-pearson-2027","title":"Lester B. Pearson International Scholarship 2027","provider":"University of Toronto","type":"Scholarship","level":"Bachelor's","country":"Canada","region":"North America","funding":"Fully funded","deadline":"School nomination: 9 Oct; admission: 16 Oct; scholarship: 6 Nov 2026","deadlineDate":"2026-10-09","milestones":[{"label":"School nomination","date":"2026-10-09","detail":"School acts first; later deadlines do not replace nomination."},{"label":"Undergraduate admission","date":"2026-10-16","detail":"Student follows the University of Toronto route."},{"label":"Scholarship form and documents","date":"2026-11-06","detail":"Nominated student uses the official invitation."}],"status":"Open","summary":"School nomination and the required admission deadline have passed. Applicants who completed both steps can submit their scholarship form and documents by 6 November 2026 through their private university invitation.","tags":["University of Toronto","School nomination","Undergraduate"],"source":"https://future.utoronto.ca/pearson-scholarships","sourceLabel":"University of Toronto official scholarship page","checked":"23 October 2026","featured":true,"entryDeadlineDate":"2026-10-09","entryClosedNote":"School nomination closed on 9 October. Remaining admission and award deadlines apply to already nominated candidates."},{"id":"australia-awards-scholarships","title":"Australia Awards Scholarships","provider":"Australian Government Department of Foreign Affairs and Trade","type":"Scholarship","level":"Any degree","country":"Australia","region":"Oceania","funding":"Fully funded","deadline":"Country-specific; check the participating-country profile","status":"Check official site","summary":"Long-term undergraduate and postgraduate awards for eligible developing-country applicants, with benefits generally including tuition, travel, living support and health cover.","tags":["Developing countries","Government scholarship","Return-home condition"],"source":"https://www.dfat.gov.au/people-to-people/australia-awards/australia-awards-scholarships","sourceLabel":"Australian Government DFAT","checked":"13 October 2026","featured":true},{"id":"schwarzman-2028-announced","title":"Schwarzman Scholars 2028–2029 — announced next cycle","provider":"Schwarzman Scholars","type":"Scholarship","level":"Master's","country":"China","region":"Asia","funding":"Fully funded","status":"Opening soon","deadline":"U.S./Global application period: April–September 2027; exact dates to verify","summary":"The official instructions announce the next U.S./Global cycle for April–September 2027, with the programme beginning August 2028. Chinese-citizenship applicants have a different March–May 2027 period. Applications are not open in this record.","tags":["Announced future cycle","Leadership","Different citizenship routes"],"source":"https://www.schwarzmanscholars.org/admissions/application-instructions/","sourceLabel":"Schwarzman official application instructions","checked":"23 October 2026"},{"id":"kaust-vsrp","title":"KAUST Visiting Student Research Program","provider":"KAUST","type":"Internship","level":"Student","country":"Saudi Arabia","region":"Middle East","funding":"Fully funded","deadline":"Year-round; project availability and dates to confirm","status":"Rolling","summary":"A 2–6 month research placement with published student/recent-graduate conditions, project-specific fit and a nominated-referee process. Separate from degree admission.","tags":["Research","STEM","Project application"],"source":"https://admissions.kaust.edu.sa/study/internships","sourceLabel":"KAUST official internship requirements and FAQ","checked":"24 October 2026"},{"id":"flex-global-2027","title":"FLEX Global high-school exchange 2027–28","provider":"U.S. Department of State / American Councils and partners","type":"Exchange","level":"Student","country":"United States","region":"North America","funding":"Fully funded","deadline":"Country-specific recruitment dates; contact the official office","status":"Check official site","summary":"Eligible students from participating countries spend an academic year in the U.S. Pakistan applicants start with the country office. Global Abroad is a different outbound route.","tags":["High school","Country-specific eligibility","Host family"],"source":"https://www.discoverflexglobal.org/apply-to-flex","sourceLabel":"FLEX Global official country application routes","checked":"24 October 2026"},{"id":"turkiye-next","title":"Türkiye Scholarships: prepare for the next degree call","provider":"Türkiye Scholarships / YTB","type":"Scholarship","level":"Graduate","supportedDegrees":["Bachelor's","Master's","PhD"],"country":"Türkiye","region":"Europe","funding":"Fully funded","deadline":"Annual Jan–Feb calendar; next named call must be verified","status":"Check official site","summary":"Degree funding with placement and level-specific academic/age conditions. The published annual calendar does not confirm that the next intake is open.","tags":["Degree placement","TBBS","Level-specific requirements"],"source":"https://www.turkiyeburslari.gov.tr/fulltimeprograms","sourceLabel":"Türkiye Scholarships official full-time programme","checked":"24 October 2026"}],"showTypeFilter":false}]]}],false,"$L1e",false,null,"$L1f"]}],false]}]
1c:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L4","scholarships/italy",{"href":"/scholarships/italy/","children":[["$","span",null,{"children":"Italy funding guide"}],["$","h3",null,{"children":"Scholarships in Italy for international students"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/italy-dsu-scholarships",{"href":"/guides/italy-dsu-scholarships/","children":[["$","span",null,{"children":"Regional funding guide"}],["$","h3",null,{"children":"DSU scholarships in Italy: eligibility, benefits and documents"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","guides/scholarship-application",{"href":"/guides/scholarship-application/","children":[["$","span",null,{"children":"Application guide"}],["$","h3",null,{"children":"How to apply for international scholarships step by step"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","deadline-calendar",{"href":"/deadline-calendar/","children":[["$","span",null,{"children":"Application planning"}],["$","h3",null,{"children":"Scholarship and opportunity deadline calendar"}],["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
1e:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-What fully funded should mean",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"What fully funded should mean"}],[["$","p","The phrase normally indicates full tuition plus a living allowance, but benefits differ. Some awards add airfare, visa costs, health insurance, books or research support; others do not.",{"children":"The phrase normally indicates full tuition plus a living allowance, but benefits differ. Some awards add airfare, visa costs, health insurance, books or research support; others do not."}],["$","p","Read the current award conditions and estimate a realistic monthly budget for the destination before accepting an offer.",{"children":"Read the current award conditions and estimate a realistic monthly budget for the destination before accepting an offer."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Tuition and mandatory university fees",{"children":"Tuition and mandatory university fees"}],["$","li","Living or maintenance stipend",{"children":"Living or maintenance stipend"}],["$","li","Travel and relocation support",{"children":"Travel and relocation support"}],["$","li","Health insurance",{"children":"Health insurance"}],["$","li","Research, thesis or study allowance",{"children":"Research, thesis or study allowance"}]]}],"$undefined","$undefined","$undefined"]}],["$","section","2-Compare coverage with a personal budget",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Compare coverage with a personal budget"}],[["$","p","For each award, copy the current benefit list into a budget and add every likely cost before the first payment. Mark tuition, stipend, travel, insurance, visa, tests, deposits, dependants and research support as covered, capped, conditional or self-funded.",{"children":"For each award, copy the current benefit list into a budget and add every likely cost before the first payment. Mark tuition, stipend, travel, insurance, visa, tests, deposits, dependants and research support as covered, capped, conditional or self-funded."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Find the right award for your degree level",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Find the right award for your degree level"}],[["$","p","For bachelor's applicants, the University of Toronto Pearson award requires high-school nomination before its separate university and scholarship submissions. At master's level, Chevening, Erasmus Mundus and eligible DAAD EPOS courses use different course-selection and application systems. At doctoral level, Commonwealth and research-based university funding have their own nomination or supervisor requirements.",{"children":"For bachelor's applicants, the University of Toronto Pearson award requires high-school nomination before its separate university and scholarship submissions. At master's level, Chevening, Erasmus Mundus and eligible DAAD EPOS courses use different course-selection and application systems. At doctoral level, Commonwealth and research-based university funding have their own nomination or supervisor requirements."}],["$","p","Funding labels also need context. The Hungarian government's Stipendium Hungaricum covers tuition and offers an allowance and accommodation support, but its official site warns the contribution may not meet full living costs. A careful comparison records which costs remain the applicant's responsibility.",{"children":"Funding labels also need context. The Hungarian government's Stipendium Hungaricum covers tuition and offers an allowance and accommodation support, but its official site warns the contribution may not meet full living costs. A careful comparison records which costs remain the applicant's responsibility."}]],"$undefined","$undefined","$undefined","$undefined","$L20","$undefined","$undefined","$undefined"]}],"$L21","$L22","$L23","$L24","$L25"]}]
1f:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Does fully funded always mean I will pay nothing?",{"children":[["$","summary",null,{"children":["Does fully funded always mean I will pay nothing?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. An award can cover tuition and a stipend while excluding dependants, deposits, tests, visa costs or part of travel. Build a personal budget from the current official benefit list."}]]}],["$","details","How should I compare two fully funded scholarships?",{"children":[["$","summary",null,{"children":["How should I compare two fully funded scholarships?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Compare eligibility, degree fit, tuition, stipend, housing, insurance, travel, renewal conditions and costs that remain yours. Also compare the application route and decision timeline."}]]}],["$","details","Can the scholarship and university have separate applications?",{"children":[["$","summary",null,{"children":["Can the scholarship and university have separate applications?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Some awards have a separate scholarship portal or nomination stage, while others are tied directly to university admission. Follow the exact sequence stated by the programme owner."}]]}]]}]]}]
20:["$","ul",null,{"children":[["$","li","Bachelor's: school nomination and undergraduate eligibility",{"children":"Bachelor's: school nomination and undergraduate eligibility"}],["$","li","Master's: course choice and admission sequence",{"children":"Master's: course choice and admission sequence"}],["$","li","PhD: supervisor, research scope and duration",{"children":"PhD: supervisor, research scope and duration"}],["$","li","All levels: net monthly budget after mandatory fees",{"children":"All levels: net monthly budget after mandatory fees"}]]}]
21:["$","section","4-Build a one-page funding comparison",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Build a one-page funding comparison"}],[["$","p","For each shortlisted scholarship, enter the official programme, citizenship rule, degree level, application deadline, tuition support, stipend, housing, insurance, travel and conditions for renewal. Mark a benefit as 'not confirmed' when the current call is silent rather than filling it in from another year's announcement.",{"children":"For each shortlisted scholarship, enter the official programme, citizenship rule, degree level, application deadline, tuition support, stipend, housing, insurance, travel and conditions for renewal. Mark a benefit as 'not confirmed' when the current call is silent rather than filling it in from another year's announcement."}],["$","p","A candidate who needs full support for dependants or upfront visa and relocation expenses should calculate that separately; a scholarship called fully funded might still leave a large personal bill.",{"children":"A candidate who needs full support for dependants or upfront visa and relocation expenses should calculate that separately; a scholarship called fully funded might still leave a large personal bill."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","5-Italy: distinguish MAECI, DSU and university awards",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Italy: distinguish MAECI, DSU and university awards"}],[["$","p","Italy's government, regional and university routes solve different costs. MAECI uses an annual eligible-country call, DSU bodies assess regional income and merit conditions, and universities may offer a tuition waiver or merit award linked to admission.",{"children":"Italy's government, regional and university routes solve different costs. MAECI uses an annual eligible-country call, DSU bodies assess regional income and merit conditions, and universities may offer a tuition waiver or merit award linked to admission."}],["$","p","The phrase fully funded should be used only after the current call confirms tuition, cash support, housing, meals, travel and insurance. The Italy scholarship guide records the current-cycle status and the official owner of each route.",{"children":"The phrase fully funded should be used only after the current call confirms tuition, cash support, housing, meals, travel and insurance. The Italy scholarship guide records the current-cycle status and the official owner of each route."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","6-Compare coverage as covered, capped, conditional or self-funded",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Compare coverage as covered, capped, conditional or self-funded"}],[["$","p","The listing label is a starting point. Build a comparison for the actual programme and applicant category. Record a limit or condition instead of converting every benefit into an unconditional yes.",{"children":"The listing label is a starting point. Build a comparison for the actual programme and applicant category. Record a limit or condition instead of converting every benefit into an unconditional yes."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Funding evidence worksheet","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Funding evidence worksheet"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Cost",{"scope":"col","children":"Cost"}],["$","th","What to record",{"scope":"col","children":"What to record"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Tuition"}],["$","td","1",{"children":"Full fee, capped amount or particular credits"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Living support"}],["$","td","1",{"children":"Amount, currency, period and payment start"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Accommodation or meals"}],["$","td","1",{"children":"Cash benefit or service; avoid double counting"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Travel and arrival"}],["$","td","1",{"children":"What must be advanced and what is reimbursed"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Insurance and documents"}],["$","td","1",{"children":"Included, excluded or not confirmed"}]],"$undefined"]}],["$","tr","5",{"children":[[["$","th","0",{"scope":"row","children":"Dependants and research"}],["$","td","1",{"children":"Separate conditions and budget"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","7-A fictional funding-gap calculation",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"A fictional funding-gap calculation"}],[["$","p","If a fictional award confirms 10,000 units of usable support against 13,500 units of relevant expenses, the estimated gap is 3,500. If tuition is separately waived, remove it from expenses before comparing cash. If a benefit is conditional or not yet awarded, keep it out of confirmed funds.",{"children":"If a fictional award confirms 10,000 units of usable support against 13,500 units of relevant expenses, the estimated gap is 3,500. If tuition is separately waived, remove it from expenses before comparing cash. If a benefit is conditional or not yet awarded, keep it out of confirmed funds."}],["$","p","A scholarship described as fully funded can still leave timing or personal-cost questions. Ask what must be paid before the first instalment and whether any renewal conditions apply. The official benefit list, not the headline, determines the comparison.",{"children":"A scholarship described as fully funded can still leave timing or personal-cost questions. Ask what must be paid before the first instalment and whether any renewal conditions apply. The official benefit list, not the headline, determines the comparison."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for A fictional funding-gap calculation","children":[["$","$L4","/guides/cost-of-living-in-italy-for-students/",{"href":"/guides/cost-of-living-in-italy-for-students/","children":["Italy budget worked example",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/germany-blocked-account-calculator/",{"href":"/tools/germany-blocked-account-calculator/","children":["Germany funding calculator",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
25:["$","section","8-Read the funding conditions behind the headline",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Read the funding conditions behind the headline"}],[["$","p","Tuition support, a stipend and full-cost support are different packages. Compare the programme terms and the costs you would still need to meet.",{"children":"Tuition support, a stipend and full-cost support are different packages. Compare the programme terms and the costs you would still need to meet."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Read the funding conditions behind the headline","children":[["$","$L4","/scholarships/turkiye-burslari/",{"href":"/scholarships/turkiye-burslari/","children":["Türkiye Scholarships: eligibility and a stronger application",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/open-doors/",{"href":"/scholarships/open-doors/","children":["Open Doors Scholarship: tracks, portfolio and funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/gates-cambridge/",{"href":"/scholarships/gates-cambridge/","children":["Gates Cambridge Scholarship: deadlines and application planning",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/kfupm/",{"href":"/scholarships/kfupm/","children":["KFUPM scholarships: choose the right graduate route",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
