1c:["$","section","1-Use the DAAD database as a filter, not a promise",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Use the DAAD database as a filter, not a promise"}],[["$","p","Select the country from which you are applying, your current academic status, subject and funding purpose. Open each programme record and verify whether the scholarship owner or the host course receives the application.",{"children":"Select the country from which you are applying, your current academic status, subject and funding purpose. Open each programme record and verify whether the scholarship owner or the host course receives the application."}],["$","p","A programme appearing in a database does not establish personal eligibility. Save the current programme notice and check degree, graduation date, work experience, language, nomination and deadline requirements together.",{"children":"A programme appearing in a database does not establish personal eligibility. Save the current programme notice and check degree, graduation date, work experience, language, nomination and deadline requirements together."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L25",null,{"id":"scholarships/germany:section-2","title":"Check your progress","items":["Applicant country and residence rule checked","Academic status and intended degree match","Application owner identified","Funding coverage and duration recorded","Current official deadline saved"]}],"$undefined","$undefined"]}]
1d:["$","section","2-Bachelor's funding needs a wider plan",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Bachelor's funding needs a wider plan"}],[["$","p","Major German scholarship databases contain far more postgraduate and research opportunities than full-course undergraduate awards. Bachelor's applicants should also inspect the chosen university's international office, admission scholarship notices and any institution-administered Deutschlandstipendium call.",{"children":"Major German scholarship databases contain far more postgraduate and research opportunities than full-course undergraduate awards. Bachelor's applicants should also inspect the chosen university's international office, admission scholarship notices and any institution-administered Deutschlandstipendium call."}],["$","p","Do not treat low tuition as full funding. Semester contributions, housing, insurance, food, travel and visa proof of funds can remain payable even when tuition is limited.",{"children":"Do not treat low tuition as full funding. Semester contributions, housing, insurance, food, travel and visa proof of funds can remain payable even when tuition is limited."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Bachelor's funding needs a wider plan","children":[["$","$L4","/scholarships/bachelors/",{"href":"/scholarships/bachelors/","children":["Bachelor's scholarship planning",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/germany-blocked-account-calculator/",{"href":"/tools/germany-blocked-account-calculator/","children":["Germany cost calculator",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1e:["$","section","3-Separate scholarships from paid doctoral positions",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Separate scholarships from paid doctoral positions"}],[["$","p","A doctoral route can be financed through a scholarship, a structured programme or an employment contract attached to a research project. Compare monthly support or salary, social-security treatment, teaching duties, funding duration and whether admission to a doctoral programme is separate.",{"children":"A doctoral route can be financed through a scholarship, a structured programme or an employment contract attached to a research project. Compare monthly support or salary, social-security treatment, teaching duties, funding duration and whether admission to a doctoral programme is separate."}],["$","p","Use the official Research in Germany routes and the host institution's vacancy page. Contact a supervisor only when you can describe a specific research fit.",{"children":"Use the official Research in Germany routes and the host institution's vacancy page. Contact a supervisor only when you can describe a specific research fit."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Separate scholarships from paid doctoral positions","children":[["$","$L4","/scholarships/phd/",{"href":"/scholarships/phd/","children":["PhD scholarship planning",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1f:["$","section","4-Build a funding comparison before accepting",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Build a funding comparison before accepting"}],[["$","p","Record confirmed tuition support, monthly cash, insurance, travel, family support and the payment start date. Then list costs that remain yours. A headline award amount is not enough to show whether arrival cash or the monthly budget works.",{"children":"Record confirmed tuition support, monthly cash, insurance, travel, family support and the payment start date. Then list costs that remain yours. A headline award amount is not enough to show whether arrival cash or the monthly budget works."}],["$","p","Only subtract funding that is confirmed in writing. Keep a separate contingency for housing deposits and expenses due before the first scholarship payment.",{"children":"Only subtract funding that is confirmed in writing. Keep a separate contingency for housing deposits and expenses due before the first scholarship payment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Build a funding comparison before accepting","children":[["$","$L4","/tools/germany-blocked-account-calculator/",{"href":"/tools/germany-blocked-account-calculator/","children":["Calculate blocked account and study costs",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/scholarship-application/",{"href":"/guides/scholarship-application/","children":["Follow the application workflow",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
