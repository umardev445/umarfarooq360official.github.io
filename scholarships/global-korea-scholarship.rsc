1f:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.studyinkorea.go.kr/en/plan/gksNoticeRead.do?bbsId=BBSMSTR_000000000461&nttId=4522",{"children":["",["$","a",null,{"href":"https://www.studyinkorea.go.kr/en/plan/gksNoticeRead.do?bbsId=BBSMSTR_000000000461&nttId=4522","target":"_blank","rel":"noreferrer","children":"NIIED/Study in Korea:2027 undergraduate GKS notice"}]]}]]]}]
20:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-What the Pakistan 2027 undergraduate example establishes",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"What the Pakistan 2027 undergraduate example establishes"}],[["$","p","The Korean Embassy in Pakistan published a 2027 undergraduate online application window from 15 September 2026 to 30 September 2026, ending 18:00Korea Standard Time, equivalent to 14:00Pakistan time. Those dates have passed at the 19 November 2026 review. Existing interview and screening notices do not reopen entry for someone who missed that application window.",{"children":"The Korean Embassy in Pakistan published a 2027 undergraduate online application window from 15 September 2026 to 30 September 2026, ending 18:00Korea Standard Time, equivalent to 14:00Pakistan time. Those dates have passed at the 19 November 2026 review. Existing interview and screening notices do not reopen entry for someone who missed that application window."}],["$","p","Use this example to see how a country office adds operational instructions to a central programme. It is not a deadline for Indonesian applicants, university-track candidates or a future graduate cycle. A page can retain the word “open” after its dated closing instant; read the dates and any official amendment together. This guide does not establish late acceptance or a replacement round.",{"children":"Use this example to see how a country office adds operational instructions to a central programme. It is not a deadline for Indonesian applicants, university-track candidates or a future graduate cycle. A page can retain the word “open” after its dated closing instant; read the dates and any official amendment together. This guide does not establish late acceptance or a replacement round."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Past country-specific window: not an invitation to apply","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Past country-specific window: not an invitation to apply"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Scope",{"scope":"col","children":"Scope"}],["$","th","Published closing point",{"scope":"col","children":"Published closing point"}],["$","th","Status at review",{"scope":"col","children":"Status at review"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Pakistan 2027 GKS-U embassy route"}],["$","td","1",{"children":"30Sep 2026,18:00KST"}],["$","td","2",{"children":"Past"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Equivalent Pakistan clock"}],["$","td","1",{"children":"30Sep 2026,14:00"}],["$","td","2",{"children":"Same instant, not extra time"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Other country/degree/track"}],["$","td","1",{"children":"Not established by this notice"}],["$","td","2",{"children":"Read its own current instructions"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.mofa.go.kr/pk-en/brd/m_3150/view.do?seq=762182",{"children":["",["$","a",null,{"href":"https://www.mofa.go.kr/pk-en/brd/m_3150/view.do?seq=762182","target":"_blank","rel":"noreferrer","children":"Korean Embassy in Pakistan:2027 undergraduate country route"}]]}]]]}],"$undefined"]}],["$","section","2-Compare the routes by who receives the first application",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Compare the routes by who receives the fi