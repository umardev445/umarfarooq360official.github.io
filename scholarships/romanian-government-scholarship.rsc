23:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original document dependency worksheet","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original document dependency worksheet"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Document",{"scope":"col","children":"Document"}],["$","th","Precondition",{"scope":"col","children":"Precondition"}],["$","th","Evidence of completion",{"scope":"col","children":"Evidence of completion"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Academic record"}],["$","td","1",{"children":"Correct name and qualification details"}],["$","td","2",{"children":"Issuer’s final record"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Translation if required"}],["$","td","1",{"children":"Accepted original and target language"}],["$","td","2",{"children":"Required translation paired with original"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Portal file"}],["$","td","1",{"children":"Current format and page requirements"}],["$","td","2",{"children":"Readable upload and submission receipt"}]],"$undefined"]}]]}]]}]}],"$undefined"]
24:["$","section","4-Keep a private review copy of the exact file you submit",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Keep a private review copy of the exact file you submit"}],[["$","p","Create a local cycle-labelled folder with an untouched original, a working copy and the final submitted version. Compare spelling, dates and qualification titles across your CV and supporting documents. Use clear filenames that let you identify the content without opening every file.",{"children":"Create a local cycle-labelled folder with an untouched original, a working copy and the final submitted version. Compare spelling, dates and qualification titles across your CV and supporting documents. Use clear filenames that let you identify the content without opening every file."}],["$","p","Before submission in an actual open call, reopen each generated file. Check that all pages are legible and that a signature or reverse-side explanation has not been lost. Save the official receipt and record any later request separately. A file uploaded to a draft is not automatically evidence that the application was submitted.",{"children":"Before submission in an actual open call, reopen each generated file. Check that all pages are legible and that a signature or reverse-side explanation has not been lost. Save the official receipt and record any later request separately. A file uploaded to a draft is not automatically evidence that the application was submitted."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","5-Plan after selection without treating the award as arrival completed",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Plan after selection without treating the award as arrival completed"}],[["$","p","If selected, read the actual acceptance and university instructions before making travel commitments. Keep award acceptance, final enrolment, accommodation and immigration steps as separate tasks with their own owners. Ask the responsible institution to clarify a condition instead of inferring it from an unofficial group message.",{"children":"If selected, read the actual acceptance and university instructions before making travel commitments. Keep award acceptance, final enrolment, accommodation and immigration steps as separate tasks with their own owners. Ask the responsible institution to clarify a condition instead of inferring it from an unofficial group message."}],["$","p","Prepare two cash scenarios: one with confirmed support available on its stated date and another for costs that arise earlier. Use your own quotes for travel and temporary accommodation. This method does not claim a benefit amount or guarantee housing. Its purpose is to reveal a timing gap while you can still plan for it.",{"children":"Prepare two cash scenarios: one with confirmed support available on its stated date and another for costs that arise earlier. Use your own quotes for travel and temporary accommodation. This method does not claim a benefit amount or guarantee housing. Its purpose is to reveal a timing gap while you can still plan for it."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Plan after selection without treating the award as arrival completed","children":[["$","$L5","/countries/europe/",{"href":"/countries/europe/","children":["Compare European study routes",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/motivation-letter/",{"href":"/guides/motivation-letter/","children":["Plan a motivation letter",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/scholarships/",{"href":"/scholarships/","children":["Find other scholarship routes",["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
