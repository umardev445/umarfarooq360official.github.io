1c:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":["$","h2",null,{"children":"Continue with a relevant guide"}]}],["$","div",null,{"className":"related-grid","children":[["$","$L5","countries/europe",{"href":"/countries/europe/","children":[["$","span",null,{"children":"Regional guide"}],["$","h3",null,{"children":"Scholarships in Europe for international students"}],["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","scholarships/masters",{"href":"/scholarships/masters/","children":[["$","span",null,{"children":"Postgraduate funding"}],["$","h3",null,{"children":"Master's scholarships for international students"}],["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","guides/motivation-letter",{"href":"/guides/motivation-letter/","children":[["$","span",null,{"children":"Writing guide"}],["$","h3",null,{"children":"How to write a scholarship motivation letter"}],["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","guides/pakistan-academic-document-attestation",{"href":"/guides/pakistan-academic-document-attestation/","children":[["$","span",null,{"children":"Application and planning guide"}],["$","h3",null,{"children":"Pakistan academic-document attestation: HEC, IBCC and destination checks"}],["$","$L6",null,{"ref":"$undefined","iconNode":"$8:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
1d:["$","p","First decide what remains useful before a new announcement: reading programme options, obtaining accurate academic records and identifying a real training need. Keep any old checklist labelled with its cycle. When new instructions appear, compare the requirements before paying for time-sensitive documents or assuming the previous deadline has shifted by one year.",{"children":"First decide what remains useful before a new announcement: reading programme options, obtaining accurate academic records and identifying a real training need. Keep any old checklist labelled with its cycle. When new instructions appear, compare the requirements before paying for time-sensitive documents or assuming the previous deadline has shifted by one year."}]
1e:["$","section","Test whether the degree-language route fits your plan",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Test whether the degree-language route fits your plan"}],[["$","p","The MFA scheme is for non-EU applicants subject to stated exclusions; Medicine, Dental Medicine and Pharmacy are excluded. It provides Romanian-taught bachelor’s and master’s routes, with language preparation where applicable. A doctoral school can specify a different study language and requires tutor agreement under the published scheme.",{"children":"The MFA scheme is for non-EU applicants subject to stated exclusions; Medicine, Dental Medicine and Pharmacy are excluded. It provides Romanian-taught bachelor’s and master’s routes, with language preparation where applicable. A doctoral school can specify a different study language and requires tutor agreement under the published scheme."}],["$","p","Use the language question as an academic decision. In a fictional case, an applicant wants an English-taught master’s because they cannot commit to Romanian study. They should research another suitable route instead of assuming an English-language application portal makes the funded degree English-taught. Another applicant willing to study in Romanian should plan the preparation period alongside the intended degree rather than treating it as a minor administrative formality.",{"children":"Use the language question as an academic decision. In a fictional case, an applicant wants an English-taught master’s because they cannot commit to Romanian study. They should research another suitable route instead of assuming an English-language application portal makes the funded degree English-taught. Another applicant willing to study in Romanian should plan the preparation period alongside the intended degree rather than treating it as a minor administrative formality."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original degree-language decision worksheet","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original degree-language decision worksheet"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Your intended route",{"scope":"col","children":"Your intended route"}],["$","th","Decision to make",{"scope":"col","children":"Decision to make"}],["$","th","Evidence to retain",{"scope":"col","children":"Evidence to retain"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Bachelor’s or master’s"}],["$","td","1",{"children":"Am I prepared for Romanian study?"}],["$","td","2",{"children":"Programme and language pathway"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Doctoral study"}],["$","td","1",{"children":"Which language and tutor arrangement applies?"}],["$","td","2",{"children":"Doctoral-school instructions"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Excluded subject"}],["$","td","1",{"children":"Does this scheme cover my field?"}],["$","td","2",{"children":"Owner’s explicit scope"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","article",null,{"className":"article-body article-body--guide","children":[null,null,["$","section","2-Make the academic case before making a document bundle",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Make the academic case before making a document bundle"}],[["$","p","Write a short degree-choice note containing the subject you want to learn, a preparation gap from your previous study and a realistic use for the training. This is an editorial exercise, not an official application essay. It helps you avoid choosing a programme solely because a scholarship website lists it.",{"children":"Write a short degree-choice note containing the subject you want to learn, a preparation gap from your previous study and a realistic use for the training. This is an editorial exercise, not an official application essay. It helps you avoid choosing a programme solely because a scholarship website lists it."}],["$","p","For a fictional engineering applicant, the useful gap might be learning how to evaluate measurement uncertainty after a small project produced inconsistent readings. The next research task is to identify actual programmes addressing that gap. Do not invent modules, laboratory access or employment outcomes to strengthen the note. Mark each programme feature with the owner page where you found it.",{"children":"For a fictional engineering applicant, the useful gap might be learning how to evaluate measurement uncertainty after a small project produced inconsistent readings. The next research task is to identify actual programmes addressing that gap. Do not invent modules, laboratory access or employment outcomes to strengthen the note. Mark each programme feature with the owner page where you found it."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Use a dependency sheet for translations and academic records",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Use a dependency sheet for translations and academic records"}],[["$","p","Before requesting a service, record each document’s issuing authority, original language, exact requirement and next dependent action. The published scheme requires academic records and identity evidence, with specified authorised translations and authentication rules. Read the full owner list for your situation rather than treating this worksheet as its replacement.",{"children":"Before requesting a service, record each document’s issuing authority, original language, exact requirement and next dependent action. The published scheme requires academic records and identity evidence, with specified authorised translations and authentication rules. Read the full owner list for your situation rather than treating this worksheet as its replacement."}],["$","p","An original transcript that still contains a name error should be corrected through the issuer before translation. Translating an incorrect record can create two versions that require correction. If two receiving tasks request different formats, keep their requirements separate and obtain clarification before ordering one expensive package on an informal assurance.",{"children":"An original transcript that still contains a name error should be corrected through the issuer before translation. Translating an incorrect record can create two versions that require correction. If two receiving tasks request different formats, keep their requirements separate and obtain clarification before ordering one expensive package on an informal assurance."}]],"$undefined","$L23","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L24","$L25"]}]
20:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L5","https://scholarships.studyinromania.gov.ro/scholarship-about",{"href":"https://scholarships.studyinromania.gov.ro/scholarship-about","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Romanian MFA scholarship: programme information"}],["$","span",null,{"children":"Reviewed 23 November 2026. The visible call is 16 February–31 March 2026 and is past. No 2027 window is inferred."}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L5","https://scholarships.studyinromania.gov.ro/scholarship-faq",{"href":"https://scholarships.studyinromania.gov.ro/scholarship-faq","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Romanian MFA scholarship: applicant FAQ"}],["$","span",null,{"children":"Reviewed 23 November 2026: degree/language and document-scope cross-check; same historical 2026 call, no future deadline inferred."}]]}],["$","$L6",null,{"ref":"$undefined","iconNode":"$20:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
