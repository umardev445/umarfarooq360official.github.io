1b:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"The MFA page still shows the closed 2026 call. Bachelor’s and master’s awards use Romanian; doctoral study can use a language set by the school. Read exclusions and the next call before applying."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose your degree/language route, then prepare a document dependency record without inventing a future deadline."]}],"$undefined"]}],["$","figure",null,{"className":"page-visual day15-guide-visual page-visual--inline","children":[["$","img",null,{"src":"/images/day25/application-workspace-1280.webp","srcSet":"/images/day25/application-workspace-640.webp 640w, /images/day25/application-workspace-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), (max-width: 1150px) calc(100vw - 64px), 760px","width":1280,"height":853,"alt":"Illustrative scene of two students comparing application folders in a library","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Illustrative study scene. The people do not represent this programme or university."}]]}],false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","The reviewed call is historical, so choose a preparation task",{"href":"#section-1","children":"The reviewed call is historical, so choose a preparation task"}],["$","a","Test whether the degree-language route fits your plan",{"href":"#section-2","children":"Test whether the degree-language route fits your plan"}],["$","a","Make the academic case before making a document bundle",{"href":"#section-3","children":"Make the academic case before making a document bundle"}],["$","a","Use a dependency sheet for translations and academic records",{"href":"#section-4","children":"Use a dependency sheet for translations and academic records"}],["$","a","Keep a private review copy of the exact file you submit",{"href":"#section-5","children":"Keep a private review copy of the exact file you submit"}],["$","a","Plan after selection without treating the award as arrival completed",{"href":"#section-6","children":"Plan after selection without treating the award as arrival completed"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","The reviewed call is historical, so choose a preparation task",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"The reviewed call is historical, so choose a preparation task"}],[["$","p","The owner displays 16 February–31 March 2026 for its application period. Those dates are past on 23 November 2026. A visible account or application button does not establish a new call. This guide is for preparing a reasoned choice and a checkable file; it does not announce 2027 applications.",{"children":"The owner displays 16 February–31 March 2026 for its application period. Those dates are past on 23 November 2026. A visible account or application button does not establish a new call. This guide is for preparing a reasoned choice and a checkable file; it does not announce 2027 applications."}],"$L1d"],"$undefined","$undefined","$undefined","$undefined","$undefined","$