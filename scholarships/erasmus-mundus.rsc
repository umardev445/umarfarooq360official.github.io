22:["$","$L2d",null,{"id":"scholarships/erasmus-mundus:section-1","title":"Check your progress","items":["Choose the exact joint master’s.","Read its current consortium call.","Check admission and scholarship cut-offs.","Compare mobility costs and alternatives."]}]
23:["$","section","1-How the programme model works",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"How the programme model works"}],[["$","p","A Joint Master is designed and delivered by multiple higher-education institutions, often with study in more than one country. The consortium defines the curriculum, mobility path, degree award, entry requirements and application system.",{"children":"A Joint Master is designed and delivered by multiple higher-education institutions, often with study in more than one country. The consortium defines the curriculum, mobility path, degree award, entry requirements and application system."}],["$","p","There is no single application form covering every Joint Master. Search the current Erasmus Mundus catalogue, open each programme's own website and compare only courses that match your academic preparation and goals.",{"children":"There is no single application form covering every Joint Master. Search the current Erasmus Mundus catalogue, open each programme's own website and compare only courses that match your academic preparation and goals."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","2-Typical 2027 application timing",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Typical 2027 application timing"}],[["$","p","The European Commission advises that applications are normally submitted between October and January for courses beginning in the following academic year. Exact opening dates, deadlines and time zones are programme-specific, so create a separate entry for each consortium.",{"children":"The European Commission advises that applications are normally submitted between October and January for courses beginning in the following academic year. Exact opening dates, deadlines and time zones are programme-specific, so create a separate entry for each consortium."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","3-Eligibility and final-year applicants",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Eligibility and final-year applicants"}],[["$","p","Applicants normally need a bachelor's degree or can be in the final year of bachelor's study, provided they graduate before the programme begins. A consortium may add subject prerequisites, grade standards, language evidence and document formats. Nationality alone does not prove eligibility.",{"children":"Applicants normally need a bachelor's degree or can be in the final year of bachelor's study, provided they graduate before the programme begins. A consortium may add subject prerequisites, grade standards, language evidence and document formats. Nationality alone does not prove eligibility."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","4-What an Erasmus Mundus scholarship may cover",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"What an Erasmus Mundus scholarship may cover"}],[["$","p","EU-funded scholarships may contribute to participation costs and support travel, visa and living expenses. The precise scholarship terms, payment schedule and uncovered costs belong to the selected programme and current intake. Calculate deposits, document costs and the period before the first payment.",{"children":"EU-funded scholarships may contribute to participation costs and support travel, visa and living expenses. The precise scholarship terms, payment schedule and uncovered costs belong to the selected programme and current intake. Calculate deposits, document costs and the period before the first payment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
27:["$","section","5-Compare mobility paths, not only course titles",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Compare mobility paths, not only course titles"}],[["$","p","Read where each semester is delivered, whether a mobility track is fixed or selected later, which institutions award the degree and what language is used at every stage. Visa, residence and housing arrangements can change as the programme moves between countries.",{"children":"Read where each semester is delivered, whether a mobility track is fixed or selected later, which institutions award the degree and what language is used at every stage. Visa, residence and housing arrangements can change as the programme moves between countries."}],["$","p","Choose a programme because its combined curriculum solves a real academic or professional gap, not only because it offers several destinations.",{"children":"Choose a programme because its combined curriculum solves a real academic or professional gap, not only because it offers several destinations."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
28:["$","section","6-Prepare a programme-specific application",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Prepare a programme-specific application"}],[["$","p","Connect prior coursework, projects or work to the Joint Master's learning outcomes. Explain why the multi-institution structure matters to your goal. Use the consortium's requested document names and limits, and do not submit one unchanged motivation letter across unrelated programmes.",{"children":"Connect prior coursework, projects or work to the Joint Master's learning outcomes. Explain why the multi-institution structure matters to your goal. Use the consortium's requested document names and limits, and do not submit one unchanged motivation letter across unrelated programmes."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Verify the consortium and intake",{"children":"Verify the consortium and intake"}],["$","li","Map subject prerequisites",{"children":"Map subject prerequisites"}],["$","li","Confirm language evidence",{"children":"Confirm language evidence"}],["$","li","Prepare degree and transcript documents",{"children":"Prepare degree and transcript documents"}],["$","li","Explain mobility-specific fit",{"children":"Explain mobility-specific fit"}],["$","li","Check scholarship consideration method",{"children":"Check scholarship consideration method"}],["$","li","Submit through the programme portal",{"children":"Submit through the programme portal"}]]}],"$undefined","$undefined","$undefined"]}]
29:["$","section","7-Fraud and fee checks",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Fraud and fee checks"}],[["$","p","Reach the programme through the European Commission catalogue or recognised consortium domain. Verify any university or application fee on that official site. Nobody can reserve an Erasmus Mundus scholarship in exchange for payment or guarantee selection through a private message.",{"children":"Reach the programme through the European Commission catalogue or recognised consortium domain. Verify any university or application fee on that official site. Nobody can reserve an Erasmus Mundus scholarship in exchange for payment or guarantee selection through a private message."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2a:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://erasmus-plus.ec.europa.eu/opportunities/individuals/students/erasmus-mundus-joint-masters",{"href":"https://erasmus-plus.ec.europa.eu/opportunities/individuals/students/erasmus-mundus-joint-masters","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Erasmus Mundus Joint Masters"}],["$","span",null,{"children":"European Commission overview, timing and application route"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
2b:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","When do Erasmus Mundus 2027 applications open?",{"children":[["$","summary",null,{"children":["When do Erasmus Mundus 2027 applications open?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Many programmes accept applications between October and January, but each consortium publishes its own opening date and deadline. Check the selected programme website."}]]}],["$","details","Is Erasmus Mundus fully funded?",{"children":[["$","summary",null,{"children":["Is Erasmus Mundus fully funded?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Top candidates may receive EU-funded scholarships that support participation, travel, visa and living expenses. Exact coverage and personal costs must be checked for the current programme."}]]}],["$","details","Can final-year bachelor's students apply?",{"children":[["$","summary",null,{"children":["Can final-year bachelor's students apply?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"They may be able to apply if they will graduate before the master's programme begins and meet the consortium's evidence requirements."}]]}],["$","details","Do I apply on one central Erasmus portal?",{"children":[["$","summary",null,{"children":["Do I apply on one central Erasmus portal?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Applications are submitted directly to the institution or consortium running the selected Joint Master, using its official process."}]]}],["$","details","Can Pakistani students apply for Erasmus Mundus?",{"children":[["$","summary",null,{"children":["Can Pakistani students apply for Erasmus Mundus?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Programmes are open globally in principle, but every Pakistani applicant must meet the selected consortium's academic, language and document rules."}]]}]]}]]}]
