1a:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Erasmus Mundus Joint Masters are international degrees delivered by university consortia. Students apply to the individual programme, and top candidates may receive EU-funded scholarships covering major participation and mobility costs."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Start with the comparison or checklist below, then open the current instructions for your exact programme or route."]}],"$undefined"]}],false,["$","$L1c",null,{"records":[{"id":"erasmus-mundus-2027","title":"Erasmus Mundus Joint Masters 2027","provider":"European Union","type":"Scholarship","level":"Master's","country":"Multiple European countries","region":"Europe","funding":"Fully funded","deadline":"Consortium-specific; check the current programme call","status":"Check official site","summary":"Joint master's programmes use their own calls and scholarship deadlines. The European Commission describes many applications between October and January, but this umbrella record is not a confirmed open call.","tags":["Europe","Joint degree","Mobility"],"source":"https://erasmus-plus.ec.europa.eu/opportunities/individuals/students/erasmus-mundus-joint-masters","sourceLabel":"European Commission – Erasmus+","checked":"13 October 2026","featured":true}]}],["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Compare the consortium before applying",{"href":"#section-1","children":"Compare the consortium before applying"}],["$","a","How the programme model works",{