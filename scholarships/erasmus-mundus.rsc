21:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","When do Erasmus Mundus 2027 applications open?",{"children":[["$","summary",null,{"children":["When do Erasmus Mundus 2027 applications open?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Many programmes accept applications between October and January, but each consortium publishes its own opening date and deadline. Check the selected programme website."}]]}],["$","details","Is Erasmus Mundus fully funded?",{"children":[["$","summary",null,{"children":["Is Erasmus Mundus fully funded?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Top candidates may receive EU-funded scholarships that support participation, travel, visa and living expenses. Exact coverage and personal costs must be checked for the current programme."}]]}],["$","details","Can final-year bachelor's students apply?",{"children":[["$","summary",null,{"children":["Can final-year bachelor's students apply?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"They may be able to apply if they will graduate before the master's programme begins and meet the consortium's evidence requirements."}]]}],["$","details","Do I apply on one central Erasmus portal?",{"children":[["$","summary",null,{"children":["Do I apply on one central Erasmus portal?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Applications are submitted directly to the institution or consortium running the selected Joint Master, using its official process."}]]}],["$","details","Can Pakistani students apply for Erasmus Mundus?",{"children":[["$","summary",null,{"children":["Can Pakistani students apply for Erasmus Mundus?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Programmes are open globally in principle, but every Pakistani applicant must meet the selected consortium's academic, language and document rules."}]]}]]}]]}]
