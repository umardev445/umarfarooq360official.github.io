24:["$","section","3-Eligibility and final-year applicants",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Eligibility and final-year applicants"}],[["$","p","Applicants normally need a bachelor's degree or can be in the final year of bachelor's study, provided they graduate before the programme begins. A consortium may add subject prerequisites, grade standards, language evidence and document formats. Nationality alone does not prove eligibility.",{"children":"Applicants normally need a bachelor's degree or can be in the final year of bachelor's study, provided they graduate before the programme begins. A consortium may add subject prerequisites, grade standards, language evidence and document formats. Nationality alone does not prove eligibility."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","4-Turn entry requirements into an evidence check",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Turn entry requirements into an evidence check"}],[["$","p","Read the entry rules before spending time on an essay. Copy the exact requirement into your worksheet and identify the document that proves it. If a requirement is ambiguous, ask the consortium a narrow question and save its written answer; a similar course elsewhere is not evidence of acceptance.",{"children":"Read the entry rules before spending time on an essay. Copy the exact requirement into your worksheet and identify the document that proves it. If a requirement is ambiguous, ask the consortium a narrow question and save its written answer; a similar course elsewhere is not evidence of acceptance."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Your document review before drafting","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Your document review before drafting"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Requirement",{"scope":"col","children":"Requirement"}],["$","th","Evidence to inspect",{"scope":"col","children":"Evidence to inspect"}],["$","th","Question to resolve",{"scope":"col","children":"Question to resolve"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Academic background"}],["$","td","1",{"children":"Transcript, degree title and relevant module descriptions"}],["$","td","2",{"children":"Does the course require named subjects or credits?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Degree completion"}],["$","td","1",{"children":"Final certificate or official expected-graduation evidence"}],["$","td","2",{"children":"What must be completed before enrolment?"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Language evidence"}],["$","td","1",{"children":"Accepted test or explicitly permitted alternative"}],["$","td","2",{"children":"Are component scores, validity dates or exemptions specified?"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"References"}],["$","td","1",{"children":"Referee invitation, submission method and due date"}],["$","td","2",{"children":"Must the referee submit separately?"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Document format"}],["$","td","1",{"children":"Translation, certification and file-size instructions"}],["$","td","2",{"children":"Is the uploaded copy sufficient at this stage?"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","5-Worked example: choose which application deserves your time",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Worked example: choose which application deserves your time"}],[["$","p","This is a fictional planning example, not a list of live programmes or an eligibility decision. A final-year engineering student has time for two applications. Their first task is to check evidence, rather than rank destinations by popularity.",{"children":"This is a fictional planning example, not a list of live programmes or an eligibility decision. A final-year engineering student has time for two applications. Their first task is to check evidence, rather than rank destinations by popularity."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Illustrative shortlist: replace these assumptions with real calls","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Illustrative shortlist: replace these assumptions with real calls"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Fictional option",{"scope":"col","children":"Fictional option"}],["$","th","Evidence found",{"scope":"col","children":"Evidence found"}],["$","th","Practical decision",{"scope":"col","children":"Practical decision"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Programme A"}],["$","td","1",{"children":"Relevant modules match, but the scholarship page still shows last year's intake"}],["$","td","2",{"children":"Keep on watch; do not label its scholarship open"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Programme B"}],["$","td","1",{"children":"Current call found; a required subject is missing from the transcript"}],["$","td","2",{"children":"Ask whether the documented alternative is accepted before drafting"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Programme C"}],["$","td","1",{"children":"Current call, academic match and accepted language evidence are documented"}],["$","td","2",{"children":"Prioritise the application and schedule referee requests"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"If Programme C requires a referee to submit separately, your uploaded essay does not finish the application. Give that task its own deadline and confirmation field. If Programme B confirms that the missing prerequisite is mandatory, remove it from the active shortlist and use the time for a better academic match."}]]}],"$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Worked example: choose which application deserves your time","children":[["$","a","/downloads/erasmus-mundus-shortlist.csv",{"href":"/downloads/erasmus-mundus-shortlist.csv","download":true,"children":["Download a blank Erasmus Mundus comparison sheet (CSV)",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
27:["$","section","6-What an Erasmus Mundus scholarship may cover",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"What an Erasmus Mundus scholarship may cover"}],[["$","p","EU-funded scholarships may contribute to participation costs and support travel, visa and living expenses. The precise scholarship terms, payment schedule and uncovered costs belong to the selected programme and current intake. Calculate deposits, document costs and the period before the first payment.",{"children":"EU-funded scholarships may contribute to participation costs and support travel, visa and living expenses. The precise scholarship terms, payment schedule and uncovered costs belong to the selected programme and current intake. Calculate deposits, document costs and the period before the first payment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
28:["$","section","7-Plan the cash needed before a scholarship payment",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Plan the cash needed before a scholarship payment"}],[["$","p","Separate the published award from the money you must have before it arrives. Put document preparation, any authorised application charge, travel, housing deposit and the first weeks of living expenses on a timeline. Only subtract funding that is actually awarded and available by the date of the expense.",{"children":"Separate the published award from the money you must have before it arrives. Put document preparation, any authorised application charge, travel, housing deposit and the first weeks of living expenses on a timeline. Only subtract funding that is actually awarded and available by the date of the expense."}],["$","p","For example, a fictional EUR 450 housing deposit plus EUR 300 of arrival expenses creates EUR 750 to arrange before an allowance is received. These are example inputs, not recommended budgets or official scholarship amounts. Replace them with quotes for the actual mobility cities and check whether any costs are reimbursed later.",{"children":"For example, a fictional EUR 450 housing deposit plus EUR 300 of arrival expenses creates EUR 750 to arrange before an allowance is received. These are example inputs, not recommended budgets or official scholarship amounts. Replace them with quotes for the actual mobility cities and check whether any costs are reimbursed later."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","8-Compare mobility paths, not only course titles",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Compare mobility paths, not only course titles"}],[["$","p","Read where each semester is delivered, whether a mobility track is fixed or selected later, which institutions award the degree and what language is used at every stage. Visa, residence and housing arrangements can change as the programme moves between countries.",{"children":"Read where each semester is delivered, whether a mobility track is fixed or selected later, which institutions award the degree and what language is used at every stage. Visa, residence and housing arrangements can change as the programme moves between countries."}],["$","p","Choose a programme because its combined curriculum solves a real academic or professional gap, not only because it offers several destinations.",{"children":"Choose a programme because its combined curriculum solves a real academic or professional gap, not only because it offers several destinations."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2a:["$","section","9-Prepare a programme-specific application",{"className":"article-section","id":"section-10","children":[["$","h2",null,{"children":"Prepare a programme-specific application"}],[["$","p","Connect prior coursework, projects or work to the Joint Master's learning outcomes. Explain why the multi-institution structure matters to your goal. Use the consortium's requested document names and limits, and do not submit one unchanged motivation letter across unrelated programmes.",{"children":"Connect prior coursework, projects or work to the Joint Master's learning outcomes. Explain why the multi-institution structure matters to your goal. Use the consortium's requested document names and limits, and do not submit one unchanged motivation letter across unrelated programmes."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Verify the consortium and intake",{"children":"Verify the consortium and intake"}],["$","li","Map subject prerequisites",{"children":"Map subject prerequisites"}],["$","li","Confirm language evidence",{"children":"Confirm language evidence"}],["$","li","Prepare degree and transcript documents",{"children":"Prepare degree and transcript documents"}],["$","li","Explain mobility-specific fit",{"children":"Explain mobility-specific fit"}],["$","li","Check scholarship consideration method",{"children":"Check scholarship consideration method"}],["$","li","Submit through the programme portal",{"children":"Submit through the programme portal"}]]}],"$undefined","$undefined","$undefined"]}]
2b:["$","section","10-Fraud and fee checks",{"className":"article-section","id":"section-11","children":[["$","h2",null,{"children":"Fraud and fee checks"}],[["$","p","Reach the programme through the European Commission catalogue or recognised consortium domain. Verify any university or application fee on that official site. Nobody can reserve an Erasmus Mundus scholarship in exchange for payment or guarantee selection through a private message.",{"children":"Reach the programme through the European Commission catalogue or recognised consortium domain. Verify any university or application fee on that official site. Nobody can reserve an Erasmus Mundus scholarship in exchange for payment or guarantee selection through a private message."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
