cope":"row","children":"Submission and later stages"}],["$","td","1",{"children":"Application, references and offer conditions"}],["$","td","2",{"children":"Current official timeline"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined",["$","$L20",null,{"id":"scholarships/chevening:section-1","title":"Check your progress","items":["Open current eligibility rules.","Check each selected course.","Prepare verifiable examples.","Record all separate milestones."]}],"$undefined","$undefined"]}],["$","section","1-Current 2027–2028 application status",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Current 2027–2028 application status"}],[["$","p","Checked 13 October 2026: Chevening's official country page marks the 2027–2028 application round closed. The central scholarship form closed on 6 October at 11:00 UTC. A later course or offer deadline does not reopen the scholarship form.",{"children":"Checked 13 October 2026: Chevening's official country page marks the 2027–2028 application round closed. The central scholarship form closed on 6 October at 11:00 UTC. A later course or offer deadline does not reopen the scholarship form."}],["$","p","Existing candidates should retain their submission confirmation, monitor the registered email and follow the official assessment and interview instructions. The timeline lists 8 July 2027 at 17:00 BST for the required unconditional eligible university offer; this is a later stage, not a new application window.",{"children":"Existing candidates should retain their submission confirmation, monitor the registered email and follow the official assessment and interview instructions. The timeline lists 8 July 2027 at 17:00 BST for the required unconditional eligible university offer; this is a later stage, not a new application window."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","2-Check eligi