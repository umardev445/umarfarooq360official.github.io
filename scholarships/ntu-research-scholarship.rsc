1d:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Choose a full-time research programme and verify its school-specific RSS availability and deadline. NTU’s current terms distinguish tuition, stipend, renewal and duties; indicating scholarship interest is not an award. The NBS August 2027 window is one specific example, not every school’s deadline."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Save the chosen programme’s current instructions and complete the programme-identity and research-fit worksheets before relying on a central deadline."]}],"$undefined"]}],["$","figure",null,{"className":"page-visual day15-guide-visual page-visual--inline","children":[["$","img",null,{"src":"/images/day15/study-desk-1280.webp","srcSet":"/images/day15/study-desk-640.webp 640w, /images/day15/study-desk-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Illustrative scene of students preparing research notes in a library","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Illustrative study scene. The people and setting do not represent this scholarship or university."}]]}],false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Identify the school and research degree before using a deadline",{"href":"#section-1","children":"Identify the school and research degree before using a deadline"}],["$","a","Read an August 2027 example without applying it to every school",{"href":"#section-2","children":"Read an August 2027 example without applying it to every school"}],["$","a","Use an evidence map for research fit",{"href":"#section-3","children":"Use an evidence map for research fit"}],["$","a","Read the stipend and support period as written",{"href":"#section-4","children":"Read the stipend and support period as written"}],["$","a","No bond does not mean no scholarship duties",{"href":"#section-5","children":"No bond does not mean no scholarship duties"}],["$","a","Prepare cash before the first payment",{"href":"#section-6","children":"Prepare cash before the first payment"}],["$","a","Check the admission form and scholarship interest together",{"href":"#section-7","children":"Check the admission form and scholarship interest together"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","Identify the school and research degree before using a deadline",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Identify the school and research degree before using a deadline"}],[["$","p","The NTU Research Scholarship supports graduate research rather than every taught master’s programme carrying NTU’s name. The central RSS page describes full-time research candidates and a minimum Honours(Distinction) or equivalent; admission and scholarship assessment still depend on the chosen programme and school. A central eligibility statement does not establish that a particular school has funding for every research master’s course.",{"children":"The NTU Research Scholarship supports graduate research rather than every taught master’s programme carrying NTU’s name. The central RSS page describes full-time research candidates and a minimum Honours(Distinction) or equivalent; admission and scholarship assessment still depend on the chosen programme and school. A central eligibility statement does not establish that a particular school has funding for every research master’s course."}],"$L1f"],"$undefined","$L20","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]]}],"$L21",false,false,false,"$L22",false,"$L23","$L24"]}],"$L25"]}]
