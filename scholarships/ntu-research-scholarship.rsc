22:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Read an August 2027 example without applying it to every school",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Read an August 2027 example without applying it to every school"}],[["$","p","Nanyang Business School explicitly lists its RSS application period for August 2027 as 1 October 2026–31 January 2027. That is a useful named example, not a university-wide deadline. The central research guide also lists earlier school-specific cutoffs, including 15 November for several arts, humanities, social-science and communication schools. At the 19 November review that listed November date had passed; a January date elsewhere does not reopen it.",{"children":"Nanyang Business School explicitly lists its RSS application period for August 2027 as 1 October 2026–31 January 2027. That is a useful named example, not a university-wide deadline. The central research guide also lists earlier school-specific cutoffs, including 15 November for several arts, humanities, social-science and communication schools. At the 19 November review that listed November date had passed; a January date elsewhere does not reopen it."}],["$","p","Record the exact programme deadline and whether the supporting documents must arrive by the same point. If the school’s instructions and a central annual table appear inconsistent, ask the named school using your intended intake. Do not choose the more convenient date. Where a source gives only a calendar date, obtain its closing-time instructions before relying on an exact-time conversion.",{"children":"Record the exact programme deadline and whether the supporting documents must arrive by the same point. If the school’s instructions and a central annual table appear inconsistent, ask the named school using your intended intake. Do not choose the more convenient date. Where a source gives only a calendar date, obtain its closing-time instructions before relying on an exact-time conversion."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Dated owner-source comparison","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Dated owner-source comparison"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Owner scope",{"scope":"col","children":"Owner scope"}],["$","th","Published example",{"scope":"col","children":"Published example"}],["$","th","Use it for",{"scope":"col","children":"Use it for"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"NBS PhD/RSS,August 2027"}],["$","td","1",{"children":"1Oct 2026–31Jan 2027"}],["$","td","2",{"children":"The named business-school route"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Central school exceptions"}],["$","td","1",{"children":"Several schools list 15 November"}],["$","td","2",{"children":"Checking whether an earlier school cutoff controls"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Your chosen degree"}],["$","td","1",{"children":"Reopen its current instructions"}],["$","td","2",{"children":"Final application and document timing"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.ntu.edu.sg/business/admissions/phd-programme/admission",{"children":["",["$","a",null,{"href":"https://www.ntu.edu.sg/business/admissions/phd-programme/admission","target":"_blank","rel":"noreferrer","children":"Nanyang Business School: August 2027 research application dates"}]]}],"$L26"]]}],"$undefined"]}],"$L27","$L28","$L29","$L2a","$L2b"]}]
