1a:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"The GIST FAQ says international graduate scholarships do not need a separate application. It also requires application-fee payment for a valid application and lists a one-timeKRW 680,000 matriculation fee. Current funding amounts and exceptions need the applicable guide and award terms."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Use the official graduate schedule and document list for your intended intake, then record the application payment and the conditions on each funding component."]}],"$undefined"]}],["$","figure",null,{"className":"page-visual day15-guide-visual page-visual--inline","children":[["$","img",null,{"src":"/images/day25/application-workspace-1280.webp","srcSet":"/images/day25/application-workspace-640.webp 640w, /images/day25/application-workspace-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), (max-width: 1150px) calc(100vw - 64px), 760px","width":1280,"height":853,"alt":"Illustrative scene of two students comparing application folders in a library","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Illustrative study scene. The people do not represent this programme or university."}]]}],false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",