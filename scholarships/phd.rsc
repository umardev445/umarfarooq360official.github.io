25:["$","section","6-Check the 2027 scholarship application route",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Check the 2027 scholarship application route"}],[["$","p","These programme guides separate the entry qualification, funding conditions and submission dependencies. Recheck the official instructions for the intended intake before applying; a school nomination, referee form or university application can be a separate task.",{"children":"These programme guides separate the entry qualification, funding conditions and submission dependencies. Recheck the official instructions for the intended intake before applying; a school nomination, referee form or university application can be a separate task."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Check the 2027 scholarship application route","children":[["$","$L5","/scholarships/oist-phd/",{"href":"/scholarships/oist-phd/","children":["OIST PhD Scholarship 2027: funding and application guide",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/scholarships/hong-kong-phd-fellowship/",{"href":"/scholarships/hong-kong-phd-fellowship/","children":["Hong Kong PhD Fellowship Scheme 2027/28: application guide",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/scholarships/gates-cambridge/",{"href":"/scholarships/gates-cambridge/","children":["Gates Cambridge 2027: course-specific funding deadlines",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/scholarships/kaust/",{"href":"/scholarships/kaust/","children":["KAUST Fall 2027: graduate admission and fellowship",["$","$L6",null,{"ref":"$undefined","