1e:["$","section",null,{"className":"content-block","aria-labelledby":"relevant-listings","children":[["$","div",null,{"className":"content-block__heading","children":[["$","h2",null,{"id":"relevant-listings","children":"Relevant opportunities"}],["$","p",null,{"children":"22 official-source records match this topic. Check category and applicant conditions before applying."}]]}],["$","$L21",null,{"items":[{"id":"knight-hennessy-2027","title":"Knight-Hennessy Scholars 2027","provider":"Stanford University","type":"Scholarship","level":"Graduate","country":"United States","region":"North America","funding":"Fully funded","deadline":"6 October 2026, 1:00 p.m. PT","deadlineDate":"2026-10-06","deadlineAt":"2026-10-06T13:00:00-07:00","status":"Closed","summary":"The 2027 KHS application is closed. Existing candidates must still follow their separate Stanford degree deadlines; the next KHS cohort is announced to open in summer 2027.","tags":["Stanford","Graduate study","Leadership"],"source":"https://knight-hennessy.stanford.edu/admission","sourceLabel":"Knight-Hennessy official website","checked":"23 October 2026","featured":false},{"id":"rhodes-2027","title":"Rhodes Scholarship 2027","provider":"Rhodes Trust","type":"Scholarship","level":"Graduate","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"2027-entry round closed; next applications reopen in 2027 for 2028 entry","status":"Closed","summary":"Applications are closed. Prepare by constituency and eligible Oxford course; future-cycle exact dates must come from the next official call.","tags":["Oxford","Postgraduate","Leadership"],"source":"https://www.rhodeshouse.ox.ac.uk/scholarships/the-rhodes-scholarship/","sourceLabel":"Rhodes Trust: current application status","checked":"24 October 2026","featured":false},{"id":"gates-cambridge-2027","title":"Gates Cambridge Scholarship","provider":"University of Cambridge","type":"Scholarship","level":"Graduate","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"Course-specific: 8 Dec 2026 or 6 Jan 2027 at 23:59 GMT; US round closed","deadlineDate":"$undefined","milestones":"$undefined","status":"Check official site","summary":"Other eligible applicants use the exact course funding deadline. The January date is not an alternative for a December course; complete references by the applicable date.","tags":["Cambridge","Master's","PhD"],"source":"https://www.student-funding.cam.ac.uk/fund/gates-cambridge-scholarship-2026","sourceLabel":"Cambridge: Gates international round for 2027/28","checked":"3 November 2026","featured":true,"deadlineAt":"$undefined"},{"id":"commonwealth-phd-2027","title":"Commonwealth PhD Scholarships 2027–2028","provider":"Commonwealth Scholarship Commission","type":"Scholarship","level":"PhD","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"20 October 2026, 16:00 BST","deadlineDate":"2026-10-20","status":"Closed","summary":"The published central 2027–2028 deadline of 20 October 2026 at 16:00 BST has passed. Existing applicants should retain confirmations and follow CSC and nominator instructions; check the official portal for any amendment.","tags":["Commonwealth","Research","PhD"],"source":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-phd-scholarships-for-least-developed-countries-and-vulnerable-states/","sourceLabel":"Commonwealth Scholarship Commission","checked":"23 October 2026","featured":false,"deadlineAt":"2026-10-20T16:00:00+01:00"},{"id":"daad-epos-2027","title":"DAAD EPOS Scholarships 2027–2028","provider":"DAAD","type":"Scholarship","level":"Graduate","country":"Germany","region":"Europe","funding":"Fully funded","deadline":"2027–2028 course list published; scholarship deadlines vary by course","status":"Check official site","summary":"DAAD links the 2027–2028 EPOS course list. Check eligible country, relevant degree and at least two years of related experience after the bachelor's degree. Submit to the selected course by its own scholarship deadline; an umbrella listing is not a confirmed open call.","tags":["Germany","Development","Professional experience"],"source":"https://www2.daad.de/deutschland/stipendium/datenbank/en/21148-scholarship-database/?detail=50076777","sourceLabel":"DAAD scholarship database","checked":"28 October 2026","featured":true,"deadlineDate":"$undefined","deadlineAt":"$undefined"},{"id":"kaust-2027","title":"KAUST Graduate Admission & Fellowship 2027","provider":"King Abdullah University of Science and Technology","type":"Graduate Program","level":"Graduate","country":"Saudi Arabia","region":"Middle East","funding":"Fully funded","deadline":"3 January 2027; Fall MS, MS/PhD and PhD; confirm portal cutoff","deadlineDate":"2027-01-03","status":"Open","summary":"Fall 2027 graduate admission with fellowship support, subject to sponsorship terms. Check current English requirements; Spring 2027 entry is closed to new applications.","tags":["STEM","MS","PhD"],"source":"https://admissions.kaust.edu.sa/how-to-apply/admission-timelines","sourceLabel":"KAUST current admission timeline","checked":"3 November 2026","featured":true,"deadlineAt":"$undefined","milestones":"$undefined"},{"id":"mext-2027","title":"Japanese Government MEXT Scholarships","provider":"Government of Japan","type":"Scholarship","level":"Any degree","country":"Japan","region":"Asia","funding":"Fully funded","deadline":"Varies by embassy or university route","status":"Check official site","summary":"Japanese government scholarships for international students selected through embassy, university or authority recommendation routes.","tags":["Japan","Embassy route","University route"],"source":"https://www.mext.go.jp/en/policy/education/highered/title02/detail02/sdetail02/1373897.htm","sourceLabel":"MEXT official website","checked":"13 October 2026","featured":true},{"id":"fulbright-foreign-student","title":"Fulbright Foreign Student Program","provider":"U.S. Department of State","type":"Scholarship","level":"Graduate","country":"United States","region":"North America","funding":"Funded","deadline":"Varies by home country","status":"Check official site","summary":"Approximately 4,000 annual grants for foreign graduate students, young professionals and artists; local rules vary by country.","tags":["USA","Master's","Research"],"source":"https://foreign.fulbrightonline.org/apply","sourceLabel":"Foreign Fulbright Program","checked":"13 October 2026"},{"id":"stipendium-hungaricum","title":"Stipendium Hungaricum Scholarship","provider":"Government of Hungary","type":"Scholarship","level":"Any degree","country":"Hungary","region":"Europe","funding":"Funded","deadline":"Apply page still labels 2026–2027; a 2027–2028 deadline is not confirmed here","status":"Check official site","summary":"On 28 October the official apply page still labels its calls 2026–2027. A registration button does not establish that a new funding round is open. Confirm the new call and sending-partner requirements before submitting.","tags":["Hungary","Bachelor's","Master's","PhD"],"source":"https://stipendiumhungaricum.hu/apply/","sourceLabel":"Stipendium Hungaricum official website","checked":"28 October 2026","deadlineDate":"$undefined","deadlineAt":"$undefined"},{"id":"australia-awards-scholarships","title":"Australia Awards Scholarships","provider":"Australian Government Department of Foreign Affairs and Trade","type":"Scholarship","level":"Any degree","country":"Australia","region":"Oceania","funding":"Fully funded","deadline":"Country-specific; check the participating-country profile","status":"Check official site","summary":"Long-term undergraduate and postgraduate awards for eligible developing-country applicants, with benefits generally including tuition, travel, living support and health cover.","tags":["Developing countries","Government scholarship","Return-home condition"],"source":"https://www.dfat.gov.au/people-to-people/australia-awards/australia-awards-scholarships","sourceLabel":"Australian Government DFAT","checked":"13 October 2026","featured":true},{"id":"australia-rtp","title":"Australian Government Research Training Program","provider":"Australian Government Department of Education","type":"Scholarship","level":"PhD","country":"Australia","region":"Oceania","funding":"Funded","deadline":"University-specific; apply through an eligible Australian provider","status":"Check official site","summary":"University-administered support for eligible research doctorate and research master's students that may include a tuition-fee offset, stipend and research-related allowances.","tags":["Research degree","University application","Tuition and stipend"],"source":"https://www.education.gov.au/research-block-grants/research-training-program","sourceLabel":"Australian Government Department of Education","checked":"13 October 2026"},{"id":"italy-maeci-2026-27","title":"MAECI Italian Government Grants 2026–2027","provider":"Italian Ministry of Foreign Affairs and International Cooperation","type":"Scholarship","level":"Graduate","country":"Italy","region":"Europe","funding":"Funded","deadline":"26 March 2026, 14:00 Italian time — closed","deadlineDate":"2026-03-26","status":"Closed","summary":"The current call is closed. MAECI grants use an annual eligible-country list and the official Study in Italy application portal for study carried out in Italy.","tags":["Italian Government","MAECI","Study in Italy"],"source":"https://www.esteri.it/en/servizi-opportunita/opportunita/borse-di-studio/per-cittadini-stranieri/borsestudio_stranieri/","sourceLabel":"Italian Ministry of Foreign Affairs","checked":"13 October 2026"},{"id":"italy-ergo-dsu-2026-27","title":"ER.GO Regional Scholarship 2026–2027","provider":"ER.GO Emilia-Romagna","type":"Scholarship","level":"Any degree","country":"Italy","region":"Europe","funding":"Funded","deadline":"24 August 2026, 16:00 — main scholarship deadline closed","deadlineDate":"2026-08-24","status":"Closed","summary":"Regional right-to-study support assessed under ER.GO's economic, enrolment and merit rules, with separate guidance for families holding income or assets abroad.","tags":["DSU","Emilia-Romagna","Income assessed"],"source":"https://www.er-go.it/cosa-fare-per/bandi-di-concorso/leggi-il-bando","sourceLabel":"ER.GO official 2026–2027 call","checked":"13 October 2026"},{"id":"open-doors-2026","title":"Open Doors: 2026 competition for study in Russia","provider":"Global Universities Association","type":"Scholarship","level":"Graduate","supportedDegrees":["Bachelor's","Master's","PhD"],"country":"Russia","region":"Europe","funding":"Funded","deadline":"Registration closed 1 November 2026; later stages for existing candidates","deadlineDate":"2026-11-01","status":"Closed","summary":"New registration is closed. Existing candidates should follow results and next-stage instructions in their account. Later dates are not a new application window.","tags":["Bachelor’s","Master’s","PhD","Track-specific rules"],"source":"https://od.globaluni.ru/","sourceLabel":"Official Open Doors rules, schedule and FAQ","checked":"2 November 2026","featured":false},{"id":"turkiye-next","title":"Türkiye Scholarships: prepare for the next degree call","provider":"Türkiye Scholarships / YTB","type":"Scholarship","level":"Graduate","supportedDegrees":["Bachelor's","Master's","PhD"],"country":"Türkiye","region":"Europe","funding":"Fully funded","deadline":"Annual Jan–Feb calendar; next named call must be verified","status":"Check official site","summary":"Degree funding with placement and level-specific academic/age conditions. The published annual calendar does not confirm that the next intake is open.","tags":["Degree placement","TBBS","Level-specific requirements"],"source":"https://www.turkiyeburslari.gov.tr/fulltimeprograms","sourceLabel":"Türkiye Scholarships official full-time programme","checked":"29 October 2026"},{"id":"kfupm-graduate","title":"KFUPM graduate scholarship routes","provider":"King Fahd University of Petroleum and Minerals","type":"Scholarship","level":"Graduate","supportedDegrees":["Master's","PhD"],"country":"Saudi Arabia","region":"Middle East","funding":"Varies","deadline":"Programme and intake-specific; verify current graduate call","status":"Check official site","summary":"Compare thesis MS, project MS and doctoral requirements. Minimum admission eligibility, scholarship selection and self-sponsored fees are separate decisions.","tags":["Thesis / project","Graduate research","Funding conditions"],"source":"https://cgis.kfupm.edu.sa/admission/kfupm-scholarship","sourceLabel":"KFUPM official scholarship terms","checked":"24 October 2026"},{"id":"isdb-ytb-2026","title":"IsDB–YTB joint scholarship 2026 — closed","provider":"Türkiye Scholarships / YTB and IsDB","type":"Scholarship","level":"Graduate","supportedDegrees":["Bachelor's","Master's","PhD"],"country":"Türkiye","region":"Europe","funding":"Fully funded","status":"Closed","deadline":"2026 call closed 20 February 2026; next joint call not confirmed","deadlineDate":"2026-02-20","summary":"Historical joint call with degree-specific country and field lists. Pakistan and Indonesia appear in the reviewed PhD country group; membership alone does not establish eligibility at every level.","tags":["Closed 2026 call","Country-by-degree eligibility","TBBS joint route"],"source":"https://turkiyeburslari.gov.tr/announcements/ytb-islamic-development-bank-isdb-joint-scholarship-program-2026-applicaiton-period-122","sourceLabel":"YTB official joint programme announcement","checked":"29 October 2026"},{"id":"fulbright-pakistan","title":"Fulbright Pakistan degree programme — closed call","provider":"USEFP","type":"Scholarship","level":"Master's","supportedDegrees":["Master's","PhD"],"country":"United States","region":"North America","funding":"Fully funded","status":"Closed","deadline":"Reviewed call closed 1 April 2026; next deadline not confirmed","deadlineDate":"2026-04-01","summary":"Pakistan-specific graduate route through USEFP. The reviewed call is closed. Prepare the study rationale and documents, then wait for the next official announcement before treating applications as available.","tags":["Pakistani applicants","USEFP","Graduate study","Closed call"],"source":"https://usefp.org/scholarships/fulbright-degree.cfm","sourceLabel":"USEFP Fulbright degree programme","checked":"1 November 2026"},{"id":"humboldt-research-fellowship","title":"Humboldt Research Fellowship","provider":"Alexander von Humboldt Foundation","type":"Fellowship","level":"PhD","country":"Germany","region":"Europe","funding":"Funded","status":"Check official site","deadline":"Next scheduled opening: 15 November 2026; capacity-limited call","summary":"Postdoctoral and experienced-researcher routes with a German host. Check doctoral-date, residence and host requirements. A scheduled opening is not a current application window.","tags":["Research","Host required","Doctoral stage"],"source":"https://www.humboldt-foundation.de/en/apply/sponsorship-programmes/humboldt-research-fellowship","sourceLabel":"Humboldt Foundation","checked":"2 November 2026"},{"id":"msca-postdoctoral-fellowships","title":"MSCA Postdoctoral Fellowships","provider":"European Commission","type":"Fellowship","level":"PhD","country":"Multiple European countries","region":"Europe","funding":"Funded","status":"Check official site","deadline":"Call-specific; check current funding portal and host deadline","summary":"Host-based research with doctoral, experience and mobility conditions. European and Global routes have different nationality rules. This overview does not confirm an open call.","tags":["Postdoctoral","Research","Mobility rules"],"source":"https://marie-sklodowska-curie-actions.ec.europa.eu/actions/postdoctoral-fellowships","sourceLabel":"European Commission: MSCA","checked":"2 November 2026"},{"id":"oist-phd-2027","title":"OIST PhD Programme 2027 admissions","provider":"Okinawa Institute of Science and Technology","type":"Scholarship","level":"PhD","country":"Japan","region":"Asia","funding":"Fully funded","deadline":"15 November 2026, 23:59 JST (UTC+9)","deadlineDate":"2026-11-15","deadlineAt":"2026-11-15T23:59:00+09:00","status":"Open","summary":"Funded doctoral route with a ¥5,000 application fee. Two references must arrive before submission; shortlisted candidates attend the 2027 online workshop.","tags":["PhD","Research","OIST","Application fee"],"source":"https://www.oist.jp/admissions/phd-program/apply-phd","sourceLabel":"OIST PhD application instructions","checked":"3 November 2026"},{"id":"hkpfs-2027","title":"Hong Kong PhD Fellowship Scheme 2027/28","provider":"Research Grants Council · Hong Kong","type":"Scholarship","level":"PhD","country":"Hong Kong","region":"Asia","funding":"Funded","deadline":"1 December 2026, 12:00 noon HKT; university applications are separate","deadlineDate":"2026-12-01","deadlineAt":"2026-12-01T12:00:00+08:00","status":"Open","summary":"Obtain the HKPFS reference number before submitting separate PhD applications to the selected universities. Check each university's funding additions and requirements.","tags":["HKPFS","PhD","Research","Hong Kong"],"source":"https://cerg1.ugc.edu.hk/hkpfs/apply.html","sourceLabel":"RGC official two-stage application instructions","checked":"3 November 2026"}],"showTypeFilter":false}]]}]
1f:["$","article",null,{"className":"article-body ","children":[["$","section","0-Compare fit before opening an application",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Compare fit before opening an application"}],[],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Decisions for this shortlist","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Decisions for this shortlist"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Check",{"scope":"col","children":"Check"}],["$","th","What to compare",{"scope":"col","children":"What to compare"}],["$","th","Next evidence",{"scope":"col","children":"Next evidence"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Funded position"}],["$","td","1",{"children":"Project and employment/stipend conditions"}],["$","td","2",{"children":"Research fit and contract duration"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"University scholarship"}],["$","td","1",{"children":"Admission and internal funding selection"}],["$","td","2",{"children":"Supervisor and department requirements"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"External award"}],["$","td","1",{"children":"Award rules plus host admission"}],["$","td","2",{"children":"Funding overlap and continuation conditions"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","1-Scholarship route or funded position?",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Scholarship route or funded position?"}],[["$","p","Doctoral funding can follow two models. In scholarship-led systems you apply for an award and a university place; in project-led systems you apply to a funded research vacancy much like a job. Some routes require supervisor support before formal submission.",{"children":"Doctoral funding can follow two models. In scholarship-led systems you apply for an award and a university place; in project-led systems you apply to a funded research vacancy much like a job. Some routes require supervisor support before formal submission."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Read the department's admission sequence",{"children":"Read the department's admission sequence"}],["$","li","Map your methods to the proposed research",{"children":"Map your methods to the proposed research"}],["$","li","Contact supervisors only with a specific fit",{"children":"Contact supervisors only with a specific fit"}],["$","li","Prepare a focused proposal when required",{"children":"Prepare a focused proposal when required"}],["$","li","Check funding duration and teaching duties",{"children":"Check funding duration and teaching duties"}]]}],"$undefined","$undefined","$undefined"]}],["$","section","2-Evaluate the funding package before accepting",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Evaluate the funding package before accepting"}],[["$","p","A funded PhD offer should state the stipend, tuition coverage, duration, conditions and any teaching or research duties. Compare the net support with local housing, health insurance and visa costs, and ask how later years are renewed.",{"children":"A funded PhD offer should state the stipend, tuition coverage, duration, conditions and any teaching or research duties. Compare the net support with local housing, health insurance and visa costs, and ask how later years are renewed."}],["$","p","Confirm who controls the project direction, what happens if a supervisor leaves and whether conference, fieldwork or research costs have separate budgets. These questions affect the quality of the doctorate as much as the headline funding amount.",{"children":"Confirm who controls the project direction, what happens if a supervisor leaves and whether conference, fieldwork or research costs have separate budgets. These questions affect the quality of the doctorate as much as the headline funding amount."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L22","$L23","$L24","$L25"]}]
