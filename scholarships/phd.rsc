22:["$","section","3-Compare the doctorate and the funding agreement",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Compare the doctorate and the funding agreement"}],[["$","p","Use the listing cards to find possibilities, then compare the model that actually fits your qualification, goal and financing needs. Routes with similar funding labels can require different application owners and documents.",{"children":"Use the listing cards to find possibilities, then compare the model that actually fits your qualification, goal and financing needs. Routes with similar funding labels can require different application owners and documents."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A route comparison before you apply","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A route comparison before you apply"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Model or stage",{"scope":"col","children":"Model or stage"}],["$","th","What to verify",{"scope":"col","children":"What to verify"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Scholarship-led route"}],["$","td","1",{"children":"Award plus university admission or nomination"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Funded project vacancy"}],["$","td","1",{"children":"Project scope, duties and appointment"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Departmental package"}],["$","td","1",{"children":"Stipend, fee remission and duration"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Supervisor-supported route"}],["$","