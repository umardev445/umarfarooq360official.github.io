1b:["$","article",null,{"className":"article-body ","children":[null,["$","section","1-Scholarship route or funded position?",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Scholarship route or funded position?"}],[["$","p","Doctoral funding can follow two models. In scholarship-led systems you apply for an award and a university place; in project-led systems you apply to a funded research vacancy much like a job. Some routes require supervisor support before formal submission.",{"children":"Doctoral funding can follow two models. In scholarship-led systems you apply for an award and a university place; in project-led systems you apply to a funded research vacancy much like a job. Some routes require supervisor support before formal submission."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Read the department's admission sequence",{"children":"Read the department's admission sequence"}],["$","li","Map your methods to the proposed research",{"children":"Map your methods to the proposed research"}],["$","li","Contact supervisors only with a specific fit",{"children":"Contact supervisors only with a specific fit"}],["$","li","Prepare a focused proposal when required",{"children":"Prepare a focused proposal when required"}],["$","li","Check funding duration and teaching duties",{"children":"Check funding duration and teaching duties"}]]}],"$undefined","$undefined"]}],["$","section","2-Evaluate the funding package before accepting",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Evaluate the funding package before accepting"}],[["$","p","A funded PhD offer should state the stipend, tuition coverage, duration, conditions and any teaching or research duties. Compare the net support with local housing, health insurance and visa costs, and ask how later years are renewed.",{"children":"A funded PhD offer should state the stipend, tuition coverage, duration, conditions and any teaching or research duties. Compare the net support with local housing, health insurance and visa costs, and ask how later years are renewed."}],["$","p","Confirm who controls the project direction, what happens if a supervisor leaves and whether conference, fieldwork or research costs have separate budgets. These questions affect the quality of the doctorate as much as the headline funding amount.",{"children":"Confirm who controls the project direction, what happens if a supervisor leaves and whether conference, fieldwork or research costs have separate budgets. These questions affect the quality of the doctorate as much as the headline funding amount."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","3-Compare the doctorate and the funding agreement",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Compare the doctorate and the funding agreement"}],[["$","p","Use the listing cards to find possibilities, then compare the model that actually fits your qualification, goal and financing needs. Routes with similar funding labels can require different application owners and documents.",{"children":"Use the listing cards to find possibilities, then compare the model that actually fits your qualification, goal and financing needs. Routes with similar funding labels can require different application owners and documents."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A route comparison before you apply","tabIndex":0,"children":"$L1c"}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1d"]}]
