e},{"id":"commonwealth-phd-2027","title":"Commonwealth PhD Scholarships 2027–2028","provider":"Commonwealth Scholarship Commission","type":"Scholarship","level":"PhD","country":"United Kingdom","region":"Europe","funding":"Fully funded","deadline":"20 October 2026, 16:00 BST","deadlineDate":"2026-10-20","status":"Open","summary":"Doctoral funding for applicants from eligible least-developed countries and vulnerable Commonwealth states. Published CSC deadline: 20 October 2026 at 16:00 BST; the nominator may set an earlier date.","tags":["Commonwealth","Research","PhD"],"source":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-phd-scholarships-for-least-developed-countries-and-vulnerable-states/","sourceLabel":"Commonwealth Scholarship Commission","checked":"13 October 2026","deadlineAt":"2026-10-20T16:00:00+01:00"},{"id":"daad-epos-2027","title":"DAAD EPOS Scholarships 2027–2028","provider":"DAAD","type":"Scholarship","level":"Graduate","country":"Germany","region":"Europe","funding":"Fully funded","deadline":"Varies by selected postgraduate course","status":"Check official site","summary":"Development-related postgraduate funding for graduates from eligible countries, generally requiring at least two years of professional experience.","tags":["Germany","Development","Professional experience"],"source":"https://www2.daad.de/deutschland/stipendium/datenbank/en/21148-scholarship-database/?detail=50076777","sourceLabel":"DAAD scholarship database","checked":"13 October 2026","featured":true},{"id":"kaust-2027","title":"KAUST Graduate Admission & Fellowship 2027","provider":"King Abdullah University of Science and Technology","type":"Graduate Program","level":"Graduate","country":"Saudi Arabia","region":"Middle East","funding":"Fully funded","deadline":"Fall 2027: 3 January 2027","deadlineDate":"2027-01-03","status":"Open","summary":"Fall 2027 applications are open for MS, MS/PhD and PhD study with KAUST Fellowship support for admitted graduate students.","tags":["STEM","MS","PhD"],"source":"https://admissions.kaust.edu.sa/how-to-apply/admission-timelines","sourceLabel":"KAUST Admissions","checked":"13 October 2026","featured":true},{"id":"mext-2027","title":"Japanese Government MEXT Scholarships","provider":"Government of Japan","type":"Scholarship","level":"Any degree","country":"Japan","region":"Asia","funding":"Fully funded","deadline":"Varies by embassy or university route","status":"Check official site","summary":"Japanese government scholarships for international students selected through embassy, university or authority recommendation routes.","tags":["Japan","Embassy route","University route"],"source":"https://www.mext.go.jp/en/policy/education/highered/title02/detail02/sdetail02/1373897.htm","sourceLabel":"MEXT official website","checked":"13 October 2026","featured":true},{"id":"fulbright-foreign-student","title":"Fulbright Foreign Student Program","provider":"U.S. Department of State","type":"Scholarship","level":"Graduate","country":"United States","region":"North America","funding":"Funded","deadline":"Varies by home country","status":"Check official site","summary":"Approximately 4,000 annual grants for foreign graduate students, young professionals and artists; local rules vary by country.","tags":["USA","Master's","Research"],"source":"https://foreign.fulbrightonline.org/apply","sourceLabel":"Foreign Fulbright Program","checked":"13 October 2026"},{"id":"stipendium-hungaricum","title":"Stipendium Hungaricum Scholarship","provider":"Government of Hungary","type":"Scholarship","level":"Any degree","country":"Hungary","region":"Europe","funding":"Funded","deadline":"2027–2028 call not confirmed on the official apply page checked 13 October","status":"Check official site","summary":"The official apply page still describes 2026–2027 and its past 15 January 2026 deadline. Prepare by sending-partner route; do not reuse that date for an unannounced future cycle.","tags":["Hungary","Bachelor's","Master's","PhD"],"sourc