23:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Use a host-specific deadline before the national one",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Use a host-specific deadline before the national one"}],[["$","p","Paris-Saclay’s own 2027 page illustrates the difference: its master’s internal deadline is 26 November 2026, while its doctoral calendar uses a different earlier date. The host also says Eiffel preparation does not replace its ordinary academic admission process. These are Paris-Saclay-specific facts, not dates for every French institution.",{"children":"Paris-Saclay’s own 2027 page illustrates the difference: its master’s internal deadline is 26 November 2026, while its doctoral calendar uses a different earlier date. The host also says Eiffel preparation does not replace its ordinary academic admission process. These are Paris-Saclay-specific facts, not dates for every French institution."}],["$","p","Do not copy a doctoral date into a master’s tracker or use the national deadline as extra time after your host closes. Read the degree level, academic year, exact internal recipient and required submission state together. Where a summary and the host page differ, ask the host which current instruction applies.",{"children":"Do not copy a doctoral date into a master’s tracker or use the national deadline as extra time after your host closes. Read the degree level, academic year, exact internal recipient and required submission state together. Where a summary and the host page differ, ask the host which current instruction applies."}],["$","p","Original fictional case: a student sees a January national deadline but their chosen host requires a November file. The student works back from November because that is the stage they control. Another institution’s later internal date does not extend the first host’s procedure.",{"children":"Original fictional case: a student sees a January national deadline but their chosen host requires a November file. The student works back from November because that is the stage they control. Another institution’s later internal date does not extend the first host’s procedure."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Use a host-specific deadline before the national one","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Use a host-specific deadline before the national one"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Tracker field",{"scope":"col","children":"Tracker field"}],["$","th","What to record",{"scope":"col","children":"What to record"}],["$","th","Mistake to catch",{"scope":"col","children":"Mistake to catch"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Degree level"}],["$","td","1",{"children":"Master’s route and exact host programme"}],["$","td","2",{"children":"Doctoral timetable copied by accident"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Student deadline"}],["$","td","1",{"children":"Host’s internal cutoff and submission method"}],["$","td","2",{"children":"National cutoff used as the student date"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Institution deadline"}],["$","td","1",{"children":"Applicable Campus France MASTER timestamp"}],["$","td","2",{"children":"Treating student email as an institutional nomination"}]],"$undefined"]}],"$L27"]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$L28"]}],"$L29","$L2a","$L2b","$L2c","$L2d"]}]
