1a:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.unipi.it/en/education/registration/enrolment-and-registration/enrolment-for-international-students/dsu-scholarship-university-of-pisa/",{"children":["",["$","a",null,{"href":"https://www.unipi.it/en/education/registration/enrolment-and-registration/enrolment-for-international-students/dsu-scholarship-university-of-pisa/","target":"_blank","rel":"noreferrer","children":"Pisa: DSU scholarship and 2026/27 deadline"}]]}]]]}]
1b:["$","section","1-Pisa, Florence and Siena: one regional route, separate admissions",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Pisa, Florence and Siena: one regional route, separate admissions"}],[["$","p","University admission determines whether you can enter a course. The DSU competition evaluates the benefit request under regional rules. Keep these tasks side by side in a tracker, with a different receipt and deadline for each.",{"children":"University admission determines whether you can enter a course. The DSU competition evaluates the benefit request under regional rules. Keep these tasks side by side in a tracker, with a different receipt and deadline for each."}],["$","p","Do not wait for a university offer before reading the benefit call: the annual rules explain how prospective students apply and when enrolment must be completed. Equally, a DSU application is not an admission offer or a visa approval.",{"children":"Do not wait for a university offer before reading the benefit call: the annual rules explain how prospective students apply and when enrolment must be completed. Equally, a DSU application is not an admission offer or a visa approval."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Plan both applications","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Plan both applications"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Decision",{"scope":"col","children":"Decision"}],["$","th","Where to verify",{"scope":"col","children":"Where to verify"}],["$","th","What not to assume",{"scope":"col","children":"What not to assume"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Academic eligibility"}],["$","td","1",{"children":"Selected university programme"}],["$","td","2",{"children":"A regional award admits you"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Financial documents"}],["$","td","1",{"children":"DSU annual call and foreign-student instructions"}],["$","td","2",{"children":"One certificate fits every profile"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Housing and meals"}],["$","td","1",{"children":"DSU benefit conditions"}],["$","td","2",{"children":"Every eligible applicant receives an immediate room"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"University registration"}],["$","td","1",{"children":"University enrolment office"}],["$","td","2",{"children":"Submitting DSU completes enrolment"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Pisa, Florence and Siena: one regional route, separate admissions","children":[["$","$L4","/guides/university-of-pisa-admissions-scholarships/",{"href":"/guides/university-of-pisa-admissions-scholarships/","children":["Pisa admissions and funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/university-of-florence-admissions-scholarships/",{"href":"/guides/university-of-florence-admissions-scholarships/","children":["Florence admissions and funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/university-of-siena-admissions-scholarships/",{"href":"/guides/university-of-siena-admissions-scholarships/","children":["Siena admissions and funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1c:["$","section","2-First application versus renewal: a narrow exception matters",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"First application versus renewal: a narrow exception matters"}],[["$","p","The DSU foreign-student instructions distinguish first or changed-level applications from certain renewals. For 2026/27, a 2025/26 scholarship winner reapplying at the same study level with unchanged economic circumstances can follow the stated declaration route instead of resubmitting the financial evidence covered by that exception.",{"children":"The DSU foreign-student instructions distinguish first or changed-level applications from certain renewals. For 2026/27, a 2025/26 scholarship winner reapplying at the same study level with unchanged economic circumstances can follow the stated declaration route instead of resubmitting the financial evidence covered by that exception."}],["$","p","Do not extend this exception to all returning students. The official instructions list cases requiring documents, including students who did not win the previous year and relevant transitions into a master’s degree. A previous university registration alone does not prove that you qualify for the renewal exception.",{"children":"Do not extend this exception to all returning students. The official instructions list cases requiring documents, including students who did not win the previous year and relevant transitions into a master’s degree. A previous university registration alone does not prove that you qualify for the renewal exception."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"A student continuing the same master’s degree after winning the previous year is not in the same position as a bachelor’s graduate beginning a new master’s course. Check the category before reusing last year’s file."}]]}],"$undefined","$undefined","$undefined","$undefined"]}]
1d:["$","section","3-Build the foreign-income document pack",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Build the foreign-income document pack"}],[["$","p","List the household members and the evidence required for income and assets in the reference year. Follow the DSU instructions about who issues the certificate and how it must be translated, legalised or otherwise authenticated. Keep the original-language document attached to its translation.",{"children":"List the household members and the evidence required for income and assets in the reference year. Follow the DSU instructions about who issues the certificate and how it must be translated, legalised or otherwise authenticated. Keep the original-language document attached to its translation."}],["$","p","A scan that cuts off the authority’s stamp or date can create a preventable query. Check every page, the passport spelling and the declared household before uploading. If original documents must be delivered as well, record the delivery method and deadline separately from online submission.",{"children":"A scan that cuts off the authority’s stamp or date can create a preventable query. Check every page, the passport spelling and the declared household before uploading. If original documents must be delivered as well, record the delivery method and deadline separately from online submission."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L23",null,{"id":"scholarships/dsu-toscana:section-4","title":"Check your progress","items":["Choose the correct first-application or renewal category","Verify household, income and asset evidence","Check the specified reference period","Prepare translations and authentication only as required","Record online and any physical-delivery requirements"]}],"$undefined","$undefined"]}]
1e:["$","section","4-Accommodation, meals and the first payment",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Accommodation, meals and the first payment"}],[["$","p","Read each benefit separately. Accommodation can depend on availability and allocation; meal access and cash payments can follow different rules. Use the written award and allocation result to decide what is confirmed.",{"children":"Read each benefit separately. Accommodation can depend on availability and allocation; meal access and cash payments can follow different rules. Use the written award and allocation result to decide what is confirmed."}],["$","p","Do not subtract an entire expected annual grant from the cash needed for arrival. Estimate temporary accommodation, rent deposit and transport before the first confirmed payment. Keep a second budget if a residence place is not available.",{"children":"Do not subtract an entire expected annual grant from the cash needed for arrival. Estimate temporary accommodation, rent deposit and transport before the first confirmed payment. Keep a second budget if a residence place is not available."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Accommodation, meals and the first payment","children":[["$","$L4","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Plan an Italy study budget",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1f:["$","section","5-After submission: rankings, corrections and continuation",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"After submission: rankings, corrections and continuation"}],[["$","p","Save the submitted form and check the official ranking notices. If your status is suspended or excluded, identify the exact missing condition and the permitted correction route. A new document emailed after a closed deadline is not automatically accepted.",{"children":"Save the submitted form and check the official ranking notices. If your status is suspended or excluded, identify the exact missing condition and the permitted correction route. A new document emailed after a closed deadline is not automatically accepted."}],["$","p","For continuation, track credits, enrolment changes and any duty to report other awards. The University of Pisa notes that overlapping benefits can require a choice. Read the compatibility clauses before assuming two awards can be combined.",{"children":"For continuation, track credits, enrolment changes and any duty to report other awards. The University of Pisa notes that overlapping benefits can require a choice. Read the compatibility clauses before assuming two awards can be combined."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
