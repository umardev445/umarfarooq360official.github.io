18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/expansion-20261022/italy-toscana-1280.webp","srcSet":"/images/expansion-20261022/italy-toscana-640.webp 640w, /images/expansion-20261022/italy-toscana-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Florence skyline beside the Arno River","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Destination or study photograph; not a photograph of the named university or scholarship."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"DSU Toscana awards support through its regional competition. Students must complete the online application; foreign-income documents and renewal treatment depend on the current call and their study history."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Identify your university and degree level, then compare the foreign-student instructions with the annual call before preparing financial certificates."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Published cycle and deadline status",{"href":"#section-1","children":"Published cycle and deadline status"}],["$","a","Pisa, Florenc