26:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is a separate KAUST Fellowship form required?",{"children":[["$","summary",null,{"children":["Is a separate KAUST Fellowship form required?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The current FAQ says no separate application is needed. Admitted students normally receive fellowship support, except in specified sponsorship or partnership arrangements. Your offer establishes the actual package."}]]}],["$","details","Is a Pakistani medium-of-instruction certificate sufficient?",{"children":[["$","summary",null,{"children":["Is a Pakistani medium-of-instruction certificate sufficient?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"KAUST's current entry page says it does not accept MOI certificates. Use an accepted test or a specifically defined exemption, and read any conditional provisions that apply to your applicant category."}]]}],["$","details","Are the published stipend amounts monthly?",{"children":[["$","summary",null,{"children":["Are the published stipend amounts monthly?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The funding page describes US$20,000 per year for MS and US$25,000–30,000 per year for PhD, depending on qualifications and progress. Distinguish an annual value from the monthly payment."}]]}],["$","details","Is this the same application as KAUST VSRP?",{"children":[["$","summary",null,{"children":["Is this the same application as KAUST VSRP?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. This guide concerns graduate degree admission and fellowship support. VSRP is a separate visiting research internship with its own process."}]]}]]}]]}]
