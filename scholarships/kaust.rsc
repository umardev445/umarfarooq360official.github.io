29:["$","section","3-Prepare the research application and referee requests",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Prepare the research application and referee requests"}],[["$","p","The application asks for academic records, a CV, a statement of purpose, identification and three referee contacts. Use academic or professional institutional email addresses as required. Current instructions say reference invitations are sent when details are entered, so ask permission before triggering the email.",{"children":"The application asks for academic records, a CV, a statement of purpose, identification and three referee contacts. Use academic or professional institutional email addresses as required. Current instructions say reference invitations are sent when details are entered, so ask permission before triggering the email."}],["$","p","Build the statement around work you can explain: the question, your role, a method, a result and a limitation. Connect that preparation to the intended graduate programme. A claim that KAUST has excellent facilities becomes more useful when you explain which training or research direction you need and why.",{"children":"Build the statement around work you can explain: the question, your role, a method, a result and a limitation. Connect that preparation to the intended graduate programme. A claim that KAUST has excellent facilities becomes more useful when you explain which training or research direction you need and why."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original document review before starting the final submission","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original document review before starting the final submission"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Item",{"scope":"col","children":"Item"}],["$","th","Check",{"scope":"col","children":"Check"}],["$","th","Keep as evidence",{"scope":"col","children":"Keep as evidence"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Academic record"}],["$","td","1",{"children":"Institution, degree, grades and grading scale agree"}],["$","td","2",{"children":"The actual uploaded file"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Statement"}],["$","td","1",{"children":"Explains your preparation and intended research direction"}],["$","td","2",{"children":"Final version matching the live form"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Referees"}],["$","td","1",{"children":"Three willing contacts using accepted email addresses"}],["$","td","2",{"children":"Invitation and receipt status"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Language evidence"}],["$","td","1",{"children":"Current accepted test or a defined exemption"}],["$","td","2",{"children":"Valid report or qualifying degree evidence"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://admissions.kaust.edu.sa/how-to-apply/entry-requirements",{"children":["",["$","a",null,{"href":"https://admissions.kaust.edu.sa/how-to-apply/entry-requirements","target":"_blank","rel":"noreferrer","children":"KAUST required documents and referee workflow"}]]}]]]}],"$undefined"]}]
2a:["$","section","4-Submit the graduate route in the correct order",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Submit the graduate route in the correct order"}],[["$","p","The graduate application and the Visiting Student Research Program serve different purposes. Do not use an internship form to seek master's or PhD admission. Check the graduate programme and intake shown on every screen.",{"children":"The graduate application and the Visiting Student Research Program serve different purposes. Do not use an internship form to seek master's or PhD admission. Check the graduate programme and intake shown on every screen."}]],["$","ol",null,{"className":"process-steps","aria-label":"Submit the graduate route in the correct order","children":[["$","li","Choose MS, MS/PhD or PhD and read the current programme requirements.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Choose MS, MS/PhD or PhD and read the current programme requirements."}]]}],["$","li","Resolve English evidence and collect the academic record and research materials.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Resolve English evidence and collect the academic record and research materials."}]]}],["$","li","Confirm referee availability before entering their contacts.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Confirm referee availability before entering their contacts."}]]}],["$","li","Complete the graduate application before 3 January and monitor the references.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Complete the graduate application before 3 January and monitor the references."}]]}],["$","li","Retain confirmation and follow interview, offer and enrolment instructions.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Retain confirmation and follow interview, offer and enrolment instructions."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Submit the graduate route in the correct order","children":[["$","$L5","/internships/kaust-vsrp/",{"href":"/internships/kaust-vsrp/","children":["Looking for an internship? Read the separate KAUST VSRP guide",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/statement-of-purpose/",{"href":"/guides/statement-of-purpose/","children":["Improve your statement of purpose",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2b:["$","section","5-A practical plan for applicants from Pakistan",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"A practical plan for applicants from Pakistan"}],[["$","p","Start by checking whether your qualification meets the chosen degree route, then read the current test and exemption rules. Obtain the grading scale and any required translation rather than using a self-converted GPA as official evidence. If final results are pending, follow the published provisional-record instructions and the eventual final-document requirement.",{"children":"Start by checking whether your qualification meets the chosen degree route, then read the current test and exemption rules. Obtain the grading scale and any required translation rather than using a self-converted GPA as official evidence. If final results are pending, follow the published provisional-record instructions and the eventual final-document requirement."}],["$","p","Keep a small upfront-cost plan for testing, documents and other expenses incurred before enrolment. The fellowship FAQ says language-test costs are not covered. Separate that expense from relocation support in the eventual award. Ask admissions about unclear degree or sponsorship details using your programme name and exact qualification.",{"children":"Keep a small upfront-cost plan for testing, documents and other expenses incurred before enrolment. The fellowship FAQ says language-test costs are not covered. Separate that expense from relocation support in the eventual award. Ask admissions about unclear degree or sponsorship details using your programme name and exact qualification."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2d",null,{"id":"scholarships/kaust:section-6","title":"Check your progress","items":["I chose the graduate degree route and Fall 2027 intake.","I checked the current qualification and GPA requirements.","My English evidence follows the current rules; I did not assume an MOI waiver.","Three eligible referees agreed before invitations were sent.","Academic documents include the required grading scale and translations.","I understand the fellowship or external-sponsorship conditions.","I saved submission evidence and the tentative decision date."]}],"$undefined","$undefined"]}]
2c:["$","section","6-Check the submission, then save the evidence",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Check the submission, then save the evidence"}],[["$","p","A saved draft and a submitted application are different states. Reopen the application summary, inspect every attachment and check the referee indicators. Keep the confirmation email or reference number with the version of the instructions you used. Put any later transcript, offer-acceptance or enrolment task in a separate calendar entry.",{"children":"A saved draft and a submitted application are different states. Reopen the application summary, inspect every attachment and check the referee indicators. Keep the confirmation email or reference number with the version of the instructions you used. Put any later transcript, offer-acceptance or enrolment task in a separate calendar entry."}],["$","p","The tracker is an editable planning sheet, not an application form or eligibility assessment. Its suggested next actions belong to you; deadlines and requirements remain controlled by the institution. Replace the blank owner, internal deadline and confirmation fields with your own plan.",{"children":"The tracker is an editable planning sheet, not an application form or eligibility assessment. Its suggested next actions belong to you; deadlines and requirements remain controlled by the institution. Replace the blank owner, internal deadline and confirmation fields with your own plan."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Check the submission, then save the evidence","children":[["$","a","/downloads/scholarship-application-tracker-2027.csv",{"href":"/downloads/scholarship-application-tracker-2027.csv","download":true,"children":["Download the scholarship application tracker (CSV)",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/deadline-calendar/",{"href":"/deadline-calendar/","children":["Compare other scholarship deadlines",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
