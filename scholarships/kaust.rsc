20:["$","section","1-Current round: Fall 2027 applications are open",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Current round: Fall 2027 applications are open"}],[["$","p","The official admissions timeline shows that the Spring 2027 PhD deadline passed on 27 September 2026. The Fall 2027 round opened on 28 September for MS, MS/PhD and PhD applicants and closes on 3 January 2027.",{"children":"The official admissions timeline shows that the Spring 2027 PhD deadline passed on 27 September 2026. The Fall 2027 round opened on 28 September for MS, MS/PhD and PhD applicants and closes on 3 January 2027."}],["$","p","KAUST marks dates as tentative, so reopen the official timeline before submitting. Do not apply to an intake or degree route that does not match the programme availability shown in the portal.",{"children":"KAUST marks dates as tentative, so reopen the official timeline before submitting. Do not apply to an intake or degree route that does not match the programme availability shown in the portal."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","2-Understand admission and fellowship support",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Understand admission and fellowship support"}],[["$","p","KAUST describes fellowship support for admitted graduate students, including tuition, living support, on-campus housing, medical and dental coverage and relocation assistance under current terms. Verify the exact award conditions, payment timing and personal costs for your offer.",{"children":"KAUST describes fellowship support for admitted graduate students, including tuition, living support, on-campus housing, medical and dental coverage and relocation assistance under current terms. Verify the exact award conditions, payment timing and personal costs for your offer."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","3-Build research and programme fit",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Build research and programme fit"}],[["$","p","Start with the KAUST academic programmes and research areas. Identify the scientific or engineering problem you want to investigate, the methods you have already used and the laboratories, faculty expertise or facilities relevant to the next step.",{"children":"Start with the KAUST academic programmes and research areas. Identify the scientific or engineering problem you want to investigate, the methods you have already used and the laboratories, faculty expertise or facilities relevant to the next step."}],["$","p","A strong statement does not simply praise KAUST's reputation. It shows that the applicant understands the research environment and can connect prior preparation to a specific, realistic direction.",{"children":"A strong statement does not simply praise KAUST's reputation. It shows that the applicant understands the research environment and can connect prior preparation to a specific, realistic direction."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","4-Prepare academic evidence",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Prepare academic evidence"}],[["$","p","Follow the live application checklist for transcripts, degree evidence, English-language requirements, references, CV and statements. Use accurate grading information and explain your individual contribution to research, thesis or technical projects.",{"children":"Follow the live application checklist for transcripts, degree evidence, English-language requirements, references, CV and statements. Use accurate grading information and explain your individual contribution to research, thesis or technical projects."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Degree and transcript records",{"children":"Degree and transcript records"}],["$","li","Official grading-scale context",{"children":"Official grading-scale context"}],["$","li","Research or technical CV",{"children":"Research or technical CV"}],["$","li","Statement aligned to the selected programme",{"children":"Statement aligned to the selected programme"}],["$","li","Referees able to assess research readiness",{"children":"Referees able to assess research readiness"}],["$","li","Accepted language evidence",{"children":"Accepted language evidence"}],["$","li","Valid identity documents",{"children":"Valid identity documents"}]]}],"$undefined","$undefined"]}]
24:["$","section","5-Contact faculty with purpose",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Contact faculty with purpose"}],[["$","p","If programme guidance encourages contact, write a short, specific message showing genuine research overlap. Mention one relevant project or method and ask a focused question. Mass emails with generic praise are unlikely to help and can damage credibility.",{"children":"If programme guidance encourages contact, write a short, specific message showing genuine research overlap. Mention one relevant project or method and ask a focused question. Mass emails with generic praise are unlikely to help and can damage credibility."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","6-Advice for international and Pakistani applicants",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Advice for international and Pakistani applicants"}],[["$","p","International applicants, including qualified students from Pakistan, should verify degree equivalency, English requirements, document formats and visa steps through the official KAUST process. Funding does not remove the need to meet academic and immigration conditions.",{"children":"International applicants, including qualified students from Pakistan, should verify degree equivalency, English requirements, document formats and visa steps through the official KAUST process. Funding does not remove the need to meet academic and immigration conditions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","7-Final deadline and fraud checks",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Final deadline and fraud checks"}],[["$","p","Apply through the KAUST admissions domain, confirm the correct intake and save the submission receipt. Do not pay a private person for guaranteed admission or fellowship selection. If a message conflicts with the official portal, verify it with KAUST directly.",{"children":"Apply through the KAUST admissions domain, confirm the correct intake and save the submission receipt. Do not pay a private person for guaranteed admission or fellowship selection. If a message conflicts with the official portal, verify it with KAUST directly."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
27:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://admissions.kaust.edu.sa/how-to-apply/admission-timelines",{"href":"https://admissions.kaust.edu.sa/how-to-apply/admission-timelines","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"KAUST admission timelines"}],["$","span",null,{"children":"Official Spring and Fall 2027 dates"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
28:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is the KAUST Spring 2027 PhD round still open?",{"children":[["$","summary",null,{"children":["Is the KAUST Spring 2027 PhD round still open?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Its stated deadline was 27 September 2026. The Fall 2027 round is the current open route shown on the official timeline."}]]}],["$","details","When does the KAUST Fall 2027 application open?",{"children":[["$","summary",null,{"children":["When does the KAUST Fall 2027 application open?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The official timeline lists 28 September 2026 as the opening date and 3 January 2027 as the deadline for Fall 2027 MS, MS/PhD and PhD applications."}]]}],["$","details","Is KAUST fully funded?",{"children":[["$","summary",null,{"children":["Is KAUST fully funded?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"KAUST describes fellowship support for admitted graduate students, including tuition and major living and study support. Read the current offer terms for exact coverage."}]]}],["$","details","Can Pakistani students apply to KAUST?",{"children":[["$","summary",null,{"children":["Can Pakistani students apply to KAUST?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Qualified international applicants, including Pakistanis, can apply when they meet the selected programme, degree, document and language requirements."}]]}],["$","details","Do I need a supervisor before applying?",{"children":[["$","summary",null,{"children":["Do I need a supervisor before applying?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Follow the current programme and admissions instructions. Researching faculty fit is important, but any required or optional contact depends on the selected route."}]]}]]}]]}]
