22:["$","div",null,{"className":"article-body","children":[["$","section","KAUST 2027: closed Spring round and open Fall round",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"KAUST 2027: closed Spring round and open Fall round"}],[["$","p","Use the dated table on the current admissions site. A generic sentence saying Spring is open does not override a past deadline. Published dates are tentative and can change.",{"children":"Use the dated table on the current admissions site. A generic sentence saying Spring is open does not override a past deadline. Published dates are tentative and can change."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Current KAUST graduate admission schedule","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Current KAUST graduate admission schedule"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Route",{"scope":"col","children":"Route"}],["$","th","Application deadline",{"scope":"col","children":"Application deadline"}],["$","th","Current planning position",{"scope":"col","children":"Current planning position"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Spring 2027 PhD"}],["$","td","1",{"children":"27 September 2026"}],["$","td","2",{"children":"Closed to new applications"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Fall 2027 MS, MS/PhD and PhD"}],["$","td","1",{"children":"3 January 2027"}],["$","td","2",{"children":"Prepare the current graduate admission application"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Fall Round 2 decisions"}],["$","td","1",{"children":"25 February 2027, tentative"}],["$","td","2",{"children":"Monitor the actual portal and official updates"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Fall semester begins"}],["$","td","1",{"children":"29 August 2027, tentative"}],["$","td","2",{"children":"Plan enrolment only after the offer instructions"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://admissions.kaust.edu.sa/how-to-apply/admission-timelines","target":"_blank","rel":"noreferrer","children":"KAUST official admission timeline"}]]}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]]}]
23:["$","figure",null,{"className":"page-visual page-visual--inline","children":[["$","img",null,{"src":"/images/programme-research-editorial.webp","srcSet":"$undefined","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Students working through programme information and application notes","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Use the guide to organise your next decision, then check the official source."}]]}]
24:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Entry requirements and current English rules",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Entry requirements and current English rules"}],[["$","p","The current admissions page requires the relevant academic qualification and a minimum GPA of 3.0/4.0 or equivalent. Its standard IELTS requirement is 7.0 overall with at least 6.5 in each section. It also lists other accepted tests and conditional provisions for specified applicants; check the current table for your case.",{"children":"The current admissions page requires the relevant academic qualification and a minimum GPA of 3.0/4.0 or equivalent. Its standard IELTS requirement is 7.0 overall with at least 6.5 in each section. It also lists other accepted tests and conditional provisions for specified applicants; check the current table for your case."}],["$","p","A medium-of-instruction certificate is not accepted as English evidence. The page defines exemptions for qualifying in-person degrees in named countries and at KAUST. Do not assume that a Pakistani English-taught degree alone grants that exemption. A minimum score establishes a requirement, not a predicted admission chance.",{"children":"A medium-of-instruction certificate is not accepted as English evidence. The page defines exemptions for qualifying in-person degrees in named countries and at KAUST. Do not assume that a Pakistani English-taught degree alone grants that exemption. A minimum score establishes a requirement, not a predicted admission chance."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://admissions.kaust.edu.sa/how-to-apply/entry-requirements",{"children":["",["$","a",null,{"href":"https://admissions.kaust.edu.sa/how-to-apply/entry-requirements","target":"_blank","rel":"noreferrer","children":"KAUST current entry requirements and English table"}]]}]]]}],"$undefined"]}],["$","section","2-KAUST Fellowship: admission route, not a second award form",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"KAUST Fellowship: admission route, not a second award form"}],[["$","p","The current FAQ says there is no separate KAUST Fellowship application. Admitted students normally receive it, with exceptions for external sponsorship or partnership arrangements. Declare existing substantial support and use the offer to establish the package that applies to you.",{"children":"The current FAQ says there is no separate KAUST Fellowship application. Admitted students normally receive it, with exceptions for external sponsorship or partnership arrangements. Declare existing substantial support and use the offer to establish the package that applies to you."}],["$","p","The funding page lists full tuition and bench-fee coverage, accommodation, health insurance, relocation assistance and a stipend. It states annual stipend values of US$20,000 for MS and US$25,000–30,000 for PhD, depending on qualifications and progress. These are annual values, not monthly salary amounts. Housing upgrades and personal circumstances can create additional costs.",{"children":"The funding page lists full tuition and bench-fee coverage, accommodation, health insurance, relocation assistance and a stipend. It states annual stipend values of US$20,000 for MS and US$25,000–30,000 for PhD, depending on qualifications and progress. These are annual values, not monthly salary amounts. Housing upgrades and personal circumstances can create additional costs."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$L28","$undefined"]}],"$L29","$L2a","$L2b","$L2c"]}]
