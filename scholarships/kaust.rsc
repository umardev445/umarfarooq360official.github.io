1a:T523,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is a separate KAUST Fellowship form required?","acceptedAnswer":{"@type":"Answer","text":"The current FAQ says no separate application is needed. Admitted students normally receive fellowship support, except in specified sponsorship or partnership arrangements. Your offer establishes the actual package."}},{"@type":"Question","name":"Is a Pakistani medium-of-instruction certificate sufficient?","acceptedAnswer":{"@type":"Answer","text":"KAUST's current entry page says it does not accept MOI certificates. Use an accepted test or a specifically defined exemption, and read any conditional provisions that apply to your applicant category."}},{"@type":"Question","name":"Are the published stipend amounts monthly?","acceptedAnswer":{"@type":"Answer","text":"No. The funding page describes US$20,000 per year for MS and US$25,000–30,000 per year for PhD, depending on qualifications and progress. Distinguish an annual value from the monthly payment."}},{"@type":"Question","name":"Is this the same application as KAUST VSRP?","acceptedAnswer":{"@type":"Answer","text":"No. This guide concerns graduate degree admission and fellowship support. VSRP is a separate visiting research internship with its own process."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page scholarship-release editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/scholarships/kaust/\",\"name\":\"KAUST Graduate Admission and Fellowship 2027 guide\",\"description\":\"Check KAUST Fall 2027 admission, the 3 January deadline, fellowship funding, current English requirements and the three-referee application workflow.\",\"url\":\"https://aspirecompass.org/scholarships/kaust/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-02\",\"date