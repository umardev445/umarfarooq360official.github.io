17:T574,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is the KAUST Spring 2027 PhD round still open?","acceptedAnswer":{"@type":"Answer","text":"No. Its stated deadline was 27 September 2026. The Fall 2027 round is the current open route shown on the official timeline."}},{"@type":"Question","name":"When does the KAUST Fall 2027 application open?","acceptedAnswer":{"@type":"Answer","text":"The official timeline lists 28 September 2026 as the opening date and 3 January 2027 as the deadline for Fall 2027 MS, MS/PhD and PhD applications."}},{"@type":"Question","name":"Is KAUST fully funded?","acceptedAnswer":{"@type":"Answer","text":"KAUST describes fellowship support for admitted graduate students, including tuition and major living and study support. Read the current offer terms for exact coverage."}},{"@type":"Question","name":"Can Pakistani students apply to KAUST?","acceptedAnswer":{"@type":"Answer","text":"Qualified international applicants, including Pakistanis, can apply when they meet the selected programme, degree, document and language requirements."}},{"@type":"Question","name":"Do I need a supervisor before applying?","acceptedAnswer":{"@type":"Answer","text":"Follow the current programme and admissions instructions. Researching faculty fit is important, but any required or optional contact depends on the selected route."}}]}1:["$","main",null,{"id":"main-content","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/scholarships/kaust/\",\"name\":\"KAUST Graduate Admission and Fellowship 2027 guide\",\"description\":\"Review KAUST Spring and Fall 2027 graduate deadlines, funded study, eligibility, application documents and STEM programme fit.\",\"url\":\"https://aspirecompass.org/scholarships/kaust/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-02\",\"dateModified\":