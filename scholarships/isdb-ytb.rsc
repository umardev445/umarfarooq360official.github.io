22:["$","p","Do not attach a stipend from an unrelated programme or describe the joint award as a loan based only on another IsDB scholarship’s conditions. Read the joint call and issued agreement for the current amounts, duties and any later obligations. This guide does not assert a current joint stipend amount or unverified repayment rule.",{"children":"Do not attach a stipend from an unrelated programme or describe the joint award as a loan based only on another IsDB scholarship’s conditions. Read the joint call and issued agreement for the current amounts, duties and any later obligations. This guide does not assert a current joint stipend amount or unverified repayment rule."}]
23:["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://turkiyeburslari.gov.tr/announcements/ytb-islamic-development-bank-isdb-joint-scholarship-program-2026-applicaiton-period-122",{"children":["",["$","a",null,{"href":"https://turkiyeburslari.gov.tr/announcements/ytb-islamic-development-bank-isdb-joint-scholarship-program-2026-applicaiton-period-122","target":"_blank","rel":"noreferrer","children":"Official 2026 joint notice: coverage"}]]}]]]}]
24:["$","section","3-How the joint route is selected in TBBS",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"How the joint route is selected in TBBS"}],[["$","p","The 2026 announcement directed eligible candidates to select “Yes” in the Joint Scholarship Programs section of the Türkiye Scholarships application. That is the instruction for the reviewed call; the next named announcement controls any future form.",{"children":"The 2026 announcement directed eligible candidates to select “Yes” in the Joint Scholarship Programs section of the Türkiye Scholarships application. That is the instruction for the reviewed call; the next named announcement controls any future form."}],["$","p","Use your own account and keep a record of the submitted route. If the option or programme is not available to your profile, first recheck country, level and the current application period. Do not alter factual education or nationality information to force a route to appear.",{"children":"Use your own account and keep a record of the submitted route. If the option or programme is not available to your profile, first recheck country, level and the current application period. Do not alter factual education or nationality information to force a route to appear."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://turkiyeburslari.gov.tr/announcements/ytb-islamic-development-bank-isdb-joint-scholarship-program-2026-applicaiton-period-122",{"children":["",["$","a",null,{"href":"https://turkiyeburslari.gov.tr/announcements/ytb-islamic-development-bank-isdb-joint-scholarship-program-2026-applicaiton-period-122","target":"_blank","rel":"noreferrer","children":"YTB joint-programme application instruction"}]]}]]]}],"$undefined"]}]
25:["$","section","4-Prepare a programme-fit file before the next call",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Prepare a programme-fit file before the next call"}],[["$","p","Build the academic case around the degree and eligible field. Identify a real problem you want to work on, the preparation you already have and the training the programme would add. Use evidence from your own work rather than a generic development slogan.",{"children":"Build the academic case around the degree and eligible field. Identify a real problem you want to work on, the preparation you already have and the training the programme would add. Use evidence from your own work rather than a generic development slogan."}],["$","p","Original outline: an applicant interested in water systems identifies a specific monitoring gap, explains a relevant project and lists the methods training they need. They then compare the eligible programmes against that learning need. A shortlist made this way gives the statement a clearer purpose than a list based only on city preference.",{"children":"Original outline: an applicant interested in water systems identifies a specific monitoring gap, explains a relevant project and lists the methods training they need. They then compare the eligible programmes against that learning need. A shortlist made this way gives the statement a clearer purpose than a list based only on city preference."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A preparation file for a future named call","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A preparation file for a future named call"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Record",{"scope":"col","children":"Record"}],["$","th","Useful evidence",{"scope":"col","children":"Useful evidence"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Eligibility"}],["$","td","1",{"children":"Country/degree/field row in the current attachment"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Academic preparation"}],["$","td","1",{"children":"Transcript and accepted qualification evidence"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Programme fit"}],["$","td","1",{"children":"Relevant course/research features and your learning gap"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Impact plan"}],["$","td","1",{"children":"Credible use of the training after the degree"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Submission"}],["$","td","1",{"children":"Current portal instructions and saved confirmation"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","5-Compare the joint route with other funding",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Compare the joint route with other funding"}],[["$","p","The joint award, general Türkiye Scholarships and university funding have different selection and coverage decisions. Do not create a duplicate university application solely because a third-party article says every route requires one; follow the relevant programme’s actual process.",{"children":"The joint award, general Türkiye Scholarships and university funding have different selection and coverage decisions. Do not create a duplicate university application solely because a third-party article says every route requires one; follow the relevant programme’s actual process."}],["$","p","Keep alternative plans in separate rows. Record whether admission is included, whether a separate university offer is required and which costs remain. An application you may make later cannot be counted as confirmed finance for a self-funded offer today.",{"children":"Keep alternative plans in separate rows. Record whether admission is included, whether a separate university offer is required and which costs remain. An application you may make later cannot be counted as confirmed finance for a self-funded offer today."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Compare the joint route with other funding","children":[["$","$L4","/scholarships/turkiye-burslari/",{"href":"/scholarships/turkiye-burslari/","children":["Türkiye Bursları eligibility and application",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/sabanci-university-admissions-scholarships/",{"href":"/guides/sabanci-university-admissions-scholarships/","children":["Sabancı degree-specific funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/bilkent-university-admissions-scholarships/",{"href":"/guides/bilkent-university-admissions-scholarships/","children":["Bilkent international aid",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
27:["$","section","6-Before using a joint scholarship deadline",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Before using a joint scholarship deadline"}],[["$","p","Check the named year and degree list again. A closed article with an unchanged “apply now” heading should not become your application calendar.",{"children":"Check the named year and degree list again. A closed article with an unchanged “apply now” heading should not become your application calendar."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L28",null,{"id":"scholarships/isdb-ytb:section-7","title":"Check your progress","items":["The official announcement names the actual intake I want.","My country appears under the correct degree-level route.","My intended field/programme is eligible.","I understand the current award terms rather than another IsDB scheme’s terms.","The portal is open for the named route before I attempt submission."]}],"$undefined","$undefined"]}]
