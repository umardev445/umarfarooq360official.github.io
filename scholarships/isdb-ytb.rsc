20:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is the IsDB–YTB scholarship open now?",{"children":[["$","summary",null,{"children":["Is the IsDB–YTB scholarship open now?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The reviewed 2026 period ended on 20 February 2026. This guide confirms no open 2027 joint call; check the named official announcement."}]]}],["$","details","Can Pakistani students apply for every IsDB–YTB degree?",{"children":[["$","summary",null,{"children":["Can Pakistani students apply for every IsDB–YTB degree?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Do not assume so. Pakistan appears in the reviewed attachment’s PhD country group. Eligibility for another degree must be checked in that degree’s own list."}]]}],["$","details","Do I apply through a separate IsDB portal?",{"children":[["$","summary",null,{"children":["Do I apply through a separate IsDB portal?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The reviewed 2026 joint notice directed applications through Türkiye Scholarships and its Joint Scholarship Programs selection. Follow the next named call for future instructions."}]]}],["$","details","Is a general IsDB scholarship announcement the same programme?",{"children":[["$","summary",null,{"children":["Is a general IsDB scholarship announcement the same programme?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Verify that the notice explicitly names the YTB–IsDB joint route. Other IsDB programmes can have different years, eligibility, funding and obligations."}]]}]]}]]}]
