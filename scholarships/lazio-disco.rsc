1b:["$","section","1-Check the institution and funding route before collecting documents",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Check the institution and funding route before collecting documents"}],[["$","p","Use the list of eligible institutions in the call, not the city in an advertisement. A student in Rome should verify the actual awarding institution and course. Sapienza admission and Lazio DiSCo are separate procedures with separate accounts and responsibilities.",{"children":"Use the list of eligible institutions in the call, not the city in an advertisement. A student in Rome should verify the actual awarding institution and course. Sapienza admission and Lazio DiSCo are separate procedures with separate accounts and responsibilities."}],["$","p","Then establish your degree level, year of study and whether this is a first application or a renewal. Keep a copy of the exact category you selected. Academic progress and previous qualifications can affect eligibility even when family income is low.",{"children":"Then establish your degree level, year of study and whether this is a first application or a renewal. Keep a copy of the exact category you selected. Academic progress and previous qualifications can affect eligibility even when family income is low."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Three decisions that belong to different offices","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Three decisions that belong to different offices"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Task",{"scope":"col","children":"Task"}],["$","th","Responsible route",{"scope":"col","children":"Responsible route"}],["$","th","Evidence to keep",{"scope":"col","children":"Evidence to keep"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Admission"}],["$","td","1",{"children":"University and programme"}],["$","td","2",{"children":"Application receipt and offer conditions"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Regional benefits"}],["$","td","1",{"children":"DiSCo competition"}],["$","td","2",{"children":"Submitted application and document requests"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Visa/pre-enrolment"}],["$","td","1",{"children":"University, Universitaly and consulate"}],["$","td","2",{"children":"Validated pre-enrolment and visa instructions"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Check the institution and funding route before collecting documents","children":[["$","$L4","/guides/sapienza-university-admissions-scholarships/",{"href":"/guides/sapienza-university-admissions-scholarships/","children":["Sapienza application pathway",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/universitaly-pre-enrolment/",{"href":"/guides/universitaly-pre-enrolment/","children":["Universitaly explained",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1c:["$","section","2-Prepare foreign-income evidence as a consistent file",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Prepare foreign-income evidence as a consistent file"}],[["$","p","Start with the household definition and reference period stated in the call. Make a document map for family composition, income, assets and any circumstances requiring a specific certificate. Each document should identify the person, issuing authority, period and currency where relevant.",{"children":"Start with the household definition and reference period stated in the call. Make a document map for family composition, income, assets and any circumstances requiring a specific certificate. Each document should identify the person, issuing authority, period and currency where relevant."}],["$","p","Translation and legalisation depend on the current rules and country of issue. Do not assume that an English bank balance replaces a required income or property certificate. If a document cannot be issued in your country, ask DiSCo about the accepted alternative before paying for a substitute.",{"children":"Translation and legalisation depend on the current rules and country of issue. Do not assume that an English bank balance replaces a required income or property certificate. If a document cannot be issued in your country, ask DiSCo about the accepted alternative before paying for a substitute."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L23",null,{"id":"scholarships/lazio-disco:section-3","title":"Check your progress","items":["Confirm the financial reference year in the current call","Match names and family relationships across certificates","Check translation, legalisation and upload instructions","Keep readable copies and submission receipts"]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Prepare foreign-income evidence as a consistent file","children":[["$","$L4","/guides/isee-parificato-international-students/",{"href":"/guides/isee-parificato-international-students/","children":["Understand ISEE parificato",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
1d:["$","section","3-Housing status and cash support are different decisions",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Housing status and cash support are different decisions"}],[["$","p","Read the resident, commuter and away-from-home definitions before estimating support. A housing request, a private rental contract and an assigned residence place are different types of evidence. Do not budget as if a room is guaranteed when you have only requested accommodation.",{"children":"Read the resident, commuter and away-from-home definitions before estimating support. A housing request, a private rental contract and an assigned residence place are different types of evidence. Do not budget as if a room is guaranteed when you have only requested accommodation."}],["$","p","Build two budgets: one with the benefit actually confirmed in writing and one with no early payment. Include rent deposit, travel and the first weeks of living expenses. This protects your plan if the ranking, accommodation allocation or payment takes longer than your arrival schedule.",{"children":"Build two budgets: one with the benefit actually confirmed in writing and one with no early payment. Include rent deposit, travel and the first weeks of living expenses. This protects your plan if the ranking, accommodation allocation or payment takes longer than your arrival schedule."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"Planning example: if you must arrive before a payment date, list the rent deposit and first month separately from your later annual budget. An expected award is not money already available in your account."}]]}],"$undefined","$undefined","$undefined","$undefined"]}]
1e:["$","section","4-Submit, inspect and retain a receipt",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Submit, inspect and retain a receipt"}],[["$","p","Work through the application using the official instructions for your identity and residence situation. Review every field before the final submission step. Saving a draft is not the same as submitting an application.",{"children":"Work through the application using the official instructions for your identity and residence situation. Review every field before the final submission step. Saving a draft is not the same as submitting an application."}],["$","p","After submitting, check the portal rather than relying only on email. Save the application number, final version, attachments and timestamps. If a ranking shows an exclusion, read the stated reason and correction or appeal route; a general message to a university may not reach the authority handling the benefit.",{"children":"After submitting, check the portal rather than relying only on email. Save the application number, final version, attachments and timestamps. If a ranking shows an exclusion, read the stated reason and correction or appeal route; a general message to a university may not reach the authority handling the benefit."}]],["$","ol",null,{"className":"process-steps","aria-label":"Submit, inspect and retain a receipt","children":[["$","li","Verify institution, degree and application category",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Verify institution, degree and application category"}]]}],["$","li","Prepare financial evidence using the stated reference year",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Prepare financial evidence using the stated reference year"}]]}],["$","li","Complete and submit the official benefit application",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Complete and submit the official benefit application"}]]}],["$","li","Track document requests, ranking status and permitted corrections",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Track document requests, ranking status and permitted corrections"}]]}],["$","li","Check payment and accommodation conditions separately",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Check payment and accommodation conditions separately"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
1f:["$","section","5-Renewal and competing awards",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Renewal and competing awards"}],[["$","p","Winning once does not remove the need to check the next competition. Record credit requirements, the date by which credits must be earned, enrolment conditions and any incompatibility with another award. A change from bachelor’s to master’s studies can require a different application category.",{"children":"Winning once does not remove the need to check the next competition. Record credit requirements, the date by which credits must be earned, enrolment conditions and any incompatibility with another award. A change from bachelor’s to master’s studies can require a different application category."}],["$","p","Before accepting several benefits, compare the compatibility clauses. Ask the awarding bodies about the combination in writing and keep their answer with your records. Avoid committing the same expense to two grants when their rules prohibit it.",{"children":"Before accepting several benefits, compare the compatibility clauses. Ask the awarding bodies about the combination in writing and keep their answer with your records. Avoid committing the same expense to two grants when their rules prohibit it."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
