18:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","figure",null,{"className":"page-visual","children":[["$","img",null,{"src":"/images/expansion-20261022/italy-lazio-1280.webp","srcSet":"/images/expansion-20261022/italy-lazio-640.webp 640w, /images/expansion-20261022/italy-lazio-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"River Tiber and historic buildings in Rome","decoding":"async","loading":"eager"}],["$","figcaption",null,{"children":"Destination or study photograph; not a photograph of the named university or scholarship."}]]}],["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"DiSCo is the regional right-to-study route for eligible institutions in Lazio. Admission alone does not enter you in the scholarship competition, and a scholarship application does not secure a university place."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Open the current DiSCo call, find your institution and applicant category, then record every application stage and document deadline."]}],"$undefined"]}],false,false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Current cycle: do not confuse a completion deadline with a new application",{"href":"#section-1","children":"Current cycle: do not confuse a completion deadline with a new application"}],["$","a","Check the institution and funding route before collecting documents",{"href":"#section-2","children":"Check the institution and funding route before collecting documents"}],["$","a","Prepare foreign-income evidence as a consistent file",{"href":"#section-3","children":"Prepare foreign-income evidence as a consistent file"}],["$","a","Housing status and cash support are different decisions",{"href":"#section-4","children":"Housing status and cash support are different decisions"}],["$","a","Submit, inspect and retain a receipt",{"href":"#section-5","children":"Submit, inspect and retain a receipt"}],["$","a","Renewal and competing awards",{"href":"#section-6","children":"Renewal and competing awards"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Current cycle: do not confuse a completion deadline with a new application",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Current cycle: do not confuse a completion deadline with a new application"}],[["$","p","The official 2026/27 notice published on 7 August stated that 11 August 2026 at 12:00 was the second-phase deadline for applicants admitted to that phase. That date has passed. It was not a fresh application opening for somebody who had not completed the earlier stage.",{"children":"The official 2026/27 notice published on 7 August stated that 11 August 2026 at 12:00 was the second-phase deadline for applicants admitted to that phase. That date has passed. It was not a fresh application opening for somebody who had not completed the earlier stage."}],["$","p","For a future intake, start at the current call and its amendments. Do not recycle dates from the previous competition. For an already submitted application, use the reserved area to check requests, rankings and any corrections that are still permitted.",{"children":"For a future intake, start at the current call and its amendments. Do not recycle dates from the previous competition. For an already submitted application, use the reserved area to check requests, rankings and any corrections that are still permitted."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$L1a","$undefined"]}],"$L1b","$L1c","$L1d","$L1e","$L1f"]}],false,"$L20","$L21"]}],"$L22"]}]
