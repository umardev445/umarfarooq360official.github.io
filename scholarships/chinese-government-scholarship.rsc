1e:["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"2027/28 example"}],["$","td","1",{"children":"Jilin Agricultural University has published a Type B postgraduate call"}],["$","td","2",{"children":"Use its current notice, not a nationwide assumed deadline"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Type A nomination"}],["$","td","1",{"children":"The responsible authority sets its own process"}],["$","td","2",{"children":"Check the authority for your applicant country"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"HEC Pakistan"}],["$","td","1",{"children":"Reviewed 2026/27 round closed on 5 January 2026"}],["$","td","2",{"children":"Do not treat it as a new open round"}]],"$undefined"]}]]}]
1f:["$","section","1-What a CSC award actually represents",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"What a CSC award actually represents"}],[["$","p","CSC is the China Scholarship Council in this study-in-China context. It should not be confused with Commonwealth Scholarship Commission results that also use the initials CSC. Search for the full programme name and check the receiving organisation before entering personal details.",{"children":"CSC is the China Scholarship Council in this study-in-China context. It should not be confused with Commonwealth Scholarship Commission results that also use the initials CSC. Search for the full programme name and check the receiving organisation before entering personal details."}],["$","p","A CSC scholarship is not an unrestricted cash grant you can take to any university. The programme, host, subject, qualification and funding duration must fit the award. Admission assessment and scholarship selection can be separate stages, and the final scholarship decision may follow a university recommendation.",{"children":"A CSC scholarship is not an unrestricted cash grant you can take to any university. The programme, host, subject, qualification and funding duration must fit the award. Admission assessment and scholarship selection can be separate stages, and the final scholarship decision may follow a university recommendation."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","2-Full and partial support need different budgets",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Full and partial support need different budgets"}],[["$","p","A full scholarship may cover tuition, accommodation or an accommodation subsidy, insurance and a living allowance under the relevant scheme. Partial scholarships can support fewer categories. Read the specific award notice rather than assuming every CSC route pays identical benefits.",{"children":"A full scholarship may cover tuition, accommodation or an accommodation subsidy, insurance and a living allowance under the relevant scheme. Partial scholarships can support fewer categories. Read the specific award notice rather than assuming every CSC route pays identical benefits."}],["$","p","For example, the reviewed Jilin Agricultural University 2027/28 notice includes tuition and application-fee waivers, accommodation, living support and medical insurance, while international travel remains the recipient’s responsibility. This example does not establish fee waivers at other hosts. Ask the university for the payment schedule and any conditions attached to continued support.",{"children":"For example, the reviewed Jilin Agricultural University 2027/28 notice includes tuition and application-fee waivers, accommodation, living support and medical insurance, while international travel remains the recipient’s responsibility. This example does not establish fee waivers at other hosts. Ask the university for the payment schedule and any conditions attached to continued support."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","3-Eligibility is the intersection of three sets of rules",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Eligibility is the intersection of three sets of rules"}],[["$","p","First check the scholarship programme’s nationality, degree and age conditions. Then check the university’s academic and language requirements. Finally check your department’s prerequisites, research fit or portfolio requirements. Passing one layer does not remove the others.",{"children":"First check the scholarship programme’s nationality, degree and age conditions. Then check the university’s academic and language requirements. Finally check your department’s prerequisites, research fit or portfolio requirements. Passing one layer does not remove the others."}],["$","p","A graduate applicant should be able to explain how the previous qualification prepares them for the intended programme. If your transcript uses an unusual grading scale, provide the institution’s scale rather than inventing a percentage conversion. Final-year applicants should verify whether a provisional graduation document is accepted and when the final certificate must be presented.",{"children":"A graduate applicant should be able to explain how the previous qualification prepares them for the intended programme. If your transcript uses an unusual grading scale, provide the institution’s scale rather than inventing a percentage conversion. Final-year applicants should verify whether a provisional graduation document is accepted and when the final certificate must be presented."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L29",null,{"id":"scholarships/chinese-government-scholarship:section-4","title":"Check your progress","items":["Scholarship applicant category is eligible","Previous qualification meets entry requirements","Age cutoff and reference date are understood","Language evidence is accepted for the course","Any nationality-history documentation is available"]}],"$undefined","$undefined"]}]
22:["$","section","4-Type A and Type B describe routes, not scholarship rankings",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Type A and Type B describe routes, not scholarship rankings"}],[["$","p","Type A commonly involves an authorised dispatching or nomination organisation. Type B is normally university-managed under the relevant host programme. Neither label means automatic admission, higher selection odds or a guaranteed level of funding. Follow the current receiving organisation and agency number.",{"children":"Type A commonly involves an authorised dispatching or nomination organisation. Type B is normally university-managed under the relevant host programme. Neither label means automatic admission, higher selection odds or a guaranteed level of funding. Follow the current receiving organisation and agency number."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Type A and Type B describe routes, not scholarship rankings","children":[["$","$L4","/guides/csc-scholarship-type-a-vs-type-b/",{"href":"/guides/csc-scholarship-type-a-vs-type-b/","children":["Compare CSC Type A and Type B",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
23:["$","section","5-Create a funding comparison before applying",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Create a funding comparison before applying"}],[["$","p","Write the programme’s promised support in one column and your expected expenses in another. Include translation, testing, medical documentation, travel and initial living costs. Mark uncertain items explicitly. If you would be unable to enroll without full support, state that constraint in your shortlist rather than accepting an unaffordable self-funded offer.",{"children":"Write the programme’s promised support in one column and your expected expenses in another. Include translation, testing, medical documentation, travel and initial living costs. Mark uncertain items explicitly. If you would be unable to enroll without full support, state that constraint in your shortlist rather than accepting an unaffordable self-funded offer."}],["$","p","Keep scholarship and course deadlines as two separate tracker fields. A later self-funded admission deadline does not extend the scholarship deadline. When an official page is undated or contains an old year, locate the dated intake notice or contact admissions before paying a fee.",{"children":"Keep scholarship and course deadlines as two separate tracker fields. A later self-funded admission deadline does not extend the scholarship deadline. When an official page is undated or contains an old year, locate the dated intake notice or contact admissions before paying a fee."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","6-How selection and renewal affect your plans",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"How selection and renewal affect your plans"}],[["$","p","Selection can involve document review, departmental assessment and nomination before the final scholarship approval. Do not describe a pre-admission letter as a scholarship award. After an offer, read the registration, academic-progress and annual-review conditions. Keep a backup plan until the final result and funding terms are clear.",{"children":"Selection can involve document review, departmental assessment and nomination before the final scholarship approval. Do not describe a pre-admission letter as a scholarship award. After an offer, read the registration, academic-progress and annual-review conditions. Keep a backup plan until the final result and funding terms are clear."}]],["$","ol",null,{"className":"process-steps","aria-label":"How selection and renewal affect your plans","children":[["$","li","Shortlist eligible courses and current calls",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Shortlist eligible courses and current calls"}]]}],["$","li","Identify Type A or Type B ownership",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Identify Type A or Type B ownership"}]]}],["$","li","Prepare the university and scholarship document sets",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Prepare the university and scholarship document sets"}]]}],["$","li","Submit each required application",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Submit each required application"}]]}],["$","li","Track review requests and retain the final award letter",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"Track review requests and retain the final award letter"}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","7-Explore the next steps in this study pathway",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Explore the next steps in this study pathway"}],[["$","p","Choose the institution, funding or preparation task that matches your situation. The guides separate admission, funding and administrative decisions.",{"children":"Choose the institution, funding or preparation task that matches your situation. The guides separate admission, funding and administrative decisions."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Explore the next steps in this study pathway","children":[["$","$L4","/guides/csca-exam/",{"href":"/guides/csca-exam/","children":["CSCA exam: requirements, subjects and registration",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/china-student-visa-x1-x2/",{"href":"/guides/china-student-visa-x1-x2/","children":["China student visa: X1, X2 and the document pathway",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/ustc-scholarships-admissions/",{"href":"/guides/ustc-scholarships-admissions/","children":["USTC scholarships and international admissions",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/cas-anso/",{"href":"/scholarships/cas-anso/","children":["CAS-ANSO scholarship: USTC, UCAS and the application route",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/china-tuition-fees-living-costs/",{"href":"/guides/china-tuition-fees-living-costs/","children":["Study costs in China: tuition, accommodation and living budget",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/njust-scholarships-admissions/",{"href":"/guides/njust-scholarships-admissions/","children":["NJUST scholarships and international admissions",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/china-foreigner-physical-examination-form/",{"href":"/guides/china-foreigner-physical-examination-form/","children":["China Foreigner Physical Examination Form: document guide",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
