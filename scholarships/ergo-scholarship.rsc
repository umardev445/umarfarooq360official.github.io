1a:T4f0,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is ER.GO the same application as Bologna admission?","acceptedAnswer":{"@type":"Answer","text":"No. University admission and regional benefits have separate purposes and deadlines. Track both, and check whether enrolment or fee-related actions must also be completed at the university."}},{"@type":"Question","name":"Is a low family income enough?","acceptedAnswer":{"@type":"Answer","text":"No. Economic eligibility includes the required income and asset assessment, and enrolment and merit conditions also apply. Missing evidence cannot be replaced by simply stating that the family has limited resources."}},{"@type":"Question","name":"Does eligible mean I can spend the scholarship now?","acceptedAnswer":{"@type":"Answer","text":"Not necessarily. Read the assignment and any conditions in your official record. Eligibility, assignment and actual payment are different stages."}},{"@type":"Question","name":"Can I rely on the largest non-resident amount?","acceptedAnswer":{"@type":"Answer","text":"Only after confirming the current rules and the accepted domicile evidence for your situation. Prepare a budget that reflects the benefit you can actually receive."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/scholarships/ergo-scholarship/\",\"name\":\"ER.GO scholarship for international students: documents, status and application\",\"description\":\"Plan an ER.GO application with overseas financial documents, domicile evidence, ranking explanations and separate university admission steps.\",\"url\":\"https://aspirecompass.org/scholarships/ergo-scholarship/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-20\",\"dateModified\":\"2026-10-20\",