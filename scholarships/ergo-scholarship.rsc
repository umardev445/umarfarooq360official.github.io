1f:["$","figure",null,{"className":"page-visual page-visual--inline","children":[["$","img",null,{"src":"/images/research-2026-10/ergo-1280.webp","srcSet":"/images/research-2026-10/ergo-640.webp 640w, /images/research-2026-10/ergo-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Conceptual illustration for er.go scholarship for international students: documents, status and application","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Original conceptual illustration; not a photograph of a named university or scholarship recipient."}]]}]
20:["$","article",null,{"className":"article-body article-body--guide","children":[null,["$","section","1-Three conditions have to work together",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Three conditions have to work together"}],[["$","p","Financial need alone is not the whole application. ER.GO’s scholarship guidance distinguishes economic evidence, academic merit and enrolment requirements. A first-year applicant should understand which checks apply at entry and which apply later to keep the benefit.",{"children":"Financial need alone is not the whole application. ER.GO’s scholarship guidance distinguishes economic evidence, academic merit and enrolment requirements. A first-year applicant should understand which checks apply at entry and which apply later to keep the benefit."}],["$","p","Write your situation in plain terms before using the portal: new degree or continuing year, previous Italian university attendance, family residence and the institution you intend to join. If you have transferred, withdrawn or studied previously, ask ER.GO about the effect on your benefit position rather than simply selecting “first year” because this is your first year at a new university.",{"children":"Write your situation in plain terms before using the portal: new degree or continuing year, previous Italian university attendance, family residence and the institution you intend to join. If you have transferred, withdrawn or studied previously, ask ER.GO about the effect on your benefit position rather than simply selecting “first year” because this is your first year at a new university."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.er-go.it/international-students/focus-on-scholarship",{"children":["",["$","a",null,{"href":"https://www.er-go.it/international-students/focus-on-scholarship","target":"_blank","rel":"noreferrer","children":"ER.GO scholarship requirements and ranking FAQ"}]]}]]]}],"$undefined"]}],["$","section","2-Overseas income and assets: prepare a consistent household file",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Overseas income and assets: prepare a consistent household file"}],[["$","p","Official ER.GO guidance says overseas economic circumstances are assessed using documents from the relevant authorities, with required translation and legalisation. Both income and asset indicators matter. A low salary figure does not resolve missing property or bank evidence.",{"children":"Official ER.GO guidance says overseas economic circumstances are assessed using documents from the relevant authorities, with required translation and legalisation. Both income and asset indicators matter. A low salary figure does not resolve missing property or bank evidence."}],["$","p","Use the announcement to identify the reference year, household members and asset dates before requesting documents. Record who issued each document and what fact it proves. If a parent has no income or property, find the accepted evidence for that situation; an unexplained blank is different from documented absence.",{"children":"Use the announcement to identify the reference year, household members and asset dates before requesting documents. Record who issued each document and what fact it proves. If a parent has no income or property, find the accepted evidence for that situation; an unexplained blank is different from documented absence."}]],"$undefined","$L24","$undefined","$undefined","$undefined","$undefined","$L25","$undefined"]}],"$L26","$L27","$L28","$L29","$L2a"]}]
