1c:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"ER.GO assesses regional benefits through economic, enrolment and academic conditions. Foreign-income documents and domicile evidence can be decisive. The ordinary 2026/27 benefit deadline has passed; later category-specific notices must be checked separately."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Confirm that your institution and applicant category are covered, then read the current announcement before collecting financial documents."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L5","#official-sources",{"href":"#official-sources","children":["Official sources",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/team/hafiz-umar-farooq/",{"href":"/team/hafiz-umar-farooq/","children":["Editorial contact",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","First identify the correct benefit and cycle",{"href":"#section-1","children":"Fir