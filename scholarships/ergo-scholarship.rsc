22:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is ER.GO the same application as Bologna admission?",{"children":[["$","summary",null,{"children":["Is ER.GO the same application as Bologna admission?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. University admission and regional benefits have separate purposes and deadlines. Track both, and check whether enrolment or fee-related actions must also be completed at the university."}]]}],["$","details","Is a low family income enough?",{"children":[["$","summary",null,{"children":["Is a low family income enough?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Economic eligibility includes the required income and asset assessment, and enrolment and merit conditions also apply. Missing evidence cannot be replaced by simply stating that the family has limited resources."}]]}],["$","details","Does eligible mean I can spend the scholarship now?",{"children":[["$","summary",null,{"children":["Does eligible mean I can spend the scholarship now?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not necessarily. Read the assignment and any conditions in your official record. Eligibility, assignment and actual payment are different stages."}]]}],["$","details","Can I rely on the largest non-resident amount?",{"children":[["$","summary",null,{"children":["Can I rely on the largest non-resident amount?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Only after confirming the current rules and the accepted domicile evidence for your situation. Prepare a budget that reflects the benefit you can actually receive."}]]}]]}]]}]
