29:["$","span","https://www.nzscholarships.govt.nz/check-eligible-countries/",{"children":["",["$","a",null,{"href":"https://www.nzscholarships.govt.nz/check-eligible-countries/","target":"_blank","rel":"noreferrer","children":"Manaaki: citizenship, region and degree availability"}]]}]
2a:["$","section","2-Make the subject argument specific to your country",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Make the subject argument specific to your country"}],[["$","p","Manaaki publishes country-specific recommended subject areas. Use the relevant country section when looking through institution catalogues. A broad degree title such as management or engineering is not enough to show how the actual modules address an identified development need.",{"children":"Manaaki publishes country-specific recommended subject areas. Use the relevant country section when looking through institution catalogues. A broad degree title such as management or engineering is not enough to show how the actual modules address an identified development need."}],["$","p","An original course-fit worksheet can have four columns: the country priority you checked, a module or research topic, your relevant work or study evidence, and a realistic use after returning. For example, a fictional applicant concerned with local flood preparedness compares a course’s water-management and disaster-planning content with a specific task they understand. They should not simply attach the same development paragraph to two courses with very different curricula. Describe a plausible contribution without inventing an employer commitment or promising a national-scale outcome.",{"children":"An original course-fit worksheet can have four columns: the country priority you checked, a module or research topic, your relevant work or study evidence, and a realistic use after returning. For example, a fictional applicant concerned with local flood preparedness compares a course’s water-management and disaster-planning content with a specific task they understand. They should not simply attach the same development paragraph to two courses with very different curricula. Describe a plausible contribution without inventing an employer commitment or promising a national-scale outcome."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original subject-fit record to complete in your own words","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original subject-fit record to complete in your own words"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Field",{"scope":"col","children":"Field"}],["$","th","Evidence to collect",{"scope":"col","children":"Evidence to collect"}],["$","th","Unresolved example",{"scope":"col","children":"Unresolved example"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Country priority"}],["$","td","1",{"children":"Current relevant Manaaki country section"}],["$","td","2",{"children":"A subject taken from another country’s list"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Course content"}],["$","td","1",{"children":"Actual modules, project or research area"}],["$","td","2",{"children":"Only a broad degree title"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Your starting evidence"}],["$","td","1",{"children":"Experience or study you can explain"}],["$","td","2",{"children":"A role or achievement copied from a sample"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Intended use"}],["$","td","1",{"children":"A concrete activity and its limits"}],["$","td","2",{"children":"An unsupported promise of national impact"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",["$L2e"]]}],"$undefined"]}]
2b:["$","section","3-Separate scholarship eligibility from institution entry",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Separate scholarship eligibility from institution entry"}],[["$","p","The eligibility guidance asks applicants to check matters including citizenship, home-country residence, work experience and previous scholarship history. Institution academic and English requirements are another layer. A positive answer to a broad eligibility questionnaire cannot certify that a specific programme will admit you.",{"children":"The eligibility guidance asks applicants to check matters including citizenship, home-country residence, work experience and previous scholarship history. Institution academic and English requirements are another layer. A positive answer to a broad eligibility questionnaire cannot certify that a specific programme will admit you."}],["$","p","The owner says scholarship applicants do not need to apply for institution admission until notified that they are preferred candidates, while they must assess likely academic and English suitability before the scholarship application. Follow the current sequence for your route; do not turn this into a universal admission-first requirement. A PhD applicant should investigate suitable supervision early and keep an accurate record of any discussions. An introductory email is not a supervisor’s acceptance or an admission decision.",{"children":"The owner says scholarship applicants do not need to apply for institution admission until notified that they are preferred candidates, while they must assess likely academic and English suitability before the scholarship application. Follow the current sequence for your route; do not turn this into a universal admission-first requirement. A PhD applicant should investigate suitable supervision early and keep an accurate record of any discussions. An introductory email is not a supervisor’s acceptance or an admission decision."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.nzscholarships.govt.nz/check-eligibility-criteria/",{"children":["",["$","a",null,{"href":"https://www.nzscholarships.govt.nz/check-eligibility-criteria/","target":"_blank","rel":"noreferrer","children":"Manaaki: residence, work, institution entry and PhD preparation"}]]}]]]}],"$undefined"]}]
2c:["$","section","4-Use a document dependency record rather than a green tick for everything",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Use a document dependency record rather than a green tick for everything"}],[["$","p","Start a private evidence record with the document issuer, the version available, the required submission stage and the person responsible for the next action. The application instructions call for an academic transcript with its grading scale and explain later verified English-translated evidence for shortlisted applicants. Reopen the current instructions before paying for a particular verification or translation service.",{"children":"Start a private evidence record with the document issuer, the version available, the required submission stage and the person responsible for the next action. The application instructions call for an academic transcript with its grading scale and explain later verified English-translated evidence for shortlisted applicants. Reopen the current instructions before paying for a particular verification or translation service."}],["$","p","In a fictional plan, the transcript is ready but its grading scale is missing, and an employer letter is still awaiting an authorised signature. Those are two different unfinished tasks. Mark them separately, identify who can resolve each and retain the issued versions. A file that has been requested is not yet in your possession; an upload selected on your device is not proof that an application reached its submitted state. Keep private identity and financial records out of public advice requests.",{"children":"In a fictional plan, the transcript is ready but its grading scale is missing, and an employer letter is still awaiting an authorised signature. Those are two different unfinished tasks. Mark them separately, identify who can resolve each and retain the issued versions. A file that has been requested is not yet in your possession; an upload selected on your device is not proof that an application reached its submitted state. Keep private identity and financial records out of public advice requests."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.nzscholarships.govt.nz/how-to-apply-for-a-scholarship/",{"children":["",["$","a",null,{"href":"https://www.nzscholarships.govt.nz/how-to-apply-for-a-scholarship/","target":"_blank","rel":"noreferrer","children":"Manaaki: region-specific application process and documents"}]]}]]]}],"$undefined"]}]
2d:["$","section","5-Build a plan that still works while the decision is unknown",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Build a plan that still works while the decision is unknown"}],[["$","p","Before an offer, compare only support actually established by the current award terms with costs you can substantiate. Do not assume a particular allowance, reimbursement date or accompanying-family benefit from an older article. A course choice, a preferred-candidate status and a final scholarship offer are different milestones.",{"children":"Before an offer, compare only support actually established by the current award terms with costs you can substantiate. Do not assume a particular allowance, reimbursement date or accompanying-family benefit from an older article. A course choice, a preferred-candidate status and a final scholarship offer are different milestones."}],["$","p","Use this original fictional cash scenario: an applicant expects to pay 400 for document and test tasks and 600 for other preparation, all in one stated currency. That is 1,000 required before any assumed reimbursement. If confirmed available funds are 750, the immediate shortfall is 250. This is not a Manaaki allowance calculation. It shows why an expected future award should not be entered as cash already available. Revise the plan from the real offer and institution instructions when they arrive, and use other suitable funding routes if an eligibility gate remains unsatisfied.",{"children":"Use this original fictional cash scenario: an applicant expects to pay 400 for document and test tasks and 600 for other preparation, all in one stated currency. That is 1,000 required before any assumed reimbursement. If confirmed available funds are 750, the immediate shortfall is 250. This is not a Manaaki allowance calculation. It shows why an expected future award should not be entered as cash already available. Revise the plan from the real offer and institution instructions when they arrive, and use other suitable funding routes if an eligibility gate remains unsatisfied."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Build a plan that still works while the decision is unknown","children":[["$","$L5","/scholarships/",{"href":"/scholarships/","children":["Compare scholarship types and status",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/motivation-letter/",{"href":"/guides/motivation-letter/","children":["Prepare a relevant motivation statement",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/guides/scholarship-application/",{"href":"/guides/scholarship-application/","children":["Check your application evidence",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
