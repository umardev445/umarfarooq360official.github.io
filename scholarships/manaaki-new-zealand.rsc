1d:T517,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is Manaaki available to every international student?","acceptedAnswer":{"@type":"Answer","text":"No. Use the published citizenship list, country-specific levels and other eligibility criteria. A university course being open to international students does not establish Manaaki eligibility."}},{"@type":"Question","name":"Can a Pakistani citizen use this reviewed Asian route?","acceptedAnswer":{"@type":"Answer","text":"Pakistan is absent from the reviewed eligible Asian-country list. Research other funding rather than treating a general international admission offer as a Manaaki exception."}},{"@type":"Question","name":"Does the March 2027 portal announcement establish my course start date?","acceptedAnswer":{"@type":"Answer","text":"No. It identifies an application window. Confirm the actual institution, degree and award commencement instructions separately."}},{"@type":"Question","name":"Should I apply for university admission first?","acceptedAnswer":{"@type":"Answer","text":"The owner says admission is not needed until preferred-candidate notification, while likely academic and English entry suitability should be checked beforehand. Follow the current instructions for your exact route."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--guide","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/scholarships/manaaki-new-zealand/\",\"name\":\"Manaaki New Zealand Scholarships: country, degree and next-window checks\",\"description\":\"Check Manaaki citizenship and degree restrictions, the announced March 2027 application window, subject priorities and an original evidence-and-dependency worksheet.\",\"url\":\"https://aspirecompass.org/scholarships/manaaki-new-zealand/\",\"inLanguage\":\"en\",\"d