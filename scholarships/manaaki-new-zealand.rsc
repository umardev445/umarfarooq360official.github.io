1f:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L5",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L5",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Manaaki is restricted by citizenship, degree and other criteria. The owner announces a future portal window of 1–31 March 2027; it is not open at the dated review. Check your country and level first, then the appropriate subject, institution and evidence requirements."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Complete the country-degree worksheet, retaining any unresolved or negative gate, before preparing an application for the future window."]}],"$undefined"]}],["$","figure",null,{"className":"page-visual day15-guide-visual page-visual--inline","children":[["$","img",null,{"src":"/images/day15/research-library-1280.webp","srcSet":"/images/day15/research-library-640.webp 640w, /images/day15/research-library-1280.webp 1280w","sizes":"(max-width: 860px) calc(100vw - 32px), 440px","width":1280,"height":853,"alt":"Illustrative scene of a student comparing a book and written research notes","decoding":"async","loading":"lazy"}],["$","figcaption",null,{"children":"Illustrative study scene. The people and setting do not represent this scholarship or university."}]]}],false,false,false,null,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","What the latest window announcement does and does not establish",{"href":"#section-1","children":"What the latest window announcement does and does not establish"}],["$","a","Country comes before course popularity",{"href":"#section-2","children":"Country comes before course popularity"}],["$","a","Make the subject argument specific to your country",{"href":"#section-3","children":"Make the subject argument specific to your country"}],["$","a","Separate scholarship eligibility from institution entry",{"href":"#section-4","children":"Separate scholarship eligibility from institution entry"}],["$","a","Use a document dependency record rather than a green tick for everything",{"href":"#section-5","children":"Use a document dependency record rather than a green tick for everything"}],["$","a","Build a plan that still works while the decision is unknown",{"href":"#section-6","children":"Build a plan that still works while the decision is unknown"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","div",null,{"className":"article-body","children":[["$","section","What the latest window announcement does and does not establish",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"What the latest window announcement does and does not establish"}],[["$","p","The tertiary landing page announces that the portal will open on 1 March 2027 and close on 31 March 2027. At this 19 November 2026 review, those are future dates. The country page still says applications have closed; that older status line should not be turned into either an opening today or a denial that a later window has been announced.",{"children":"The tertiary landing page announces that the portal will open on 1 March 2027 and close on 31 March 2027. At this 19 November 2026 review, those are future dates. The country page still says applications have closed; that older status line should not be turned into either an opening today or a denial that a later window has been announced."}],"$L21"],"$undefined","$L22","$undefined","$undefined","$undefined","$undefined","$L23","$undefined"]}]]}],"$L24",false,false,false,"$L25",false,"$L26","$L27"]}],"$L28"]}]
