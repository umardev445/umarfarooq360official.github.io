19:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[["$","p",null,{"className":"editorial-contact","children":["Published by ",["$","$L4",null,{"href":"/editorial-policy/","children":"AspireCompass Editorial Team"}]," · Editorial contact: ",["$","$L4",null,{"href":"/team/hafiz-umar-farooq/","children":"Hafiz Umar Farooq"}]]}],["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"MAECI is Italian Government funding for eligible study and research routes. Selection is separate from university admission. The checked 2026/27 call is closed; a new 2027/28 deadline is not confirmed in the sources reviewed here."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Identify your eligible-country entry and study category before preparing an application. Use the ministry call, not a date copied from a scholarship listing."]}],["$","nav",null,{"className":"answer-links","aria-label":"Useful next steps","children":[["$","$L4","#official-sources",{"href":"#official-sources","children":["Official sources",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/team/hafiz-umar-farooq/",{"href":"/team/hafiz-umar-farooq/","children":["Editorial contact",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}],false,false,["$","details",null,{"className":"mobile-contents","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Cycle status: what is confirmed",{"href":"#section-1","children":"Cycle status: what is confirmed"}],["$","a","Choose the study route before assessing your chances",{"href":"#section-2","children":"Choose the study route before assessing your chances"}],["$","a","What the grant covers—and the costs to keep separate",{"href":"#section-3","children":"What the grant covers—and the costs to keep separate"}],["$","a","Admission and funding: organise two connected timelines",{"href":"#section-4","children":"Admission and funding: organise two connected timelines"}],["$","a","Prepare evidence by purpose, not a copied universal checklist",{"href":"#section-5","children":"Prepare evidence by purpose, not a copied universal checklist"}],["$","a","Submit a file you can trace after the deadline",{"href":"#section-6","children":"Submit a file you can trace after the deadline"}],["$","a","MAECI versus regional DSU: compare before choosing",{"href":"#section-7","children":"MAECI versus regional DSU: compare before choosing"}]]}]]}],false,false,false,false,false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","section","0-Cycle status: what is confirmed",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Cycle status: what is confirmed"}],[["$","p","The ministry page and its 2026/27 call state 26 March 2026 at 14:00 Italian time as the application deadline. That date has passed. This page remains useful for preparation, but it is not an announcement that a fresh round is open.",{"children":"The ministry page and its 2026/27 call state 26 March 2026 at 14:00 Italian time as the application deadline. That date has passed. This page remains useful for preparation, but it is not an announcement that a fresh round is open."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"MAECI cycle record checked 20 October 2026","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"MAECI cycle record checked 20 October 2026"}],"$L1b","$L1c"]}]}],"$L1d"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L1e","$L1f","$L20","$L21","$L22","$L23"]}],false,"$L24","$L25"]}],"$L26"]}]
