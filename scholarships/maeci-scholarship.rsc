1c:["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"2026/27 central call"}],["$","td","1",{"children":"Closed"}],["$","td","2",{"children":"Use it only as the named previous-cycle reference"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"2027/28 call"}],["$","td","1",{"children":"Not confirmed here"}],["$","td","2",{"children":"Watch the ministry and Study in Italy notices"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"University admission"}],["$","td","1",{"children":"Programme-specific"}],["$","td","2",{"children":"Check the course separately; scholarship timing does not replace admission timing"}]],"$undefined"]}]]}]
1d:["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://www.esteri.it/en/servizi-opportunita/opportunita/borse-di-studio/per-cittadini-stranieri/borsestudio_stranieri/","target":"_blank","rel":"noreferrer","children":"Official guidance"}]]}]
1e:["$","section","1-Choose the study route before assessing your chances",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Choose the study route before assessing your chances"}],[["$","p","Start with the award category, not the headline amount. A master’s applicant, doctoral applicant and research visitor may need different academic evidence. Read the exact category in the current call before treating an age rule, language condition or document as applicable to you.",{"children":"Start with the award category, not the headline amount. A master’s applicant, doctoral applicant and research visitor may need different academic evidence. Read the exact category in the current call before treating an age rule, language condition or document as applicable to you."}],["$","p","Build a one-page eligibility note: citizenship, residence, intended degree, previous qualification, teaching language and any earlier study in Italy. Then match each point against the call. If a condition is ambiguous, ask the programme authority a narrow question with the relevant article number rather than relying on a generic “all nationalities” claim.",{"children":"Build a one-page eligibility note: citizenship, residence, intended degree, previous qualification, teaching language and any earlier study in Italy. Then match each point against the call. If a condition is ambiguous, ask the programme authority a narrow question with the relevant article number rather than relying on a generic “all nationalities” claim."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Check the official eligible-country list for the named cycle.",{"children":"Check the official eligible-country list for the named cycle."}],["$","li","Confirm whether your precise degree or research route is funded.",{"children":"Confirm whether your precise degree or research route is funded."}],["$","li","Separate academic admission eligibility from scholarship eligibility.",{"children":"Separate academic admission eligibility from scholarship eligibility."}],["$","li","Check restrictions on existing qualifications, prior study and combining awards.",{"children":"Check restrictions on existing qualifications, prior study and combining awards."}]]}],"$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://www.esteri.it/wp-content/uploads/2026/03/Bando-26-27-ENG.pdf",{"children":["",["$","a",null,{"href":"https://www.esteri.it/wp-content/uploads/2026/03/Bando-26-27-ENG.pdf","target":"_blank","rel":"noreferrer","children":"Read the official call"}]]}]]]}],"$undefined"]}]
1f:["$","section","2-What the grant covers—and the costs to keep separate",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"What the grant covers—and the costs to keep separate"}],[["$","p","For the study categories identified in Article 11, the 2026/27 call specifies a total grant of €10,800. That is a named-cycle amount, not a promise for every programme or a future intake. The call also provides scholarship-period insurance with exclusions.",{"children":"For the study categories identified in Article 11, the 2026/27 call specifies a total grant of €10,800. That is a named-cycle amount, not a promise for every programme or a future intake. The call also provides scholarship-period insurance with exclusions."}],["$","p","Tuition exemption is university-dependent. Article 9 states that regional fees remain payable and are not reimbursed by MAECI. A student should therefore ask the chosen university for a personal fee assessment before treating the award as a zero-cost study plan.",{"children":"Tuition exemption is university-dependent. Article 9 states that regional fees remain payable and are not reimbursed by MAECI. A student should therefore ask the chosen university for a personal fee assessment before treating the award as a zero-cost study plan."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Read the benefit beside its condition","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Read the benefit beside its condition"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Budget line",{"scope":"col","children":"Budget line"}],["$","th","How to interpret it",{"scope":"col","children":"How to interpret it"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Grant"}],["$","td","1",{"children":"Check the category, duration and payment conditions in the call"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"University tuition"}],["$","td","1",{"children":"Ask the institution whether its exemption applies"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Regional fee"}],["$","td","1",{"children":"Keep this separate from an advertised tuition waiver"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Insurance"}],["$","td","1",{"children":"Read the covered period and exclusions"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Before-arrival costs"}],["$","td","1",{"children":"Budget for tests, documents, travel, deposits and visa-related expenses"}]],"$undefined"]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://www.esteri.it/wp-content/uploads/2026/03/Bando-26-27-ENG.pdf","target":"_blank","rel":"noreferrer","children":"2026/27 call, Articles 9–11"}]]}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","3-Admission and funding: organise two connected timelines",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Admission and funding: organise two connected timelines"}],[["$","p","Do not wait for one process to finish before learning the other process’s deadline. Shortlist a course, identify its admissions portal and record the university’s required documents. In a second column, record the scholarship portal, supporting evidence and any admission-related requirement for your category.",{"children":"Do not wait for one process to finish before learning the other process’s deadline. Shortlist a course, identify its admissions portal and record the university’s required documents. In a second column, record the scholarship portal, supporting evidence and any admission-related requirement for your category."}],["$","p","An award application does not reserve a university seat. Equally, an academic offer is not a scholarship award. The useful planning question is: what must be submitted, accepted or completed by each authority’s deadline? A course closing before a funding decision needs a different plan from one accepting a conditional application.",{"children":"An award application does not reserve a university seat. Equally, an academic offer is not a scholarship award. The useful planning question is: what must be submitted, accepted or completed by each authority’s deadline? A course closing before a funding decision needs a different plan from one accepting a conditional application."}]],["$","ol",null,{"className":"process-steps","aria-label":"Admission and funding: organise two connected timelines","children":[["$","li","Select a suitable institution and programme.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Select a suitable institution and programme."}]]}],["$","li","Read its admission call and save its deadline.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Read its admission call and save its deadline."}]]}],["$","li","Check the MAECI category and nationality conditions.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Check the MAECI category and nationality conditions."}]]}],["$","li","Prepare the separate scholarship submission through the official portal.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Prepare the separate scholarship submission through the official portal."}]]}],["$","li","After any selection, complete admission, enrolment and immigration steps applicable to your case.",{"children":[["$","span",null,{"children":5}],["$","strong",null,{"children":"After any selection, complete admission, enrolment and immigration steps applicable to your case."}]]}]]}],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","p",null,{"className":"table-source","children":["Official reference: ",[["$","span","https://studyinitaly.esteri.it/Static/FAQ",{"children":["",["$","a",null,{"href":"https://studyinitaly.esteri.it/Static/FAQ","target":"_blank","rel":"noreferrer","children":"Study in Italy application FAQ"}]]}]]]}],"$undefined"]}]
21:["$","section","4-Prepare evidence by purpose, not a copied universal checklist",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Prepare evidence by purpose, not a copied universal checklist"}],[["$","p","Create separate folders for identity, academic qualifications, language evidence and route-specific material. The current call and portal decide which files are mandatory and when they must be available. A list copied from another degree category can omit an essential item or make you spend money on an unnecessary document.",{"children":"Create separate folders for identity, academic qualifications, language evidence and route-specific material. The current call and portal decide which files are mandatory and when they must be available. A list copied from another degree category can omit an essential item or make you spend money on an unnecessary document."}],["$","p","For research-based applications, align the proposed work with the host and the scholarship category. For a taught degree, explain why the course fits your background and future plan. Use an original, evidence-based motivation statement; a prestigious institution name alone does not explain academic fit.",{"children":"For research-based applications, align the proposed work with the host and the scholarship category. For a taught degree, explain why the course fits your background and future plan. Use an original, evidence-based motivation statement; a prestigious institution name alone does not explain academic fit."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A practical document preparation map","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A practical document preparation map"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Folder",{"scope":"col","children":"Folder"}],["$","th","Question to resolve",{"scope":"col","children":"Question to resolve"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Identity"}],["$","td","1",{"children":"Does the document meet the current portal’s validity and readability rules?"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Qualifications"}],["$","td","1",{"children":"Is the award completed, or is an accepted provisional document available?"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Language"}],["$","td","1",{"children":"Which proof does the scholarship require, and which does the course require?"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Host or admission evidence"}],["$","td","1",{"children":"Is an invitation or admission letter needed for this category?"}]],"$undefined"]}],["$","tr","4",{"children":[[["$","th","0",{"scope":"row","children":"Additional evidence"}],["$","td","1",{"children":"Which attachments does this year’s official form actually request?"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Prepare evidence by purpose, not a copied universal checklist","children":[["$","$L4","/guides/motivation-letter/",{"href":"/guides/motivation-letter/","children":["Plan a motivation letter",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/scholarship-cv/",{"href":"/guides/scholarship-cv/","children":["Prepare a scholarship CV",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
22:["$","section","5-Submit a file you can trace after the deadline",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Submit a file you can trace after the deadline"}],[["$","p","Use an email address you check regularly and keep control of the account yourself. Before submission, compare the spelling of your name, the course and institution across forms. Check that the correct final attachment opens and that a translation has not accidentally replaced the original where both are required.",{"children":"Use an email address you check regularly and keep control of the account yourself. Before submission, compare the spelling of your name, the course and institution across forms. Check that the correct final attachment opens and that a translation has not accidentally replaced the original where both are required."}],["$","p","Save the confirmation, a copy of the submitted application and the official call. Record the submission date and the source of any later instruction. This makes an interview request, clarification or correction easier to handle without reconstructing which version you sent.",{"children":"Save the confirmation, a copy of the submitted application and the official call. Record the submission date and the source of any later instruction. This makes an interview request, clarification or correction easier to handle without reconstructing which version you sent."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L27",null,{"id":"scholarships/maeci-scholarship:section-6","title":"Check your progress","items":["My study category and nationality match the named call.","My university application is tracked separately.","I checked the teaching-language evidence for both processes.","My budget includes costs outside the grant.","I retained the submission confirmation and call."]}],"$undefined","$undefined"]}]
23:["$","section","6-MAECI versus regional DSU: compare before choosing",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"MAECI versus regional DSU: compare before choosing"}],[["$","p","These are different funding systems with different authorities and assessment rules. Research each independently and check incompatibility provisions before assuming you can hold both. A sensible comparison includes eligibility, documents, award conditions, housing, payment timing and the cost you must cover before assistance arrives.",{"children":"These are different funding systems with different authorities and assessment rules. Research each independently and check incompatibility provisions before assuming you can hold both. A sensible comparison includes eligibility, documents, award conditions, housing, payment timing and the cost you must cover before assistance arrives."}],["$","p","Use the Italy scholarship hub for a broad comparison, then the relevant regional guide for operational instructions. This avoids treating a national award and a regional right-to-study application as the same form.",{"children":"Use the Italy scholarship hub for a broad comparison, then the relevant regional guide for operational instructions. This avoids treating a national award and a regional right-to-study application as the same form."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for MAECI versus regional DSU: compare before choosing","children":[["$","$L4","/scholarships/italy/",{"href":"/scholarships/italy/","children":["Compare Italy funding routes",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/italy-dsu-scholarships/",{"href":"/guides/italy-dsu-scholarships/","children":["Understand regional DSU support",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Plan initial study costs",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:1:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
24:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://www.esteri.it/en/servizi-opportunita/opportunita/borse-di-studio/per-cittadini-stranieri/borsestudio_stranieri/",{"href":"https://www.esteri.it/en/servizi-opportunita/opportunita/borse-di-studio/per-cittadini-stranieri/borsestudio_stranieri/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"MAECI ministry and cycle notices"}],["$","span",null,{"children":"Checked 20 October 2026; the named programme and cycle control the rule."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://www.esteri.it/wp-content/uploads/2026/03/Bando-26-27-ENG.pdf",{"href":"https://www.esteri.it/wp-content/uploads/2026/03/Bando-26-27-ENG.pdf","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"2026/27 official English call"}],["$","span",null,{"children":"Checked 20 October 2026; the named programme and cycle control the rule."}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":"$24:props:children:2:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L4","https://studyinitaly.esteri.it/Static/FAQ",{"href":"https://studyinitaly.esteri.it/Static/FAQ","target":"_blank","rel":"n