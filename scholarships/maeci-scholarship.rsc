17:T4b1,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is the next MAECI call open?","acceptedAnswer":{"@type":"Answer","text":"The sources reviewed on 20 October 2026 show the closed 2026/27 call. This guide does not confirm an open 2027/28 round. Reopen the ministry page before acting on a new date."}},{"@type":"Question","name":"Does winning MAECI automatically give me admission?","acceptedAnswer":{"@type":"Answer","text":"No. The scholarship and institution have separate processes. Check course admission and complete all required university steps, even if you are selected for funding."}},{"@type":"Question","name":"Does MAECI waive every university fee?","acceptedAnswer":{"@type":"Answer","text":"No blanket exemption applies. The checked call makes tuition exemption dependent on university rules and states that regional fees remain payable by the student."}},{"@type":"Question","name":"Should I apply using an agent’s private scholarship form?","acceptedAnswer":{"@type":"Answer","text":"The ministry directs candidates to the official Study in Italy portal. Keep ownership of your account and use the authority’s published instructions."}}]}1:["$","main",null,{"id":"main-content","className":"$undefined","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/scholarships/maeci-scholarship/\",\"name\":\"MAECI Italian Government Scholarship: eligibility, funding and application\",\"description\":\"Understand MAECI eligibility, funding limits, documents and the separate scholarship and university admission steps, with official cycle information.\",\"url\":\"https://aspirecompass.org/scholarships/maeci-scholarship/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-20\",\"dateModified\":\"2026-10-20\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/im