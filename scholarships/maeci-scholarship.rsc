25:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is the next MAECI call open?",{"children":[["$","summary",null,{"children":["Is the next MAECI call open?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The sources reviewed on 20 October 2026 show the closed 2026/27 call. This guide does not confirm an open 2027/28 round. Reopen the ministry page before acting on a new date."}]]}],["$","details","Does winning MAECI automatically give me admission?",{"children":[["$","summary",null,{"children":["Does winning MAECI automatically give me admission?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The scholarship and institution have separate processes. Check course admission and complete all required university steps, even if you are selected for funding."}]]}],["$","details","Does MAECI waive every university fee?",{"children":[["$","summary",null,{"children":["Does MAECI waive every university fee?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No blanket exemption applies. The checked call makes tuition exemption dependent on university rules and states that regional fees remain payable by the student."}]]}],["$","details","Should I apply using an agent’s private scholarship form?",{"children":[["$","summary",null,{"children":["Should I apply using an agent’s private scholarship form?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The ministry directs candidates to the official Study in Italy portal. Keep ownership of your account and use the authority’s published instructions."}]]}]]}]]}]
