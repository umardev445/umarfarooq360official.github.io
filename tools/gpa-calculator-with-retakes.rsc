alse,false,false,false,["$","article",null,{"className":"article-body ","children":[["$","section","0-Two policies, two calculations",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Two policies, two calculations"}],[["$","p","Current quality points are current GPA multiplied by GPA-counted credits, unless you enter exact transcript quality points. For each course, old and new points are its credits multiplied by the respective grade points. This tool assumes that the repeat carries the same credits as the old attempt.",{"children":"Current quality points are current GPA multiplied by GPA-counted credits, unless you enter exact transcript quality points. For each course, old and new points are its credits multiplied by the respective grade points. This tool assumes that the repeat carries the same credits as the old attempt."}]],"$undefined","$L1f","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L20","$L21","$L22","$L23"]}],false,"$L24","$L25"]}],false]}]
