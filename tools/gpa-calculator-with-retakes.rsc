1f:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Equal-credit repeat models","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Equal-credit repeat models"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Policy model",{"scope":"col","children":"Policy model"}],["$","th","Quality points after repeat",{"scope":"col","children":"Quality points after repeat"}],["$","th","GPA credits after repeat",{"scope":"col","children":"GPA credits after repeat"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Old grade replaced"}],["$","td","1",{"children":"Current − old + new"}],["$","td","2",{"children":"Current credits"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Both attempts counted"}],["$","td","1",{"children":"Current + new"}],["$","td","2",{"children":"Current credits + repeated credits"}]],"$undefined"]}]]}]]}]}],"$undefined"]
20:["$","section","1-Worked example: retaking a three-credit F",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Worked example: retaking a three-credit F"}],[["$","p","A 2.60 GPA across 45 counted credits gives 117 quality points. The old three-credit F contributes zero. A new A worth 4.0 contributes 12. With replacement, 129 ÷ 45 = 2.87. With both attempts, 129 ÷ 48 = 2.69. The same new grade therefore has different effects.",{"children":"A 2.60 GPA across 45 counted credits gives 117 quality points. The old three-credit F contributes zero. A new A worth 4.0 contributes 12. With replacement, 129 ÷ 45 = 2.87. With both attempts, 129 ÷ 48 = 2.69. The same new grade therefore has different effects."}]],"$undefined","$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"Using 45 − 3 credits with the unchanged 2.60 GPA would imply 109.2 starting points, which is not the actual record after excluding a zero-point F. If you adjust a record manually, remove both the appropriate quality points and credits before recomputing the GPA."}]]}],"$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","2-Use the correct transcript totals",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Use the correct transcript totals"}],[["$","p","Earned credits, attempted credits and GPA-counted credits can differ. A pass/fail course may earn credit without entering GPA, while a failed attempt can enter GPA without earning degree credit. Read the transcript labels or ask the registrar which totals to use.",{"children":"Earned credits, attempted credits and GPA-counted credits can differ. A pass/fail course may earn credit without entering GPA, while a failed attempt can enter GPA without earning degree credit. Read the transcript labels or ask the registrar which totals to use."}],["$","p","A rounded displayed GPA is an approximation to its underlying quality points. The optional exact-quality-points input lets you use the transcript numerator directly. If the old attempts cannot mathematically fit the record, the tool asks you to check the inputs rather than showing an impossible average.",{"children":"A rounded displayed GPA is an approximation to its underlying quality points. The optional exact-quality-points input lets you use the transcript numerator directly. If the old attempts cannot mathematically fit the record, the tool asks you to check the inputs rather than showing an impossible average."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L26",null,{"id":"tools/gpa-calculator-with-retakes:section-3","title":"Check your progress","items":["Old attempts are already in the current totals.","Current credits are GPA-counted credits.","Each old attempt is entered only once.","Old and new attempts have equal credit value in this model.","Exact quality points are used when available."]}],"$undefined","$undefined"]}]
22:["$","section","3-Why your institution may produce a different official result",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Why your institution may produce a different official result"}],[["$","p","Institutions can limit repeat eligibility, restrict the number of repeat credits, keep both attempts on a transcript or apply exceptions based on timing. The University of Maryland's published repeat guidance is an example of a policy that needs more information than one generic formula. It is not a rule for all colleges.",{"children":"Institutions can limit repeat eligibility, restrict the number of repeat credits, keep both attempts on a transcript or apply exceptions based on timing. The University of Maryland's published repeat guidance is an example of a policy that needs more information than one generic formula. It is not a rule for all colleges."}],["$","p","Do not confuse removing a grade from the GPA calculation with deleting the historical attempt from the transcript. Also check scholarship or financial-aid rules separately; this calculator does not determine eligibility for either.",{"children":"Do not confuse removing a grade from the GPA calculation with deleting the historical attempt from the transcript. Also check scholarship or financial-aid rules separately; this calculator does not determine eligibility for either."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","4-A lower retake grade can lower the result",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"A lower retake grade can lower the result"}],[["$","p","If the new grade is below the old grade, the replacement model can reduce GPA. Some institutions instead use the higher grade or apply other restrictions, but that is a third policy question and is not automatically selected here.",{"children":"If the new grade is below the old grade, the replacement model can reduce GPA. Some institutions instead use the higher grade or apply other restrictions, but that is a third policy question and is not automatically selected here."}],["$","p","Compare the realistic grade improvement, repeat approval and credit load before registering. When the goal is a target cumulative GPA across new courses, use the existing target planner rather than entering unrelated new courses as if they were repeats.",{"children":"Compare the realistic grade improvement, repeat approval and credit load before registering. When the goal is a target cumulative GPA across new courses, use the existing target planner rather than entering unrelated new courses as if they were repeats."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for A lower retake grade can lower the result","children":[["$","$L4","/tools/gpa-cgpa-calculator/",{"href":"/tools/gpa-cgpa-calculator/","children":["Plan future GPA across new credits",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/weighted-vs-unweighted-gpa/",{"href":"/guides/weighted-vs-unweighted-gpa/","children":["Understand GPA weighting",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
