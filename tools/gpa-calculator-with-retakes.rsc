25:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Do retakes always replace the old grade?",{"children":[["$","summary",null,{"children":["Do retakes always replace the old grade?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Repeat treatment depends on the institution and your eligibility. This tool compares two models without choosing the official policy."}]]}],["$","details","Do I enter the old course in my current totals?",{"children":[["$","summary",null,{"children":["Do I enter the old course in my current totals?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. The current GPA and credits should already include it. The tool performs the removal for the replacement scenario."}]]}],["$","details","Why are my two results different?",{"children":[["$","summary",null,{"children":["Why are my two results different?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Replacement changes the old points while keeping the equal-credit denominator. Counting both attempts adds another attempt's credits as well as its points."}]]}],["$","details","Can I use a course repeated for a different number of credits?",{"children":[["$","summary",null,{"children":["Can I use a course repeated for a different number of credits?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not in this simplified equal-credit model. Ask the registrar for the appropriate treatment before recalculating the record."}]]}]]}]]}]
