17:T442,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Do retakes always replace the old grade?","acceptedAnswer":{"@type":"Answer","text":"No. Repeat treatment depends on the institution and your eligibility. This tool compares two models without choosing the official policy."}},{"@type":"Question","name":"Do I enter the old course in my current totals?","acceptedAnswer":{"@type":"Answer","text":"Yes. The current GPA and credits should already include it. The tool performs the removal for the replacement scenario."}},{"@type":"Question","name":"Why are my two results different?","acceptedAnswer":{"@type":"Answer","text":"Replacement changes the old points while keeping the equal-credit denominator. Counting both attempts adds another attempt's credits as well as its points."}},{"@type":"Question","name":"Can I use a course repeated for a different number of credits?","acceptedAnswer":{"@type":"Answer","text":"Not in this simplified equal-credit model. Ask the registrar for the appropriate treatment before recalculating the record."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--tool student-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/tools/gpa-calculator-with-retakes/\",\"name\":\"GPA calculator with retakes: compare repeat policies\",\"description\":\"Estimate cumulative GPA after course retakes. Compare grade replacement and both-attempt policies, with credits, quality points and transcript checks.\",\"url\":\"https://aspirecompass.org/tools/gpa-calculator-with-retakes/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetIn