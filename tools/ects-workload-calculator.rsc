21:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can this convert US credits officially?",{"children":[["$","summary",null,{"children":["Can this convert US credits officially?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Workload arithmetic is not an institutional credit-transfer or recognition decision."}]]}],["$","details","Should I count only lectures?",{"children":[["$","summary",null,{"children":["Should I count only lectures?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Use the total workload defined for the course, including relevant independent study and assessment preparation."}]]}],["$","details","Which hours-per-credit factor should I choose?",{"children":[["$","summary",null,{"children":["Which hours-per-credit factor should I choose?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Use your institution’s published rule. The editable default is a planning example, not a worldwide rule."}]]}]]}]]}]
