24:["$","p","Write the actual academic cycle and applicant category beside the deadline. A closing date for self-funded admission may not be the scholarship date; an upload date for selected candidates may not reopen registration. Keep a link or private copy of the owner notice so you can explain where every input came from.",{"children":"Write the actual academic cycle and applicant category beside the deadline. A closing date for self-funded admission may not be the scholarship date; an upload date for selected candidates may not reopen registration. Keep a link or private copy of the owner notice so you can explain where every input came from."}]
25:["$","p","The prefilled values are a worked planning example, not a programme announcement. Replace the date, time and zone together. A screen showing the correct arithmetic for an old notice can still be the wrong application plan. Recheck the programme owner when the cycle or deadline changes.",{"children":"The prefilled values are a worked planning example, not a programme announcement. Replace the date, time and zone together. A screen showing the correct arithmetic for an old notice can still be the wrong application plan. Recheck the programme owner when the cycle or deadline changes."}]
26:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"A complete private cutoff record","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"A complete private cutoff record"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Field",{"scope":"col","children":"Field"}],["$","th","Useful record",{"scope":"col","children":"Useful record"}],["$","th","Unresolved example",{"scope":"col","children":"Unresolved example"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Source"}],["$","td","1",{"children":"Exact programme/cycle and owner URL"}],["$","td","2",{"children":"Only a forwarded image or a search snippet"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Owner clock"}],["$","td","1",{"children":"Calendar date and24-hour cutoff"}],["$","td","2",{"children":"A date without a confirmed closing time"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Zone"}],["$","td","1",{"children":"Owner-confirmed IANA place or UTC offset"}],["$","td","2",{"children":"CST, IST or an unspecified local time"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Task"}],["$","td","1",{"children":"New application, reference, funding or enrolment step"}],["$","td","2",{"children":"All stages marked with one generic deadline"}]],"$undefined"]}]]}]]}]}],"$undefined"]
27:["$","section","1-Read one instant in the owner, UTC and target clocks",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Read one instant in the owner, UTC and target clocks"}],[["$","p","The following original examples show why a converted date matters as much as the hour. In the first row, an evening cutoff in the source city appears on the next date in Pakistan. In the second, a midnight-near source time appears on the previous UTC date. Neither result gives an extra day to submit: they are different labels for the same instant.",{"children":"The following original examples show why a converted date matters as much as the hour. In the first row, an evening cutoff in the source city appears on the next date in Pakistan. In the second, a midnight-near source time appears on the previous UTC date. Neither result gives an extra day to submit: they are different labels for the same instant."}],["$","p","Use the complete result rather than copying only an hour into a calendar. Keep the time-zone label and the UTC value together. The target date-change field compares calendar dates; it is not a number of hours remaining or a grace period. Set a personal reminder earlier than the actual cutoff, and label that reminder as your own buffer.",{"children":"Use the complete result rather than copying only an hour into a calendar. Keep the time-zone label and the UTC value together. The target date-change field compares calendar dates; it is not a number of hours remaining or a grace period. Set a personal reminder earlier than the actual cutoff, and label that reminder as your own buffer."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Original exact-date conversion examples","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Original exact-date conversion examples"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Owner input",{"scope":"col","children":"Owner input"}],["$","th","UTC result",{"scope":"col","children":"UTC result"}],["$","th","Target result",{"scope":"col","children":"Target result"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"21Jan2027,23:59,Europe/Zurich"}],["$","td","1",{"children":"21Jan2027,22:59UTC"}],["$","td","2",{"children":"Asia/Karachi:22Jan2027,03:59"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"29Feb2028,00:10,UTC+05:45"}],["$","td","1",{"children":"28Feb2028,18:25UTC"}],["$","td","2",{"children":"UTC target is on the previous date"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"15Nov2026,23:59,Asia/Tokyo"}],["$","td","1",{"children":"15Nov2026,14:59UTC"}],["$","td","2",{"children":"UTC target keeps the same date"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
28:["$","section","2-A place-based zone and a numeric offset answer different questions",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"A place-based zone and a numeric offset answer different questions"}],[["$","p","An IANA identifier such as Europe/Paris asks the browser to use that place’s rules for the entered date. An explicit offset such as UTC+01:00 fixes the numerical difference from UTC. The same city may use a different offset in summer and winter. This tool accepts either form when you have a reason for that input; it does not decide which wording the owner intended.",{"children":"An IANA identifier such as Europe/Paris asks the browser to use that place’s rules for the entered date. An explicit offset such as UTC+01:00 fixes the numerical difference from UTC. The same city may use a different offset in summer and winter. This tool accepts either form when you have a reason for that input; it does not decide which wording the owner intended."}],["$","p","If a notice states a summer abbreviation and a numeric offset for a winter date, keep the inconsistency visible. Converting both assumptions can expose the difference, but choosing the more convenient result does not resolve it. Ask the owner for an unambiguous UTC instant or corrected zone. Do not silently substitute a city for a stated offset or infer the owner’s zone from your device.",{"children":"If a notice states a summer abbreviation and a numeric offset for a winter date, keep the inconsistency visible. Converting both assumptions can expose the difference, but choosing the more convenient result does not resolve it. Ask the owner for an unambiguous UTC instant or corrected zone. Do not silently substitute a city for a stated offset or infer the owner’s zone from your device."}],["$","p","The browser-zone button changes only your target field. It is a convenience for viewing the result, not evidence about the programme’s location or deadline. A device set to the wrong local zone will faithfully display that wrong choice until you correct it.",{"children":"The browser-zone button changes only your target field. It is a convenience for viewing the result, not evidence about the programme’s location or deadline. A device set to the wrong local zone will faithfully display that wrong choice until you correct it."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
29:["$","section","3-Skipped and repeated clock times need an explicit decision",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Skipped and repeated clock times need an explicit decision"}],[["$","p","A clock change can skip a local time entirely or make the same clock reading occur twice. The converter checks possible instants under the browser’s installed rules. With no matching instant it reports a gap instead of moving the deadline forward. With two it exposes both UTC possibilities and leaves the default choice unresolved.",{"children":"A clock change can skip a local time entirely or make the same clock reading occur twice. The converter checks possible instants under the browser’s installed rules. With no matching instant it reports a gap instead of moving the deadline forward. With two it exposes both UTC possibilities and leaves the default choice unresolved."}],["$","p","Original worked case: 7November2027 at01:30 in America/New_York has two readings under the usual rules,05:30UTC and06:30UTC. The first/second selector is available so you can match an owner-confirmed offset; it is not permission to pick the later one for extra time. Clock changes are not universally one hour, which is why a half-hour transition is included in the tool’s verification cases.",{"children":"Original worked case: 7November2027 at01:30 in America/New_York has two readings under the usual rules,05:30UTC and06:30UTC. The first/second selector is available so you can match an owner-confirmed offset; it is not permission to pick the later one for extra time. Clock changes are not universally one hour, which is why a half-hour transition is included in the tool’s verification cases."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2a:["$","section","4-Convert first, then check the actual submission dependency",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Convert first, then check the actual submission dependency"}],[["$","p","After resolving the clock, make a separate row for each required submission. A completed local draft, a selected upload file and an owner confirmation are different states. If another person controls a reference or an institution controls a document, schedule that dependency before your own final action. The converter cannot estimate their processing time.",{"children":"After resolving the clock, make a separate row for each required submission. A completed local draft, a selected upload file and an owner confirmation are different states. If another person controls a reference or an institution controls a document, schedule that dependency before your own final action. The converter cannot estimate their processing time."}],["$","p","Use a short final audit: does the notice cover this cycle and applicant category; are date, time and zone all explicit; does the target result include the correct calendar date; and what confirmation proves the required task reached its submitted state? If any answer is unknown, keep it unknown instead of replacing it with a reassuring calculation.",{"children":"Use a short final audit: does the notice cover this cycle and applicant category; are date, time and zone all explicit; does the target result include the correct calendar date; and what confirmation proves the required task reached its submitted state? If any answer is unknown, keep it unknown instead of replacing it with a reassuring calculation."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Convert first, then check the actual submission dependency","children":[["$","$L5","/guides/scholarship-application/",{"href":"/guides/scholarship-application/","children":["Track separate scholarship application tasks",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/deadline-calendar/",{"href":"/deadline-calendar/","children":["Check programme-specific calendar records",["$","$L6",null,{"ref":"$undefined","iconNode":"$9:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2b:["$","section","5-Scope and limits of this conversion",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Scope and limits of this conversion"}],[["$","p","Supported inputs are real calendar dates from2000 through2100 and minute-level24-hour times. Bare abbreviations are deliberately rejected because they can be ambiguous. The numeric offset range isUTC−14:00 toUTC+14:00. The result uses the browser’s time-zone rules for named places; recent government changes may not yet be included on an older device.",{"children":"Supported inputs are real calendar dates from2000 through2100 and minute-level24-hour times. Bare abbreviations are deliberately rejected because they can be ambiguous. The numeric offset range isUTC−14:00 toUTC+14:00. The result uses the browser’s time-zone rules for named places; recent government changes may not yet be included on an older device."}],["$","p","Use an owner-confirmed explicit offset when that is the published authoritative input. A successful conversion does not validate eligibility, verify that a portal is working, or make an expired application available. Your entered cutoff is calculated in this page and is not stored between visits or sent with the conversion.",{"children":"Use an owner-confirmed explicit offset when that is the published authoritative input. A successful conversion does not validate eligibility, verify that a portal is working, or make an expired application available. Your entered cutoff is calculated in this page and is not stored between visits or sent with the conversion."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
