2d:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can the converter work when a deadline has no time zone?",{"children":[["$","summary",null,{"children":["Can the converter work when a deadline has no time zone?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"It will not infer the owner’s zone. Ask the owner to confirm the cutoff and its zone or UTC offset before relying on a result."}]]}],["$","details","Why does a converted date move forward or backward?",{"children":[["$","summary",null,{"children":["Why does a converted date move forward or backward?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Different zones can be on different calendar dates at the same instant. Copy the whole target date, time and zone, not only the hour."}]]}],["$","details","Does choosing the second occurrence extend a deadline?",{"children":[["$","summary",null,{"children":["Does choosing the second occurrence extend a deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It only selects one of two possible instants for a repeated clock reading. Use it only after the owner confirms the intended UTC offset."}]]}],["$","details","Why might two devices disagree about a recent zone change?",{"children":[["$","summary",null,{"children":["Why might two devices disagree about a recent zone change?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Their installed time-zone data may differ. Check the owner’s explicit UTC information and use up-to-date software; do not choose whichever result gives more time."}]]}]]}]]}]
