20:["$","section","1-Listening and Reading raw marks",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Listening and Reading raw marks"}],[["$","p","IELTS Listening and Reading each contain 40 questions. Official guidance notes that raw marks are converted to band scores and that the precise marks needed can vary slightly between test versions. Academic and General Training Reading also use different typical mark patterns.",{"children":"IELTS Listening and Reading each contain 40 questions. Official guidance notes that raw marks are converted to band scores and that the precise marks needed can vary slightly between test versions. Academic and General Training Reading also use different typical mark patterns."}],["$","p","For that reason, this tool asks for section bands rather than claiming that one unofficial raw-mark table can predict every test form. Use the official IELTS score explanation for current indicative marks and your official report for application evidence.",{"children":"For that reason, this tool asks for section bands rather than claiming that one unofficial raw-mark table can predict every test form. Use the official IELTS score explanation for current indicative marks and your official report for application evidence."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","2-How to use the calculator for scholarship planning",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"How to use the calculator for scholarship planning"}],[["$","p","First compare the estimated overall and lowest section with the exact course condition. Next identify the weakest component and plan practice around the marking criteria rather than repeatedly taking full tests without diagnosis.",{"children":"First compare the estimated overall and lowest section with the exact course condition. Next identify the weakest component and plan practice around the marking criteria rather than repeatedly taking full tests without diagnosis."}],["$","p","If a scholarship advertises an IELTS waiver, check the university rule independently. Medium of Instruction letters and alternative tests are institution-specific routes, not universal replacements.",{"children":"If a scholarship advertises an IELTS waiver, check the university rule independently. Medium of Instruction letters and alternative tests are institution-specific routes, not universal replacements."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","3-Independent calculator notice",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Independent calculator notice"}],[["$","p","AspireCompass is not affiliated with IELTS, the British Council, IDP or Cambridge University Press & Assessment. IELTS is a registered trade mark of its owners. This calculator reproduces the arithmetic of averaging section bands for educational planning and does not issue, verify or replace a test result.",{"children":"AspireCompass is not affiliated with IELTS, the British Council, IDP or Cambridge University Press & Assessment. IELTS is a registered trade mark of its owners. This calculator reproduces the arithmetic of averaging section bands for educational planning and does not issue, verify or replace a test result."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://ielts.org/take-a-test/your-results/ielts-scoring-in-detail",{"href":"https://ielts.org/take-a-test/your-results/ielts-scoring-in-detail","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"IELTS scoring in detail"}],["$","span",null,{"children":"Official overall-band rounding, section scoring and band descriptors"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
24:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","How is the IELTS overall band calculated?",{"children":[["$","summary",null,{"children":["How is the IELTS overall band calculated?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Add Listening, Reading, Writing and Speaking, divide by four and round the average to the nearest half band under the published IELTS rule."}]]}],["$","details","What happens when the average is 6.25?",{"children":[["$","summary",null,{"children":["What happens when the average is 6.25?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The official IELTS scoring explanation shows that an average ending in .25 rounds up to the next half band, so 6.25 becomes 6.5."}]]}],["$","details","What happens when the average is 6.75?",{"children":[["$","summary",null,{"children":["What happens when the average is 6.75?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"An average ending in .75 rounds up to the next whole band, so 6.75 becomes 7.0."}]]}],["$","details","Is meeting the overall band enough for university admission?",{"children":[["$","summary",null,{"children":["Is meeting the overall band enough for university admission?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not always. Many courses also require a minimum score in each section. Follow the exact course and intake requirement."}]]}],["$","details","Can I submit this calculator result with an application?",{"children":[["$","summary",null,{"children":["Can I submit this calculator result with an application?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It is an estimate for planning. Submit only the official language evidence accepted by the programme or institution."}]]}]]}]]}]
