18:T41f,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How many semester credits are 90 quarter credits?","acceptedAnswer":{"@type":"Answer","text":"Under the common 3:2 conversion, 90 ÷ 1.5 = 60 semester credits. The receiving institution decides the actual award and degree applicability."}},{"@type":"Question","name":"Can I convert semester credits back to quarter credits?","acceptedAnswer":{"@type":"Answer","text":"Yes. Select the reverse direction; the tool multiplies semester credits by 1.5. Optional destination fields reset when changing units."}},{"@type":"Question","name":"Does this convert ECTS credits?","acceptedAnswer":{"@type":"Answer","text":"No. It handles US quarter and semester credit volume. ECTS recognition requires the receiving institution's process."}},{"@type":"Question","name":"Does conversion change my GPA?","acceptedAnswer":{"@type":"Answer","text":"The unit conversion alone does not determine a GPA. The institution decides how transfer grades are treated; use its policy."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--tool student-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/tools/quarter-to-semester-credits-calculator/\",\"name\":\"Quarter credits to semester credits calculator\",\"description\":\"Convert quarter and semester credits in either direction. Add course rows, keep fractional precision and compare estimates with school-awarded credit values.\",\"url\":\"https://aspirecompass.org/tools/quarter-to-semester-credits-calculator/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__