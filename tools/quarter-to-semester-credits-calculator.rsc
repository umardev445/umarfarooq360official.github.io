27:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","How many semester credits are 90 quarter credits?",{"children":[["$","summary",null,{"children":["How many semester credits are 90 quarter credits?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Under the common 3:2 conversion, 90 ÷ 1.5 = 60 semester credits. The receiving institution decides the actual award and degree applicability."}]]}],["$","details","Can I convert semester credits back to quarter credits?",{"children":[["$","summary",null,{"children":["Can I convert semester credits back to quarter credits?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Select the reverse direction; the tool multiplies semester credits by 1.5. Optional destination fields reset when changing units."}]]}],["$","details","Does this convert ECTS credits?",{"children":[["$","summary",null,{"children":["Does this convert ECTS credits?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It handles US quarter and semester credit volume. ECTS recognition requires the receiving institution's process."}]]}],["$","details","Does conversion change my GPA?",{"children":[["$","summary",null,{"children":["Does conversion change my GPA?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The unit conversion alone does not determine a GPA. The institution decides how transfer grades are treated; use its policy."}]]}]]}]]}]
