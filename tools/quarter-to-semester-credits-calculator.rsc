22:["$","section","1-Add a course list before comparing totals",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Add a course list before comparing totals"}],[["$","p","For a quarter schedule with courses worth 5, 4 and 3 credits, the total is 12. Dividing 12 by 1.5 gives 8 semester credits. A single five-quarter-credit course gives 3.333… before display rounding.",{"children":"For a quarter schedule with courses worth 5, 4 and 3 credits, the total is 12. Dividing 12 by 1.5 gives 8 semester credits. A single five-quarter-credit course gives 3.333… before display rounding."}],["$","p","Keep fractions until the end of a planning calculation. Rounding each small course down can create a different total from rounding the combined value. If a university awards different values course by course, use its evaluation rather than choosing a rounding method to obtain a preferred answer.",{"children":"Keep fractions until the end of a planning calculation. Rounding each small course down can create a different total from rounding the combined value. If a university awards different values course by course, use its evaluation rather than choosing a rounding method to obtain a preferred answer."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
23:["$","section","2-Converted, awarded and degree-applicable credits are different",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Converted, awarded and degree-applicable credits are different"}],[["$","p","A conversion estimates volume. A receiving school may award transfer credit after reviewing course level, content and other rules. A department then decides whether awarded credit satisfies the specific degree requirement. Those are separate decisions.",{"children":"A conversion estimates volume. A receiving school may award transfer credit after reviewing course level, content and other rules. A department then decides whether awarded credit satisfies the specific degree requirement. Those are separate decisions."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Keep each credit decision separate","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Keep each credit decision separate"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Stage",{"scope":"col","children":"Stage"}],["$","th","What it answers",{"scope":"col","children":"What it answers"}],["$","th","Evidence to use",{"scope":"col","children":"Evidence to use"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Volume conversion"}],["$","td","1",{"children":"What is the common unit equivalent?"}],["$","td","2",{"children":"This ratio and transparent arithmetic"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Transfer credit awarded"}],["$","td","1",{"children":"How many credits did the school recognise?"}],["$","td","2",{"children":"Receiving school evaluation"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Degree applicability"}],["$","td","1",{"children":"Which requirement does the course satisfy?"}],["$","td","2",{"children":"Programme/adviser confirmation"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"GPA treatment"}],["$","td","1",{"children":"Does the grade enter a specific GPA?"}],["$","td","2",{"children":"Institutional or admissions policy"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
24:["$","section","3-How the optional school-awarded fields work",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"How the optional school-awarded fields work"}],[["$","p","Leave a field blank when the awarded credit is unknown; blank is not interpreted as zero. Enter zero only when the school has actually awarded zero in the destination unit. If you enter values for only some rows, the result labels the record as partial.",{"children":"Leave a field blank when the awarded credit is unknown; blank is not interpreted as zero. Enter zero only when the school has actually awarded zero in the destination unit. If you enter values for only some rows, the result labels the record as partial."}],["$","p","When every row has a school-awarded value, the optional target calculation uses those values. Otherwise it uses the converted estimates and labels that basis. Existing credits must not overlap the courses entered above, or you will double count the same study.",{"children":"When every row has a school-awarded value, the optional target calculation uses those values. Otherwise it uses the converted estimates and labels that basis. Existing credits must not overlap the courses entered above, or you will double count the same study."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","4-A numeric target is not a graduation audit",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"A numeric target is not a graduation audit"}],[["$","p","A plan may reach a total while still missing required courses, residency credit, upper-level study or other programme conditions. Likewise, a credit conversion does not prove full-time enrolment or financial-aid status. Use the relevant institution's criteria for those decisions.",{"children":"A plan may reach a total while still missing required courses, residency credit, upper-level study or other programme conditions. Likewise, a credit conversion does not prove full-time enrolment or financial-aid status. Use the relevant institution's criteria for those decisions."}],["$","p","For example, 90 quarter credits converts to 60 semester credits under the common ratio. It does not follow that every receiving programme will accept all 60 toward the degree. Keep the evaluation and requirement match beside the estimate.",{"children":"For example, 90 quarter credits converts to 60 semester credits under the common ratio. It does not follow that every receiving programme will accept all 60 toward the degree. Keep the evaluation and requirement match beside the estimate."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L28",null,{"id":"tools/quarter-to-semester-credits-calculator:section-5","title":"Check your progress","items":["Source and destination calendars identified.","Source credits are academic credits, not clock hours.","Unknown awarded credits remain blank.","Existing credits do not duplicate entered courses.","Degree applicability and GPA policy checked separately."]}],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for A numeric target is not a graduation audit","children":[["$","$L4","/tools/gpa-cgpa-calculator/",{"href":"/tools/gpa-cgpa-calculator/","children":["Calculate course GPA",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/gpa-calculator-with-retakes/",{"href":"/tools/gpa-calculator-with-retakes/","children":["Compare retake policies",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/ects-workload-calculator/",{"href":"/tools/ects-workload-calculator/","children":["ECTS study-workload planning",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
