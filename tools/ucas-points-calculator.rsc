1f:["$","section","1-Follow the qualification-to-offer workflow",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Follow the qualification-to-offer workflow"}],[["$","p","First enter your results as awarded or predicted. Then remove qualifications your chosen course does not count. Finally compare the remaining total with the complete offer, including subjects, units and separate GCSE requirements. The same academic record can therefore produce a general tariff total and a smaller course-counted total.",{"children":"First enter your results as awarded or predicted. Then remove qualifications your chosen course does not count. Finally compare the remaining total with the complete offer, including subjects, units and separate GCSE requirements. The same academic record can therefore produce a general tariff total and a smaller course-counted total."}]],["$","ol",null,{"className":"process-steps","aria-label":"Follow the qualification-to-offer workflow","children":[["$","li","Match the exact qualification family and size.",{"children":[["$","span",null,{"children":1}],["$","strong",null,{"children":"Match the exact qualification family and size."}]]}],["$","li","Select the grade; add an optional subject label.",{"children":[["$","span",null,{"children":2}],["$","strong",null,{"children":"Select the grade; add an optional subject label."}]]}],["$","li","Exclude qualifications not accepted in the particular offer.",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"Exclude qualifications not accepted in the particular offer."}]]}],["$","li","Read the itemised result before comparing with the offer.",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"Read the itemised result before comparing with the offer."}]]}]]}],"$undefined","$undefined",["$","aside",null,{"className":"worked-example","children":[["$","h3",null,{"children":"Worked example"}],["$","p",null,{"children":"B in Biology (40), B in Chemistry (40) and C in Mathematics (32) give 112 points. If a course also requires B in Mathematics, this combination does not satisfy that named-grade condition despite reaching 112."}]]}],"$undefined","$undefined","$undefined","$undefined"]}]
20:["$","section","2-Avoid double counting overlapping study",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Avoid double counting overlapping study"}],[["$","p","This tool recognises an AS entered alongside an A level with the same subject label, ignoring case and surrounding spaces. It excludes that AS from the estimate. Without matching labels, the tool cannot infer that the study overlaps. It also cannot decide whether two vocational qualifications contain duplicated units.",{"children":"This tool recognises an AS entered alongside an A level with the same subject label, ignoring case and surrounding spaces. It excludes that AS from the estimate. Without matching labels, the tool cannot infer that the study overlaps. It also cannot decide whether two vocational qualifications contain duplicated units."}],["$","p","UCAS explains that providers can restrict accepted qualifications and generally count the highest achievement in overlapping study. Use the include checkbox to model the course rule, but obtain confirmation if the overlap is unclear.",{"children":"UCAS explains that providers can restrict accepted qualifications and generally count the highest achievement in overlapping study. Use the include checkbox to model the course rule, but obtain confirmation if the overlap is unclear."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L25",null,{"id":"tools/ucas-points-calculator:section-3","title":"Check your progress","items":["Same-subject AS and A levels are not counted twice.","BTEC title and size match the official award.","The course accepts the included qualifications.","Required subjects and other conditions are checked."]}],"$undefined","$undefined"]}]
21:["$","section","3-Read the reverse lookup correctly",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Read the reverse lookup correctly"}],[["$","p","The reverse lookup lists combinations of three passing GCE A levels. It returns exact totals where possible; otherwise it displays the smallest available total at or above the target. It does not round a target into a guaranteed offer match.",{"children":"The reverse lookup lists combinations of three passing GCE A levels. It returns exact totals where possible; otherwise it displays the smallest available total at or above the target. It does not round a target into a guaranteed offer match."}],["$","p","For example, a target of 113 has no exact three-passing-A-level match under these values. The next total is 120. This is useful arithmetic for a minimum-points condition, but it cannot substitute for an offer specifying particular grades.",{"children":"For example, a target of 113 has no exact three-passing-A-level match under these values. The next total is 120. This is useful arithmetic for a minimum-points condition, but it cannot substitute for an offer specifying particular grades."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Read the reverse lookup correctly","children":[["$","$L4","/guides/96-ucas-points-in-grades/",{"href":"/guides/96-ucas-points-in-grades/","children":["96 points in grades",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/104-ucas-points-in-grades/",{"href":"/guides/104-ucas-points-in-grades/","children":["104 points in grades",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/112-ucas-points-in-grades/",{"href":"/guides/112-ucas-points-in-grades/","children":["112 points in grades",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/120-ucas-points-in-grades/",{"href":"/guides/120-ucas-points-in-grades/","children":["120 points in grades",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/128-ucas-points-in-grades/",{"href":"/guides/128-ucas-points-in-grades/","children":["128 points in grades",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
22:["$","section","4-Check a qualification outside the supported list",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Check a qualification outside the supported list"}],[["$","p","Scottish qualifications, Access to HE Diplomas, IB components, partial T Levels and other vocational awards can require different tables or additional information. Omitting them from this simplified calculator does not mean that they lack tariff points or are unacceptable to a university. Use the official UCAS lookup for the exact title and application cycle.",{"children":"Scottish qualifications, Access to HE Diplomas, IB components, partial T Levels and other vocational awards can require different tables or additional information. Omitting them from this simplified calculator does not mean that they lack tariff points or are unacceptable to a university. Use the official UCAS lookup for the exact title and application cycle."}],["$","p","Calculations run in your browser. No transcript upload or account is required. Reset restores the teaching example; Print produces a printable view of the current page and results.",{"children":"Calculations run in your browser. No transcript upload or account is required. Reset restores the teaching example; Print produces a printable view of the current page and results."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
