1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--tool student-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/tools/ucas-points-calculator/\",\"name\":\"UCAS points calculator: qualifications and grade targets\",\"description\":\"Calculate UCAS points from supported A levels, BTEC Nationals, EPQ and full T Levels. See a breakdown and reverse lookup for three A-level grades.\",\"url\":\"https://aspirecompass.org/tools/ucas-points-calculator/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tools\",\"item\":\"https://aspirecompass.org/tools/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"UCAS points calculator: qualifications and grade targets\",\"item\":\"https://aspirecompass.org/tools/ucas-points-calculator/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Does the total prove I meet my offer?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. A course can restrict the qualifications it counts or require particular subjects, grades and other conditions.\"}},{\"@type\":\"Question\",\"name\":\"Can I include an EPQ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, the calculator includes EPQ tariff values. Exclude it if your course does not count it towards the offer.\"}},{\"@type\":\"Question\",\"name\":\"Why is my AS worth zero in the breakdown?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"An included A level has the same subject label, so the overlapping AS is excluded. It is not a statement that every AS grade is worth zero.\"}},{\"@type\":\"Question\",\"name\":\"Is this an official UCAS service?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. AspireCompass is an independent educational site. Confirm qualification values and acceptance with UCAS and the university.\"}}]}"}}]],["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--utility","children":["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L4",null,{"href":"/","children":"Home"}],["$","i",null,{"children":"/"}]]}],["$","span","/tools/",{"children":[["$","$L4",null,{"href":"/tools/","children":"Tools"}],["$","i",null,{"children":"/"}]]}],["$","span","/tools/ucas-points-calculator/",{"children":[["$","span",null,{"aria-current":"page","children":"UCAS points calculator: qualifications and grade targets"}],false]}]]}],["$","span",null,{"data-slot":"badge","data-variant":"outline","className":"inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3 border-border text-foreground [a&]:hover:bg-accent [a&]:hover:text-accent-foreground inner-eyebrow","children":"UK student planning"}],false,"$L17","$L18","$L19"]}],false]}]}],false,"$L1a","$L1b"]}]
