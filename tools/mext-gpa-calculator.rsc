1a:["$","div",null,{"className":"site-shell content-layout content-layout--wide","children":[["$","div",null,{"className":"content-main","children":[false,false,"$undefined",false,false,false,null,["$","details",null,{"className":"mobile-contents mobile-contents--wide","children":[["$","summary",null,{"children":"On this page: jump to your answer"}],["$","nav",null,{"aria-label":"Article sections","children":[["$","a","Choose a documented mapping before entering course records",{"href":"#section-1","children":"Choose a documented mapping before entering course records"}],["$","a","Compute the weighted result from included courses",{"href":"#section-2","children":"Compute the weighted result from included courses"}],["$","a","Worked example: keep 8/3 visible before host rounding",{"href":"#section-3","children":"Worked example: keep 8/3 visible before host rounding"}],["$","a","Exclusions should be visible in a separate record",{"href":"#section-4","children":"Exclusions should be visible in a separate record"}],["$","a","A numeric result does not decide the application",{"href":"#section-5","children":"A numeric result does not decide the application"}],["$","a","Handle precision and reporting as a separate host instruction",{"href":"#section-6","children":"Handle precision and reporting as a separate host instruction"}]]}]]}],false,["$","$L1c",null,{}],false,false,false,false,false,false,false,false,false,false,false,false,[["$","section",null,{"className":"quick-answer","aria-labelledby":"quick-answer-title","children":[["$","h2",null,{"id":"quick-answer-title","children":"The short answer"}],["$","p",null,{"children":"Use a named host’s three-point grade mapping, then divide included grade-point×credit totals by included credits. Do not rescale a cumulative 4.0 GPA. Unsupported grades and host rounding need explicit clarification."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Open the linked appendix, confirm the applicable mapping and enter only the supported regular-course records."]}],"$undefined"]}],["$","nav",null,{"className":"tool-jump-nav","aria-label":"More free planning tools","children":[["$","span",null,{"children":"Free tools"}],[["$","$L5","/tools/mext-gpa-calculator",{"href":"/tools/mext-gpa-calculator/","aria-current":"page","children":"MEXT mapped GPA"}],["$","$L5","/tools/ucas-points-calculator",{"href":"/tools/ucas-points-calculator/","aria-current":"$undefined","children":"UCAS points"}],["$","$L5","/tools/weighted-gpa-calculator",{"href":"/tools/weighted-gpa-calculator/","aria-current":"$undefined","children":"Weighted GPA"}],["$","$L5","/tools/gpa-calculator-with-retakes",{"href":"/tools/gpa-calculator-with-retakes/","aria-current":"$undefined","children":"Retake GPA"}],["$","$L5","/tools/quarter-to-semester-credits-calculator",{"href":"/tools/quarter-to-semester-credits-calculator/","aria-current":"$undefined","children":"Quarter / semester credits"}],["$","$L5","/tools/final-grade-calculator",{"href":"/tools/final-grade-calculator/","aria-current":"$undefined","children":"Final grade"}],["$","$L5","/tools/ects-workload-calculator",{"href":"/tools/ects-workload-calculator/","aria-current":"$undefined","children":"ECTS workload"}],["$","$L5","/tools/gpa-cgpa-calculator",{"href":"/tools/gpa-cgpa-calculator/","aria-current":"$undefined","children":"GPA calculator"}],["$","$L5","/tools/ielts-band-calculator",{"href":"/tools/ielts-band-calculator/","aria-current":"$undefined","children":"IELTS calculator"}],["$","$L5","/tools/italy-study-cost-calculator",{"href":"/tools/italy-study-cost-calculator/","aria-current":"$undefined","children":"Italy cost calculator"}],["$","$L5","/tools/germany-blocked-account-calculator",{"href":"/tools/germany-blocked-account-calculator/","aria-current":"$undefined","children":"Germany funding calculator"}],["$","$L5","/tools/scholarship-deadline-timezone-converter",{"href":"/tools/scholarship-deadline-timezone-conv