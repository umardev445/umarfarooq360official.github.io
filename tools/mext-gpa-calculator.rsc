1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--tool","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/tools/mext-gpa-calculator/\",\"name\":\"MEXT GPA calculator: check the named mapping and included credits\",\"description\":\"Estimate a three-point MEXT GPA using an identified host mapping, transparent credit weighting and worked examples. Check exclusions and host rounding before reporting.\",\"url\":\"https://aspirecompass.org/tools/mext-gpa-calculator/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-11-23\",\"dateModified\":\"2026-11-28\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tools\",\"item\":\"https://aspirecompass.org/tools/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"MEXT GPA calculator: check the named mapping and included credits\",\"item\":\"https://aspirecompass.org/tools/mext-gpa-calculator/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can I multiply my 4.0 GPA by 3/4?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. A course-level grade mapping and the applicable included-credit rule are needed.\"}},{\"@type\":\"Question\",\"name\":\"Should unsupported plus/minus marks be converted automatically?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Keep the original marks and obtain the receiving host’s mapping.\"}},{\"@type\":\"Question\",\"name\":\"Does this calculator confirm MEXT eligibility?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. It is a scoped calculation estimate; the host’s current rules and full application conditions control.\"}}]}"}}]],["$","section",null,{"className":"inner-hero inner-hero--compact inner-hero--utility","children":["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L5",null,{"href":"/","children":"Home"}],["$","i",null,{"children":"/"}]]}],["$","span","/tools/",{"children":[["$","$L5",null,{"href":"/tools/","children":"Tools"}],["$","i",null,{"children":"/"}]]}],["$","span","/tools/mext-gpa-calculator/",{"children":[["$","span",null,{"aria-current":"page","children":"MEXT GPA calculator: check the named mapping and included credits"}],false]}]]}],["$","span",null,{"data-slot":"badge","data-variant":"outline","className":"inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3 border-border text-foreground [a&]:hover:bg-accent [a&]:hover:text-accent-foreground inner-eyebrow","children":"Transparent academic planning tool"}],false,["$","h1",null,{"children":"MEXT GPA calculator: check the named mapping and included credits"}],["$","p",null,{"children":"Use this tool only after identifying the relevant host and route appendix. It calculates an estimate from supported grade categories; it cannot certify transcript equivalence or scholarship eligibility."}],"$L19"]}],false]}]}],false,"$L1a","$L1b"]}]
