29:["$","section","2-Use the official amount for the correct purpose",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Use the official amount for the correct purpose"}],[["$","p","The calculator starts with the 2026 study-visa figure published by official German guidance. Applicants seeking a study place, language course or another residence purpose can face a different monthly requirement.",{"children":"The calculator starts with the 2026 study-visa figure published by official German guidance. Applicants seeking a study place, language course or another residence purpose can face a different monthly requirement."}],["$","p","Keep the amount editable and confirm it through the responsible mission or Consular Services Portal immediately before transferring money. An old blog figure or another visa category is not sufficient evidence.",{"children":"Keep the amount editable and confirm it through the responsible mission or Consular Services Portal immediately before transferring money. An old blog figure or another visa category is not sufficient evidence."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Use the official amount for the correct purpose","children":[["$","$L4","https://www.make-it-in-germany.com/en/visa-residence/types/studying",{"href":"https://www.make-it-in-germany.com/en/visa-residence/types/studying","children":["Official study-visa requirements",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","https://www.auswaertiges-amt.de/en/visa-service/visabestimmungen-node/sperrkonto-seite",{"href":"https://www.auswaertiges-amt.de/en/visa-service/visabestimmungen-node/sperrkonto-seite","children":["Official blocked-account guidance",["$","$L5",null,{"ref":"$undefined","iconNode":"$7:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
2a:["$","section","3-Scholarship reductions require confirmation",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Scholarship reductions require confirmation"}],[["$","p","Enter only a formally confirmed monthly scholarship. The calculator can show the arithmetic difference, but the mission decides whether the award and its wording satisfy all or part of the financial-proof requirement.",{"children":"Enter only a formally confirmed monthly scholarship. The calculator can show the arithmetic difference, but the mission decides whether the award and its wording satisfy all or part of the financial-proof requirement."}],["$","p","For the personal budget, the same scholarship is subtracted once from total costs. Do not also reduce tuition when a tuition waiver has already been entered as zero.",{"children":"For the personal budget, the same scholarship is subtracted once from total costs. Do not also reduce tuition when a tuition waiver has already been entered as zero."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2b:["$","section","4-Provider fees are separate from the blocked money",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Provider fees are separate from the blocked money"}],[["$","p","A provider can charge setup, monthly service or transfer-related fees. These costs are not part of the balance released for living expenses. Enter the current provider quotation rather than relying on a comparison copied from an older article.",{"children":"A provider can charge setup, monthly service or transfer-related fees. These costs are not part of the balance released for living expenses. Enter the current provider quotation rather than relying on a comparison copied from an older article."}],["$","p","AspireCompass does not recommend or rank blocked-account providers. Review the provider's current terms, refund route, support and payment instructions yourself.",{"children":"AspireCompass does not recommend or rank blocked-account providers. Review the provider's current terms, refund route, support and payment instructions yourself."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
2c:["$","section","5-Replace every example with dated evidence",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Replace every example with dated evidence"}],[["$","p","The cost presets are starting assumptions. Replace rent with a realistic offer or housing range, tuition with the programme's fee page and semester contribution with the university's current amount.",{"children":"The cost presets are starting assumptions. Replace rent with a realistic offer or housing range, tuition with the programme's fee page and semester contribution with the university's current amount."}],["$","p","Keep a separate cash-on-arrival total for housing deposits, travel and costs due before the first monthly release or scholarship payment.",{"children":"Keep a separate cash-on-arrival total for housing deposits, travel and costs due before the first monthly release or scholarship payment."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L2d",null,{"id":"tools/germany-blocked-account-calculator:section-6","title":"Check your progress","items":["Official monthly requirement verified","Visa duration confirmed","Scholarship entered only if formally confirmed","Provider fees copied from current terms","University tuition and semester contribution checked","Housing deposit and arrival cash kept separate"]}],"$undefined","$undefined"]}]
