25:["$","article",null,{"className":"article-body ","children":[["$","section","0-How to read the deposit and budget outputs",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"How to read the deposit and budget outputs"}],[["$","p","The blocked deposit remains your money subject to release conditions. A provider fee is a cost; a deposit is proof and a source of later living funds. The calculator supports planning and does not confirm that your consulate accepts a provider or that a future intake uses the same threshold.",{"children":"The blocked deposit remains your money subject to release conditions. A provider fee is a cost; a deposit is proof and a source of later living funds. The calculator supports planning and does not confirm that your consulate accepts a provider or that a future intake uses the same threshold."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"How to read the deposit and budget outputs","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"How to read the deposit and budget outputs"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Output",{"scope":"col","children":"Output"}],["$","th","Meaning",{"scope":"col","children":"Meaning"}],["$","th","Avoid this mistake",{"scope":"col","children":"Avoid this mistake"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Estimated blocked deposit"}],["$","td","1",{"children":"Monthly amount multiplied by selected months"}],["$","td","2",{"children":"Adding the full deposit again to living costs it already funds"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Arrival cash"}],["$","td","1",{"children":"