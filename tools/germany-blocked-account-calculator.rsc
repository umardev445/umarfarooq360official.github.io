27:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","How is the Germany blocked account amount calculated?",{"children":[["$","summary",null,{"children":["How is the Germany blocked account amount calculated?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"For a standard calculation, multiply the current monthly requirement by the number of required months. Any scholarship reduction must be accepted by the responsible visa authority."}]]}],["$","details","Is the blocked-account deposit an extra cost?",{"children":[["$","summary",null,{"children":["Is the blocked-account deposit an extra cost?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It remains the applicant's money and is released in restricted monthly amounts after arrival, although provider and transfer fees are separate costs."}]]}],["$","details","Can a scholarship reduce the blocked amount?",{"children":[["$","summary",null,{"children":["Can a scholarship reduce the blocked amount?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"A recognised scholarship can be accepted as financial proof, but the responsible mission decides whether the specific award covers all or part of the requirement."}]]}],["$","details","Does the calculator guarantee a student visa?",{"children":[["$","summary",null,{"children":["Does the calculator guarantee a student visa?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It is a planning tool. The German mission assesses the official documents, current financial requirement and complete visa application."}]]}],["$","details","Why can real monthly costs be higher than the official amount?",{"children":[["$","summary",null,{"children":["Why can real monthly costs be higher than the official amount?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The official amount is a standard financial threshold. Actual rent, deposits, insurance, university charges and lifestyle depend on the applicant's location and circumstances."}]]}]]}]]}]
