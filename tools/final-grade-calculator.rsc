1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--tool research-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/tools/final-grade-calculator/\",\"name\":\"Final grade calculator: what score do you need?\",\"description\":\"Calculate the final exam score needed for a target course grade, or project your final grade. See the formula, impossible targets and syllabus assumptions.\",\"url\":\"https://aspirecompass.org/tools/final-grade-calculator/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-22\",\"dateModified\":\"2026-10-22\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/images/expansion-20261022/tool-final-1280.webp\",\"caption\":\"Original illustration of assessment contributions and a target marker\"},\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tools\",\"item\":\"https://aspirecompass.org/tools/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Final grade calculator: what score do you need?\",\"item\":\"https://aspirecompass.org/tools/final-grade-calculator/\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What if I need more than 100%?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The target is not reachable under the entered 0–100 model. Check your inputs and syllabus; the calculator does not assu