24:[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Interpret the result","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Interpret the result"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Output",{"scope":"col","children":"Output"}],["$","th","Meaning under this model",{"scope":"col","children":"Meaning under this model"}],["$","th","What to check",{"scope":"col","children":"What to check"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Above 100%"}],["$","td","1",{"children":"Target exceeds the assumed maximum"}],["$","td","2",{"children":"Inputs and course policy"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"0–100%"}],["$","td","1",{"children":"Numerical score required"}],["$","td","2",{"children":"Rounding and minimum-exam rules"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"At or below 0%"}],["$","td","1",{"children":"Weighted target already secured numerically"}],["$","td","2",{"children":"Compulsory exam and completion conditions"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Final weight 0%"}],["$","td","1",{"children":"Final cannot change the weighted result"}],["$","td","2",{"children":"Whether the syllabus was entered correctly"}]],"$undefined"]}]]}]]}]}],"$undefined"]
25:["$","section","3-Project a result from your expected exam score",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Project a result from your expected exam score"}],[["$","p","In projected-grade mode, multiply the current average by the non-final share and the expected exam score by the final share, then add the contributions. For example, 80% current work and 90% final with a 40% final weight produce 48 + 36 = 84%.",{"children":"In projected-grade mode, multiply the current average by the non-final share and the expected exam score by the final share, then add the contributions. For example, 80% current work and 90% final with a 40% final weight produce 48 + 36 = 84%."}],["$","p","Try a cautious, expected and optimistic exam result for your own study planning. These are scenarios, not predictions. Use the gap between scenarios to decide where further preparation would matter most.",{"children":"Try a cautious, expected and optimistic exam result for your own study planning. These are scenarios, not predictions. Use the gap between scenarios to decide where further preparation would matter most."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","4-When a different calculation is required",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"When a different calculation is required"}],[["$","p","Multiple remaining assessments, dropped scores, point-based grading and category minimums may require a fuller model. Combine completed work correctly before using this tool, and do not represent two differently weighted remaining assessments as one without calculating their combined result.",{"children":"Multiple remaining assessments, dropped scores, point-based grading and category minimums may require a fuller model. Combine completed work correctly before using this tool, and do not represent two differently weighted remaining assessments as one without calculating their combined result."}],["$","p","For semester or cumulative performance across courses, use the GPA calculator with credits and the correct grading scale. A course percentage is not automatically a GPA and should not be converted using an invented universal table.",{"children":"For semester or cumulative performance across courses, use the GPA calculator with credits and the correct grading scale. A course percentage is not automatically a GPA and should not be converted using an invented universal table."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for When a different calculation is required","children":[["$","$L5","/tools/gpa-cgpa-calculator/",{"href":"/tools/gpa-cgpa-calculator/","children":["Calculate credit-weighted GPA and CGPA",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L5","/tools/ects-workload-calculator/",{"href":"/tools/ects-workload-calculator/","children":["Plan workload using ECTS",["$","$L6",null,{"ref":"$undefined","iconNode":"$7:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
27:["$","section","5-Before using the output for a decision",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Before using the output for a decision"}],[["$","p","Read the syllabus, check the remaining weight and confirm whether the displayed current average is the non-final average. Preserve the original values if you compare several targets. The reset button restores a clearly labelled example rather than an official student record.",{"children":"Read the syllabus, check the remaining weight and confirm whether the displayed current average is the non-final average. Preserve the original values if you compare several targets. The reset button restores a clearly labelled example rather than an official student record."}],["$","p","Inputs stay in your browser for the calculation and are not submitted to AspireCompass by this tool. The result is a planning aid; only the institution issues your official grade.",{"children":"Inputs stay in your browser for the calculation and are not submitted to AspireCompass by this tool. The result is a planning aid; only the institution issues your official grade."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L28",null,{"id":"tools/final-grade-calculator:section-6","title":"Check your progress","items":["Current grade represents all non-final work","Final weight matches the syllabus","Scores use the same 0–100 scale","Rounding and minimum-exam conditions checked","An above-100 result is not treated as achievable"]}],"$undefined","$undefined"]}]
