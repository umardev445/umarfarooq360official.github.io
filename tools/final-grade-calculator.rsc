23:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","What if I need more than 100%?",{"children":[["$","summary",null,{"children":["What if I need more than 100%?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The target is not reachable under the entered 0–100 model. Check your inputs and syllabus; the calculator does not assume extra credit."}]]}],["$","details","Can I skip the exam if the result is below zero?",{"children":[["$","summary",null,{"children":["Can I skip the exam if the result is below zero?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The numerical target may already be secured, but compulsory-exam or minimum-score rules can still apply."}]]}],["$","details","Does this work with several remaining assessments?",{"children":[["$","summary",null,{"children":["Does this work with several remaining assessments?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"This version models one final component. Calculate the non-final average and remaining component correctly or use the institution’s fuller grading method."}]]}]]}]]}]
