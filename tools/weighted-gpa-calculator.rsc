25:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is weighted GPA always out of 5.0?",{"children":[["$","summary",null,{"children":["Is weighted GPA always out of 5.0?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The maximum depends on the base scale, bonuses and school policy. The settings here are explicit examples you can edit."}]]}],["$","details","Can I convert a single weighted GPA into an unweighted GPA?",{"children":[["$","summary",null,{"children":["Can I convert a single weighted GPA into an unweighted GPA?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not uniquely without enough course and policy information. Enter the actual grades and credits to calculate both from the same record."}]]}],["$","details","Does AP exam credit increase this GPA?",{"children":[["$","summary",null,{"children":["Does AP exam credit increase this GPA?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"This tool weights course grades, not AP exam scores. A receiving college decides any exam credit or placement separately."}]]}],["$","details","Do you store my courses?",{"children":[["$","summary",null,{"children":["Do you store my courses?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The calculator runs in your browser and does not ask for a transcript upload or submit course inputs to AspireCompass."}]]}]]}]]}]
