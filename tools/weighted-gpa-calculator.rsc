17:T401,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is weighted GPA always out of 5.0?","acceptedAnswer":{"@type":"Answer","text":"No. The maximum depends on the base scale, bonuses and school policy. The settings here are explicit examples you can edit."}},{"@type":"Question","name":"Can I convert a single weighted GPA into an unweighted GPA?","acceptedAnswer":{"@type":"Answer","text":"Not uniquely without enough course and policy information. Enter the actual grades and credits to calculate both from the same record."}},{"@type":"Question","name":"Does AP exam credit increase this GPA?","acceptedAnswer":{"@type":"Answer","text":"This tool weights course grades, not AP exam scores. A receiving college decides any exam credit or placement separately."}},{"@type":"Question","name":"Do you store my courses?","acceptedAnswer":{"@type":"Answer","text":"The calculator runs in your browser and does not ask for a transcript upload or submit course inputs to AspireCompass."}}]}1:["$","main",null,{"id":"main-content","className":"editorial-page editorial-page--tool student-page","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://aspirecompass.org/tools/weighted-gpa-calculator/\",\"name\":\"Weighted GPA calculator for Honors, AP and IB courses\",\"description\":\"Calculate weighted and unweighted GPA from the same courses. Edit Honors/AP/IB bonuses, credits and A+ handling, with a transparent quality-points breakdown.\",\"url\":\"https://aspirecompass.org/tools/weighted-gpa-calculator/\",\"inLanguage\":\"en\",\"datePublished\":\"2026-10-26\",\"dateModified\":\"2026-10-26\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"AspireCompass\",\"url\":\"https://aspirecompass.org\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\