1f:["$","p","The displayed result is rounded to two decimals after the calculation. A+ can be set to 4.0 or 4.3. With 4.3 selected, the unweighted base scale can exceed 4.0; read that setting rather than comparing unlike scales.",{"children":"The displayed result is rounded to two decimals after the calculation. A+ can be set to 4.0 or 4.3. With 4.3 selected, the unweighted base scale can exceed 4.0; read that setting rather than comparing unlike scales."}]
20:["$","section","1-Worked example: three courses, two GPAs",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Worked example: three courses, two GPAs"}],[["$","p","Use the example settings of +0.5 Honors and +1.0 AP/IB with A+ at 4.0. These are teaching assumptions. Your school may assign different bonuses, eligible grades or course types.",{"children":"Use the example settings of +0.5 Honors and +1.0 AP/IB with A+ at 4.0. These are teaching assumptions. Your school may assign different bonuses, eligible grades or course types."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Credit-weighted example with equal one-credit courses","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Credit-weighted example with equal one-credit courses"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Course",{"scope":"col","children":"Course"}],["$","th","Grade / level",{"scope":"col","children":"Grade / level"}],["$","th","Base points",{"scope":"col","children":"Base points"}],["$","th","Weighted points",{"scope":"col","children":"Weighted points"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"English"}],["$","td","1",{"children":"A / Regular"}],["$","td","2",{"children":"4.0"}],["$","td","3",{"children":"4.0"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Chemistry"}],["$","td","1",{"children":"B / Honors"}],["$","td","2",{"children":"3.0"}],["$","td","3",{"children":"3.5"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"History"}],["$","td","1",{"children":"A / AP"}],["$","td","2",{"children":"4.0"}],["$","td","3",{"children":"5.0"}]],"$undefined"]}],["$","tr","3",{"children":[[["$","th","0",{"scope":"row","children":"Total / 3 credits"}],["$","td","1",{"children":"Same record"}],["$","td","2",{"children":"11 ÷ 3 = 3.67"}],["$","td","3",{"children":"12.5 ÷ 3 = 4.17"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
21:["$","section","2-Credits change the influence of each course",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"Credits change the influence of each course"}],[["$","p","Course weighting and course rigor are separate uses of the word weighted. A half-credit A and a one-credit B do not contribute equally even before an Honors bonus is considered. Enter the credit values used by your school rather than treating every row as one full course.",{"children":"Course weighting and course rigor are separate uses of the word weighted. A half-credit A and a one-credit B do not contribute equally even before an Honors bonus is considered. Enter the credit values used by your school rather than treating every row as one full course."}],["$","p","For example, a 0.5-credit A at 4.0 earns 2 quality points, while a 1-credit B at 3.0 earns 3. The unweighted result is 5 ÷ 1.5 = 3.33. It is not the simple mean of 4 and 3.",{"children":"For example, a 0.5-credit A at 4.0 earns 2 quality points, while a 1-credit B at 3.0 earns 3. The unweighted result is 5 ÷ 1.5 = 3.33. It is not the simple mean of 4 and 3."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
22:["$","section","3-Adjust the assumptions before relying on a result",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"Adjust the assumptions before relying on a result"}],[["$","p","The default model applies bonuses to A through C−, with an option to include D-range grades. An F receives no bonus. P, W and I entries are excluded from both averages in this tool. None of those defaults overrides a school policy.",{"children":"The default model applies bonuses to A through C−, with an option to include D-range grades. An F receives no bonus. P, W and I entries are excluded from both averages in this tool. None of those defaults overrides a school policy."}],["$","p","If a school caps total bonus points, selects only certain years, excludes particular subjects or uses an unfamiliar base grade scale, this general tool may not reproduce its official result. Keep the policy and transcript beside your calculation.",{"children":"If a school caps total bonus points, selects only certain years, excludes particular subjects or uses an unfamiliar base grade scale, this general tool may not reproduce its official result. Keep the policy and transcript beside your calculation."}]],"$undefined","$undefined","$undefined","$undefined","$undefined",["$","$L26",null,{"id":"tools/weighted-gpa-calculator:section-4","title":"Check your progress","items":["A+ handling matches the school.","Credits use the same unit throughout.","Only eligible course levels receive bonuses.","Bonus eligibility for lower grades is checked.","Excluded grades match the intended estimate."]}],"$undefined","$undefined"]}]
23:["$","section","4-A school GPA is not every college admissions GPA",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"A school GPA is not every college admissions GPA"}],[["$","p","The University of California publishes its own eligibility calculation, including a defined course/year window and honors rules. A generic Honors/AP average must not be labelled a UC capped GPA. Other institutions may evaluate the academic record differently.",{"children":"The University of California publishes its own eligibility calculation, including a defined course/year window and honors rules. A generic Honors/AP average must not be labelled a UC capped GPA. Other institutions may evaluate the academic record differently."}],["$","p","Use your official transcript when an application asks for your reported school GPA. If a college publishes a separate calculation method, use that method for a clearly named estimate rather than treating this number as its official decision.",{"children":"Use your official transcript when an application asks for your reported school GPA. If a college publishes a separate calculation method, use that method for a clearly named estimate rather than treating this number as its official decision."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for A school GPA is not every college admissions GPA","children":[["$","$L4","/guides/weighted-vs-unweighted-gpa/",{"href":"/guides/weighted-vs-unweighted-gpa/","children":["Read weighted versus unweighted GPA",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/gpa-calculator-with-retakes/",{"href":"/tools/gpa-calculator-with-retakes/","children":["Compare repeat-course policies",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/gpa-cgpa-calculator/",{"href":"/tools/gpa-cgpa-calculator/","children":["Use the cumulative target planner",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
