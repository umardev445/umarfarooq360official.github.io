 combines the credits and grade points across the periods you enter. The target planner estimates the future average needed; it does not replace a university’s official conversion rules."}],["$","p",null,{"className":"answer-next","children":[["$","strong",null,{"children":"Next step:"}]," ","Choose the correct grade-point scale, enter each course’s credits and grade points, and use the target planner only with completed and future credits separated."]}],"$undefined"]}],["$","nav",null,{"className":"tool-jump-nav","aria-label":"More free planning tools","children":[["$","span",null,{"children":"Free tools"}],[["$","$L4","/tools/ucas-points-calculator",{"href":"/tools/ucas-points-calculator/","aria-current":"$undefined","children":"UCAS points"}],["$","$L4","/tools/weighted-gpa-calculator",{"href":"/tools/weighted-gpa-calculator/","aria-current":"$undefined","children":"Weighted GPA"}],["$","$L4","/tools/gpa-calculator-with-retakes",{"href":"/tools/gpa-calculator-with-retakes/","aria-current":"$undefined","children":"Retake GPA"}],["$","$L4","/tools/quarter-to-semester-credits-calculator",{"href":"/tools/quarter-to-semester-credits-calculator/","aria-current":"$undefined","children":"Quarter / semester credits"}],["$","$L4","/tools/final-grade-calculator",{"href":"/tools/final-grade-calculator/","aria-current":"$undefined","children":"Final grade"}],["$","$L4","/tools/ects-workload-calculator",{"href":"/tools/ects-workload-calculator/","aria-current":"$undefined","children":"ECTS workload"}],["$","$L4","/tools/gpa-cgpa-calculator",{"href":"/tools/gpa-cgpa-calculator/","aria-current":"page","children":"GPA calculator"}],["$","$L4","/tools/ielts-band-calculator",{"href":"/tools/ielts-band-calculator/","aria-current":"$undefined","children":"IELTS calculator"}],["$","$L4","/tools/italy-study-cost-calculator",{"href":"/tools/italy-study-cost-calculator/","aria-current":"$undefined","children":"Italy cost calculator"}],["$","$L4","/tools/germany-blocked-account-calculator