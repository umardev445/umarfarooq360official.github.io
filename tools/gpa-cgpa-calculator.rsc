1e:["$","article",null,{"className":"article-body ","children":[["$","section","0-Check the grading scale before trusting a result",{"className":"article-section","id":"section-1","children":[["$","h2",null,{"children":"Check the grading scale before trusting a result"}],[["$","p","The same percentage can map to different grade points at different institutions. An arithmetic GPA is useful only when the inputs follow the scale your university uses. Do not treat a result on a 4-point scale as an official conversion from another system.",{"children":"The same percentage can map to different grade points at different institutions. An arithmetic GPA is useful only when the inputs follow the scale your university uses. Do not treat a result on a 4-point scale as an official conversion from another system."}]],"$undefined",[["$","p",null,{"className":"table-scroll-hint","children":"On a small screen, scroll the table sideways to compare all columns."}],["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Check the grading scale before trusting a result","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Check the grading scale before trusting a result"}],["$","thead",null,{"children":["$","tr",null,{"children":[[["$","th","Your task",{"scope":"col","children":"Your task"}],["$","th","Use",{"scope":"col","children":"Use"}],["$","th","Check first",{"scope":"col","children":"Check first"}]],"$undefined"]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[[["$","th","0",{"scope":"row","children":"Semester GPA"}],["$","td","1",{"children":"Courses and credits from that semester"}],["$","td","2",{"children":"Grade points follow your institution’s scale"}]],"$undefined"]}],["$","tr","1",{"children":[[["$","th","0",{"scope":"row","children":"Cumulative GPA"}],["$","td","1",{"children":"Completed periods with their credit weights"}],["$","td","2",{"children":"No semester or course is counted twice"}]],"$undefined"]}],["$","tr","2",{"children":[[["$","th","0",{"scope":"row","children":"Target GPA"}],["$","td","1",{"children":"Completed record plus planned future credits"}],["$","td","2",{"children":"The required result is within the chosen scale"}]],"$undefined"]}]]}]]}]}],"$undefined"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","1-Worked example: credits change the result",{"className":"article-section","id":"section-2","children":[["$","h2",null,{"children":"Worked example: credits change the result"}],[["$","p","Suppose one course has 3 credits at 4.0 and another has 2 credits at 3.0. Weighted points are 12 + 6 = 18; total credits are 5. GPA is 18 ÷ 5 = 3.60, not the unweighted average 3.50.",{"children":"Suppose one course has 3 credits at 4.0 and another has 2 credits at 3.0. Weighted points are 12 + 6 = 18; total credits are 5. GPA is 18 ÷ 5 = 3.60, not the unweighted average 3.50."}],["$","p","The default letter-grade scale may differ from your university. Select custom grade points in the calculator when you have official numeric values. Admissions may require an original CGPA statement rather than this tool's estimate.",{"children":"The default letter-grade scale may differ from your university. Select custom grade points in the calculator when you have official numeric values. Admissions may require an original CGPA statement rather than this tool's estimate."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],["$","section","2-CGPA to percentage and 4.0 GPA conversion",{"className":"article-section","id":"section-3","children":[["$","h2",null,{"children":"CGPA to percentage and 4.0 GPA conversion"}],[["$","p","The converter uses a proportional estimate: current CGPA divided by the maximum scale, multiplied by 100 for percentage or by 4 for a four-point result. For example, 8.0 on a 10.0 scale produces an 80% proportional estimate and 3.20 on a 4.0 scale.",{"children":"The converter uses a proportional estimate: current CGPA divided by the maximum scale, multiplied by 100 for percentage or by 4 for a four-point result. For example, 8.0 on a 10.0 scale produces an 80% proportional estimate and 3.20 on a 4.0 scale."}],"$L21"],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}],"$L22","$L23","$L24","$L25","$L26","$L27"]}]
1f:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Source records support the guide. Page update dates describe editorial changes; they do not mean every linked rule was checked again today. Reopen the current call for your programme and intake."}],["$","div",null,{"className":"source-grid","children":[["$","$L4","https://applications.wes.org/igpa-calculator/",{"href":"https://applications.wes.org/igpa-calculator/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"World Education Services iGPA Calculator"}],["$","span",null,{"children":"Example of a dedicated international grade-conversion service; account access may be required"}]]}],["$","$L5",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
20:["$","section",null,{"className":"faq-section","children":[["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","How do I calculate GPA with credit hours?",{"children":[["$","summary",null,{"children":["How do I calculate GPA with credit hours?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Multiply each course grade point by its credit hours, add the results and divide by the total included credit hours. The interactive calculator performs these steps automatically."}]]}],["$","details","How can I calculate the GPA needed to reach a target?",{"children":[["$","summary",null,{"children":["How can I calculate the GPA needed to reach a target?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Enter your current GPA, completed credits, future credits and target GPA in the target planner. It calculates the average required across the future credits and flags a result above 4.00 as unavailable on a standard 4.0 scale."}]]}],["$","details","Is CGPA divided by 10 and multiplied by 100 always correct?",{"children":[["$","summary",null,{"children":["Is CGPA divided by 10 and multiplied by 100 always correct?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It is only a proportional estimate for a 10-point scale. Universities and credential evaluators may use a different institution- or country-specific method."}]]}],["$","details","Can I convert percentage directly to a 4.0 GPA?",{"children":[["$","summary",null,{"children":["Can I convert percentage directly to a 4.0 GPA?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"You can create a rough proportional estimate, but an official decision may consider grade bands, pass marks, institution standards and individual courses. Follow the receiving institution's instructions."}]]}],["$","details","Does a calculated GPA prove scholarship eligibility?",{"children":[["$","summary",null,{"children":["Does a calculated GPA prove scholarship eligibility?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It can help you compare an academic threshold, but official eligibility and selection depend on the complete current programme rules."}]]}],["$","details","Does AspireCompass store my grades?",{"children":[["$","summary",null,{"children":["Does AspireCompass store my grades?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The calculator runs in your browser and does not require an account or submission of a transcript."}]]}],["$","details","Can this calculator convert my GPA into an official university GPA?",{"children":[["$","summary",null,{"children":["Can this calculator convert my GPA into an official university GPA?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It is a planning tool. Universities and credential evaluators may use their own grading rules, course weights and conversion methods, so use the institution's stated method for an official application."}]]}],["$","details","Should I enter credits when calculating CGPA?",{"children":[["$","summary",null,{"children":["Should I enter credits when calculating CGPA?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Use credit weighting when your institution assigns different credit values to courses. A simple average can be misleading when courses carry unequal weight."}]]}],["$","details","Why might my calculated result differ from my transcript?",{"children":[["$","summary",null,{"children":["Why might my calculated result differ from my transcript?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Your institution may apply rounding, repeated-course, excluded-course or grade-point rules that a general calculator cannot infer. Your official transcript remains authoritative."}]]}]]}]]}]
21:["$","p","That calculation is useful for rough comparison, not credential evaluation. Institutions may examine grade distribution, course level, university policy, pass mark, class rank or a country-specific equivalency table instead of using a straight-line formula.",{"children":"That calculation is useful for rough comparison, not credential evaluation. Institutions may examine grade distribution, course level, university policy, pass mark, class rank or a country-specific equivalency table instead of using a straight-line formula."}]
22:["$","section","3-How to calculate the GPA needed for a target",{"className":"article-section","id":"section-4","children":[["$","h2",null,{"children":"How to calculate the GPA needed for a target"}],[["$","p","The target planner begins with your current cumulative quality points: current GPA multiplied by completed credits. It then calculates the total quality points needed after the future credits and divides the remaining requirement by those future credits.",{"children":"The target planner begins with your current cumulative quality points: current GPA multiplied by completed credits. It then calculates the total quality points needed after the future credits and divides the remaining requirement by those future credits."}],["$","p","A required result above 4.00 is not achievable on a standard unweighted 4.0 scale with the entered credit plan. Adding more future credits can change the estimate, but course repeats, exclusions and institutional rules may produce a different official result.",{"children":"A required result above 4.00 is not achievable on a standard unweighted 4.0 scale with the entered credit plan. Adding more future credits can change the estimate, but course repeats, exclusions and institutional rules may produce a different official result."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Use the cumulative GPA currently shown by your institution",{"children":"Use the cumulative GPA currently shown by your institution"}],["$","li","Enter only credits already included in that GPA",{"children":"Enter only credits already included in that GPA"}],["$","li","Add the credits you realistically expect to complete",{"children":"Add the credits you realistically expect to complete"}],["$","li","Compare the required average with the maximum institutional grade point",{"children":"Compare the required average with the maximum institutional grade point"}]]}],"$undefined","$undefined","$undefined"]}]
23:["$","section","4-Which GPA should go on a scholarship application?",{"className":"article-section","id":"section-5","children":[["$","h2",null,{"children":"Which GPA should go on a scholarship application?"}],[["$","p","Use the original GPA, CGPA or percentage exactly as it appears on the official transcript unless the application gives a conversion instruction. Include the scale, such as 3.42/4.00 or 8.1/10.0, so the number has context.",{"children":"Use the original GPA, CGPA or percentage exactly as it appears on the official transcript unless the application gives a conversion instruction. Include the scale, such as 3.42/4.00 or 8.1/10.0, so the number has context."}],["$","p","When a form requires a different scale, follow that programme's stated calculator or credential-evaluation route. Save a note explaining the method and do not present an AspireCompass estimate as a university-issued result.",{"children":"When a form requires a different scale, follow that programme's stated calculator or credential-evaluation route. Save a note explaining the method and do not present an AspireCompass estimate as a university-issued result."}]],"$undefined","$undefined","$undefined","$undefined",["$","ul",null,{"children":[["$","li","Original result and maximum scale",{"children":"Original result and maximum scale"}],["$","li","Institution and country",{"children":"Institution and country"}],["$","li","Programme's required conversion method",{"children":"Programme's required conversion method"}],["$","li","Calculated result with method noted",{"children":"Calculated result with method noted"}],["$","li","Official evaluation where specifically requested",{"children":"Official evaluation where specifically requested"}]]}],"$undefined","$undefined","$undefined"]}]
24:["$","section","5-Common calculation mistakes",{"className":"article-section","id":"section-6","children":[["$","h2",null,{"children":"Common calculation mistakes"}],[["$","p","A simple average of course grades is wrong when courses carry different credits. Other common errors include mixing percentage marks with grade points, omitting repeated courses without permission and rounding every row before calculating the final result.",{"children":"A simple average of course grades is wrong when courses carry different credits. Other common errors include mixing percentage marks with grade points, omitting repeated courses without permission and rounding every row before calculating the final result."}],["$","p","Keep several decimal places during the calculation and round only the final display. If your transcript already provides a cumulative result, do not replace it with a self-calculated number unless the application explicitly asks you to recalculate it.",{"children":"Keep several decimal places during the calculation and round only the final display. If your transcript already provides a cumulative result, do not replace it with a self-calculated number unless the application explicitly asks you to recalculate it."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
25:["$","section","6-Use GPA as one part of scholarship fit",{"className":"article-section","id":"section-7","children":[["$","h2",null,{"children":"Use GPA as one part of scholarship fit"}],[["$","p","A minimum GPA is normally an eligibility threshold, not a prediction of selection. Scholarships may also evaluate degree relevance, leadership, research fit, work experience, references, language evidence and the quality of programme-specific answers.",{"children":"A minimum GPA is normally an eligibility threshold, not a prediction of selection. Scholarships may also evaluate degree relevance, leadership, research fit, work experience, references, language evidence and the quality of programme-specific answers."}],["$","p","After checking the academic threshold, use the scholarship finder to narrow programmes by degree level, destination and funding. Then verify the current criteria on the programme owner's website.",{"children":"After checking the academic threshold, use the scholarship finder to narrow programmes by degree level, destination and funding. Then verify the current criteria on the programme owner's website."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined"]}]
26:["$","section","7-Use the result in the right application route",{"className":"article-section","id":"section-8","children":[["$","h2",null,{"children":"Use the result in the right application route"}],[["$","p","Keep the original scale and transcript beside any estimate. A calculator helps you plan, but the university or scholarship decides how grades are evaluated and whether a converted value is accepted.",{"children":"Keep the original scale and transcript beside any estimate. A calculator helps you plan, but the university or scholarship decides how grades are evaluated and whether a converted value is accepted."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Use the result in the right application route","children":[["$","$L4","/scholarships/bachelors/",{"href":"/scholarships/bachelors/","children":["Find bachelor's scholarships",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/masters/",{"href":"/scholarships/masters/","children":["Find master's scholarships",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/scholarships/phd/",{"href":"/scholarships/phd/","children":["Find PhD funding",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/scholarship-application/",{"href":"/guides/scholarship-application/","children":["Build a scholarship application",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
27:["$","section","8-Choose the GPA model that fits your question",{"className":"article-section","id":"section-9","children":[["$","h2",null,{"children":"Choose the GPA model that fits your question"}],[["$","p","This tool weights grades by course credits. A high-school weighted GPA also applies course-rigor bonuses; a repeated course may require replacing the old attempt rather than adding an ordinary new course. Use the dedicated model when one of those rules applies.",{"children":"This tool weights grades by course credits. A high-school weighted GPA also applies course-rigor bonuses; a repeated course may require replacing the old attempt rather than adding an ordinary new course. Use the dedicated model when one of those rules applies."}]],"$undefined","$undefined","$undefined","$undefined","$undefined","$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Choose the GPA model that fits your question","children":[["$","$L4","/tools/weighted-gpa-calculator/",{"href":"/tools/weighted-gpa-calculator/","children":["Weighted GPA calculator for Honors, AP and IB courses",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/guides/weighted-vs-unweighted-gpa/",{"href":"/guides/weighted-vs-unweighted-gpa/","children":["Weighted vs unweighted GPA: compare the same academic record",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L4","/tools/gpa-calculator-with-retakes/",{"href":"/tools/gpa-calculator-with-retakes/","children":["GPA calculator with retakes: compare repeat policies",["$","$L5",null,{"ref":"$undefined","iconNode":"$6:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
